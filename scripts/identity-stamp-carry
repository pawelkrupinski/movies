#!/usr/bin/env bash
# Purpose: The stamp carry (project/StampCarry.scala; the owner, 2026-11-20)
# THE STAMP CARRY (project/StampCarry.scala; the owner, 2026-11-20): a commit whose identity change is PROVEN to change no
# decision keeps the stamps its parent deployed under, so workers boot on it without re-resolving every family; an
# unproven change bumps them, as before. The proofs are rows of test/resources/identity-stamp-carry.tsv.
#
#   scripts/identity-stamp-carry propose <base>..<head> [--proof pure-move|what-if]
#   scripts/identity-stamp-carry verify <old>..<new>
#   scripts/identity-stamp-carry auto <base>..<head> [--no-commit]
#   scripts/identity-stamp-carry stamps <ref>
#
#   propose  proves <base>..<head> (scripts/pure-move-check, else a recorded and published `scripts/identity-what-if --all`
#            verdict of every country with no take moved) and appends a row for each stamp the range moves and the proof carries
#            (a what-if carries no venue slot, nor the agreement rules with --model-only): commit the table after the
#            change, in a commit of its own. Nothing is written when no proof holds.
#   verify   the pre-push hook's `stampcarry` check: every row the table at <new> holds and <old>'s does not, proven again
#            -- its proof re-run or re-read for exactly its base and head, its digests made again by the build. Any row
#            it cannot prove refuses the push.
#   auto     what `agentctl land` runs after its rebase (scripts/land-before-queue), so no lane has to remember: the
#            pushed range carried by a recorded whole what-if of its very diff (taken before the rebase), else commit by
#            commit by pure-move-check; the rows committed on their own in the same push. A commit that may move a stamp
#            and proves nothing bumps the head's stamps (the head is what deploys), so then nothing is built or written.
#            Builds stamps only when a proof holds: seconds a cached tree, about a minute one not. Each range a row
#            cites goes to test/resources/identity-stamp-carry-ranges.tsv too (its commit count and patch-id), so
#            `verify` proves the row at the commits agentctl's queue rewrites it into (identity_stamp_carry.py)
#   publish  identity-what-if's, after each country (`publish <head> <base> <countries> <tools hash> <run id>`): the run's
#            verdict lines and takes diffs uploaded as one asset of the identity-what-if-verdicts release, the record a
#            what-if row is held to (a committed verdict is text its author writes; trust model: identity_stamp_carry.py)
#   stamps   each stamp's RAW digest at <ref> (`<stamp> TAB <digest>`), made by the build over the ref's identity tree
#            (identity-tools.sh's identity_tree, the what-if's own: one compile serves both), cached until a source moves
#
# What holds a row, and what never carries (Identity-Design; a what-if over the drift harness, the title rules, resources
# or stores): scripts/identity_stamp_carry.py; its tests: scripts/identity_stamp_carry_test.py.
# Exit 0 done, 1 refused, 2 usage or undecidable.
set -euo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
case "${1:-}" in
  -h|--help|"") usage_from_header; exit 0 ;;
  stamps) ;;
  *) exec python3 -I -B "$(dirname "$0")/identity_stamp_carry.py" "$@" ;;
esac
[ -n "${2:-}" ] || { echo "stamps <ref>" >&2; exit 2; }
# shellcheck disable=SC2034 # read by identity-tools.sh's identity_log
IDENTITY_TOOL=identity-stamp-carry
# shellcheck source=scripts/identity-tools.sh
. "$(dirname "$0")/identity-tools.sh"
# the what-if's tool files, so the tree is the one it lays out and compiles (a tree claimed by other tool files is laid out
# again); only identity's own resources are built here, so a base the files cannot compile with still gives its stamps
# (identity_what_if_cli_context.py's TOOL_FILES)
TOOL_FILES=()
while IFS= read -r f; do TOOL_FILES+=("$f"); done < <(python3 -I -B -c 'import sys; sys.path.insert(0, sys.argv[1])
import identity_what_if_cli_context as c; print("\n".join(c.TOOL_FILES))' "$IDENTITY_REPO/scripts")
[ "${#TOOL_FILES[@]}" -gt 0 ] || { identity_log "could not read the what-if's tool files"; exit 2; }
tree=$(identity_tree "$2" "${TOOL_FILES[@]}") || exit 2
kept=$tree/target/identity-tools/stamps
fresh() {
  [ -s "$kept" ] && [ -z "$(find "$tree/build.sbt" "$tree/project" "$tree"/*/src/main -newer "$kept" -type f -print -quit 2>/dev/null)" ]
}
make_stamps() {
  fresh && return 0
  local log=$tree/target/identity-tools/stamps.log dir name file
  mkdir -p "$(dirname "$kept")"
  : > "$kept.started"
  identity_log "building the identity stamps of $2 in $tree"
  jvm_slot_take "$IDENTITY_TOOL"
  # shellcheck disable=SC2046 # jvm_cpu_options: none, or one option
  if ! (cd "$tree" && sbt $(jvm_cpu_options | sed 's/^/-J/') -batch "identity/Compile/managedResources") > "$log" 2>&1; then
    jvm_slot_release; tail -30 "$log" >&2; identity_log "the build failed in $tree (log: $log)"; return 1
  fi
  jvm_slot_release
  # the stamps this build wrote (it writes them every run): a tree seeded from another Scala version's build holds that
  # one's stale copies beside them
  dir=$(find "$tree/identity/target" -path '*resource_managed/main/services/identity/identity-rules-version.txt' -newer "$kept.started" -print -quit)
  [ -n "$dir" ] || { identity_log "the build wrote no stamps under $tree/identity/target"; return 1; }
  dir=$(dirname "$dir")
  : > "$kept.part"
  for name in identity-rules venue-slot agreement-rules; do
    # the raw digest: a build from before the stamp carry wrote it as the version itself
    file=$dir/$name-digest.txt; [ -f "$file" ] || file=$dir/$name-version.txt
    printf '%s\t%s\n' "$name" "$(tr -d '[:space:]' < "$file")" >> "$kept.part"
  done
  mv "$kept.part" "$kept"
}
identity_locked "stamps-$(basename "$tree")" make_stamps "$@" || exit 2
cat "$kept"
