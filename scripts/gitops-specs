#!/bin/sh
# Purpose: Run movies' GitOps-reading specs against a movies-gitops tree before that tree reaches movies-gitops main
# The name its callers run (movies-gitops' pre-push hook, lint-registry-test.sh's --plan): gitops_specs.py beside it is
# the tool, its header (`--help`) says what it does.
exec python3 "$(dirname "$0")/gitops_specs.py" "$@"
