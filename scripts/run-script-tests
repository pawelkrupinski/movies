#!/usr/bin/env python3
# Purpose: Every script self-test, found by its name and run in parallel: the one way CI, the pre-push hook and a person at a terminal run them
# Every script self-test, found by its name and run in parallel: the one way CI, the pre-push hook and
# a person at a terminal run them.
#
#   scripts/run-script-tests                       # every self-test (the untagged ones)
#   scripts/run-script-tests scripts/ci identity   # only those whose path is under / contains / matches one of these
#   scripts/run-script-tests --changed origin/main # only those whose test, tool, a file they name, or one they
#                                                  # source or import (transitively) changed
#   scripts/run-script-tests --list [--all]        # what would run: path, tag, reason (tab-separated)
#   scripts/run-script-tests --tag manual          # only the tests tagged so (see TAGS)
#   scripts/run-script-tests --reads               # every glob a test declares it reads (see READS), one a line
#   scripts/run-script-tests --changed A --readers # only those a glob they declare they read selects (READS)
#   scripts/run-script-tests --paths FILE --list   # what --changed would select for the paths FILE lists, one a line
#                                                  # (no git: the land queue asks which tests two changes share)
#   scripts/run-script-tests --bash "$(scripts/floor-bash)"  # every self-test under the floor bash 3.2 (macOS's
#                                                  # /bin/bash; elsewhere scripts/floor-bash --install builds it)
#   scripts/run-script-tests --changed origin/main --bash "$(scripts/floor-bash)"  # the floor's own scope (FLOOR)
#   scripts/run-script-tests --changed origin/main --floor "$(scripts/floor-bash)" # both in ONE run: the floor's scope
#                                                  # under the floor bash, the rest natively (FLOOR; the pre-push hook)
#   scripts/run-script-tests --linux [<names>]     # the selected tests in an ubuntu-26.04 container, as CI runs
#                                                  # them (default: those --changed origin/main selects); Docker
#   scripts/run-script-tests --stress 8 [<names>]  # each named test (none named: each concurrency-heavy one, STRESS)
#                                                  # run 8 times at once beside a CPU burner a core; with --changed,
#                                                  # the concurrency-heavy ones it selects (the hook's PREPUSH_STRESS=N)
#
# Options: --jobs N (8 at once; under --stress every run at once), --burn K (--stress's CPU burners: one a core), --stall S (a test ended after 300 s without progress), --timeout S (a wall-clock
# ceiling on each test; none by default), --root DIR (the checkout; this script's own),
# --bash PATH (each .sh test run by it, and first on the PATH as `bash`, so the tools it starts through their
# `#!/usr/bin/env bash` and every `bash -c` run by it too).
#
# WHY. The self-tests were listed by hand: ~60 lines of one background step in ci.yml plus single
# lines in six other workflows, and a test nobody listed ran nowhere (ScriptSelfTestsRunInCiSpec
# caught several). Found by name, a new test runs the moment it exists: NAME IT `<tool>-test.sh` or
# `<tool>_test.py`, beside its tool, under one of the roots below, and nothing needs wiring.
#
# TAGS. A `# script-test: <tag> <why>` line in a test's first 40 lines keeps it out of the default
# run: `manual` for one that needs what no CI job has (a live replica set, a device farm) or is not a
# self-test at all; any other tag (`own-job`, ...) for one a workflow runs by name where its toolchain
# is (ScriptSelfTestsRunInCiSpec holds those to it). `--tag <tag>` runs them; `--all` lists everything.
#
# READS. A test holding the repository's own files to a rule (every workflow, every .py, every Scala spec) names none of
# them, so --changed never selected it for the edit it exists to catch, and the pre-push hook let that edit land: 18 of
# Tool self-tests' first 35 reds (download_artifact_layout_test.py #259-263 on a workflow, python_floor_lint_test.py
# #131-134 on a .py, lint-registry-test.sh #158-166 and #194 on a spec). Such a test says what it reads, in a
# `# script-test-reads: <glob> [<glob>...]` line in its first 40 lines, the globs relative to the root, `*` crossing
# `/` (a `case` pattern); --changed selects it when a changed path matches one, and the pre-push hook runs its
# `scripttests` check for such a path (`--reads`). An extensionless tool (scripts/hooks/pre-push) is named by its
# directory and name (`hooks/pre-push`), a test naming it so selected by its edit (pre-push-gate-test.sh, #71-72); an
# extensionless Python tool is a .py to a declared glob (`*.py` selects the floor lint for infra/bin/fleet-ssh).
# DERIVED READS (14eb62591d: stall-watch.sh changed, and --changed never selected pre-push-tools-test.sh, which runs the
# hook, which runs the watchdog): a test is also selected by a change to what it names in its code and, one step
# further, what those name -- each with what it sources or imports, never through another self-test
# (scripts/lib/script_tests_changed.py, Derived). A `# script-test-reads:` line stays, for what no name says.
# `--readers` keeps, of what --changed selects, only the tests a declared glob selects: what the hook's --verify-only
# runs over agentctl's combined tree, where a change and what landed beside it share no file, yet a test holding every
# .py or spec to a rule can break on the two together.
#
# FLOOR. `--bash` with `--changed` is the pre-push hook's floor run, scoped to what a change can break under 3.2 (it
# re-ran every selected test, ~+70 s a landing, 2026-11-16): every bash file the change touches (a .sh, or an
# extensionless file with a bash shebang) parsed by that bash (`-n`: ed160b94b's `case ... in pat)` inside `$( )`,
# Order independence #72), its ADDED lines held to the constructs bash 3.2 lacks (scripts/floor-constructs.tsv: declare -A,
# mapfile, ${x,,}, wait -n, ...; a line's comment is no code), each finding a `FLOOR <file>:<line>: <construct>` row
# failing the run -- and, re-run under it, the self-tests of those bash files and of the scripts sourcing them, never a
# test selected only by a name it mentions or a glob it reads (those run on today's bash: no bash the change touched
# is theirs to run). tool-self-tests.yml's macOS job runs a push's floor scope, and on a dispatch every self-test under it.
# `--floor <bash>` with `--changed` is both runs in ONE: the floor's static half, the floor's scope under it, and every
# other selected test natively, in one pool of --jobs. The hook ran the two side by side, so a test in both ran twice at
# once -- pre-push-test.sh, ~150-220 s each, kept a hook change ~+43 s (+14%) over its budget by the contention alone
# (2026-11-16) -- and each test of the floor's scope now runs once, under 3.2. Its run on today's bash is the --linux
# run's (CI's ubuntu bash 5) and CI's; a construct that bash 5 rejects and 3.2 accepts is the rare way round.
#
# LONGEST FIRST. A run lasts as long as its slowest slot, and a few tests take minutes where most take seconds, so a slow
# one started last stretches the run. Tests start in descending order of the seconds their last PASS took, kept in
# $RUN_SCRIPT_TESTS_DURATIONS (default ~/.cache/kinowo-script-tests/durations.tsv, `path<TAB>seconds`, merged and
# replaced by temp file + mv, so concurrent runs lose at worst one another's update). A test with no recorded time
# (new, or no cache: CI's container, --linux) starts FIRST, the larger file first -- it may be a slow one, and size
# is the only proxy there is. Only the order changes, never which tests run nor their verdicts.
#
# Each test runs from the checkout's root, `bash` for .sh and `python3` for .py, stdin closed, in a
# process group of its own (scripts/lib/tool_bounded.py, tool-conventions.sh's `bounded`: the whole group ended, and a Ctrl-C
# reaching it, which GNU timeout's own process group would not).
#
# A NO-PROGRESS BOUND, NOT A WALL CLOCK (scripts/stall_watch.py): a test is ended, STALLED, once it has
# gone --stall seconds with no output, no CPU in its processes and none of them runnable, and its log
# says what the group was stuck on (scripts/stall-report.sh). A test that is working is never cut short
# however long a loaded machine makes it: Tool self-tests #2857 ran four of them (identity-takes-check,
# pre-push, pre-push-tools, identity-measure; 115-450 s on a quiet runner) under a load of 160 and cut
# each, passing case after passing case, at the 600 s a test it had then. --timeout S adds a wall-clock
# ceiling for a caller that wants one; CI's is the job's own timeout. The table names each PASS / FAIL /
# STALLED / TIMEOUT with its seconds; a failure's last lines follow.
# STRESS. A race between a test's own processes (a background compile and the resolve reading the tree it lays out:
# identity-what-if-test.sh, Order independence #89-#91, fixed in 8be54b489; sbt-warm-test.sh's keeper #74;
# identity-slice-test.sh #94) shows on the slow 3-core macOS runner and almost never on a laptop. `--stress N` makes the
# laptop that runner: every named test N times, all at once (--jobs: N x tests), beside --burn K busy loops (one a core),
# its table a row a run, and a verdict a test (`STRESS <test>: K of N failed`). A test whose first 40 lines say
# `# script-test-stress: <why>` is CONCURRENCY-HEAVY: `--stress N` with no names runs those, with --changed those it
# selects; a --changed run that selects one says so, naming the command. The pre-push hook stresses them only when
# asked (PREPUSH_STRESS=N): a stressed what-if test is minutes of CPU, past the landing budget. No durations are kept and
# the tree is not checked under --stress (copies of one test share the checkout on purpose). The burners end with the
# run, and by themselves once it is gone. It reproduces what the runner did: sbt-warm-test.sh at the parent of f69ccf47f
# (its busy stub ending before the first poll) failed 6 of 6 at `--stress 6 --burn 36` on an 18-core laptop, main 0 of
# 6. Races needing a slow disk rather than a slow CPU (identity-what-if's tree layout, #89-#91) it did not reproduce.
#
# THE TREE IS LEFT AS FOUND. Every test shares ONE checkout with the 7 others running beside it, so a file one test leaves
# there is read by the next: js-quality-report-test.sh's `npm ci` left scripts/js-quality/node_modules, and
# tool-jvm-headless-test.sh's `grep -r` read it (Order independence #99) -- the victim failed, the polluter passed. So the
# polluter fails: the checkout's state (`git status --porcelain --ignored`: what is new, changed, deleted, or new and
# ignored) is taken before the run and after it, and each path new after it is put on the test that made it, a test FAIL
# (POLLUTE) naming it. Under --jobs, who made it is read in two steps. Its candidates are the tests running when it was
# made (its ctime -- tar or `cp -p` keep an mtime, never a ctime -- inside a test's start..end); then each candidate runs
# AGAIN, ALONE, with the leftovers moved aside, and the one that makes a path again is its polluter (the leftovers are put
# back afterwards: the tree ends as the run left it). Confirming costs a run of each candidate, paid only when something
# was left. A path no candidate makes again alone (an edit beside the run, a co-agent's sbt writing target/) is said and
# does not fail the run. Two snapshots cost ~1 s a run; a per-test snapshot could not tell 8 concurrent tests apart
# anyway. Skipped (RUN_SCRIPT_TESTS_TREE_CHECK=0 -- the landing check's beside run sets it, scripts/ci/hook-beside.sh:
# another run writes the same checkout --, or a --root that is no writable git checkout: --linux's read-only copy). Tests install their tools outside the tree (~/.cache/kinowo/<tool>/<lock hash>, js-quality-report), and run
# with PYTHONDONTWRITEBYTECODE=1: an import's __pycache__ is no test's to leave. `python3 -I` ignores that variable (-I
# implies -E), so every launch passes -B beside it (scripts/lib/tool_python.py; its test refuses one without).
#
# THE GOVERNOR. A run (and --linux's container, and its image build) holds a governor ticket on the Mac (jvm_gate.py's JvmGate.width, jvm-gate.sh's
# gov_width, `agentctl gov`), charged its parallelism (--jobs, or fewer tests): while the laptop is starved it waits for
# admission, then starts by itself (the owner, 2026-11-19). None under a ticket already (AGENTCTL_GOV_WIDTH: a check's
# hook, whose width caps --jobs), off the Mac, with KINOWO_GOVERNOR=0, or riding a parent's. The tests themselves run
# with descriptor 7 closed and KINOWO_JVM_SLOT_HELD unset -- a test of the gate fakes its own governor and must see no
# ticket of this run's (and shell-spec.sh keeps the real governor out of every spec) -- and AGENTCTL_GOV_WIDTH=1: each
# holds one core of the run's ticket, so a fan-out inside one (scripts/gov-parallel) runs one wide, ticketless.
# Exit: 0 all passed (or none selected by --changed), 1 any failed or a filter matched nothing,
# 2 a --changed base that is no commit, 64 usage.
#
# Python (scripts/lib/script_tests_*.py, tool_bounded.py, jvm_gate.py; this file is main(), the composition root).
# The pre-push hook greps this file for the flags it passes:
# --floor) --stress) --readers --linux --bash.
from __future__ import annotations

import os
import platform
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from typing import Callable, List, MutableMapping, Optional, Sequence, Tuple

HERE = os.path.dirname(os.path.realpath(__file__))
LIB = os.path.join(HERE, "lib")
sys.path.insert(0, LIB)

import machine  # noqa: E402
from jvm_gate import Governor, Host, JvmGate, SubprocessCommands  # noqa: E402
from jvm_memory import Clock, MemoryGate, SlotWait  # noqa: E402
from script_tests_found import Found, concurrency_heavy, declared_reads, discover  # noqa: E402
from script_tests_select import Options, Refused, Selection, git_in, heavy_only, select  # noqa: E402
import script_tests_linux as linux  # noqa: E402
from script_tests_pool import Pool  # noqa: E402
from script_tests_run import Plan, Run, Settings, Width, govern, plan_run, tools, widening  # noqa: E402
from tool_cli import header_usage  # noqa: E402

ROOTS = "scripts .github/scripts .github/actions android/scripts ios/scripts infra/bin infra/nix/bin infra/nix/files data"
# The oldest python3 every Python tool runs on: macOS's /usr/bin/python3 (3.9). scripts/ci/python_floor_lint.py holds
# the code to it -- no syntax, and no annotation evaluated at runtime, newer than this.
PythonFloor="3.9"  # noqa: E225  (python_floor_lint.py reads this line as it is)
# CI's runner (tool-self-tests.yml's `script-tests` job) as an image: the Dockerfile's ubuntu base, same digest
# (infra/bin/image_pins.py refreshes it here), from mirror.gcr.io (CiImageMirrorSpec: never Docker Hub first), plus
# what the runner ships that the tests reach for (zstd, rsync, node, PyYAML, nc among them). Its hash tags the image.
LINUX_IMAGE_RECIPE = r'''FROM mirror.gcr.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      bash coreutils findutils sed gawk grep diffutils git jq python3 perl curl ca-certificates unzip zip xz-utils \
      file procps lsof bc tzdata shellcheck zstd rsync nodejs python3-yaml netcat-openbsd > /dev/null && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory "*"'''
CI_CONTEXT = ("GITHUB_STEP_SUMMARY GITHUB_OUTPUT GITHUB_ENV GITHUB_PATH GITHUB_STATE GITHUB_REF GITHUB_REF_NAME "
              "GITHUB_REF_TYPE GITHUB_REF_PROTECTED GITHUB_HEAD_REF GITHUB_BASE_REF GITHUB_SHA GITHUB_EVENT_NAME "
              "GITHUB_EVENT_PATH GITHUB_SERVER_URL GITHUB_API_URL GITHUB_GRAPHQL_URL GITHUB_REPOSITORY "
              "GITHUB_REPOSITORY_OWNER GITHUB_RUN_ID GITHUB_RUN_NUMBER GITHUB_RUN_ATTEMPT GITHUB_WORKFLOW "
              "GITHUB_WORKFLOW_REF GITHUB_JOB GITHUB_ACTOR GITHUB_TRIGGERING_ACTOR").split()
VALUED = {"--jobs": "jobs", "--stress": "stress", "--burn": "burn", "--timeout": "timeout", "--stall": "stall",
          "--root": "root", "--tag": "tag", "--changed": "changed", "--paths": "paths", "--bash": "bash",
          "--floor": "floor"}
SWITCHES = {"--list": "list", "--all": "all", "--reads": "reads", "--readers": "readers", "--linux": "linux"}


class Usage(Exception):
    """A caller's mistake: said, then the usage, exit 64."""


def usage() -> str:
    return header_usage(os.path.realpath(__file__))


def parse(argv: Sequence[str]) -> Optional[Options]:
    """The options, None for --help (printed)."""
    o = Options(root=os.path.dirname(HERE), roots=[str(r) for r in ROOTS.split()], constructs=os.path.join(HERE, "floor-constructs.tsv"))
    i = 0
    while i < len(argv):
        if argv[i] in ("-h", "--help"):
            sys.stdout.write(usage())
            return None
        i = read_word(o, argv, i) + 1
    o.jobs_given = "--jobs" in argv
    return checked(o)


def read_word(o: Options, argv: Sequence[str], i: int) -> int:
    """argv[i] read into `o`: the index of the last word it took."""
    word = argv[i]
    if word in VALUED:
        if i + 1 >= len(argv):
            raise Usage(f"{word} needs a value")
        setattr(o, VALUED[word], argv[i + 1])
        return i + 1
    if word in SWITCHES:
        setattr(o, SWITCHES[word], True)
    elif word.startswith("-"):
        raise Usage(f"unknown option {word}")
    else:
        o.filters.append(word)
    return i


REFUSALS: Sequence[Tuple[Callable[[Options], bool], str]] = (
    (lambda o: o.readers and not o.changed, "--readers needs --changed"),
    (lambda o: bool(o.paths) and not o.list, "--paths only lists (--list): a run is --changed's"),
    (lambda o: not o.stress.isdigit(), "--stress takes a count"),
    (lambda o: int(o.stress) > 0 and o.linux, "--stress runs here, not --linux"),
    (lambda o: bool(o.floor) and (not o.changed or bool(o.bash)), "--floor needs --changed, and no --bash"),
    (lambda o: not (o.jobs.isdigit() and o.timeout.isdigit() and o.stall.isdigit()),
     "--jobs, --timeout and --stall take a count"),
)


def checked(o: Options) -> Options:
    if not os.path.isdir(o.root):
        raise Usage(f"--root {o.root} is no directory")
    o.root = os.path.abspath(o.root)
    if o.paths:
        o.changed = f"(the paths in {o.paths})"
    refused = next((why for broken, why in REFUSALS if broken(o)), None)
    if refused:
        raise Usage(refused)
    if o.linux and not o.filters and not o.changed and not o.tag:
        o.changed = "origin/main"  # --linux with nothing named: the tests the pre-push hook would run
    return o


def say(line: str) -> None:
    sys.stderr.write(line + "\n")
    sys.stderr.flush()


def linked_bash(scratch: str, name: str, bash: str, flag: str) -> str:
    """A directory holding `bash` as `bash` (first on a PATH: what a test or tool starts by `bash` runs)."""
    if not (os.path.isfile(bash) and os.access(bash, os.X_OK)):
        raise Usage(f"{flag} {bash} is no executable")
    directory = os.path.join(scratch, name)
    os.makedirs(directory)
    os.symlink(bash, os.path.join(directory, "bash"))
    return directory


def compose_gate(env: MutableMapping[str, str], root: str) -> JvmGate:
    """THE GOVERNOR's ticket (jvm_gate.py): the composition root's one gate."""
    home = os.path.expanduser("~")
    host = Host(env, os.getpid(), platform.system(), home, lambda: root, say)
    governor = Governor(host, SubprocessCommands())
    memory = MemoryGate(env, Clock(time.sleep), say, lambda: governor.bin() is not None, platform.system())
    slots = os.path.join(env.get("KINOWO_IDENTITY_CACHE") or os.path.join(home, ".cache/kinowo-identity"), "jvm-slots")
    return JvmGate(host, governor, memory, SlotWait(memory, slots), slots)


def too_old_python(tests: Sequence[Found]) -> bool:
    if not any(t.path.endswith(".py") for t in tests):
        return False
    floor_version = PythonFloor.replace(".", ", ")
    if machine.status(["python3", "-c", f"import sys; sys.exit(sys.version_info < ({floor_version}))"],
                      out=subprocess.DEVNULL, err=subprocess.DEVNULL) == 0:
        return False
    version = machine.output(["python3", "--version"])[1].strip()
    say(f"run-script-tests: {version} is too old -- the Python tools need {PythonFloor} or newer")
    return True


def settings(o: Options, env: MutableMapping[str, str], tree_check: bool) -> Settings:
    home = os.path.expanduser("~")
    return Settings(int(o.jobs), o.jobs_given, int(o.stress or 0), o.burn, int(o.timeout), int(o.stall),
                    env.get("RUN_SCRIPT_TESTS_LOG_DIR") or os.path.join(home, ".cache/kinowo-script-tests/failed"),
                    env.get("RUN_SCRIPT_TESTS_DURATIONS") or os.path.join(home, ".cache/kinowo-script-tests/durations.tsv"),
                    tree_check, o.bash or o.floor)


def run_on_linux(o: Options, s: Settings, env: MutableMapping[str, str], scratch: str, tests: List[str]) -> int:
    if not tests:
        print(f"run-script-tests: no script tests selected{' by the changes since ' + o.changed if o.changed else ''}")
        return 0
    gate = compose_gate(env, o.root)
    try:
        return run_in_container(o, s, env, scratch, tests, govern(gate, env, o.root, s.jobs, tests))
    finally:
        gate.release()


def run_in_container(o: Options, s: Settings, env: MutableMapping[str, str], scratch: str, tests: List[str],
                     width: Width) -> int:
    inner = ["scripts/run-script-tests", "--jobs", str(width.jobs), "--timeout", o.timeout, "--stall", o.stall]
    c = linux.Container(o.root, LINUX_IMAGE_RECIPE, s.log_dir, inner + (["--tag", o.tag] if o.tag else []),
                        os.path.expanduser("~"), os.path.join(HERE, "linux-tree-sync.py"), scratch,
                        int(env.get("RUN_SCRIPT_TESTS_LINUX_SLOTS") or 4),
                        int(env.get("RUN_SCRIPT_TESTS_LINUX_WAIT") or 1800))
    return linux.run(c, tests, say, time.sleep)


def nothing_selected(o: Options, findings: Sequence[str]) -> int:
    if o.changed:
        print(f"run-script-tests: no script tests selected by the changes since {o.changed}")
        if findings:
            print("\n" + "\n".join(findings))
            print(f"run-script-tests: {len(findings)} thing(s) the floor bash {o.bash or o.floor} cannot run (FLOOR)")
            return 1
        return 0
    named = " ".join(o.filters) or "the roots"
    say(f"run-script-tests: no script test matches {named}{' tagged ' + o.tag if o.tag else ''}")
    return 1


@dataclass
class Floor:
    """--floor: its bash's directory (first on its tests' PATH) and the tests of its scope."""
    bin: str = ""
    tests: List[str] = field(default_factory=lambda: [])


def floor_scope(o: Options, env: MutableMapping[str, str], scratch: str) -> Floor:
    """--bash first on every PATH; --floor's own scope worked out by its own rules (FLOOR), to run in this run."""
    if o.bash:
        env["PATH"] = linked_bash(scratch, "bash-bin", o.bash, "--bash") + os.pathsep + env.get("PATH", "")
    if not o.floor:
        return Floor()
    return Floor(linked_bash(scratch, "floor-bin", o.floor, "--floor"), [t.path for t in select(o, o.floor).tests])


def listed(chosen: Selection) -> int:
    print("".join(t.row() + "\n" for t in chosen.tests), end="")
    return 0


def chosen_for(o: Options) -> Tuple[Selection, Optional[int]]:
    """The selection, and an exit status when there is nothing further to do (--list, STRESS with none to run)."""
    chosen = select(o, o.bash, "" if o.list else (o.bash or o.floor))
    stop = heavy_only(o, chosen) if int(o.stress) and not o.filters else None
    if stop is None and o.list:
        stop = listed(chosen)
    return chosen, stop


def run(o: Options, env: MutableMapping[str, str], scratch: str, tree_check: bool) -> int:
    """Everything after the options: select, then list, run on Linux, or run here."""
    s = settings(o, env, tree_check)
    scope = floor_scope(o, env, scratch)
    chosen, stop = chosen_for(o)
    if stop is not None:
        return stop
    if o.linux:
        return run_on_linux(o, s, env, scratch, [t.path for t in chosen.tests])
    if not chosen.tests:
        return nothing_selected(o, chosen.findings)
    return 1 if too_old_python(chosen.tests) else run_here(o, s, env, scratch, scope, chosen)


def run_here(o: Options, s: Settings, env: MutableMapping[str, str], scratch: str, scope: Floor,
             chosen: Selection) -> int:
    tests = [t.path for t in chosen.tests]
    gate = compose_gate(env, o.root)
    try:
        width = govern(gate, env, o.root, s.jobs, tests)
        return run_planned(o, s, env, scratch, scope, chosen, plan_run(o.root, scratch, tests, s, width), gate)
    finally:
        gate.release()


def run_planned(o: Options, s: Settings, env: MutableMapping[str, str], scratch: str, scope: Floor,
                chosen: Selection, planned: Tuple[Plan, int], gate: JvmGate) -> int:
    plan, count = planned
    plan.floor_tests, plan.floor_bin = scope.tests, scope.bin
    pool = Pool(plan, dict(env), tools(LIB, HERE), time.sleep, widening=widening(gate, plan))
    heavy = [p for p in plan.paths[:count] if concurrency_heavy(os.path.join(o.root, p))]
    return Run(s, pool, git_in(o.root), time.sleep).run(count, bool(o.changed), heavy, chosen.findings)


def prepared(env: MutableMapping[str, str]) -> bool:
    """The environment the tests get: none of the CI run's context, no bytecode written; the tree check's switch
    (this run's own, never its tests') read and dropped."""
    tree_check = env.pop("RUN_SCRIPT_TESTS_TREE_CHECK", "1") != "0"
    for name in CI_CONTEXT:
        env.pop(name, None)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return tree_check


def print_reads(root: str) -> int:
    globs = declared_reads(root, [t.path for t in discover(root, ROOTS.split())])
    print("".join(g + "\n" for g in sorted({g for gs in globs.values() for g in gs}, key=lambda g: g.encode())), end="")
    return 0


def main(argv: List[str]) -> int:
    env = machine.environment()
    tree_check = prepared(env)
    scratch = ""
    try:
        o = parse(argv)
        if o is None:
            return 0
        os.chdir(o.root)
        if o.reads:
            return print_reads(o.root)
        scratch = tempfile.mkdtemp(prefix="run-script-tests.")
        return run(o, env, scratch, tree_check)
    except Usage as e:
        sys.stderr.write(f"run-script-tests: {e}\n" + usage())
        return 64
    except Refused as e:
        say(str(e))
        return 2
    finally:
        if scratch:
            shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
