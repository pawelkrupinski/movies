#!/usr/bin/env bash
# Every script self-test, found by its name and run in parallel: the one way CI, the pre-push hook and
# a person at a terminal run them.
#
#   scripts/run-script-tests                       # every self-test (the untagged ones)
#   scripts/run-script-tests scripts/ci identity   # only those whose path is under / contains / matches one of these
#   scripts/run-script-tests --changed origin/main # only those whose test, tool, a file they name, or one they
#                                                  # source or import (transitively) changed
#   scripts/run-script-tests --list [--all]        # what would run: path, tag, reason (tab-separated)
#   scripts/run-script-tests --tag manual          # only the tests tagged so (see TAGS)
#   scripts/run-script-tests --bash /bin/bash      # every self-test under that bash (macOS's 3.2: the floor)
#   scripts/run-script-tests --linux [<names>]     # the selected tests in an ubuntu-26.04 container, as CI runs
#                                                  # them (default: those --changed origin/main selects); Docker
#
# Options: --jobs N (8 at once), --timeout S (600 s a test), --root DIR (the checkout; this script's own),
# --bash PATH (each .sh test run by it, and first on the PATH as `bash`, so the tools it starts through their
# `#!/usr/bin/env bash` and every `bash -c` run by it too).
#
# WHY. The self-tests were listed by hand: ~60 lines of one background step in ci.yml plus single
# lines in six other workflows, and a test nobody listed ran nowhere (ScriptSelfTestsRunInCiSpec
# caught several). Found by name, a new test runs the moment it exists: NAME IT `<tool>-test.sh` or
# `<tool>_test.py`, beside its tool, under one of the roots below, and nothing needs wiring.
#
# TAGS. A `# script-test: <tag> <why>` line in a test's first 40 lines keeps it out of the default
# run: `manual` for one that needs what no CI job has (a live replica set, a device farm) or is not a
# self-test at all; any other tag (`own-job`, ...) for one a workflow runs by name where its toolchain
# is (ScriptSelfTestsRunInCiSpec holds those to it). `--tag <tag>` runs them; `--all` lists everything.
#
# Each test runs from the checkout's root, `bash` for .sh and `python3` for .py, stdin closed, under
# its own timeout (tool-conventions.sh's `bounded`: the test's whole process group ended, and a
# Ctrl-C reaching it, which GNU timeout's own process group would not). The table names each
# PASS / FAIL / TIMEOUT with its seconds; a failure's last lines follow.
# Exit: 0 all passed (or none selected by --changed), 1 any failed or a filter matched nothing,
# 2 a --changed base that is no commit, 64 usage. Bash 3.2 (macOS /bin/bash): no wait -n, no maps.
set -uo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "${BASH_SOURCE[0]}")/tool-conventions.sh" # bounded: each test under its timeout, Ctrl-C reaching it
# A self-test runs its tool as a test, never as the CI step it is run from: one that reads GITHUB_STEP_SUMMARY or
# GITHUB_OUTPUT would write into the calling step's own (Forgejo warns of every job summary, and discards it).
unset GITHUB_STEP_SUMMARY GITHUB_OUTPUT

Roots="scripts .github/scripts .github/actions android/scripts ios/scripts infra/bin data"
# The oldest python3 every Python tool runs on: macOS's /usr/bin/python3 (3.9). scripts/ci/python_floor_lint.py holds
# the code to it -- no syntax, and no annotation evaluated at runtime, newer than this.
PythonFloor="3.9"

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
stall_report="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/stall-report.sh" # this script's own, whatever --root
jobs=8 timeout_s=600 list=0 all=0 tag="" changed_base="" test_bash="" linux=0 filters=()
usage() { usage_from_header "${BASH_SOURCE[0]}" >&2; exit 64; }
# A caller's mistake exits 64 here (above), not tool-conventions.sh's 2: flag_value's missing value too.
usage_error() { echo "run-script-tests: $*" >&2; usage; }
while [ $# -gt 0 ]; do
  case "$1" in
    --jobs) flag_value "$@"; jobs="$2"; shift ;;
    --timeout) flag_value "$@"; timeout_s="$2"; shift ;;
    --root) flag_value "$@"; root="$(cd "$2" && pwd)" || exit 64; shift ;;
    --list) list=1 ;;
    --all) all=1 ;;
    --tag) flag_value "$@"; tag="$2"; shift ;;
    --changed) flag_value "$@"; changed_base="$2"; shift ;;
    --bash) flag_value "$@"; test_bash="$2"; shift ;;
    --linux) linux=1 ;;
    -h|--help) usage ;;
    -*) echo "run-script-tests: unknown option $1" >&2; usage ;;
    *) filters+=("$1") ;;
  esac
  shift
done
cd "$root" || exit 64
# --linux with nothing named: the tests the pre-push hook would run, those the changes since origin/main touch
[ "$linux" = 1 ] && [ ${#filters[@]} -eq 0 ] && [ -z "$changed_base" ] && [ -z "$tag" ] && changed_base=origin/main

# ── Discovery ──────────────────────────────────────────────────────────────────────────────────
discover() { # every self-test under the roots: path<TAB>tag<TAB>reason
  local r present=()
  for r in $Roots; do [ -d "$r" ] && present+=("$r"); done
  [ ${#present[@]} -eq 0 ] && return 0
  find "${present[@]}" \( -name node_modules -o -name build -o -name .build -o -name target \) -prune -o \
        -type f \( -name '*-test.sh' -o -name '*_test.py' \) -print \
    | LC_ALL=C sort -u \
    | while IFS= read -r path; do
        local marker
        marker="$(head -40 "$path" | sed -n 's/^#[[:space:]]*script-test:[[:space:]]*//p' | head -1)"
        if [ -n "$marker" ]; then
          printf '%s\t%s\t%s\n' "$path" "${marker%%[[:space:]]*}" "$(printf '%s' "${marker#"${marker%%[[:space:]]*}"}" | sed 's/^[[:space:]]*//')"
        else
          printf '%s\t-\t\n' "$path"
        fi
      done
}

matches_filter() { # <path>: no filters, or one names a directory above it, a substring of it, or a glob matching it
  [ ${#filters[@]} -eq 0 ] && return 0
  local f
  for f in "${filters[@]}"; do
    f="${f%/}"
    # shellcheck disable=SC2254 # the filter is a glob on purpose
    case "$1" in "$f"|"$f"/*|*"$f"*|$f) return 0 ;; esac
  done
  return 1
}

# The paths a --changed run is about: committed since leaving the base, plus uncommitted and untracked.
changed_paths() {
  git rev-parse -q --verify "$changed_base^{commit}" >/dev/null 2>&1 \
    || { echo "run-script-tests: --changed $changed_base is no commit" >&2; return 2; }
  { git diff --name-only "$changed_base...HEAD" && git diff --name-only HEAD && git ls-files --others --exclude-standard; } \
    | LC_ALL=C sort -u
}

stem() { # <file name> -> the tool name a test or tool shares, - and _ alike, extension dropped
  local n="${1%.*}"; n="${n%-test}"; n="${n%_test}"; printf '%s' "$n" | tr _ -; }

# A library's change reaches the tests of every tool that uses it, though none of them names it: what a changed file
# is sourced or imported by (bash `. f` / `source f` / `# shellcheck source=f`; python `import m` / `from m import`),
# however deep, counts as changed too. A sourced or imported name is resolved among the checkout's own scripts by file
# name, the importer's directory's alone when it has one (a module a tool finds through the sys.path it extends is
# named so too); a name none of them has (os, json) is the standard library's. One grep and one awk, whatever the size.
script_index() { # the checkout's scripts: what a source or an import can name
  # shellcheck disable=SC2086 # the roots, a word each
  { git ls-files -- $Roots; git ls-files --others --exclude-standard -- $Roots; } 2>/dev/null \
    | grep -E '\.(sh|py)$|(^|/)[^./]+$' | LC_ALL=C sort -u
}
with_their_users() { # <changed paths file> -> those paths, and every script that sources or imports one, transitively
  script_index > "$work/index"
  tr '\n' '\0' < "$work/index" | xargs -0 grep -HE \
    '^[[:space:]]*(\.|source)[[:space:]]|shellcheck[[:space:]]+source=|^[[:space:]]*(import|from)[[:space:]]+[A-Za-z_]' \
    2>/dev/null > "$work/uses"
  awk '
    function dir_of(p) { return p ~ /\// ? substr(p, 1, match(p, /\/[^\/]*$/) - 1) : "." }
    function base_of(p) { sub(/.*\//, "", p); return p }
    function use(importer, name,   d, n, i, paths) {
      d = dir_of(importer)
      if ((d "/" name) in indexed) { users[d "/" name] = users[d "/" name] " " importer; return }
      n = split(named[name], paths, " ")
      for (i = 1; i <= n; i++) if (paths[i] != importer) users[paths[i]] = users[paths[i]] " " importer
    }
    FILENAME == ARGV[1] { indexed[$0] = 1; named[base_of($0)] = named[base_of($0)] " " $0; next }
    FILENAME == ARGV[2] {
      colon = index($0, ":"); importer = substr($0, 1, colon - 1); line = substr($0, colon + 1)
      if (line ~ /^[[:space:]]*(import|from)[[:space:]]/) {
        if (importer ~ /\.sh$/) next
        sub(/^[[:space:]]*(import|from)[[:space:]]+/, "", line); match(line, /^[A-Za-z_][A-Za-z0-9_]*/)
        use(importer, substr(line, 1, RLENGTH) ".py"); next
      }
      while (match(line, /[A-Za-z0-9_.-]+\.sh/)) { use(importer, substr(line, RSTART, RLENGTH)); line = substr(line, RSTART + RLENGTH) }
      next
    }
    { if (!($0 in out)) { out[$0] = 1; queue[++tail] = $0 } }
    END {
      for (head = 1; head <= tail; head++) {
        print queue[head]
        n = split(users[queue[head]], more, " ")
        for (i = 1; i <= n; i++) if (!(more[i] in out)) { out[more[i]] = 1; queue[++tail] = more[i] }
      }
    }' "$work/index" "$work/uses" "$1"
}

# What touched_by reads, worked out once a run rather than once a test and a changed path: the changed paths, each one's
# "<dir> <stem>" (its test's, were it a tool), and a pattern a test naming it matches.
changed_keys() { # <changed paths file> -> $work/changed.keys and $work/changed.names
  awk -v keys="$work/changed.keys" -v names="$work/changed.names" '
    NF {
      dir = $0 ~ /\// ? substr($0, 1, match($0, /\/[^\/]*$/) - 1) : "."
      name = $0; sub(/.*\//, "", name)
      stem = name; sub(/\.[^.]*$/, "", stem); sub(/-test$/, "", stem); sub(/_test$/, "", stem); gsub(/_/, "-", stem)
      print dir " " stem > keys
      if (name ~ /\./) { gsub(/[.[\\*^$]/, "\\\\&", name); print "(^|[^A-Za-z0-9_.-])" name "([^A-Za-z0-9_-]|$)" > names }
    }' "$1"
  touch "$work/changed.keys" "$work/changed.names"
}

touched_by() { # <test path> <changed paths file>: the test, its tool, or a file whose name it mentions, changed
  grep -qxF "$1" "$2" && return 0
  grep -qxF "$(dirname "$1") $(stem "$(basename "$1")")" "$work/changed.keys" && return 0
  [ -s "$work/changed.names" ] && grep -qEf "$work/changed.names" "$1" 2>/dev/null
}

# ── --linux: the selected tests in a container like CI's runner ───────────────────────────────────
# CI runs these on ubuntu-26.04 (ci.yml's `test` job): GNU coreutils/sed/find/grep, a newer bash and python3. A Mac's
# BSD tools and /bin/bash 3.2 pass what Linux fails -- 03b3a6825's refit logged `sysctl machdep.cpu.brand_string`,
# macOS-only, and CI run 38772214523 failed on it. The image is ubuntu:26.04 from mirror.gcr.io (CiImageMirrorSpec:
# never Docker Hub first) plus the packages below, built once and kept, tagged by this recipe's hash. The checkout is
# mounted READ-ONLY at its own path; the tests write only to their mktemp scratch, the container's own /tmp. Its git
# metadata (config, HEAD, refs, the worktree's own dir: git_metadata_tar) is a snapshot in a tmpfs at the git dir's own
# path, only the objects mounted live (a worktree's .git file names the clone's git dir by absolute path). They run as this user, not
# root, as CI's `runner` does: root passes a chmod-000 check that fails everywhere else. The package list is what the
# runner image ships that the tests reach for -- zstd (every recording/tree archive the convergence and restore tools
# unpack), rsync (ios-release.sh pins /usr/bin/rsync) and node (local-mirror/rules-test.sh) among them: a tool the runner has and this image lacks fails
# a test here that CI passes.
LinuxImageRecipe='FROM mirror.gcr.io/library/ubuntu:26.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      bash coreutils findutils sed gawk grep diffutils git jq python3 perl curl ca-certificates unzip zip xz-utils \
      file procps lsof bc tzdata shellcheck zstd rsync nodejs > /dev/null && rm -rf /var/lib/apt/lists/* \
 && git config --system safe.directory "*"'
# <objects dir> [depth] -> every object directory it borrows from, transitively (objects/info/alternates; git follows
# five levels), each absolute and resolved: a repository reads them as its own, so a container without them cannot.
alternate_object_dirs() {
  local objects="$1" depth="${2:-0}" line dir
  [ "$depth" -lt 5 ] && [ -f "$objects/info/alternates" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; /*) dir=$line ;; *) dir="$objects/$line" ;; esac
    dir="$(cd "$dir" 2>/dev/null && pwd -P)" || continue
    echo "$dir"
    alternate_object_dirs "$dir" $((depth + 1))
  done < "$objects/info/alternates"
}
# <common dir> <git dir> -> a tar of the git metadata a checkout reads, all but the objects, relative to the common dir.
# Mounted live, the clone's shared .git/config read as missing in the container whenever a host git rewrote it (every
# agent's worktree commits through it; git writes a config.lock and renames it over): Rancher's virtiofs answered
# ENOENT for most of the next second, and git died "unknown error occurred while reading the configuration files" --
# 58 of pre-push-test.sh's checks on plain main (2026-10-28), passing alone. A file mounted over it went the same way:
# the rename invalidates that path, and the mount on it with it.
git_metadata_tar() {
  local common=$1 dir=$2 prefix entry entries=()
  for prefix in "" "${dir#"$common"/}/"; do
    [ "$prefix" = "$dir/" ] && continue # the main checkout: its git dir is the common dir
    for entry in config config.worktree HEAD ORIG_HEAD FETCH_HEAD commondir gitdir index packed-refs refs shallow info; do
      [ -e "$common/$prefix$entry" ] && entries+=("$prefix$entry")
    done
  done
  COPYFILE_DISABLE=1 tar -C "$common" --no-xattrs -cf - "${entries[@]}" # no macOS ._ files, no xattr headers
}
run_on_linux() {
  local docker image git_common git_dir alternate mounts=() selected=()
  docker=$(command -v docker || true)
  [ -z "$docker" ] && [ -x "$HOME/.rd/bin/docker" ] && docker="$HOME/.rd/bin/docker" # Rancher Desktop's
  if [ -z "$docker" ] || ! bounded 20 "$docker" info > /dev/null 2>&1; then
    echo "run-script-tests: --linux needs a running Docker (docker info failed) -- start Docker / Rancher Desktop" >&2
    return 2
  fi
  image="kinowo-script-tests:$(printf '%s' "$LinuxImageRecipe" | git hash-object --stdin | cut -c1-12)"
  if ! "$docker" image inspect "$image" > /dev/null 2>&1; then
    echo "run-script-tests: building $image (once)" >&2
    printf '%s\n' "$LinuxImageRecipe" | bounded 900 "$docker" build -q -t "$image" - > /dev/null || {
      echo "run-script-tests: could not build $image" >&2; return 2; }
  fi
  mounts=(-v "$root:$root:ro")
  git_common="$(cd "$root" && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  git_dir="$(cd "$root" && git rev-parse --path-format=absolute --git-dir 2>/dev/null)"
  [ -z "$git_common" ] || mounts+=(--mount "type=tmpfs,destination=$git_common,tmpfs-mode=1777"
    -v "$git_common/objects:$git_common/objects:ro")
  # ...and the object directories it borrows from: on ci-runner every checkout's objects/info/alternates names the
  # runner's git mirror (/git-mirror, infra forgejo.nix), which holds every object the job's fetch did not bring. Unmounted,
  # `git show HEAD:<path>` failed in here for a blob the mirror already had -- identity-measure-test.sh's "HEAD has no
  # .github/convergence-paths.txt" on the check tier (run 3260), passing wherever the mirror lagged the commit.
  if [ -n "$git_common" ]; then
    while IFS= read -r alternate; do mounts+=(-v "$alternate:$alternate:ro"); done < <(alternate_object_dirs "$git_common/objects")
  fi
  while IFS="$(printf '\t')" read -r path _; do selected+=("$path"); done < "$work/selected"
  echo "run-script-tests: ${#selected[@]} test(s) on Linux ($image)" >&2
  # each path names exactly its own test; a tag, when one selected them, keeps the tagged ones in
  # the failing logs land on the host, in the run's own log directory
  mkdir -p "$log_dir" && mounts+=(-v "$log_dir:$log_dir")
  # the snapshot comes in on stdin, unpacked before the tests start (their stdin closed, as ever)
  # shellcheck disable=SC2016 # expanded by the container's bash
  { [ -z "$git_common" ] || git_metadata_tar "$git_common" "$git_dir"; } |
    "$docker" run --rm -i --user "$(id -u):$(id -g)" -e HOME=/tmp -e TERM=dumb -e RUN_SCRIPT_TESTS_LOG_DIR="$log_dir" "${mounts[@]}" -w "$root" "$image" \
      bash -c '[ -z "$0" ] || tar -xf - -C "$0" || exit 2; exec "$@" < /dev/null' "$git_common" \
      bash scripts/run-script-tests --jobs "$jobs" --timeout "$timeout_s" ${tag:+--tag "$tag"} "${selected[@]}"
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
# where a failing test's whole log is kept (the report shows its last 60 lines)
log_dir=${RUN_SCRIPT_TESTS_LOG_DIR:-$HOME/.cache/kinowo-script-tests/failed}
if [ -n "$test_bash" ]; then
  [ -x "$test_bash" ] || { echo "run-script-tests: --bash $test_bash is no executable" >&2; exit 64; }
  mkdir "$work/bash-bin" && ln -s "$test_bash" "$work/bash-bin/bash" || exit 64
  PATH="$work/bash-bin:$PATH"; export PATH
fi
if [ -n "$changed_base" ]; then
  changed_paths > "$work/changed.direct" || exit 2
  with_their_users "$work/changed.direct" > "$work/changed"
  changed_keys "$work/changed"
fi

: > "$work/selected"
discover | while IFS="$(printf '\t')" read -r path t reason; do
  if [ -n "$tag" ]; then [ "$t" = "$tag" ] || continue
  elif [ "$all" = 0 ]; then [ "$t" = - ] || continue
  fi
  matches_filter "$path" || continue
  if [ -n "$changed_base" ]; then touched_by "$path" "$work/changed" || continue; fi
  printf '%s\t%s\t%s\n' "$path" "$t" "$reason"
done > "$work/selected"

if [ "$list" = 1 ]; then cat "$work/selected"; exit 0; fi

if [ "$linux" = 1 ]; then
  [ -s "$work/selected" ] || { echo "run-script-tests: no script tests selected${changed_base:+ by the changes since $changed_base}"; exit 0; }
  run_on_linux
  exit $?
fi

if [ ! -s "$work/selected" ]; then
  if [ -n "$changed_base" ]; then echo "run-script-tests: no script tests selected by the changes since ${changed_base}"; exit 0; fi
  echo "run-script-tests: no script test matches ${filters[*]:-the roots}${tag:+ tagged $tag}" >&2
  exit 1
fi

# A python3 below the floor fails every Python test in its own way (a TypeError on `str | None`, a SyntaxError on
# `match`); say so once, instead.
if grep -q '\.py	' "$work/selected" && ! python3 -c "import sys; sys.exit(sys.version_info < (${PythonFloor/./, }))" 2>/dev/null; then
  echo "run-script-tests: $(python3 --version 2>&1) is too old -- the Python tools need ${PythonFloor} or newer" >&2
  exit 1
fi

# ── Running ────────────────────────────────────────────────────────────────────────────────────
run_one() { # <index> <path>: its log, exit status and seconds land in $work/<index>.*
  local i="$1" path="$2" start=$SECONDS code interpreter=bash
  case "$path" in *.py) interpreter=python3 ;; esac
  # a test that times out says what it was stuck on, in its own log (the report's tail shows it)
  BOUNDED_ON_TIMEOUT="$stall_report" bounded "$timeout_s" "$interpreter" "$path" < /dev/null > "$work/$i.log" 2>&1
  code=$?
  echo "$((SECONDS - start))" > "$work/$i.seconds"
  echo "$code" > "$work/$i.rc"
}

paths=()
while IFS="$(printf '\t')" read -r path _; do paths+=("$path"); done < "$work/selected"
total=${#paths[@]}
started=$SECONDS
printf '\033[36m▸\033[0m %s script test(s), %s at a time\n' "$total" "$jobs"

pids=() idx=() next=0 done_count=0 failed=0
report() { # <index>
  local i="$1" code secs status
  code="$(cat "$work/$i.rc")"; secs="$(cat "$work/$i.seconds")"
  if [ "$code" = 0 ]; then status=PASS
  elif [ "$code" = 124 ] || [ "$code" = 137 ] || [ "$secs" -ge "$timeout_s" ]; then status=TIMEOUT
  else status=FAIL
  fi
  printf '%-7s %4ss  %s\n' "$status" "$secs" "${paths[$i]}" >> "$work/table"
  if [ "$status" != PASS ]; then
    failed=$((failed + 1))
    { printf '\n── %s %s (exit %s) ──\n' "$status" "${paths[$i]}" "$code"
      tail -60 "$work/$i.log" | sed 's/^/    /'
      # the whole log kept: a flake's 42 failures past the last 60 lines were lost once (2026-10-18, pre-push-test.sh on Linux)
      local kept; kept="$log_dir/$(date +%Y%m%d-%H%M%S)-$$-$(basename "${paths[$i]}").log"
      if mkdir -p "$log_dir" 2>/dev/null && cp "$work/$i.log" "$kept" 2>/dev/null; then printf '    (whole log: %s)\n' "$kept"; fi
    } >> "$work/failures"
  fi
}
: > "$work/table"; : > "$work/failures"
while [ "$done_count" -lt "$total" ]; do
  while [ "${#pids[@]}" -lt "$jobs" ] && [ "$next" -lt "$total" ]; do
    run_one "$next" "${paths[$next]}" &
    pids+=($!); idx+=("$next"); next=$((next + 1))
  done
  still=() still_idx=() k=0
  while [ "$k" -lt "${#pids[@]}" ]; do
    if kill -0 "${pids[$k]}" 2>/dev/null; then still+=("${pids[$k]}"); still_idx+=("${idx[$k]}")
    else wait "${pids[$k]}" 2>/dev/null; report "${idx[$k]}"; done_count=$((done_count + 1))
    fi
    k=$((k + 1))
  done
  pids=(${still[@]+"${still[@]}"}); idx=(${still_idx[@]+"${still_idx[@]}"})
  [ "$done_count" -lt "$total" ] && sleep 0.2
done

LC_ALL=C sort -k3 "$work/table"
cat "$work/failures"
echo
if [ "$failed" -gt 0 ]; then
  printf '%s of %s failed (%ss)\n' "$failed" "$total" "$((SECONDS - started))"
  exit 1
fi
printf 'all %s passed (%ss)\n' "$total" "$((SECONDS - started))"
