#!/usr/bin/env python3
"""Refuse a Bash command that pipes a test run into a filter: the pipe hides the run's exit status.

A shell pipeline's status is its LAST command's. `scripts/sbt-warm "worker/testOnly deploy.*" 2>&1 | grep FAIL | head -30`
exits 0 whatever sbt said -- grep or head decides -- and `head` cuts the summary (`Tests: ... failed 61`,
`[error] (worker / Test / testOnly) sbt.TestsFailedException`) off the end, so what is left reads as a list of FAILED
lines under a green exit. On 2026-11-08 agents took exactly that as "sbt printed *** FAILED *** yet reported success"
(the deploy specs in a worktree without infra/bin/fetch-gitops). sbt-warm, sbt and the testUnit alias all exit 1 on a
failed test; the pipe threw it away.

PreToolUse on Bash (.claude/settings.json): DENIES (exit 2, the reason on stderr) a command in which a test runner --
scripts/sbt-warm, sbt, sbtn, scripts/it-local.sh, scripts/run-script-tests, scripts/fail-before,
scripts/convergence-local.sh, scripts/page-tests-local -- runs in a pipeline stage other than the last, unless the
command keeps the runner's status (a real `set -o pipefail` / `set -euo pipefail` before the pipe -- not the word in
quoted text, not `set +o pipefail` --, or reads bash's `PIPESTATUS` or zsh's `pipestatus` -- the Bash
tool's shell is zsh). A `bash -c` / `sh -c` / `zsh -c` script is read the same way, and a prefix's options
(`timeout -s KILL 900`, `nice -n 5`, `env -u X`, `time -p`) leave the runner after them in command position. Write the run to a log and read the log:
`scripts/sbt-warm "<cmd>" > "$log" 2>&1; echo "exit=$?"; grep -E '...' "$log"`.

It reads the command, not the shell: heredoc bodies are dropped first, and a command it cannot tokenize is allowed. A
broken guard never blocks (exit 0).
"""
import os
import re
import sys
from typing import List, Optional

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from cli import hook_event  # noqa: E402
from cli.shell_words import ASSIGNMENT, SHELLS, command_words, is_punctuation  # noqa: E402

WATCHED = {
    "sbt-warm", "sbt", "sbtn", "it-local.sh", "run-script-tests", "fail-before", "convergence-local.sh",
    "page-tests-local",
}
# Words that leave the next word in command position: `timeout 900 scripts/sbt-warm ...` runs sbt-warm.
KEYWORDS = {"then", "do", "else", "elif", "if", "while", "until", "!"}
# Commands that run the command after their options; each one's options that take a value (`nice -n 5`).
PREFIXES = {"env": {"-u", "-C", "-S"}, "time": set(), "nice": {"-n"}, "exec": {"-a"}, "command": set(),
            "nohup": set(), "caffeinate": {"-t", "-w"}, "builtin": set(), "timeout": {"-s", "-k"},
            "gtimeout": {"-s", "-k"}}
TIMEOUTS = {"timeout", "gtimeout"}  # ... and a duration before the command

ADVICE = (
    "A pipeline exits with its LAST command's status, so a failed test run piped into grep/tail/head reads as exit 0 "
    "(and `head` cuts sbt's failure summary off). Write the run to a log and read the log instead: "
    "`scripts/sbt-warm \"<cmd>\" > \"$log\" 2>&1; echo \"exit=$?\"; grep -E 'FAILED|Tests:|error\\]' \"$log\"` -- "
    "or start the command with `set -o pipefail;`."
)


def set_option(pipefail: bool, previous: str, word: str) -> bool:
    """Whether pipefail is on after `word` of a `set` command, `previous` being the word before: `-o pipefail` or
    `-euo pipefail` turns it on, `+o pipefail` off, anything else leaves it."""
    if word == "pipefail" and re.fullmatch(r"[-+][A-Za-z]*o", previous):
        return previous[0] == "-"
    return pipefail


def is_help_flag(word: str) -> bool:
    return word in ("-h", "--help")


def words_of(command: str) -> Optional[List[str]]:
    """The command's words, its continuations joined; None when it cannot be tokenized or reads the pipe's status
    (a PIPESTATUS / pipestatus word, not a comment: shlex drops those)."""
    try:
        words = command_words(command)
    except ValueError:
        return None
    return None if any("pipestatus" in word.lower() for word in words) else words


PIPES = ("|", "|&")
REDIRECTIONS = ("<", ">", ">>", ">&", "<&", "&>", "&>>", "<<", "<<<", "<>", ">|")
DURATION = re.compile(r"[0-9.]+[smhd]?")
OPTION_CLUSTER = re.compile(r"-[A-Za-z]+")


class RunnerScan:
    """One pass over a command's words, remembering what the shell would: which test runner the current pipeline stage
    ends with, whether `set -o pipefail` keeps its status, and which word is next in command position.

    Per nesting depth (a `( )` or `{ }` group opens one): the watched runner whose status the current pipeline stage
    ends with (`stages`), and whether a separator (; && || & newline) has ended the stage's last command (`separated`)
    -- the next command word then starts a new one. A group's runner is its last command's, so
    `{ scripts/sbt-warm x; } | tail` counts."""

    def __init__(self) -> None:
        self.pipefail = False
        self.set_flags: Optional[str] = None  # the last option cluster of a `set` command being read, else None
        self.stages: List[Optional[str]] = [None]
        self.separated = [False]
        self.command_position = True
        self.skip_target = False  # a redirection's target is no command
        self.prefix: Optional[str] = None  # the prefix command whose options are being read
        self.skip_value = False  # ... and an option's value comes next
        self.shell_options = False  # a shell's options being read
        self.script_next = False  # ... and its -c script comes next

    def feed(self, word: str) -> Optional[str]:
        """Take the next word; the runner a pipe has just been seen to discard, or None."""
        if is_punctuation(word):
            return self.punctuation(word)
        if self.skip_target:
            self.skip_target = False
            return None
        if self.shell_options or self.script_next:
            return self.shell_word(word)
        if self.group_word(word):
            return None
        if self.set_flags is not None:  # a `set` command's words: `-euo pipefail` turns the option on, `+o pipefail` off
            self.pipefail, self.set_flags = set_option(self.pipefail, self.set_flags, word), word
        elif not self.command_position:
            self.argument(word)
        elif not self.prefix_word(word):
            self.command_word(word)
        return None

    def open_group(self) -> None:
        self.stages.append(None)
        self.separated.append(False)

    def close_group(self) -> None:
        if len(self.stages) > 1:
            inner = self.stages.pop()
            self.separated.pop()
            if self.separated[-1]:
                self.stages[-1], self.separated[-1] = None, False
            self.stages[-1] = inner or self.stages[-1]

    def punctuation(self, word: str) -> Optional[str]:
        self.prefix, self.skip_value, self.shell_options, self.script_next, self.set_flags = None, False, False, False, None
        if word == "(":
            self.open_group()
            self.command_position = True
        elif word == ")":
            self.close_group()
            self.command_position = False
        elif word in PIPES:
            if self.stages[-1] and not self.pipefail:
                return self.stages[-1]
            self.command_position = True
        elif word in REDIRECTIONS:
            self.skip_target = True
        else:  # ; && || & ;; and a newline
            self.separated[-1] = True
            self.command_position = True
        return None

    def shell_word(self, word: str) -> Optional[str]:
        """A word of `bash -c '<script>'`: the options, then the script, read as a command of its own."""
        if self.script_next:
            self.shell_options = self.script_next = False
            return masked_runner(word)
        if OPTION_CLUSTER.fullmatch(word):
            self.script_next = "c" in word
        else:
            self.shell_options = False  # a script file or `-o name`: not read
        return None

    def group_word(self, word: str) -> bool:
        """Whether `word` was a `{` (in command position) or a `}`."""
        if word == "{" and self.command_position:
            self.open_group()
            return True
        if word == "}":
            self.close_group()
            self.command_position = False
            return True
        return False

    def argument(self, word: str) -> None:
        if is_help_flag(word) and not self.separated[-1]:  # reading a runner's help runs no test
            self.stages[-1] = None

    def prefix_word(self, word: str) -> bool:
        """Whether `word` was an option (or option value) of the prefix command being read; a word that is not ends it."""
        if self.skip_value:
            self.skip_value = False
            return True
        if not self.prefix:
            return False
        if self.prefix == "command" and word in ("-v", "-V"):  # a lookup: `command -v sbt` runs nothing
            self.prefix, self.command_position = None, False
            return True
        if word.startswith("-"):
            self.skip_value = word in PREFIXES[self.prefix]
            return True
        if self.prefix in TIMEOUTS and DURATION.fullmatch(word):
            return True
        self.prefix = None
        return False

    def command_word(self, word: str) -> None:
        if ASSIGNMENT.match(word) or word in KEYWORDS:
            return
        if word in PREFIXES:
            self.prefix = word
            return
        if self.separated[-1]:
            self.stages[-1], self.separated[-1] = None, False
        name = os.path.basename(word)
        if name in WATCHED:
            self.stages[-1] = name
        self.shell_options = name in SHELLS
        if word == "set":
            self.set_flags = ""
        self.command_position = False


def masked_runner(command):
    """The test runner whose exit status a pipe in `command` discards, or None."""
    words = words_of(command)
    if words is None:
        return None
    scan = RunnerScan()
    for word in words:
        runner = scan.feed(word)
        if runner:
            return runner
    return None


def main():
    try:
        event = hook_event.read_event()
        command = event.get("tool_input", {}).get("command", "")
        runner = masked_runner(command) if isinstance(command, str) else None
    except Exception:  # a broken guard must not wedge every session
        return 0
    if runner:
        print(f"masked-exit-guard: `{runner}` is piped into another command, which hides whether it failed. {ADVICE}",
              file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
