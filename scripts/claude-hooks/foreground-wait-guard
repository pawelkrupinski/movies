#!/usr/bin/env python3
"""Refuse a long wait run in the foreground: start it with run_in_background and end the turn instead.

scripts/wait-for, scripts/ci-wait and `agentctl wait` exist to be run in the background -- the Bash tool notifies the
agent when they exit (each one's header says so, as do CLAUDE.md and the agent-ops skill). Run in the foreground they
hold the agent in a tool call it cannot leave: a week of transcripts to 2026-11-15 shows ~180 foreground wait-for calls
a week, median 173 s each (the Bash tool's timeout sliced into ~170 s polls, called again and again), 7-11 agent-hours
a week spent watching a log.

PreToolUse on Bash (.claude/settings.json): DENIES (exit 2, the reason on stderr) a call without run_in_background
whose command runs one of them in command position -- unless it is bounded to a minute or less (`--timeout 60` for
wait-for and agentctl wait, `--timeout 60s` / `--timeout 1` for ci-wait, whose bare number is minutes, or a
`timeout 60` prefix), a check that is answered at once. `--help` is allowed. A broken guard never blocks (exit 0).
"""
import os
import re
import sys
from typing import List, Optional, Tuple

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
from cli import hook_event  # noqa: E402
from cli import shell_words as shell  # noqa: E402


SHORT_WAIT_SECONDS = 60
COMMAND_START = {"then", "do", "else", "elif", "if", "while", "until", "!", "time", "nohup", "exec", "command"}

ADVICE = (
    "Start it with run_in_background=true and END YOUR TURN: the Bash tool notifies you when it exits, with its "
    "output. A foreground wait holds you in a tool call you cannot leave and burns the Bash timeout in ~170 s slices "
    "(7-11 agent-hours a week, 2026-11). For a check that should answer at once, bound it: --timeout 60 or less."
)


def seconds(value: Optional[str], bare_unit: str) -> Optional[float]:
    match = re.fullmatch(r"([0-9.]+)([smhd]?)", value or "")
    if not match:
        return None
    number, unit = float(match.group(1)), match.group(2) or bare_unit
    return number * {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]


Wait = Tuple[str, List[str], Optional[float]]  # (tool, its arguments, the seconds a `timeout` prefix bounds it to)


def waits(words: List[str]) -> List[Wait]:
    """Each (tool, its arguments, the seconds a `timeout` prefix bounds it to or None) a waiting tool runs with, in
    command position. `timeout 30 scripts/wait-for ...` is a bounded check as much as `--timeout 30` is."""
    found: List[Wait] = []
    position, prefix_timeout, bound = True, False, None
    for index, word in enumerate(words):
        if shell.is_punctuation(word):
            position = word not in ("<", ">", ">>", ">&", "<&", "&>", "&>>", "<<", "<<<", "<>", ">|")
            if position:
                prefix_timeout, bound = False, None
            continue
        if not position:
            continue
        if word in ("timeout", "gtimeout"):
            prefix_timeout = True
            continue
        if prefix_timeout and bound is None and words[index - 1] in ("-k", "--kill-after", "-s", "--signal"):
            continue  # an option's value (-s KILL, -k 5), never timeout's duration nor the command
        if re.fullmatch(r"[0-9.]+[smhd]?", word):
            # timeout's DURATION (its options come before it); 0 disables the timeout: no bound
            if prefix_timeout and bound is None:
                bound = seconds(word, "s") or None
            continue
        if word in COMMAND_START or shell.ASSIGNMENT.match(word) or word.startswith("-") or word in ("env", "nice"):
            continue  # a prefix or its option: the command is still to come
        name = os.path.basename(word)
        rest: List[str] = []
        for later in words[index + 1:]:
            if shell.is_punctuation(later):
                break
            rest.append(later)
        found.extend(waiting_tool(name, rest, bound))
        position, prefix_timeout, bound = False, False, None
    return found


def waiting_tool(name: str, arguments: List[str], bound: Optional[float]) -> List[Wait]:
    """The wait a command in command position is, if it is one: a waiting tool itself, or a shell whose -c script runs one."""
    if name in ("wait-for", "ci-wait"):
        return [(name, arguments, bound)]
    if name == "agentctl" and arguments[:1] == ["wait"]:
        return [("agentctl wait", arguments[1:], bound)]
    if name in shell.SHELLS:
        return waits_in_script(arguments, bound)
    return []


def script_of(arguments: List[str]) -> Optional[str]:
    """The script of a shell's `-c` among its leading options (`bash -c '...'`, `bash -lc '...'`), or None."""
    for index, word in enumerate(arguments):
        if not re.fullmatch(r"-[A-Za-z]+", word):
            return None  # a script file or `-o name`: not read
        if "c" in word:
            return arguments[index + 1] if index + 1 < len(arguments) else None
    return None


def waits_in_script(arguments: List[str], bound: Optional[float]) -> List[Wait]:
    """The waits a `bash -c` script runs, read as a command of its own and still held to the `timeout` prefix of the
    shell that runs it."""
    script = script_of(arguments)
    if script is None:
        return []
    try:
        words = shell.command_words(script)
    except ValueError:
        return []
    return [(name, rest, tighter(inner, bound)) for name, rest, inner in waits(words)]


def tighter(first: Optional[float], second: Optional[float]) -> Optional[float]:
    """The smaller of two bounds, where None is no bound."""
    bounds = [b for b in (first, second) if b is not None]
    return min(bounds) if bounds else None


def flag_timeout(name: str, arguments: List[str]) -> Optional[float]:
    """The seconds a `--timeout N` / `--timeout=N` among a wait tool's `arguments` bounds it to, or None."""
    limit = None
    for flag, value in zip(arguments, arguments[1:] + [""]):
        if flag.startswith("--timeout="):
            flag, value = "--timeout", flag.partition("=")[2]
        if flag == "--timeout":
            limit = seconds(value, "m" if name == "ci-wait" else "s")
    return limit


def unbounded_wait(command: str) -> Optional[str]:
    """The waiting tool `command` runs for longer than a short check, or None."""
    try:
        words = shell.command_words(command)
    except ValueError:
        return None
    for name, arguments, bound in waits(words):
        if "-h" in arguments or "--help" in arguments:
            continue
        limit = flag_timeout(name, arguments)
        if bound is not None and (limit is None or bound < limit):
            limit = bound
        if limit is None or limit > SHORT_WAIT_SECONDS:
            return name
    return None


def main():
    global shell
    try:
        event = hook_event.read_event()
        tool_input = event.get("tool_input", {})
        if tool_input.get("run_in_background") is True:
            return 0
        command = tool_input.get("command", "")
        name = unbounded_wait(command) if isinstance(command, str) else None
    except Exception:  # a broken guard must not wedge every session
        return 0
    if name:
        print(f"foreground-wait-guard: `{name}` runs in the foreground. {ADVICE}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
