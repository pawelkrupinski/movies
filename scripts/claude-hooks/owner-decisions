#!/usr/bin/env python3
"""Put agentctl's pending OWNER DECISIONS in front of the session the owner is talking to.

The owner (2026-11-16): a `RED BLOCKED ON OWNER: WAITING ON YOU: ... Answer: `! ~/bin/agentctl decide <id> "..."``
showed only in his status line; the sessions he talks to never surfaced it, so decisions sat unanswered for hours.
The orchestrator's `agentctl inbox wait --forever` Monitor was lost after every compaction and other sessions never
ran one. Run as Claude Code hooks from .claude/settings.json:

  prompt         UserPromptSubmit: reads agentctl's pending owner decisions from its snapshot's STRUCTURED `asks`
                 (state.json, written by every tick: ~/bin lib/agentctl/ask.py owner_asks -- each told ask of an
                 OWNER_ONLY category, with its question and the exact `! ~/bin/agentctl decide ...` line) and adds them
                 as context, telling the model to put each to the user verbatim at the top of its reply. Never read out
                 of inbox text (2026-11-19: an open agentctl issue QUOTING a red's "WAITING ON YOU: ..." was put to the
                 owner as a pending decision though no red waited on him). A snapshot older than STALE_SECONDS says
                 nothing. Dedupe: a block is shown once per session, again only when its question changes, after
                 REMIND_SECONDS (30 min), or after a compaction; an answered or lapsed ask leaves the snapshot by itself.
  session-start  SessionStart: after a compaction (or /clear) says to start the owner inbox notifier -- a one-shot
                 `agentctl inbox wait` under Bash run_in_background, never a Monitor (a Monitor expires after at most
                 30 minutes, so it was re-armed every half hour, 2026-11-18) -- and forgets the
                 session's shown items (the summary may have lost them); on startup/resume only in the root checkout
                 (the orchestrator's). Silent elsewhere.

Never blocks a prompt, and BOUNDED: stdin is read for at most STDIN_SECONDS (a terminal is never read: run by hand
from a shell the hook used to wait on the tty for ever) and the whole run is cut at DEADLINE_SECONDS. A missing or
stale snapshot, or garbage anywhere, prints nothing and exits 0.
Env (tests): AGENTCTL_STATE_FILE / AGENTCTL_STATE_ROOT (agentctl's own), OWNER_DECISIONS_STATE_DIR,
OWNER_DECISIONS_REMIND_SECONDS.
"""
import hashlib
import json
import os
import re
import signal
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
from processes import machine  # noqa: E402
import atomic  # noqa: E402
from cli import hook_event  # noqa: E402

STATE_DIR = machine.environment().get("OWNER_DECISIONS_STATE_DIR", os.path.expanduser("~/.cache/claude-owner-decisions"))
REMIND_SECONDS = float(machine.environment().get("OWNER_DECISIONS_REMIND_SECONDS", 30 * 60))
STATE_TTL_SECONDS = 7 * 24 * 3600
STALE_SECONDS = 3600     # a snapshot no tick (or mirror) refreshed for this long is not believed
STDIN_SECONDS = 2
DEADLINE_SECONDS = 4     # under the 5 s hook timeout in .claude/settings.json
NOTIFIER = "~/bin/agentctl inbox wait --since-ack --audience owner --timeout 43200"


def emit(event, text):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}}))


def state_path(session):
    return os.path.join(STATE_DIR, re.sub(r"[^A-Za-z0-9_.-]", "_", session) + ".json")


def load_state(session):
    try:
        with open(state_path(session)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(session, state):
    atomic.write_json(state_path(session), state)
    now = machine.wall()
    for name in os.listdir(STATE_DIR):  # a session's file outlives it; a week is plenty
        path = os.path.join(STATE_DIR, name)
        try:
            if now - os.path.getmtime(path) > STATE_TTL_SECONDS:
                os.remove(path)
        except OSError:
            pass


def snapshot_path():
    if machine.environment().get("AGENTCTL_STATE_FILE"):
        return machine.environment()["AGENTCTL_STATE_FILE"]
    return os.path.join(machine.environment().get("AGENTCTL_STATE_ROOT") or os.path.expanduser("~/.cache/agentctl"), "state.json")


def pending_decisions(now):
    """The told owner asks of agentctl's snapshot (state.json `asks`), [] when it has none, is stale or unreadable."""
    try:
        with open(snapshot_path()) as f:
            snap = json.load(f)
        fresh = max(float(snap.get(k) or 0) for k in ("tick_at", "fetched_at"))
        asks = snap.get("asks") or []
    except (OSError, ValueError, TypeError, AttributeError):
        return []
    if now - fresh > STALE_SECONDS or not isinstance(asks, list):
        return []
    return [a for a in asks if isinstance(a, dict) and a.get("q") and a.get("how")]


def describe(ask):
    reds = ", ".join(str(r) for r in ask.get("reds") or []) or ", ".join(str(k) for k in ask.get("keys") or [])
    lines = ["- WAITING ON YOU [%s]: %s%s" % (ask.get("category"), reds + ": " if reds else "", str(ask["q"])[:600]),
             "  How: " + str(ask["how"])[:400]]
    if ask.get("until"):
        lines.append("  Auto-clears when " + str(ask["until"])[:200])
    return "\n".join(lines)


def prompt(hook):
    session = str(hook.get("session_id") or "unknown")
    state, now, shown = load_state(session), machine.wall(), []
    for ask in pending_decisions(now):
        key = str(ask.get("block") or ask.get("keys"))
        digest = hashlib.sha1(json.dumps([ask.get("q"), ask.get("how"), ask.get("keys")]).encode()).hexdigest()[:16]
        seen = state.get(key)
        if seen and seen.get("digest") == digest and now - seen.get("at", 0) < REMIND_SECONDS:
            continue
        state[key] = {"at": now, "digest": digest}
        shown.append(describe(ask))
    if not shown:
        return
    save_state(session, state)
    emit("UserPromptSubmit",
         "agentctl has %d decision(s) waiting on the owner (the user). Put each one to the user verbatim at the top of "
         "your reply, before anything else -- the question, why, and the exact `! ...` answer command for them to "
         "run -- then carry on with their message:\n%s" % (len(shown), "\n".join(shown)))


def in_root_checkout(cwd):
    def rev(flag):
        r = subprocess.run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", flag],
                           capture_output=True, text=True, timeout=5, env=dict(machine.environment(), GIT_OPTIONAL_LOCKS="0"))
        return os.path.realpath(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
    git_dir = rev("--git-dir")
    return git_dir is not None and git_dir == rev("--git-common-dir")


def session_start(hook):
    source, cwd = hook.get("source"), hook.get("cwd") or os.getcwd()
    if source in ("compact", "clear"):
        try:
            os.remove(state_path(str(hook.get("session_id") or "unknown")))
        except OSError:
            pass
    elif not (source in ("startup", "resume") and in_root_checkout(cwd)):
        return
    emit("SessionStart",
         "Start the owner inbox notifier now unless one is running: run `%s` with Bash run_in_background=true, not "
         "as a Monitor (a Monitor expires after 30 minutes and needs re-arming; this waits up to 12 h and costs "
         "nothing). It exits, waking you, on the first new owner item: triage and ack each entry it printed, then "
         "start it again. Pending owner decisions are also added to each prompt by "
         "scripts/claude-hooks/owner-decisions." % NOTIFIER)


def give_up(_signum, _frame):
    os._exit(0)


def main():
    signal.signal(signal.SIGALRM, give_up)
    signal.alarm(DEADLINE_SECONDS)
    try:
        hook = hook_event.read_event(STDIN_SECONDS)
        {"prompt": prompt, "session-start": session_start}[sys.argv[1]](hook)
    except Exception:  # a broken hook must never wedge a prompt
        pass


if __name__ == "__main__":
    main()
    sys.exit(0)
