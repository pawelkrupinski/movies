#!/bin/sh
# Purpose: Mutation testing of the methods a change touches (Stryker4s; a report, never a gate; a name for mutation_check.py)
# MUTATION TESTING OF THE METHODS A CHANGE TOUCHES -- the name its callers run: scripts/mutation_check.py is the tool,
# its header (`--help`) says what it does, and how.
exec python3 "$(dirname "$0")/mutation_check.py" "$@"
