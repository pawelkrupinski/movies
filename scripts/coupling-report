#!/usr/bin/env bash
# THE COUPLING REPORT (CLAUDE.md, Design rules): the production code's coupling, from Zinc's class-dependency record
# and, between the classes of one source file, their class files (`sbt couplingReport`, project/Coupling.scala), through this checkout's kept sbt server (scripts/sbt-warm).
#
#   scripts/coupling-report             the markdown report (module matrix, packages' Ca/Ce/I/A/D, package cycles with
#                                       the class references behind every edge, top fan-in/fan-out classes, god hubs,
#                                       split packages) to stdout, then the ratchet's verdict against the baseline
#   scripts/coupling-report --update    the same, then the measured rows written to test/resources/coupling-baseline.tsv:
#                                       every fall recorded; a rise must be committed with `Coupling: <why>`; each
#                                       frozen distance row's ceiling kept (`distance-cap`, only falling; over a
#                                       conflicted baseline the least of every side's); and
#                                       each frozen class's reference set to test/resources/coupling-fanout-refs.tsv
#                                       (what a later `Coupling: split of <X>` claim is held to)
#   scripts/coupling-report --out DIR   keep rows.tsv, report.md, edges.tsv (every package edge's class references) and
#                                       fanouts.tsv (every class's held fan-out) in DIR
#                                       (default: a temporary directory)
#   scripts/coupling-report --check-split <X> <piece>... [--base REV]
#                                       whether the ratchet would accept the WORKING TREE's split of frozen class X
#                                       into those pieces under the current rule (each piece below X's row, their
#                                       references' union within X's at REV -- default the merge base with
#                                       origin/main -- and the distance rows it moves, each with its ceiling and the
#                                       headroom left under it), and the `Coupling: split of`
#                                       trailer to use: scripts/ci/coupling_ratchet.py split-check, the ratchet's own
#                                       code. Exit 0 accepted, 1 refused.
#
# The pre-push hook's `coupling` check runs the same task and scripts/ci/coupling_ratchet.py over the pushed range.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
update="" out="" split="" base=""
pieces=()
while [ $# -gt 0 ]; do
    case "$1" in
        --update) update=1 ;;
        --out) out="$2"; shift ;;
        --base) base="$2"; shift ;;
        --check-split)
            [ $# -ge 3 ] || { echo "coupling-report: --check-split <X> <piece>..." >&2; exit 2; }
            split="$2"; shift 2
            while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do pieces+=("$1"); shift; done
            [ ${#pieces[@]} -gt 0 ] || { echo "coupling-report: --check-split <X> needs at least one piece" >&2; exit 2; }
            continue ;;
        -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "coupling-report: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
if [ -z "$out" ]; then out="$(mktemp -d)"; trap 'rm -rf "$out"' EXIT; fi
mkdir -p "$out"
cd "$root"
"$root/scripts/sbt-warm" "couplingReport $out/rows.tsv $out/report.md $out/edges.tsv $out/fanouts.tsv" > "$out/sbt.log" 2>&1 \
    || { tail -30 "$out/sbt.log" >&2; echo "coupling-report: sbt couplingReport failed (log: $out/sbt.log)" >&2; exit 2; }
if [ -n "$split" ]; then
    args=(split-check --current "$out/rows.tsv" --fanouts "$out/fanouts.tsv" --split "$split")
    for p in "${pieces[@]}"; do args+=(--into "$p"); done
    [ -z "$base" ] || args+=(--base "$base")
    rc=0
    python3 "$root/scripts/ci/coupling_ratchet.py" "${args[@]}" || rc=$?
    exit "$rc"
fi
cat "$out/report.md"
echo
rc=0
python3 "$root/scripts/ci/coupling_ratchet.py" check --current "$out/rows.tsv" --edges "$out/edges.tsv" --fanouts "$out/fanouts.tsv" || rc=$?
if [ -n "$update" ]; then
    python3 "$root/scripts/ci/coupling_ratchet.py" update --current "$out/rows.tsv" --baseline test/resources/coupling-baseline.tsv
    python3 "$root/scripts/ci/coupling_ratchet.py" refs --current "$out/rows.tsv" --fanouts "$out/fanouts.tsv" \
        > "$root/test/resources/coupling-fanout-refs.tsv"
    echo "coupling-report: wrote test/resources/coupling-baseline.tsv and coupling-fanout-refs.tsv -- a rise is committed with a \`Coupling: <why>\` trailer"
    exit 0
fi
exit "$rc"
