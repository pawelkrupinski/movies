#!/usr/bin/env bash
#
# Proves the commit gate: a test that FAILS before the change and PASSES after it.
#
#   scripts/fail-before [<commit>] [--files <glob>]... [--ci | --local] -- <test command...>
#
# <commit> (default HEAD) is the change under test. Two throwaway detached worktrees are made:
#   BEFORE  <commit>'s parent, with ONLY the commit's test-side files copied over from <commit>
#           (so the new test meets the old production code);
#   AFTER   <commit> itself.
# The command (one argument: a shell line, run through `bash -c`; several: one command, each argument kept whole), run
# from the worktree's root, must FAIL in BEFORE and PASS in AFTER.
#   FAIL-BEFORE: yes|no     PASS-AFTER: yes|no     (and the tail of each output)
# Exit 0 only for yes/yes; 1 otherwise; 2 for a usage or setup error, or a run that timed out (no verdict).
#
# TEST-SIDE FILES (the only ones copied into BEFORE): the source and resource directories of the build's TEST
# configurations, *_test.py, *-test.sh, test/resources/**, .claude/**. Which src/ directories are test-side is read
# from <commit>'s build.sbt, not listed here: `Test` and every `config(...)` extending it (src/test, src/it,
# src/page, or the directory its `scalaSource`/`resourceDirectory` names). A configuration extending `Compile` --
# src/fixtures, the replay wirings and fixture-archive code the tests drive -- is code under test and stays at the
# parent: copied, a fix living there met its test in BEFORE and proved nothing. --files <glob> (repeatable; a shell
# `case` pattern over the repo-relative path, `*` crosses `/`) replaces that default list.
#
# SBT: a command that goes through scripts/sbt-warm runs against each worktree's own kept server (the
# worktree's own copy of the script); both servers are stopped afterwards. A cold worktree compiles from
# the seed, so expect minutes: the caller's checkout when it is at <commit> and built (KINOWO_SBT_WARM_SEED, unless
# set) — AFTER is its very sources and BEFORE differs from them by the commit's production files alone, where the
# newest build of an older main commit cost a recompile of every commit since (6-9 min a run, 2026-10-18).
#
# ON CI (the owner, 2026-11-18: heavy local proofs go to ci-runner's measure lane): --ci runs both on ci-runner instead
# (scripts/ci-sbt, through identity-run.yml), side by side -- BEFORE as a commit of the parent's tree with the same
# test-side files laid over it, AFTER as <commit> -- for a command that is ONE scripts/sbt-warm call (its sbt commands
# run there as `sbt -batch "<a>; <b>"`). The proof is as strong as the local one: each side's verdict is that run's
# "Run the command" step, the sbt command's own exit (a test or compile failure fails; passing passes), and a run that
# gives none -- a setup step failed, cancelled, timed out -- is no verdict (exit 2), never a "fails before". --local
# runs here. Neither: KINOWO_FAIL_BEFORE_ROUTE (auto | local | ci), auto by default -- on CI when the command can go
# there, the laptop's governor would hold its two runs now and the measure lane is free (scripts/jvm-gate.sh
# jvm_route: `agentctl gov route`), else here. The local runs stay local inside (KINOWO_SBT_WARM_ROUTE=local).
# KINOWO_CI_SBT names scripts/ci-sbt (the tests' seam).
#
# SAFETY: the caller's worktree is never touched. The worktrees live in $KINOWO_FAIL_BEFORE_DIR (default
# ~/.cache/kinowo-fail-before), are removed by a trap, and are the only change to the shared .git (its
# worktree list). Every GIT_* variable is dropped first, so a hook's exported GIT_DIR cannot redirect git
# (see scripts/scratch-git.sh). KINOWO_FAIL_BEFORE_TIMEOUT (seconds, default 3000) bounds each run, its
# whole process group (an sbt-forked JVM too): a run past it is ended and gives no verdict.
set -uo pipefail

while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_')

# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
# shellcheck source=scripts/jvm-gate.sh
. "$(dirname "$0")/jvm-gate.sh"
# The exit contract above: a setup that fails gives no verdict, 2, as a usage slip does (tool-conventions.sh's die).
# shellcheck disable=SC2034 # read by tool-conventions.sh (die, usage_error)
DIE_STATUS=2

commit=HEAD
patterns=()
route=${KINOWO_FAIL_BEFORE_ROUTE:-auto}
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --files) flag_value "$@"; patterns+=("$2"); shift 2 ;;
    --ci) route=ci; shift ;;
    --local) route=local; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) usage_error "unknown option $1" ;;
    *) commit=$1; shift ;;
  esac
done
[ $# -gt 0 ] || usage_error "usage: scripts/fail-before [<commit>] [--files <glob>]... [--ci | --local] -- <test command...>"
case "$route" in auto|local|ci) ;; *) usage_error "KINOWO_FAIL_BEFORE_ROUTE is auto, local or ci, not $route" ;; esac
# One argument is a shell line, run as written ('a && b'); several are ONE command, each argument kept whole -- joined
# bare they were split again by `bash -c`, and `scripts/sbt-warm "identity/testOnly X -- -z some case"` ran the whole module.
if [ $# -eq 1 ]; then command_line=$1; else command_line=$(printf '%q ' "$@"); fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git checkout"
sha=$(git -C "$top" rev-parse --verify -q "$commit^{commit}") || die "no such commit: $commit"
parent=$(git -C "$top" rev-parse --verify -q "$sha^") || die "$commit has no parent"

# The src/ directories of the build's test configurations, one per line: `test`, every `lazy val X = config("x")
# extend Y` whose Y is Test or another such configuration (its sbt default src/x), and any directory such a
# configuration's `X / scalaSource` / `javaSource` / `resourceDirectory` names. Read from <commit>'s build.sbt
# (none: sbt's default, src/test alone).
test_source_directories() {
  local build line test_vals=" Test " grew=1
  build=$(git -C "$top" show "$sha:build.sbt" 2>/dev/null) || build=""
  echo test
  local config_re='lazy val ([A-Za-z0-9_]+) *= *config\("([A-Za-z0-9_-]+)"\) *extend\(? *([A-Za-z0-9_]+)'
  while [ "$grew" = 1 ]; do # a configuration may extend one declared after it: repeat until none joins
    grew=0
    while IFS= read -r line; do
      if [[ $line =~ $config_re ]] && [[ $test_vals == *" ${BASH_REMATCH[3]} "* ]] && [[ $test_vals != *" ${BASH_REMATCH[1]} "* ]]; then
        test_vals="$test_vals${BASH_REMATCH[1]} "; echo "${BASH_REMATCH[2]}"; grew=1
      fi
    done <<< "$build"
  done
  local override_re='([A-Za-z0-9_]+) */ *(scalaSource|javaSource|resourceDirectory) *:= *baseDirectory\.value */ *"src" */ *"([^"]+)"'
  while IFS= read -r line; do
    if [[ $line =~ $override_re ]] && [[ $test_vals == *" ${BASH_REMATCH[1]} "* ]]; then echo "${BASH_REMATCH[3]}"; fi
  done <<< "$build"
}
if [ ${#patterns[@]} -eq 0 ]; then
  while IFS= read -r directory; do patterns+=("*/src/$directory/*"); done < <(test_source_directories | sort -u)
  patterns+=('*_test.py' '*-test.sh' 'test/resources/*' '.claude/*')
fi

# The commit's test-side files: the only ones BEFORE takes from <commit>.
test_paths=()
while IFS= read -r path; do
  [ -n "$path" ] || continue
  for p in "${patterns[@]}"; do case "$path" in $p) test_paths+=("$path"); break ;; esac; done
# unquoted: git quotes a path that is not ASCII ("k\303\266ln"), which no pattern matches
done < <(git -C "$top" -c core.quotePath=false diff-tree --no-commit-id --name-only -r --diff-filter=AMCR "$sha")
[ "${#test_paths[@]}" -gt 0 ] || die "$sha changes no test-side file (see --files): nothing to prove"

# sbt_command_of <test command...> -> the sbt command line ("a; b") of a test command that is one scripts/sbt-warm call;
# 1 for anything else (a shell line of several commands, a pipe, a redirect, an sbt-warm flag)
sbt_command_of() {
  python3 -I - "$@" <<'PY'
import os, shlex, sys
args = sys.argv[1:]
if len(args) == 1:
    lex = shlex.shlex(args[0], posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    try:
        args = list(lex)
    except ValueError:
        sys.exit(1)
    if any(t and set(t) <= set("();<>|&") for t in args):
        sys.exit(1)
if len(args) < 2 or os.path.basename(args[0]) != "sbt-warm" or any(a.startswith("--") for a in args[1:]):
    sys.exit(1)
print("; ".join(args[1:]))
PY
}
sbt_command=$(sbt_command_of "$@") || sbt_command=""
if [ "$route" = ci ] && [ -z "$sbt_command" ]; then
  die "--ci runs a command that is one scripts/sbt-warm call (its sbt commands go to sbt -batch on CI); this is not: $command_line"
fi
if [ "$route" = auto ]; then
  route=local
  if [ -n "$sbt_command" ] && [ "$(jvm_route testUnit)" = ci ]; then
    route=ci
    echo "fail-before: the governor would hold two local runs now and ci-runner's measure lane is free: both run there (--local runs here)" >&2
  fi
fi

# BEFORE as a commit (for CI): <commit>'s parent's tree with the test-side files of <commit> laid over it
before_commit() {
  local index tree path entry
  index=$(mktemp) || return 1
  GIT_INDEX_FILE=$index git -C "$top" read-tree "$parent" || { rm -f "$index"; return 1; }
  for path in "${test_paths[@]}"; do
    entry=$(git -C "$top" ls-tree "$sha" -- "$path") || { rm -f "$index"; return 1; }
    # "<mode> blob <object>\t<path>": the mode (an executable test stays one) and the object as <commit> has them
    GIT_INDEX_FILE=$index git -C "$top" update-index --add --cacheinfo "$(echo "$entry" | awk '{ print $1 "," $3 }'),$path" ||
      { rm -f "$index"; return 1; }
  done
  tree=$(GIT_INDEX_FILE=$index git -C "$top" write-tree); rm -f "$index"
  [ -n "$tree" ] || return 1
  git -C "$top" commit-tree "$tree" -p "$parent" -m "fail-before: BEFORE of $(git -C "$top" rev-parse --short "$sha") (its parent and its test-side files)"
}

verdict() { # <before rc> <after rc> <before log> <after log>
  local fail_before pass_after
  fail_before=$([ "$1" -ne 0 ] && echo yes || echo no)
  pass_after=$([ "$2" -eq 0 ] && echo yes || echo no)
  printf '\n--- BEFORE (exit %s), last lines ---\n' "$1"; tail -n 15 "$3"
  printf '\n--- AFTER (exit %s), last lines ---\n' "$2"; tail -n 15 "$4"
  printf '\nFAIL-BEFORE: %s\nPASS-AFTER: %s\n' "$fail_before" "$pass_after"
  [ "$fail_before" = yes ] && [ "$pass_after" = yes ]
}

if [ "$route" = ci ]; then
  ci_sbt=${KINOWO_CI_SBT:-$(dirname "$0")/ci-sbt}   # the tests' seam
  logs=$(mktemp -d) || die "cannot create a log directory"
  trap 'rm -rf "$logs"' EXIT
  bc=$(before_commit) || die "cannot make the BEFORE commit"
  printf 'fail-before: %s (%d test-side file(s) laid onto %s) on CI: sbt %s\n' "$sha" "${#test_paths[@]}" \
    "$(git -C "$top" rev-parse --short "$parent")" "$sbt_command"
  (cd "$top" && "$ci_sbt" --commit "$bc" --log "$logs/before.log" -- "$sbt_command") 2> "$logs/before.err" &
  before_pid=$!
  (cd "$top" && "$ci_sbt" --commit "$sha" --log "$logs/after.log" -- "$sbt_command") 2> "$logs/after.err" &
  after_pid=$!
  before_rc=0; wait "$before_pid" || before_rc=$?
  after_rc=0; wait "$after_pid" || after_rc=$?
  cat "$logs/before.err" "$logs/after.err" >&2
  touch "$logs/before.log" "$logs/after.log"
  # ci-sbt's 2 is no verdict: the run did not get to say what the command did
  if [ "$before_rc" -eq 2 ] || [ "$after_rc" -eq 2 ]; then
    die "a CI run gave no verdict (BEFORE exit $before_rc, AFTER exit $after_rc: a setup step failed, cancelled or timed out) -- no verdict, as a local timeout"
  fi
  verdict "$before_rc" "$after_rc" "$logs/before.log" "$logs/after.log"
  exit $?
fi

base=${KINOWO_FAIL_BEFORE_DIR:-$HOME/.cache/kinowo-fail-before}
mkdir -p "$base" || die "cannot create $base"
work=$(mktemp -d "$base/run.XXXXXX") || die "cannot create a work directory"
before="$work/before" after="$work/after"

stop_servers() { # <worktree>
  case "$command_line" in
    *sbt-warm*) if [ -x "$1/scripts/sbt-warm" ]; then (cd "$1" && scripts/sbt-warm --stop) >/dev/null 2>&1; fi ;;
  esac
  return 0
}
cleanup() {
  for wt in "$before" "$after"; do
    stop_servers "$wt"
    git -C "$top" worktree remove --force "$wt" >/dev/null 2>&1
  done
  git -C "$top" worktree prune >/dev/null 2>&1
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

git -C "$top" worktree add -q --detach "$before" "$parent" >/dev/null 2>&1 || die "cannot make the BEFORE worktree"
git -C "$top" worktree add -q --detach "$after" "$sha" >/dev/null 2>&1 || die "cannot make the AFTER worktree"

copied=0
for path in "${test_paths[@]}"; do
  mkdir -p "$before/$(dirname "$path")"
  git -C "$top" show "$sha:$path" > "$before/$path" || die "cannot copy $path"
  if [ -x "$after/$path" ]; then chmod +x "$before/$path"; fi
  copied=$((copied + 1))
done

# Each run bounded (tool-conventions.sh's `bounded`): in a process group of its own, ended whole at the deadline (exit
# 124) — the JVM an sbt test forks too, not just the shell — and on fail-before's own INT/TERM.
# The nearest seed of both: the caller's own build of <commit>.
seed=${KINOWO_SBT_WARM_SEED:-}
if [ -z "$seed" ] && [ "$(git -C "$top" rev-parse HEAD)" = "$sha" ] && compgen -G "$top/*/target/scala-*/zinc" > /dev/null; then
  seed=$top
fi
run_in() { # <worktree> <log>
  (cd "$1" && { [ -z "$seed" ] || export KINOWO_SBT_WARM_SEED="$seed"; } && export KINOWO_SBT_WARM_ROUTE=local && bounded "${KINOWO_FAIL_BEFORE_TIMEOUT:-3000}" bash -c "$command_line") > "$2" 2>&1
}

printf 'fail-before: %s (%d test-side file(s) copied onto %s)\n' "$sha" "$copied" "$(git -C "$top" rev-parse --short "$parent")"
run_in "$before" "$work/before.log"; before_rc=$?
run_in "$after" "$work/after.log"; after_rc=$?

for rc in "$before_rc" "$after_rc"; do
  [ "$rc" -ne 124 ] && continue
  printf '\n--- BEFORE (exit %s) ---\n' "$before_rc"; tail -n 15 "$work/before.log"
  printf '\n--- AFTER (exit %s) ---\n' "$after_rc"; tail -n 15 "$work/after.log"
  die "a run timed out after ${KINOWO_FAIL_BEFORE_TIMEOUT:-3000}s (exit 124): no verdict — a hang is not a failure"
done
verdict "$before_rc" "$after_rc" "$work/before.log" "$work/after.log"
