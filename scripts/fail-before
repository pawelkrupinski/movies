#!/usr/bin/env bash
#
# Proves the commit gate: a test that FAILS before the change and PASSES after it.
#
#   scripts/fail-before [<commit>] [--files <glob>]... -- <test command...>
#
# <commit> (default HEAD) is the change under test. Two throwaway detached worktrees are made:
#   BEFORE  <commit>'s parent, with ONLY the commit's test-side files copied over from <commit>
#           (so the new test meets the old production code);
#   AFTER   <commit> itself.
# The command (one argument: a shell line, run through `bash -c`; several: one command, each argument kept whole), run
# from the worktree's root, must FAIL in BEFORE and PASS in AFTER.
#   FAIL-BEFORE: yes|no     PASS-AFTER: yes|no     (and the tail of each output)
# Exit 0 only for yes/yes; 1 otherwise; 2 for a usage or setup error, or a run that timed out (no verdict).
#
# TEST-SIDE FILES (the only ones copied into BEFORE): */src/test|it|fixtures/**, *_test.py, *-test.sh,
# test/resources/**, .claude/**. --files <glob> (repeatable; a shell `case` pattern over the repo-relative
# path, `*` crosses `/`) replaces that default list.
#
# SBT: a command that goes through scripts/sbt-warm runs against each worktree's own kept server (the
# worktree's own copy of the script); both servers are stopped afterwards. A cold worktree compiles from
# the seed, so expect minutes.
#
# SAFETY: the caller's worktree is never touched. The worktrees live in $KINOWO_FAIL_BEFORE_DIR (default
# ~/.cache/kinowo-fail-before), are removed by a trap, and are the only change to the shared .git (its
# worktree list). Every GIT_* variable is dropped first, so a hook's exported GIT_DIR cannot redirect git
# (see scripts/scratch-git.sh). KINOWO_FAIL_BEFORE_TIMEOUT (seconds, default 3000) bounds each run, its
# whole process group (an sbt-forked JVM too): a run past it is ended and gives no verdict.
set -uo pipefail

while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_')

# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
# The exit contract above: a setup that fails gives no verdict, 2, as a usage slip does (tool-conventions.sh's die).
DIE_STATUS=2

commit=HEAD
patterns=()
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --files) [ $# -ge 2 ] || usage_error "--files needs a glob"; patterns+=("$2"); shift 2 ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) usage_error "unknown option $1" ;;
    *) commit=$1; shift ;;
  esac
done
[ $# -gt 0 ] || usage_error "usage: scripts/fail-before [<commit>] [--files <glob>]... -- <test command...>"
# One argument is a shell line, run as written ('a && b'); several are ONE command, each argument kept whole -- joined
# bare they were split again by `bash -c`, and `scripts/sbt-warm "identity/testOnly X -- -z some case"` ran the whole module.
if [ $# -eq 1 ]; then command_line=$1; else command_line=$(printf '%q ' "$@"); fi
[ ${#patterns[@]} -gt 0 ] || patterns=('*/src/test/*' '*/src/it/*' '*/src/fixtures/*' '*_test.py' '*-test.sh' 'test/resources/*' '.claude/*')

top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git checkout"
sha=$(git -C "$top" rev-parse --verify -q "$commit^{commit}") || die "no such commit: $commit"
parent=$(git -C "$top" rev-parse --verify -q "$sha^") || die "$commit has no parent"

base=${KINOWO_FAIL_BEFORE_DIR:-$HOME/.cache/kinowo-fail-before}
mkdir -p "$base" || die "cannot create $base"
work=$(mktemp -d "$base/run.XXXXXX") || die "cannot create a work directory"
before="$work/before" after="$work/after"

stop_servers() { # <worktree>
  case "$command_line" in
    *sbt-warm*) if [ -x "$1/scripts/sbt-warm" ]; then (cd "$1" && scripts/sbt-warm --stop) >/dev/null 2>&1; fi ;;
  esac
  return 0
}
cleanup() {
  for wt in "$before" "$after"; do
    stop_servers "$wt"
    git -C "$top" worktree remove --force "$wt" >/dev/null 2>&1
  done
  git -C "$top" worktree prune >/dev/null 2>&1
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

git -C "$top" worktree add -q --detach "$before" "$parent" >/dev/null 2>&1 || die "cannot make the BEFORE worktree"
git -C "$top" worktree add -q --detach "$after" "$sha" >/dev/null 2>&1 || die "cannot make the AFTER worktree"

copied=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  match=0
  for p in "${patterns[@]}"; do case "$path" in $p) match=1; break ;; esac; done
  [ "$match" = 1 ] || continue
  mkdir -p "$before/$(dirname "$path")"
  git -C "$top" show "$sha:$path" > "$before/$path" || die "cannot copy $path"
  if [ -x "$after/$path" ]; then chmod +x "$before/$path"; fi
  copied=$((copied + 1))
done < <(git -C "$top" diff-tree --no-commit-id --name-only -r --diff-filter=AMCR "$sha")
[ "$copied" -gt 0 ] || die "$sha changes no test-side file (see --files): nothing to prove"

# Each run bounded (tool-conventions.sh's `bounded`): in a process group of its own, ended whole at the deadline (exit
# 124) — the JVM an sbt test forks too, not just the shell — and on fail-before's own INT/TERM.
run_in() { # <worktree> <log>
  (cd "$1" && bounded "${KINOWO_FAIL_BEFORE_TIMEOUT:-3000}" bash -c "$command_line") > "$2" 2>&1
}

printf 'fail-before: %s (%d test-side file(s) copied onto %s)\n' "$sha" "$copied" "$(git -C "$top" rev-parse --short "$parent")"
run_in "$before" "$work/before.log"; before_rc=$?
run_in "$after" "$work/after.log"; after_rc=$?

for rc in "$before_rc" "$after_rc"; do
  [ "$rc" -ne 124 ] && continue
  printf '\n--- BEFORE (exit %s) ---\n' "$before_rc"; tail -n 15 "$work/before.log"
  printf '\n--- AFTER (exit %s) ---\n' "$after_rc"; tail -n 15 "$work/after.log"
  die "a run timed out after ${KINOWO_FAIL_BEFORE_TIMEOUT:-3000}s (exit 124): no verdict — a hang is not a failure"
done
fail_before=$([ "$before_rc" -ne 0 ] && echo yes || echo no)
pass_after=$([ "$after_rc" -eq 0 ] && echo yes || echo no)
printf '\n--- BEFORE (exit %s), last lines ---\n' "$before_rc"; tail -n 15 "$work/before.log"
printf '\n--- AFTER (exit %s), last lines ---\n' "$after_rc"; tail -n 15 "$work/after.log"
printf '\nFAIL-BEFORE: %s\nPASS-AFTER: %s\n' "$fail_before" "$pass_after"
[ "$fail_before" = yes ] && [ "$pass_after" = yes ]
