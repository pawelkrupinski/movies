#!/bin/sh
# Purpose: The fast precheck: before `agentctl land` queues a change, the cheap reasons the landing check would reject it, here
# The name agentctl runs (it checks scripts/land-precheck is executable) and the skills and docs name: scripts/land_precheck.py is the tool (its header says what it does).
exec python3 "$(dirname "$0")/land_precheck.py" "$@"
