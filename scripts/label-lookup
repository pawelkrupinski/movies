#!/usr/bin/env python3
"""Every hand judgement touching one listing or one film, with who added it and when, and what prod takes today.

  scripts/label-lookup <cc> --title T [--venue V] [--no-prod] [--no-history] [--root DIR]
  scripts/label-lookup <cc> --film tmdb:N [--no-prod] [--no-history] [--root DIR]

Reads, for the country:
  identity-judgements.tsv     test/resources/fixtures/ (every judgement: its verdict, state, scope, reason, evidence)
  expected-matches.tsv        test/resources/fixtures/identity-unmatched/ (the ratchet's regenerated right takes)
each entry with its verdict, note, and the commit and date that last changed its line (git blame).

  --title   the listing's raw title, single-spaced as every judgement file keys it; exact when any file holds it so,
            else every title holding it (case and accents aside)
  --venue   the venue: a line for every venue ("*") covers it too, and the venue's own RIGHT overrules "*"'s WRONG
            (identity_judgements.label_of, the reading every gate shares); the effective verdict per film is printed
  --film    every entry naming that film, in any file
  --no-prod skip what prod takes now: the local prod mirror's identity_traces (mongodb://127.0.0.1:28017,
            kinowo[_<cc>]_prod_mirror, read-only; $LOCAL_MIRROR_PORT overrides), its freshness checked first by
            scripts/local-mirror/freshness
Conflicts are the identity judgements lint's own findings (scripts/ci/identity_judgements_lint.py) that touch the
listing or film; the policy's exceptions (accepted-right-loss) are named as notes.
"""

import argparse
import json
import os
import re
import sys
import unicodedata
from collections import defaultdict
from datetime import datetime, timezone
from typing import Any, Dict, List, Mapping, Optional, Set, Tuple

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "lib"))
sys.path.insert(0, os.path.join(HERE, "ci"))
from processes import machine  # noqa: E402
import tool_git  # noqa: E402
import tool_process  # noqa: E402
from seams.tool_files import Files  # noqa: E402
import identity_judgements as store  # noqa: E402  (the one reader of the judgements)
import identity_judgements_lint as lint  # noqa: E402  (the lint's rules, never a copy of them)
import identity_takes as takes  # noqa: E402  (the one reader of the take files)
from identity_judgements import label_of, normalise as single_spaced  # noqa: E402


def folded(s: str) -> str:
    s = unicodedata.normalize("NFKD", single_spaced(s).replace("ł", "l").replace("Ł", "L").lower())
    return "".join(ch for ch in s if not unicodedata.combining(ch))


class Entry:
    def __init__(self, path: str, line: int, cc: str, venue: str, title: str, films: "List[str]", verdict: str, note: str) -> None:
        self.path, self.line, self.cc, self.venue, self.title = path, line, cc, venue, single_spaced(title)
        self.films, self.verdict, self.note = films, verdict, note
        self.history = ""


def judgement_entries(files: Files, root: str) -> "List[Entry]":
    """Each row of the judgements file: its verdict, and its state, scope and reason beside the evidence."""
    out: "List[Entry]" = []
    for r in store.read_at(files, root):
        state = "" if r.state == "open" else f" {r.state}" + (f" ({r.scope})" if r.scope else "")
        verdict = r.verdict + state if state else r.verdict
        note = "; ".join(x for x in (r.reason and f"reason: {r.reason}", r.evidence, r.judged and f"judged {r.judged}") if x)
        out.append(Entry(store.PATH, r.line, r.country, r.venue, r.rawTitle, [r.film], verdict, note))
    return out


def all_entries(root: str, files: Files) -> "List[Entry]":
    out = judgement_entries(files, root)
    expected = files.path(root, takes.EXPECTED_MATCHES)
    if files.exists(expected):
        out += [Entry(takes.EXPECTED_MATCHES, n, cc, venue, title, [film], "expected take", note)
                for n, cc, venue, title, film, note in takes.expected_matches(files, expected)]
    return out


def blame_commits(porcelain: str) -> "Dict[str, Dict[str, Any]]":
    """What `git blame --porcelain` says of each commit: {sha: {"lines": [...], "time": epoch, "summary": text}}."""
    commits: "Dict[str, Dict[str, Any]]" = {}
    at: "Optional[Tuple[str, int]]" = None
    for line in porcelain.split("\n"):
        m = re.match(r"^([0-9a-f]{40}) \d+ (\d+)", line)
        if m:
            at = (m.group(1), int(m.group(2)))
            commits.setdefault(m.group(1), {})
            commits[m.group(1)].setdefault("lines", []).append(at[1])
        elif at and line.startswith("author-time "):
            commits[at[0]]["time"] = int(line.split()[1])
        elif at and line.startswith("summary "):
            commits[at[0]]["summary"] = line[len("summary "):]
    return commits


def history_of(sha: str, c: "Dict[str, Any]") -> str:
    when = datetime.fromtimestamp(c.get("time", 0), timezone.utc).strftime("%Y-%m-%d")
    return "uncommitted" if sha == "0" * 40 else f"{sha[:9]} {when} {c.get('summary', '')[:70]}"


def blame(git: tool_git.Git, entries: "List[Entry]") -> None:
    """Each entry's history: the commit that last changed its line, and its date (one `git blame` per file; `git` is
    a tool_git.Git over the repository's root, which sets a hook's own GIT_DIR aside)."""
    by_file: "Dict[str, List[Entry]]" = defaultdict(list)
    for e in entries:
        by_file[e.path].append(e)
    for rel, es in by_file.items():
        args = ["blame", "--porcelain"]
        for e in es:
            args += ["-L", f"{e.line},{e.line}"]
        out = git.out(*args, "--", rel, timeout=120, quiet=True)
        if out is None:
            continue
        for sha, c in blame_commits(out).items():
            for e in es:
                if e.line in c["lines"]:
                    e.history = history_of(sha, c)


Take = Tuple[str, str, str, str]  # (venue, rawTitle, film, basis)


def mirror_db(cc: str) -> str:
    return "kinowo_prod_mirror" if cc == "pl" else f"kinowo_{cc}_prod_mirror"


MIRROR_SCRIPT = """
const q = JSON.parse(process.env.LABEL_LOOKUP_QUERY);
const sel = {};
if (q.title) sel["listing.rawTitle"] = q.exact ? q.title : {$regex: q.titleRegex, $options: "i"};
if (q.venue) sel["listing.venue"] = q.venue;
if (q.film) sel["film"] = q.film;
print(JSON.stringify(db.identity_traces.find(sel, {listing: 1, film: 1, basis: 1}).limit(200).toArray()
  .map(t => [t.listing.venue, t.listing.rawTitle, t.film, t.basis])));
"""


class ProdMirror:
    """The local prod mirror's takes: its freshness as scripts/local-mirror/freshness judges it (the one check every tool
    reading the mirror shares), then identity_traces through mongosh -- both commands through the runner."""

    def __init__(self, runner: tool_process.Runner, env: "Mapping[str, str]") -> None:
        self.runner, self.env = runner, env
        self.uri = f"mongodb://127.0.0.1:{env.get('LOCAL_MIRROR_PORT', '28017')}"

    def ask(self, argv: "List[str]", env: "Mapping[str, str]") -> tool_process.Captured:
        return self.runner.capture(tool_process.Command(argv, env, timeout=60))

    def takes(self, cc: str, query: "Dict[str, Any]") -> "Tuple[str, List[Take]]":
        """(freshness, [(venue, rawTitle, film, basis)]), or (why not, [])."""
        f = self.ask([os.path.join(HERE, "local-mirror", "freshness"), cc, "--quiet", "--need", "identity_traces"], self.env)
        fresh = " ".join((f.stdout.strip().split("\n") or [""])[0].split()[1:]) or f.stderr.strip()
        if f.code == 2:
            return f"no mirror: {fresh}", []
        r = self.ask(["mongosh", "--quiet", f"{self.uri}/{mirror_db(cc)}?directConnection=true&serverSelectionTimeoutMS=5000",
                      "--eval", MIRROR_SCRIPT], {**self.env, "LABEL_LOOKUP_QUERY": json.dumps(query)})
        try:
            takes = json.loads(r.stdout.strip().split("\n")[-1])
        except (ValueError, IndexError):
            return f"no mirror: the local prod mirror at {self.uri}/{mirror_db(cc)} did not answer (scripts/local-mirror)", []
        if f.code == 3:
            fresh += " -- NOT FRESH: its takes are as of then"
        return fresh, [(v, single_spaced(t), f"tmdb:{film}" if film is not None else "none", b) for v, t, film, b in takes]


def at_venue(entries: "List[Entry]", venue: "Optional[str]") -> "List[Entry]":
    if not venue:
        return entries
    return [e for e in entries if e.venue in ("", "*") or folded(e.venue) == folded(venue)]


def titled(entries: "List[Entry]", want: str, exact: bool) -> "List[Entry]":
    """The entries titled exactly `want`, or (none are) holding it, case and accents aside."""
    if exact:
        return [e for e in entries if e.title == want]
    return [e for e in entries if folded(want) in folded(e.title)]


def selected_entries(entries: "List[Entry]", cc: str, film: "Optional[str]", title: "Optional[str]",
                     venue: "Optional[str]") -> "Tuple[List[Entry], Optional[bool], str]":
    """The entries a film or a listing names, whether the title matched exactly, and the report's heading."""
    if film:
        return [e for e in entries if film in e.films], None, f"label-lookup {cc.upper()} · film {film}"
    assert title is not None  # the caller gives a film or a title
    want = single_spaced(title)
    exact = any(e.title == want for e in entries)
    hits = at_venue(titled(entries, want, exact), venue)
    heading = (f"label-lookup {cc.upper()} · listing '{want}'" + (f" at '{venue}'" if venue else " at every venue") +
               (" (exact title)" if exact else " (titles holding it, case and accents aside)"))
    return hits, exact, heading


def verdict_origin(own: "Optional[str]", every: "Optional[str]") -> str:
    if own and every:
        return f"the venue's own {own} beside '*' {every}"
    return "the venue's own" if own else "'*'" if every else ""


def right_at_venue(hits: "List[Entry]", labels: "store.Labels", venue: str) -> "List[str]":
    """The TMDB films the judgements call right at the venue, once each."""
    judged = [e for e in hits if e.path == store.PATH and e.films[0].startswith("tmdb:")]
    return sorted({e.films[0] for e in judged if label_of(labels, venue, e.title, e.films[0]) == "right"})


def effective_verdict_lines(hits: "List[Entry]", titles: "List[str]", labels: "store.Labels", venue: str) -> "List[str]":
    out = [f"effective verdict at '{venue}' (the judgements: the venue's own row overrides '*'):"]
    judged = [(t, f) for t in titles for f in sorted({e.films[0] for e in hits if e.path == store.PATH and e.title == t})]
    for t, f in judged:
        why = verdict_origin(labels.get((venue, t, f)), labels.get(("*", t, f)))
        out.append(f"  {t} · {f}: {(label_of(labels, venue, t, f) or '-').upper()} ({why})")
    out += [] if judged else ["  none: the judgements judge no film for it"]
    right = right_at_venue(hits, labels, venue)
    if len(right) > 1:
        out.append(f"  NOTE {len(right)} films judged right for one venue: {', '.join(right)} (two listings, or a label to settle)")
    return out


def entry_lines(hits: "List[Entry]") -> "List[str]":
    out = [f"entries ({len(hits)}):"]
    for e in sorted(hits, key=lambda e: (e.path, e.title, e.venue, e.line)):
        where = f"{e.venue} | {e.title}" if e.venue else e.title
        shown = e.verdict.split(" ", 1)
        shown[0] = shown[0].upper() if shown[0] in ("right", "wrong") else shown[0]
        out.append(f"  {os.path.basename(e.path)}:{e.line}  {where}  {' '.join(e.films)}  {' '.join(shown)}")
        if e.note:
            out.append(f"      note: {e.note}")
        if e.history:
            out.append(f"      last changed: {e.history}")
    return out


def prod_query(film: "Optional[str]", title: "Optional[str]", exact: "Optional[bool]", venue: "Optional[str]") -> "Optional[Dict[str, Any]]":
    if film and film.startswith("tmdb:"):
        return {"film": int(film.split(":")[1])}
    if not title:
        return None
    query: "Dict[str, Any]" = {"title": single_spaced(title), "exact": bool(exact), "titleRegex": re.escape(single_spaced(title))}
    if venue and not film:
        query["venue"] = venue
    return query


def take_judgement(labels: "store.Labels", v: str, t: str, f: str) -> str:
    """label_of's verdict, its implied WRONG (another film judged right for the listing) said as the miss."""
    j = store.stated(labels, v, t, f) if f != "none" else None
    if j:
        return j
    missed = sorted(r for r in store.right_films(labels, v, t) if r != f and r.startswith("tmdb:")
                    and label_of(labels, v, t, r) == "right")
    return f"misses RIGHT {', '.join(missed)}" if missed else "unjudged"


def shown_judgement(j: str) -> str:
    return f"labels: {j.upper()}" if j in ("right", "wrong") else j


def take_warning(verdicts: "Set[str]") -> str:
    if "wrong" in verdicts:
        return "  <- prod takes a film the judgements call WRONG"
    if any(j.startswith("misses") for j in verdicts):
        return "  <- prod misses the film the judgements call RIGHT"
    return ""


def take_lines(takes: "List[Take]", labels: "store.Labels") -> "List[str]":
    if len(takes) <= 12:
        lines = []
        for v, t, f, b in sorted(takes):
            j = take_judgement(labels, v, t, f)
            lines.append(f"  {v} | {t} -> {f} ({b})  [{shown_judgement(j)}]" + take_warning({j}))
        return lines
    groups = defaultdict(list)  # one line per take, its venues counted and judged venue by venue
    for v, t, f, b in takes:
        groups[(t, f, b)].append(v)
    lines = []
    for (t, f, b), vs in sorted(groups.items(), key=lambda g: (-len(g[1]), g[0])):
        tally = defaultdict(int)
        for v in vs:
            tally[take_judgement(labels, v, t, f)] += 1
        verdicts = ", ".join(f"{n} {shown_judgement(j)}" for j, n in sorted(tally.items()))
        lines.append(f"  {t} -> {f} ({b}) at {len(vs)} venue(s), e.g. {', '.join(sorted(vs)[:3])}  [{verdicts}]" + take_warning(set(tally)))
    return lines


def prod_lines(mirror: "ProdMirror", cc: str, query: "Dict[str, Any]", labels: "store.Labels") -> "List[str]":
    fresh, takes = mirror.takes(cc, query)
    out = [f"prod takes now (local mirror {mirror_db(cc)}, identity_traces; {fresh}):"] + take_lines(takes, labels)
    if len(takes) == 200:
        out.append("  … the first 200 listings only")
    if not takes and not fresh.startswith("no mirror"):
        out.append("  none: prod's identity traces hold no such listing")
    return out


def touches(k: "Tuple[str, ...]", cc: str, film: "Optional[str]", titles: "List[str]") -> bool:
    """Whether a lint finding's key names the film or one of the titles, in this country."""
    if k[1] != cc:
        return False
    if film:
        return film in k
    return any(x in titles for x in k[2:]) or (k[2] == "hard-clusters" and k[3] in {lint.key(t) for t in titles})


def conflict_lines(files: Files, root: str, judgements: "List[store.Row]", cc: str, film: "Optional[str]",
                   titles: "List[str]") -> "List[str]":
    mine = [(k, m) for k, m in lint.lint(files, root) if touches(k, cc, film, titles)]
    out = [f"conflicts (identity_judgements_lint): {'none' if not mine else len(mine)}"]
    out += [f"  {k[0]}: {m}" for k, m in mine]
    notes = lint.notices([r for r in judgements if r.country == cc and (film == r.film if film else single_spaced(r.rawTitle) in titles)])
    return out + [f"  note: {m}" for m in notes]


def lookup(root: str, cc: str, files: Files, git: tool_git.Git, mirror: "ProdMirror", title: "Optional[str]" = None,
           venue: "Optional[str]" = None, film: "Optional[str]" = None, prod: bool = True, history: bool = True) -> "List[str]":
    entries = [e for e in all_entries(root, files) if e.cc == cc]
    judgements = store.read_at(files, root)
    labels = store.labels_by_country(judgements)[cc]
    hits, exact, heading = selected_entries(entries, cc, film, title, venue)
    titles = sorted({e.title for e in hits})
    out = [heading]
    if venue and not film:
        out += effective_verdict_lines(hits, titles, labels, venue)
    if history:
        blame(git, hits)
    out += entry_lines(hits)
    query = prod_query(film, title, exact, venue) if prod else None
    if query is not None:
        out += prod_lines(mirror, cc, query, labels)
    return out + conflict_lines(files, root, judgements, cc, film, titles)


def main(argv: "Optional[List[str]]" = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cc")
    ap.add_argument("--title")
    ap.add_argument("--venue")
    ap.add_argument("--film")
    ap.add_argument("--no-prod", action="store_true")
    ap.add_argument("--no-history", action="store_true")
    ap.add_argument("--root", default=os.path.dirname(HERE))
    a = ap.parse_args(argv)
    if bool(a.title) == bool(a.film) or (a.venue and not a.title):
        ap.error("name a listing (--title [--venue]) or a film (--film tmdb:N), not both")
    if a.film and not re.match(r"^[a-z]+:\S+$", a.film):
        ap.error("--film is an id: tmdb:N, imdb:ttN, …")
    env = machine.environment()
    runner = tool_process.SubprocessRunner()
    print("\n".join(lookup(a.root, a.cc.lower(), Files.here(), tool_git.Git(runner, env, a.root), ProdMirror(runner, env),
                          a.title, a.venue, a.film, not a.no_prod, not a.no_history)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
