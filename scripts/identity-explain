#!/usr/bin/env bash
#
# An alias of `scripts/identity-slice <cc> --explain …` (see its --help): WHY a listing of the unmatched-cluster capture
# took (or did not take) its film. Kept because prod's take-change lines print it as their `repro` (TakeChangeLines).
#
#   scripts/identity-explain <cc> [--venue S] [--title S] [--ref A [--ref B]] [--fixture SRC] [--limit N] [--no-resolve]
set -euo pipefail
case "${1:-}" in -h|--help|"") exec "$(dirname "$0")/identity-slice" --help ;; esac
cc=$1; shift
exec "$(dirname "$0")/identity-slice" "$cc" --explain "$@"
