#!/bin/sh
# Purpose: The weekly identity rule refit, whole — the one script `.github/workflows/identity-refit.yml` runs and a local run runs the same way
# The name its callers run (identity-refit.yml, identity-calibrate.sh --refit, the skills): scripts/identity_refit.py is
# the tool, its header (`--help`) says what it runs, and how.
exec python3 "$(dirname "$0")/identity_refit.py" "$@"
