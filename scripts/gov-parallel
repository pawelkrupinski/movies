#!/usr/bin/env bash
# Purpose: THE GOVERNED FAN-OUT for a shell: xargs -P under a governor ticket charged its width, or within the ticket it runs under
# THE GOVERNED FAN-OUT FOR A SHELL (the owner, 2026-11-25: "fix structurally" -- load 103 on 18 cores while `agentctl
# gov status` said 0 admitted: the mutation tests' `xargs -P 4`, run beside eight others by run-script-tests, held no
# ticket). `xargs -P N` with its width from the governor (scripts/jvm-gate.sh gov_width):
#
#   scripts/gov-parallel --job J -P N [xargs options...] [command...]
#
#   --job J   what the ticket is charged as (mutation-tests, ...)
#   -P N      the width it wants
#
# Under a ticket already ($AGENTCTL_GOV_WIDTH: a check's hook, run-script-tests' test, a gov-run with cores) it takes
# none and runs at most that wide -- a nested fan-out never waits on its own parent; else it waits for a ticket charged
# N cores, held on descriptor 7 by xargs and every command it starts, given back when they have all ended. Each command
# runs with AGENTCTL_GOV_WIDTH=1: one core of it, so a fan-out inside runs one wide. No governor (Linux CI,
# KINOWO_GOVERNOR=0): N wide. scripts/ci/fanout_lint.py refuses an `xargs -P` anywhere else.
# Exit: xargs's; 64 usage.
set -uo pipefail
usage() { sed -n '7,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 64; }
job="" want=""
while [ $# -gt 0 ]; do
  case "$1" in
    --job) [ $# -ge 2 ] || usage; job=$2; shift 2 ;;
    -P) [ $# -ge 2 ] || usage; want=$2; shift 2 ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done
[ -n "$job" ] && [ -n "$want" ] || usage
# shellcheck source=scripts/jvm-gate.sh
. "$(dirname "${BASH_SOURCE[0]}")/jvm-gate.sh"
gov_width "$job" "$job" "$want" 1
AGENTCTL_GOV_WIDTH=1 exec xargs -P "$GOV_WIDTH" "$@"
