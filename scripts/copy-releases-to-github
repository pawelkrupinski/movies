#!/usr/bin/env python3
"""Copy movies' Forgejo releases and their assets to the same repository on github.com (github-return-plan
2026-10-30, 3.4 item 5 / W4b). The OWNER runs it: it publishes to a public repository with the owner's `gh` login.

WHY. Phase 1 moved git only. The CI's data lives in release assets -- convergence-fixtures (the hermetic pairs,
enrichment trees, fills, refused/refetch lists, the takes store), identity-recordings, the Android pre-releases --
about 13 GB on Forgejo that github.com's runners read once they are primary, and that the github.com shadow runs read
already (a convergence leg without its pinned pair fails its preflight).

WHAT. For each Forgejo release (or each --tag): create the github.com release if missing (same name, notes,
pre-release flag, target), then upload every asset github.com lacks or holds with another size, one at a time through
a scratch directory (downloaded with the Forgejo token, uploaded with `gh release upload --clobber`, deleted). It is
IDEMPOTENT: a rerun uploads only what is still missing, so an interrupted copy just runs again.

THE 1000-ASSET LIMIT. A github.com release holds at most 1000 assets; convergence-fixtures has ~1160 on Forgejo, ~720
of them CACHES the CI rebuilds on a miss: the takes store (takes-{trace,tracex,shape,gaps,final,decisions}-<cc>-<sha>.gz,
scripts/ci/identity-takes-check.sh) and identity-measure's result cache (measure-result-<key>.json). By default those
are NOT copied (--with-caches copies them). Should a release still exceed the limit -- counting the assets github.com
already holds that stay -- the overflow goes to `<tag>-part-2`, `-part-3`, ... in name order, and the run says so:
nothing reads a part release yet, so split only knowingly (scripts/ci/gh-release.sh's readers read `<tag>`).

STALE ASSETS. github.com still holds the pre-suspension convergence-fixtures (~430 assets). Assets there that Forgejo
no longer has are LISTED; --prune deletes them (list first, then prune: the owner's rule for deletions).

DRY RUN unless --apply: prints what it would create, upload, skip, split and prune, with sizes.

    scripts/copy-releases-to-github                              # dry run, every release
    scripts/copy-releases-to-github --tag identity-recordings    # one release
    scripts/copy-releases-to-github --apply [--prune]            # copy (and delete github.com's stale assets)

Needs: the Forgejo tunnel (KINOWO_FORGEJO_URL, default http://forgejo.internal:3000) and FORGEJO_API_TOKEN or the
unlocked `movies` vault (as scripts/forge-gh); `gh` logged in to github.com with `repo` scope. Tested by
scripts/copy_releases_to_github_test.py.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
from dataclasses import dataclass, field

HERE = os.path.dirname(os.path.abspath(__file__))
GITHUB_ASSET_LIMIT = 1000
GITHUB_ASSET_MAX_BYTES = 2 * 1024 ** 3 - 1
CACHE_ASSET = re.compile(r"^(takes-(trace|tracex|shape|gaps|final|decisions)-[a-z]{2}-.*\.gz|measure-result-.*\.json)$")


def _forge_gh():
    loader = importlib.machinery.SourceFileLoader("forge_gh", os.path.join(HERE, "forge-gh"))
    spec = importlib.util.spec_from_loader("forge_gh", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


@dataclass
class Asset:
    name: str
    size: int
    url: str = ""


@dataclass
class Release:
    tag: str
    name: str = ""
    body: str = ""
    prerelease: bool = False
    target: str = ""
    assets: list = field(default_factory=list)


@dataclass
class Plan:
    """One github.com release's work: create it?, which assets to upload, which stay, which are stale."""
    tag: str
    source: Release
    create: bool
    upload: list           # Asset, from Forgejo
    present: list          # names already on github.com with the same size
    skipped_caches: list   # Asset, not copied (--with-caches copies them)
    too_large: list        # Asset over github.com's 2 GiB asset limit
    stale: list            # names on github.com only
    prune: bool

    def final_count(self) -> int:
        kept_stale = 0 if self.prune else len(self.stale)
        return len(self.present) + len(self.upload) + kept_stale


def plan_release(source: Release, target_assets: dict | None, with_caches: bool, prune: bool,
                 limit: int = GITHUB_ASSET_LIMIT) -> list:
    """Plans for `source` and, past the limit, its part releases. `target_assets` maps the github.com release's asset
    names to sizes, or is None when github.com has no such release."""
    have = target_assets or {}
    wanted, caches, too_large = [], [], []
    for a in sorted(source.assets, key=lambda a: a.name):
        if not with_caches and CACHE_ASSET.match(a.name):
            caches.append(a)
        elif a.size > GITHUB_ASSET_MAX_BYTES:
            too_large.append(a)
        else:
            wanted.append(a)
    wanted_names = {a.name for a in wanted} | {a.name for a in caches} | {a.name for a in too_large}
    stale = sorted(n for n in have if n not in wanted_names)
    present = [a.name for a in wanted if have.get(a.name) == a.size]
    upload = [a for a in wanted if have.get(a.name) != a.size]
    first = Plan(source.tag, source, target_assets is None, upload, present, caches, too_large, stale, prune)
    plans = [first]
    room = limit - (len(present) + (0 if prune else len(stale)))
    if len(upload) > room:
        # Keep what is already there; the overflow of new uploads moves to part releases, in name order.
        first.upload, overflow = upload[:max(room, 0)], upload[max(room, 0):]
        part = 2
        while overflow:
            chunk, overflow = overflow[:limit], overflow[limit:]
            plans.append(Plan(f"{source.tag}-part-{part}", source, True, chunk, [], [], [], [], prune))
            part += 1
    return plans


def human(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024
    return str(n)


def describe(plans: list) -> list:
    lines = []
    for p in plans:
        up = sum(a.size for a in p.upload)
        lines.append(f"{p.tag}: {'CREATE, ' if p.create else ''}upload {len(p.upload)} ({human(up)}), "
                     f"{len(p.present)} already there, {len(p.skipped_caches)} caches not copied, "
                     f"{len(p.stale)} stale on github.com{' (PRUNED)' if p.prune and p.stale else ''}"
                     f" -> {p.final_count()} assets")
        if p.tag != p.source.tag:
            lines.append(f"  !! {p.tag} is a PART release: nothing reads it yet (gh-release.sh's readers read {p.source.tag})")
        for a in p.too_large:
            lines.append(f"  !! {a.name}: {human(a.size)}, over github.com's 2 GiB asset limit -- not copied")
        if p.stale:
            shown = ", ".join(p.stale[:8]) + (f", ... ({len(p.stale) - 8} more)" if len(p.stale) > 8 else "")
            lines.append(f"  stale on github.com{'' if p.prune else ' (kept; --prune deletes)'}: {shown}")
    return lines


# ── the two forges ─────────────────────────────────────────────────────────────────────────────
def forgejo_releases(repo: str, env=os.environ) -> list:
    fg = _forge_gh()
    base, token = fg.server(env), fg.token(env)
    out, page = [], 1
    while True:
        req = urllib.request.Request(f"{base}/api/v1/repos/{repo}/releases?limit=50&page={page}",
                                     headers={"Authorization": f"token {token}"})
        with urllib.request.urlopen(req, timeout=120) as r:
            batch = json.load(r)
        if not batch:
            return out
        for rel in batch:
            out.append(Release(rel["tag_name"], rel.get("name") or rel["tag_name"], rel.get("body") or "",
                               bool(rel.get("prerelease")), rel.get("target_commitish") or "",
                               [Asset(a["name"], int(a["size"]), a["browser_download_url"]) for a in rel.get("assets", [])]))
        page += 1


def gh(*args, check=True, capture=True) -> subprocess.CompletedProcess:
    return subprocess.run(["gh", *args], check=check, text=True, capture_output=capture)


def github_assets(repo: str, tag: str) -> dict | None:
    """github.com's release `tag`: its assets' sizes by name, or None when there is no such release."""
    done = gh("api", f"repos/{repo}/releases/tags/{tag}", "--jq", ".id", check=False)
    if done.returncode != 0:
        if "Not Found" in done.stderr or "HTTP 404" in done.stderr:
            return None
        raise SystemExit(f"gh could not read github.com's {tag}: {done.stderr.strip()}")
    listed = gh("api", "--paginate", f"repos/{repo}/releases/{done.stdout.strip()}/assets?per_page=100", "--jq",
                ".[] | [.name, .size] | @tsv").stdout
    sizes = {}
    for line in listed.splitlines():
        name, size = line.rsplit("\t", 1)
        sizes[name] = int(size)
    return sizes


def target_on_github(repo: str, target: str) -> str:
    if target and gh("api", f"repos/{repo}/commits/{target}", "--jq", ".sha", check=False).returncode == 0:
        return target
    return "main"


def apply(plan: Plan, repo: str, scratch: str, env=os.environ) -> None:
    fg = _forge_gh()
    token = fg.token(env)
    src = plan.source
    if plan.create:
        title = src.name if plan.tag == src.tag else f"{src.name} (part {plan.tag.rsplit('-', 1)[1]})"
        args = ["release", "create", plan.tag, "-R", repo, "--title", title, "--notes", src.body or title,
                "--target", target_on_github(repo, src.target)]
        if src.prerelease:
            args.append("--prerelease")
        gh(*args, capture=False)
    for i, a in enumerate(plan.upload, 1):
        path = os.path.join(scratch, a.name)
        req = urllib.request.Request(a.url, headers={"Authorization": f"token {token}"})
        with urllib.request.urlopen(req, timeout=600) as r, open(path, "wb") as f:
            shutil.copyfileobj(r, f, 1024 * 1024)
        if os.path.getsize(path) != a.size:
            raise SystemExit(f"{a.name}: downloaded {os.path.getsize(path)} bytes, Forgejo lists {a.size}")
        gh("release", "upload", plan.tag, path, "-R", repo, "--clobber", capture=False)
        os.remove(path)
        print(f"  [{i}/{len(plan.upload)}] {plan.tag} <- {a.name} ({human(a.size)})", flush=True)
    if plan.prune:
        for name in plan.stale:
            gh("release", "delete-asset", plan.tag, name, "-R", repo, "-y", capture=False)
            print(f"  pruned {plan.tag}/{name}", flush=True)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--from-repo", default="pawelkrupinski/movies", help="the Forgejo repository")
    ap.add_argument("--to-repo", default="pawelkrupinski/movies", help="the github.com repository")
    ap.add_argument("--tag", action="append", help="only this release (repeatable)")
    ap.add_argument("--with-caches", action="store_true", help="also copy the takes store and measure-result caches")
    ap.add_argument("--prune", action="store_true", help="delete github.com assets Forgejo no longer has")
    ap.add_argument("--apply", action="store_true", help="do it (default: a dry run)")
    args = ap.parse_args(argv)

    releases = forgejo_releases(args.from_repo)
    if args.tag:
        missing = set(args.tag) - {r.tag for r in releases}
        if missing:
            raise SystemExit(f"no such Forgejo release: {', '.join(sorted(missing))}")
        releases = [r for r in releases if r.tag in args.tag]
    plans = []
    for rel in releases:
        plans += plan_release(rel, github_assets(args.to_repo, rel.tag), args.with_caches, args.prune)
    print("\n".join(describe(plans)))
    total = sum(a.size for p in plans for a in p.upload)
    print(f"\n{'COPYING' if args.apply else 'DRY RUN: would copy'} {sum(len(p.upload) for p in plans)} assets, "
          f"{human(total)}, {args.from_repo} (Forgejo) -> {args.to_repo} (github.com)")
    if not args.apply:
        print("Run again with --apply to copy" + ("" if args.prune else " (and --prune to delete the stale assets listed)") + ".")
        return 0
    scratch = tempfile.mkdtemp(prefix="copy-releases-")
    try:
        for p in plans:
            apply(p, args.to_repo, scratch)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    print("done: rerun the dry run to confirm nothing is left to upload")
    return 0


if __name__ == "__main__":
    sys.exit(main())
