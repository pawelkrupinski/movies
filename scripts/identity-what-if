#!/usr/bin/env bash
# A LOCAL WHAT-IF OF A RESOLVER CHANGE over prod's current corpus, in minutes: the base's and the head's model resolve
# the LOCAL prod mirror's snapshot of a moment (`--at`; :28017, read-only), the head re-resolving only the families the
# change can reach, and every take that moved is bucketed by the judgements (test/resources/fixtures/identity-judgements
# .tsv) as scripts/identity-measure buckets a CI measurement -- moved, gained, lost, right->wrong, new-wrong -- with prod's
# served take beside each.
#
#   scripts/identity-what-if [--base REF] [--head REF|.] [--at ISO] [--max-age HOURS] [--all] [--verify]
#                            [--offline] [--model-only] [--answers-dir DIR] [--no-serve]
#   scripts/identity-what-if --bisect GOOD BAD [--listing 'cc|venue|raw title'] [--at ISO] [--since ISO] cc
#   scripts/identity-what-if --recording RUN --base REF --head REF cc...
#   scripts/identity-what-if --stop-served
#                            [--threads N] [--out DIR] [--judgements F] [--json] cc...
#
#   --base REF     the code the change is measured against (default origin/main)
#   --head REF|.   the change: a commit, or `.` (default) for this checkout's code with its uncommitted edits
#   --at ISO       the mirror moment both sides resolve (default: the newest snapshot the base already resolved within
#                  --max-age hours, 6 by default, else now)
#   --all          re-resolve every family at the head, whatever the change reaches: the DEFAULT for a change reaching a
#                  take (2026-11-20, the stamp carry: only a whole verdict carries a stamp -- scripts/identity-stamp-carry --
#                  and the head costs about what the base side does; most resolver changes select ALL anyway)
#   --selection    re-resolve only the families the change can reach (the default before 2026-11-20): faster on a narrow
#                  change, but its verdict carries no stamp
#   --verify       also resolve every family at the head and FAIL (exit 1) if any take differs from the what-if's: the
#                  proof that the selection missed nothing
#   --threads N    head families resolved at once (default 6)
#   --out DIR      where the per-country diff TSVs go (default target/identity-what-if/<head>)
#   --judgements F the judgements the moves are bucketed by (default the head's own, as identity-measure classifies)
#   --offline      ask nothing: a question the mirror's store lacks stays a gap, its listing counted as awaiting an
#                  answer (the tool before 2026-11-05). Without it, every such question -- TMDB's and IMDb's for the
#                  model, the agreement families' (IMDb, Wikidata, Metacritic, Rotten Tomatoes, Filmweb where it votes),
#                  posters and catalogue pages for the stage -- is asked of the REAL service once (direct requests over
#                  production's paced wire, each host at most 8 at once, halved on a 429/503; never a proxy or paid
#                  service; TMDB's key from the vault: `secrets run movies TMDB_API_KEY`) and filed into the LOCAL
#                  what-if store, keyed as production's store keys it, so a repeat run asks nothing
#   --answers-dir  that store (default $KINOWO_IDENTITY_CACHE/what-if-answers; one directory a country)
#   --no-serve     a JVM per side; by default the head's tree runs in a KEPT JVM (one per tree and code; stops after
#                  $KINOWO_IDENTITY_WHAT_IF_IDLE_MINUTES, 10, idle minutes; --stop-served stops them all) holding the
#                  corpus and its context of the last two (country, snapshot, answers): a warm rerun resolves only
#   --bisect G B   the commit of G..B (first parent) whose code moved a take on one mirror snapshot: the listing's model
#                  and final take with --listing (its venue and raw title as takes-diff rows name them), else every take;
#                  each step a whole side, kept as a base is (about a minute a step cold, seconds kept). When G and B take
#                  alike, no commit moved it: B is resolved at --since (24 h before the snapshot by default) to say
#                  whether the CORPUS did
#   --recording RUN  replay that cached "Record scrape fixtures" run instead of the mirror, through CI's OWN two tools
#                  (scripts/identity-measure-local: the model's IdentityResolveDump and the ratchet's final takes): the
#                  CI measure's numbers exactly (its recording, its capture), at a whole resolve's cost, not the what-if's
#   --model-only   compare the model's takes only; by default the FINAL take too: a fresh agreement stage settled over
#                  each side's model takes (the base's every family, the head's re-resolved ones), diffed as the measure
#                  diffs its final stage
#
# HOW. Each ref's sources are laid out once under the shared cache (scripts/identity-tools.sh's identity_tree, this
# checkout's WhatIfResolve.scala and MemoLookups.scala dropped in, so a ref from before the tool works) and compiled once.
# The base resolves every family (services.identity.WhatIfResolve: takes, rule ids, block keys, prod's served take) in a
# JVM of its own, and the side is KEPT on disk, keyed by the base's sha, the tool files and the snapshot moment: a repeat
# run resolves only the head. While a base side resolves, the head compiles beside it (its own JVM slot).
# scripts/identity_what_if.py selects: the changed code walked up its callers to the rule roots
# (scripts/identity-what-if-roots.tsv), the families whose base trace names one of their rules re-resolved, widened while a
# re-resolved family blocks under another's key; a change it cannot attribute (shared resolver code, scoring, lookups,
# normalizer) re-resolves ALL, and says why. A change reaching no take (docs, tests, scripts, comments: `reaches`) or a
# selection naming no family starts no head JVM and compiles no head: its takes are the base's. Then it diffs.
# Every line it logs carries the seconds since it started (+Ns): the run's phase timings.
#
# A change to the agreement stage (identity/.../agreement/, or a definition its code calls) selects ALL: every family's
# final take settled again at the head, and it says why.
#
# WHAT IT IS NOT. prod's current corpus, not a recording: CI's scripts/identity-measure replays a pinned recording
# and stays the verdict of record; the two differ by the corpus (docs: identity-investigation skill).
#
# Each country it finishes is recorded for scripts/identity-measure's what-if gate (THE VERDICT RECORD, below).
#
# A PURE MOVE (scripts/pure-move-check: files, packages and classes renamed, nothing else) is not resolved at all: it
# prints "PURE MOVE: what-if skipped (scripts/pure-move-check)", records a `pure-move` verdict a country and exits 0.
#
# A MIRROR CHANGING UNDER THE RUN IS A HARNESS ERROR, never takes moved (2026-11-19: lane C's US what-if reported 87k
# takes moved off a base read while the mirror re-seeded, 16k of its live asks failed; a rerun moved none). Both sides
# read the mirror's CURRENT listings (the snapshot moment replays identity history over them), so both must read ONE
# copy. The run FENCES the mirror's tailer (scripts/local-mirror/fence-rule.js: a file under $KINOWO_MIRROR_FENCE_DIR,
# ~/.cache/kinowo/mirror-fence by default, that tail.js holds every change for; mirror.sh holds its re-seed audit), and
# its fence LINGERS $KINOWO_WHAT_IF_FENCE_LINGER_MINUTES (20) after it, so a rerun finds the same copy and the base side
# it kept. It is pinned to the mirror's generation (scripts/local-mirror/freshness --generation): its seed generation and
# its tail position (the resume token of the last change tailed: 2026-11-20, lane A3's DE what-if moved a take a write
# tailed between its sides moved, its base-vs-base control the same one). Refused while a seed is in flight or due, and
# exit 2 when either is not the same before the base, between the sides and after the head. Kept base sides and the kept
# JVM's corpora are keyed by it, so nothing resolved off one copy is served against another. A side whose live asks
# failed past $KINOWO_WHAT_IF_MAX_FAILED_ASKS (25) is exit 2 too, and is not kept: an unanswered question is a gap the
# side takes as pending, and the diff would read every one as a move.
#
# Exit 0 done (CLEAN or BLOCKING is printed per country), 1 --verify found a take the selection missed, 2 usage / a
# side failed / HARNESS ERROR (mirror not ready, re-seeded during the run, answers failed, or a head of the base's very
# tree -- a control -- moving any take: 2026-11-19, lane E2's control moved the same 462 US takes as its change). Every JVM takes a slot of
# scripts/jvm-gate.sh.
set -euo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
usage() { usage_from_header; }
# shellcheck disable=SC2034 # read by identity-tools.sh's identity_log
IDENTITY_TOOL=identity-what-if
# shellcheck source=scripts/identity-tools.sh
. "$(dirname "$0")/identity-tools.sh"
identity_explain_exits
repo=$IDENTITY_REPO
# every line it logs (the shared tools' too: layout, compile, slot waits) stamped with the seconds since it started, so a
# run's log reads as its phase timings
what_if_started=$SECONDS
identity_log() { echo "[identity-what-if +$((SECONDS - what_if_started))s] $*" >&2; }
self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
serve_dir=$IDENTITY_CACHE/what-if-serve
# A kept JVM's idle exit, as identity-slice's: each holds a JVM slot while idle
idle_minutes=${KINOWO_IDENTITY_WHAT_IF_IDLE_MINUTES:-10}
# 0 while <pid> is still a what-if JVM: a pid file outlives its process, and the pid comes back as someone else's.
is_kept() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; ps -o args= -p "$1" 2>/dev/null | grep -q 'services\.identity\.WhatIfResolve'; }
stop_kept() { is_kept "$1" || return 1; kill "$1" 2>/dev/null; }
if [ "${1:-}" = --stop-served ]; then
  for pidf in "$serve_dir"/*.pid; do
    [ -f "$pidf" ] || continue
    stop_kept "$(cat "$pidf")" && identity_log "stopped the kept JVM $(cat "$pidf")"
    rm -f "$pidf" "${pidf%.pid}.sock" "${pidf%.pid}.tree"
  done
  exit 0
fi
# THE KEEPER of a kept JVM (as identity-slice's): holds its JVM slot for the JVM's whole life and ends once it has.
if [ "${1:-}" = --keep-served ]; then
  seen=0
  while kill -0 "$2" 2>/dev/null; do
    if is_kept "$2"; then seen=1; elif [ "$seen" = 1 ]; then break; fi
    jvm_slot_take_if_free || true
    sleep "${KINOWO_IDENTITY_SLICE_KEEPER_POLL:-10}"
  done
  exit 0
fi

base=origin/main head=. at="" max_age=6 all=auto verify=0 threads=6 out="" json=0 judgements="" ccs=()
answers=live answers_dir="" final=1 serve=${KINOWO_IDENTITY_WHAT_IF_SERVE:-1}
bisect_good="" bisect_bad="" bisect_listing="" bisect_since="" recording=""
original_args=("$@")
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) flag_value "$@"; base=$2; shift 2 ;;
    --head) flag_value "$@"; head=$2; shift 2 ;;
    --at) flag_value "$@"; at=$2; shift 2 ;;
    --max-age) flag_value "$@"; max_age=$2; shift 2 ;;
    --all) all=1; shift ;;
    --selection) all=0; shift ;;
    --verify) verify=1; shift ;;
    --threads) flag_value "$@"; threads=$2; shift 2 ;;
    --out) flag_value "$@"; out=$2; shift 2 ;;
    --json) json=1; shift ;;
    --judgements) flag_value "$@"; judgements=$2; shift 2 ;;
    --offline) answers=offline; shift ;;
    --answers-dir) flag_value "$@"; answers_dir=$2; shift 2 ;;
    --model-only) final=0; shift ;;
    --no-serve) serve=0; shift ;;
    --bisect) [ "$#" -ge 3 ] || { echo "--bisect GOOD BAD" >&2; exit 2; }; bisect_good=$2; bisect_bad=$3; shift 3 ;;
    --listing) flag_value "$@"; bisect_listing=$2; shift 2 ;;
    --since) flag_value "$@"; bisect_since=$2; shift 2 ;;
    --recording) flag_value "$@"; recording=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "unknown argument $1" >&2; usage >&2; exit 2 ;;
    *) ccs+=("$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"); shift ;;
  esac
done
[ "${#ccs[@]}" -gt 0 ] || { echo "name a country (pl de uk es us)" >&2; exit 2; }
# A PURE MOVE MEASURES NOTHING (the owner, 2026-11-18): a range that only moves code -- files, packages and classes
# renamed, nothing else (scripts/pure-move-check) -- moves no take, and its base cannot even be compiled with the head's
# tool files across a package rename. Each country's verdict is recorded as `pure-move` for identity-measure's gate.
# Not for --bisect, nor a `.` head with uncommitted edits (the check reads commits); not pure or undecidable: as before.
if [ -z "$bisect_good" ] && [ -z "${KINOWO_PURE_MOVE_CHECKED:-}" ]; then
  pure_head=$head
  if [ "$pure_head" = . ]; then
    pure_head=""; [ -n "$(git -C "$repo" status --porcelain --untracked-files=no)" ] || pure_head=HEAD
  fi
  if [ -n "$pure_head" ]; then
    pure_rc=0; pure_out=$("$repo/scripts/pure-move-check" "$base..$pure_head" --quiet 2>&1) || pure_rc=$?
    if [ "$pure_rc" = 0 ]; then
      echo "PURE MOVE: what-if skipped (scripts/pure-move-check)"
      pure_base=$(git -C "$repo" rev-parse --verify "$base^{commit}") pure_sha=$(git -C "$repo" rev-parse --verify "$pure_head^{commit}")
      for cc in "${ccs[@]}"; do what_if_record_verdict "$pure_sha" "$pure_base" "$cc" pure-move "-"; done
      exit 0
    fi
    identity_log "not a pure move (scripts/pure-move-check exit $pure_rc: $(tail -1 <<< "$pure_out")): resolving as before"
  fi
  export KINOWO_PURE_MOVE_CHECKED=1 # the vault's re-run of this tool, below, asks no second time
fi
if [ -n "$recording" ]; then
  # a CI recording, replayed by CI's own two tools (scripts/identity-measure-local): the measure's numbers exactly
  [ "$head" != . ] || { echo "--recording measures commits: name --head REF (commit the change first)" >&2; exit 2; }
  exec "$(dirname "$0")/identity-measure-local" --base "$base" --head "$head" --recording "$recording" \
    --countries "$(IFS=,; echo "${ccs[*]}")"
fi

TOOL_FILES=(worker/src/test/scala/services/identity/OlderRefs.scala worker/src/test/scala/services/identity/WhatIfResolve.scala worker/src/test/scala/services/identity/WhatIfAnswers.scala
  worker/src/test/scala/scripts/StageAnswers.scala worker/src/fixtures/scala/tools/MemoLookups.scala worker/src/fixtures/scala/tools/OlderRefTypes.scala worker/src/fixtures/scala/services/identity/vocabulary/OlderRefsPackage.scala worker/src/fixtures/scala/services/identity/measures/OlderRefsPackage.scala
  worker/src/fixtures/scala/tools/KeptJvm.scala worker/src/test/scala/services/identity/MirrorWorld.scala
  worker/src/fixtures/scala/services/identityadapters/OlderRefsPackage.scala)
answers_dir=${answers_dir:-$IDENTITY_CACHE/what-if-answers}
if [ "$answers" = live ] && [ -z "${TMDB_API_KEY:-}" ] && [ -z "${KINOWO_WHAT_IF_NO_VAULT:-}" ]; then
  # TMDB's key from the vault, for the live asks only: the whole run under it, never written anywhere. A vault that will
  # not open (locked, a Touch ID prompt nobody answers) leaves the run on the answers earlier live runs filed
  secrets run movies TMDB_API_KEY -- env KINOWO_WHAT_IF_NO_VAULT=1 "$0" ${original_args[@]+"${original_args[@]}"} && exit 0
  rc=$?
  [ "$rc" = 64 ] || exit "$rc" # 64: the vault refused (locked, a Touch ID prompt timed out)
  identity_log "the vault did not give TMDB_API_KEY (secrets unlock movies, then run again): answering from the local store only, nothing asked live"
  answers=cached
fi
[ "$answers" != live ] || [ -n "${TMDB_API_KEY:-}" ] || { identity_log "no TMDB_API_KEY: answering from the local store only"; answers=cached; }
answer_args=(--answers "$answers"); [ "$answers" = offline ] || answer_args+=(--answers-dir "$answers_dir")
# a cached side reads what a live one asked: one kept base serves both
side_answers=$([ "$answers" = offline ] && echo offline || echo live)
final_args=(); [ "$final" = 0 ] || final_args+=(--final)
base_sha=$(git -C "$repo" rev-parse --verify "$base^{commit}") || { echo "no commit $base" >&2; exit 2; }
if [ "$head" = . ]; then head_label=worktree-$(git -C "$repo" rev-parse --short=12 HEAD); head_sha=.
else head_sha=$(git -C "$repo" rev-parse --verify "$head^{commit}") || { echo "no commit $head" >&2; exit 2; }; head_label=${head_sha:0:12}; fi
out=${out:-$repo/target/identity-what-if/$head_label}
mkdir -p "$out"
tools_hash=$(identity_tools_hash "${TOOL_FILES[@]}")
cache=$IDENTITY_CACHE/what-if

max_failed_asks=${KINOWO_WHAT_IF_MAX_FAILED_ASKS:-25}
harness_error() { identity_log "HARNESS ERROR: $*"; echo "HARNESS ERROR: $*" >&2; }
# mirror_generation <cc> -> the mirror's generation for <cc>: `<seed generation>-tail<tail position's digest>`, or the
# bare `seeding` / `reseed-due` (freshness --generation; its report to stderr); exit 2 when the mirror does not answer
mirror_generation() {
  local report rc=0 gen tail
  report=$(scripts/local-mirror/freshness "$1" --quiet --generation) || rc=$?
  grep -vE '^(GENERATION|TAIL) ' <<< "$report" >&2 || true
  [ "$rc" != 2 ] || { identity_log "$1: the local prod mirror does not answer (scripts/local-mirror/freshness)"; exit 2; }
  gen=$(awk -v cc="$1" '$1 == "GENERATION" && $2 == cc { print $3 }' <<< "$report")
  tail=$(awk -v cc="$1" '$1 == "TAIL" && $2 == cc { print $3 }' <<< "$report") # its position; $4 is its sync moment
  [ -n "$gen" ] || { harness_error "$1: mirror not ready: freshness reported no seed generation"; exit 2; }
  case "$gen" in seeding|reseed-due) printf '%s\n' "$gen"; return 0 ;; esac
  [ -n "$tail" ] || { harness_error "$1: mirror not ready: freshness reported no tail position"; exit 2; }
  printf '%s-tail%s\n' "$gen" "$(printf '%s' "$tail" | shasum | cut -c1-12)"
}
# THE FENCE (scripts/local-mirror/fence-rule.js): mirror_fence <cc> holds <cc>'s tailer for this run -- a `run` fence,
# its expiry the longest a run takes -- and each turns into a `linger` one (mirror_fence_linger) once its sides are read, or at the exit, so a rerun
# within the linger reads the same copy. A fence of a what-if that died without its exit (its pid gone) is dropped.
# THE DRAIN: back-to-back what-ifs of many agents would hold the tail for good, so a run that finds the mirror more than
# $KINOWO_WHAT_IF_DRAIN_MINUTES (20: fence-rule.js's linger lag, past which no linger holds) behind first waits for every
# other run's fence to go, then -- its own `drain` fence lifting every linger -- for the tail to apply its backlog
# (behind by under 2 min, or its position standing still for 3 polls: nothing left), and only then fences. Each wait is bounded; one that runs out is said and the run goes on --
# still one copy for both sides, only an older one.
fence_root=${KINOWO_MIRROR_FENCE_DIR:-$HOME/.cache/kinowo/mirror-fence}
fence_linger_minutes=${KINOWO_WHAT_IF_FENCE_LINGER_MINUTES:-20}
drain_minutes=${KINOWO_WHAT_IF_DRAIN_MINUTES:-20}
drain_wait_seconds=${KINOWO_WHAT_IF_DRAIN_WAIT_SECONDS:-900}
drain_poll_seconds=${KINOWO_WHAT_IF_DRAIN_POLL_SECONDS:-10}
fences=()
# tail_state <cc> -> `<tail position> <seconds behind>` (`?` when freshness knows no sync moment), from freshness's report
# whatever its exit: a warning (3, a stale tail or a seed in flight) still reports the tail, and mirror_ready judges the
# seed after the drain (2026-11-21: under pipefail its exit 3 stopped the run, silently, before us and es)
tail_state() {
  local report
  report=$(scripts/local-mirror/freshness "$1" --quiet --tail 2>/dev/null) || true
  awk -v cc="$1" -v now="$(date +%s)" '$1 == "TAIL" && $2 == cc { print $3, ($4 ~ /^[0-9]+$/ ? int(now - $4 / 1000) : "?") }' <<< "$report"
}
# other_runs <fence dir> -> the live run fences in it but this run's (dropping a dead run's and every expired one)
other_runs() {
  local f kind expiry pid
  for f in "$1"/what-if-*; do
    [ -f "$f" ] || continue
    read -r expiry kind < "$f" 2>/dev/null || continue
    pid=${f##*/what-if-}
    if [ "${expiry:-0}" -le "$(date +%s)" ] 2>/dev/null || { [ "$kind" != linger ] && ! kill -0 "$pid" 2>/dev/null; }; then rm -f "$f"; continue; fi
    if [ "$kind" = run ] && [ "$pid" != $$ ]; then echo "${f##*/}"; fi
  done
  return 0
}
mirror_drain() { # <cc> <fence dir>
  local state behind started=$SECONDS others last="" position still=0
  state=$(tail_state "$1"); behind=${state#* }
  case "$behind" in ''|'?'|*[!0-9]*) return 0 ;; esac
  [ "$behind" -gt $(( drain_minutes * 60 )) ] || return 0
  identity_log "$1: the mirror is $(( behind / 60 )) min behind (past $drain_minutes): draining the tail's backlog before fencing"
  while others=$(other_runs "$2"); [ -n "$others" ]; do
    [ $(( SECONDS - started )) -lt "$drain_wait_seconds" ] || { identity_log "$1: other runs still hold the tail after ${drain_wait_seconds}s ($(tr "\n" " " <<< "$others")): fencing an undrained copy"; return 0; }
    identity_log "$1: waiting for the runs holding the tail to end: $(tr "\n" " " <<< "$others")"
    sleep "$drain_poll_seconds"
  done
  # this run's drain fence (fence-rule.js): lingers hold nothing while it stands; mirror_fence replaces it with the run's
  echo "$(( $(date +%s) + drain_wait_seconds + 60 )) drain" > "$2/what-if-$$.part" && mv "$2/what-if-$$.part" "$2/what-if-$$"
  while :; do
    state=$(tail_state "$1"); position=${state% *}; behind=${state#* }
    case "$behind" in *[!0-9]*|'') return 0 ;; esac
    if [ "$position" = "$last" ]; then still=$((still + 1)); else still=0; fi
    if [ "$behind" -lt 120 ] || [ "$still" -ge 3 ]; then identity_log "$1: drained (${behind}s behind) in $(( SECONDS - started ))s"; return 0; fi
    [ $(( SECONDS - started )) -lt "$drain_wait_seconds" ] || { identity_log "$1: the tail did not drain in ${drain_wait_seconds}s (${behind}s behind): fencing as it is"; return 0; }
    last=$position
    sleep "$drain_poll_seconds"
  done
}
mirror_fence() {
  local dir f
  dir=$fence_root/$([ "$1" = pl ] && echo kinowo || echo "kinowo_$1")
  mkdir -p "$dir"
  other_runs "$dir" > /dev/null
  mirror_drain "$1" "$dir"
  f=$dir/what-if-$$
  echo "$(( $(date +%s) + 4 * 3600 )) run" > "$f.part" && mv "$f.part" "$f"
  fences+=("$f")
}
mirror_fence_linger() {
  local f
  for f in ${fences[@]+"${fences[@]}"}; do
    [ -f "$f" ] && echo "$(( $(date +%s) + fence_linger_minutes * 60 )) linger" > "$f.part" && mv "$f.part" "$f"
  done
  fences=()
}
# mirror_ready <cc> -> the generation a run of <cc> pins itself to; exit 2 while a seed is in flight or due
mirror_ready() {
  local gen; gen=$(mirror_generation "$1") || exit 2
  case "$gen" in
    seeding) harness_error "$1: mirror not ready: a seed is in flight (or died, leaving a torn copy): its collections are fragments until it finishes -- wait for scripts/local-mirror/freshness $1 to stop warning, then run again"; exit 2 ;;
    reseed-due) harness_error "$1: mirror not ready: its stream state is gone and a re-seed is due -- wait for it to finish (scripts/local-mirror/freshness $1), then run again"; exit 2 ;;
  esac
  printf '%s\n' "$gen"
}
# mirror_unchanged <cc> <pinned generation> <when> -> 0, or exit 2 when the mirror re-seeded (or began to), or tailed a
# write, since
mirror_unchanged() {
  local now; now=$(mirror_generation "$1") || exit 2
  [ "$now" = "$2" ] && return 0
  if [ "${now%%-tail*}" = "${2%%-tail*}" ]; then
    harness_error "$1: the mirror tailed a write during the run (generation $2 before the base, $now $3): the sides read different corpora, so no take is reported moved and nothing is recorded -- its fence did not hold (is the mirror service running a checkout with scripts/local-mirror/fence-rule.js? a fence older than its limits?); run again"
  else
    harness_error "$1: the mirror was re-seeded during the run (generation $2 before the base, $now $3): the sides read different corpora, so no take is reported moved and nothing is recorded -- run again once scripts/local-mirror/freshness $1 is quiet"
  fi
  return 2
}
# answers_ok <side dir> <label> -> 0, or 2 when the side's live asks failed past the bound (answers.txt: WhatIfAnswers'
# `N live request(s) (...; F failed) ...`)
answers_ok() {
  local line failed asked
  line=$(cat "$1/answers.txt" 2>/dev/null || true)
  failed=$(sed -nE 's/.*; ([0-9]+) failed\).*/\1/p' <<< "$line"); failed=${failed:-0}
  asked=$(sed -nE 's/^([0-9]+) live request.*/\1/p' <<< "$line"); asked=${asked:-0}
  [ "$failed" -gt "$max_failed_asks" ] || return 0
  harness_error "$cc: answers failed: $failed of $asked live ask(s) of the $2 side failed (more than $max_failed_asks, KINOWO_WHAT_IF_MAX_FAILED_ASKS): their questions are gaps the side took as pending, not moves -- the mirror not ready, or a service refusing; the side is not kept"
  return 2
}

seconds() { python3 -I -c 'import time; print(f"{time.time():.1f}")'; }
elapsed() { python3 -I -c "import sys; print(f'{float(sys.argv[2]) - float(sys.argv[1]):.0f}')" "$1" "$(seconds)"; }

tree_of() { if [ "$1" = . ]; then echo "$repo"; else identity_tree "$1" "${TOOL_FILES[@]}"; fi; }
# The code a tree runs: a ref's tree is its code; this checkout's, its commit and its uncommitted edits.
code_stamp() { # <tree>
  if [ "$1" != "$repo" ]; then basename "$1"; return; fi
  { git -C "$repo" rev-parse HEAD; git -C "$repo" diff HEAD; git -C "$repo" ls-files --others --exclude-standard -- '*.scala' '*.tsv' |
      while IFS= read -r f; do shasum "$repo/$f"; done; } | shasum | cut -c1-16
}
# resolve <tree> <cc> <out dir> <args...> -> that tree's WhatIfResolve, through its kept JVM (one per tree and code,
# started when none is: the corpus and its context loaded once, not per run), or a JVM of its own with --no-serve
resolve() {
  local tree=$1 cc=$2 dir=$3 cp rc=0; shift 3
  mkdir -p "$dir"
  if [ "$serve" = 1 ]; then served "$tree" "$cc" "$dir" "$@" && return 0; rc=$?; [ "$rc" = 3 ] || return "$rc"; fi
  cp=$(identity_classpath "$tree") || return 2
  jvm_slot_take identity-what-if
  rc=0
  (cd "$tree" && "${IDENTITY_JAVA[@]}" -cp "$cp" services.identity.WhatIfResolve "$cc" --out "$dir" "$@") > "$dir/run.log" 2>&1 || rc=$?
  jvm_slot_release
  [ "$rc" = 0 ] || { tail -30 "$dir/run.log" >&2; identity_log "$cc: WhatIfResolve failed in $tree (log $dir/run.log)"; return 2; }
}
# served <tree> <cc> <out dir> <args...> -> the request through the tree's kept JVM; 3 when no kept JVM could start
served() {
  local tree=$1 cc=$2 dir=$3 key sock pid cp rc; shift 3
  key=$(printf '%s\n' "$tree" "$(code_stamp "$tree")" | shasum | cut -c1-16)
  sock=$serve_dir/$key.sock
  mkdir -p "$serve_dir"
  for _ in 1 2; do
    pid=$(cat "$serve_dir/$key.pid" 2>/dev/null || echo "")
    if [ ! -S "$sock" ] || ! is_kept "$pid"; then
      cp=$(identity_classpath "$tree") || return 2
      rm -f "$sock"
      # an older code of this tree (an edit of this checkout) keeps no JVM of its own
      for f in "$serve_dir"/*.tree; do
        [ -f "$f" ] && [ "$(basename "$f" .tree)" != "$key" ] && [ "$(cat "$f")" = "$tree" ] || continue
        stop_kept "$(cat "${f%.tree}.pid" 2>/dev/null)" || true; rm -f "$f" "${f%.tree}.pid" "${f%.tree}.sock"
      done
      identity_log "starting a kept JVM for $tree (log $serve_dir/$key.log; stops after $idle_minutes idle minutes)"
      KINOWO_GOV_JOB=keeper jvm_slot_take identity-what-if   # the kept JVM's memory; each request its cores, below
      (cd "$tree" && set -m && { nohup "${IDENTITY_JAVA[@]}" -cp "$cp" services.identity.WhatIfResolve --serve "$sock" \
          --idle-minutes "$idle_minutes" > "$serve_dir/$key.log" 2>&1 < /dev/null 6>&- 7>&- 8>&- &
        echo $! > "$serve_dir/$key.pid"; printf '%s\n' "$tree" > "$serve_dir/$key.tree"; })
      jvm_slot_keeper_start "$repo" "$serve_dir/$key.keeper.log" "$self" --keep-served "$(cat "$serve_dir/$key.pid")"
      local started=$SECONDS
      until [ -S "$sock" ]; do
        kill -0 "$(cat "$serve_dir/$key.pid")" 2>/dev/null || { tail -20 "$serve_dir/$key.log" >&2; identity_log "the kept JVM did not start"; return 3; }
        [ $(( SECONDS - started )) -lt 300 ] || { stop_kept "$(cat "$serve_dir/$key.pid")" || true; identity_log "the kept JVM did not listen in 300 s"; return 3; }
        sleep 1
      done
    fi
    rc=0
    jvm_cpu_take identity-what-if what-if   # this request's cores (jvm-gate.sh): the keeper holds only the memory
    kept_jvm_call "$sock" "$cc" --out "$dir" "$@" > "$dir/run.log" 2>&1 || rc=$?
    jvm_slot_release
    case "$rc" in
      0) return 0 ;;
      111|112) identity_log "the kept JVM went away ($rc): starting another"; rm -f "$sock" ;;
      *) tail -30 "$dir/run.log" >&2; identity_log "$cc: WhatIfResolve failed in $tree (log $dir/run.log)"; return 2 ;;
    esac
  done
  return 3
}

# The newest snapshot moment <sha> was already resolved at for <cc> within --max-age hours, if any.
# The directory <sha>'s sides of <cc> are kept under: per tool files, answers and the mirror's seed generation
side_root() { echo "$cache/$1/$2-$tools_hash-$side_answers-mirror$mirror_gen"; } # <cc> <sha>
cached_at() { # <cc> [sha]
  local root; root=$(side_root "$1" "${2:-$base_sha}")
  [ -d "$root" ] || return 0
  python3 -I - "$root" "$max_age" "$final" <<'PY'
import datetime, os, sys
root, hours = sys.argv[1], float(sys.argv[2])
now = datetime.datetime.now(datetime.timezone.utc)
want = "final.tsv" if sys.argv[3] == "1" else "prod.tsv"
done = [d for d in os.listdir(root) if os.path.exists(os.path.join(root, d, "prod.tsv")) and os.path.exists(os.path.join(root, d, want))]
fresh = [d for d in done if now - datetime.datetime.fromisoformat(d.replace("Z", "+00:00")) <= datetime.timedelta(hours=hours)]
print(max(fresh) if fresh else "")
PY
}

# whole_side <sha> <cc> <snapshot> -> the directory of <sha>'s every family resolved at <snapshot> (takes, families,
# prod, final), KEPT per (sha, tool files, answers, snapshot): resolved here only when it is not.
# ONE PRODUCER (2026-11-20: two lanes' what-ifs of one base and snapshot shared `<dir>.part`, and the first to finish
# moved it away under the other, which failed): a run takes `<dir>.lock` (mkdir: atomic) before it resolves, into a
# `.part` of its own (pid and a random suffix), renamed whole into <dir>; a run finding the lock held waits for it
# and then reads the side the holder kept. A lock whose holder died is broken.
side_lock_wait=${KINOWO_WHAT_IF_SIDE_LOCK_WAIT_SECONDS:-3600}
side_lock_poll=${KINOWO_WHAT_IF_SIDE_LOCK_POLL_SECONDS:-2}
side_complete() { [ -f "$1/prod.tsv" ] && { [ "$final" = 0 ] || [ -f "$1/final.tsv" ]; }; }
side_lock() { # <dir> -> 0 holding <dir>.lock, 2 when it stayed held past the wait
  local lock=$1.lock holder started=$SECONDS said=0
  mkdir -p "$(dirname "$1")"
  until mkdir "$lock" 2>/dev/null; do
    holder=$(cat "$lock/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
      identity_log "breaking the lock of $(basename "$1") left by $holder (no longer running)"; rm -rf "$lock"; continue
    fi
    [ $(( SECONDS - started )) -lt "$side_lock_wait" ] || { harness_error "$cc: another what-if (pid ${holder:-?}) has been resolving this side for ${side_lock_wait}s ($lock)"; return 2; }
    [ "$said" = 1 ] || { identity_log "$cc: another what-if (pid ${holder:-?}) is resolving this side: waiting to read it"; said=1; }
    sleep "$side_lock_poll"
  done
  echo $$ > "$lock/pid"
}
whole_side() {
  # a JVM of its own, never a kept one: the side it resolves is kept on disk and never asked of that JVM again, which
  # would only have held a JVM slot idle for its 10 minutes (2026-11-15: a what-if queued 390 s behind two such)
  local sha=$1 cc=$2 snapshot=$3 dir tree serve=0 part
  dir=$(side_root "$cc" "$sha")/$snapshot
  if ! side_complete "$dir"; then
    side_lock "$dir" || return 2
    if side_complete "$dir"; then
      identity_log "$cc: reading ${sha:0:12}'s side at $snapshot another what-if just resolved"
    else
      part=$dir.part-$$-$RANDOM
      tree=$(tree_of "$sha") || { rm -rf "$dir.lock"; harness_error "$cc: laying out ${sha:0:12} for its whole side failed (exit $?)"; return 2; }
      identity_log "$cc: resolving ${sha:0:12} whole at $snapshot"
      resolve "$tree" "$cc" "$part" --at "$snapshot" "${answer_args[@]}" ${final_args[@]+"${final_args[@]}"} \
        --mirror-generation "$mirror_gen" >&2 || { rm -rf "$part" "$dir.lock"; return 2; }
      answers_ok "$part" "${sha:0:12}" || { rm -rf "$part" "$dir.lock"; return 2; }
      rm -rf "$dir"; mv "$part" "$dir"
    fi
    rm -rf "$dir.lock"
  fi
  answers_ok "$dir" "${sha:0:12}" || { rm -rf "$dir"; return 2; }
  printf '%s\n' "$dir"
}

if [ -n "$bisect_good" ]; then
  # BISECT: the commit of <good>..<bad> (first parent) whose code moved the take -- a listing's model and final take,
  # or every take -- over ONE mirror snapshot, each step a whole side kept as any base is; when <good> and <bad> take
  # alike there, the code did not move it: the corpus did, and the take at --since and at the snapshot is shown.
  [ "${#ccs[@]}" = 1 ] || { echo "--bisect: one country" >&2; exit 2; }
  cc=${ccs[0]}
  # each step's tree is resolved once: a kept JVM per step would hold a JVM slot idle for nothing
  serve=0
  good=$(git -C "$repo" rev-parse --verify "$bisect_good^{commit}") || { echo "--bisect: no commit $bisect_good" >&2; exit 2; }
  bad=$(git -C "$repo" rev-parse --verify "$bisect_bad^{commit}") || { echo "--bisect: no commit $bisect_bad" >&2; exit 2; }
  trap 'identity_said_exit $?; mirror_fence_linger' EXIT
  mirror_fence "$cc"
  mirror_gen=$(mirror_ready "$cc") || exit 2
  snapshot=${at:-$(cached_at "$cc" "$bad")}; snapshot=${snapshot:-$(date -u +%Y-%m-%dT%H:%M:00Z)}
  commits=("$good"); while IFS= read -r c; do commits+=("$c"); done < <(git -C "$repo" rev-list --first-parent --reverse "$good..$bad")
  take_args=(take); [ -z "$bisect_listing" ] || take_args+=(--listing "$bisect_listing")
  take_at() { local d; d=$(whole_side "$1" "$cc" "$2") || exit 2; python3 -I "$repo/scripts/identity_what_if.py" "${take_args[@]}" --side "$d"; }
  identity_log "$cc bisect: ${#commits[@]} commit(s) from ${good:0:12} to ${bad:0:12} at $snapshot${bisect_listing:+, listing $bisect_listing}"
  started=$(seconds)
  first=$(take_at "$good" "$snapshot"); last=$(take_at "$bad" "$snapshot")
  echo "  ${good:0:12} (good): $first"
  echo "  ${bad:0:12} (bad):  $last"
  if [ "$first" = "$last" ]; then
    since=${bisect_since:-$(python3 -I -c 'import datetime,sys; t=datetime.datetime.fromisoformat(sys.argv[1].replace("Z","+00:00")); print((t-datetime.timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:00Z"))' "$snapshot")}
    before=$(take_at "$bad" "$since")
    echo "  no commit of the range moves it at $snapshot: the code takes alike. ${bad:0:12} at $since: $before"
    [ "$before" = "$last" ] && echo "  CORPUS: the take stood alike at $since too -- neither the code nor the corpus moved it in that window" \
      || echo "  CORPUS: the corpus moved it between $since and $snapshot (scripts/identity-replay / identity-why name the input)"
    mirror_unchanged "$cc" "$mirror_gen" "after the bisect" || exit 2
    echo "  wall $(elapsed "$started")s"
    exit 0
  fi
  lo=0 hi=$(( ${#commits[@]} - 1 )) step=0
  while [ $(( hi - lo )) -gt 1 ]; do
    mid=$(( (lo + hi) / 2 )); step=$((step + 1))
    t=$(take_at "${commits[$mid]}" "$snapshot")
    echo "  step $step: ${commits[$mid]:0:12} $([ "$t" = "$first" ] && echo good || echo bad): $t"
    if [ "$t" = "$first" ]; then lo=$mid; else hi=$mid; fi
  done
  mirror_unchanged "$cc" "$mirror_gen" "after the bisect" || exit 2
  echo "  FIRST MOVED BY $(git -C "$repo" log -1 --format='%h %s' "${commits[$hi]}")"
  echo "    before: $(take_at "${commits[$lo]}" "$snapshot")"
  echo "    after:  $(take_at "${commits[$hi]}" "$snapshot")"
  echo "  snapshot $snapshot; $step step(s); wall $(elapsed "$started")s"
  exit 0
fi

# THE VERDICT RECORD (identity-tools.sh's what_if_record_verdict; scripts/identity-measure's what-if gate reads it): a
# line a country finished. A `.` head counts as its commit only with no uncommitted edits to tracked files.
verdict_head=$head_sha
[ "$head_sha" != . ] || { [ -z "$(git -C "$repo" status --porcelain --untracked-files=no)" ] && verdict_head=$(git -C "$repo" rev-parse HEAD); }
# With the takes moved (the model's and the final diff's rows) and how: every family or the selection, final takes or the
# model's -- a whole, nothing-moved verdict of every country is what carries a stamp (scripts/identity-stamp-carry).
record_verdict() { # <cc> <diff exit>
  [ "$verdict_head" != . ] || return 0
  local moved=- mode f files=("$out/takes-diff-$1.tsv")
  [ "$final" = 0 ] || files+=("$out/final-diff-$1.tsv")
  # a diff it did not write counts as unknown, never as none moved
  for f in "${files[@]}"; do [ -f "$f" ] || files=(); done
  [ "${#files[@]}" = 0 ] || moved=$(cat "${files[@]}" | grep -cv '^country' || true)
  mode="$([ "$whole" = 1 ] && echo whole || echo selected),$([ "$final" = 1 ] && echo final || echo model-only)"
  what_if_record_verdict "$verdict_head" "$base_sha" "$1" "$([ "$2" = 0 ] && echo "done" || echo "verify-failed")" "$out/takes-diff-$1.tsv" \
    "$moved" "$mode"
}
identity_log "base $base_sha, head $head_label; laying out and compiling the refs (once each)"
# Each step before the resolve that fails says which it was and its status (Order independence #90: an exit 2 here
# printed nothing, so the cause could not be told from the log)
step_failed() { harness_error "$1 failed (exit $2)"; exit 2; }
tree_of "$base_sha" > /dev/null || step_failed "laying out the base ${base_sha:0:12}" $?
head_tree=$(tree_of "$head_sha") || step_failed "laying out the head $head_label" $?
# HEAD = BASE (the same tree): a control, whose every moved take is the harness's own (below)
same_code=0; [ "$head_sha" = . ] || ! git -C "$repo" diff --quiet "$base_sha" "$head_sha" -- || same_code=1
judgements=${judgements:-$head_tree/test/resources/fixtures/identity-judgements.tsv}
# Whether the head resolves at all: the code alone says whether any change reaches a take (identity_what_if.py reaches).
# None (docs, tests, scripts, comments) and no --all/--verify: the selection is empty, so the head is not compiled
# beside the base -- and an empty selection (below) starts no head JVM at all.
reach=$(python3 -I "$repo/scripts/identity_what_if.py" reaches --repo "$repo" --base "$base_sha" --head "$head_sha") ||
  step_failed "identity_what_if.py reaches (whether the head's change reaches a take)" $?
# --all by default for a change reaching a take, the selection with --verify (which checks it) or one reaching none
[ "$all" != auto ] || { all=0; [ "$reach" = none ] || [ "$verify" = 1 ] || all=1; }
head_resolves=1; [ "$reach" != none ] || [ "$all" = 1 ] || [ "$verify" = 1 ] || head_resolves=0
# The head's compile, started beside the base's resolve when the base side is not kept (it takes its own JVM slot);
# waited for before the head resolves -- and on every exit before that (a harness error after the base): left running,
# it outlived the tool, holding its JVM slot, and wrote into the head's tree while the next run of that ref laid it out
# again, which then failed with no word (Order independence #90)
head_compile=""
compile_head_beside() {
  [ "$head_resolves" = 1 ] && [ -z "$head_compile" ] && ! identity_classpath_fresh "$head_tree" || return 0
  identity_log "compiling the head beside the base's resolve"
  identity_classpath "$head_tree" > /dev/null & head_compile=$!
}
head_compile_done() { [ -z "$head_compile" ] || { wait "$head_compile" || true; head_compile=""; }; }
trap 'identity_said_exit $?; head_compile_done; mirror_fence_linger' EXIT
status=0
for cc in "${ccs[@]}"; do
  mirror_fence "$cc"
  mirror_gen=$(mirror_ready "$cc") || exit 2
  started=$(seconds)
  snapshot=${at:-$(cached_at "$cc")}
  if [ -z "$snapshot" ]; then snapshot=$(date -u +%Y-%m-%dT%H:%M:00Z); fi
  base_root=$(side_root "$cc" "$base_sha")
  base_state=$([ -f "$base_root/$snapshot/final.tsv" ] || { [ "$final" = 0 ] &&
    [ -f "$base_root/$snapshot/prod.tsv" ]; } && echo kept || echo resolved)
  [ "$base_state" = kept ] || compile_head_beside
  base_dir=$(whole_side "$base_sha" "$cc" "$snapshot") || exit 2
  # a base resolved here off a copy that changed under it is not kept: it is no side of either generation
  mirror_unchanged "$cc" "$mirror_gen" "after the base" || { [ "$base_state" = kept ] || rm -rf "$base_dir"; exit 2; }
  base_seconds=$(elapsed "$started")
  head_dir=$out/$cc
  rm -rf "$head_dir"; mkdir -p "$head_dir"
  if [ "$all" = 1 ]; then
    tail -n +2 "$base_dir/takes.tsv" | cut -f1 > "$head_dir/select.txt"; selected="selected: ALL (--all)"
  else
    selected=$(python3 -I "$repo/scripts/identity_what_if.py" select --repo "$repo" --base "$base_sha" --head "$head_sha" \
      --takes "$base_dir/takes.tsv" --out "$head_dir/select.txt") || exit 2
  fi
  identity_log "$cc: $selected"
  # a selection of every family is a whole resolve too: what the verdict record says, and the stamp carry reads
  whole=0; [ "$all" = 1 ] || [ "$verify" = 1 ] ||
    { cmp -s <(sort -u "$head_dir/select.txt") <(tail -n +2 "$base_dir/takes.tsv" | cut -f1 | sort -u) && whole=1; } || true
  [ "$all" = 0 ] && [ "$verify" = 0 ] || whole=1
  head_started=$(seconds)
  more=(); [ "$verify" = 0 ] || more+=(--whole)
  if [ ! -s "$head_dir/select.txt" ] && [ "$verify" = 0 ]; then
    # nothing to re-resolve: what WhatIfResolve writes for an empty selection, without a compile or a JVM
    identity_log "$cc: no family to re-resolve: the head's takes are the base's (no head JVM)"
    printf 'key\tvenue\trawTitle\tfamily\ttake\trules\n' > "$head_dir/takes.tsv"
    printf 'selected\tre-resolved\tgroups\trounds\n0\t0\t0\t1\n' > "$head_dir/region.tsv"
    [ "$final" = 0 ] || printf 'key\tfinal\tbasis\n' > "$head_dir/final.tsv"
    echo > "$head_dir/answers.txt"
  else
    head_compile_done
    resolve "$head_tree" "$cc" "$head_dir" --at "$snapshot" --select "$head_dir/select.txt" --families "$base_dir/families.tsv" \
      --base-takes "$base_dir/takes.tsv" --threads "$threads" "${answer_args[@]}" ${final_args[@]+"${final_args[@]}"} \
      ${more[@]+"${more[@]}"} --mirror-generation "$mirror_gen" || exit 2
    answers_ok "$head_dir" head || exit 2
  fi
  mirror_unchanged "$cc" "$mirror_gen" "after the head" || { [ "$base_state" = kept ] || rm -rf "$base_dir"; exit 2; }
  # both sides read: this country's fence lingers now, not once every later country is done too (a run of five held
  # the first one's tail for all five)
  mirror_fence_linger
  head_seconds=$(elapsed "$head_started")
  diff_args=(diff --cc "$cc" --base "$base_dir" --head "$head_dir" --judgements "$judgements" --tsv "$out/takes-diff-$cc.tsv")
  [ "$verify" = 0 ] || diff_args+=(--verify)
  [ "$json" = 0 ] || diff_args+=(--json)
  rc=0; python3 -I "$repo/scripts/identity_what_if.py" "${diff_args[@]}" || rc=$?
  if [ "$same_code" = 1 ]; then
    moved=$(cat "$out/takes-diff-$cc.tsv" "$out/final-diff-$cc.tsv" 2>/dev/null | grep -cv '^country' || true)
    if [ "$moved" -gt 0 ]; then
      # the base side is dropped whether kept or not: one of the two read other inputs, and a kept one is the suspect
      rm -rf "$base_dir"
      harness_error "$cc: the same code moved $moved take(s) (head ${head_label} = base ${base_sha:0:12}): the sides read different inputs -- a mirror changed under a kept base side or its fence, or live answers one side had and the other did not (answers above); nothing recorded, the base side dropped -- run again"
      exit 2
    fi
  fi
  [ "$rc" = 0 ] || status=$rc
  record_verdict "$cc" "$rc"
  region=$(tail -n 1 "$head_dir/region.tsv" | awk -F'\t' '{print $2 " listings in " $3 " group(s), " $4 " round(s)"}')
  echo "  $selected; re-resolved $region"
  for side in "$base_dir" "$head_dir"; do
    [ ! -s "$side/answers.txt" ] || [ "$(cat "$side/answers.txt")" = "" ] || echo "  answers asked live ($([ "$side" = "$head_dir" ] && echo head || echo base)): $(cat "$side/answers.txt")"
  done
  echo "  snapshot $snapshot; answers $answers; wall: base ${base_seconds}s ($base_state), head ${head_seconds}s, total $(elapsed "$started")s; rows $out/takes-diff-$cc.tsv"
done
exit "$status"
