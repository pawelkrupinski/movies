#!/usr/bin/env bash
# Re-pin identity slice cases on this checkout's code, in place, keeping each case's expected.tsv.
#
#   scripts/identity-slice-refresh [--recording RUN] <case dir>...
#
# A pinned case (test/resources/fixtures/identity-slices/<dir>, IdentitySliceCasesSpec) holds every answer its listings
# read when it was emitted. A resolver change that makes them ask more -- a listing it leaves unmatched asks the
# agreement's lookups, a new banner a new search -- fails the case with "lacks answers" though nothing it pins moved.
# This re-emits each case (scripts/identity-slice --emit-case) with every listing its expected.tsv names, on the
# recording given (default identity-slice's), into a scratch root, then puts the new slice files into the case's own
# directory and keeps its expected.tsv as it was: a hand expectation ("not:<film>", "pending:…") survives, the case keeps
# its name, and no other case is touched.
#
# The country is the directory name's prefix (de-…, uk-…). A case is left as it was when its re-emit fails or pins its
# listings as more than one slice (they fall in several clusters: re-emit them by hand, or with --widen). Exit 1 when
# any case was not re-pinned, 2 on a usage error.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/tool-conventions.sh
. "$here/tool-conventions.sh" # usage_from_header
slice=${IDENTITY_SLICE:-$here/identity-slice}
recording=()
cases=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --recording) recording=(--recording "$2"); shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) echo "identity-slice-refresh: unknown option $1" >&2; exit 2 ;;
    *) cases+=("${1%/}") ;;
  esac
  shift
done
[ "${#cases[@]}" -gt 0 ] || { usage_from_header >&2; exit 2; }

say() { echo "identity-slice-refresh: $*" >&2; }
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
failed=0
for dir in "${cases[@]}"; do
  [ -f "$dir/expected.tsv" ] || { say "$dir: no expected.tsv -- not a slice case"; failed=1; continue; }
  name=$(basename "$dir")
  cc=${name%%-*}
  # every listing once (a `not:` case names one listing per film it must not take); a last line without its newline too
  keys=()
  while IFS= read -r key; do keys+=(--key "$key"); done < <(
    tail -n +2 "$dir/expected.tsv" | while IFS=$'\t' read -r venue raw _ || [ -n "$venue" ]; do
      [ -z "$venue$raw" ] || printf '%s|%s\n' "$venue" "$raw"
    done | awk '!seen[$0]++')
  [ "${#keys[@]}" -gt 0 ] || { say "$dir: its expected.tsv names no listing"; failed=1; continue; }
  root="$scratch/$name"
  mkdir -p "$root"
  if ! out=$(KINOWO_IDENTITY_SLICE_EMIT_ROOT="$root" "$slice" "$cc" "${recording[@]+"${recording[@]}"}" "${keys[@]}" --emit-case 2>&1); then
    printf '%s\n' "$out" | tail -5 >&2
    say "$dir: re-emit failed, left as it was"; failed=1; continue
  fi
  # identity-slice names each directory it pinned: "--emit-case: N listing(s) pinned in <path> (…"
  pinned=$(printf '%s\n' "$out" | sed -n 's/^--emit-case: .* pinned in \(.*\) (IdentitySliceCasesSpec.*$/\1/p')
  count=$(printf '%s' "$pinned" | grep -c . || true)
  if [ "$count" != 1 ]; then
    say "$dir: its listings were pinned as $count slices (they fall in several clusters), left as it was"; failed=1; continue
  fi
  [ -d "$pinned" ] || { say "$dir: identity-slice named no pinned directory, left as it was"; failed=1; continue; }
  for f in slice.json.gz rows.json.gz http.jsonl.gz filed.json.gz filed.source; do
    rm -f "${dir:?}/${f:?}"
    [ ! -f "$pinned/$f" ] || cp "$pinned/$f" "$dir/$f"
  done
  say "$dir: re-pinned ($(( ${#keys[@]} / 2 )) listing(s))"
done
exit "$failed"
