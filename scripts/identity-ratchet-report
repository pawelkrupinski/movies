#!/usr/bin/env python3
"""The unmatched-cluster ratchet's findings as a clean table — WRONG / UNJUDGED / MOVED / LOST / NEW takes, each with
the decision's explanation — from an "Identity capture" run, the PR it opened, or a local ratchet run.

  scripts/identity-ratchet-report <run id | PR number | ratchet-takes.tsv | --local> [--status S[,S]] [--country cc]
                                  [--explain] [--tsv] [--limit N]

  run id      an identity-capture.yml run: its `identity-ratchet` artifact (ratchet-takes.tsv, written by
              UnmatchedClustersRatchetSpec). A run from before the artifact existed is read from its pull-request
              job's log instead (no explanations; a LOST take's venue is the text before its first comma).
  PR number   a capture PR (opened only once the ratchet is green): the run its body names ("run 38389526184").
  --local     target/identity-unmatched/ratchet-takes.tsv, written by a local
              `sbt "worker/testOnly services.identity.UnmatchedClustersRatchetSpec"`.
  --status    only these (default WRONG,UNJUDGED,MOVED,LOST); ALL for every finding
  --explain   print each take's explanation under it
  --tsv       print the findings as TSV (the artifact's columns) instead of the table, for a script or a spreadsheet

Downloads are kept in $KINOWO_IDENTITY_CACHE/ratchet/<run>/ (default ~/.cache/kinowo-identity): a repeat is instant.
"""
import csv
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter

REPO = os.environ.get("KINOWO_REPO", "pawelkrupinski/movies")
CACHE = os.environ.get("KINOWO_IDENTITY_CACHE", os.path.expanduser("~/.cache/kinowo-identity"))
COLUMNS = ["status", "country", "venue", "rawTitle", "film", "title", "basis", "ids", "was", "explanation"]
ORDER = ["WRONG", "UNJUDGED", "MOVED", "LOST", "NEW", "RIGHT"]
LOCAL = os.path.join("target", "identity-unmatched", "ratchet-takes.tsv")


GH_TIMEOUT = int(os.environ.get("KINOWO_IDENTITY_DOWNLOAD_TIMEOUT", "1800"))
# what gh prints when a run holds no such artifact (scripts/ci/gh-optional.sh): anything else is a read that failed
ABSENT = re.compile(r"no artifact matches|no valid artifacts found|HTTP 404")


def gh_run(*args):
    """gh, bounded: (exit status, stdout, stderr), a timeout an exit status like any other failure."""
    try:
        done = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 124, "", f"gh {' '.join(args)} timed out after {GH_TIMEOUT}s"
    return done.returncode, done.stdout, done.stderr


def gh(*args):
    code, out, err = gh_run(*args)
    if code != 0:
        sys.exit(f"[identity-ratchet-report] could not read gh {' '.join(args[:2])}: {err.strip() or f'exit {code}'}")
    return out


def read_tsv(path):
    with open(path, encoding="utf-8", newline="") as f:
        rows = list(csv.DictReader(f, delimiter="\t", quoting=csv.QUOTE_NONE))
    return [{c: (r.get(c) or "") for c in COLUMNS} for r in rows]


def write_tsv(rows, out):
    out.write("\t".join(COLUMNS) + "\n")
    for r in rows:
        out.write("\t".join(r[c] for c in COLUMNS) + "\n")


ANSI = re.compile(r"(\x1b|\^\[)\[[0-9;]*m")
SECTIONS = {"WRONG takes:": "WRONG", "UNJUDGED takes:": "UNJUDGED", "right takes LOST:": "LOST"}


def parse_log(text):
    """The findings the ratchet's assertion messages print in a job log: sbt's ANSI colours, the log's job/step/time
    prefix and sbt's [info] tag stripped."""
    rows, section = [], None
    for raw in text.splitlines():
        line = ANSI.sub("", raw)
        line = re.sub(r"^[^\t]*\t[^\t]*\t\S+Z ", "", line)  # job, step, timestamp
        line = re.sub(r"^\[info\] ?", "", line)
        body = line[2:] if line.startswith("  ") else line
        if body.strip() in SECTIONS:
            section = SECTIONS[body.strip()]
            continue
        if section is None:
            continue
        if section == "LOST":
            m = re.fullmatch(r"\(([a-z]{2}),(.*),([a-z]+:[^,]+)\)\s*", body)
            if not m:
                section = None
                continue
            venue, _, raw_title = m.group(2).partition(",")
            rows.append(dict(zip(COLUMNS, ["LOST", m.group(1), venue, raw_title, "", "", "", "", m.group(3), ""])))
            continue
        cells = body.rstrip().split("\t")
        if not re.fullmatch(r"[a-z]{2}", cells[0]) or len(cells) < 4:
            section = None
            continue
        cells += [""] * 7
        if section == "WRONG":
            rows.append(dict(zip(COLUMNS, ["WRONG", *cells[:5], "", "", "", ""])))
        else:
            rows.append(dict(zip(COLUMNS, ["UNJUDGED", *cells[:5], cells[5], cells[6], "", ""])))
    return rows


def run_of_pr(number):
    body = json.loads(gh("pr", "view", str(number), "-R", REPO, "--json", "body"))["body"]
    m = re.search(r"run (\d{6,})", body)
    if not m:
        sys.exit(f"PR {number}'s body names no capture run")
    return m.group(1)


def findings_of_run(run):
    """The run's findings, cached: its artifact, else its pull-request job's log."""
    folder = os.path.join(CACHE, "ratchet", run)
    cached = os.path.join(folder, "ratchet-takes.tsv")
    if os.path.exists(cached):
        return read_tsv(cached)
    os.makedirs(folder, exist_ok=True)
    # downloaded beside the cache's copy, moved in whole: a download cut short is never read back as the findings
    part = tempfile.mkdtemp(prefix="dl.", dir=folder)
    try:
        code, _, err = gh_run("run", "download", run, "-R", REPO, "--name", "identity-ratchet", "--dir", part)
        if code == 0 and os.path.exists(os.path.join(part, "ratchet-takes.tsv")):
            os.replace(os.path.join(part, "ratchet-takes.tsv"), cached)
            return read_tsv(cached)
    finally:
        shutil.rmtree(part, ignore_errors=True)
    # only an artifact gh says is not there sends the read to the log: a failed download is not an absent artifact
    if code != 0 and not ABSENT.search(err):
        sys.exit(f"[identity-ratchet-report] could not download run {run}'s identity-ratchet artifact: {err.strip() or f'exit {code}'}")
    print(f"[identity-ratchet-report] run {run} has no identity-ratchet artifact: reading its pull-request job's log",
          file=sys.stderr)
    jobs = json.loads(gh("run", "view", run, "-R", REPO, "--json", "jobs"))["jobs"]
    job = next((j for j in jobs if j["name"] == "pull-request"), None)
    if job is None:
        sys.exit(f"run {run} has no pull-request job")
    rows = parse_log(gh("run", "view", "-R", REPO, "--job", str(job["databaseId"]), "--log"))
    with open(cached, "w", encoding="utf-8") as f:
        write_tsv(rows, f)
    return rows


def table(rows, explain, out):
    widths = {"venue": 34, "rawTitle": 46, "film": 16, "title": 40}
    def cut(text, n):
        return text if len(text) <= n else text[: n - 1] + "…"
    for status in ORDER:
        group = [r for r in rows if r["status"] == status]
        if not group:
            continue
        out.write(f"\n{status} ({len(group)})\n")
        for r in group:
            film = r["film"] + (f" (was {r['was']})" if r["was"] else "")
            out.write(f"  {r['country']}  {cut(r['venue'], widths['venue']):<34}  {cut(r['rawTitle'], widths['rawTitle']):<46}  "
                      f"{cut(film, 30):<30}  {cut(r['title'], widths['title']):<40}  {r['basis']}\n")
            if explain and r["explanation"]:
                for part in r["explanation"].split(" ¶ "):
                    out.write(f"        {part}\n")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    source, statuses, country, explain, as_tsv, limit = argv[0], "WRONG,UNJUDGED,MOVED,LOST", None, False, False, None
    rest = argv[1:]
    while rest:
        flag = rest.pop(0)
        if flag == "--status": statuses = rest.pop(0)
        elif flag == "--country": country = rest.pop(0)
        elif flag == "--explain": explain = True
        elif flag == "--tsv": as_tsv = True
        elif flag == "--limit": limit = int(rest.pop(0))
        else:
            print(f"unknown argument {flag}", file=sys.stderr)
            return 2
    if source == "--local":
        rows = read_tsv(LOCAL)
    elif os.path.isfile(source):
        rows = read_tsv(source)
    elif re.fullmatch(r"\d{6,}", source):
        rows = findings_of_run(source)
    elif re.fullmatch(r"\d{1,5}", source):
        rows = findings_of_run(run_of_pr(source))
    else:
        print(f"no run, PR or file {source}", file=sys.stderr)
        return 2
    counts = Counter(r["status"] for r in rows)
    wanted = set(ORDER) if statuses.upper() == "ALL" else set(statuses.upper().split(","))
    rows = [r for r in rows if r["status"] in wanted and (country is None or r["country"] == country)]
    if limit is not None:
        rows = rows[:limit]
    if as_tsv:
        write_tsv(rows, sys.stdout)
    else:
        print("findings: " + ", ".join(f"{s} {counts[s]}" for s in ORDER if counts[s]))
        table(rows, explain, sys.stdout)
    return 0


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `| head` ends the table quietly
    sys.exit(main(sys.argv[1:]))
