#!/usr/bin/env bash
#
# Where a Claude Code session's subagents spent their time: every agent's hours by bucket -- polling waits (sleep loops, ci-wait, wait-for) by what they
# wait for (a CI run, a measurement, a slice, an sbt suite, a local convergence leg), waits on a background command by the
# command that launched it, idle gaps over 3 minutes, the model's own short gaps, foreground sbt runs by their shape, the
# pre-push hook's `git push` -- then the 10 longest agents with their top buckets.
#
#   scripts/agent-time [<tasks dir>] [--longest N]
#   scripts/agent-time [<tasks dir>] --agent <id or prefix> [--top N]    one agent's N slowest steps, in order
#
#   <tasks dir>  a session's tasks directory (/private/tmp/claude-$UID/<project>/<session>/tasks); default the newest
#                session's of this checkout's project (AGENT_TIME_ROOT overrides /private/tmp/claude-$UID)
#
# Read-only: it parses the transcripts (`<agent id>.output`, first line carrying "agentId") and the session's own.
# The logic and its tests: scripts/agent_time.py, scripts/agent_time_test.py.
set -euo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh" # usage_from_header
case "${1:-}" in -h|--help) usage_from_header; exit 0 ;; esac
exec python3 -I "$(dirname "$0")/agent_time.py" "$@"
