#!/usr/bin/env bash
# THE ONE WAY CI RUNS SBT: every sbt setup on CI (sbt/setup-sbt, through setup-sbt-build, convergence-setup,
# run-page-test or a job's own step) puts this directory first on PATH, so each `sbt ...` of a workflow or a CI script
# comes here, and it runs the real sbt with the same arguments, output and exit status. (OneSbtPathSpec)
#
# WHY. A compile can read a STALE TASTy file: `-Wsafe-init` follows a constructor into another file's compiled body,
# and in zinc's first cycle that body can predate a signature change (project/StaleTastyRetry.scala). The build's
# plugin recovers a batch run by dropping the configuration's classes and running the batch again, but only while it is
# armed, and a batch could disarm it: Identity live drift #2001 (run 3141) began `set worker / Test / run / fork :=
# false`, whose reload armed the plugin a second time, and failed every country. So the recovery is here too, outside
# the build: a run that failed on the stale read and was NOT retried by the plugin drops the stale classes
# (`staleTastyDrop`) and runs once more. A run the plugin already retried is left failed: a second retry would only
# repeat it.
set -uo pipefail

guard_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

# The real sbt: the first `sbt` on PATH that is not this one.
real=""
IFS=: read -r -a path_dirs <<< "$PATH"
for dir in "${path_dirs[@]}"; do
  [ -n "$dir" ] && [ -x "$dir/sbt" ] || continue
  [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$guard_dir" ] && continue
  real="$dir/sbt"
  break
done
[ -n "$real" ] || { echo "sbt-guard: no sbt on PATH besides $guard_dir" >&2; exit 127; }

stale_read='due to error in reading TASTy'
plugin_retried='[stale TASTy] running the batch again'

log=$(mktemp "${TMPDIR:-/tmp}/sbt-guard.XXXXXX")
trap 'rm -f "$log" "$log.status"' EXIT

# The real sbt with its stdout and stderr kept apart (a caller may read either), each copied into the log.
run() {
  : > "$log"
  { { "$real" "$@"; echo $? > "$log.status"; } 2>&1 1>&3 3>&- | tee -a "$log" 3>&- >&2; } 3>&1 | tee -a "$log"
  local status
  status=$(cat "$log.status" 2>/dev/null || echo 1)
  rm -f "$log.status"
  return "$status"
}

run "$@"
status=$?
[ "$status" -ne 0 ] || exit 0
grep -qF "$stale_read" "$log" || exit "$status"
if grep -qF "$plugin_retried" "$log"; then exit "$status"; fi

# The drop goes the way the run went: a `--client` run's to its server (whose build never arms the plugin), any other
# as a batch of its own.
drop=(-batch staleTastyDrop)
for arg in "$@"; do [ "$arg" = "--client" ] && drop=(--client staleTastyDrop); done
echo "sbt-guard: the run failed on a stale TASTy read and was not retried: dropping the stale classes and running it again" >&2
"$real" "${drop[@]}" || exit "$status"
run "$@"
