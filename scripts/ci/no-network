#!/usr/bin/env bash
# NO NETWORK FOR THE TESTS: run a command that may reach loopback and nothing else. Order independence's test steps run
# through it once their dependencies are fetched (each leg's warm step, the one that may use the network, retrying at
# the fetch layer only): a test that still reads the network then fails at once, naming the address, instead of
# passing or failing by the day's network (a Maven 429 mid-run, run #53).
#
#   scripts/ci/no-network -- <command...>    run it cut off
#   scripts/ci/no-network --probe            the mode this runner allows, one word and why
#
# Modes, the strongest the runner allows (NO_NETWORK_MODE forces one; a mode the runner cannot give is an error):
#   netns    Linux: a network namespace holding only loopback, as the same user (unshare --user --map-current-user
#            --net; on a github-hosted VM, AppArmor's unprivileged-userns restriction lifted first). Nothing leaves: a
#            connect is "Network is unreachable".
#   sandbox  macOS: sandbox-exec denying every outbound IP connection but localhost's (EPERM at connect).
#   proxy    neither: every HTTP(S) client -- curl, python, every JVM through JAVA_TOOL_OPTIONS -- sent to a closed
#            loopback port, loopback exempt. It does not stop a raw socket: a warning says so.
# (scripts/ci/no-network-test.sh)
set -euo pipefail

SANDBOX_PROFILE='(version 1)(allow default)(deny network-outbound (remote ip "*:*"))(allow network-outbound (remote ip "localhost:*"))'
CLOSED=127.0.0.1:9 # discard: nothing listens there

# THE SAME USER INSIDE (Order independence #113, run 45030284135): mapped to root, the JVM's user.home is passwd's
# /root, not $HOME -- every sbt launcher failed "AccessDeniedException: /root/.sbt/..." on ci-runner's job image, whose
# job user is no root. --map-current-user keeps the uid (and so its home and caches); --keep-caps keeps the namespace's
# own capabilities across the exec, which bringing loopback up needs.
NETNS="unshare --user --map-current-user --keep-caps --net --"
LOOPBACK_UP='ip link set lo up 2> /dev/null || ifconfig lo up 2> /dev/null'
netns_works() { command -v unshare > /dev/null 2>&1 && $NETNS sh -c "$LOOPBACK_UP" 2> /dev/null; }
netns_allowed() {
  netns_works && return 0
  # GitHub's Ubuntu VMs restrict unprivileged user namespaces (AppArmor); the VM is the job's alone, so lift it there
  [ "${RUNNER_ENVIRONMENT:-}" = github-hosted ] && [ "$(uname -s)" = Linux ] || return 1
  sudo -n sysctl -qw kernel.apparmor_restrict_unprivileged_userns=0 > /dev/null 2>&1 || return 1
  netns_works
}
sandbox_works() { [ "$(uname -s)" = Darwin ] && command -v sandbox-exec > /dev/null 2>&1 && sandbox-exec -p "$SANDBOX_PROFILE" true 2> /dev/null; }

mode() {
  case "${NO_NETWORK_MODE:-}" in
    netns) netns_allowed || { echo "no-network: NO_NETWORK_MODE=netns, but this runner allows no network namespace" >&2; return 1; }; echo netns ;;
    sandbox) sandbox_works || { echo "no-network: NO_NETWORK_MODE=sandbox, but this is no macOS with sandbox-exec" >&2; return 1; }; echo sandbox ;;
    proxy) echo proxy ;;
    "") if netns_allowed; then echo netns; elif sandbox_works; then echo sandbox; else echo proxy; fi ;;
    *) echo "no-network: unknown NO_NETWORK_MODE ${NO_NETWORK_MODE}" >&2; return 64 ;;
  esac
}

case "${1:-}" in
  --probe)
    m="$(mode)"
    case "$m" in
      netns) echo "netns (a network namespace with loopback only)" ;;
      sandbox) echo "sandbox (sandbox-exec: no outbound IP but localhost)" ;;
      proxy) echo "proxy (no network namespace here: HTTP(S) clients sent to a closed port; raw sockets not stopped)" ;;
    esac ;;
  --)
    shift
    [ $# -gt 0 ] || { echo "usage: no-network -- <command...>" >&2; exit 64; }
    m="$(mode)"
    case "$m" in
      netns)
        # shellcheck disable=SC2016 # the inner shell's own "$@"
        # shellcheck disable=SC2086 # NETNS: words by design
        exec $NETNS sh -c "$LOOPBACK_UP"' || exit 70; exec "$@"' no-network "$@" ;;
      sandbox) exec sandbox-exec -p "$SANDBOX_PROFILE" "$@" ;;
      proxy)
        echo "::warning title=no-network::this runner allows no network namespace: HTTP(S) clients go to a closed port, raw sockets are not stopped" >&2
        export http_proxy="http://$CLOSED" https_proxy="http://$CLOSED" HTTP_PROXY="http://$CLOSED" HTTPS_PROXY="http://$CLOSED"
        export no_proxy="localhost,127.0.0.1,::1" NO_PROXY="localhost,127.0.0.1,::1"
        export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=9 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=9 -Dhttp.nonProxyHosts=localhost|127.*|[::1]"
        exec "$@" ;;
    esac ;;
  *) echo "usage: no-network -- <command...> | --probe" >&2; exit 64 ;;
esac
