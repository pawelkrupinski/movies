#!/bin/sh
# Purpose: Coverage of the methods a change touches (scoverage; a report, never a gate; a name for coverage_touched.py)
# COVERAGE OF THE METHODS A CHANGE TOUCHES -- the name its callers run: scripts/coverage_touched.py is the tool, its
# header (`--help`) says what it does, and how.
exec python3 "$(dirname "$0")/coverage_touched.py" "$@"
