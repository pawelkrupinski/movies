#!/usr/bin/env bash
# COVERAGE OF THE METHODS A CHANGE TOUCHES (scoverage; a report, never a gate): which touched production methods the
# specs that reach them leave unrun, so the pinning tests are written FIRST -- before a refactor moves what they would
# have to pin.
#
#   scripts/coverage-touched <base>..<head> [--below <percent>] [--out DIR]
#
# Over a throwaway worktree at <head> (scripts/touched-tree.sh; the caller's checkout and its build are never touched):
# the touched methods (a hunk's line inside a `def`: scripts/touched_methods.py over quality.MethodSpans), the specs that
# reach them (`touchedSpecs`: a spec of the method's source, or of a production caller using its name), then ONLY the touched methods' modules compiled with
# coverage on (`set <module>/coverageEnabled := true`: the Scala 3 compiler's own instrumentation, sbt-scoverage
# reading it), only those specs run (`<module>/testOnly`, in whichever module they are), and each instrumented module's
# report read: every touched method's statements and how many ran, those under --below (default 80%) first. A spec
# that fails still counts what it ran (said in the report). Instrumentation is never on in the normal build: the
# plugin's coverageEnabled is false by default, and nothing here sets it outside the worktree.
#
#   --below N   the statement coverage under which a method is listed first (default 80)
#   --out DIR   keep touched.tsv, specs.txt, the sbt logs, the XML reports and report.md in DIR (default: a temporary
#               directory, removed)
#
# Exit 0 with the report (also when nothing is touched); 1 when a step failed; 2 a usage error. The heavy step runs under
# one governor ticket (scripts/gov-run --job coverage-touched).
set -euo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
# shellcheck source=scripts/touched-tree.sh
. "$(dirname "$0")/touched-tree.sh"

range="" below=80 keep=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage_from_header; exit 0 ;;
    --below) flag_value "$@"; below=$2; shift ;;
    --out) flag_value "$@"; keep=$2; shift ;;
    -*) usage_error "unknown flag $1" ;;
    *) [ -z "$range" ] || usage_error "one range, not '$range' and '$1'"; range=$1 ;;
  esac
  shift
done
[ -n "$range" ] || usage_error "a range <base>..<head>"
case "$below" in ''|*[!0-9.]*) usage_error "--below wants a percentage, not '$below'" ;; esac

TT_OUT=$keep
touched_tree_open coverage-touched "$range"
started=$SECONDS
if ! touched_tree_methods; then
  echo "coverage-touched: the range touches no production method"
  exit 0
fi
touched_tree_specs

modules=$(touched_tree_modules)
enable=() reports=() runs=()
for m in $modules; do
  enable+=("set $m/coverageEnabled := true")
  reports+=("$m/coverageReport")
done
for tm in $(cut -d' ' -f1 "$TT_OUT/specs.txt" | sort -u); do
  runs+=("$tm/testOnly $(awk -v m="$tm" '$1 == m { printf "%s ", $2 }' "$TT_OUT/specs.txt" | sed 's/ $//')")
done
spec_count=$(grep -c . "$TT_OUT/specs.txt" || true)
echo "coverage-touched: $(grep -c . "$TT_OUT/touched.tsv") touched method(s) in $(echo "$modules" | tr '\n' ' ')- ${spec_count} spec(s) reach them"

tests_rc=0
if [ ${#runs[@]} -gt 0 ]; then
  "$TT_TOOLS/scripts/gov-run" --job coverage-touched --cores 4 --mem 4 -- \
    bash -c '. "$1/scripts/touched-tree.sh"; TT_TREE=$2 TT_TOOLS=$1; shift 2; touched_tree_sbt "$@"' _ \
    "$TT_TOOLS" "$TT_TREE" "$TT_OUT/tests.log" "${enable[@]}" "${runs[@]}" || tests_rc=$?
fi
touched_tree_sbt "$TT_OUT/report.log" "${enable[@]}" "${reports[@]}" \
  || { tail -20 "$TT_OUT/report.log" >&2; die "coverageReport failed (log: $TT_OUT/report.log)"; }

xml=()
for m in $modules; do
  found=$(find "$TT_TREE/$m/target" -path '*scoverage-report/scoverage.xml' 2>/dev/null | head -1 || true)
  if [ -n "$found" ]; then xml+=(--xml "$found"); cp "$found" "$TT_OUT/scoverage-$m.xml"; fi
done
{
  python3 -I "$TT_TOOLS/scripts/touched_methods.py" coverage --touched "$TT_OUT/touched.tsv" --below "$below" \
    --root "$TT_TREE" "${xml[@]+"${xml[@]}"}"
  [ ${#runs[@]} -gt 0 ] || echo "No spec reaches the touched methods: every one is unpinned."
  [ "$tests_rc" -eq 0 ] || echo "Some reaching specs FAILED (exit $tests_rc; log: $TT_OUT/tests.log): what they ran still counts."
  echo "coverage-touched: $((SECONDS - started)) s"
} | tee "$TT_OUT/report.md"
