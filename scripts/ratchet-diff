#!/usr/bin/env bash
# Purpose: The ratchet diff (CLAUDE.md, the coupling and code-quality ratchets): every frozen row that changed between two refs
# THE RATCHET DIFF (CLAUDE.md, the coupling and code-quality ratchets): every frozen row that changed between two refs --
# complexity (cognitive, cyclomatic, inner-defs), length (method, file), duplication, fan-out, package D, cycles, and the
# JS/TS ratchet's rows (`js <kind>`, test/resources/js-quality-baseline.tsv) -- as a
# before -> after table marked fell / rose / new / measured / removed / moved, then per metric the totals and how many rows are
# still over the limit. A lane's report pastes this, never numbers written by hand.
#
#   scripts/ratchet-diff <base>..<head>          markdown, read from the committed baselines at each ref (cheap)
#   scripts/ratchet-diff <base>                  the same, <head> HEAD
#   scripts/ratchet-diff --tsv <base>..<head>    the same rows as TSV
#   scripts/ratchet-diff --measure <base>        the head side measured from this WORKING TREE (scripts/quality-report
#                                                and scripts/coupling-report --out, through sbt-warm, and
#                                                scripts/js-quality-report's production areas) instead of its
#                                                committed baselines: a fall nobody recorded with --update shows too
#                                                (run this checkout's own copy: another's measures its tree)
#
# The table and its marks: scripts/ci/ratchet_diff.py.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
measure="" format=() range=""
while [ $# -gt 0 ]; do
    case "$1" in
        --measure) measure=1 ;;
        --tsv) format=(--tsv) ;;
        -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*) echo "ratchet-diff: unknown argument $1" >&2; exit 2 ;;
        *) [ -z "$range" ] || { echo "ratchet-diff: one range" >&2; exit 2; }; range="$1" ;;
    esac
    shift
done
[ -n "$range" ] || { echo "ratchet-diff: <base>..<head> (or <base>) is required" >&2; exit 2; }
base="${range%%..*}"
head=""
case "$range" in *..*) head="${range#*..}" ;; esac
args=(--base "$base")
if [ -n "$measure" ]; then
    # the measure reads this script's checkout, the refs come from the current one: they must be the same checkout (a
    # worktree calling the root checkout's copy measured main's tree and said "No ratchet row changed")
    "$root/scripts/own-checkout" "$0" || exit 2
    if [ -n "$head" ] && [ "$(git rev-parse "$head")" != "$(git rev-parse HEAD)" ]; then
        echo "ratchet-diff: --measure measures this working tree: give <base> or <base>..HEAD" >&2; exit 2
    fi
    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    "$root/scripts/quality-report" --out "$work/quality" > "$work/quality.log" 2>&1 || true
    "$root/scripts/coupling-report" --out "$work/coupling" > "$work/coupling.log" 2>&1 || true
    "$root/scripts/js-quality-report" --areas "$root/scripts/js-quality/ratchet-areas.tsv" --out "$work/js" > "$work/js.log" 2>&1 || true
    for f in quality coupling; do
        [ -s "$work/$f/rows.tsv" ] || { tail -20 "$work/$f.log" >&2; echo "ratchet-diff: the $f measure wrote no rows" >&2; exit 2; }
    done
    [ -s "$work/js/over-limit.tsv" ] || { tail -20 "$work/js.log" >&2; echo "ratchet-diff: the js measure wrote no rows" >&2; exit 2; }
    args+=(--quality-rows "$work/quality/rows.tsv" --coupling-rows "$work/coupling/rows.tsv" --js-rows "$work/js/over-limit.tsv")
elif [ -n "$head" ]; then
    args+=(--head "$head")
fi
python3 "$root/scripts/ci/ratchet_diff.py" "${args[@]}" ${format[@]+"${format[@]}"}
