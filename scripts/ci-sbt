#!/usr/bin/env bash
#
# ONE sbt COMMAND ON ci-runner's MEASURE LANE, with its verdict: the laptop's heavy test runs (a whole-module testUnit,
# scripts/fail-before's two runs) off the laptop when its governor would hold them (the owner, 2026-11-18: "stop the
# laptop being the bottleneck"). It runs through scripts/identity-ci-run (.github/workflows/identity-run.yml: `sbt -batch
# <command>` on movies-measure, a throwaway MongoDB beside it, the GitOps manifests checked out), at a commit.
#
#   scripts/ci-sbt [--commit <rev> | --tree] [--log <file>] [--quiet] -- '<sbt command>'
#
#   --tree     (default) this checkout as it is: HEAD when clean, else a commit of HEAD plus its tracked changes and its
#              untracked files under */src/ (a new spec), never any other untracked file (a stray .env is never pushed)
#              -- the files left out are named
#   --commit   that commit instead
#   --log      where the command's sbt output goes (default: printed)
#   --quiet    print only the verdict line
#
# THE VERDICT is the command's own, as a local run's exit status is: the conclusion of the run job's "Run the command"
# step (`sbt -batch <command>`), never the run's as a whole --
#   0  the command passed (the step succeeded)
#   1  the command failed (the step failed: a test, a compile error -- what a local nonzero exit is)
#   2  no verdict: the run could not be made, a step before the command failed (checkout, setup, MongoDB), it was
#      cancelled or timed out (KINOWO_CI_SBT_TIMEOUT seconds, default 10800), or it could not be read. Never a failure:
#      scripts/fail-before must not read an infrastructure red as "fails before".
# Polls every KINOWO_CI_SBT_POLL seconds (30). KINOWO_IDENTITY_CI_RUN names the dispatcher (the tests' seam).
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/tool-conventions.sh
. "$here/tool-conventions.sh"
# shellcheck disable=SC2034 # read by tool-conventions.sh (die, usage_error)
DIE_STATUS=2
mode=tree rev="" log="" quiet=0 command=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tree) mode=tree; shift ;;
    --commit) flag_value "$@"; mode=commit; rev=$2; shift 2 ;;
    --log) flag_value "$@"; log=$2; shift 2 ;;
    --quiet) quiet=1; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    --) shift; command=$*; break ;;
    *) usage_error "unknown argument: $1 (the sbt command goes after --)" ;;
  esac
done
[ -n "$command" ] || usage_error "no command: put the sbt command after --"
say() { echo "ci-sbt: $*" >&2; }
dispatcher=${KINOWO_IDENTITY_CI_RUN:-$here/identity-ci-run}

# ci_sbt_snapshot -> the commit of this checkout as it is (HEAD when nothing tracked changed and no new source)
ci_sbt_snapshot() {
  local index tree head left
  head=$(git rev-parse --verify -q HEAD) || return 1
  index=$(mktemp) || return 1
  cp "$(git rev-parse --git-path index)" "$index" 2> /dev/null || : > "$index"
  GIT_INDEX_FILE=$index git add -u -- . > /dev/null 2>&1
  git ls-files --others --exclude-standard -z -- '*/src/*' | GIT_INDEX_FILE=$index xargs -0 git add -- > /dev/null 2>&1
  tree=$(GIT_INDEX_FILE=$index git write-tree) || { rm -f "$index"; return 1; }
  rm -f "$index"
  left=$(git ls-files --others --exclude-standard | grep -v '^[^/]*/src/' | head -5)
  [ -z "$left" ] || say "untracked files outside */src/ are not run: $(echo "$left" | paste -sd' ' -)"
  if [ "$tree" = "$(git rev-parse "$head^{tree}")" ]; then echo "$head"; return 0; fi
  git commit-tree "$tree" -p "$head" -m "ci-sbt: the working tree of $(git rev-parse --short "$head")"
}

if [ "$mode" = tree ]; then
  commit=$(ci_sbt_snapshot) || die "could not snapshot this checkout"
else
  commit=$(git rev-parse --verify -q "$rev^{commit}") || die "no commit $rev"
fi

out=$("$dispatcher" --head "$commit" --no-wait --countries pl --command "$command") ||
  die "could not dispatch \`$command\` at ${commit:0:9} (identity-ci-run)"
run=$(printf '%s\n' "$out" | tail -n 1)
[[ "$run" =~ ^[0-9]+$ ]] || die "identity-ci-run gave no run id (got: $run)"
say "run $run: \`sbt $command\` at ${commit:0:9} on ci-runner's measure lane"

deadline=$((SECONDS + ${KINOWO_CI_SBT_TIMEOUT:-10800}))
view=""
while :; do
  view=$(bounded 90 "$KINOWO_GH" run view "$run" --json status,conclusion,jobs 2> /dev/null) || view=""
  status=$(printf '%s' "$view" | python3 -I -c 'import json, sys
try:
    print(json.load(sys.stdin).get("status") or "")
except ValueError:
    print("")')
  [ "$status" = completed ] && break
  [ "$SECONDS" -lt "$deadline" ] || { say "run $run did not complete within ${KINOWO_CI_SBT_TIMEOUT:-10800}s"; exit 2; }
  sleep "${KINOWO_CI_SBT_POLL:-30}"
done
# the "Run the command" step of every run job (one shard: the command names no {cc}); none, or one not success /
# failure (skipped: an earlier step failed; cancelled), is no verdict
verdict=$(printf '%s' "$view" | python3 -I -c 'import json, sys
d = json.load(sys.stdin)
steps = [s.get("conclusion") for j in d.get("jobs") or [] if (j.get("name") or "").startswith("run ")
         for s in j.get("steps") or [] if s.get("name") == "Run the command"]
print("pass" if steps and all(s == "success" for s in steps) else
      "fail" if "failure" in steps and all(s in ("success", "failure") for s in steps) else
      "none " + (",".join(str(s) for s in steps) or "no command step") + " (run " + str(d.get("conclusion")) + ")")')

jobs=$(mktemp -d) && trap 'rm -rf "$jobs"' EXIT
if gh_download 90 run download "$run" --pattern 'identity-run*' --dir "$jobs" > /dev/null 2>&1; then
  sbtlog=$(find "$jobs" -name 'sbt*.log' | head -n 1)
  if [ -n "$sbtlog" ]; then
    if [ -n "$log" ]; then cp "$sbtlog" "$log"; elif [ "$quiet" = 0 ]; then cat "$sbtlog"; fi
  fi
else
  say "could not download run $run's sbt log"
fi
case "$verdict" in
  pass) say "run $run: PASSED \`$command\`"; exit 0 ;;
  fail) say "run $run: FAILED \`$command\`"; exit 1 ;;
  *) say "run $run: NO VERDICT: the command step is ${verdict#none }"; exit 2 ;;
esac
