#!/usr/bin/env bash
# THE PRE-LAND DRIFT CHECK: a commit's `takes-drift-1|2|... (<country>)` rows -- "Check that the incremental state ends
# where a whole resolve does" (scripts/ci/identity-drift-check.sh), the step behind 28 of 36 red convergence runs in the
# week to 2026-10-29 -- run on CI BEFORE the commit lands, and nothing else of the convergence suite.
#
# Why (docs: convergence-failures-2026-10-29, §5 Tier 2 and §7.2): main's full suite gives a drift verdict ~48 minutes
# after a push (red) or ~80 (green), and only once the commit is on main; fixers' "fixes" were refuted there, one after
# another. This dispatches Identity model convergence with `drift-only` (10 rows, not 37), so one
# red row is judged in ~12-16 minutes and all ten in ~25-40, before the push.
#
# usage: scripts/identity-drift-ci [<commit> | --head REF] [--countries pl,de,uk,us,es] [--seeds S1,S2|S1|,S2|both]
#                                  [--for-red <run> | --against <run>|main] [--timeout <minutes>]
#                                  [--out DIR] [--no-wait]
#        scripts/identity-drift-ci --run <run id> [--out DIR]
#   <commit>     default HEAD (committed only; a commit whose workflows predate drift-only gets main's .github/ and
#                scripts/ci/ laid over it, as identity-measure does)
#   --countries  the countries whose drift rows run (the workflow's takes-countries); default all five
#   --seeds      the seeds the rows replay (pins, scripts/ci/drift_seeds.py): `S1,S2` both rows, `S1` (= `S1,`) row 1
#                alone, `,S2` row 2 alone; `both` (the default) both rows on their FIXED seeds (drift-gate-seeds.tsv). --for-red and --against pin their baseline run's seeds
#                themselves, so a row is only ever held against the same seed
#   --for-red    only the rows a red convergence run failed: its failed `takes-drift-1|2 (<country>)` jobs name the
#                countries and rows, the red run's own seeds the seeds they replay (its rows' `seed` artifact files; a run
#                from before the rotation replayed seeds 1 and 2; a run with none left, the rows' fixed seeds) (a run id, or the run's number as its URL shows it). A red with no failed drift row
#                has nothing to judge here: exit 0, said so. A FIX MAY BE PARTIAL (5df3295bd cleared PL's flips while DE
#                seed 2's stayed): each row still red is held against the red run's own verdict.txt for it -- open
#                divergences plus flips beyond the allow-lists. Fewer in some row and more in none is PROGRESS (exit 0,
#                `DRIFT PROGRESS: ...`); no row better, or one worse, is a refuted fix (exit 1); the red's verdict unreadable (its
#                artifacts kept 7 days) is no verdict (exit 2)
#   --against    every requested row held against a run's own verdict for it -- `main`: main's newest decided convergence
#                run -- in place of "any red row is red": a row worse than there (more open findings, or red where it was
#                green) is DRIFT RED (exit 1); none worse is `DRIFT NOT WORSE` (exit 0) even while main itself is red.
#                What a NEW OR TIGHTENED CHECK must show to land (scripts/ci/commit_rules.py's rule): it finds
#                nothing main's run does not, every finding at birth on its allow-list as TEMPORARY. And what
#                identity-landing-check asks of a change while main is red on drift
#   --timeout    minutes to WAIT for the rows (default max(75, 1.5 x the ETA of recent measure runs)). It only stops the
#                waiting: the run is never cancelled; it says `--run <id>` and exits 3 (STILL RUNNING, no verdict)
#   --no-wait    dispatch, print the run id, exit 0; collect with --run
#   --run        collect an existing drift-only run
#   --out        where each row's artifact goes (default target/identity-drift-ci/<run>)
#
# It pushes the commit as `measure/<user>/<short sha>-drift-<random>` (the pre-push hook checks nothing on a measure/
# ref; the run deletes its branch as its last job), dispatches through scripts/ci/dispatch.sh, waits with backoff (60 s,
# x1.5, at most 5 min; a line per poll, and $KINOWO_PROGRESS_FILE touched, so the pre-push hook's no-progress watchdog
# sees it alive), stops as soon as every requested drift row has ended (the run's tail goes on without it), then prints
# each row's verdict.txt and its report's divergence and flip lines.
#
# Called by scripts/identity-landing-check (its `drift` group) and by the pre-push hook's `identitydrift` check (a push carrying
# `Fixes-Red: <run>` for a convergence drift red: `--for-red <run>`). Never runs anything heavy on the laptop.
#
# The last line on stdout is the verdict: `DRIFT CLEAN`, `DRIFT RED: <rows>`, or `NO VERDICT: <why>`.
# Exit: 0 clean (or nothing to judge), 1 a divergence or flip beyond the allow-lists, 2 could not run, 3 still running at --timeout.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/identity-tools.sh
. "$here/identity-tools.sh" # bounded, die, usage_*, country_flag, gh_download, identity_gh, identity_push_measure_branch
# shellcheck disable=SC2034 # read by tool-conventions.sh (die, usage_error)
DIE_STATUS=2
TOOL_NAME=identity-drift-ci
# shellcheck source=scripts/ci/dispatch.sh
. "$here/ci/dispatch.sh"
export DISPATCH_GH_TIMEOUT=${IDENTITY_DRIFT_GH_TIMEOUT:-90} DISPATCH_POLL_SECONDS=${IDENTITY_DRIFT_POLL:-30}
export DISPATCH_GH=$KINOWO_GH
# the takes rows are Identity takes' (the owner, 2026-11-08): a drift-only request starts no convergence row
workflow=identity-takes.yml
say() { echo "identity-drift-ci: $*" >&2; }
progress() { [ -z "${KINOWO_PROGRESS_FILE:-}" ] || date +%s >> "$KINOWO_PROGRESS_FILE" 2> /dev/null || true; }

ref=HEAD seeds=both for_red="" against="" timeout_min=75 timeout_set="" out="" nowait="" run=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --head) flag_value "$@"; ref=$2; shift ;;
    --country|--countries|--country=*|--countries=*) country_flag "$@"; shift $((COUNTRY_FLAG_ARGS - 1)) ;;
    --seeds) flag_value "$@"; seeds=$2; shift ;;
    --for-red) flag_value "$@"; for_red=${2#\#}; shift ;;
    --against) flag_value "$@"; against=${2#\#}; shift ;;
    --timeout) flag_value "$@"; timeout_min=$2; timeout_set=1; shift ;;
    --out) flag_value "$@"; out=$2; shift ;;
    --no-wait) nowait=1 ;;
    --run) flag_value "$@"; run=$2; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) usage_error "unknown option $1" ;;
    *) ref=$1 ;;
  esac
  shift
done
pins=""
if [ "$seeds" != both ]; then
  pins=$(python3 "$here/ci/drift_seeds.py" pins "$seeds" 2> /dev/null) || usage_error "--seeds takes S1,S2, S1, ,S2 or both, not $seeds"
fi
[ -z "$for_red" ] || [ -z "$against" ] || usage_error "--for-red and --against each name the baseline: one of them"
countries=""; [ "${#SELECTED_COUNTRIES[@]}" -eq 0 ] || countries=$(selected_countries_csv)
remote=${IDENTITY_MEASURE_REMOTE:-origin}

csv_add() { [[ ",$1," == *",$2,"* ]] && echo "$1" || echo "${1:+$1,}$2"; } # <csv> <item>

# base_root: the baseline runs' artifacts, downloaded once (their seeds before the dispatch, their verdicts after)
base_root=$(mktemp -d "${TMPDIR:-/tmp}/identity-drift-ci.XXXXXX")
trap 'rm -rf "$base_root"' EXIT
# base_download <run id>: the run's identity-drift artifacts into $base_root/base-<id> (once)
base_download() {
  [ -d "$base_root/base-$1" ] && return 0
  mkdir -p "$base_root/base-$1"
  gh_download "$DISPATCH_GH_TIMEOUT" run download "$1" --pattern 'identity-drift-*' --dir "$base_root/base-$1" > /dev/null \
    || say "could not download run $1's identity-drift artifacts"
}
# row_seed <run id> <row 1|2> -> the seed that row of the run replayed: its artifacts' `seed` file; a run whose artifacts
# name none predates the rotation (row N replayed seed N); a run with no artifacts left names nothing (empty): its row
# replays its FIXED set (scripts/ci/drift_seeds.py, drift-gate-seeds.tsv) -- what every run since the fixed seeds replays
row_seed() {
  local seed
  base_download "$1"
  seed=$(cat "$base_root/base-$1"/identity-drift-*-takes-drift-"$2"/seed 2> /dev/null | head -1)
  if [ -n "$seed" ]; then echo "$seed"; return; fi
  if compgen -G "$base_root/base-$1/identity-drift-*-takes-drift-*" > /dev/null; then echo "$2"; return; fi
  say "run $1 left no takes-drift-$2 artifact naming its seed: the row replays its fixed seeds"
}
# pins_of <run id> <rows> -> `S1,S2` for the run's rows named (1, 2 or `1 2`), the others' sides empty; nothing at all
# when no row named a seed (every row its fixed set)
pins_of() {
  local id=$1 one="" two=""
  case " $2 " in *" 1 "*) one=$(row_seed "$id" 1) || return 1 ;; esac
  case " $2 " in *" 2 "*) two=$(row_seed "$id" 2) || return 1 ;; esac
  [ -z "$one$two" ] || echo "$one,$two"
}
# drift_jobs <run id> -> "<name>\t<status>\t<conclusion>" for each takes-drift row of the run (none yet: nothing)
drift_jobs() {
  # (github.com names a leg's row `leg (germany) / takes-drift-1 (germany)`: convergence_reuse.py's jobs_by_name reads it)
  local json
  json=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$1" --json jobs) || return 1
  python3 "$here/ci/convergence_reuse.py" drift-rows <<< "$json" | grep -v '^$' || true
}

# ── --for-red: the rows a red failed ─────────────────────────────────────────────────────────────────────────────
# A Fixes-Red: trailer names a run by its id or by the number its URL shows; both are tried, among convergence runs.
if [ -n "$for_red" ]; then
  [[ "$for_red" =~ ^[0-9]+$ ]] || usage_error "--for-red takes a run id or number, not $for_red"
  ids=$(identity_gh "$DISPATCH_GH_TIMEOUT" run list --workflow "$workflow" --limit 300 --json databaseId,number \
    --jq ".[] | select(.databaseId == $for_red or .number == $for_red) | .databaseId") || die "could not list $workflow's runs"
  [ -n "$ids" ] || { say "run $for_red is no $workflow run among its newest 300: no drift row to judge"; echo "DRIFT CLEAN (nothing to judge)"; exit 0; }
  red_rows="" red_ids=""
  for id in $ids; do
    rows=$(drift_jobs "$id") || die "could not read run $id's jobs"
    failed=$(awk -F'\t' '$3 == "failure" { print $1 }' <<< "$rows")
    [ -z "$failed" ] || red_ids+=" $id"
    red_rows+=$failed$'\n'
  done
  red_rows=$(grep -v '^$' <<< "$red_rows" | LC_ALL=C sort -u)
  if [ -z "$red_rows" ]; then
    say "run $for_red failed no takes-drift row: nothing for the drift check to judge"
    echo "DRIFT CLEAN (nothing to judge)"
    exit 0
  fi
  seen_rows="" countries=""
  while IFS= read -r row; do
    n=${row#takes-drift-}; n=${n%% *}
    country=${row#*(}; country=${country%)}
    seen_rows=$(csv_add "$seen_rows" "$n"); countries=$(csv_add "$countries" "$(identity_country_code "$country")")
  done <<< "$red_rows"
  # the red's OWN seeds, pinned: a row is held against the seed it failed on, never another (rotating seeds)
  first_red=${red_ids# }; first_red=${first_red%% *}
  if [[ ",$seen_rows," =~ ,([3-9]|[1-9][0-9]+), ]]; then
    # a pin reaches rows 1 and 2 alone (drift_seeds.py rows_of): a red extra row replays its FIXED seeds, every row of
    # its country with it -- the seeds the red replayed, since the set is fixed
    pins=""
    say "run $for_red's red rows include takes-drift-${BASH_REMATCH[1]}, which no pin reaches: every row replays its fixed seeds"
  else
    pins=$(pins_of "$first_red" "${seen_rows//,/ }") || die "could not tell which seeds run $for_red's drift rows replayed"
  fi
  seeds=$pins
  say "run $for_red's red drift rows: $(tr '\n' ',' <<< "$red_rows" | sed 's/,$//') -> countries $countries, seeds $pins (the red's own)"
fi

# ── the baseline every row is held against: the red's (--for-red) or the named run's (--against) ─────────────────────
base_ids=${red_ids:-} base_label="run ${for_red:-}"
if [ -n "$against" ]; then
  if [ "$against" = main ]; then
    # main's newest decided run whose drift rows ran (a reused or cancelled run judged none)
    for id in $(identity_gh "$DISPATCH_GH_TIMEOUT" run list --workflow "$workflow" --branch main --limit 10 --json databaseId,status \
                  --jq '.[] | select(.status == "completed") | .databaseId') ; do
      # (awk decides alone: under pipefail a `grep -q` ending first would SIGPIPE the writer and pass the run over)
      drift_jobs "$id" | awk -F'\t' '$3 == "success" || $3 == "failure" { decided = 1 } END { exit !decided }' \
        && { base_ids=$id; break; }
    done
    [ -n "$base_ids" ] || die "no decided run of $workflow on main judged its drift rows: nothing to hold this one against"
  else
    [[ "$against" =~ ^[0-9]+$ ]] || usage_error "--against takes a run id or main, not $against"
    base_ids=$against
  fi
  base_label="run $base_ids"
  # the baseline's own seeds, pinned (unless --seeds named rows): the rows replay what it replayed, never as if equal
  want_rows="1 2"; [ -z "$pins" ] || want_rows=$(sed -E 's/^([^,]*),(.*)$/\1:\2/' <<< "$pins" | awk -F: '{ if ($1 != "") printf "1 "; if ($2 != "") printf "2" }')
  pins=$(pins_of "$base_ids" "$want_rows") || die "could not tell which seeds $base_label's drift rows replayed"
  seeds=$pins
  say "every row held against $base_label${against:+ ($against)}, on its seeds $pins"
fi

# the rows this run must judge, `takes-drift-<row> (<country>)` a line: every row the country has (1, 2 and any further
# row its fixed seeds are spread over), or the rows the pins name (drift_seeds.py rows)
expected_rows() {
  local cc r
  for cc in ${countries:-pl de uk es us}; do
    for r in $(python3 "$here/ci/drift_seeds.py" rows --cc "$cc" --pins "${pins:-}"); do
      echo "takes-drift-$r ($(identity_country_name "$cc"))"
    done
  done
}
countries=${countries//,/ }

# ── the run: dispatched, or named ────────────────────────────────────────────────────────────────────────────────
branch="" dispatched_at=$SECONDS
delete_branch() {
  [ -n "$branch" ] || return 0
  bounded 120 git push -q "$remote" --delete "refs/heads/$branch" 2> /dev/null && say "deleted branch $branch"
}
if [ -z "$run" ]; then
  commit=$(git rev-parse --verify -q "$ref^{commit}") || die "no commit $ref"
  [ "$ref" != HEAD ] || [ -z "$(git status --porcelain --untracked-files=no 2> /dev/null)" ] \
    || say "WARNING: uncommitted changes are not checked -- only ${commit:0:9}"
  push=$commit
  # The commit's own workflows must know drift-only and hold identity-takes.yml (2026-11-08); an older one gets main's CI
  # laid over it (identity-measure's way).
  leg=$(git show "$commit:.github/workflows/country-convergence-leg.yml" 2> /dev/null) || leg=""
  if [[ "$leg" != *drift-only* ]] || ! git cat-file -e "$commit:.github/workflows/$workflow" 2> /dev/null; then
    bounded 120 git fetch -q "$remote" main || die "could not fetch $remote main"
    push=$(identity_main_ci_over "$remote" "$commit" drift) || die "could not lay main's CI over $commit"
    say "${commit:0:9} predates the drift-only dispatch: checking it under $remote/main's .github/ and scripts/ci/ (${push:0:9})"
  fi
  branch=$(identity_measure_branch "$commit" drift)
  say "commit $(git log --oneline -1 "$commit" | cut -c1-100)"
  identity_push_measure_branch "$remote" "$push" "$branch" || { delete_branch; die "could not push $branch: $MEASURE_PUSH_ERROR"; }
  only=(-f drift-only=true)
  [ -z "$countries" ] || only+=(-f takes-countries="$(tr ' ' ',' <<< "$countries")")
  [ -z "$pins" ] || only+=(-f drift-seeds="$pins")
  dispatched_at=$SECONDS
  identity_dispatch_measure "$workflow" "$branch" "$push" \
    "identity-drift-ci ${for_red:+--for-red $for_red }${against:+--against $against }${commit:0:9}" "${only[@]}" \
    || { [[ "$IDENTITY_DISPATCH_ERROR" == dispatched* ]] || delete_branch; die "$IDENTITY_DISPATCH_ERROR"; }
  run=$DISPATCHED_RUN
  say "run $run on $branch: drift-only, $(expected_rows | wc -l | tr -d ' ') row(s) ($(expected_rows | tr '\n' ',' | sed 's/,$//'))"
  if [ -n "$nowait" ]; then say "not waiting: collect with  scripts/identity-drift-ci --run $run"; echo "$run"; exit 0; fi
fi

# ── wait until every expected drift row has ended ────────────────────────────────────────────────────────────────
expected=$(expected_rows)
if [ -z "$branch" ]; then
  # --run: the rows the run itself has (its countries and seeds were its dispatch's)
  expected=""
fi
if [ -z "$timeout_set" ] && run_eta "$workflow" measure/ > /dev/null 2>&1; then
  eta=${RUN_ETA_SAID#\~}; eta=${eta%% *}
  [[ "$eta" =~ ^[0-9]+$ ]] && [ $((eta * 3 / 2)) -gt "$timeout_min" ] && timeout_min=$((eta * 3 / 2))
fi
deadline=$((SECONDS + timeout_min * 60)) delay=${IDENTITY_DRIFT_FIRST_WAIT:-60} unread=0
while :; do
  progress
  if rows=$(drift_jobs "$run") && status=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$run" --json status --jq .status); then
    unread=0
    want=${expected:-$(cut -f1 <<< "$rows" | grep -v '^$')}
    ended=$(awk -F'\t' '$2 == "completed" { print $1 }' <<< "$rows" | LC_ALL=C sort -u)
    open=$(LC_ALL=C comm -23 <(printf '%s\n' "$want" | grep -v '^$' | LC_ALL=C sort -u) <(printf '%s\n' "$ended"))
    say "run $run: $(( $(grep -c . <<< "$want") - $(grep -c . <<< "$open") ))/$(grep -c . <<< "$want" | tr -d ' ') drift row(s) ended, run $status, $(( (SECONDS - dispatched_at) / 60 )) min"
    [ -n "$want" ] && [ -z "$open" ] && break
    [ "$status" = completed ] && break
  else
    unread=$((unread + 1))
    [ "$unread" -lt 10 ] || die "run $run: ten unreadable reads in a row"
  fi
  if [ "$SECONDS" -ge "$deadline" ]; then
    # --timeout only stops the WAITING: the run (and its branch, the run's to delete) goes on -- never cancelled here
    say "run $run: the drift rows did not end within --timeout $timeout_min minutes -- STILL RUNNING, left running (no verdict)"
    say "collect it later with  scripts/identity-drift-ci --run $run"
    exit 3
  fi
  sleep "$delay"; delay=$(dispatch_backoff_next "$delay")
done
# the run's tail (timings, the branch drop) goes on; the branch is the run's to delete
branch=""
wall=$(( (SECONDS - dispatched_at) / 60 ))

# ── the verdict ──────────────────────────────────────────────────────────────────────────────────────────────────
out=${out:-$(git rev-parse --show-toplevel 2> /dev/null || pwd)/target/identity-drift-ci/$run}
rm -rf "$out"; mkdir -p "$out"
gh_download "$DISPATCH_GH_TIMEOUT" run download "$run" --pattern 'identity-drift-*' --dir "$out" > /dev/null \
  || say "could not download run $run's identity-drift artifacts (each row's verdict still stands)"
# open_findings <verdict.txt> -> divergences plus flips beyond the allow-lists (identity-drift-check.sh's verdict line)
open_findings() {
  sed -nE 's/^([0-9]+) divergence\(s\).* ([0-9]+) flip\(s\).*/\1 \2/p' "$1" 2> /dev/null | awk 'NR == 1 { print $1 + $2 }'
}
# the baseline's own verdict per row (--for-red, --against): its job's conclusion, and its artifact when it failed
base_rows=""
for id in $base_ids; do
  base_rows+=$(drift_jobs "$id" | sed "s/\$/	$id/")$'\n' || say "could not read baseline run $id's jobs"
  base_download "$id"
  cp -R "$base_root/base-$id" "$out/base-$id"
done
# was_open <row name> <artifact dir name> -> the baseline's open findings for the row: 0 where its job passed, its
# verdict's count where it failed, nothing where unknown
was_open() {
  local line id
  line=$(awk -F'\t' -v n="$1" '$1 == n && ($3 == "success" || $3 == "failure")' <<< "$base_rows" | head -1)
  [ -n "$line" ] || return 0
  case $(cut -f3 <<< "$line") in success) echo 0; return ;; esac
  id=$(cut -f4 <<< "$line")
  open_findings "$out/base-$id/$2/verdict.txt"
}
red=() unjudged=() better=() same=() worse=() unknown_base=()
while IFS=$'\t' read -r name _ conclusion; do
  [ -n "$name" ] || continue
  [ -z "$expected" ] || grep -qxF "$name" <<< "$expected" || continue
  # --run: the countries a drift-only dispatch left out show as skipped rows, which judge nothing
  [ -n "$expected" ] || [ "$conclusion" != skipped ] || continue
  row=${name#takes-drift-}; row=${row%% *}; country=${name#*(}; country=${country%)}
  dir="$out/identity-drift-$(identity_country_code "$country")-takes-drift-$row"
  seed=$(cat "$dir/seed" 2> /dev/null || echo '?')
  echo "$name [seed $seed]: $conclusion -- $(cat "$dir/verdict.txt" 2> /dev/null || echo 'no verdict.txt')"
  [ "$conclusion" != failure ] || [ ! -f "$dir/reproduce.txt" ] || echo "    reproduce: $(cat "$dir/reproduce.txt")"
  [ ! -f "$dir/report.txt" ] || grep -E '^## |^  [0-9]+ listing|^      ' "$dir/report.txt" | head -40 | sed 's/^/    /'
  case $conclusion in success) ;; failure) red+=("$name") ;; *) unjudged+=("$name ($conclusion)") ;; esac
  if [ -n "$base_ids" ] && { [ "$conclusion" = failure ] || [ "$conclusion" = success ]; }; then
    now=0; [ "$conclusion" = success ] || now=$(open_findings "$dir/verdict.txt")
    was=$(was_open "$name" "$(basename "$dir")")
    if [ "$conclusion" = success ] && [ -n "$was" ] && [ "$was" != 0 ]; then better+=("$name: green")
    elif [ "$conclusion" = success ]; then :
    elif [ -z "$now" ] || [ -z "$was" ]; then unknown_base+=("$name")
    elif [ "$now" -lt "$was" ]; then better+=("$name: $was -> $now open")
    elif [ "$now" -eq "$was" ]; then same+=("$name: $was -> $now open")
    else worse+=("$name: $was -> $now open"); fi
  fi
done <<< "$rows"
missing=""
[ -z "$expected" ] || missing=$(LC_ALL=C comm -23 <(printf '%s\n' "$expected" | LC_ALL=C sort -u) <(cut -f1 <<< "$rows" | LC_ALL=C sort -u))
echo "run $run, $wall min from dispatch; artifacts in $out"
if [ "${#red[@]}" -gt 0 ] && [ -n "$against" ]; then
  if [ "${#worse[@]}" -gt 0 ]; then echo "DRIFT RED: worse than $base_label: ${worse[*]}"; exit 1; fi
  if [ "${#unknown_base[@]}" -gt 0 ] || [ "${#unjudged[@]}" -gt 0 ] || [ -n "$missing" ]; then
    echo "NO VERDICT: not judged against $base_label: ${unknown_base[*]+${unknown_base[*]}}${unjudged[*]+ ${unjudged[*]}} $(paste -sd, - <<< "$missing")"; exit 2
  fi
  echo "DRIFT NOT WORSE than $base_label: ${same[*]+${same[*]}}${better[*]+ (better: ${better[*]})}"; exit 0
fi
if [ "${#red[@]}" -gt 0 ] && [ -n "$for_red" ]; then
  if [ "${#worse[@]}" -gt 0 ] || { [ "${#better[@]}" -eq 0 ] && [ "${#unknown_base[@]}" -eq 0 ]; }; then
    echo "DRIFT RED: no better than run $for_red: ${worse[*]+${worse[*]} }${same[*]+${same[*]}}"; exit 1
  fi
  if [ "${#unknown_base[@]}" -gt 0 ] || [ "${#unjudged[@]}" -gt 0 ] || [ -n "$missing" ]; then
    echo "NO VERDICT: still red, and no baseline to tell a partial fix by: ${unknown_base[*]+${unknown_base[*]}}${unjudged[*]+ ${unjudged[*]}} $(paste -sd, - <<< "$missing")"; exit 2
  fi
  echo "DRIFT PROGRESS: $(printf '%s; ' "${better[@]}" | sed 's/; $//') -- still red: ${red[*]}"; exit 0
fi
if [ "${#red[@]}" -gt 0 ]; then echo "DRIFT RED: ${red[*]}"; exit 1; fi
if [ -n "$missing" ] || [ "${#unjudged[@]}" -gt 0 ]; then
  echo "NO VERDICT: $({ printf '%s\n' "${unjudged[@]+"${unjudged[@]}"}"; printf '%s\n' "$missing"; } | grep -v '^$' | paste -sd, - | sed 's/,/, /g') not judged"
  exit 2
fi
# (--run passes over skipped rows: a run whose every row was skipped -- its setup red, say -- judged nothing)
judged=$(awk -F'\t' '$3 == "success" || $3 == "failure"' <<< "$rows" | grep -c .)
[ "$judged" -gt 0 ] || { echo "NO VERDICT: run $run has no takes-drift row that passed or failed"; exit 2; }
echo "DRIFT CLEAN"
exit 0
