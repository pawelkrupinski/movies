#!/bin/sh
# Purpose: One venue's listings as the code at one or two git refs reads them, from a recording — never the network
# The name its callers run (the skills, the identity findings report's lines); scripts/venue_replay.py is the tool, its
# header (`--help`) says what it replays, and how.
exec python3 "$(dirname "$0")/venue_replay.py" "$@"
