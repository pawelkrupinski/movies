# The floor the tools promise, bash 3.2 (scripts/floor-bash: a Mac's /bin/bash, elsewhere the GNU 3.2.57 it builds), its
# path printed; nothing printed when there is no floor run (PREPUSH_SKIP=floor, or a pushed runner from before --bash:
# the hook is the working tree's, the runner the pushed commit's). No floor bash BLOCKS, as any missing tool does:
# ci-runner's Linux landing checks, whose missing bash 3 once passed it in silence, let ed160b94b land a construct 3.2
# cannot parse (Order independence #72). PREPUSH_FLOOR_BASH names one (the hook's test).
scripttests_floor() {
    grep -q -e '--bash' scripts/run-script-tests 2>/dev/null || return 0
    if skipped floor; then warn "scripttests under the floor bash 3.2 SKIPPED (PREPUSH_SKIP=floor)"; return 0; fi
    local floor major
    if [ -n "${PREPUSH_FLOOR_BASH:-}" ]; then
        floor=$PREPUSH_FLOOR_BASH
    elif [ -x scripts/floor-bash ]; then
        floor=$(scripts/floor-bash 2> "$tmp/floor-bash.err") \
            || { missing_tool floor "bash 3.2 ($(tr '\n' ' ' < "$tmp/floor-bash.err"))" "scripts/floor-bash --install"; return 1; }
    else
        floor=/bin/bash # a pushed tree from before scripts/floor-bash
    fi
    # shellcheck disable=SC2016 # expanded by that bash
    major=$([ -x "$floor" ] && "$floor" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null) || major=""
    case "$major" in
        3) echo "$floor" ;;
        *) missing_tool floor "bash 3.2 (the floor; $floor is ${major:+bash }${major:-no bash})" \
               "scripts/floor-bash --install, or PREPUSH_FLOOR_BASH=<a bash 3.2>" ;;
    esac
}

check_scripttests() {
    # In the same run (--floor): the floor bash 3.2 (scripttests_floor) over the bash the push touches -- parsed,
    # its added lines held to 3.2, its own self-tests run under it (run-script-tests' FLOOR; every selected test re-run cost a
    # landing ~+70 s) -- so a bash-4-only construct is caught at the push, not by the nightly macOS job; and on Linux (`--linux`: CI's ubuntu-26.04, in Docker) -- GNU tools a Mac's BSD ones hide
    # (03b3a6825), beside it in the background. Warm, that adds ~4 s to a run the native one outlasts: ~0 s of wall time.
    local floor floor_pid="" linux_pid="" rc=0
    if [ -n "$scripttests_readers" ]; then # --verify-only's repo-wide self-tests (above), alone
        if scripts/run-script-tests --changed "$base_sha" --readers > "$tmp/scripttests.log" 2>&1; then
            tail -1 "$tmp/scripttests.log"; return 0
        fi
        grep -v '^PASS\|✓' "$tmp/scripttests.log" | head -80 >&2; return 1
    fi
    local native=()
    floor=$(scripttests_floor) || return 1
    # ONE RUN, ONE POOL (run-script-tests --floor): the floor's scope under 3.2 and the rest natively. Run side by side,
    # a test in both ran twice at once -- pre-push-test.sh, minutes each -- and the contention alone kept a hook change
    # ~+43 s over the landing budget (2026-11-16). A runner from before --floor gets its own floor run, as before.
    if [ -n "$floor" ] && grep -q -e '--floor)' scripts/run-script-tests 2>/dev/null; then
        native=(--floor "$floor")
    elif [ -n "$floor" ]; then
        scripts/run-script-tests --changed "$base_sha" --bash "$floor" > "$tmp/scripttests-floor.log" 2>&1 &
        floor_pid=$!
    fi
    # ALREADY ON LINUX (ci-runner's landing checks, CI's ubuntu): the native run IS the Linux run, so the Docker copy of
    # it repeated it for 120-150 CPU-s a job (2026-11-18) -- skipped, said
    if [ "${PREPUSH_UNAME:-$(uname -s)}" = Linux ]; then
        echo "on Linux: this run is Linux's (the Docker pass, run-script-tests --linux, would repeat it)"
    elif ! skipped linux && grep -q -e '--linux' scripts/run-script-tests 2>/dev/null; then
        scripts/run-script-tests --linux --changed "$base_sha" > "$tmp/scripttests-linux.log" 2>&1 &
        linux_pid=$!
    fi
    if scripts/run-script-tests --changed "$base_sha" ${native[@]+"${native[@]}"} > "$tmp/scripttests.log" 2>&1; then
        tail -1 "$tmp/scripttests.log"
        [ "${PREPUSH_STRESS:-0}" != 0 ] || grep '^run-script-tests: concurrency-heavy' "$tmp/scripttests.log" || true
        [ ${#native[@]} -eq 0 ] || echo "under $floor: the floor's scope, in the same run ($(grep -c ' (floor)$' "$tmp/scripttests.log" | tr -d ' ') test(s))"
    else
        grep -v '^PASS\|✓' "$tmp/scripttests.log" | head -80 >&2; rc=1
    fi
    if [ -n "$linux_pid" ]; then
        if wait "$linux_pid"; then
            echo "on Linux: $(tail -1 "$tmp/scripttests-linux.log")"
        elif grep -q -- '--linux needs a running Docker' "$tmp/scripttests-linux.log"; then
            echo "on Linux: SKIPPED (Docker is not running -- start Rancher/Docker Desktop to run them as CI does)"
        else
            echo "on Linux (scripts/run-script-tests --linux; PREPUSH_SKIP=linux skips it):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-linux.log" | head -80 >&2
            rc=1
        fi
    fi
    # STRESS, opt-in (PREPUSH_STRESS=N): the concurrency-heavy tests the push selects, N runs of each at once under load
    if [ "$rc" = 0 ] && [ "${PREPUSH_STRESS:-0}" != 0 ] && grep -q -e '--stress)' scripts/run-script-tests 2>/dev/null; then
        if scripts/run-script-tests --changed "$base_sha" --stress "$PREPUSH_STRESS" > "$tmp/scripttests-stress.log" 2>&1; then
            echo "stressed (PREPUSH_STRESS=$PREPUSH_STRESS): $(grep -E '^STRESS|no concurrency-heavy' "$tmp/scripttests-stress.log" | paste -sd';' -)"
        else
            echo "under stress (PREPUSH_STRESS=$PREPUSH_STRESS, scripts/run-script-tests --stress):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-stress.log" | head -80 >&2
            rc=1
        fi
    fi
    if [ -n "$floor_pid" ]; then
        if wait "$floor_pid"; then
            echo "under $floor: $(tail -1 "$tmp/scripttests-floor.log")"
        else
            echo "under the floor bash $floor (scripts/floor-bash; PREPUSH_SKIP=floor skips it):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-floor.log" | head -80 >&2
            rc=1
        fi
    fi
    return $rc
}

# actionlint over changed workflows; a composite action's `run:` blocks, which actionlint does not
# lint, through scripts/ci/shellcheck-action-runs.sh. CI's `Workflow lint` step runs both over the
# whole tree, so a missing tool here only defers the finding to CI.
check_actionlint() {
    local workflows actions rc=0
    workflows="$(changed_matching '^\.github/workflows/.*\.ya?ml$')"
    actions="$(changed_matching '^\.github/actions/[^/]*/action\.ya?ml$')"
    if [ -n "$workflows" ]; then
        if command -v actionlint >/dev/null; then
            # shellcheck disable=SC2086 # workflow file names carry no spaces
            SHELLCHECK_OPTS='-S warning' actionlint $workflows || rc=1
        else
            missing_tool actionlint actionlint "brew install actionlint" || rc=1
        fi
    fi
    if [ -n "$actions" ]; then
        if command -v shellcheck >/dev/null; then
            # shellcheck disable=SC2086 # action paths carry no spaces
            scripts/ci/shellcheck-action-runs.sh $actions || rc=1
        else
            missing_tool actionlint shellcheck "brew install shellcheck" || rc=1
        fi
    fi
    return "$rc"
}

# Fail on a warning the push ADDS: count each changed script's warnings at the base and at HEAD.
check_shellcheck() {
    need shellcheck shellcheck "brew install shellcheck" || return 1
    local f before after rc=0
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in *.txt|*.tsv) continue ;; esac # local-tests.txt, lint-registry.tsv: the hook's tables, no shell
        after="$(shellcheck -S warning -f gcc "$f" 2>/dev/null | wc -l | tr -d ' ')"
        if git cat-file -e "$base_sha:$f" 2>/dev/null; then
            git show "$base_sha:$f" > "$tmp/base.sh"
            before="$(cd "$(dirname "$f")" && shellcheck -S warning -f gcc "$tmp/base.sh" 2>/dev/null | wc -l | tr -d ' ')"
        else
            before=0
        fi
        if [ "$after" -gt "$before" ]; then
            warn "$f: shellcheck warnings $before → $after"
            shellcheck -S warning "$f" >&2
            rc=1
        fi
    done < <(printf '%s\n' "$changed" | pre_push_py --shell-paths)
    return $rc
}

check_sbt() {
    # A NEW REPO-READING SPEC NEEDS ITS LINT-REGISTRY ROW (Tool self-tests #158, #166: two deploy specs landed rowless,
    # so no push ever ran them, and lint-registry-test.sh -- run only when a script changes -- saw it on main after).
    local unregistered spec
    unregistered="$("$(dirname "${BASH_SOURCE[0]}")/lint-registry-missing")" || return 1
    if [ -n "$unregistered" ]; then
        for spec in $unregistered; do
            warn "$spec has no lint-registry row: add one to scripts/hooks/lint-registry.tsv (its header has the format)"
        done
        return 1
    fi
    # ...AND ITS ROW SELECTS IT FOR EVERY PATH IT READS (Tool self-tests #194: a row missed two test/resources files its
    # spec reads, seen on main only). A push of the registry or its readers runs the reads check over every row (~8 s);
    # a push of specs alone, over theirs (a second).
    local misses line only=()
    if grep -qE '(/src/test/scala/.*Spec\.scala|^scripts/hooks/lint-registry\.tsv)$' <<< "$changed" \
        && [ -f scripts/ci/lint_registry_reads.py ]; then
        if ! grep -qE '^scripts/(hooks/lint-registry\.tsv|hooks/pre-push|ci/lint_registry_reads\.py)$' <<< "$changed"; then
            only=(--only)
            while IFS= read -r line; do only+=("$line"); done < <(printf '%s\n' "$changed" \
                | sed -nE 's|^([^/]+)/src/test/scala/(.*Spec)\.scala$|\1:\2|p' | tr / .)
        fi
        misses="$(python3 scripts/ci/lint_registry_reads.py ${only[@]+"${only[@]}"})" || return 1
        if [ -n "$misses" ]; then
            while IFS=$'\t' read -r spec line; do
                warn "$spec reads $line, which its lint-registry row does not select: add the path's glob to its row"
            done <<< "$misses"
            return 1
        fi
    fi
    need_jvm sbt || return 1
    local compiles
    # shellcheck disable=SC2207 # task names carry no spaces
    compiles=($(printf '%s\n' "$changed" | compile_plan))
    local lints module tests=() gitops_stale=0
    # The specs reading the GitOps manifests join the lints once infra/bin/fetch-gitops has put them in this checkout
    # (from GitHub). The fetch failing BLOCKS the push: the checkout left behind is stale, and the local clone
    # the script once fell back to went stale with GitHub (2026-10-19) -- a spec then failed on a probe movies-gitops
    # 24a5162 had already fixed. The specs needing them stay out of this run; the rest still run, for their verdicts.
    if printf '%s\n' "$changed" | reads_gitops && ! skipped lintspecs && [ -x infra/bin/fetch-gitops ]; then
        if KINOWO_GITOPS_DEST="$PWD/infra/kubernetes" bounded "${PREPUSH_GITOPS_SECONDS:-90}" infra/bin/fetch-gitops > "$tmp/fetch-gitops.log" 2>&1; then
            export PREPUSH_GITOPS=1
        else
            gitops_stale=1
            sed 's/^/    /' "$tmp/fetch-gitops.log" | tail -8 >&2
            warn "GitOps manifests STALE: infra/bin/fetch-gitops could not fetch movies-gitops main, so the push is BLOCKED. Fix: the network to github.com, then push again (or PREPUSH_SKIP=lintspecs, named in your report)."
        fi
    fi
    lints="$(printf '%s\n' "$changed" | lint_plan)"
    # a module none of whose rows the push selects runs none: a bare `testOnly` would run its every test
    local module_lints
    for module in http common scrapers repochecks worker web; do
        module_lints="$(printf '%s\n' "$lints" | sed -n "s/^$module://p" | tr '\n' ' ' | sed 's/ $//')"
        [ -z "$module_lints" ] || tests+=("$module/Test/testOnly $module_lints")
    done
    # the basic tests (local-tests.txt's `basic sbt` lines) ride the same run, after the compiles and lints; --fast-only:
    # the `fast` set instead
    local set=basic
    [ -n "$fast_only" ] && set=fast
    while IFS= read -r line; do [ -n "$line" ] && tests+=("$line"); done < <(local_test_lines "$set" sbt | without_unfetched_gitops)
    if [ -n "$verify_only" ]; then
        # THE COMBINED TREE'S UNIT TESTS, NARROWED TO WHAT THE CHANGE REACHES (TEST-IMPACT SELECTION, as the identity
        # area's): the worker's whole rest row cost every worker-touching verification ~70-90 s for the few specs the
        # change can reach. Through the kept server only (one more call to the warm compiler that runs the check); a
        # cold `sbt -batch` check, or no answer, runs every touched module's unit tests, as before. The selection also
        # adds, in ANY module, the tests a test-side reader of a changed file reaches (its `READS` lines: the worker's
        # source lints over a scrapers change, through ScalaSourceScan's `scrapers/src/main`), and leaves out the lint
        # specs this run already runs, so none runs twice.
        printf '%s\n' "$changed" | unit_plan > "$tmp/unit.plan"
        unit_universe > "$tmp/unit.universe"
        printf '%s\n' "$lints" > "$tmp/unit.lints"
        local widen=""
        [ -s "$tmp/unit.plan" ] && widen=1
        if [ -s "$tmp/unit.plan" ] && [ "$sbt_client" = 1 ] && test_impact unit > "$tmp/unit.select.log" 2>&1 \
                && python3 scripts/ci/identity_impact.py plan --impact "$tmp/unit.impact" --reads "$tmp/unit.universe" \
                    --except "$tmp/unit.lints" < "$tmp/unit.plan" > "$tmp/unit.narrowed"; then
            log "verify: the unit tests the combined change reaches: $(grep -c . "$tmp/unit.narrowed" | tr -d ' ') sbt line(s)$(grep -m1 '^ALL' "$tmp/unit.impact" | sed 's/^ALL/, every one:/')" >&2
            mv "$tmp/unit.narrowed" "$tmp/unit.plan"
            grep -q '^ALL' "$tmp/unit.impact" || widen=""
        elif [ -s "$tmp/unit.plan" ] && [ "$sbt_client" = 1 ]; then
            warn "verify: no test-impact selection ($(tail -1 "$tmp/unit.select.log")) -- every touched module's unit tests"
        fi
        # no selection naming the change's readers (ALL, cold, no answer): every module's source-walking lints join
        if [ -n "$widen" ]; then
            source_lint_lines "$lints" < "$tmp/unit.plan" > "$tmp/unit.sourcelints"
            log "verify: no selection names the change's readers -- every module's source lints join ($(grep -c . "$tmp/unit.sourcelints" | tr -d ' ') sbt line(s))" >&2
            cat "$tmp/unit.sourcelints" >> "$tmp/unit.plan"
        fi
        while IFS= read -r line; do [ -n "$line" ] && tests+=("$line"); done < <(without_unfetched_gitops < "$tmp/unit.plan")
    fi
    local coupling=""
    if [ -n "$(printf '%s\n' "$changed" | coupling_paths)" ] && [ -f coupling.sbt ]; then
        if skipped coupling; then warn "coupling SKIPPED (PREPUSH_SKIP)"
        else coupling=1; rm -f "$tmp/coupling.rows" "$tmp/coupling.edges" "$tmp/coupling.fanouts" "$tmp/coupling.collaborators"
            tests+=("couplingReport $tmp/coupling.rows $tmp/coupling.md $tmp/coupling.edges $tmp/coupling.fanouts $tmp/coupling.collaborators"); fi
    fi
    local quality=""
    if [ -n "$(printf '%s\n' "$changed" | quality_paths)" ] && [ -d quality ]; then
        if skipped quality; then warn "quality SKIPPED (PREPUSH_SKIP)"
        else quality=1; rm -f "$tmp/quality.rows"; tests+=("quality/runMain quality.QualityReport --root $PWD --rows $tmp/quality.rows"); fi
    fi
    local run=(sbt -batch -Dsbt.server.forcestart=false ${compiles[@]+"${compiles[@]}"} "${tests[@]}")
    if [ "$sbt_client" = 1 ]; then
        local line
        line="$(printf '%s; ' ${compiles[@]+"${compiles[@]}"} "${tests[@]}")"
        # through scripts/sbt-warm, as any call to the kept server: a bare `sbt --client` held no busy lock and kept no
        # last-used mark fresh, so the server's keeper, seeing it idle, could stop it mid-check (2026-10-19)
        run=("$root/scripts/sbt-warm" "${line%; }")
    fi
    "${run[@]}" > "$tmp/sbt.log" 2>&1 \
        || { failure_summary "$tmp/sbt.log" >&2; warn "full log: $tmp/sbt.log"; return 1; }
    if [ -n "$coupling" ]; then
        local args=() r
        need sbt python3 "install Python 3 (brew install python)" || return 1
        for r in "${ranges[@]}"; do args+=(--range "$r"); done
        [ -s "$tmp/coupling.rows" ] || { warn "coupling: sbt couplingReport wrote no rows (full log: $tmp/sbt.log)"; return 1; }
        python3 scripts/ci/coupling_ratchet.py check --current "$tmp/coupling.rows" --edges "$tmp/coupling.edges" \
            --fanouts "$tmp/coupling.fanouts" --collaborators "$tmp/coupling.collaborators" ${args[@]+"${args[@]}"} >&2 || return 1
    fi
    if [ -n "$quality" ]; then
        local qargs=() r
        need sbt python3 "install Python 3 (brew install python)" || return 1
        for r in "${ranges[@]}"; do qargs+=(--range "$r"); done
        [ -s "$tmp/quality.rows" ] || { warn "quality: quality/runMain quality.QualityReport wrote no rows (full log: $tmp/sbt.log)"; return 1; }
        python3 scripts/ci/quality_ratchet.py check --current "$tmp/quality.rows" ${qargs[@]+"${qargs[@]}"} >&2 || return 1
        python3 scripts/design-rules/naming_lint.py check --languages scala ${qargs[@]+"${qargs[@]}"} >&2 || return 1
        python3 scripts/design-rules/design_check.py check --languages scala ${qargs[@]+"${qargs[@]}"} >&2 || return 1
    fi
    [ "$gitops_stale" = 0 ]
}

# The commands of <set> of <kind> (sbt|sh|first) in the CHECKED tree's local-tests.txt, one per line.
local_test_lines() { # <set> <kind>
    [ -f scripts/hooks/local-tests.txt ] || return 0
    sed -nE "s/^$1[[:space:]]+$2[[:space:]]+//p" scripts/hooks/local-tests.txt
}
# An area's local tests: its first lines (each a fast check whose failure names everything at once: it fails the area
# there, nothing else run; the identity area's after its test-impact selection, none when it selected nothing), its sbt
# lines in ONE scripts/sbt-warm call (the checkout's kept server: warm, and the one
# compiler over its target/), then its sh lines. A failure shows the failing specs; the full log stays.
# THE IDENTITY PLAN ALONE: PREPUSH_IDENTITY_PLAN=<file> makes the identity area write the sbt lines its TEST-IMPACT
# SELECTION picked (a `# ` line first: the selection's summary, or why there was none and every identity test is the
# plan) and run nothing -- no first line, no spec. scripts/identity-impact-check's `hook` mode reads it from a detached
# checkout of its own, as a landing check's tree is (2026-11-19: tracebacks of a missing identity.impact in a landing
# check's failure dump, which were the hook self-test's stub runs, not the check's selection).
run_local_tests() { # <set>
    local cmds=() line rc=0 sh_lines=1 plan_only=""
    [ "$1" != identity ] || plan_only="${PREPUSH_IDENTITY_PLAN:-}"
    need_jvm "$1" || return 1
    while IFS= read -r line; do [ -n "$line" ] && cmds+=("$line"); done < <(local_test_lines "$1" sbt)
    if [ "$1" = identity ] && [ "${#cmds[@]}" -gt 0 ]; then
        local selected=()
        local said
        if select_identity_tests "${cmds[@]}" > "$tmp/identity.plan" 2> "$tmp/identity.select.log"; then
            while IFS= read -r line; do [ -n "$line" ] && selected+=("$line"); done < "$tmp/identity.plan"
            said="$(tr '\n' ';' < "$tmp/identity.summary" | sed 's/;$//; s/;/; /')"
            log "identity: $said"
            cmds=(${selected[@]+"${selected[@]}"})
        else
            said="no test-impact selection ($(tail -1 "$tmp/identity.select.log")) -- every identity test"
            warn "identity: $said"
        fi
        if [ -n "$plan_only" ]; then
            { printf '# %s\n' "$said"; [ "${#cmds[@]}" -eq 0 ] || printf '%s\n' "${cmds[@]}"; } > "$plan_only"
            log "identity: the plan alone, to $plan_only (PREPUSH_IDENTITY_PLAN): nothing run"
            return 0
        fi
        if [ "${#cmds[@]}" -eq 0 ]; then log "identity: the change reaches no identity spec"; return 0; fi
    fi
    # the first lines: once, never sharded (shard 1 runs them, as the sh lines); the identity area's after its selection,
    # and only when that reached a spec (a fixtures tool no identity spec reads ran the slice coverage for nothing)
    if [ -z "${PREPUSH_IDENTITY_SHARD:-}" ] || [ "$1" != identity ] || [ "${PREPUSH_IDENTITY_SHARD%%/*}" = 1 ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            if ! bash -c "$line" < /dev/null > "$tmp/$1.first.log" 2>&1; then
                cat "$tmp/$1.first.log" >&2
                warn "$1: \`$line\` failed (full log: $tmp/$1.first.log)"
                return 1
            fi
            grep -m1 -E '^[a-z-]+: [0-9]+ ' "$tmp/$1.first.log" || true
        done < <(local_test_lines "$1" first)
    fi
    # THE IDENTITY SHARDS (precommit-check.yml's `check (identity k/n)` jobs): PREPUSH_IDENTITY_SHARD=<k>/<n> runs shard k of
    # the selected lines (scripts/ci/shard_tests.py: every class in exactly one shard, under its own line's command and
    # arguments; a line naming no class outright whole in one). The n jobs together run what one job ran.
    if [ "$1" = identity ] && [ -n "${PREPUSH_IDENTITY_SHARD:-}" ] && [ "${#cmds[@]}" -gt 0 ]; then
        local sharded=()
        # balanced on scripts/ci/shard-weights-identity.tsv (absent: every class weighs the same)
        printf '%s\n' "${cmds[@]}" | python3 scripts/ci/shard_tests.py --shard "$PREPUSH_IDENTITY_SHARD" --weights identity \
            > "$tmp/identity.shard" \
            || { warn "identity: shard $PREPUSH_IDENTITY_SHARD could not be cut"; return 1; }
        while IFS= read -r line; do [ -n "$line" ] && sharded+=("$line"); done < "$tmp/identity.shard"
        log "identity: shard $PREPUSH_IDENTITY_SHARD, $(wc -w < "$tmp/identity.shard" | tr -d ' ') words of ${#cmds[@]} line(s)"
        cmds=(${sharded[@]+"${sharded[@]}"})
        # the area's sh lines are no classes to split: shard 1 runs them
        [ "${PREPUSH_IDENTITY_SHARD%%/*}" = 1 ] || sh_lines=0
        if [ "${#cmds[@]}" -eq 0 ] && [ "$sh_lines" = 0 ]; then log "identity: nothing in shard $PREPUSH_IDENTITY_SHARD"; return 0; fi
    fi
    # THE POPULATION WALK AGAINST THE BASE (PopulationMonotonicitySpec's CandidatesKey, scripts/ci/population-walk-diff):
    # every identity testOnly line names the candidates directory, so a slice whose flips differ from the known rows is
    # judged against the change's merge base after the run -- a flip main has too passes, one the change adds refuses
    # the push naming the listing, slice and chain. No candidate (the usual case): nothing more runs.
    # THE WALK'S ROWS KEPT (PopulationMonotonicitySpec's CacheKey, sbt's identityWalkDigest): the walk's rows of a slice
    # are kept per digest of every path the walk's code and data are (the slices apart: each keyed by its own files)
    # under $KINOWO_POPULATION_WALK_ROWS (default $KINOWO_IDENTITY_CACHE/population-walk-rows)/<digest>/ -- a change that leaves the walk's code and data as a
    # walked commit had them walks only the slices whose files differ; the rows are judged as walked ones, every run.
    # No digest (a working tree with changes, the task failed): every slice walks. The landing check keeps the directory
    # between runs (precommit-check.yml's actions/cache); a digest unused for 5 days is dropped.
    local popwalk="" walkcache=""
    if [ "$1" = identity ] && [ "${#cmds[@]}" -gt 0 ]; then
        popwalk="$tmp/population-walk"
        walkcache="$(population_walk_rows identity)"
        local i extra="-Didentity.population.candidates=$popwalk${walkcache:+ -Didentity.population.cache=$walkcache}"
        for i in "${!cmds[@]}"; do
            case "${cmds[$i]}" in
                *testOnly\ *\ --\ *) cmds[$i]="${cmds[$i]} $extra" ;;
                *testOnly\ *) cmds[$i]="${cmds[$i]} -- $extra" ;;
            esac
        done
    fi
    if [ "${#cmds[@]}" -gt 0 ]; then
        scripts/sbt-warm "${cmds[@]}" > "$tmp/$1.log" 2>&1 || rc=1
    fi
    # judged even when another spec failed: the refusal names its listings beside the other failures
    if [ -n "$popwalk" ] && [ -d "$popwalk" ]; then
        local walk_base
        walk_base="$(git merge-base "$base_sha" "$head_sha" 2>/dev/null || echo "$base_sha")"
        scripts/ci/population-walk-diff "$popwalk" "$walk_base" >> "$tmp/$1.log" 2>&1 || rc=1
        grep '^population walk: ' "$tmp/$1.log" | tail -40 >&2
    fi
    if [ "$rc" = 0 ] && [ "$sh_lines" = 1 ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            bash -c "$line" < /dev/null >> "$tmp/$1.log" 2>&1 || { rc=1; break; }
        done < <(local_test_lines "$1" sh)
    fi
    if [ "$rc" != 0 ]; then
        failure_summary "$tmp/$1.log" >&2
        warn "full log: $tmp/$1.log"
        return 1
    fi
    grep -E 'Tests: succeeded|All tests passed|[0-9]+ passed' "$tmp/$1.log" | tail -3
}
# The walk's rows kept (THE WALK'S ROWS KEPT, above): <the rows root>/<identityWalkDigest>, printed (made, fresh); nothing
# when sbt gives no digest (every slice walks); what it says goes to stderr. Asked once a run (its answer kept in $tmp): the identity area and the
# flipbacklog check share it, so a slice the change brings is walked once between them, not by each (~3-10 s a slice).
population_walk_rows() { # <the check asking>
    local rows_root="${KINOWO_POPULATION_WALK_ROWS:-${KINOWO_IDENTITY_CACHE:-$HOME/.cache/kinowo-identity}/population-walk-rows}" digest=""
    if [ ! -f "$tmp/walk-digest.asked" ]; then
        scripts/sbt-warm "identityWalkDigest $tmp/identity.walk-digest" > "$tmp/identity.walk-digest.log" 2>&1 \
            || rm -f "$tmp/identity.walk-digest"
        touch "$tmp/walk-digest.asked"
    fi
    [ -f "$tmp/identity.walk-digest" ] && digest="$(tr -cd '0-9a-f' < "$tmp/identity.walk-digest")"
    if [ "${#digest}" != 64 ]; then
        log "$1: no population walk digest ($(tail -1 "$tmp/identity.walk-digest.log" 2> /dev/null)): every slice walks" >&2
        return 0
    fi
    mkdir -p "$rows_root/$digest" && touch "$rows_root/$digest"
    find "$rows_root" -mindepth 1 -maxdepth 1 -type d -mtime +5 -exec rm -rf {} + 2> /dev/null
    log "$1: the population walk's rows kept under digest ${digest:0:12} ($(find "$rows_root/$digest" -name '*.tsv' | wc -l | tr -d ' ') slice(s) kept)" >&2
    echo "$rows_root/$digest"
}
# TEST-IMPACT SELECTION (scripts/ci/identity_impact.py, project/TestImpact.scala): of the identity set's sbt lines, only
# the specs the pushed change can reach (the compiler's dependency record; the data's readers by name), each once, the
# country-scoped ones (tools.CountryScope) over the countries it can reach. Every path the range changed counts,
# deletions too (a deleted source selects every test); one range only -- several, and every test runs. Prints the sbt
# lines to run (none: no spec reached), or fails (every test runs).
# test_impact <name>: the range's changed paths to $tmp/<name>.changed and the classes they reach (identityImpact's
# `<module> <class>` lines, or `ALL <why>`) to $tmp/<name>.impact, through the checkout's kept sbt server; says why not.
test_impact() {
    local mb
    [ "${#ranges[@]}" -eq 1 ] || { echo "the push holds ${#ranges[@]} ranges"; return 1; }
    mb="$(git merge-base "$base_sha" "$head_sha")" || { echo "no merge base of ${base_sha:0:9} and ${head_sha:0:9}"; return 1; }
    git diff --name-only --no-renames "$mb" "$head_sha" > "$tmp/$1.changed" || return 1
    scripts/sbt-warm "identityImpact $tmp/$1.changed $tmp/$1.impact" > "$tmp/$1.impact.log" 2>&1 \
        || { tail -20 "$tmp/$1.impact.log"; echo "sbt identityImpact failed"; return 1; }
    # an exit 0 that wrote nothing (a kept server answering for a command it never ran) is no answer, said as one
    [ -f "$tmp/$1.impact" ] || { tail -20 "$tmp/$1.impact.log"; echo "sbt identityImpact wrote no answer"; return 1; }
}
select_identity_tests() { # <the set's sbt lines>...
    local mb countries every_test=()
    test_impact identity >&2 || return 1 # its why on stderr: stdout is the plan
    [ ! -s "$tmp/identity.impact.tests" ] || every_test=(--every-test "$tmp/identity.impact.tests")
    mb="$(git merge-base "$base_sha" "$head_sha")" || return 1
    countries="$(python3 scripts/ci/identity_impact.py countries "$mb" "$head_sha" < "$tmp/identity.changed")" \
        || { echo "the countries could not be read" >&2; return 1; }
    # ALL (every test) runs each class once and by name (--every-test: identityImpact's list of every test class), so
    # identity's specs no longer run twice and the landing check's shards split it by class
    printf '%s\n' "$@" | python3 scripts/ci/identity_impact.py plan --impact "$tmp/identity.impact" --countries "$countries" \
        ${every_test[@]+"${every_test[@]}"} || { echo "no plan" >&2; return 1; }
    if grep -q '^ALL' "$tmp/identity.impact"; then
        echo "every identity spec: $(grep -m1 '^ALL' "$tmp/identity.impact" | cut -c5-)"
    else echo "the specs the change reaches ($(grep -c . "$tmp/identity.impact") test classes in every module)"
    fi > "$tmp/identity.summary"
    echo "countries in scope: ${countries:-none}" >> "$tmp/identity.summary"
}
check_identity() { run_local_tests identity; }
# THE RATCHET (the header's `allowlists`): an allow-list row only with its check's birth, TEMPORARY; else lists only shrink
# THE DRIFT GATE'S COMMIT RULES (the header's `allowlists` and `driftguards`): one walker, scripts/ci/commit_rules.py
commit_rules() { # <rule set>
    local args=() r
    need "$1" python3 "install Python 3 (brew install python)" || return 1
    for r in "${ranges[@]}"; do args+=(--range "$r"); done
    python3 scripts/ci/commit_rules.py "$1" "${args[@]}"
}
check_allowlists() { commit_rules allowlists; }
# A NEW CHECK GATES ONLY ONCE IT HAS BEEN GREEN (the header's `newchecks`): every job, runner label and gate workflow THE
# GATE reads has its row in .github/gating-checks.tsv -- a new one as `unproven`, with its owner -- so it reports until a
# green run proves it (scripts/ci/gating_checks.py lint, seconds)
check_newchecks() {
    need newchecks python3 "install Python 3 (brew install python)" || return 1
    python3 scripts/ci/gating_checks.py lint
}
# THE EXTERNAL SCHEDULER'S SCHEDULE IS THE WORKFLOWS' OWN CRONS (the header's `schedules`): a cron edited without
# regenerating infra/nix/files/scheduled-workflows.json, or a covered workflow's `== 'schedule'` condition missing the
# scheduler's repository_dispatch, refuses the push with the fix
check_schedules() {
    need schedules python3 "install Python 3 (brew install python)" || return 1
    python3 infra/nix/files/scheduled_dispatch.py check
}
# THE IDENTITY DRIFT CHECK: each claimed red's failed takes-drift rows, on CI (scripts/identity-drift-ci --for-red). 1 blocks; 2
# (the run could not be made: CI unreachable, no token) warns and passes -- a fix is not held hostage to an outage, and
# main's own run still judges it.
# identity-drift-ci <log> <args...>: its whole output kept in <log>, each poll's progress line shown as it comes -- a run
# queued behind a saturated ci-runner polls for many minutes, and a hook silent that long is ended by `agentctl land` as
# stalled (#1041) -- and its exit status returned.
drift_ci() {
    local log=$1; shift
    { scripts/identity-drift-ci "$@" 2>&1; echo "drift-ci-exit:$?"; } | tee "$log" \
        | { grep --line-buffered -E '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row' >&2 || true; }
    return "$(sed -n 's/^drift-ci-exit://p' "$log" | tail -1)"
}
check_identitydrift() {
    local run rc=0 r
    if [ "${GITHUB_ACTIONS:-}" = true ]; then
        warn "drift: not run from a CI job (it pushes a measure/ branch and dispatches from the laptop): main's run judges ${drift_reds:+Fixes-Red: $drift_reds}${drift_birth:+ the birth of a check}"
        return 0
    fi
    if [ -n "$drift_birth" ]; then
        log "drift: a check's birth or tightening ($drift_birth): every drift row at ${head_sha:0:9}, against main's newest run"
        drift_ci "$tmp/drift-birth.log" --head "$head_sha" --against main; r=$?
        grep -vE '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row|^drift-ci-exit:' "$tmp/drift-birth.log" | tail -40 >&2
        case $r in
            0) ;;
            1) warn "drift: the check finds what main's run does not -- a new or tightened check lands green: put what it finds at birth on its allow-list, TEMPORARY with an owner and when it goes, under New-Check: (full log: $tmp/drift-birth.log)"; rc=1 ;;
            *) warn "drift: no verdict on the check's birth (exit $r): not held against the push; main's run judges it" ;;
        esac
    fi
    for run in $drift_reds; do
        log "drift: the takes-drift rows run $run failed, at ${head_sha:0:9}, drift-only on ci-runner (scripts/identity-drift-ci)"
        drift_ci "$tmp/drift-$run.log" --head "$head_sha" --for-red "$run"; r=$?
        grep -vE '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row|^drift-ci-exit:' "$tmp/drift-$run.log" | tail -40 >&2
        case $r in
            0) ;;
            1) warn "drift: Fixes-Red: $run does not fix its drift rows at ${head_sha:0:9} (full log: $tmp/drift-$run.log)"; rc=1 ;;
            *) warn "drift: no verdict for Fixes-Red: $run (exit $r): not held against the push; main's run judges it" ;;
        esac
    done
    return $rc
}
check_driftguards() { commit_rules driftguards; }
# A PURE MOVE'S CLAIM HOLDS (the header's `puremove`): each commit saying `Pure-Move:` is one, by the check identity-what-if
# runs, over that commit alone
check_puremove() {
    local r sha claim rc=0
    need puremove python3 "install Python 3 (brew install python)" || return 1
    for r in "${ranges[@]}"; do
        while IFS= read -r sha; do
            claim="$(git log -1 --format='%(trailers:key=Pure-Move,valueonly,unfold)' "$sha" | grep -v '^$' || true)"
            [ -n "$claim" ] || continue
            if [ "$claim" != verified ]; then
                warn "puremove: ${sha:0:9} says 'Pure-Move: $claim': the trailer is 'Pure-Move: verified', or none"; rc=1; continue
            fi
            if scripts/pure-move-check "$sha^..$sha" > "$tmp/puremove.$sha" 2>&1; then
                log "puremove: ${sha:0:9} is a pure move"
            else
                cat "$tmp/puremove.$sha" >&2
                warn "puremove: ${sha:0:9} says 'Pure-Move: verified' but scripts/pure-move-check does not find a pure move: drop the trailer (and run scripts/identity-what-if) or make the commit one"
                rc=1
            fi
        done < <(git rev-list --reverse "$r")
    done
    return $rc
}
# A CARRIED STAMP IS PROVEN (the header's `stampcarry`): every carry row the push adds or changes, proven again
check_stampcarry() {
    local r rc=0
    need stampcarry python3 "install Python 3 (brew install python)" || return 1
    for r in "${ranges[@]}"; do
        scripts/identity-stamp-carry verify "$r" || rc=1
    done
    return $rc
}
# THE FLIP BACKLOG IS COMPLETE (the header's `flipbacklog`): the slices the change brings walked, judged as main's spec
# judges them
check_flipbacklog() {
    local mb s dirs=()
    need flipbacklog python3 "install Python 3 (brew install python)" || return 1
    mb="$(git merge-base "$base_sha" "$head_sha")" || { warn "flipbacklog: no merge base of ${base_sha:0:9} and ${head_sha:0:9}"; return 1; }
    python3 scripts/ci/population_walk_diff.py changed-slices "$mb" > "$tmp/flipbacklog.slices" \
        || { warn "flipbacklog: the slices the change brings could not be read"; return 1; }
    while IFS= read -r s; do [ -n "$s" ] && dirs+=("test/resources/fixtures/$s"); done < "$tmp/flipbacklog.slices"
    if [ "${#dirs[@]}" -eq 0 ]; then log "flipbacklog: no slice the change brings"; return 0; fi
    need_jvm flipbacklog || return 1
    local walkcache
    walkcache="$(population_walk_rows flipbacklog)"
    log "flipbacklog: ${#dirs[@]} slice(s) the change brings, walked (PopulationMonotonicitySpec)"
    if ! scripts/sbt-warm "worker/Test/runMain services.identity.PopulationMonotonicitySpec ${walkcache:+--cache $walkcache }${dirs[*]}" > "$tmp/flipbacklog.log" 2>&1; then
        tail -n 20 "$tmp/flipbacklog.log" >&2; warn "flipbacklog: the walk did not run (full log: $tmp/flipbacklog.log)"; return 1
    fi
    sed -nE 's/^\[info\] //; /^(# )?(drift|identity)-slices\//p' "$tmp/flipbacklog.log" > "$tmp/flipbacklog.walk"
    python3 scripts/ci/population_walk_diff.py judge-walk "$tmp/flipbacklog.walk"
}

# THE HEAVY ROWS (the header): Main's own commands, with Main's row filter, against the job's MongoDB. They ride the
# landing check's rest job (2026-11-18: a job of their own waited up to 17 min for a slot), so the MongoDB is named to
# them alone, $PREPUSH_HEAVY_MONGODB_URI / _DB: the rest's other checks (the basic e2e specs among them) run as Main's
# unit rows do, with none ($MONGODB_URI is still read, for a caller from before).
heavy_row() { # <check> <sbt command> [env...]
    local check=$1 cmd=$2; shift 2
    local uri="${PREPUSH_HEAVY_MONGODB_URI:-${MONGODB_URI:-}}" db="${PREPUSH_HEAVY_MONGODB_DB:-${MONGODB_DB:-}}"
    need_jvm "$check" || return 1
    [ -n "$uri" ] || [ "${check#e2e}" != "$check" ] \
        || { warn "$check: no \$PREPUSH_HEAVY_MONGODB_URI -- the integration specs need a MongoDB replica set (scripts/ci/start-mongo-replset.sh)"; return 1; }
    # the e2e rows run as Main's do, with no MongoDB named; the integration rows against the job's
    local mongo=()
    case "$check" in
        e2e*) mongo=(-u MONGODB_URI -u MONGODB_DB) ;;
        *) mongo=(MONGODB_URI="$uri"); [ -z "$db" ] || mongo+=(MONGODB_DB="$db") ;;
    esac
    env "${mongo[@]}" "$@" sbt -batch "$cmd" > "$tmp/$check.log" 2>&1 \
        || { grep -E '\*\*\* FAILED|\[error\]|Failed tests:|TEST FAILED' "$tmp/$check.log" | head -80 >&2; warn "full log: $tmp/$check.log"; return 1; }
    grep -E 'Tests: succeeded|All tests passed|Passed: Total' "$tmp/$check.log" | tail -3 || true
}
# the rest row's deploy specs read the GitOps manifests: fetched here when nothing put them in place (the sbt check's
# lint plan fetches them only for a change reading them)
check_itrest() {
    if [ ! -d infra/kubernetes ] && [ -x infra/bin/fetch-gitops ]; then
        KINOWO_GITOPS_DEST="$PWD/infra/kubernetes" bounded "${PREPUSH_GITOPS_SECONDS:-90}" infra/bin/fetch-gitops > "$tmp/fetch-gitops.log" 2>&1 \
            || { tail -8 "$tmp/fetch-gitops.log" >&2; warn "itrest: infra/bin/fetch-gitops could not fetch the GitOps manifests the deploy specs read"; return 1; }
    fi
    heavy_row itrest itAll IT_ROW=rest
}
check_itidentity() { heavy_row itidentity itAll IT_ROW=identity; }
check_e2ecorpus() { heavy_row e2ecorpus e2eCorpus; }

check_ios() {
    scripts/ios-compile-check.sh
}

# The takes the newest decided Identity model convergence legs served, as `<dir>/<cc>-takes/<cc>.json.gz` under a cache
# kept per run in the shared git dir; prints the files, or nothing (warned) when gh cannot fetch them in time. A run that
# reused an earlier run's verdict (scripts/ci/convergence_reuse.py) ran no leg and served nothing: the next one back is
# read, up to three.
served_takes() {
    local runs run cache part found=""
    runs="$(bounded "$GhSeconds" gh run list --workflow "Identity model convergence" \
        --branch main --status completed --limit 30 --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success" or .conclusion == "failure")][0:3][].databaseId' 2>/dev/null)" || runs=""
    [ -n "$runs" ] || { warn "judgements: no Identity model convergence run to read served takes from — served check SKIPPED"; return 0; }
    for run in $runs; do
        cache="$(git rev-parse --path-format=absolute --git-common-dir)/kinowo-cache/served-takes/$run"
        if [ ! -d "$cache" ]; then
            # Agents push at once and share this cache: each downloads into a directory of its own, and only the first to
            # finish renames it into place (rename(2) onto a filled directory fails; `mv` would nest it inside).
            part=""
            mkdir -p "$(dirname "$cache")" && part="$(mktemp -d "$cache.part.XXXXXX")" \
                && bounded 120 gh run download "$run" -p 'convergence-diagnostics-*-convergence' \
                -D "$part" >/dev/null 2>&1 \
                || { [ -n "$part" ] && rm -rf "$part"; continue; }
            perl -e 'rename($ARGV[0], $ARGV[1]) or exit 1' "$part" "$cache" 2>/dev/null || rm -rf "$part"
        fi
        found=$(find "$cache" -path '*-takes/*.json.gz')
        [ -z "$found" ] || { echo "$found"; return 0; }
    done
    warn "judgements: could not fetch the served takes of runs $(echo $runs) — served check SKIPPED"
}

check_judgements() {
    local served=() before=""
    need judgements python3 "install Python 3 (brew install python)" || return 1
    # grep reads the whole list, never -q: quitting at the match SIGPIPEs printf over a long one, failing the pipeline.
    # --fast-only (THE COMBINED FILES): the files' own consistency; each member's own check read the served takes.
    if [ -z "$fast_only" ] && printf '%s\n' "$changed" | grep -x 'test/resources/fixtures/identity-judgements.tsv' > /dev/null; then
        need judgements gh "brew install gh" || return 1
        while IFS= read -r f; do [ -n "$f" ] && served+=("$f"); done < <(served_takes)
        before="$tmp/judgements-before.tsv"
        git show "$base_sha:test/resources/fixtures/identity-judgements.tsv" > "$before" 2>/dev/null || before=""
    fi
    # --replay-head: the takes the push newly judges wrong judged at the PUSHED code (identity-slice), not the last leg's
    python3 scripts/ci/identity_judgements_lint.py ${served[@]+--served "${served[@]}"} ${before:+--before "$before" --replay-head}
}
