#!/usr/bin/env bash
# PRE-PUSH: the checks that fail CI in seconds, run here in seconds, for what this push changes.
#
# About one CI failure in nine over four weeks (2026-08-27 → 09-24) was a lint or a generated
# artefact: nothing a ten-minute pipeline needed to discover. Each check below runs only when the
# push touches the paths it guards, so a typical push costs a few seconds and a Scala push well
# under a minute on a warm build:
#
#   `eslint`      web/src/main/assets/js/**, web/src/page/resources/**/*.js, eslint.config.js, eslint-rules/** (the repo's own rules), package*.json
#   `drift`       the generated roster chain (scripts/ci/generated-artefacts-drift.sh)
#   `snapshot`    the read-model snapshot's input stamp (scripts/read-model-snapshot-inputs.sh)
#   `sbt`         NoWallClockInTestsSpec, NoWallClockInClientsSpec, the two Grafana metric-coverage
#                 specs and NoSilencedGhCurlSpec, in ONE sbt run, on any Scala or dashboard change or any
#                 script or workflow under scripts/, .github/ or infra/ (plus ScriptSelfTestsRunInCiSpec,
#                 ConvergenceDispatchGateSpec and NoLiteralWaitBoundSpec for the paths they read:
#                 `--lint-plan`) — and,
#                 ahead of them in that same run, the Test/It/Page configs of every module the push
#                 touches and every module depending on one (`sbt compile` skips them all: f20a6b5dd
#                 broke worker/It/compile and only CI saw it). `--compile-plan` prints that list.
#   `dashboards`  infra/test/test_dashboards.py — the Grafana dashboards' structure and queries,
#                 the CI check `Stage NixOS closures` runs (well under a second)
#   `hooktest`    scripts/hooks/pre-push-test.sh, when the hook or its test changes — a new
#                 check changes what the hook plans, which that test pins
#   `actionlint`  changed workflow files (with shellcheck over their `run:` blocks)
#   `shellcheck`  changed *.sh and hook scripts — fails only on warnings the push ADDS, so a
#                 file that was already noisy can still be edited
#   `ios`         scripts/ios-compile-check.sh (app target + Linux SwiftPM) on ios/** — this one
#                 is minutes, not seconds, and only runs for iOS pushes
#   `judgements`  scripts/ci/identity_judgements_lint.py on labels.tsv, accepted.tsv, the suspect and
#                 known-wrong baselines and the expected matches and hard clusters: the judgements and
#                 the files leaning on them agree. A labels.tsv change is also read against the takes
#                 the newest Identity model convergence legs served (their diagnostics artifacts, cached
#                 per run): a take the push newly calls wrong that no baseline lists fails here, not
#                 in the leg after the push (911d8f486)
#
# WHAT IS CHECKED is the pushed commit's tree: in place when the checkout is that tree, else in a
# temporary worktree of it (cold, so an sbt check there takes minutes, not seconds). The same
# temporary worktree is used when an sbt check would share target/ with a live sbt in the
# checkout (e.g. the DevPanel's `sbt web/run`): two compilers over one classes dir race.
#
# RED BUILDS GATE EVERY PUSH TO MAIN. Before any path check: when the newest COMPLETED run on main of a
# gating workflow (Main, Identity model convergence, Record scrape fixtures; a cancelled run says nothing
# and is passed over) is red, the push lands only as a fix for it — every pushed commit carries a
# `Fixes-Red: <run id>` trailer naming one of the red runs — except a commit touching no production path
# (*/src/main/, conf/, build.sbt, project/, infra/nix/, infra/kubernetes/, Dockerfile): tools — scripts, docs,
# skills, tests, fixtures, CI tooling — land while red (user, 2026-10-14). On 2026-10-13/14, 50 of 96 identity commits
# landed while Identity model convergence was red: 3f11e2cc3's wrong switches hid behind a DE red for six
# hours, and three gates and label batches each turned it red again. One `gh run list` a workflow, each
# bounded; gh missing or unreachable is said out loud and does not block (it is no evidence of a red).
# Bypass: PREPUSH_SKIP=redgate. NOT gating: the Identity findings report (a recording's own suspects and
# corpus-shape findings, red after 3 days untriaged) -- no push makes or mends a recording's data.
#
# BYPASS: `git push --no-verify` skips the whole hook. `PREPUSH_SKIP="ios sbt" git push` skips
# the named checks. A tool that is not installed (actionlint, shellcheck, Docker, Xcode) is
# skipped with a warning, never silently.
#
# INSTALL: scripts/install-hooks.sh (sets core.hooksPath=scripts/hooks, which every worktree of
# this clone shares; the path is relative, so each worktree runs its own checkout's hook).
# An ABSOLUTE path (an IDE rewrote it three times on 2026-10-14) is warned about, and the hook it names
# hands over to the pushing worktree's own copy, so a stale root checkout never judges a worktree's push.
#
# DRY RUN / TEST: `scripts/hooks/pre-push --plan < paths` prints the checks a list of changed
# paths selects, without running them (scripts/hooks/pre-push-test.sh). `--range A..B` runs the
# hook for the commits in A..B (diffed from their merge-base) instead of reading git's stdin.
set -uo pipefail
# git exports GIT_DIR (and, by setup, GIT_INDEX_FILE / GIT_WORK_TREE) for the repository being
# pushed — for a worktree, ITS git dir. Every check inherits them, and in the temporary checkout
# below they would point each `git` back at the pushing worktree's HEAD and index. The hook runs at
# the checkout's root, where git finds the repository on its own: clear them once, for every check.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

root="$(git rev-parse --show-toplevel)" || exit 1

# ── The PUSHING checkout's own hook runs, whatever core.hooksPath says ──────────────────────────
# core.hooksPath=scripts/hooks is relative: each worktree runs its own checkout's copy. Rewritten to an
# absolute path (three times on 2026-10-14, very likely an IDE's git integration), every worktree's push ran
# the ROOT checkout's copy — an older hook, judging new work by stale checks. So a hook git runs for another
# checkout than its own hands over to that checkout's copy. Once only (PREPUSH_DELEGATED_FROM), and never for
# the dry runs (--plan, --compile-plan, --range), which name the file they mean.
case "${1:-}" in
    --plan|--compile-plan|--range) ;;
    *)
        if [ -z "${PREPUSH_DELEGATED_FROM:-}" ]; then
            hooks_path="$(git config --get core.hooksPath || true)"
            case "$hooks_path" in
                /*|~*) printf '\033[33m! pre-push\033[0m core.hooksPath is absolute (%s): every worktree reaches that one copy — scripts/install-hooks.sh sets it back to the relative scripts/hooks\n' "$hooks_path" >&2 ;;
            esac
            hook_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
            own="$(cd "$root" && pwd -P)/scripts/hooks/pre-push"
            if [ "$(cd "$root" && pwd -P)" != "$hook_root" ] && [ -f "$own" ] && ! [ "$own" -ef "${BASH_SOURCE[0]}" ]; then
                export PREPUSH_DELEGATED_FROM="$hook_root"
                exec bash "$own" "$@"
            fi
        fi ;;
esac
unset PREPUSH_DELEGATED_FROM
# ── end of the hand-over ──
cd "$root" || exit 1

Zero=0000000000000000000000000000000000000000

# ── Which checks a set of changed paths selects ─────────────────────────────────────────────────
# One line per path on stdin; prints the selected check names, one per line, in run order.
plan() {
    local eslint=0 drift=0 snapshot=0 sbt=0 dashboards=0 hooktest=0 actionlint=0 shellcheck=0 ios=0 judgements=0 path
    while IFS= read -r path; do
        case "$path" in
            web/src/main/assets/js/*.js|web/src/page/resources/*.js|eslint.config.js|eslint-rules/*.js|package.json|package-lock.json) eslint=1 ;;
        esac
        case "$path" in
            common/src/main/scala/models/*|data/*|android/app/src/main/java/pl/kinowo/model/City.kt|ios/Kinowo/Models/City.swift|scripts/ci/generated-artefacts-drift.sh) drift=1 ;;
        esac
        case "$path" in
            test/resources/fixtures/08-06-2026/*|scripts/read-model-snapshot-inputs.sh) snapshot=1 ;;
        esac
        case "$path" in
            *.scala|*.java|build.sbt|project/*|infra/nix/files/monitoring/grafana/dashboards/*) sbt=1 ;;
        esac
        # What NoSilencedGhCurlSpec reads: a script that silences a gh/curl read failed Main from a push this check never
        # selected (d00c5edf2).
        case "$path" in
            scripts/*.sh|.github/*.sh|.github/*.yml|.github/*.yaml|infra/*.sh|infra/*.yml|infra/*.yaml) sbt=1 ;;
        esac
        # What the lints `--lint-plan` adds read: a script self-test no workflow runs (ScriptSelfTestsRunInCiSpec), a
        # literal wait in test code (NoLiteralWaitBoundSpec) — each turned Main red on 2026-10-14.
        case "$path" in
            scripts/*test_*.py|scripts/*_test.py|scripts/*-test.sh|.github/*test_*.py|.github/*_test.py|.github/*-test.sh|\
            worker/src/fixtures/*) sbt=1 ;;
        esac
        case "$path" in
            infra/nix/files/monitoring/*|infra/test/test_dashboards.py) dashboards=1 ;;
        esac
        case "$path" in
            scripts/hooks/pre-push|scripts/hooks/pre-push-test.sh) hooktest=1 ;;
        esac
        case "$path" in
            .github/workflows/*.yml|.github/workflows/*.yaml) actionlint=1 ;;
        esac
        case "$path" in
            *.sh|scripts/hooks/*) shellcheck=1 ;;
        esac
        case "$path" in
            ios/*) ios=1 ;;
        esac
        case "$path" in
            test/resources/fixtures/identity-unmatched/*.tsv|test/resources/fixtures/identity-takes/*|\
            test/resources/fixtures/identity-suspects/*|test/resources/fixtures/corpus/expected-hard-clusters-*|\
            scripts/ci/identity_judgements_lint*.py|scripts/ci/identity_takes_diff.py) judgements=1 ;;
        esac
    done
    [ $judgements = 1 ] && echo judgements
    [ $eslint = 1 ] && echo eslint
    [ $drift = 1 ] && echo drift
    [ $snapshot = 1 ] && echo snapshot
    [ $dashboards = 1 ] && echo dashboards
    [ $hooktest = 1 ] && echo hooktest
    [ $actionlint = 1 ] && echo actionlint
    [ $shellcheck = 1 ] && echo shellcheck
    [ $sbt = 1 ] && echo sbt
    [ $ios = 1 ] && echo ios
    return 0
}

# ── Which test configs a set of changed paths has to compile ────────────────────────────────────
# One line per path on stdin; prints the sbt compile tasks, one per line, in dependency order. A
# module's own test configs plus those of every module that depends on it (build.sbt's dependsOn):
# common → identity → testkit → worker → web (page->fixtures) → e2e. The build itself touches them all.
compile_plan() {
    local common=0 identity=0 testkit=0 worker=0 web=0 e2e=0 path
    while IFS= read -r path; do
        case "$path" in
            build.sbt|project/*)  common=1 ;;
            common/*.scala|common/*.java)   common=1 ;;
            identity/*.scala|identity/*.java) identity=1 ;;
            testkit/*.scala|testkit/*.java) testkit=1 ;;
            # web's Page config compiles against worker's fixtures config (page->fixtures).
            worker/src/fixtures/*)          worker=1; web=1 ;;
            worker/*.scala|worker/*.java)   worker=1 ;;
            web/*.scala|web/*.java)         web=1 ;;
            e2e/*.scala|e2e/*.java)         e2e=1 ;;
        esac
    done
    [ $common = 1 ] && identity=1
    [ $identity = 1 ] && testkit=1
    [ $testkit = 1 ] && worker=1
    [ $worker = 1 ] && e2e=1
    [ $web = 1 ] && e2e=1
    [ $common = 1 ] && web=1
    [ $testkit = 1 ] && web=1
    [ $common = 1 ] && echo common/Test/compile
    [ $identity = 1 ] && echo identity/Test/compile
    [ $testkit = 1 ] && echo testkit/Test/compile
    [ $worker = 1 ] && printf '%s\n' worker/Test/compile worker/It/compile
    [ $web = 1 ] && printf '%s\n' web/Test/compile web/It/compile web/Page/compile
    [ $e2e = 1 ] && echo e2e/Test/compile
    return 0
}

# ── Which lint specs the sbt check runs ─────────────────────────────────────────────────────────
# One line per path on stdin; prints `<module>:<spec>`, one per line. The standing lints always; the cheap CI lints that
# turned Main red on 2026-10-14 only when the push touches what they read (seconds each, in the same warm sbt run):
#   ScriptSelfTestsRunInCiSpec    a script self-test no workflow runs          — scripts/, .github/
#   ConvergenceDispatchGateSpec   the convergence dispatch gate and its paths  — scripts/, .github/
#   NoLiteralWaitBoundSpec        a literal bound on a wait in test code       — test, it, page, fixtures, testkit
lint_plan() {
    local scripts=0 tests=0 path
    while IFS= read -r path; do
        case "$path" in scripts/*|.github/*) scripts=1 ;; esac
        case "$path" in worker/src/fixtures/*|*/src/test/*|*/src/it/*|*/src/page/*|testkit/*) tests=1 ;; esac
    done
    printf '%s\n' worker:tools.NoWallClockInTestsSpec worker:services.cinemas.NoWallClockInClientsSpec \
        worker:deploy.GrafanaMetricCoverageSpec worker:deploy.NoSilencedGhCurlSpec web:deploy.GrafanaWebMetricCoverageSpec
    [ $scripts = 1 ] && printf '%s\n' worker:deploy.ScriptSelfTestsRunInCiSpec worker:deploy.ConvergenceDispatchGateSpec
    [ $tests = 1 ] && echo worker:tools.NoLiteralWaitBoundSpec
    return 0
}

case "${1:-}" in
    --plan)         plan; exit 0 ;;
    --compile-plan) compile_plan; exit 0 ;;
    --lint-plan)    lint_plan; exit 0 ;;
esac

log()  { printf '\033[36m▸ pre-push\033[0m %s\n' "$*"; }
warn() { printf '\033[33m! pre-push\033[0m %s\n' "$*" >&2; }
skipped() { case " ${PREPUSH_SKIP:-} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ── Red builds gate the push ────────────────────────────────────────────────────────────────────
GatingWorkflows=("Main" "Identity model convergence" "Record scrape fixtures")
GhSeconds="${PREPUSH_GH_SECONDS:-15}"

# `<conclusion> <run id> <url>` of a workflow's newest decided run on main (success or a failure of any kind; cancelled,
# skipped and unfinished runs say nothing), empty when it has none; non-zero when gh cannot answer in time.
newest_verdict() { # <workflow name>
    perl -e 'alarm shift; exec @ARGV or exit 127' "$GhSeconds" \
        gh run list --workflow "$1" --branch main --limit 30 --json databaseId,status,conclusion,url \
        --jq '[.[] | select(.status == "completed" and (.conclusion | IN("cancelled", "skipped", "neutral", "") | not))][0] // empty
              | "\(.conclusion) \(.databaseId) \(.url)"'
}

# A production path: what reaches a running pod or a fleet host. Everything else — scripts/, docs/, .claude/, the
# test, it and fixture trees, test/resources/, .github/ tooling — is tools, which may land while red (user, 2026-10-14).
is_production_path() { # <path>
    case "$1" in
        */src/main/*|conf/*|*/conf/*|build.sbt|project/*|infra/nix/*|infra/kubernetes/*|Dockerfile) return 0 ;;
    esac
    return 1
}

# Whether <commit> changes any production path.
touches_production() { # <commit>
    local path
    while IFS= read -r path; do
        [ -n "$path" ] && is_production_path "$path" && return 0
    done < <(git diff-tree --no-commit-id --name-only -r --root -m "$1")
    return 1
}

# Refuses a push to main while a gating workflow's newest verdict is red, unless every pushed commit that touches a
# production path names one of the red runs in a `Fixes-Red: <run id>` trailer. <range>... the pushed commits.
check_redgate() {
    command -v gh >/dev/null || { warn "gh not installed: the gating workflows' verdicts are unread — red-build gate SKIPPED"; return 0; }
    local workflow verdict conclusion id url reds="" commit fixes ok bad=0 r
    for workflow in "${GatingWorkflows[@]}"; do
        verdict="$(newest_verdict "$workflow" 2>&1)" \
            || { warn "could not read $workflow's verdict in ${GhSeconds}s (${verdict%%$'\n'*}) — red-build gate SKIPPED for it"; continue; }
        [ -n "$verdict" ] || continue
        read -r conclusion id url <<< "$verdict"
        if [ "$conclusion" != success ]; then
            reds="$reds $id"
            warn "$workflow is RED on main: run $id ($conclusion) $url"
        fi
    done
    [ -z "$reds" ] && return 0
    for r in "$@"; do
        while IFS=$'\t' read -r commit fixes; do
            if ! touches_production "$commit"; then
                log "${commit:0:9} is tools-only (touch no production path): lands while red" >&2
                continue
            fi
            ok=0
            for id in $(printf '%s' "$fixes" | tr ',' ' '); do
                case " $reds " in *" $id "*) ok=1 ;; esac
            done
            [ "$ok" = 1 ] && continue
            warn "${commit:0:9} carries no Fixes-Red: trailer naming a red run (red:$reds)"
            bad=1
        done < <(git log --format='%H%x09%(trailers:key=Fixes-Red,valueonly,separator=%x2C)' "$r")
    done
    [ "$bad" = 0 ] && { log "every pushed production commit is declared a fix for a red run"; return 0; }
    warn "main is red: only a fix for it lands. Add 'Fixes-Red: <run id>' to each commit's message (git commit --amend"
    warn "on unpushed commits), or bypass with PREPUSH_SKIP=redgate."
    return 1
}

# ── What is being pushed ────────────────────────────────────────────────────────────────────────
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref. The base for a new
# remote branch (or a remote sha this clone has never fetched) is its merge-base with origin/main.
base_for() {
    local local_sha="$1" remote_sha="$2"
    if [ "$remote_sha" != "$Zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        echo "$remote_sha"
    elif git rev-parse -q --verify origin/main >/dev/null; then
        git merge-base "$local_sha" origin/main 2>/dev/null || true
    else
        # Said out loud: an unfetched clone would otherwise check nothing and pass.
        printf '\033[33m! pre-push\033[0m no origin/main to find the base of %s from — nothing checked (git fetch origin, then push again)\n' "${local_sha:0:9}" >&2
    fi
}

ranges=()
to_main=0
if [ "${1:-}" = "--range" ]; then
    ranges+=("${2:?--range A..B}")
    to_main=1   # a dry run is judged as a push to main
else
    while read -r _local_ref local_sha remote_ref remote_sha; do
        [ "$local_sha" = "$Zero" ] && continue   # deleting a remote ref: nothing to check
        base="$(base_for "$local_sha" "$remote_sha")"
        [ -n "$base" ] && ranges+=("$base..$local_sha")
        [ "$remote_ref" = refs/heads/main ] && to_main=1
    done
fi
[ "${#ranges[@]}" -eq 0 ] && exit 0

if [ "$to_main" = 1 ]; then
    if skipped redgate; then warn "redgate SKIPPED (PREPUSH_SKIP)"
    else check_redgate "${ranges[@]}" || exit 1
    fi
fi

# THREE dots: what the pushed commits changed since they left the base, not how the two tips
# differ. A fetch by any agent moves origin/main under every worktree of this clone, and a two-dot
# diff would count those newer commits of main as this push's changes.
changed=""
for r in "${ranges[@]}"; do
    # A diff that fails is not "nothing changed".
    names="$(git diff --name-only --diff-filter=d "${r/../...}")" \
        || { printf '\033[33m! pre-push\033[0m cannot diff %s — blocked (bypass with --no-verify)\n' "$r" >&2; exit 1; }
    changed="$changed$names"$'\n'
done
changed="$(printf '%s' "$changed" | grep -v '^$' | LC_ALL=C sort -u)"
[ -z "$changed" ] && exit 0
# A commit, not a name: `--range A..HEAD` must compare equal to the checkout's own HEAD.
head_sha="$(git rev-parse --verify "${ranges[${#ranges[@]}-1]##*..}^{commit}")" || exit 1
base_sha="${ranges[0]%%..*}"

checks="$(printf '%s\n' "$changed" | plan)"
[ -z "$checks" ] && exit 0

# ── Running them ────────────────────────────────────────────────────────────────────────────────
changed_matching() { printf '%s\n' "$changed" | grep -E "$1" || true; }

check_eslint() {
    if [ ! -x node_modules/.bin/eslint ]; then
        log "installing ESLint (npm ci, once per worktree)"
        npm ci --no-audit --no-fund --silent >/dev/null || return 1
    fi
    npm run --silent lint
}

check_drift() {
    # GeoNames' Polish gazetteer, kept in the shared git dir so every worktree downloads it once.
    GEONAMES_CACHE="$(git rev-parse --path-format=absolute --git-common-dir)/kinowo-cache/geonames" \
        scripts/ci/generated-artefacts-drift.sh > "$tmp/drift.log" 2>&1 \
        || { sed -n '/::error::/,$p' "$tmp/drift.log" | head -80 >&2; return 1; }
}

check_snapshot() {
    scripts/read-model-snapshot-inputs.sh check "$head_sha"
}

check_dashboards() {
    python3 infra/test/test_dashboards.py > "$tmp/dashboards.log" 2>&1 \
        || { sed -n '/^FAIL\|^ERROR\|AssertionError/,+3p' "$tmp/dashboards.log" | head -40 >&2; return 1; }
}

check_hooktest() {
    bash scripts/hooks/pre-push-test.sh > "$tmp/hooktest.log" 2>&1 \
        || { grep -v '✓' "$tmp/hooktest.log" | head -40 >&2; return 1; }
}

check_actionlint() {
    command -v actionlint >/dev/null || { warn "actionlint not installed (brew install actionlint) — SKIPPED"; return 0; }
    local files
    files="$(changed_matching '^\.github/workflows/.*\.ya?ml$')"
    # shellcheck disable=SC2086 # workflow file names carry no spaces
    SHELLCHECK_OPTS='-S warning' actionlint $files
}

# Fail on a warning the push ADDS: count each changed script's warnings at the base and at HEAD.
check_shellcheck() {
    command -v shellcheck >/dev/null || { warn "shellcheck not installed (brew install shellcheck) — SKIPPED"; return 0; }
    local f before after rc=0
    for f in $(changed_matching '(\.sh$|^scripts/hooks/)'); do
        [ -f "$f" ] || continue
        after="$(shellcheck -S warning -f gcc "$f" 2>/dev/null | wc -l | tr -d ' ')"
        if git cat-file -e "$base_sha:$f" 2>/dev/null; then
            git show "$base_sha:$f" > "$tmp/base.sh"
            before="$(cd "$(dirname "$f")" && shellcheck -S warning -f gcc "$tmp/base.sh" 2>/dev/null | wc -l | tr -d ' ')"
        else
            before=0
        fi
        if [ "$after" -gt "$before" ]; then
            warn "$f: shellcheck warnings $before → $after"
            shellcheck -S warning "$f" >&2
            rc=1
        fi
    done
    return $rc
}

check_sbt() {
    command -v sbt >/dev/null || { warn "sbt not installed — SKIPPED"; return 0; }
    local compiles
    # shellcheck disable=SC2207 # task names carry no spaces
    compiles=($(printf '%s\n' "$changed" | compile_plan))
    local lints module tests=()
    lints="$(printf '%s\n' "$changed" | lint_plan)"
    for module in worker web; do
        tests+=("$module/Test/testOnly $(printf '%s\n' "$lints" | sed -n "s/^$module://p" | tr '\n' ' ' | sed 's/ $//')")
    done
    local run=(sbt -batch -Dsbt.server.forcestart=false "${compiles[@]}" "${tests[@]}")
    if [ "$sbt_client" = 1 ]; then
        local line
        line="$(printf '%s; ' "${compiles[@]}" "${tests[@]}")"
        run=(sbt --client "${line%; }")
    fi
    "${run[@]}" > "$tmp/sbt.log" 2>&1 \
        || { grep -E '\*\*\* FAILED|\[error\]|should|Error' "$tmp/sbt.log" | head -60 >&2; warn "full log: $tmp/sbt.log"; return 1; }
}

check_ios() {
    scripts/ios-compile-check.sh
}

# The takes the newest decided Identity model convergence legs served, as `<dir>/<cc>-takes/<cc>.json.gz` under a cache
# kept per run in the shared git dir; prints the files, or nothing (warned) when gh cannot fetch them in time.
served_takes() {
    local run cache
    run="$(perl -e 'alarm shift; exec @ARGV or exit 127' "$GhSeconds" gh run list --workflow "Identity model convergence" \
        --branch main --status completed --limit 30 --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success" or .conclusion == "failure")][0].databaseId // empty' 2>/dev/null)" || run=""
    [ -n "$run" ] || { warn "judgements: no Identity model convergence run to read served takes from — served check SKIPPED"; return 0; }
    cache="$(git rev-parse --path-format=absolute --git-common-dir)/kinowo-cache/served-takes/$run"
    if [ ! -d "$cache" ]; then
        mkdir -p "$cache.part"
        perl -e 'alarm shift; exec @ARGV or exit 127' 120 gh run download "$run" -p 'convergence-diagnostics-*-convergence' \
            -D "$cache.part" >/dev/null 2>&1 && mv "$cache.part" "$cache" \
            || { rm -rf "$cache.part"; warn "judgements: could not fetch run $run's served takes — served check SKIPPED"; return 0; }
    fi
    find "$cache" -path '*-takes/*.json.gz'
}

check_judgements() {
    local served=() before=""
    if printf '%s\n' "$changed" | grep -qx 'test/resources/fixtures/identity-unmatched/labels.tsv' && command -v gh >/dev/null; then
        while IFS= read -r f; do [ -n "$f" ] && served+=("$f"); done < <(served_takes)
        before="$tmp/labels-before.tsv"
        git show "$base_sha:test/resources/fixtures/identity-unmatched/labels.tsv" > "$before" 2>/dev/null || before=""
    fi
    # --replay-head: the takes the push newly labels wrong judged at the PUSHED code (identity-slice), not the last leg's
    python3 scripts/ci/identity_judgements_lint.py ${served[@]+--served "${served[@]}"} ${before:+--labels-before "$before" --replay-head}
}

tmp="$(mktemp -d)"

# THE PUSHED COMMITS ARE JUDGED, not the working tree: that can hold edits the push does not
# carry, or sit on another branch entirely (`git push origin other:main`). When HEAD is the
# pushed commit and nothing the push changed differs from it, the checkout is that tree and the
# checks run in place, warm. Otherwise they run in a temporary worktree of the pushed commit —
# never `git stash`, which is shared by every worktree of this clone — removed afterwards.
in_place() {
    [ "$(git rev-parse HEAD)" = "$head_sha" ] || return 1
    local path
    while IFS= read -r path; do
        git diff --quiet HEAD -- "$path" || return 1
        [ -z "$(git ls-files --others --exclude-standard -- "$path")" ] || return 1
    done <<< "$changed"
}
# ONE sbt PER target/. A live sbt JVM in this checkout — the DevPanel's `sbt web/run`, an IDE's
# BSP server, an agent's test run — compiles into the same target/ as the check would: Play's dev
# server recompiles on the first request after a merge changes sources. Two Zincs over one classes
# dir delete and rewrite each other's class files, and the check's tests then load a class the
# other has just deleted (NoClassDefFoundError: services/movies/MovieRepository$, twice on
# 2026-09-26; a retry passed once both had settled). Echoes the first such pid.
live_sbt_in_checkout() {
    local here pid cwd
    here="$(pwd -P)"
    for pid in $(pgrep -f 'sbt-launch|xsbt\.boot\.Boot' 2>/dev/null); do
        cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
        [ -n "$cwd" ] && [ "$(cd "$cwd" 2>/dev/null && pwd -P)" = "$here" ] && { echo "$pid"; return 0; }
    done
    return 1
}
isolate_reason="" sbt_client=0
if ! in_place; then
    isolate_reason="the working tree is not ${head_sha:0:9}"
elif printf '%s\n' "$checks" | grep -qx sbt && ! skipped sbt && live_pid="$(live_sbt_in_checkout)"; then
    # the checkout's KEPT server (scripts/sbt-warm: `sbt --client`, launched --detach-stdio) is no rival compiler —
    # it is the one compiler: the check runs through it, in place and warm
    if ps -o args= -p "$live_pid" 2>/dev/null | grep -q -- '--detach-stdio'; then
        sbt_client=1
        log "the sbt check runs through this checkout's kept sbt server (pid $live_pid), warm"
    else
        isolate_reason="a live sbt (pid $live_pid) shares this checkout's target/"
    fi
fi
if [ -n "$isolate_reason" ]; then
    tree="$tmp/tree"
    git worktree add -q --detach "$tree" "$head_sha" || { warn "cannot check out ${head_sha:0:9} to check it"; exit 1; }
    trap 'git -C "$root" worktree remove --force "$tree" >/dev/null 2>&1; git -C "$root" worktree prune' EXIT
    [ -d "$root/node_modules" ] && ln -s "$root/node_modules" "$tree/node_modules"
    log "$isolate_reason: checking a temporary checkout of ${head_sha:0:9}"
    cd "$tree" || exit 1
fi

failed=""
started=$SECONDS
log "$(printf '%s' "$checks" | tr '\n' ' ') — for $(printf '%s\n' "$changed" | wc -l | tr -d ' ') changed path(s)"
for check in $checks; do
    if skipped "$check"; then warn "$check SKIPPED (PREPUSH_SKIP)"; continue; fi
    t0=$SECONDS
    if "check_$check"; then
        log "$check ok ($((SECONDS - t0))s)"
    else
        warn "$check FAILED ($((SECONDS - t0))s)"
        failed="$failed $check"
    fi
done

if [ -n "$failed" ]; then
    warn "blocked by:$failed ($((SECONDS - started))s). Fix, or bypass with PREPUSH_SKIP=\"${failed# }\" / --no-verify."
    exit 1
fi
rm -rf "$tmp"
log "all clear ($((SECONDS - started))s)"
