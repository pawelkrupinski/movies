#!/usr/bin/env bash
# Purpose: Pre-push: the checks that fail CI in seconds, run here in seconds, for what this push changes
# shellcheck disable=SC2154 # the run's state (changed, ranges, head_sha, tmp, ...) comes from the state file pre_push_checks.Shell sources first
# PRE-PUSH: the checks that fail CI in seconds, run here in seconds, for what this push changes.
# (The selection functions named below -- plan, js_quality_paths, lint_plan, is_shell_path, ... -- are Python's:
# scripts/pre_push.py over scripts/lib/pre_push_{paths,plan,units,lints,modes}.py; the checks run here.)
#
# About one CI failure in nine over four weeks (2026-08-27 → 09-24) was a lint or a generated
# artefact: nothing a ten-minute pipeline needed to discover. Each check below runs only when the
# push touches the paths it guards, so a typical push costs a few seconds and a Scala push well
# under a minute on a warm build:
#
#   `eslint`      web/src/main/assets/js/**, web/src/page/resources/**/*.js, eslint.config.js, eslint-rules/** (the repo's own rules), package*.json + page-tests-playwright/tests/*.ts + lint-flake-patterns*.mjs (the page-spec flake lint)
#   `jsquality`   THE JS/TS QUALITY RATCHET (CLAUDE.md, "Code quality ratchets"), on a change to the production JS/TS
#                 (web/src/main/assets/js/**, infra/version-dashboard/src/**), its baseline or the measure (js_quality_paths):
#                 scripts/js-quality-report --check measures it (scripts/js-quality/ratchet-areas.tsv; ESLint + sonarjs,
#                 jscpd, dependency-cruiser and the /* global */ graph, ~2-3 s) and scripts/ci/js_quality_ratchet.py holds
#                 it to test/resources/js-quality-baseline.tsv -- no new function, file, clone set, module or cycle past a
#                 limit (cognitive / cyclomatic 10, inner defs 2, function 50 lines, file 500, clones 50 tokens, fan-out 9,
#                 D 0.20, no cycle), no frozen row rising -- and the baseline grows only in a commit carrying the kind's
#                 trailer (`Complexity:`, `Length:`, `Duplication:`, `Coupling: <why>`; scripts/js-quality-report --update
#                 writes it; falls need none). Tests, page tests, Playwright and scripts are reported, never gated: they
#                 select no check. Its tools: `npm ci` once per lock, outside the tree in ~/.cache/kinowo/js-quality (npm or node missing BLOCKS)
#   `pyquality`   THE PYTHON QUALITY RATCHET (CLAUDE.md, "Code quality ratchets"), on a change to a Python tool under
#                 scripts/, .github/scripts/, infra/bin/, infra/nix/bin/, infra/nix/files/, android/ or ios/scripts/ (a .py, or an
#                 extension-less file with a python shebang), its baseline, the
#                 measure or pyrightconfig.json (py_quality_paths): scripts/py-quality-report --check measures every one
#                 (stdlib ast + tokenize: cognitive / cyclomatic 10, inner defs 2, function 50 lines, file 500, clones 50
#                 tokens, fan-out 9, no import cycle; ~1 s) and strict pyright over the push's own .py files, and
#                 scripts/ci/py_quality_ratchet.py holds them to test/resources/py-quality-baseline.tsv -- no new row
#                 past a limit, no frozen row rising, a new file with no type error -- the baseline growing only under the
#                 kind's trailer (`Complexity:`, `Length:`, `Duplication:`, `Coupling:`, `Typing: <why>`). Self-tests
#                 are reported, never held. Pyright: `npm ci` once per lock, outside the tree in ~/.cache/kinowo/py-quality
#                 (npm or node missing BLOCKS)
#   `drift`       the generated roster chain (scripts/ci/generated-artefacts-drift.sh)
#   `snapshot`    the read-model snapshot's input stamp (scripts/read-model-snapshot-inputs.sh)
#   `sbt`         NoWallClockInTestsSpec, NoWallClockInClientsSpec, the two Grafana metric-coverage
#                 specs and NoSilencedGhCurlSpec, in ONE sbt run, on any Scala or dashboard change, any
#                 script or workflow under scripts/, .github/ or infra/, or any file a lint-registry row says its spec
#                 reads (the Dockerfile, the AOT class list, host-memory.json, a fixture: THE ARTEFACT READERS, every
#                 spec reading a checked-in or generated artefact, held to its row by lint_registry_reads.py) -- plus, on any change under scripts/,
#                 .github/, .claude/, CLAUDE.md, build.sbt, project/ or */src/test|it/ (`--lint-plan`, ~30 s warm),
#                 the repo-reading lint specs whose rows read what the push changes (each row: what its spec opens,
#                 and its own code): the deploy/ specs and the No*/*Lint* source lints, bar the
#                 ones listed at lint_plan that boot a server -- those reading the GitOps manifests too, once
#                 infra/bin/fetch-gitops has put them in place (GitHub unreachable: the push BLOCKED, never
#                 checked against stale manifests); `lintspecs` skips just those -- and,
#                 ahead of them in that same run, the Test/It/Page configs of every module the push
#                 touches and every module depending on one (`sbt compile` skips them all: f20a6b5dd
#                 broke worker/It/compile and only CI saw it). `--compile-plan` prints that list.
#                 AND THE COUPLING RATCHET (CLAUDE.md, Design rules), in that same run, when the push touches a deployed
#                 module's src/main, the build or the ratchet (coupling_paths): `couplingReport` measures the production
#                 code's coupling from Zinc's record (project/Coupling.scala; ~2 s warm) and scripts/ci/coupling_ratchet.py
#                 holds it to NO package cycle (any cycle edge refuses, naming its class references; no trailer
#                 excuses one) and to test/resources/coupling-baseline.tsv -- no new cross-module edge kind, package
#                 Ce past its row, class fan-out or package distance D past its frozen row or the limit (9; 0.20 for a package of 8+
#                 types; only an exemption, test/resources/coupling-exemptions.tsv, admits a new one), package edge into a higher layer or, inside
#                 an ordered layer, a higher rank, package without its layer or rank (test/resources/coupling-layers.tsv)
#                 -- and the baseline grows, and the layer table loosens (an `allow` row, a moved layer or rank), only
#                 in a commit carrying `Coupling: <why>` (scripts/coupling-report --update writes the baseline; falls
#                 need no trailer; a frozen class cut into pieces freezes them at their own values under
#                 `Coupling: split of <X>` when they take over X's code and reference nothing X did not,
#                 test/resources/coupling-fanout-refs.tsv, the classification test/resources/coupling-collaborators.tsv).
#                 PREPUSH_SKIP=coupling skips just it.
#                 AND THE CODE-QUALITY RATCHETS (CLAUDE.md, "Code quality ratchets"), in that same run, when the push
#                 touches a deployed module's src/main Scala, the `quality` module, a quality baseline or the ratchet
#                 (quality_paths): `quality/runMain quality.QualityReport` measures every production method's
#                 complexity from its source (scalameta) and scripts/ci/quality_ratchet.py holds it to
#                 test/resources/complexity-baseline.tsv -- no new method past a limit (cognitive 10, cyclomatic 10,
#                 inner defs 2), no frozen row rising -- and its length to length-baseline.tsv (method 50 lines, file
#                 500), and its clone groups (PMD CPD, 50+ tokens, beside the parse: ~7 s together) to
#                 duplication-baseline.tsv -- no new group, no group gaining a copy; a baseline grows only in a commit
#                 carrying its trailer (`Complexity: <why>`, `Length: <why>`, `Duplication: <why>`;
#                 scripts/quality-report --update writes them; falls need no trailer); the declared data tables
#                 (test/resources/quality-data-tables.tsv: hand-written literal tables, measured as no method and no
#                 source lines) must each read as data -- no def, branch, lambda or block -- and a row added carries
#                 `Length: <why>`. And THE NAMING LINT
#                 (scripts/design-rules/naming_lint.py, seconds): two top-level types of one package named with the same words
#                 in another order refuse the push; a NEW type named for an action (...Apart, ...Plans, ...Reads) with
#                 at most one public def is warned about. And THE DESIGN RULES (scripts/design-rules/design_check.py
#                 --languages scala): the Scala names' frozen suffix / abbreviation rows (test/resources/design-baseline.tsv).
#                 `jsquality` and `pyquality` run the same two over their own language, with the general rules'
#                 collaborator-only fan-out, distance, layers, data guard and design lint (CLAUDE.md, "Design rules").
#                 PREPUSH_SKIP=quality skips just it
#   `dashboards`  infra/test/test_dashboards.py — the Grafana dashboards' structure and queries,
#                 the CI check `Stage NixOS closures` runs (well under a second)
#   `metricalerts` infra/test/test_metric_alert_coverage.py — every kinowo_* metric family and recording rule is read by
#                 an alert or has a row (metric, reason, owner) in test/resources/metrics-without-alerts.tsv; on a change
#                 to the rule files, the Grafana alerts, the metric catalogue (what a new registration regenerates), a
#                 metrics source (`*/src/main/*etrics*`), a fleet exporter (an infra/nix *.sh/*.nix or scripts/ci/*.py
#                 echoing `# TYPE kinowo_`) or the TSV. Its PyYAML comes from the pinned venv scripts/python-venv builds
#                 once (about a second)
#   `scripttests` scripts/run-script-tests --changed <base>, on any change under the script-test roots (scripts/,
#                 .github/scripts|actions, android/scripts, ios/scripts, infra/bin, data) or matching a glob a self-test
#                 declares it reads (`run-script-tests --reads`: every workflow, .py and Scala spec): only the self-tests
#                 whose test, tool, a file they name, or one they read the push changed -- this hook's own test among them (it names
#                 install-hooks.sh and hooks-path.sh), since a new check changes what the hook plans; and the
#                 floor bash 3.2 the tools promise to run on, in its own scope (run-script-tests' FLOOR: the bash the
#                 push touches parsed by it and its added lines held to 3.2, the self-tests of those bash files run
#                 under it instead of natively, in the same run; `--changed <base> --floor "$(scripts/floor-bash)"`: a Mac's
#                 /bin/bash, on Linux -- ci-runner's landing checks -- the GNU 3.2.57 `scripts/floor-bash --install`
#                 builds; none BLOCKS, PREPUSH_SKIP=floor skips it); and, Docker running, beside them on Linux
#                 (`--linux`, CI's ubuntu-26.04; PREPUSH_SKIP=linux skips it) -- unless the hook already runs on Linux
#                 (ci-runner's landing checks: the native run is the Linux one). Opt-in, PREPUSH_STRESS=N: the
#                 concurrency-heavy self-tests the push selects (`# script-test-stress:`) run again N times at once
#                 beside a CPU burner a core (run-script-tests' STRESS) -- minutes of CPU, past the landing budget,
#                 so never by default; a run selecting one says so
#   `actionlint`  changed workflow files (with shellcheck over their `run:` blocks), and changed
#                 composite actions' `run:` blocks (scripts/ci/shellcheck-action-runs.sh)
#   `shellcheck`  changed *.sh, hook scripts and extensionless tools with a shell shebang (pre_push_paths.is_shell_path) —
#                 fails only on warnings the push ADDS, so a file that was already noisy can still be edited
#   (no `oldrefs` check: identity-slice's old-ref compile, scripts/identity-slice-old-ref-test.sh, runs after landing, on
#                 Main's `identity-slice old-ref compile` row -- the owner, 2026-11-21, "(5)": it caught 1 change in 27
#                 landing checks, at a p90 of 20 min)
#   `itrest` `itidentity` `e2ecorpus`  THE HEAVY ROWS, in the landing check only (PREPUSH_HEAVY_ROWS=1, precommit-check.yml's
#                 `check (rest)` job, after its sbt check): Main's `integration-test (rest)` and `(identity)` (`IT_ROW=<row> sbt itAll`,
#                 against the job's throwaway MongoDB, $PREPUSH_HEAVY_MONGODB_URI: theirs alone) and, with the identity row, `e2e (corpus)`
#                 (`sbt e2eCorpus`), selected by the paths each row can move (pre_push_plan.heavy_rows). 8 of Main's 14
#                 code reds in the five days to 2026-10-30 were in rows nothing ran before main (ci-failures-2026-10-30
#                 §2.1). Never on the laptop: off CI the variable is unset and none is selected. `e2e (rest)` is no longer
#                 one (the owner, 2026-11-17, "B1": 0 failures in 95 landing checks, 303 runner-min a week): it runs
#                 after landing, on Main, as the page tests do
#   `basic`       NOT a check of its own: scripts/hooks/local-tests.txt's `basic` lines (all test configs compiled, the
#                 IntegrationTest compiles, FilmScheduleEndToEnd + ReadModelSnapshot, the worker's DocCommentPlacement,
#                 RegisteredCollectionLists and deploy specs) ride the `sbt` check's one sbt run, whenever it runs --
#                 the basic tests before every merge (once the merge queue's pre-check list)
#   `identity`    local-tests.txt's `identity` lines, on a change to the identity paths (pre_push_paths.IDENTITY) or to what the
#                 identity specs read by class alone, common's production code and the testkit (is_identity_reach_path): the identity
#                 specs that run in under 15 min on the laptop (measured there); convergence and the takes measure
#                 are main's CI's. FIRST, its `first` line: SLICE ANSWER COVERAGE (scripts/identity-slice-coverage,
#                 ~30 s warm, ~2.5 min under load) -- every pinned slice case and drift slice replayed at the pushed code, every request one
#                 asks that its fixture lacks named at once with the `--repin` line that pins them all from their
#                 recordings (Unmatched C's new searches turned main red twice, #2180, found a case at a time). Through scripts/sbt-warm, warm. Only the specs the change can reach, over the
#                 countries it can reach (TEST-IMPACT SELECTION, select_identity_tests; proof: identity-impact-check).
#                 The population walk (PopulationMonotonicitySpec) is judged AGAINST THE MERGE BASE: a slice whose flips
#                 differ from the known rows is walked again with the base's code (scripts/ci/population-walk-diff), and
#                 only a flip the base lacks (or a known row cured) refuses -- the listing, slice and chain named
#                 Its rows are kept per digest of its code and data (sbt identityWalkDigest) and per slice content:
#                 a change leaving both as a checked commit had them walks only the slices whose files differ
#   (no `page` check: the page specs and the Playwright rows run after landing, on Main's `page-tests-*` rows -- the
#                 owner, 2026-11-17, "B1": 0 failures in 14 landing checks, ~23 min each. scripts/page-tests-local runs
#                 them on the laptop, by hand, for a UI change)
#   `identitydrift` scripts/identity-drift-ci --for-red <run>, on a push to main whose commits carry `Fixes-Red: <run>` (and no
#                 `Red-Unrelated:`) and touch a drift path (.github/identity-drift-paths.txt): the red's own failed
#                 `takes-drift-1|2 (<country>)` rows, run drift-only on CI, ~12-16 min. A
#                 fix no better than the red in any row, or worse in one, refuses the push (a partial fix lands): a
#                 "fix" for a drift red is judged on the red's rows before it lands, not ~48 min after on main
#                 (convergence-failures-2026-10-29 §7.2: two refuted fixes, 52 fixer launches).
#                 A red with no failed drift row has nothing to judge; a run that could not be made warns and passes
#                 (nothing heavy runs on the laptop either way). Not from a CI job (agentctl's remote checks): said so.
#                 AND A CHECK'S BIRTH LANDS GREEN: a push touching the gate itself (.github/identity-drift-gate-paths.txt:
#                 the drift-check script, the replay harness, the flip predicate, the allow-lists), or carrying
#                 `New-Check:` and touching a drift path, runs every drift row against main's newest run
#                 (identity-drift-ci --against main): a row worse than main's refuses the push
#   `newchecks`   scripts/ci/gating_checks.py lint, on a change to a workflow, the gating-checks registry or this hook: every
#                 job, runner label and gate workflow THE GATE reads is registered, a new one `unproven` (with its owner)
#                 until a green run proves it (`prove`). The red gate below holds no push for a run red only in unproven
#                 checks: A NEW CHECK GATES ONLY ONCE IT HAS BEEN GREEN (ci-failures-2026-10-30, recommendation 5)
#   `schedules`   infra/nix/files/scheduled_dispatch.py check, on a change to a workflow or the external scheduler's
#                 generated schedule: monitoring-1's dispatch timers are generated from the workflows' own crons
#                 (scheduled-workflows.json), and every covered workflow treats the scheduler's repository_dispatch as
#                 its schedule (under a second)
#   `allowlists`  scripts/ci/commit_rules.py allowlists over the pushed commits, on a change to a registered allow-list
#                 (.github/allow-lists.txt) or the ratchet itself: a row lands only with its check's birth (`New-Check:`,
#                 the row TEMPORARY with an owner and when it goes); otherwise a list only shrinks
#   `ios`         scripts/ios-compile-check.sh (app target + XCUITests, Mac and Linux SwiftPM; fails on a concurrency
#                 diagnostic) on ios/** — this one
#                 is minutes, not seconds, and only runs for iOS pushes
#   `driftguards` scripts/ci/commit_rules.py driftguards over the pushed commits, on a change to the identity paths, worker/src/main or
#                 the drift harness (is_drift_path), or on any pushed commit carrying `Fixes-Red:` (CI judges every one): a commit fixing a drift or flip red (`Fixes-Red:` and a message
#                 about drift/flips) lands with its drift slice (test/resources/fixtures/drift-slices/, cut by
#                 scripts/identity-slice --emit-drift-slice) or `Drift-Slice: none -- <why>`; a red fix changing
#                 resolver or agreement RULE code names the design
#                 doc that measured it (`Identity-Design: <doc>`; red fixers fix incremental state, not rules -- the
#                 owner, 2026-10-29); and a change to the drift harness
#                 (IdentityDrift, IdentityLiveDrift, TakeFlips, identity-drift-check.sh) carries its self-test in the same
#                 commit (IdentityDriftSpec, CorrectionFlipReplaySpec, TakeFlipsSpec, the check's test) or
#                 `Drift-Harness-Refactor: <why>`; and a change to what the worker serves over time (the model's
#                 input gate, holds, settle, asks) ships its gauges/alert in the same commit or names the earlier
#                 push's commit that did (`Gauges-Shipped: <sha>`; else `Gauges: none -- <why>`). Seconds: git only
#   `puremove`    scripts/pure-move-check <sha>^..<sha> over each pushed commit carrying `Pure-Move: verified`, whatever it
#                 touches: a commit claiming to be a pure move (files, packages and classes renamed, nothing else, so no
#                 take can move and scripts/identity-what-if has nothing to measure) is one. The trailer is optional --
#                 identity-what-if runs the check itself -- and verified only when present. Such a commit's paths select
#                 no `identity` area and no identity heavy rows (A VERIFIED PURE MOVE OWES NO IDENTITY AREA, below);
#                 the commits without the claim still do. Seconds a commit
#   `stampcarry`  scripts/identity-stamp-carry verify over the pushed range, on a change to the stamp carry table
#                 (test/resources/identity-stamp-carry.tsv; project/StampCarry.scala): every row the push adds or changes
#                 is proven again -- its pure-move-check re-run, or its recorded identity-what-if verdict (every country,
#                 every family, no take moved) re-read, for exactly the row's base and head, and both digests made again
#                 by the build over those commits' trees. A row it cannot prove refuses the push: a carried stamp keeps
#                 every worker's stored families on the next boot, so only a proven-equivalent change may carry one.
#                 Seconds when the rows' trees are compiled (propose compiled them), a compile a tree when not
#   `flipbacklog` THE FLIP BACKLOG IS COMPLETE (Main #2515: 97d260d67 committed the Ratzeburg Grinch drift slice with its
#                 `drift` row alone; PopulationMonotonicitySpec failed main on four A -> B -> A takes no `population` row
#                 named, and a slice changed alone selected no check at all), on a change to the flip backlog, the
#                 struck flips, the drift-gate seeds, a drift or identity slice, or its judge: every slice the change
#                 brings (its files, or its `population` rows, differ from the merge base's:
#                 scripts/ci/population_walk_diff.py changed-slices) walked with PopulationMonotonicitySpec.main through
#                 scripts/sbt-warm, and judged on the known rows alone, as main's spec judges it (judge-walk): a flip no
#                 row names refuses with the row to add, as do a cured row, a rule contract breach and a failed walk.
#                 No slice brought (a seeds-only explorer filing): no sbt, a second. Else ~3 s a slice warm
#   `judgements`  scripts/ci/identity_judgements_lint.py on identity-judgements.tsv, the expected
#                 matches and hard clusters: the judgements are well formed and the files leaning on
#                 them agree. A judgements change is also read against the takes the newest Identity
#                 model convergence legs served (their diagnostics artifacts, cached per run): a take
#                 the push newly calls wrong that no known-wrong row tolerates fails here, not in the
#                 leg after the push (911d8f486)
#
# WHAT IS CHECKED is the pushed commit's tree: in place when the checkout is that tree, else in a
# temporary worktree of it (cold, so an sbt check there takes minutes, not seconds). The same
# temporary worktree is used when an sbt check would share target/ with a live sbt in the
# checkout (e.g. the DevPanel's `sbt web/run`): two compilers over one classes dir race.
#
# RED BUILDS GATE EVERY PUSH TO MAIN. Before any path check: when the newest COMPLETED run on main of a
# gating workflow (Main, Identity model convergence and Identity takes, the owner's gate of 2026-10-27 and 2026-11-08; a cancelled run says nothing
# and is passed over) is red, the push lands only as a fix for it — every pushed commit carries a
# `Fixes-Red: <run>` trailer naming a run of the current red episode (A FIX MATCHES THE RED, below) — except a commit touching no production path
# (*/src/main/, conf/, build.sbt, project/, infra/nix/, infra/kubernetes/, Dockerfile): tools — scripts, docs,
# skills, tests, fixtures, CI tooling — land while red (user, 2026-10-14). On 2026-10-13/14, 50 of 96 identity commits
# landed while Identity model convergence was red: 3f11e2cc3's wrong switches hid behind a DE red for six
# hours, and three gates and label batches each turned it red again. One `gh run list` a workflow, each
# bounded and tried $PREPUSH_GATE_ATTEMPTS (3) times; gh, curl or jq NOT INSTALLED blocks, as any missing tool does
# (BYPASS below).
# THE GATE FAILS CLOSED: a gate it cannot read -- no token, an API error, no answer in time -- may be red, so a push with
# a production commit in it is REFUSED, saying how to hand the hook the token; a tools-only push lands, as it would
# while red. 2026-10-27 08:05Z: a gate skipped for want of a token let agentctl's waiting processor push onto a red Main.
# Bypass: PREPUSH_SKIP=redgate. NOT gating: the Identity findings report (a recording's own suspects and
# corpus-shape findings, red after 3 days untriaged) -- no push makes or mends a recording's data.
#
# A STRANDED TRAILER REFUSES EVERY PUSH TO MAIN, green or red, a dry run (--checks-only, --fast-only) too: a pushed
# commit's `Fixes-Red:`, `Red-Unrelated:`, `New-Check:`, `Retires:` or `Pure-Move:` line outside the message's closing trailer block
# (a paragraph of its own above `Co-Authored-By:`) is prose to git's trailer parser, the only reader the red gate and
# agentctl's red bookkeeping have. 38 of main's 204 Fixes-Red commits from 2026-10-20 to 11-02 had theirs there: Main
# #2164's and #2547's fixes landed unlinked, the reds stayed open and fixers were sent at them again; 2 of 2026-11-19's 3
# `Pure-Move:` claims were never checked, and paid the identity area a pure move owes none of. Bypass:
# PREPUSH_SKIP=trailers.
# A MISPLACED TRAILER WARNS (never refuses): any known key (scripts/ci/trailers.py KNOWN_KEYS -- Coupling, Complexity,
# Duplication, Length, Pure-Move, Fixes-Red, Identity-Design, Drift-Harness-Refactor) on a line git reads no trailer
# from is named with its commit and line number, before a ratchet refuses the push as if no trailer was given.
#
# THE KNOWN-RED BASELINE: with $PREPUSH_BASELINE_DIR set (agentctl sets it), a check that fails is held against the push
# only when it fails in a way plain main does not. `<dir>/<base commit sha>` is the hook's own output of the same checks
# on the base's tree, its first line `pre-push baseline <base commit sha>` (agentctl's `land` writes it when a change's
# dry run fails: `--checks-only` over main's tree on top of the change). A failing check whose failure lines (the strong
# markers -- *** FAILED, [error], Error:, assertion, exit code, FAILED -- else every line, normalized: no timestamps,
# temp paths, shas or numbers) ALL appear in that check's failure on the base is KNOWN RED: said, not blocking. A
# change that fixes one simply passes it. FAIL-CLOSED: no file for the push's base, a file without that first line, or
# more than one pushed range, and every failing check blocks as ever. A stall is never known red. Without the variable,
# nothing changes (2026-10-27: every land failed on main's own breakage, the fix included).
#
# REUSE: a push of a tree that already passed -- same tree, base, changed paths, hook, red-gate state and PREPUSH_SKIP --
# skips the path checks (THE REUSE, below; the key kept in ~/.cache/kinowo-prepush). Anything different runs them all.
# PREPUSH_NO_REUSE=1 runs them regardless.
#
# NO STEP HANGS: each check runs under a no-progress bound (scripts/stall-watch.sh): no CPU in the hook's processes, no
# log written in its temp dir and no progress from scripts/sbt-warm (KINOWO_PROGRESS_FILE: a kept sbt server's work is
# no CPU of the hook's) for $PREPUSH_STALL_SECONDS (1200) ends the check's processes and fails it with
# `pre-push STALLED: <check>`, and the hook with exit 75 -- THE STALL SIGNAL, which scripts/sbt-warm gives too (its
# own bound, 600 s, fires first inside an sbt step). 2026-10-27: a land's hook sat 2.5 h in one sbt-warm call, the
# landing lock held, five lands behind it.
#
# BYPASS: `git push --no-verify` skips the whole hook. `PREPUSH_SKIP="ios sbt" git push` skips
# the named checks.
#
# A MISSING LOCAL TOOL BLOCKS THE PUSH, saying how to fix it -- never a skip (user, 2026-10-21: an agent's push, sbt off
# its PATH, skipped the sbt check and landed unchecked). sbt and a java that runs (sbt), shellcheck,
# actionlint, npm (eslint), python3 (drift, dashboards, judgements, metricalerts) and the drift's timezonefinder and metricalerts' PyYAML (the
# pinned venvs scripts/python-venv builds by itself; blocked only when it cannot), gh (judgements; the
# red gate); the red gate unread blocks a production
# push (THE GATE FAILS CLOSED, above). What stays a WARNING is what lies outside
# this machine's install: an external service unreachable (a served-takes download) and a Docker or Xcode that is not RUNNING/selected (scripttests --linux, ios: CI runs
# both). Not the GitOps manifests: their fetch failing BLOCKS (the checkout left behind is stale, and specs passed or
# failed against it).
#
# INSTALL: scripts/install-hooks.sh (sets core.hooksPath=scripts/hooks, which every worktree of
# this clone shares; the path is relative, so each worktree runs its own checkout's hook).
# An ABSOLUTE path (an IDE rewrote it three times on 2026-10-14) is warned about, and the hook it names
# hands over to the pushing worktree's own copy, so a stale root checkout never judges a worktree's push.
#
# DRY RUN / TEST: `scripts/hooks/pre-push --plan < paths` prints the checks a list of changed
# paths selects, without running them (scripts/hooks/pre-push-test.sh). `--fast-only A..B` is the `waiting` batch's
# combined check at green (each change was checked alone, on an older main, before it joined; the rebase writes the
# combined tree no member saw): the red gate is not judged
# and only the `sbt` check runs -- every test config compiled, the lint specs, and local-tests.txt's `fast` set instead
# of `basic`; no area tests -- with the touched files' shellcheck and actionlint checks, and the checks a touched
# union-merged file selects (THE COMBINED FILES: the rebase wrote it, no member checked it; e.g. `judgements`). Its pass is stored like any (THE REUSE), and a push with PREPUSH_REUSE_FAST=1 (agentctl's
# batch push) of the same tree on the same base reuses it after judging the red gate. `--verify-only A..B` is agentctl's
# COMBINED-TREE VERIFICATION (the owner, 2026-11-16, "but always recompile and unit test"): a change fully checked on an
# older main A, rebased onto a main that moved with no file overlap, so A..B is what landed since plus the change --
# the --fast-only set over those paths, plus the unit tests of every module they touch (`--unit-plan < paths` prints
# them; the worker's are its `rest` unit row -- its identity row is the `identity` area's, its heavy rows no unit
# stage's -- and any worker identity-row spec the paths change, by name; through the kept server narrowed to the
# classes the combined change reaches, test_impact, joined by the tests in ANY module a test-side reader of a changed
# file reaches: `--unit-universe`), plus the self-tests holding repo-wide files
# to a rule (`run-script-tests --readers`) when those paths touch what they read. `--checks-only A..B` is `--range A..B` without
# the red gate: every check, judged as a push to main whatever main's state -- what `agentctl land` runs on the
# `waiting` branch while main is red (the gate is judged again when that branch is pushed). `--range A..B` runs the
# hook for the commits in A..B (diffed from their merge-base) instead of reading git's stdin.
set -uo pipefail
# THE LEGACY FALLBACK (shell-to-Python migration, section 10): KINOWO_PRE_PUSH_LEGACY=1 runs the whole hook as it was
# before its selection moved to Python, scripts/hooks/pre-push.sh-legacy, sourced so its command line still names
# this hook (agentctl finds a push's hook by `hooks/pre-push` in it).
if [ "${KINOWO_PRE_PUSH_LEGACY:-}" = 1 ]; then exec bash -c '. "$0.sh-legacy"' "${BASH_SOURCE[0]}" "$@"; fi
# THE SELECTION AND THE RUN ARE PYTHON'S (scripts/pre_push.py over scripts/lib/pre_push_*.py): which checks, compiles,
# lint specs and tests a list of paths selects (every plan mode), and the run itself -- the hand-over, what is pushed,
# the range rules, the red gate and the stranded trailers (scripts/lib/pre_push_gate.py), the known-red baseline, the
# reuse, the check loop with its watchdog and the verdict lines (scripts/lib/pre_push_run.py; its process keeps this
# hook's path on its command line, which agentctl finds a push's hook by). Run, this file execs it; SOURCED
# (pre_push_checks.Shell, after the run's state as shell variables), it defines the checks below -- `check_<name>` --
# each called by name in a bash of its own.
PrePushHook="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
PrePushPy="${PrePushHook%/*}/../pre_push.py"
pre_push_py() { python3 -I -B "$PrePushPy" "$PrePushHook" "$@"; }
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    case "${1:-}" in
        --plan|--compile-plan|--coupling-plan|--quality-plan|--js-quality-plan|--py-quality-plan|--identity-change|\
        --unit-plan|--unit-universe|--source-lints|--lint-plan|--per-file-lints|--script-test-plan|--failure-summary)
            # ── a plan mode: the copy asked answers it, never handed over ──
            exec python3 -I -B "$PrePushPy" "$PrePushHook" "$@" ;;
    esac
    # git exports GIT_DIR (and, by setup, GIT_INDEX_FILE / GIT_WORK_TREE) for the repository being pushed — for a
    # worktree, ITS git dir: cleared once, for every check (the temporary checkout's git would read the pusher's).
    unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX
    root="$(git rev-parse --show-toplevel)" || exit 1
    # ── The PUSHING checkout's own hook runs, whatever core.hooksPath says ──────────────────────────
    # core.hooksPath=scripts/hooks is relative: each worktree runs its own checkout's copy. Rewritten to an absolute path
    # (three times on 2026-10-14, very likely an IDE's git integration), every worktree's push ran the ROOT checkout's
    # copy — an older hook, judging new work by stale checks. So a hook git runs for another checkout than its own hands
    # over to that checkout's copy. Once only (PREPUSH_DELEGATED_FROM), and never for the dry runs (--range,
    # --checks-only, --fast-only, --verify-only), which name the file they mean; the plan modes were answered above.
    case "${1:-}" in
        --range|--checks-only|--fast-only|--verify-only) ;;
        *)
            if [ -z "${PREPUSH_DELEGATED_FROM:-}" ]; then
                hooks_path="$(git config --get core.hooksPath || true)"
                case "$hooks_path" in
                    /*|~*) printf '\033[33m! pre-push\033[0m core.hooksPath is absolute (%s): every worktree reaches that one copy — scripts/install-hooks.sh sets it back to the relative scripts/hooks\n' "$hooks_path" >&2 ;;
                esac
                hook_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
                own="$(cd "$root" && pwd -P)/scripts/hooks/pre-push"
                if [ "$(cd "$root" && pwd -P)" != "$hook_root" ] && [ -f "$own" ] && ! [ "$own" -ef "${BASH_SOURCE[0]}" ]; then
                    export PREPUSH_DELEGATED_FROM="$hook_root"
                    exec bash "$own" "$@"
                fi
            fi ;;
    esac
    unset PREPUSH_DELEGATED_FROM
# ── end of the hand-over ── (at the line's start: pre-push-test.sh stamps the hook after it)
# A CI RUN'S REF checks nothing (scripts/lib/pre_push_push.py CI_REFS): refs/heads/measure/*, refs/heads/check/* and
# refs/heads/land/* -- agentctl reads that this hook supports land/ refs by the literal `refs/heads/land/` in this file
# (~/bin lib/agentctl/queuesubmit.py land_refs_supported), so it stays here, named.
    # THE RUN FAILS CLOSED: no python3, and nothing would be selected -- the push BLOCKED (A MISSING LOCAL TOOL)
    command -v python3 > /dev/null || {
        printf '\033[33m! pre-push\033[0m python3 not found: the selection check cannot run, so the push is BLOCKED (never skipped). Fix: install Python 3 (brew install python) -- then push again (or PREPUSH_SKIP=selection, named in your report).\n' >&2
        exit 1; }
    cd "$root" || exit 1
    exec python3 -I -B "$PrePushPy" "$PrePushHook" --run "$@"
fi
# ── sourced: the checks ─────────────────────────────────────────────────────────────────────────
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "${BASH_SOURCE[0]}")/../tool-conventions.sh" # bounded: every gh read below has a deadline

skipped() { case " ${PREPUSH_SKIP:-} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# ── Which checks, compiles, lint specs and tests a push selects: scripts/pre_push.py (the header says what each
# check guards; scripts/pre_push_test.py holds the selection). Each reads paths (or sbt lines) on stdin.
plan() { pre_push_py --plan; }
compile_plan() { pre_push_py --compile-plan; }
coupling_paths() { pre_push_py --coupling-plan; }
quality_paths() { pre_push_py --quality-plan; }
unit_plan() { pre_push_py --unit-plan; }
unit_universe() { pre_push_py --unit-universe < /dev/null; }
source_lint_lines() { pre_push_py --source-lints "${1:-}"; } # <lints> < plan lines
lint_plan() { pre_push_py --lint-plan; }
reads_gitops() { pre_push_py --reads-gitops > /dev/null; }
without_unfetched_gitops() { pre_push_py --without-unfetched-gitops; }
failure_summary() { pre_push_py --failure-summary "$1"; } # <log>

log()  { printf '\033[36m▸ pre-push\033[0m %s\n' "$*"; }
warn() { printf '\033[33m! pre-push\033[0m %s\n' "$*" >&2; }

# A local tool a check needs, missing: the check FAILS, saying how to fix it (header: A MISSING LOCAL TOOL).
missing_tool() { # <check> <tool> <fix>
    warn "$2 not found: the $1 check cannot run, so the push is BLOCKED (never skipped). Fix: $3 -- then push again (or PREPUSH_SKIP=$1, named in your report)."
    return 1
}
need() { # <check> <tool> <fix>
    command -v "$2" >/dev/null || missing_tool "$@"
}
SdkmanFix='put sdkman'"'"'s sbt and java on PATH: export PATH="$HOME/.sdkman/candidates/sbt/current/bin:$HOME/.sdkman/candidates/java/current/bin:$PATH" (or run: . "$HOME/.sdkman/bin/sdkman-init.sh")'
# sbt, and a java that RUNS (macOS's /usr/bin/java is a stub that only says no runtime is installed); sbt's launcher
# takes $JAVA_HOME's first.
need_jvm() { # <check>
    local java=java
    need "$1" sbt "$SdkmanFix" || return 1
    [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && java="$JAVA_HOME/bin/java"
    bounded 30 "$java" -version >/dev/null 2>&1 || missing_tool "$1" "a java that runs (\$JAVA_HOME or PATH)" "$SdkmanFix"
}

# ── Red builds gate the push: scripts/lib/pre_push_gate.py (THE GATE, A FIX MATCHES THE RED, A STRANDED TRAILER) ─

# ── Running them: the light checks (eslint ... judgements, ios) are scripts/lib/pre_push_light.py's ──

# The floor the tools promise, bash 3.2 (scripts/floor-bash: a Mac's /bin/bash, elsewhere the GNU 3.2.57 it builds), its
# path printed; nothing printed when there is no floor run (PREPUSH_SKIP=floor, or a pushed runner from before --bash:
# the hook is the working tree's, the runner the pushed commit's). No floor bash BLOCKS, as any missing tool does:
# ci-runner's Linux landing checks, whose missing bash 3 once passed it in silence, let ed160b94b land a construct 3.2
# cannot parse (Order independence #72). PREPUSH_FLOOR_BASH names one (the hook's test).
scripttests_floor() {
    grep -q -e '--bash' scripts/run-script-tests 2>/dev/null || return 0
    if skipped floor; then warn "scripttests under the floor bash 3.2 SKIPPED (PREPUSH_SKIP=floor)"; return 0; fi
    local floor major
    if [ -n "${PREPUSH_FLOOR_BASH:-}" ]; then
        floor=$PREPUSH_FLOOR_BASH
    elif [ -x scripts/floor-bash ]; then
        floor=$(scripts/floor-bash 2> "$tmp/floor-bash.err") \
            || { missing_tool floor "bash 3.2 ($(tr '\n' ' ' < "$tmp/floor-bash.err"))" "scripts/floor-bash --install"; return 1; }
    else
        floor=/bin/bash # a pushed tree from before scripts/floor-bash
    fi
    # shellcheck disable=SC2016 # expanded by that bash
    major=$([ -x "$floor" ] && "$floor" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null) || major=""
    case "$major" in
        3) echo "$floor" ;;
        *) missing_tool floor "bash 3.2 (the floor; $floor is ${major:+bash }${major:-no bash})" \
               "scripts/floor-bash --install, or PREPUSH_FLOOR_BASH=<a bash 3.2>" ;;
    esac
}

check_scripttests() {
    # In the same run (--floor): the floor bash 3.2 (scripttests_floor) over the bash the push touches -- parsed,
    # its added lines held to 3.2, its own self-tests run under it (run-script-tests' FLOOR; every selected test re-run cost a
    # landing ~+70 s) -- so a bash-4-only construct is caught at the push, not by the nightly macOS job; and on Linux (`--linux`: CI's ubuntu-26.04, in Docker) -- GNU tools a Mac's BSD ones hide
    # (03b3a6825), beside it in the background. Warm, that adds ~4 s to a run the native one outlasts: ~0 s of wall time.
    local floor floor_pid="" linux_pid="" rc=0
    if [ -n "$scripttests_readers" ]; then # --verify-only's repo-wide self-tests (above), alone
        if scripts/run-script-tests --changed "$base_sha" --readers > "$tmp/scripttests.log" 2>&1; then
            tail -1 "$tmp/scripttests.log"; return 0
        fi
        grep -v '^PASS\|✓' "$tmp/scripttests.log" | head -80 >&2; return 1
    fi
    local native=()
    floor=$(scripttests_floor) || return 1
    # ONE RUN, ONE POOL (run-script-tests --floor): the floor's scope under 3.2 and the rest natively. Run side by side,
    # a test in both ran twice at once -- pre-push-test.sh, minutes each -- and the contention alone kept a hook change
    # ~+43 s over the landing budget (2026-11-16). A runner from before --floor gets its own floor run, as before.
    if [ -n "$floor" ] && grep -q -e '--floor)' scripts/run-script-tests 2>/dev/null; then
        native=(--floor "$floor")
    elif [ -n "$floor" ]; then
        scripts/run-script-tests --changed "$base_sha" --bash "$floor" > "$tmp/scripttests-floor.log" 2>&1 &
        floor_pid=$!
    fi
    # ALREADY ON LINUX (ci-runner's landing checks, CI's ubuntu): the native run IS the Linux run, so the Docker copy of
    # it repeated it for 120-150 CPU-s a job (2026-11-18) -- skipped, said
    if [ "${PREPUSH_UNAME:-$(uname -s)}" = Linux ]; then
        echo "on Linux: this run is Linux's (the Docker pass, run-script-tests --linux, would repeat it)"
    elif ! skipped linux && grep -q -e '--linux' scripts/run-script-tests 2>/dev/null; then
        scripts/run-script-tests --linux --changed "$base_sha" > "$tmp/scripttests-linux.log" 2>&1 &
        linux_pid=$!
    fi
    if scripts/run-script-tests --changed "$base_sha" ${native[@]+"${native[@]}"} > "$tmp/scripttests.log" 2>&1; then
        tail -1 "$tmp/scripttests.log"
        [ "${PREPUSH_STRESS:-0}" != 0 ] || grep '^run-script-tests: concurrency-heavy' "$tmp/scripttests.log" || true
        [ ${#native[@]} -eq 0 ] || echo "under $floor: the floor's scope, in the same run ($(grep -c ' (floor)$' "$tmp/scripttests.log" | tr -d ' ') test(s))"
    else
        grep -v '^PASS\|✓' "$tmp/scripttests.log" | head -80 >&2; rc=1
    fi
    if [ -n "$linux_pid" ]; then
        if wait "$linux_pid"; then
            echo "on Linux: $(tail -1 "$tmp/scripttests-linux.log")"
        elif grep -q -- '--linux needs a running Docker' "$tmp/scripttests-linux.log"; then
            echo "on Linux: SKIPPED (Docker is not running -- start Rancher/Docker Desktop to run them as CI does)"
        else
            echo "on Linux (scripts/run-script-tests --linux; PREPUSH_SKIP=linux skips it):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-linux.log" | head -80 >&2
            rc=1
        fi
    fi
    # STRESS, opt-in (PREPUSH_STRESS=N): the concurrency-heavy tests the push selects, N runs of each at once under load
    if [ "$rc" = 0 ] && [ "${PREPUSH_STRESS:-0}" != 0 ] && grep -q -e '--stress)' scripts/run-script-tests 2>/dev/null; then
        if scripts/run-script-tests --changed "$base_sha" --stress "$PREPUSH_STRESS" > "$tmp/scripttests-stress.log" 2>&1; then
            echo "stressed (PREPUSH_STRESS=$PREPUSH_STRESS): $(grep -E '^STRESS|no concurrency-heavy' "$tmp/scripttests-stress.log" | paste -sd';' -)"
        else
            echo "under stress (PREPUSH_STRESS=$PREPUSH_STRESS, scripts/run-script-tests --stress):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-stress.log" | head -80 >&2
            rc=1
        fi
    fi
    if [ -n "$floor_pid" ]; then
        if wait "$floor_pid"; then
            echo "under $floor: $(tail -1 "$tmp/scripttests-floor.log")"
        else
            echo "under the floor bash $floor (scripts/floor-bash; PREPUSH_SKIP=floor skips it):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-floor.log" | head -80 >&2
            rc=1
        fi
    fi
    return $rc
}

check_sbt() {
    # A NEW REPO-READING SPEC NEEDS ITS LINT-REGISTRY ROW (Tool self-tests #158, #166: two deploy specs landed rowless,
    # so no push ever ran them, and lint-registry-test.sh -- run only when a script changes -- saw it on main after).
    local unregistered spec
    unregistered="$("$(dirname "${BASH_SOURCE[0]}")/lint-registry-missing")" || return 1
    if [ -n "$unregistered" ]; then
        for spec in $unregistered; do
            warn "$spec has no lint-registry row: add one to scripts/hooks/lint-registry.tsv (its header has the format)"
        done
        return 1
    fi
    # ...AND ITS ROW SELECTS IT FOR EVERY PATH IT READS (Tool self-tests #194: a row missed two test/resources files its
    # spec reads, seen on main only). A push of the registry or its readers runs the reads check over every row (~8 s);
    # a push of specs alone, over theirs (a second).
    local misses line only=()
    if grep -qE '(/src/test/scala/.*Spec\.scala|^scripts/hooks/lint-registry\.tsv)$' <<< "$changed" \
        && [ -f scripts/ci/lint_registry_reads.py ]; then
        if ! grep -qE '^scripts/(hooks/lint-registry\.tsv|hooks/pre-push|ci/lint_registry_reads\.py)$' <<< "$changed"; then
            only=(--only)
            while IFS= read -r line; do only+=("$line"); done < <(printf '%s\n' "$changed" \
                | sed -nE 's|^([^/]+)/src/test/scala/(.*Spec)\.scala$|\1:\2|p' | tr / .)
        fi
        misses="$(python3 scripts/ci/lint_registry_reads.py ${only[@]+"${only[@]}"})" || return 1
        if [ -n "$misses" ]; then
            while IFS=$'\t' read -r spec line; do
                warn "$spec reads $line, which its lint-registry row does not select: add the path's glob to its row"
            done <<< "$misses"
            return 1
        fi
    fi
    need_jvm sbt || return 1
    local compiles
    # shellcheck disable=SC2207 # task names carry no spaces
    compiles=($(printf '%s\n' "$changed" | compile_plan))
    local lints module tests=() gitops_stale=0
    # The specs reading the GitOps manifests join the lints once infra/bin/fetch-gitops has put them in this checkout
    # (from GitHub). The fetch failing BLOCKS the push: the checkout left behind is stale, and the local clone
    # the script once fell back to went stale with GitHub (2026-10-19) -- a spec then failed on a probe movies-gitops
    # 24a5162 had already fixed. The specs needing them stay out of this run; the rest still run, for their verdicts.
    if printf '%s\n' "$changed" | reads_gitops && ! skipped lintspecs && [ -x infra/bin/fetch-gitops ]; then
        if KINOWO_GITOPS_DEST="$PWD/infra/kubernetes" bounded "${PREPUSH_GITOPS_SECONDS:-90}" infra/bin/fetch-gitops > "$tmp/fetch-gitops.log" 2>&1; then
            export PREPUSH_GITOPS=1
        else
            gitops_stale=1
            sed 's/^/    /' "$tmp/fetch-gitops.log" | tail -8 >&2
            warn "GitOps manifests STALE: infra/bin/fetch-gitops could not fetch movies-gitops main, so the push is BLOCKED. Fix: the network to github.com, then push again (or PREPUSH_SKIP=lintspecs, named in your report)."
        fi
    fi
    lints="$(printf '%s\n' "$changed" | lint_plan)"
    # a module none of whose rows the push selects runs none: a bare `testOnly` would run its every test
    local module_lints
    for module in http common scrapers repochecks worker web; do
        module_lints="$(printf '%s\n' "$lints" | sed -n "s/^$module://p" | tr '\n' ' ' | sed 's/ $//')"
        [ -z "$module_lints" ] || tests+=("$module/Test/testOnly $module_lints")
    done
    # the basic tests (local-tests.txt's `basic sbt` lines) ride the same run, after the compiles and lints; --fast-only:
    # the `fast` set instead
    local set=basic
    [ -n "$fast_only" ] && set=fast
    while IFS= read -r line; do [ -n "$line" ] && tests+=("$line"); done < <(local_test_lines "$set" sbt | without_unfetched_gitops)
    if [ -n "$verify_only" ]; then
        # THE COMBINED TREE'S UNIT TESTS, NARROWED TO WHAT THE CHANGE REACHES (TEST-IMPACT SELECTION, as the identity
        # area's): the worker's whole rest row cost every worker-touching verification ~70-90 s for the few specs the
        # change can reach. Through the kept server only (one more call to the warm compiler that runs the check); a
        # cold `sbt -batch` check, or no answer, runs every touched module's unit tests, as before. The selection also
        # adds, in ANY module, the tests a test-side reader of a changed file reaches (its `READS` lines: the worker's
        # source lints over a scrapers change, through ScalaSourceScan's `scrapers/src/main`), and leaves out the lint
        # specs this run already runs, so none runs twice.
        printf '%s\n' "$changed" | unit_plan > "$tmp/unit.plan"
        unit_universe > "$tmp/unit.universe"
        printf '%s\n' "$lints" > "$tmp/unit.lints"
        local widen=""
        [ -s "$tmp/unit.plan" ] && widen=1
        if [ -s "$tmp/unit.plan" ] && [ "$sbt_client" = 1 ] && test_impact unit > "$tmp/unit.select.log" 2>&1 \
                && python3 scripts/ci/identity_impact.py plan --impact "$tmp/unit.impact" --reads "$tmp/unit.universe" \
                    --except "$tmp/unit.lints" < "$tmp/unit.plan" > "$tmp/unit.narrowed"; then
            log "verify: the unit tests the combined change reaches: $(grep -c . "$tmp/unit.narrowed" | tr -d ' ') sbt line(s)$(grep -m1 '^ALL' "$tmp/unit.impact" | sed 's/^ALL/, every one:/')" >&2
            mv "$tmp/unit.narrowed" "$tmp/unit.plan"
            grep -q '^ALL' "$tmp/unit.impact" || widen=""
        elif [ -s "$tmp/unit.plan" ] && [ "$sbt_client" = 1 ]; then
            warn "verify: no test-impact selection ($(tail -1 "$tmp/unit.select.log")) -- every touched module's unit tests"
        fi
        # no selection naming the change's readers (ALL, cold, no answer): every module's source-walking lints join
        if [ -n "$widen" ]; then
            source_lint_lines "$lints" < "$tmp/unit.plan" > "$tmp/unit.sourcelints"
            log "verify: no selection names the change's readers -- every module's source lints join ($(grep -c . "$tmp/unit.sourcelints" | tr -d ' ') sbt line(s))" >&2
            cat "$tmp/unit.sourcelints" >> "$tmp/unit.plan"
        fi
        while IFS= read -r line; do [ -n "$line" ] && tests+=("$line"); done < <(without_unfetched_gitops < "$tmp/unit.plan")
    fi
    local coupling=""
    if [ -n "$(printf '%s\n' "$changed" | coupling_paths)" ] && [ -f coupling.sbt ]; then
        if skipped coupling; then warn "coupling SKIPPED (PREPUSH_SKIP)"
        else coupling=1; rm -f "$tmp/coupling.rows" "$tmp/coupling.edges" "$tmp/coupling.fanouts" "$tmp/coupling.collaborators"
            tests+=("couplingReport $tmp/coupling.rows $tmp/coupling.md $tmp/coupling.edges $tmp/coupling.fanouts $tmp/coupling.collaborators"); fi
    fi
    local quality=""
    if [ -n "$(printf '%s\n' "$changed" | quality_paths)" ] && [ -d quality ]; then
        if skipped quality; then warn "quality SKIPPED (PREPUSH_SKIP)"
        else quality=1; rm -f "$tmp/quality.rows"; tests+=("quality/runMain quality.QualityReport --root $PWD --rows $tmp/quality.rows"); fi
    fi
    local run=(sbt -batch -Dsbt.server.forcestart=false ${compiles[@]+"${compiles[@]}"} "${tests[@]}")
    if [ "$sbt_client" = 1 ]; then
        local line
        line="$(printf '%s; ' ${compiles[@]+"${compiles[@]}"} "${tests[@]}")"
        # through scripts/sbt-warm, as any call to the kept server: a bare `sbt --client` held no busy lock and kept no
        # last-used mark fresh, so the server's keeper, seeing it idle, could stop it mid-check (2026-10-19)
        run=("$root/scripts/sbt-warm" "${line%; }")
    fi
    "${run[@]}" > "$tmp/sbt.log" 2>&1 \
        || { failure_summary "$tmp/sbt.log" >&2; warn "full log: $tmp/sbt.log"; return 1; }
    if [ -n "$coupling" ]; then
        local args=() r
        need sbt python3 "install Python 3 (brew install python)" || return 1
        for r in "${ranges[@]}"; do args+=(--range "$r"); done
        [ -s "$tmp/coupling.rows" ] || { warn "coupling: sbt couplingReport wrote no rows (full log: $tmp/sbt.log)"; return 1; }
        python3 scripts/ci/coupling_ratchet.py check --current "$tmp/coupling.rows" --edges "$tmp/coupling.edges" \
            --fanouts "$tmp/coupling.fanouts" --collaborators "$tmp/coupling.collaborators" ${args[@]+"${args[@]}"} >&2 || return 1
    fi
    if [ -n "$quality" ]; then
        local qargs=() r
        need sbt python3 "install Python 3 (brew install python)" || return 1
        for r in "${ranges[@]}"; do qargs+=(--range "$r"); done
        [ -s "$tmp/quality.rows" ] || { warn "quality: quality/runMain quality.QualityReport wrote no rows (full log: $tmp/sbt.log)"; return 1; }
        python3 scripts/ci/quality_ratchet.py check --current "$tmp/quality.rows" ${qargs[@]+"${qargs[@]}"} >&2 || return 1
        python3 scripts/design-rules/naming_lint.py check --languages scala ${qargs[@]+"${qargs[@]}"} >&2 || return 1
        python3 scripts/design-rules/design_check.py check --languages scala ${qargs[@]+"${qargs[@]}"} >&2 || return 1
    fi
    [ "$gitops_stale" = 0 ]
}

# The commands of <set> of <kind> (sbt|sh|first) in the CHECKED tree's local-tests.txt, one per line.
local_test_lines() { # <set> <kind>
    [ -f scripts/hooks/local-tests.txt ] || return 0
    sed -nE "s/^$1[[:space:]]+$2[[:space:]]+//p" scripts/hooks/local-tests.txt
}
# An area's local tests: its first lines (each a fast check whose failure names everything at once: it fails the area
# there, nothing else run; the identity area's after its test-impact selection, none when it selected nothing), its sbt
# lines in ONE scripts/sbt-warm call (the checkout's kept server: warm, and the one
# compiler over its target/), then its sh lines. A failure shows the failing specs; the full log stays.
# THE IDENTITY PLAN ALONE: PREPUSH_IDENTITY_PLAN=<file> makes the identity area write the sbt lines its TEST-IMPACT
# SELECTION picked (a `# ` line first: the selection's summary, or why there was none and every identity test is the
# plan) and run nothing -- no first line, no spec. scripts/identity-impact-check's `hook` mode reads it from a detached
# checkout of its own, as a landing check's tree is (2026-11-19: tracebacks of a missing identity.impact in a landing
# check's failure dump, which were the hook self-test's stub runs, not the check's selection).
run_local_tests() { # <set>
    local cmds=() line rc=0 sh_lines=1 plan_only=""
    [ "$1" != identity ] || plan_only="${PREPUSH_IDENTITY_PLAN:-}"
    need_jvm "$1" || return 1
    while IFS= read -r line; do [ -n "$line" ] && cmds+=("$line"); done < <(local_test_lines "$1" sbt)
    if [ "$1" = identity ] && [ "${#cmds[@]}" -gt 0 ]; then
        local selected=()
        local said
        if select_identity_tests "${cmds[@]}" > "$tmp/identity.plan" 2> "$tmp/identity.select.log"; then
            while IFS= read -r line; do [ -n "$line" ] && selected+=("$line"); done < "$tmp/identity.plan"
            said="$(tr '\n' ';' < "$tmp/identity.summary" | sed 's/;$//; s/;/; /')"
            log "identity: $said"
            cmds=(${selected[@]+"${selected[@]}"})
        else
            said="no test-impact selection ($(tail -1 "$tmp/identity.select.log")) -- every identity test"
            warn "identity: $said"
        fi
        if [ -n "$plan_only" ]; then
            { printf '# %s\n' "$said"; [ "${#cmds[@]}" -eq 0 ] || printf '%s\n' "${cmds[@]}"; } > "$plan_only"
            log "identity: the plan alone, to $plan_only (PREPUSH_IDENTITY_PLAN): nothing run"
            return 0
        fi
        if [ "${#cmds[@]}" -eq 0 ]; then log "identity: the change reaches no identity spec"; return 0; fi
    fi
    # the first lines: once, never sharded (shard 1 runs them, as the sh lines); the identity area's after its selection,
    # and only when that reached a spec (a fixtures tool no identity spec reads ran the slice coverage for nothing)
    if [ -z "${PREPUSH_IDENTITY_SHARD:-}" ] || [ "$1" != identity ] || [ "${PREPUSH_IDENTITY_SHARD%%/*}" = 1 ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            if ! bash -c "$line" < /dev/null > "$tmp/$1.first.log" 2>&1; then
                cat "$tmp/$1.first.log" >&2
                warn "$1: \`$line\` failed (full log: $tmp/$1.first.log)"
                return 1
            fi
            grep -m1 -E '^[a-z-]+: [0-9]+ ' "$tmp/$1.first.log" || true
        done < <(local_test_lines "$1" first)
    fi
    # THE IDENTITY SHARDS (precommit-check.yml's `check (identity k/n)` jobs): PREPUSH_IDENTITY_SHARD=<k>/<n> runs shard k of
    # the selected lines (scripts/ci/shard_tests.py: every class in exactly one shard, under its own line's command and
    # arguments; a line naming no class outright whole in one). The n jobs together run what one job ran.
    if [ "$1" = identity ] && [ -n "${PREPUSH_IDENTITY_SHARD:-}" ] && [ "${#cmds[@]}" -gt 0 ]; then
        local sharded=()
        # balanced on scripts/ci/shard-weights-identity.tsv (absent: every class weighs the same)
        printf '%s\n' "${cmds[@]}" | python3 scripts/ci/shard_tests.py --shard "$PREPUSH_IDENTITY_SHARD" --weights identity \
            > "$tmp/identity.shard" \
            || { warn "identity: shard $PREPUSH_IDENTITY_SHARD could not be cut"; return 1; }
        while IFS= read -r line; do [ -n "$line" ] && sharded+=("$line"); done < "$tmp/identity.shard"
        log "identity: shard $PREPUSH_IDENTITY_SHARD, $(wc -w < "$tmp/identity.shard" | tr -d ' ') words of ${#cmds[@]} line(s)"
        cmds=(${sharded[@]+"${sharded[@]}"})
        # the area's sh lines are no classes to split: shard 1 runs them
        [ "${PREPUSH_IDENTITY_SHARD%%/*}" = 1 ] || sh_lines=0
        if [ "${#cmds[@]}" -eq 0 ] && [ "$sh_lines" = 0 ]; then log "identity: nothing in shard $PREPUSH_IDENTITY_SHARD"; return 0; fi
    fi
    # THE POPULATION WALK AGAINST THE BASE (PopulationMonotonicitySpec's CandidatesKey, scripts/ci/population-walk-diff):
    # every identity testOnly line names the candidates directory, so a slice whose flips differ from the known rows is
    # judged against the change's merge base after the run -- a flip main has too passes, one the change adds refuses
    # the push naming the listing, slice and chain. No candidate (the usual case): nothing more runs.
    # THE WALK'S ROWS KEPT (PopulationMonotonicitySpec's CacheKey, sbt's identityWalkDigest): the walk's rows of a slice
    # are kept per digest of every path the walk's code and data are (the slices apart: each keyed by its own files)
    # under $KINOWO_POPULATION_WALK_ROWS (default $KINOWO_IDENTITY_CACHE/population-walk-rows)/<digest>/ -- a change that leaves the walk's code and data as a
    # walked commit had them walks only the slices whose files differ; the rows are judged as walked ones, every run.
    # No digest (a working tree with changes, the task failed): every slice walks. The landing check keeps the directory
    # between runs (precommit-check.yml's actions/cache); a digest unused for 5 days is dropped.
    local popwalk="" walkcache=""
    if [ "$1" = identity ] && [ "${#cmds[@]}" -gt 0 ]; then
        popwalk="$tmp/population-walk"
        walkcache="$(population_walk_rows identity)"
        local i extra="-Didentity.population.candidates=$popwalk${walkcache:+ -Didentity.population.cache=$walkcache}"
        for i in "${!cmds[@]}"; do
            case "${cmds[$i]}" in
                *testOnly\ *\ --\ *) cmds[$i]="${cmds[$i]} $extra" ;;
                *testOnly\ *) cmds[$i]="${cmds[$i]} -- $extra" ;;
            esac
        done
    fi
    if [ "${#cmds[@]}" -gt 0 ]; then
        scripts/sbt-warm "${cmds[@]}" > "$tmp/$1.log" 2>&1 || rc=1
    fi
    # judged even when another spec failed: the refusal names its listings beside the other failures
    if [ -n "$popwalk" ] && [ -d "$popwalk" ]; then
        local walk_base
        walk_base="$(git merge-base "$base_sha" "$head_sha" 2>/dev/null || echo "$base_sha")"
        scripts/ci/population-walk-diff "$popwalk" "$walk_base" >> "$tmp/$1.log" 2>&1 || rc=1
        grep '^population walk: ' "$tmp/$1.log" | tail -40 >&2
    fi
    if [ "$rc" = 0 ] && [ "$sh_lines" = 1 ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            bash -c "$line" < /dev/null >> "$tmp/$1.log" 2>&1 || { rc=1; break; }
        done < <(local_test_lines "$1" sh)
    fi
    if [ "$rc" != 0 ]; then
        failure_summary "$tmp/$1.log" >&2
        warn "full log: $tmp/$1.log"
        return 1
    fi
    grep -E 'Tests: succeeded|All tests passed|[0-9]+ passed' "$tmp/$1.log" | tail -3
}
# The walk's rows kept (THE WALK'S ROWS KEPT, above): <the rows root>/<identityWalkDigest>, printed (made, fresh); nothing
# when sbt gives no digest (every slice walks); what it says goes to stderr. Asked once a run (its answer kept in $tmp): the identity area and the
# flipbacklog check share it, so a slice the change brings is walked once between them, not by each (~3-10 s a slice).
population_walk_rows() { # <the check asking>
    local rows_root="${KINOWO_POPULATION_WALK_ROWS:-${KINOWO_IDENTITY_CACHE:-$HOME/.cache/kinowo-identity}/population-walk-rows}" digest=""
    if [ ! -f "$tmp/walk-digest.asked" ]; then
        scripts/sbt-warm "identityWalkDigest $tmp/identity.walk-digest" > "$tmp/identity.walk-digest.log" 2>&1 \
            || rm -f "$tmp/identity.walk-digest"
        touch "$tmp/walk-digest.asked"
    fi
    [ -f "$tmp/identity.walk-digest" ] && digest="$(tr -cd '0-9a-f' < "$tmp/identity.walk-digest")"
    if [ "${#digest}" != 64 ]; then
        log "$1: no population walk digest ($(tail -1 "$tmp/identity.walk-digest.log" 2> /dev/null)): every slice walks" >&2
        return 0
    fi
    mkdir -p "$rows_root/$digest" && touch "$rows_root/$digest"
    find "$rows_root" -mindepth 1 -maxdepth 1 -type d -mtime +5 -exec rm -rf {} + 2> /dev/null
    log "$1: the population walk's rows kept under digest ${digest:0:12} ($(find "$rows_root/$digest" -name '*.tsv' | wc -l | tr -d ' ') slice(s) kept)" >&2
    echo "$rows_root/$digest"
}
# TEST-IMPACT SELECTION (scripts/ci/identity_impact.py, project/TestImpact.scala): of the identity set's sbt lines, only
# the specs the pushed change can reach (the compiler's dependency record; the data's readers by name), each once, the
# country-scoped ones (tools.CountryScope) over the countries it can reach. Every path the range changed counts,
# deletions too (a deleted source selects every test); one range only -- several, and every test runs. Prints the sbt
# lines to run (none: no spec reached), or fails (every test runs).
# test_impact <name>: the range's changed paths to $tmp/<name>.changed and the classes they reach (identityImpact's
# `<module> <class>` lines, or `ALL <why>`) to $tmp/<name>.impact, through the checkout's kept sbt server; says why not.
test_impact() {
    local mb
    [ "${#ranges[@]}" -eq 1 ] || { echo "the push holds ${#ranges[@]} ranges"; return 1; }
    mb="$(git merge-base "$base_sha" "$head_sha")" || { echo "no merge base of ${base_sha:0:9} and ${head_sha:0:9}"; return 1; }
    git diff --name-only --no-renames "$mb" "$head_sha" > "$tmp/$1.changed" || return 1
    scripts/sbt-warm "identityImpact $tmp/$1.changed $tmp/$1.impact" > "$tmp/$1.impact.log" 2>&1 \
        || { tail -20 "$tmp/$1.impact.log"; echo "sbt identityImpact failed"; return 1; }
    # an exit 0 that wrote nothing (a kept server answering for a command it never ran) is no answer, said as one
    [ -f "$tmp/$1.impact" ] || { tail -20 "$tmp/$1.impact.log"; echo "sbt identityImpact wrote no answer"; return 1; }
}
select_identity_tests() { # <the set's sbt lines>...
    local mb countries every_test=()
    test_impact identity >&2 || return 1 # its why on stderr: stdout is the plan
    [ ! -s "$tmp/identity.impact.tests" ] || every_test=(--every-test "$tmp/identity.impact.tests")
    mb="$(git merge-base "$base_sha" "$head_sha")" || return 1
    countries="$(python3 scripts/ci/identity_impact.py countries "$mb" "$head_sha" < "$tmp/identity.changed")" \
        || { echo "the countries could not be read" >&2; return 1; }
    # ALL (every test) runs each class once and by name (--every-test: identityImpact's list of every test class), so
    # identity's specs no longer run twice and the landing check's shards split it by class
    printf '%s\n' "$@" | python3 scripts/ci/identity_impact.py plan --impact "$tmp/identity.impact" --countries "$countries" \
        ${every_test[@]+"${every_test[@]}"} || { echo "no plan" >&2; return 1; }
    if grep -q '^ALL' "$tmp/identity.impact"; then
        echo "every identity spec: $(grep -m1 '^ALL' "$tmp/identity.impact" | cut -c5-)"
    else echo "the specs the change reaches ($(grep -c . "$tmp/identity.impact") test classes in every module)"
    fi > "$tmp/identity.summary"
    echo "countries in scope: ${countries:-none}" >> "$tmp/identity.summary"
}
check_identity() { run_local_tests identity; }
# THE IDENTITY DRIFT CHECK: each claimed red's failed takes-drift rows, on CI (scripts/identity-drift-ci --for-red). 1 blocks; 2
# (the run could not be made: CI unreachable, no token) warns and passes -- a fix is not held hostage to an outage, and
# main's own run still judges it.
# identity-drift-ci <log> <args...>: its whole output kept in <log>, each poll's progress line shown as it comes -- a run
# queued behind a saturated ci-runner polls for many minutes, and a hook silent that long is ended by `agentctl land` as
# stalled (#1041) -- and its exit status returned.
drift_ci() {
    local log=$1; shift
    { scripts/identity-drift-ci "$@" 2>&1; echo "drift-ci-exit:$?"; } | tee "$log" \
        | { grep --line-buffered -E '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row' >&2 || true; }
    return "$(sed -n 's/^drift-ci-exit://p' "$log" | tail -1)"
}
check_identitydrift() {
    local run rc=0 r
    if [ "${GITHUB_ACTIONS:-}" = true ]; then
        warn "drift: not run from a CI job (it pushes a measure/ branch and dispatches from the laptop): main's run judges ${drift_reds:+Fixes-Red: $drift_reds}${drift_birth:+ the birth of a check}"
        return 0
    fi
    if [ -n "$drift_birth" ]; then
        log "drift: a check's birth or tightening ($drift_birth): every drift row at ${head_sha:0:9}, against main's newest run"
        drift_ci "$tmp/drift-birth.log" --head "$head_sha" --against main; r=$?
        grep -vE '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row|^drift-ci-exit:' "$tmp/drift-birth.log" | tail -40 >&2
        case $r in
            0) ;;
            1) warn "drift: the check finds what main's run does not -- a new or tightened check lands green: put what it finds at birth on its allow-list, TEMPORARY with an owner and when it goes, under New-Check: (full log: $tmp/drift-birth.log)"; rc=1 ;;
            *) warn "drift: no verdict on the check's birth (exit $r): not held against the push; main's run judges it" ;;
        esac
    fi
    for run in $drift_reds; do
        log "drift: the takes-drift rows run $run failed, at ${head_sha:0:9}, drift-only on ci-runner (scripts/identity-drift-ci)"
        drift_ci "$tmp/drift-$run.log" --head "$head_sha" --for-red "$run"; r=$?
        grep -vE '^identity-drift-ci: run [0-9]+: [0-9]+/[0-9]+ drift row|^drift-ci-exit:' "$tmp/drift-$run.log" | tail -40 >&2
        case $r in
            0) ;;
            1) warn "drift: Fixes-Red: $run does not fix its drift rows at ${head_sha:0:9} (full log: $tmp/drift-$run.log)"; rc=1 ;;
            *) warn "drift: no verdict for Fixes-Red: $run (exit $r): not held against the push; main's run judges it" ;;
        esac
    done
    return $rc
}
# THE FLIP BACKLOG IS COMPLETE (the header's `flipbacklog`): the slices the change brings walked, judged as main's spec
# judges them
check_flipbacklog() {
    local mb s dirs=()
    need flipbacklog python3 "install Python 3 (brew install python)" || return 1
    mb="$(git merge-base "$base_sha" "$head_sha")" || { warn "flipbacklog: no merge base of ${base_sha:0:9} and ${head_sha:0:9}"; return 1; }
    python3 scripts/ci/population_walk_diff.py changed-slices "$mb" > "$tmp/flipbacklog.slices" \
        || { warn "flipbacklog: the slices the change brings could not be read"; return 1; }
    while IFS= read -r s; do [ -n "$s" ] && dirs+=("test/resources/fixtures/$s"); done < "$tmp/flipbacklog.slices"
    if [ "${#dirs[@]}" -eq 0 ]; then log "flipbacklog: no slice the change brings"; return 0; fi
    need_jvm flipbacklog || return 1
    local walkcache
    walkcache="$(population_walk_rows flipbacklog)"
    log "flipbacklog: ${#dirs[@]} slice(s) the change brings, walked (PopulationMonotonicitySpec)"
    if ! scripts/sbt-warm "worker/Test/runMain services.identity.PopulationMonotonicitySpec ${walkcache:+--cache $walkcache }${dirs[*]}" > "$tmp/flipbacklog.log" 2>&1; then
        tail -n 20 "$tmp/flipbacklog.log" >&2; warn "flipbacklog: the walk did not run (full log: $tmp/flipbacklog.log)"; return 1
    fi
    sed -nE 's/^\[info\] //; /^(# )?(drift|identity)-slices\//p' "$tmp/flipbacklog.log" > "$tmp/flipbacklog.walk"
    python3 scripts/ci/population_walk_diff.py judge-walk "$tmp/flipbacklog.walk"
}

# THE HEAVY ROWS (the header): Main's own commands, with Main's row filter, against the job's MongoDB. They ride the
# landing check's rest job (2026-11-18: a job of their own waited up to 17 min for a slot), so the MongoDB is named to
# them alone, $PREPUSH_HEAVY_MONGODB_URI / _DB: the rest's other checks (the basic e2e specs among them) run as Main's
# unit rows do, with none ($MONGODB_URI is still read, for a caller from before).
heavy_row() { # <check> <sbt command> [env...]
    local check=$1 cmd=$2; shift 2
    local uri="${PREPUSH_HEAVY_MONGODB_URI:-${MONGODB_URI:-}}" db="${PREPUSH_HEAVY_MONGODB_DB:-${MONGODB_DB:-}}"
    need_jvm "$check" || return 1
    [ -n "$uri" ] || [ "${check#e2e}" != "$check" ] \
        || { warn "$check: no \$PREPUSH_HEAVY_MONGODB_URI -- the integration specs need a MongoDB replica set (scripts/ci/start-mongo-replset.sh)"; return 1; }
    # the e2e rows run as Main's do, with no MongoDB named; the integration rows against the job's
    local mongo=()
    case "$check" in
        e2e*) mongo=(-u MONGODB_URI -u MONGODB_DB) ;;
        *) mongo=(MONGODB_URI="$uri"); [ -z "$db" ] || mongo+=(MONGODB_DB="$db") ;;
    esac
    env "${mongo[@]}" "$@" sbt -batch "$cmd" > "$tmp/$check.log" 2>&1 \
        || { grep -E '\*\*\* FAILED|\[error\]|Failed tests:|TEST FAILED' "$tmp/$check.log" | head -80 >&2; warn "full log: $tmp/$check.log"; return 1; }
    grep -E 'Tests: succeeded|All tests passed|Passed: Total' "$tmp/$check.log" | tail -3 || true
}
# the rest row's deploy specs read the GitOps manifests: fetched here when nothing put them in place (the sbt check's
# lint plan fetches them only for a change reading them)
check_itrest() {
    if [ ! -d infra/kubernetes ] && [ -x infra/bin/fetch-gitops ]; then
        KINOWO_GITOPS_DEST="$PWD/infra/kubernetes" bounded "${PREPUSH_GITOPS_SECONDS:-90}" infra/bin/fetch-gitops > "$tmp/fetch-gitops.log" 2>&1 \
            || { tail -8 "$tmp/fetch-gitops.log" >&2; warn "itrest: infra/bin/fetch-gitops could not fetch the GitOps manifests the deploy specs read"; return 1; }
    fi
    heavy_row itrest itAll IT_ROW=rest
}
check_itidentity() { heavy_row itidentity itAll IT_ROW=identity; }
check_e2ecorpus() { heavy_row e2ecorpus e2eCorpus; }

