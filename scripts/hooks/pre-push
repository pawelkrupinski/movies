#!/usr/bin/env bash
# PRE-PUSH: the checks that fail CI in seconds, run here in seconds, for what this push changes.
#
# About one CI failure in nine over four weeks (2026-08-27 → 09-24) was a lint or a generated
# artefact: nothing a ten-minute pipeline needed to discover. Each check below runs only when the
# push touches the paths it guards, so a typical push costs a few seconds and a Scala push well
# under a minute on a warm build:
#
#   `eslint`      web/src/main/assets/js/**, web/src/page/resources/**/*.js, eslint.config.js, eslint-rules/** (the repo's own rules), package*.json + page-tests-playwright/tests/*.ts + lint-flake-patterns*.mjs (the page-spec flake lint)
#   `drift`       the generated roster chain (scripts/ci/generated-artefacts-drift.sh)
#   `snapshot`    the read-model snapshot's input stamp (scripts/read-model-snapshot-inputs.sh)
#   `sbt`         NoWallClockInTestsSpec, NoWallClockInClientsSpec, the two Grafana metric-coverage
#                 specs and NoSilencedGhCurlSpec, in ONE sbt run, on any Scala or dashboard change or any
#                 script or workflow under scripts/, .github/ or infra/ -- plus, on any change under scripts/,
#                 .github/, .claude/, CLAUDE.md, build.sbt, project/ or */src/test|it/ (`--lint-plan`, ~30 s warm),
#                 every other repo-reading lint spec: all deploy/ specs and the No*/*Lint* source lints, bar the
#                 ones listed at lint_plan that boot a server -- those reading the GitOps manifests too, once
#                 infra/bin/fetch-gitops has put them in place (Forgejo, else GitHub; neither reachable: the push
#                 BLOCKED, never checked against stale manifests); `lintspecs` skips just those -- and,
#                 ahead of them in that same run, the Test/It/Page configs of every module the push
#                 touches and every module depending on one (`sbt compile` skips them all: f20a6b5dd
#                 broke worker/It/compile and only CI saw it). `--compile-plan` prints that list.
#   `dashboards`  infra/test/test_dashboards.py — the Grafana dashboards' structure and queries,
#                 the CI check `Stage NixOS closures` runs (well under a second)
#   `scripttests` scripts/run-script-tests --changed <base>, on any change under the script-test roots (scripts/,
#                 .github/scripts|actions, android/scripts, ios/scripts, infra/bin, data): only the self-tests whose test,
#                 tool, or a file they name the push changed -- this hook's own test among them (it names
#                 install-hooks.sh and hooks-path.sh), since a new check changes what the hook plans; on a Mac, run
#                 again under its /bin/bash 3.2 (`--bash /bin/bash`), the bash the tools promise to run on; and,
#                 Docker running, beside them on Linux (`--linux`, CI's ubuntu-26.04; PREPUSH_SKIP=linux skips it)
#   `actionlint`  changed workflow files (with shellcheck over their `run:` blocks), and changed
#                 composite actions' `run:` blocks (scripts/ci/shellcheck-action-runs.sh)
#   `shellcheck`  changed *.sh and hook scripts — fails only on warnings the push ADDS, so a
#                 file that was already noisy can still be edited
#   `oldrefs`     scripts/identity-slice-old-ref-test.sh, on a change to a file identity-slice or title-trace drops into
#                 the refs they decide under (each tool's TOOL_FILES, read from the tool): each tool compiles into its
#                 oldest supported ref (the floor that test names), in the tree kept under ~/.cache/kinowo-identity/refs --
#                 an incremental compile once laid out. Only CI's integration job ran it, and 0ab79600b broke
#                 `identity-slice --compiles c2974e3aa` unseen while GitHub was down (fixed in 4eded3e81)
#   `ios`         scripts/ios-compile-check.sh (app target + XCUITests, Mac and Linux SwiftPM; fails on a concurrency
#                 diagnostic) on ios/** — this one
#                 is minutes, not seconds, and only runs for iOS pushes
#   `judgements`  scripts/ci/identity_judgements_lint.py on identity-judgements.tsv, the expected
#                 matches and hard clusters: the judgements are well formed and the files leaning on
#                 them agree. A judgements change is also read against the takes the newest Identity
#                 model convergence legs served (their diagnostics artifacts, cached per run): a take
#                 the push newly calls wrong that no known-wrong row tolerates fails here, not in the
#                 leg after the push (911d8f486)
#
# WHAT IS CHECKED is the pushed commit's tree: in place when the checkout is that tree, else in a
# temporary worktree of it (cold, so an sbt check there takes minutes, not seconds). The same
# temporary worktree is used when an sbt check would share target/ with a live sbt in the
# checkout (e.g. the DevPanel's `sbt web/run`): two compilers over one classes dir race.
#
# RED BUILDS GATE EVERY PUSH TO MAIN. Before any path check: when the newest COMPLETED run on main of a
# gating workflow (Main, Identity model convergence, Verify scrape recording; a cancelled run says nothing
# and is passed over) is red, the push lands only as a fix for it — every pushed commit carries a
# `Fixes-Red: <run id>` trailer naming one of the red runs — except a commit touching no production path
# (*/src/main/, conf/, build.sbt, project/, infra/nix/, infra/kubernetes/, Dockerfile): tools — scripts, docs,
# skills, tests, fixtures, CI tooling — land while red (user, 2026-10-14). On 2026-10-13/14, 50 of 96 identity commits
# landed while Identity model convergence was red: 3f11e2cc3's wrong switches hid behind a DE red for six
# hours, and three gates and label batches each turned it red again. One `gh run list` a workflow, each
# bounded; gh UNREACHABLE is said out loud and does not block (it is no evidence of a red); gh, curl or jq NOT
# INSTALLED blocks, as any missing tool does (BYPASS below). A push to a
# Forgejo remote (ssh://forgejo-git/…, since GitHub suspended the account 2026-10-19) reads Forgejo's actions runs API
# instead, by curl, with $FORGEJO_API_TOKEN or the token in the `movies` vault when it is already unlocked; without
# one the gate is skipped, said in one line (the repository is private: anonymous reads answer 404).
# Bypass: PREPUSH_SKIP=redgate. NOT gating: the Identity findings report (a recording's own suspects and
# corpus-shape findings, red after 3 days untriaged) -- no push makes or mends a recording's data.
#
# REUSE: a push of a tree that already passed -- same tree, base, changed paths, hook, red-gate state and PREPUSH_SKIP --
# skips the path checks (THE REUSE, below; the key kept in ~/.cache/kinowo-prepush). Anything different runs them all.
# PREPUSH_NO_REUSE=1 runs them regardless.
#
# BYPASS: `git push --no-verify` skips the whole hook. `PREPUSH_SKIP="ios sbt" git push` skips
# the named checks.
#
# A MISSING LOCAL TOOL BLOCKS THE PUSH, saying how to fix it -- never a skip (user, 2026-10-21: an agent's push, sbt off
# its PATH, skipped the sbt check and landed unchecked). sbt and a java that runs (sbt, oldrefs), shellcheck,
# actionlint, npm (eslint), python3 (drift, dashboards, judgements) and the drift's timezonefinder, gh (judgements; the
# red gate on a GitHub push), curl and jq (the red gate on a Forgejo push). What stays a WARNING is what lies outside
# this machine's install: an external service unreachable (the red gate's Forgejo/GitHub API, a served-takes
# download), no Forgejo token, and a Docker or Xcode that is not RUNNING/selected (scripttests --linux, ios: CI runs
# both). Not the GitOps manifests: their fetch failing BLOCKS (the checkout left behind is stale, and specs passed or
# failed against it; a push needs Forgejo anyway).
#
# INSTALL: scripts/install-hooks.sh (sets core.hooksPath=scripts/hooks, which every worktree of
# this clone shares; the path is relative, so each worktree runs its own checkout's hook).
# An ABSOLUTE path (an IDE rewrote it three times on 2026-10-14) is warned about, and the hook it names
# hands over to the pushing worktree's own copy, so a stale root checkout never judges a worktree's push.
#
# DRY RUN / TEST: `scripts/hooks/pre-push --plan < paths` prints the checks a list of changed
# paths selects, without running them (scripts/hooks/pre-push-test.sh). `--range A..B` runs the
# hook for the commits in A..B (diffed from their merge-base) instead of reading git's stdin.
set -uo pipefail
# git exports GIT_DIR (and, by setup, GIT_INDEX_FILE / GIT_WORK_TREE) for the repository being
# pushed — for a worktree, ITS git dir. Every check inherits them, and in the temporary checkout
# below they would point each `git` back at the pushing worktree's HEAD and index. The hook runs at
# the checkout's root, where git finds the repository on its own: clear them once, for every check.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX

root="$(git rev-parse --show-toplevel)" || exit 1

# ── The PUSHING checkout's own hook runs, whatever core.hooksPath says ──────────────────────────
# core.hooksPath=scripts/hooks is relative: each worktree runs its own checkout's copy. Rewritten to an
# absolute path (three times on 2026-10-14, very likely an IDE's git integration), every worktree's push ran
# the ROOT checkout's copy — an older hook, judging new work by stale checks. So a hook git runs for another
# checkout than its own hands over to that checkout's copy. Once only (PREPUSH_DELEGATED_FROM), and never for
# the dry runs (--plan, --compile-plan, --range), which name the file they mean.
case "${1:-}" in
    --plan|--compile-plan|--range) ;;
    *)
        if [ -z "${PREPUSH_DELEGATED_FROM:-}" ]; then
            hooks_path="$(git config --get core.hooksPath || true)"
            case "$hooks_path" in
                /*|~*) printf '\033[33m! pre-push\033[0m core.hooksPath is absolute (%s): every worktree reaches that one copy — scripts/install-hooks.sh sets it back to the relative scripts/hooks\n' "$hooks_path" >&2 ;;
            esac
            hook_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
            own="$(cd "$root" && pwd -P)/scripts/hooks/pre-push"
            if [ "$(cd "$root" && pwd -P)" != "$hook_root" ] && [ -f "$own" ] && ! [ "$own" -ef "${BASH_SOURCE[0]}" ]; then
                export PREPUSH_DELEGATED_FROM="$hook_root"
                exec bash "$own" "$@"
            fi
        fi ;;
esac
unset PREPUSH_DELEGATED_FROM
# ── end of the hand-over ──
cd "$root" || exit 1

# ── core.hooksPath stays RELATIVE, and this hook proves it did not move it ──────────────────────
# Absolute (an IDE wrote it three times on 2026-10-14, a fourth time with no IDE running, between two pushes), it sends
# every worktree to ONE copy of the hooks. An absolute path that names a worktree of THIS clone's scripts/hooks holds
# only this repository's own hooks, so it is set back to relative here (a foreign directory is left alone). The value
# the hook starts with is then compared at EXIT: a hook that finds it moved while the checks ran says so, names the
# processes that could have done it, and restores it — a writer inside the checks is caught, not guessed at.
hooks_path_now() { git config --local --get core.hooksPath 2>/dev/null || true; }
# shellcheck source=scripts/hooks-path.sh
. "$(dirname "${BASH_SOURCE[0]}")/../hooks-path.sh"
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "${BASH_SOURCE[0]}")/../tool-conventions.sh" # bounded: every gh read below has a deadline
case "$(hooks_path_now)" in
    /*)
        if hooks_path_is_own "$(hooks_path_now)"; then
            printf '\033[33m! pre-push\033[0m core.hooksPath was %s: set back to the relative scripts/hooks\n' "$(hooks_path_now)" >&2
            git config --local core.hooksPath scripts/hooks
        fi ;;
esac
hooks_path_at_start="$(hooks_path_now)"
# The shared root checkout off main or dirty strands every agent's next rebase: said on every push, never blocking it.
root_check="$(dirname "${BASH_SOURCE[0]}")/../root-checkout-check"
root_warning=""
# A plan mode only prints what a push would run: the root checkout's state means nothing to it, and the check's
# `git status` over the whole root is the cost of every plan call -- in a Linux container, where the bind mount's
# stat data never matches the index, a full rehash: pre-push-test.sh's ~20 plan calls ran past its 600 s bound.
case "${1:-}" in --plan|--compile-plan|--lint-plan) root_check="" ;; esac
[ ! -x "$root_check" ] || root_warning="$("$root_check" "$root" 2>&1)"
[ -z "$root_warning" ] || printf '\033[33m! pre-push\033[0m %s\n' "$root_warning" >&2
tree=""
on_exit() {
    local now
    cd "$root" || return # a temporary checkout is about to go; git has to run somewhere that stays
    if [ -n "$tree" ]; then git -C "$root" worktree remove --force "$tree" >/dev/null 2>&1; git -C "$root" worktree prune; fi
    now="$(hooks_path_now)"
    if [ "$now" != "$hooks_path_at_start" ]; then
        printf '\033[31m! pre-push\033[0m core.hooksPath moved from "%s" to "%s" WHILE this hook ran — restoring it. Candidates:\n' "$hooks_path_at_start" "$now" >&2
        ps -axo pid,ppid,command | grep -E 'git( |-)config|install-hooks|hooksPath' | grep -v grep >&2
        if [ -n "$hooks_path_at_start" ]; then git config --local core.hooksPath "$hooks_path_at_start"; else git config --local --unset core.hooksPath; fi
    fi
}
trap on_exit EXIT

Zero=0000000000000000000000000000000000000000

skipped() { case " ${PREPUSH_SKIP:-} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# The files identity-slice and title-trace drop into every ref they decide under: each tool's TOOL_FILES=( … ), read
# from the tool itself, one per line.
tool_files() {
    local tool
    for tool in scripts/identity-slice scripts/title-trace; do
        [ -f "$tool" ] && sed -n '/^TOOL_FILES=(/,/)/{s/^TOOL_FILES=(//;s/).*$//;p;}' "$tool" | tr ' ' '\n'
    done | grep -v '^$' || true
}

# Whether the repo-reading lint specs (`--lint-plan`) read <path>: scripts, workflows, skills, the docs, the build, the
# test, it and page trees, the fixtures.
read_by_lint_specs() { # <path>
    case "$1" in
        scripts/*|.github/*|.claude/*|CLAUDE.md|build.sbt|project/*|*/src/test/*|*/src/it/*|*/src/page/*.scala|worker/src/fixtures/*|testkit/*) return 0 ;;
    esac
    return 1
}

# ── Which checks a set of changed paths selects ─────────────────────────────────────────────────
# One line per path on stdin; prints the selected check names, one per line, in run order.
plan() {
    local eslint=0 drift=0 snapshot=0 sbt=0 dashboards=0 scripttests=0 actionlint=0 shellcheck=0 ios=0 judgements=0 oldrefs=0 path
    local tools
    tools=" $(tool_files | tr '\n' ' ') "
    while IFS= read -r path; do
        case "$path" in
            web/src/main/assets/js/*.js|web/src/page/resources/*.js|eslint.config.js|eslint-rules/*.js|package.json|package-lock.json|page-tests-playwright/tests/*.ts|page-tests-playwright/lint-flake-patterns*.mjs) eslint=1 ;;
        esac
        case "$path" in
            common/src/main/scala/models/*|geodata/src/main/scala/models/*|data/*|android/app/src/main/java/pl/kinowo/model/City.kt|ios/Kinowo/Models/City.swift|scripts/ci/generated-artefacts-drift.sh) drift=1 ;;
        esac
        case "$path" in
            test/resources/fixtures/08-06-2026/*|scripts/read-model-snapshot-inputs.sh) snapshot=1 ;;
        esac
        case "$path" in
            *.scala|*.java|build.sbt|project/*|infra/nix/files/monitoring/grafana/dashboards/*) sbt=1 ;;
        esac
        # What NoSilencedGhCurlSpec reads: a script that silences a gh/curl read failed Main from a push this check never
        # selected (d00c5edf2).
        case "$path" in
            scripts/*.sh|.github/*.sh|.github/*.yml|.github/*.yaml|infra/*.sh|infra/*.yml|infra/*.yaml) sbt=1 ;;
        esac
        # What the repo-reading lint specs `--lint-plan` adds read: scripts, workflows, tests, fixtures, skills, the docs and
        # the build -- each turned Main red from a push this check never selected (2026-10-13..15).
        read_by_lint_specs "$path" && sbt=1
        case "$path" in
            infra/nix/files/monitoring/*|infra/test/test_dashboards.py) dashboards=1 ;;
        esac
        case "$path" in
            scripts/*|.github/scripts/*|.github/actions/*|android/scripts/*|ios/scripts/*|infra/bin/*|data/*) scripttests=1 ;;
        esac
        case "$path" in
            .github/workflows/*.yml|.github/workflows/*.yaml|.github/actions/*/action.yml|.github/actions/*/action.yaml) actionlint=1 ;;
        esac
        case "$path" in
            *.sh|scripts/hooks/*) shellcheck=1 ;;
        esac
        case "$path" in
            ios/*) ios=1 ;;
        esac
        case "$path" in
            test/resources/fixtures/identity-judgements.tsv|test/resources/fixtures/identity-unmatched/*.tsv|\
            test/resources/fixtures/corpus/expected-hard-clusters-*|\
            scripts/ci/identity_judgements*.py|scripts/ci/identity_takes*.py) judgements=1 ;;
        esac
        case "$tools" in *" $path "*) oldrefs=1 ;; esac
    done
    [ $judgements = 1 ] && echo judgements
    [ $eslint = 1 ] && echo eslint
    [ $drift = 1 ] && echo drift
    [ $snapshot = 1 ] && echo snapshot
    [ $dashboards = 1 ] && echo dashboards
    [ $scripttests = 1 ] && echo scripttests
    [ $actionlint = 1 ] && echo actionlint
    [ $shellcheck = 1 ] && echo shellcheck
    [ $sbt = 1 ] && echo sbt
    [ $oldrefs = 1 ] && echo oldrefs
    [ $ios = 1 ] && echo ios
    return 0
}

# ── Which test configs a set of changed paths has to compile ────────────────────────────────────
# One line per path on stdin; prints the sbt compile tasks, one per line, in dependency order. A
# module's own test configs plus those of every module that depends on it (build.sbt's dependsOn):
# geodata → common → identity → testkit → scrapers → worker (test->test on scrapers) → web (page->fixtures) → e2e. The build
# itself touches them all.
compile_plan() {
    local common=0 identity=0 testkit=0 scrapers=0 worker=0 web=0 e2e=0 path
    while IFS= read -r path; do
        case "$path" in
            build.sbt|project/*)  common=1 ;;
            common/*.scala|common/*.java|geodata/*.scala)   common=1 ;;
            identity/*.scala|identity/*.java) identity=1 ;;
            testkit/*.scala|testkit/*.java) testkit=1 ;;
            scrapers/*.scala|scrapers/*.java) scrapers=1 ;;
            # web's Page config compiles against worker's fixtures config (page->fixtures).
            worker/src/fixtures/*)          worker=1; web=1 ;;
            worker/*.scala|worker/*.java)   worker=1 ;;
            web/*.scala|web/*.java)         web=1 ;;
            e2e/*.scala|e2e/*.java)         e2e=1 ;;
        esac
    done
    [ $common = 1 ] && identity=1
    [ $identity = 1 ] && testkit=1
    [ $testkit = 1 ] && scrapers=1
    [ $scrapers = 1 ] && worker=1
    [ $worker = 1 ] && e2e=1
    [ $web = 1 ] && e2e=1
    [ $testkit = 1 ] && web=1
    [ $common = 1 ] && echo common/Test/compile
    [ $identity = 1 ] && echo identity/Test/compile
    [ $testkit = 1 ] && echo testkit/Test/compile
    [ $scrapers = 1 ] && echo scrapers/Test/compile
    [ $worker = 1 ] && printf '%s\n' worker/Test/compile worker/It/compile
    [ $web = 1 ] && printf '%s\n' web/Test/compile web/It/compile web/Page/compile
    [ $e2e = 1 ] && echo e2e/Test/compile
    return 0
}

# ── Which lint specs the sbt check runs ─────────────────────────────────────────────────────────
# One line per path on stdin; prints `<module>:<spec>`, one per line. The standing lints always. Every other spec that
# only READS THE REPO'S FILES (never boots the app, never needs the network) runs when the push touches what such a spec
# reads: scripts/, .github/, .claude/, CLAUDE.md, build.sbt, project/, */src/test|it|page/, worker/src/fixtures, testkit/
# (~30 s warm in all). The set is read off the directories, so a new lint spec joins it by existing:
#   <module>/src/test/scala/deploy/*Spec.scala     every workflow / wiring / budget / gate spec
#   <module>/src/test/scala/tools/{No*,*Lint*}Spec the source lints (common, scrapers, worker, web)
# except what stays out, and why:
#   needs the GitOps manifests, which live in another repository (CI checks them out; the sbt check runs
#   infra/bin/fetch-gitops first, and with PREPUSH_GITOPS=1 -- the manifests in place -- these run too):
#       NodeCpuBudgetSpec NodeMemoryBudgetSpec ChangeStreamSilenceAlertSpec CinemaScrapeStalenessAlertSpec
#       WorkerRolloutStaggerSpec FluxImageAutomationSpec LauncherJvmFlagsSpec AotCacheOptionsSpec K8sTierPathGatingSpec
#       PrometheusNodePortAgreementSpec WorkerScrapeCadenceConfigSpec SharedUsersDatabaseConfigSpec WebRolloutAvailabilitySpec
#   boots a fixture server (not a file lint): FixtureServerBootSpec FixtureServerBootOverlapSpec
# Skip just these with PREPUSH_SKIP=lintspecs (the standing five still run under `sbt`).
LintSpecsNeedingGitOps="NodeCpuBudgetSpec NodeMemoryBudgetSpec ChangeStreamSilenceAlertSpec CinemaScrapeStalenessAlertSpec WorkerRolloutStaggerSpec FluxImageAutomationSpec LauncherJvmFlagsSpec AotCacheOptionsSpec K8sTierPathGatingSpec PrometheusNodePortAgreementSpec WorkerScrapeCadenceConfigSpec SharedUsersDatabaseConfigSpec WebRolloutAvailabilitySpec"
LintSpecsBootingServers="FixtureServerBootSpec FixtureServerBootOverlapSpec"
# The lints every sbt check runs, whatever the push touches.
StandingLintSpecs="worker:tools.NoWallClockInTestsSpec scrapers:services.cinemas.NoWallClockInClientsSpec worker:deploy.GrafanaMetricCoverageSpec worker:deploy.NoSilencedGhCurlSpec web:deploy.GrafanaWebMetricCoverageSpec"
# Whether one of the paths on stdin is one the repo-reading lint specs read.
reads_repo() {
    local path found=1
    while IFS= read -r path; do
        read_by_lint_specs "$path" && found=0
    done
    return $found
}
lint_plan() {
    local repo_read=0 module dir file spec excluded="$LintSpecsBootingServers"
    reads_repo && repo_read=1
    [ "${PREPUSH_GITOPS:-}" = 1 ] || excluded="$excluded $LintSpecsNeedingGitOps"
    printf '%s\n' $StandingLintSpecs
    if [ $repo_read = 1 ] && ! skipped lintspecs; then
        for module in common scrapers worker web; do
            for dir in deploy tools; do
                for file in "$module"/src/test/scala/$dir/*Spec.scala; do
                    [ -f "$file" ] || continue
                    spec="$(basename "$file" .scala)"
                    case "$dir:$spec" in tools:No*|tools:*Lint*|deploy:*) ;; *) continue ;; esac
                    case " $excluded " in *" $spec "*) continue ;; esac
                    case " $StandingLintSpecs " in *" $module:$dir.$spec "*) continue ;; esac
                    echo "$module:$dir.$spec"
                done
            done
        done
    fi
    return 0
}

case "${1:-}" in
    --plan)         plan; exit 0 ;;
    --compile-plan) compile_plan; exit 0 ;;
    --lint-plan)    lint_plan; exit 0 ;;
esac

log()  { printf '\033[36m▸ pre-push\033[0m %s\n' "$*"; }
warn() { printf '\033[33m! pre-push\033[0m %s\n' "$*" >&2; }

# A local tool a check needs, missing: the check FAILS, saying how to fix it (header: A MISSING LOCAL TOOL).
missing_tool() { # <check> <tool> <fix>
    warn "$2 not found: the $1 check cannot run, so the push is BLOCKED (never skipped). Fix: $3 -- then push again (or PREPUSH_SKIP=$1, named in your report)."
    return 1
}
need() { # <check> <tool> <fix>
    command -v "$2" >/dev/null || missing_tool "$@"
}
SdkmanFix='put sdkman'"'"'s sbt and java on PATH: export PATH="$HOME/.sdkman/candidates/sbt/current/bin:$HOME/.sdkman/candidates/java/current/bin:$PATH" (or run: . "$HOME/.sdkman/bin/sdkman-init.sh")'
# sbt, and a java that RUNS (macOS's /usr/bin/java is a stub that only says no runtime is installed); sbt's launcher
# takes $JAVA_HOME's first.
need_jvm() { # <check>
    local java=java
    need "$1" sbt "$SdkmanFix" || return 1
    [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ] && java="$JAVA_HOME/bin/java"
    bounded 30 "$java" -version >/dev/null 2>&1 || missing_tool "$1" "a java that runs (\$JAVA_HOME or PATH)" "$SdkmanFix"
}

# ── Red builds gate the push ────────────────────────────────────────────────────────────────────
# The nightly data's verdict is VERIFY's, never the capture's (docs/forgejo-ci.md, "Capture, then verify"): Record scrape
# fixtures goes red when it could not scrape or record a country -- a fact about the night, not about any push -- and is
# watched by its own issue and identity-ci-staleness's recording-stale; Verify scrape recording replays what it captured,
# hermetically, and goes red when the code does not hold on it.
GatingWorkflows=("Main" "Identity model convergence" "Verify scrape recording")
# The same workflows by file: Forgejo's runs API filters on the workflow file, not its name.
GatingWorkflowFiles=("main.yml" "identity-model-convergence.yml" "verify-scrape-recording.yml")
GhSeconds="${PREPUSH_GH_SECONDS:-15}"

# Where the push goes decides whose runs are read (GitHub suspended the account on 2026-10-19; main's CI runs on Forgejo
# since): a Forgejo remote (ssh://forgejo-git/…, a forgejo.* host) reads Forgejo's actions API, anything else GitHub's
# through gh. git hands the hook the push URL as $2; a --range dry run takes $PREPUSH_REMOTE_URL, else the push URL of
# the remote its base names (`forgejo/main..HEAD` reads Forgejo, as `git push forgejo` will), else GitHub. So a dry run
# of `<remote>/main..HEAD` is keyed like the push that follows it, which then REUSES its pass (CHECK FIRST, below).
remote_url=""
case "${1:-}" in
    --range)
        remote_url="${PREPUSH_REMOTE_URL:-}"
        range_base="${2:-}"; range_base="${range_base%%..*}"
        case "$range_base" in
            */*) [ -z "$remote_url" ] && remote_url="$(git remote get-url --push "${range_base%%/*}" 2>/dev/null || true)" ;;
        esac ;;
    *)       remote_url="${2:-}" ;;
esac
is_forgejo_url() { # <url>
    case "$1" in
        ssh://forgejo-git/*|forgejo-git:*|*://forgejo.*|*://forgejo:*|*://*@forgejo.*|*@localhost:2222*|*://localhost:2222/*) return 0 ;;
    esac
    return 1
}
# `<api base> <owner>/<repo>` of a Forgejo remote. The ssh alias has no web side: its API is the laptop tunnel's
# http://forgejo.internal:3000 ($PREPUSH_FORGEJO_URL overrides).
forgejo_api_for() { # <url>
    local url="$1" web path
    case "$url" in
        http://*|https://*) web="$(printf '%s' "$url" | sed -E 's#^(https?://)([^@/]*@)?([^/]+)/.*#\1\3#')"
                            path="$(printf '%s' "$url" | sed -E 's#^https?://[^/]+/##')" ;;
        *://*)              web="http://forgejo.internal:3000"; path="$(printf '%s' "$url" | sed -E 's#^[a-z+]+://[^/]+/##')" ;;
        *)                  web="http://forgejo.internal:3000"; path="${url#*:}" ;;
    esac
    path="${path%.git}"; path="${path%/}"
    printf '%s/api/v1 %s\n' "${PREPUSH_FORGEJO_URL:-$web}" "$path"
}

# `<conclusion> <run id> <url>` of a workflow's newest decided run on main (success or a failure of any kind; cancelled,
# skipped and unfinished runs say nothing), empty when it has none; non-zero when gh cannot answer in time.
newest_verdict() { # <workflow name>
    bounded "$GhSeconds" \
        gh run list --workflow "$1" --branch main --limit 30 --json databaseId,status,conclusion,url \
        --jq '[.[] | select(.status == "completed" and (.conclusion | IN("cancelled", "skipped", "neutral", "") | not))][0] // empty
              | "\(.conclusion) \(.databaseId) \(.url)"'
}

# The same off Forgejo's GET /repos/{owner}/{repo}/actions/runs: a run's one `status` is its verdict once decided
# (success, failure; cancelled, skipped, running, waiting and blocked say nothing). The run id is the run's number in
# its URL (…/actions/runs/<n>), the one a Fixes-Red: trailer names. The token, when there is one, goes to curl on
# stdin, never in its argv. Non-zero (curl's or HTTP's error on stderr) when Forgejo cannot answer in time.
newest_verdict_forgejo() { # <api base> <owner/repo> <workflow file>
    local body code
    body="$(mktemp)"
    code="$(printf '%s' "${forgejo_token:+header = \"Authorization: token $forgejo_token\"}" \
        | bounded "$GhSeconds" curl -sS --config - -o "$body" -w '%{http_code}' \
            "$1/repos/$2/actions/runs?workflow_id=$3&ref=refs/heads/main&limit=30")" \
        || { local rc=$?; rm -f "$body"; return "$rc"; }
    if [ "$code" != 200 ]; then
        echo "HTTP $code" >&2
        rm -f "$body"; return 1
    fi
    jq -r '[(.workflow_runs // [])[] | select(.status | IN("success", "failure"))][0] // empty
           | "\(.status) \(.index_in_repo) \(.html_url) \(.id)"' "$body"
    local rc=$?; rm -f "$body"; return "$rc"
}

# Forgejo's token on the laptop: $FORGEJO_API_TOKEN when the environment has it, else read from the Touch ID vault —
# only while `movies` is already unlocked, so a push never raises a Touch ID prompt. Never written anywhere.
forgejo_token=""
read_forgejo_token() {
    if [ -n "${FORGEJO_API_TOKEN:-}" ]; then forgejo_token="$FORGEJO_API_TOKEN"; return 0; fi
    command -v secrets >/dev/null || return 1
    [ "$(bounded 5 secrets status movies)" = unlocked ] || return 1
    forgejo_token="$(bounded 5 secrets get movies FORGEJO_API_TOKEN)" && [ -n "$forgejo_token" ]
}

# A production path: what reaches a running pod or a fleet host. Everything else — scripts/, docs/, .claude/, the
# test, it and fixture trees, test/resources/, .github/ tooling — is tools, which may land while red (user, 2026-10-14).
is_production_path() { # <path>
    case "$1" in
        */src/main/*|conf/*|*/conf/*|build.sbt|project/*|infra/nix/*|infra/kubernetes/*|Dockerfile) return 0 ;;
    esac
    return 1
}

# Whether <commit> changes any production path.
touches_production() { # <commit>
    local path
    while IFS= read -r path; do
        [ -n "$path" ] && is_production_path "$path" && return 0
    done < <(git diff-tree --no-commit-id --name-only -r --root -m "$1")
    return 1
}

# Refuses a push to main while a gating workflow's newest verdict is red, unless every pushed commit that touches a
# production path names one of the red runs in a `Fixes-Red: <run id>` trailer. <range>... the pushed commits.
check_redgate() {
    local workflow verdict conclusion id url api_id reds="" commit fixes ok bad=0 r errors i forge=gh api="" repo=""
    if is_forgejo_url "$remote_url"; then
        forge=Forgejo
        need redgate curl "brew install curl" || return 1
        need redgate jq "brew install jq" || return 1
        read -r api repo <<< "$(forgejo_api_for "$remote_url")"
        # The repository is private: its runs answer 404 to an anonymous read (2026-10-20), so no token is said once and
        # passed -- no evidence of a red, so no block, and no Touch ID prompt on a push.
        read_forgejo_token || {
            warn "no Forgejo token (\$FORGEJO_API_TOKEN unset; vault 'movies' locked: secrets unlock movies) — red-build gate SKIPPED"
            gate_state="no-token"
            return 0
        }
    else
        need redgate gh "brew install gh" || return 1
    fi
    # gh's stderr kept apart from its answer: a warning beside a green verdict would otherwise be read as the verdict.
    errors="$(mktemp)"
    for i in "${!GatingWorkflows[@]}"; do
        workflow="${GatingWorkflows[$i]}"
        if [ "$forge" = Forgejo ]; then verdict="$(newest_verdict_forgejo "$api" "$repo" "${GatingWorkflowFiles[$i]}" 2>"$errors")"
        else verdict="$(newest_verdict "$workflow" 2>"$errors")"
        fi || {
            if [ $? = 124 ]; then warn "$forge did not answer $workflow's verdict within ${GhSeconds}s: cut off — red-build gate SKIPPED for it"
            else warn "could not read $workflow's verdict from $forge ($(head -n 1 "$errors")) — red-build gate SKIPPED for it"
            fi
            gate_state="$gate_state $i:unread"
            continue
        }
        [ -n "$verdict" ] || { gate_state="$gate_state $i:none"; continue; }
        read -r conclusion id url api_id <<< "$verdict"
        gate_state="$gate_state $i:$conclusion:$id"
        if [ "$conclusion" != success ]; then
            # On Forgejo a run has two ids: its number in the URL and the API's run id (the one scripts/forge-gh and the
            # artifact registry use). A Fixes-Red: naming either declares the fix.
            reds="$reds $id${api_id:+ $api_id}"
            warn "$workflow is RED on main: run $id ($conclusion) $url${api_id:+ (run id $api_id)}"
        fi
    done
    rm -f "$errors"
    [ -z "$reds" ] && return 0
    for r in "$@"; do
        while IFS=$'\t' read -r commit fixes; do
            if ! touches_production "$commit"; then
                log "${commit:0:9} is tools-only (touch no production path): lands while red" >&2
                continue
            fi
            ok=0
            for id in $(printf '%s' "$fixes" | tr ',' ' '); do
                case " $reds " in *" $id "*) ok=1 ;; esac
            done
            [ "$ok" = 1 ] && continue
            warn "${commit:0:9} carries no Fixes-Red: trailer naming a red run (red:$reds)"
            bad=1
        done < <(git log --format='%H%x09%(trailers:key=Fixes-Red,valueonly,separator=%x2C)' "$r")
    done
    [ "$bad" = 0 ] && { log "every pushed production commit is declared a fix for a red run"; return 0; }
    warn "main is red: only a fix for it lands. Add 'Fixes-Red: <run id>' to each commit's message (git commit --amend"
    warn "on unpushed commits), or bypass with PREPUSH_SKIP=redgate."
    return 1
}

# ── What is being pushed ────────────────────────────────────────────────────────────────────────
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref. The base for a new
# remote branch (or a remote sha this clone has never fetched) is its merge-base with origin/main.
base_for() {
    local local_sha="$1" remote_sha="$2"
    if [ "$remote_sha" != "$Zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        echo "$remote_sha"
    elif git rev-parse -q --verify origin/main >/dev/null; then
        git merge-base "$local_sha" origin/main 2>/dev/null || true
    else
        # Said out loud: an unfetched clone would otherwise check nothing and pass.
        printf '\033[33m! pre-push\033[0m no origin/main to find the base of %s from — nothing checked (git fetch origin, then push again)\n' "${local_sha:0:9}" >&2
    fi
}

ranges=()
to_main=0
# A MEASUREMENT'S BRANCH (scripts/identity-measure's `measure/<user>/<sha>-<rand>`) is pushed only for CI to run the
# commit's identity takes from: it never lands, nothing merges it, and its run deletes it. The checks below guard what
# main's CI will build, so a push of measure/ refs alone checks nothing -- what the commit becomes on main is checked
# when it is pushed there. Any other ref in the same push is checked as ever.
measure_only="" other=""
if [ "${1:-}" = "--range" ]; then
    ranges+=("${2:?--range A..B}")
    to_main=1   # a dry run is judged as a push to main
else
    pushed=""
    while read -r _local_ref local_sha remote_ref remote_sha; do
        pushed+="$_local_ref $local_sha $remote_ref $remote_sha"$'\n'
        [ "$local_sha" = "$Zero" ] && continue   # deleting a remote ref: nothing to check
        case "$remote_ref" in refs/heads/measure/*) measure_only=1; continue ;; *) other=1 ;; esac
        base="$(base_for "$local_sha" "$remote_sha")"
        [ -n "$base" ] && ranges+=("$base..$local_sha")
        [ "$remote_ref" = refs/heads/main ] && to_main=1
    done
    # THE SQUASH GUARD (2026-10-22): a commit built by `git reset --soft` onto a main that had moved since the worktree
    # was cut silently reverts everyone else's work in between -- one would have reverted 71 files (the red gate
    # caught it by luck). agentctl refuses a push that returns files to an older main. Where agentctl is not installed
    # (CI, another machine), nothing changes.
    if [ "$to_main" = 1 ] && [ -x "$HOME/bin/agentctl" ]; then
        printf '%s' "$pushed" | "$HOME/bin/agentctl" prepush-check --hook "${1:-forgejo}" "${2:-}" || exit 1
    fi
fi
if [ "${#ranges[@]}" -eq 0 ]; then
    [ -n "$measure_only" ] && [ -z "$other" ] && log "measure/ branch: a measurement's run ref, never landed -- nothing to check"
    exit 0
fi

# The red gate's state, one word a workflow (`<i>:<conclusion>:<run>`, `<i>:unread`, `<i>:none`): a key of THE REUSE below.
gate_state="not-main"
if [ "$to_main" = 1 ]; then
    if skipped redgate; then warn "redgate SKIPPED (PREPUSH_SKIP)"; gate_state="skipped"
    else gate_state=""; check_redgate "${ranges[@]}" || exit 1
    fi
fi

# THREE dots: what the pushed commits changed since they left the base, not how the two tips
# differ. A fetch by any agent moves origin/main under every worktree of this clone, and a two-dot
# diff would count those newer commits of main as this push's changes.
changed=""
for r in "${ranges[@]}"; do
    # A diff that fails is not "nothing changed".
    names="$(git diff --name-only --diff-filter=d "${r/../...}")" \
        || { printf '\033[33m! pre-push\033[0m cannot diff %s — blocked (bypass with --no-verify)\n' "$r" >&2; exit 1; }
    changed="$changed$names"$'\n'
done
changed="$(printf '%s' "$changed" | grep -v '^$' | LC_ALL=C sort -u)"
[ -z "$changed" ] && exit 0
# A commit, not a name: `--range A..HEAD` must compare equal to the checkout's own HEAD.
head_sha="$(git rev-parse --verify "${ranges[${#ranges[@]}-1]##*..}^{commit}")" || exit 1
base_sha="${ranges[0]%%..*}"

checks="$(printf '%s\n' "$changed" | plan)"
[ -z "$checks" ] && exit 0

# ── THE REUSE: a passed result answers a re-push of the SAME tree ───────────────────────────────
# A re-push of the very same tree -- a no-content rebase, a reworded message, a push that lost its race at the remote
# after the checks passed -- ran every check again: minutes of sbt for a tree already judged. A run that passes stores
# its KEY in ~/.cache/kinowo-prepush ($PREPUSH_REUSE_DIR); a later push with the same key skips the path checks, said in
# one line. The key is everything the checks' verdict reads: the pushed tree and the base's (shellcheck and scripttests
# judge against the base), the changed paths and the checks they select, this hook's own bytes and the helpers it
# sources, the red gate's state and PREPUSH_SKIP. One byte of difference in any of them -- the tree, the hook, a red run
# appearing or clearing -- is another key, and everything runs. A key part that cannot be read means no reuse at all. Only
# a push of one ref is reused; a failed run stores nothing. The red gate itself always runs (above).
# PREPUSH_NO_REUSE=1 runs everything regardless.
reuse_dir="${PREPUSH_REUSE_DIR:-$HOME/.cache/kinowo-prepush}" reuse_key=""
compute_reuse_key() { # prints the key, or fails when any part of it cannot be read
    local here tree base_tree hook
    here="$(dirname "${BASH_SOURCE[0]}")"
    tree="$(git rev-parse --verify -q "$head_sha^{tree}")" && [ -n "$tree" ] || return 1
    base_tree="$(git rev-parse --verify -q "$base_sha^{tree}")" && [ -n "$base_tree" ] || return 1
    hook="$(cat "${BASH_SOURCE[0]}" "$here/../hooks-path.sh" "$here/../tool-conventions.sh" | git hash-object --stdin)" \
        && [ -n "$hook" ] || return 1
    { echo "tree $tree"; echo "base $base_tree"; echo "hook $hook"; echo "gate $gate_state"
      echo "skip $(tr -s ' ' '\n' <<< "${PREPUSH_SKIP:-}" | grep -v '^$' | LC_ALL=C sort -u | tr '\n' ' ')"
      echo "checks $(printf '%s' "$checks" | tr '\n' ' ')"; printf '%s\n' "$changed"; } | git hash-object --stdin
}
if [ -z "${PREPUSH_NO_REUSE:-}" ] && [ "${#ranges[@]}" -eq 1 ]; then
    reuse_key="$(compute_reuse_key)" || reuse_key=""
    if [ -n "$reuse_key" ] && [ -f "$reuse_dir/$reuse_key" ]; then
        log "same tree $(git rev-parse --short "$head_sha^{tree}"), base, hook and red-gate state as a push that passed $(cat "$reuse_dir/$reuse_key"): $(printf '%s' "$checks" | tr '\n' ' ')reused, not run again (PREPUSH_NO_REUSE=1 runs them)" >&2
        exit 0
    fi
fi

# ── Running them ────────────────────────────────────────────────────────────────────────────────
changed_matching() { printf '%s\n' "$changed" | grep -E "$1" || true; }

check_eslint() {
    need eslint npm "install Node.js (brew install node)" || return 1
    if [ ! -x node_modules/.bin/eslint ]; then
        log "installing ESLint (npm ci, once per worktree)"
        npm ci --no-audit --no-fund --silent >/dev/null || return 1
    fi
    npm run --silent lint
}

check_drift() {
    need drift python3 "install Python 3 (brew install python)" || return 1
    # data/us/scripts/generate_roster.py needs it; without it the generator exits before writing any ::error:: line
    python3 -c 'import timezonefinder' 2>/dev/null \
        || missing_tool drift "python3's timezonefinder" "python3 -m pip install timezonefinder" || return 1
    # GeoNames' Polish gazetteer, kept in the shared git dir so every worktree downloads it once.
    GEONAMES_CACHE="$(git rev-parse --path-format=absolute --git-common-dir)/kinowo-cache/geonames" \
        scripts/ci/generated-artefacts-drift.sh > "$tmp/drift.log" 2>&1 \
        || { if grep -q '::error::' "$tmp/drift.log"; then sed -n '/::error::/,$p' "$tmp/drift.log" | head -80 >&2
             else tail -30 "$tmp/drift.log" >&2; fi; return 1; }
}

check_snapshot() {
    scripts/read-model-snapshot-inputs.sh check "$head_sha"
}

check_dashboards() {
    need dashboards python3 "install Python 3 (brew install python)" || return 1
    python3 infra/test/test_dashboards.py > "$tmp/dashboards.log" 2>&1 \
        || { sed -n '/^FAIL\|^ERROR\|AssertionError/,+3p' "$tmp/dashboards.log" | head -40 >&2; return 1; }
}

check_scripttests() {
    # Beside them, in the background, the same tests on Linux (`--linux`: CI's ubuntu-26.04, in Docker) -- GNU tools a
    # Mac's BSD ones hide (03b3a6825). Warm, it adds ~4 s to a run the native one outlasts: ~0 s of wall time.
    local linux_pid=""
    if ! skipped linux && grep -q -e '--linux' scripts/run-script-tests 2>/dev/null; then
        scripts/run-script-tests --linux --changed "$base_sha" > "$tmp/scripttests-linux.log" 2>&1 &
        linux_pid=$!
    fi
    scripts/run-script-tests --changed "$base_sha" > "$tmp/scripttests.log" 2>&1 \
        || { grep -v '^PASS\|✓' "$tmp/scripttests.log" | head -80 >&2; [ -z "$linux_pid" ] || wait "$linux_pid"; return 1; }
    tail -1 "$tmp/scripttests.log"
    if [ -n "$linux_pid" ]; then
        if wait "$linux_pid"; then
            echo "on Linux: $(tail -1 "$tmp/scripttests-linux.log")"
        elif grep -q -- '--linux needs a running Docker' "$tmp/scripttests-linux.log"; then
            echo "on Linux: SKIPPED (Docker is not running -- start Rancher/Docker Desktop to run them as CI does)"
        else
            echo "on Linux (scripts/run-script-tests --linux; PREPUSH_SKIP=linux skips it):" >&2
            grep -v '^PASS\|✓' "$tmp/scripttests-linux.log" | head -80 >&2
            return 1
        fi
    fi
    # On a Mac, again under its /bin/bash 3.2, the floor the tools promise: a bash-4-only construct is caught at the push,
    # not by the nightly macOS job (PREPUSH_FLOOR_BASH stands in for /bin/bash in the hook's test)
    local floor=${PREPUSH_FLOOR_BASH:-/bin/bash} major
    [ -x "$floor" ] || return 0
    # shellcheck disable=SC2016 # expanded by that bash
    major=$("$floor" -c 'echo "${BASH_VERSINFO[0]}"' 2>/dev/null) || return 0
    case "$major" in [0-3]) ;; *) return 0 ;; esac
    # The hook is the working tree's, the runner the pushed commit's: one from before --bash existed runs once.
    grep -q -e '--bash' scripts/run-script-tests 2>/dev/null || return 0
    scripts/run-script-tests --changed "$base_sha" --bash "$floor" > "$tmp/scripttests-floor.log" 2>&1 \
        || { echo "under $floor (bash $major):" >&2; grep -v '^PASS\|✓' "$tmp/scripttests-floor.log" | head -80 >&2; return 1; }
    echo "under $floor: $(tail -1 "$tmp/scripttests-floor.log")"
}

# actionlint over changed workflows; a composite action's `run:` blocks, which actionlint does not
# lint, through scripts/ci/shellcheck-action-runs.sh. CI's `Workflow lint` step runs both over the
# whole tree, so a missing tool here only defers the finding to CI.
check_actionlint() {
    local workflows actions rc=0
    workflows="$(changed_matching '^\.github/workflows/.*\.ya?ml$')"
    actions="$(changed_matching '^\.github/actions/[^/]*/action\.ya?ml$')"
    if [ -n "$workflows" ]; then
        if command -v actionlint >/dev/null; then
            # shellcheck disable=SC2086 # workflow file names carry no spaces
            SHELLCHECK_OPTS='-S warning' actionlint $workflows || rc=1
        else
            missing_tool actionlint actionlint "brew install actionlint" || rc=1
        fi
    fi
    if [ -n "$actions" ]; then
        if command -v shellcheck >/dev/null; then
            # shellcheck disable=SC2086 # action paths carry no spaces
            scripts/ci/shellcheck-action-runs.sh $actions || rc=1
        else
            missing_tool actionlint shellcheck "brew install shellcheck" || rc=1
        fi
    fi
    return "$rc"
}

# Fail on a warning the push ADDS: count each changed script's warnings at the base and at HEAD.
check_shellcheck() {
    need shellcheck shellcheck "brew install shellcheck" || return 1
    local f before after rc=0
    for f in $(changed_matching '(\.sh$|^scripts/hooks/)'); do
        [ -f "$f" ] || continue
        after="$(shellcheck -S warning -f gcc "$f" 2>/dev/null | wc -l | tr -d ' ')"
        if git cat-file -e "$base_sha:$f" 2>/dev/null; then
            git show "$base_sha:$f" > "$tmp/base.sh"
            before="$(cd "$(dirname "$f")" && shellcheck -S warning -f gcc "$tmp/base.sh" 2>/dev/null | wc -l | tr -d ' ')"
        else
            before=0
        fi
        if [ "$after" -gt "$before" ]; then
            warn "$f: shellcheck warnings $before → $after"
            shellcheck -S warning "$f" >&2
            rc=1
        fi
    done
    return $rc
}

check_sbt() {
    need_jvm sbt || return 1
    local compiles
    # shellcheck disable=SC2207 # task names carry no spaces
    compiles=($(printf '%s\n' "$changed" | compile_plan))
    local lints module tests=() gitops_stale=0
    # The specs reading the GitOps manifests join the lints once infra/bin/fetch-gitops has put them in this checkout
    # (Forgejo, else GitHub). The fetch failing BLOCKS the push: the checkout left behind is stale, and the local clone
    # the script once fell back to went stale with GitHub (2026-10-19) -- a spec then failed on a probe movies-gitops
    # 24a5162 had already fixed. The specs needing them stay out of this run; the rest still run, for their verdicts.
    if printf '%s\n' "$changed" | reads_repo && ! skipped lintspecs && [ -x infra/bin/fetch-gitops ]; then
        if KINOWO_GITOPS_DEST="$PWD/infra/kubernetes" bounded "${PREPUSH_GITOPS_SECONDS:-90}" infra/bin/fetch-gitops > "$tmp/fetch-gitops.log" 2>&1; then
            export PREPUSH_GITOPS=1
        else
            gitops_stale=1
            sed 's/^/    /' "$tmp/fetch-gitops.log" | tail -8 >&2
            warn "GitOps manifests STALE: infra/bin/fetch-gitops could not fetch movies-gitops main, so the push is BLOCKED. Fix: the Forgejo tunnel (launchctl kickstart -k gui/\$(id -u)/net.bitcashier.forgejo-tunnel), then push again (or PREPUSH_SKIP=lintspecs, named in your report)."
        fi
    fi
    lints="$(printf '%s\n' "$changed" | lint_plan)"
    for module in common scrapers worker web; do
        tests+=("$module/Test/testOnly $(printf '%s\n' "$lints" | sed -n "s/^$module://p" | tr '\n' ' ' | sed 's/ $//')")
    done
    local run=(sbt -batch -Dsbt.server.forcestart=false ${compiles[@]+"${compiles[@]}"} "${tests[@]}")
    if [ "$sbt_client" = 1 ]; then
        local line
        line="$(printf '%s; ' ${compiles[@]+"${compiles[@]}"} "${tests[@]}")"
        # through scripts/sbt-warm, as any call to the kept server: a bare `sbt --client` held no busy lock and kept no
        # last-used mark fresh, so the server's keeper, seeing it idle, could stop it mid-check (2026-10-19)
        run=("$root/scripts/sbt-warm" "${line%; }")
    fi
    "${run[@]}" > "$tmp/sbt.log" 2>&1 \
        || { grep -E '\*\*\* FAILED|\[error\]|should|Error' "$tmp/sbt.log" | head -60 >&2; warn "full log: $tmp/sbt.log"; return 1; }
    [ "$gitops_stale" = 0 ]
}

# The tools' files compile into each tool's floor ref (scripts/identity-slice-old-ref-test.sh names them): an
# incremental compile in the floor's cached tree, minutes only the first time a machine lays it out.
check_oldrefs() {
    need_jvm oldrefs || return 1
    env -u OLD_REFS bash scripts/identity-slice-old-ref-test.sh > "$tmp/oldrefs.log" 2>&1 \
        || { grep -v '^PASS\|✓' "$tmp/oldrefs.log" | tail -60 >&2; warn "full log: $tmp/oldrefs.log"; return 1; }
}

check_ios() {
    scripts/ios-compile-check.sh
}

# The takes the newest decided Identity model convergence legs served, as `<dir>/<cc>-takes/<cc>.json.gz` under a cache
# kept per run in the shared git dir; prints the files, or nothing (warned) when gh cannot fetch them in time. A run that
# reused an earlier run's verdict (scripts/ci/convergence_reuse.py) ran no leg and served nothing: the next one back is
# read, up to three.
served_takes() {
    local runs run cache part found=""
    runs="$(bounded "$GhSeconds" gh run list --workflow "Identity model convergence" \
        --branch main --status completed --limit 30 --json databaseId,conclusion \
        --jq '[.[] | select(.conclusion == "success" or .conclusion == "failure")][0:3][].databaseId' 2>/dev/null)" || runs=""
    [ -n "$runs" ] || { warn "judgements: no Identity model convergence run to read served takes from — served check SKIPPED"; return 0; }
    for run in $runs; do
        cache="$(git rev-parse --path-format=absolute --git-common-dir)/kinowo-cache/served-takes/$run"
        if [ ! -d "$cache" ]; then
            # Agents push at once and share this cache: each downloads into a directory of its own, and only the first to
            # finish renames it into place (rename(2) onto a filled directory fails; `mv` would nest it inside).
            part=""
            mkdir -p "$(dirname "$cache")" && part="$(mktemp -d "$cache.part.XXXXXX")" \
                && bounded 120 gh run download "$run" -p 'convergence-diagnostics-*-convergence' \
                -D "$part" >/dev/null 2>&1 \
                || { [ -n "$part" ] && rm -rf "$part"; continue; }
            perl -e 'rename($ARGV[0], $ARGV[1]) or exit 1' "$part" "$cache" 2>/dev/null || rm -rf "$part"
        fi
        found=$(find "$cache" -path '*-takes/*.json.gz')
        [ -z "$found" ] || { echo "$found"; return 0; }
    done
    warn "judgements: could not fetch the served takes of runs $(echo $runs) — served check SKIPPED"
}

check_judgements() {
    local served=() before=""
    need judgements python3 "install Python 3 (brew install python)" || return 1
    if printf '%s\n' "$changed" | grep -qx 'test/resources/fixtures/identity-judgements.tsv'; then
        need judgements gh "brew install gh" || return 1
        while IFS= read -r f; do [ -n "$f" ] && served+=("$f"); done < <(served_takes)
        before="$tmp/judgements-before.tsv"
        git show "$base_sha:test/resources/fixtures/identity-judgements.tsv" > "$before" 2>/dev/null || before=""
    fi
    # --replay-head: the takes the push newly judges wrong judged at the PUSHED code (identity-slice), not the last leg's
    python3 scripts/ci/identity_judgements_lint.py ${served[@]+--served "${served[@]}"} ${before:+--before "$before" --replay-head}
}

tmp="$(mktemp -d)"

# THE PUSHED COMMITS ARE JUDGED, not the working tree: that can hold edits the push does not
# carry, or sit on another branch entirely (`git push origin other:main`). When HEAD is the
# pushed commit and nothing the push changed differs from it, the checkout is that tree and the
# checks run in place, warm. Otherwise they run in a temporary worktree of the pushed commit —
# never `git stash`, which is shared by every worktree of this clone — removed afterwards.
in_place() {
    [ "$(git rev-parse HEAD)" = "$head_sha" ] || return 1
    local path
    while IFS= read -r path; do
        git diff --quiet HEAD -- "$path" || return 1
        [ -z "$(git ls-files --others --exclude-standard -- "$path")" ] || return 1
    done <<< "$changed"
}
# ONE sbt PER target/. A live sbt JVM in this checkout — the DevPanel's `sbt web/run`, an IDE's
# BSP server, an agent's test run — compiles into the same target/ as the check would: Play's dev
# server recompiles on the first request after a merge changes sources. Two Zincs over one classes
# dir delete and rewrite each other's class files, and the check's tests then load a class the
# other has just deleted (NoClassDefFoundError: services/movies/MovieRepository$, twice on
# 2026-09-26; a retry passed once both had settled). Echoes the first such pid.
live_sbt_in_checkout() {
    local here pid cwd
    here="$(pwd -P)"
    for pid in $(pgrep -f 'sbt-launch|xsbt\.boot\.Boot' 2>/dev/null); do
        cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
        [ -n "$cwd" ] && [ "$(cd "$cwd" 2>/dev/null && pwd -P)" = "$here" ] && { echo "$pid"; return 0; }
    done
    return 1
}
isolate_reason="" sbt_client=0
if ! in_place; then
    isolate_reason="the working tree is not ${head_sha:0:9}"
elif printf '%s\n' "$checks" | grep -qx sbt && ! skipped sbt && live_pid="$(live_sbt_in_checkout)"; then
    # the checkout's KEPT server (scripts/sbt-warm: `sbt --client`, launched --detach-stdio) is no rival compiler —
    # it is the one compiler: the check runs through it (by scripts/sbt-warm), in place and warm
    if ps -o args= -p "$live_pid" 2>/dev/null | grep -q -- '--detach-stdio'; then
        sbt_client=1
        log "the sbt check runs through this checkout's kept sbt server (pid $live_pid), warm"
    else
        isolate_reason="a live sbt (pid $live_pid) shares this checkout's target/"
    fi
fi
if [ -n "$isolate_reason" ]; then
    tree="$tmp/tree"
    git worktree add -q --detach "$tree" "$head_sha" || { warn "cannot check out ${head_sha:0:9} to check it"; exit 1; }
    [ -d "$root/node_modules" ] && ln -s "$root/node_modules" "$tree/node_modules"
    log "$isolate_reason: checking a temporary checkout of ${head_sha:0:9}"
    cd "$tree" || exit 1
fi

failed=""
started=$SECONDS
log "$(printf '%s' "$checks" | tr '\n' ' ') — for $(printf '%s\n' "$changed" | wc -l | tr -d ' ') changed path(s)"
# ADVICE ONLY, never run here (it dispatches CI runs): an identity change passes these checks and still reddens Main on
# specs neither they nor identity-measure run -- six Main reds on 2026-10-22 had been measured LANDABLE.
if printf '%s\n' "$changed" | grep -qE '^(identity/|worker/src/main/scala/services/identity/|common/src/main/(resources/title-(rules|words)\.tsv|scala/services/titlerules/)|test/resources/fixtures/identity-)'; then
    log "identity change: did scripts/identity-landing-check say LANDABLE for ${head_sha:0:9}? It runs the measure AND the identity specs Main runs (MatchedTakesLabel, IdentitySliceCases, the ratchets, title rules, hard clusters, e2e) -- this hook runs neither" >&2
fi
for check in $checks; do
    if skipped "$check"; then warn "$check SKIPPED (PREPUSH_SKIP)"; continue; fi
    t0=$SECONDS
    if "check_$check"; then
        log "$check ok ($((SECONDS - t0))s)"
    else
        warn "$check FAILED ($((SECONDS - t0))s)"
        failed="$failed $check"
    fi
done

if [ -n "$failed" ]; then
    warn "blocked by:$failed ($((SECONDS - started))s). Fix, or bypass with PREPUSH_SKIP=\"${failed# }\" / --no-verify."
    exit 1
fi
rm -rf "$tmp"
if [ -n "$reuse_key" ] && mkdir -p "$reuse_dir" 2>/dev/null; then
    printf '%s (%s)\n' "$(date -u +%Y-%m-%dT%H:%MZ)" "${head_sha:0:9}" > "$reuse_dir/$reuse_key.$$" && mv -f "$reuse_dir/$reuse_key.$$" "$reuse_dir/$reuse_key"
    find "$reuse_dir" -type f -mtime +14 -delete 2>/dev/null
fi
log "all clear ($((SECONDS - started))s)"
# CHECK FIRST: git opens the push's ssh connection BEFORE it runs this hook and sends the pack only after it, so a long
# hook holds that connection idle. To Forgejo it rides the laptop's launchd ssh tunnel (net.bitcashier.forgejo-tunnel,
# `ssh -N forgejo-tunnel`); when the tunnel drops (its own keepalives missed under a load of 100+, a network change) and
# launchd restarts it, every connection forwarded through it dies with it: on 2026-10-23 pushes whose hook ran 20-76 min printed "all clear"
# and then "Connection to localhost closed by remote host" / "Broken pipe" / "unexpected disconnect while reading
# sideband packet". Nothing here can keep that connection; the re-push can be fast instead: this pass is stored (THE
# REUSE), so the same push again skips the checks.
if [ "${1:-}" != --range ] && [ "$SECONDS" -ge "${PREPUSH_LONG_SECONDS:-300}" ]; then
    warn "this hook ran ${SECONDS}s with the push's connection open (git connects first): if the push now dies with \"closed by remote host\" / \"Broken pipe\" / \"unexpected disconnect\", run the same git push again -- this pass is stored and is reused in seconds. Next time check first: scripts/hooks/pre-push --range ${1:-<remote>}/main..HEAD, then git push"
fi
