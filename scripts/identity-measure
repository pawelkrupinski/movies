#!/usr/bin/env bash
# WHOLE-CORPUS MEASURE OF A RESOLVER CHANGE, before landing it: every take a commit moves, in every country's whole
# pinned recording, split by what the judgements (test/resources/fixtures/identity-judgements.tsv) make of it.
#
# A selector-only `identity-slice --batch` measures the listings it is handed: twice it missed regressions the whole
# corpus showed (26e48897d lost 9 PL "Lalka" and 9 UK takes; branch a083 lost UK "Fallen Angels" x8 and DE
# "Schwanensee"), and a local whole-corpus slice is ~192k listings, >10 hours. CI's identity takes check
# (scripts/ci/identity-takes-check.sh) resolves the whole recording at a base and a head in ~15 minutes a country.
# This dispatches that check, and only that check (`takes-only`), for one commit, then classifies its moves
# (scripts/identity_measure.py) and prints LANDABLE or NOT LANDABLE.
#
# THE DEFAULT WAY TO MEASURE (2026-10-21): it runs on ci-runner (Forgejo CI), not on the laptop. scripts/identity-measure-local
# is the fallback, run only under the heavy-run slot wrapper. Typical wall time: ~25-40 minutes, most of it the takes rows.
#
# usage: scripts/identity-measure [<commit-or-branch> | --head <commit>] [--base <sha>] [--recording <run>]
#                                 [--countries pl,de,uk,us,es] [--keep-branch] [--no-wait | --wait] [--full] [--fresh] [--json]
#                                 [--timeout <minutes>] [--all-countries] [--all-recordings | --one-recording] [--plan]
#                                 [--footprint [--traces DIR] | --footprint-only [--traces DIR]] [--no-cache] [--tier LABEL]
#        scripts/identity-measure --sweep
#        scripts/identity-measure --run <run id> [--countries ...] [--keep-branch] [--json] [--no-wait | --wait] [--timeout <minutes>]
#   <commit>       default HEAD (uncommitted changes are NOT measured: commit them first); --head names it too
#   --base         default the commit's merge-base with <remote>/main; the commit's parent when it is on main already
#   --recording    a `Record scrape fixtures` run (e.g. 528), or prod-latest (the freshest complete nightly), every leg replays -- its corpus and tree as released, no
#                  fills, the bare pair identity-measure-local lays -- in place of the pinned pair. Never reused. Name
#                  the countries it holds with --countries (528: pl,de)
#   --countries    the countries measured and judged: only their legs run (the workflow's `takes-countries`); also a
#                  repeatable --country cc[,cc], as the other identity tools take it. Default: THE FOOTPRINT (below)
#   --all-countries  every country, whatever the footprint
#   --all-recordings measure over every recording in IDENTITY_MEASURE_RECORDINGS at once, in parallel (THE RECORDINGS)
#   --one-recording  never more than the one recording, whatever the change moved
#   --no-store     the takes check resolves both sides afresh, reusing and storing nothing (implies --fresh): the
#                  control that proves a stored base changes no verdict
#   --plan         print the footprint and the (recording, countries) runs it would dispatch, and exit
#   --footprint    a TITLE-RULE change measured on the laptop in minutes, no dispatch, when it can be proved to move no take
#                  (THE FOOTPRINT MEASURE below); otherwise says why and measures in full, as without it
#   --footprint-only  the same, but exit 3 where --footprint would measure in full (nothing dispatched)
#   --traces DIR   the base's traces from DIR (<cc>.jsonl.gz: a resolve's and a ratchet's --trace files, concatenated)
#                  in place of the release's: a base no takes check stored one for, traced by scripts/identity-ci-run
#   --keep-branch  leave the temporary branch on the remote (on Forgejo the run drops it anyway, below)
#   --no-wait      dispatch, print the run, keep the branch, and exit: collect later with --run <id> (which deletes it)
#   --wait         say the run's id and an ETA (the median wall time of the workflow's recent measure/ runs), then wait
#                  with ~/bin/agentctl wait's backoff -- 60 s, x1.5, at most 5 min (IDENTITY_MEASURE_WAIT_FIRST seconds
#                  first) -- not a read every 30 s. An agent runs it in the background and ends its turn. With --run too
#   --full         run the whole convergence suite, not only the takes rows (never reused, never stored)
#   --fresh        dispatch even when an earlier measurement of the same change answers it (below; the result cache too)
#   --no-cache     neither answer from THE RESULT CACHE (below) nor store in it: measure afresh
#   --tier         the ci-runner tier label the run's jobs take (the workflow's `tier` input): identity-landing-check
#                  passes the check tier, since a landing check blocks work; default empty, a measurement's `measure`
#   --sweep        delete the orphaned measure/ branches on origin (below) and exit; opt-in only, never run by a measurement
#   --take-paths   print the paths a reuse treats as able to move a take (matches.sh dialect) and exit
#   --json         machine output (scripts/identity_measure.py --json)
#   --run          collect an existing run instead (its identity-takes-<cc> artifacts); deletes its measure/ branch.
#                  A run still in progress is waited for (at most --timeout); with --no-wait it exits 2 instead
#
# THE FOOTPRINT (2026-10-22). Without --countries, only the countries whose takes the change CAN move are measured: each
# changed take-moving file's countries as scripts/ci/identity_impact.py reads them (the identity area's test-impact
# selection, 2026-10-27): */services/cinemas/<cc>/ or a capture identity-unmatched/<cc>.* reaches <cc>; a title-rules.tsv
# change the countries whose loaded rows differ (a row's `countries`, a venue row's venues); title-words.tsv EVERY country
# (TitleWords.tokens folds every language into one set: a German word reads in a Polish title too -- until 2026-10-27 a
# row reached only its language's countries, which was unsound); any other take-moving file -- the resolver, the shared
# rules -- every country. A change touching none measures all, as before (the takes rows then say "nothing can have
# moved" in seconds).
#
# THE FOOTPRINT MEASURE (--footprint, 2026-10-22). A change to the title rules alone -- title-rules.tsv, the
# services/titlerules/ code (not TitleRulePlaceholders.scala, which FormatTags reads directly) and TitleNormalizer.scala:
# the code the resolver reads titles through and nothing else does -- changes what the resolve READS, never how it
# decides. Every takes check stores, beside the base it resolved and each main head, every title reading its resolve and
# its ratchet made (scripts/ci/identity-takes-check.sh's THE NORMALIZER TRACE: `takes-trace-<cc>-<identity code>-<p|n><run>`
# on the release). This replays the base's under the head's rules (services.movies.NormalizerTraceCheck, compiled in the
# head's tree: ~1-3 minutes, no runner). When every reading of every footprint country reads alike, the head's resolve
# would make exactly the base's readings in the same order and decide exactly as it did: NO TAKE CAN MOVE, printed as
# the measure's table (`measure: footprint`) and LANDABLE, exit 0. That is sound for the recording the trace is over (the
# newest pinned pair's, or --recording's named one), its fills aside. Anything else falls back to the full measure, said
# first, its table `measure: full`:
#   - a changed take-moving file outside the title rules (matcher, scoring, a capture, BillingParse, title-words.tsv: no
#     trace says what they decide);
#   - no stored trace of the base's identity code over the recording (a base main stored none for yet);
#   - a reading that reads otherwise -- takes may move, and which only a resolve can say (they are listed, up to 20 a
#     country) -- or one the head cannot make again (a method gone, a venue renamed).
# The full measure stays the gate a change LANDS on: a footprint 0 is for iterating, and its own measure states so.
#
# THE RECORDINGS (2026-10-22). One recording by default: the pinned pair (or --recording), over the footprint's
# countries. It is also the cheap pre-diff for the rest: when it is LANDABLE and the change moved takes in two or more
# countries (CROSS-COUNTRY), the same change is measured again over the other recordings in IDENTITY_MEASURE_RECORDINGS
# (default "528": <run>[:<the countries it holds>], else read from its artifacts), in parallel, for the countries that moved; the
# verdict is the worst of them. A change that moved nothing, or one country's takes, is answered by the one recording.
# --all-recordings dispatches every recording at once, without the pre-diff; --one-recording never more than one.
# With --no-wait only the first is dispatched; collecting it with --run says which recordings a cross-country change
# still needs.
#
# THE REMOTE. IDENTITY_MEASURE_REMOTE, else `forgejo` when the clone has one (CI's forge since GitHub suspended the account
# on 2026-10-19), else origin. Every gh call goes through scripts/forge-gh, Forgejo's API on a Forgejo checkout.
#
# THE BRANCH. The workflow runs a commit only from a ref, so the commit is pushed as `measure/<user>/<short sha>-<random>`
# -- the one kind of branch push this repository allows besides main, ONLY to run a build. The pre-push hook checks
# nothing on a measure/ ref (it never lands), so the push needs no --no-verify. It is deleted at the end:
# success, failure, Ctrl-C (which also cancels the run) alike. A commit
# whose workflows predate the takes-only dispatch gets main's .github/ and scripts/ci/ laid over it in a commit of
# its own (no identity path: the check diffs only identity code, so the measured code is the commit's).
#
# REUSE. A measurement is the takes rows' base and head resolves over the pinned recording, classified HERE with the
# judgements. An earlier run of (B0, H0) answers (B1, H1) -- collected again, no push, no dispatch -- when
#   - the change is the same: `git patch-id --stable` of B..H over the files that can move a take -- the paths under
#     .github/convergence-paths.txt less the CI plumbing (.github/, scripts/ but the takes check's own), plus what the
#     takes check reads beyond them (its resolve dump under worker/src/it, the ratchet spec, the checked-in captures)
#     -- is equal (the key it is stored under), AND
#   - main moved only outside them: `git diff B0 B1` touches none (matched by .github/actions/changed-paths/matches.sh,
#     as kick-convergence.sh matches them), so the base resolves alike, AND `git diff H0 H1` touches none either: the
#     patch-id ignores whitespace and line numbers, so it finds a candidate but never proves the head the same.
# identity-judgements.tsv is left out of all three: it moves no take, and collecting classifies with the head's own. A
# run is reused for at most IDENTITY_MEASURE_REUSE_HOURS (default 24) after it was DISPATCHED (a --run's from its
# createdAt, not from when it was collected): the pinned recording is renewed nightly, and a fresh dispatch measures
# over the newest. Stored per change under <cache>/measure/reuse/<patch-id>/<base>, written whole (temp file + mv),
# only for a run whose takes artifacts are downloaded in the cache -- by a measurement or a --run.
# `--take-paths` prints the take-moving patterns (at HEAD) and exits.
#
# THE RESULT CACHE (2026-10-23). Every verdict a measurement prints (LANDABLE or NOT LANDABLE, its table, the countries
# whose takes moved) is stored as an asset of the takes store's release (FIXTURE_RELEASE_TAG, convergence-fixtures, where
# the takes check stores its resolves): `measure-result-<key>.json`, the key a hash of the head and base shas, the
# recording (`pinned` or the run), the countries measured, the measure mode (takes, full, footprint) and THE TOOLING HASH
# -- the blobs of this script, identity_measure.py, the takes check and the workflows that run it, in this checkout. A
# repeat request with the same key prints the stored verdict in seconds (`CACHED verdict of run <id>`, exit as stored):
# no push, no dispatch, no download, from any clone. A pinned-pair verdict is answered for IDENTITY_MEASURE_CACHE_HOURS
# (default 24, as REUSE: the pinned pair is renewed), a named recording's for good. --no-cache, --fresh and --no-store
# never read it (only --no-store stores nothing either); --json neither reads nor stores (the cache holds the table).
# A --no-wait dispatch leaves its key beside the run's cache (<cache>/measure/<run>/result-key), so its --run stores
# the verdict -- when the checkout classifies with the head's own judgements. A cache that cannot be read or written
# is said and skipped, never a failed measurement. The head's judgements are part of the head, so a judgement made
# since is a new head and a new key.
#
# THE SWEEP. A SIGKILLed run (no trap runs) leaves its branch on origin. `--sweep` alone (opt-in: no measurement runs
# it, as it deletes remote branches and has not met the real origin yet) deletes every
# origin `measure/*` branch whose newest run of the workflow is COMPLETED more than IDENTITY_MEASURE_SWEEP_HOURS
# (default 24, as long as a measurement is reused) ago. A branch with a run still queued or in progress, or finished
# more recently (a `--no-wait` measurement awaiting its `--run`), stays; so does one with no run at all, whose age
# origin does not tell. Best effort: an unreachable origin or gh is said and skipped, never a failed measurement.
# Unexercised against the real origin so far (GitHub was suspended when it was written): the self-test stubs gh and git.
#
# THE LANE. A run from any branch but main has a convergence lane of its own (identity-model-convergence.yml's
# concurrency): it replaces no one's waiting run and waits behind no other measurement, only for runners. A run cancelled anyway
# (by hand) is dispatched again until the deadline.
#
# Exit: 0 LANDABLE, 1 NOT LANDABLE, 2 the measurement could not be made, 3 --footprint-only could not answer.
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/identity-tools.sh
. "$here/identity-tools.sh" # identity_locked, identity_put; tool-conventions.sh's bounded, usage_from_header, countries
workflow=identity-model-convergence.yml
ref="" base="" recording="" keep="" nowait="" wait_eta="" full="" fresh="" json="" run="" timeout_min=120 take_paths="" sweep=""
all_countries="" recordings=auto plan="" no_store="" footprint_measure="" footprint_traces="" no_cache="" tier=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base) base=$2; shift ;;
    --head) ref=$2; shift ;;
    --recording) recording=$2; shift ;;
    # one parser for both spellings (tool-conventions.sh): --countries pl,de and a repeatable --country cc
    --country|--countries|--country=*|--countries=*) country_flag "$@"; shift $((COUNTRY_FLAG_ARGS - 1)) ;;
    --keep-branch) keep=1 ;;
    --no-wait) nowait=1 ;;
    --wait) wait_eta=1 ;;
    --full) full=1 ;;
    --fresh) fresh=1 ;;
    --take-paths) take_paths=1 ;;
    --all-countries) all_countries=1 ;;
    --all-recordings) recordings=all ;;
    --one-recording) recordings=one ;;
    --plan) plan=1 ;;
    --footprint) footprint_measure=1 ;;
    --footprint-only) footprint_measure=only ;;
    --traces) footprint_traces=$2; shift ;;
    --no-store) no_store=1 fresh=1 ;;
    --no-cache) no_cache=1 ;;
    --tier) tier=$2; shift ;;
    --sweep) sweep=1 ;;
    --json) json=1 ;;
    --run) run=$2; shift ;;
    --timeout) timeout_min=$2; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) usage_error "unknown option $1" ;;
    *) ref=$1 ;;
  esac
  shift
done
[ -z "$wait_eta" ] || [ -z "$nowait" ] || usage_error "--wait and --no-wait contradict each other"
countries=$(selected_countries_csv)
# the countries named on the command line (empty: every leg), as the workflow's takes-countries
named_countries=""; [ "${#SELECTED_COUNTRIES[@]}" -eq 0 ] || named_countries=$countries
# prod-latest: the freshest complete nightly recording (prod_latest_run), resolved once, by the first country's marker
if [ "$recording" = prod-latest ]; then
  recording=$(prod_latest_run "${countries%%,*}") || exit 2
  echo "identity-measure: --recording prod-latest is run $recording" >&2
fi
[ -z "$recording" ] || [[ "$recording" =~ ^[0-9]+$ ]] || usage_error "--recording takes a run id or prod-latest, not $recording"

say() { echo "identity-measure: $*" >&2; }
# Exit 2 is "the measurement could not be made" (above), a failure and a usage slip alike: tool-conventions.sh's die.
# shellcheck disable=SC2034 # read by tool-conventions.sh (die, usage_error)
DIE_STATUS=2
# Dispatching, finding the run and waiting on it: scripts/ci/dispatch.sh. Every gh call is bounded: a hung API read
# must not hold the measurement (and its branch) forever.
. "$here/ci/dispatch.sh"
export DISPATCH_GH_TIMEOUT=${IDENTITY_MEASURE_GH_TIMEOUT:-90} DISPATCH_POLL_SECONDS=${IDENTITY_MEASURE_POLL:-30}
export DISPATCH_GH=$KINOWO_GH # scripts/forge-gh: Forgejo's API on a Forgejo checkout
remote=${IDENTITY_MEASURE_REMOTE:-}
[ -n "$remote" ] || { git remote get-url forgejo > /dev/null 2>&1 && remote=forgejo; } || remote=origin
# Forgejo cannot cancel a run through its API, so its run drops its own branch (THE BRANCH above)
run_drops_branch=""
[ "$("$KINOWO_GH" --which 2> /dev/null)" = forgejo ] && run_drops_branch=1

branch="" measured_run="" finished="" scratch=""
delete_branch() {
  bounded 120 git push -q "$remote" --delete "refs/heads/$branch" 2> /dev/null && { say "deleted branch $branch"; return; }
  # A push that failed may never have made the branch (ls-remote's 2: no such ref): nothing to delete.
  bounded 60 git ls-remote --exit-code "$remote" "refs/heads/$branch" > /dev/null 2>&1
  [ $? -eq 2 ] || say "could not delete branch $branch -- git push $remote --delete $branch"
}
cleanup() {
  # Run to the end: a second Ctrl-C (or the TERM after a first) mid-clean-up would leave the branch behind.
  trap '' INT TERM
  [ -z "$scratch" ] || rm -rf "$scratch"
  # Ctrl-C mid-run: the run would replay a branch about to vanish -- cancel it first.
  if [ -n "$measured_run" ] && [ -z "$finished" ] && [ -n "$run_drops_branch" ]; then
    # Forgejo: no API cancels a run, and the run deletes its own branch when it ends
    say "run $measured_run goes on (Forgejo has no API to cancel it; cancel it in the web UI if it should not) and deletes $branch when it ends"
    branch=""
  elif [ -n "$measured_run" ] && [ -z "$finished" ]; then
    say "cancelling run $measured_run"
    identity_gh "$DISPATCH_GH_TIMEOUT" run cancel "$measured_run" > /dev/null || say "could not cancel run $measured_run -- cancel it by hand"
  fi
  if [ -n "$branch" ] && [ -z "$keep" ]; then
    delete_branch
  elif [ -n "$branch" ]; then
    say "kept branch $branch"
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

[ -n "$take_paths$sweep" ] || bounded 120 git fetch -q "$remote" main || die "could not fetch $remote main" # --take-paths reads HEAD alone

# sweep_orphans: delete the origin measure/ branches whose newest run finished over IDENTITY_MEASURE_SWEEP_HOURS ago (THE SWEEP above)
sweep_orphans() {
  local heads ref name latest status created cutoff cutoff_epoch
  cutoff_epoch=$(( $(date +%s) - ${IDENTITY_MEASURE_SWEEP_HOURS:-24} * 3600 ))
  cutoff=$(date -u -d "@$cutoff_epoch" +%Y-%m-%dT%H:%M:%SZ 2> /dev/null || date -u -r "$cutoff_epoch" +%Y-%m-%dT%H:%M:%SZ)
  heads=$(bounded 60 git ls-remote --heads "$remote" 'refs/heads/measure/*') || { say "sweep: could not list $remote's measure/ branches"; return 0; }
  while read -r _ ref; do
    [ -n "$ref" ] || continue
    name=${ref#refs/heads/}
    latest=$(identity_gh "$DISPATCH_GH_TIMEOUT" run list --workflow "$workflow" --branch "$name" --limit 1 --json status,createdAt \
      --jq '.[0] | select(. != null) | "\(.status) \(.createdAt)"') || { say "sweep: could not read the runs of $name"; continue; }
    read -r status created <<< "$latest"
    [ "${status:-}" = completed ] && [[ "$created" < "$cutoff" ]] || continue
    if bounded 120 git push -q "$remote" --delete "$ref" 2> /dev/null; then say "sweep: deleted orphaned $name (run finished $created)"
    else say "sweep: could not delete $name"; fi
  done <<< "$heads"
}
if [ -n "$sweep" ]; then sweep_orphans; exit 0; fi

# ── collect: one finished run's takes rows → the table ───────────────────────────────────────────

# measure_download <run id> <cache dir> -> the run's identity-takes artifacts in <cache>/artifacts, downloaded once: run
# under identity_locked, so two agents collecting one run never download into (or read) the same directory at once
measure_download() {
  local id=$1 cache=$2 dl=$2/artifacts
  [ -f "$cache/downloaded" ] && return 0
  rm -rf "$dl"; mkdir -p "$dl"
  # gh_download: bounded, a failed read asked again; absent (3) is a run without takes, a failed read (1) no answer
  gh_download "$DISPATCH_GH_TIMEOUT" run download "$id" --pattern 'identity-takes-*' --dir "$dl"
  case $? in
    0) touch "$cache/downloaded" ;;
    3) say "run $id: no identity-takes artifact to download (a run from before the takes rows uploaded theirs?)" ;;
    *) say "could not download run $id's identity-takes artifacts (gh failed or timed out)"; return 1 ;;
  esac
}

collect() { # <run id> <commit whose judgements classify> [checkout: classify with its working tree's judgements]
  local id=$1 commit=$2 cache dl url rows judgements jobs checkout_judgements
  cache=$KINOWO_IDENTITY_CACHE/measure/$id dl=$KINOWO_IDENTITY_CACHE/measure/$id/artifacts
  # What THIS collect classifies with is its own, never the shared cache's: another agent's --run of the same run may
  # classify with other judgements at the same moment.
  scratch=$(mktemp -d) || die "could not make a scratch directory"
  rows=$scratch/rows.json judgements=$scratch/identity-judgements.tsv
  mkdir -p "$cache"
  url=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json url --jq .url) || die "could not read run $id"
  jobs=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json jobs --jq '(.jobs // [])[] | select(.name | endswith(" / takes")) | [.name, .conclusion] | @tsv') \
    || die "could not read run $id's jobs"
  { echo "{"; first=1
    while IFS=$'\t' read -r name conclusion; do
      [ -n "$name" ] || continue
      [ -n "$first" ] || echo ","; first=""
      printf '"%s": "%s"' "$(identity_country_code "${name% / takes}")" "${conclusion:-unfinished}"
    done <<< "$jobs"
    echo "}"; } > "$rows"
  identity_locked "measure-$id" measure_download "$id" "$cache" || die "run $id's takes could not be downloaded (above)"
  # --run re-classifies an older run with the judgements made since -- the checkout's, committed or not.
  checkout_judgements=${3:+$(git rev-parse --show-toplevel)/test/resources/fixtures/identity-judgements.tsv}
  if [ -n "$checkout_judgements" ] && [ -f "$checkout_judgements" ]; then
    cp "$checkout_judgements" "$judgements" && say "classifying with this checkout's judgements ($checkout_judgements)"
  elif ! git show "$commit:test/resources/fixtures/identity-judgements.tsv" > "$judgements"; then
    say "$commit holds no identity-judgements.tsv: classifying with $remote/main's"
    git show "$remote/main:test/resources/fixtures/identity-judgements.tsv" > "$judgements" || die "no judgements to classify with"
  fi
  python3 -I "$here/identity_measure.py" "$dl" --judgements "$judgements" --countries "$countries" --rows "$rows" \
    --run-url "$url" ${json:+--json} --moved-out "$cache/moved" --kind full | tee "$scratch/table.txt"
  local verdict=${PIPESTATUS[0]}
  collected_table=$scratch/table.txt collected_judgements=$judgements
  timings "$id" "$dl"
  return $verdict
}

# Where a measurement's time went, on stderr (the table, or --json, stays alone on stdout): the run's wait for runners
# and its length, each takes row's job (and its base row's: identity-takes-check.sh's THE BASE ROW), and each row's phases from identity-takes-check.sh's timings.tsv -- which
# phases a stored result spared ("reused") and which were resolved. A row from before the file was written has none.
timings() { # <run id> <artifacts dir>
  local id=$1 dl=$2 times cc file
  times=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json createdAt,startedAt,updatedAt,jobs --jq '
      def s: if . == null or . == "" then null else fromdateiso8601 end;
      # The run "starts" when created; it is the first job that waited for a runner (and, on the main lane, for the lane).
      ([.jobs[].startedAt | s | select(. != null)] | min) as $first |
      "run: created \(.createdAt), waited for runners \(($first - (.createdAt|s)) // "?")s, then ran \(((.updatedAt|s) - $first) // "?")s",
      (.jobs[] | select(.name | test(" / takes(-base)?$")) |
        "  \(.name): \(((.completedAt|s) - (.startedAt|s)) // "?")s \(.conclusion // "unfinished")")') \
    || { say "run $id: could not read its timings"; return 0; }
  say "timings of run $id"
  while IFS= read -r line; do say "  $line"; done <<< "$times"
  for file in "$dl"/identity-takes-*/timings.tsv; do
    [ -f "$file" ] || continue
    cc=${file%/timings.tsv}; cc=${cc##*/identity-takes-}
    say "  $cc phases: $(awk -F'\t' 'NR > 1 { printf "%s%s %ss (%s)", sep, $1, $2, $3; sep = ", " }' "$file")"
  done
}

sha256() { if command -v sha256sum > /dev/null; then sha256sum; else shasum -a 256; fi; }
# ── THE RESULT CACHE (above) ───────────────────────────────────────────────────────────────────────────────
result_release=${FIXTURE_RELEASE_TAG:-convergence-fixtures}
tooling_hash() { # the blobs of the measure's own tooling, in this checkout: a change to how it measures is a new key
  local root=$here/.. f
  for f in scripts/identity-measure scripts/identity_measure.py scripts/identity-tools.sh scripts/tool-conventions.sh \
           scripts/ci/dispatch.sh scripts/ci/identity-takes-check.sh scripts/ci/identity_takes.py scripts/ci/identity_takes_diff.py \
           .github/workflows/identity-model-convergence.yml .github/workflows/country-convergence-leg.yml; do
    [ -f "$root/$f" ] && printf '%s %s\n' "$f" "$(git hash-object "$root/$f")"
  done | sha256 | cut -c1-16
}
result_key() { # <mode> -> the asset name a verdict of this head, base, recording, countries and mode is stored under
  printf 'head=%s base=%s recording=%s countries=%s mode=%s tooling=%s' "$commit" "$base" "${recording:-pinned}" \
    "$countries" "$1" "$(tooling_hash)" | sha256 | cut -c1-32 | sed 's/^/measure-result-/; s/$/.json/'
}
# result_lookup <mode>: prints a stored verdict's table and returns its verdict (0 or 1); 10 when none answers
result_lookup() {
  local name file stored now max verdict run
  [ -z "$no_cache$fresh$json" ] || return 10
  name=$(result_key "$1") file=$(mktemp)
  if ! identity_gh "$DISPATCH_GH_TIMEOUT" release download "$result_release" -p "$name" -O "$file" --clobber > /dev/null 2>&1 \
      || ! verdict=$(jq -er '.verdict | select(. == 0 or . == 1)' "$file" 2> /dev/null); then
    rm -f "$file"; return 10
  fi
  stored=$(jq -r '.stored_at // 0' "$file") run=$(jq -r '.run // "?"' "$file") now=$(date +%s)
  max=$(( ${IDENTITY_MEASURE_CACHE_HOURS:-24} * 3600 ))
  if [ -z "$recording" ] && [ $((now - stored)) -gt "$max" ]; then
    say "cache: $name is $(( (now - stored) / 3600 ))h old, older than the pinned pair's ${IDENTITY_MEASURE_CACHE_HOURS:-24}h -- measuring"
    rm -f "$file"; return 10
  fi
  say "CACHED verdict of run $run ($1, ${recording:-pinned} $countries, stored $(date -u -r "$stored" +%Y-%m-%dT%H:%MZ 2> /dev/null || date -u -d "@$stored" +%Y-%m-%dT%H:%MZ)) -- --no-cache to measure again"
  say "commit $(git log --oneline -1 "$commit")"
  say "base   $(git log --oneline -1 "$base")"
  jq -j '.table' "$file"
  # the cross-country follow-up reads the countries that moved beside the run, as after a measurement
  mkdir -p "$KINOWO_IDENTITY_CACHE/measure/cached-$run" && jq -r '.moved // ""' "$file" > "$KINOWO_IDENTITY_CACHE/measure/cached-$run/moved"
  cached_run=cached-$run
  rm -f "$file"
  return "$verdict"
}
# result_store_as <asset name> <verdict> <run> <table file> [moved file]: best effort, said when it fails
result_store_as() {
  local name=$1 verdict=$2 dir file
  [ -z "$no_cache$no_store$json" ] && [ "$verdict" -le 1 ] && [ -s "$4" ] || return 0
  dir=$(mktemp -d) file=$dir/$name
  jq -n --arg head "$commit" --arg base "$base" --arg recording "${recording:-pinned}" --arg countries "$countries" \
     --arg key "$name" --argjson verdict "$verdict" --arg run "$3" --argjson at "$(date +%s)" --rawfile table "$4" \
     --arg moved "$(cat "${5:-/dev/null}" 2> /dev/null)" \
     '{key: $key, head: $head, base: $base, recording: $recording, countries: $countries, verdict: $verdict, run: $run,
       stored_at: $at, moved: $moved, table: $table}' > "$file" \
    && identity_gh 300 release upload "$result_release" "$file" --clobber > /dev/null 2>&1 \
    && say "cache: stored as $name on release $result_release" \
    || say "cache: could not store $name on release $result_release (the next request measures again)"
  rm -rf "$dir"
}
result_store() { result_store_as "$(result_key "$1")" "${@:2}"; } # <mode> <verdict> <run> <table> [moved]

# ── reuse: an earlier measurement of the same change, main moved only outside the paths that move a take ─────────────────
reuse_root=$KINOWO_IDENTITY_CACHE/measure/reuse
# The paths that can move a TAKE, as a patterns file; empty when <ref> has no convergence paths. The convergence paths
# less the judgements (matches.sh's `!`) and less the CI plumbing a leg runs (.github/, scripts/): a change there makes a
# run fail or report differently, never resolve differently -- 2026-10-15 a landing re-measured a083 for 13 minutes
# because main had moved only convergence-setup.sh and its siblings. The takes check's own scripts stay: they write
# the takes the measurement reads. And what the takes check reads that no convergence path names -- the leg's verdict
# never depended on them, the takes do (scripts/identity-measure-test.sh holds this list to identity-takes-check.sh's):
# the resolve dump and its shadow (worker/src/it), the ratchet spec the final takes run, and the captures they replay
# (identity-unmatched/; expected-matches.tsv is the ratchet's output, regenerated from the judgements).
convergence_patterns() { # <ref> -> file
  local f; f=$(mktemp)
  if git show "$1:.github/convergence-paths.txt" 2> /dev/null \
      | grep -v -E '^[[:space:]]*(\.github/|scripts/)' > "$f"; then
    git show "$1:.github/convergence-paths.txt" | grep -E '^scripts/ci/(identity-takes-check\.sh|identity_takes[a-z_]*\.py|corpus_shape_diff\.py)$' >> "$f"
    printf '%s\n' 'worker/src/it/**' 'worker/src/test/scala/services/identity/UnmatchedClustersRatchetSpec.scala' \
      'test/resources/fixtures/identity-unmatched/**' '!test/resources/fixtures/identity-unmatched/expected-matches.tsv' \
      '!test/resources/fixtures/identity-judgements.tsv' >> "$f"
    echo "$f"
  else rm -f "$f"; fi
}
if [ -n "$take_paths" ]; then
  patterns=$(convergence_patterns HEAD) || true
  [ -n "$patterns" ] || die "HEAD has no .github/convergence-paths.txt"
  cat "$patterns"; rm -f "$patterns"; exit 0
fi
in_convergence_paths() { "$here/../.github/actions/changed-paths/matches.sh" "$1"; } # <patterns> < paths -> true|false
# The change B..H as one patch-id over its convergence-path files; "empty" when it touches none of them.
change_id() { # <base> <head> <patterns>
  local files=() f id
  while IFS= read -r f; do
    [ -n "$f" ] && [ "$(printf '%s\n' "$f" | in_convergence_paths "$3")" = true ] && files+=("$f")
  done < <(git diff --name-only --no-renames "$1" "$2")
  [ "${#files[@]}" -gt 0 ] || { echo empty; return; }
  id=$(git diff --no-renames "$1" "$2" -- "${files[@]}" | git patch-id --stable | cut -d' ' -f1)
  [ -n "$id" ] && echo "$id"
}
# store_measurement <base> <head> <run id> <dispatched, epoch seconds>: the run answers this change from this base,
# written whole.
store_measurement() {
  local patterns id dir part
  [ -f "$KINOWO_IDENTITY_CACHE/measure/$3/downloaded" ] || return 0
  patterns=$(convergence_patterns "$1"); [ -n "$patterns" ] || return 0
  id=$(change_id "$1" "$2" "$patterns"); rm -f "$patterns"
  [ -n "$id" ] || return 0
  dir=$reuse_root/$id; mkdir -p "$dir"
  part=$(mktemp "$dir/.$1.XXXXXX") && printf '%s\t%s\t%s\n' "$3" "$2" "$4" > "$part" && mv -f "$part" "$dir/$1"
}
# find_measurement <base> <head> -> "<run> <stored base>" of a stored measurement answering it; 1 when none does.
find_measurement() {
  local patterns id entry b0 run h0 at now max moved
  patterns=$(convergence_patterns "$1"); [ -n "$patterns" ] || return 1
  id=$(change_id "$1" "$2" "$patterns")
  [ -n "$id" ] && [ -d "$reuse_root/$id" ] || { rm -f "$patterns"; return 1; }
  now=$(date +%s) max=$(( ${IDENTITY_MEASURE_REUSE_HOURS:-24} * 3600 ))
  for entry in $(ls -t "$reuse_root/$id"); do
    b0=$entry
    IFS=$'\t' read -r run h0 at < "$reuse_root/$id/$entry" || continue
    [ $((now - at)) -le "$max" ] || continue
    [ -f "$KINOWO_IDENTITY_CACHE/measure/$run/downloaded" ] || continue
    # a run that measured fewer countries (--countries), or over a named recording, answers no other measurement
    for cc in ${countries//,/ }; do [ -d "$KINOWO_IDENTITY_CACHE/measure/$run/artifacts/identity-takes-$cc" ] || continue 2; done
    grep -qs '^named' "$KINOWO_IDENTITY_CACHE/measure/$run"/artifacts/identity-takes-*/recording.txt && continue
    git cat-file -e "$b0^{commit}" 2> /dev/null && git cat-file -e "$h0^{commit}" 2> /dev/null || continue
    moved=$(git diff --name-only --no-renames "$b0" "$1" | in_convergence_paths "$patterns") || continue
    [ "$moved" = false ] || continue
    moved=$(git diff --name-only --no-renames "$h0" "$2" | in_convergence_paths "$patterns") || continue
    [ "$moved" = false ] || continue
    rm -f "$patterns"; echo "$run $b0"; return 0
  done
  rm -f "$patterns"; return 1
}

# THE TAKES ROWS, NOT THE RUN (2026-10-22). The verdict is the takes rows' artifacts, uploaded as each row ends; the run's
# tail -- request-bisect, timings -- is a job hop apiece, each queued behind every other run's work
# for a runner (on the old self-hosted CI it added 32 minutes to run 790's 52). So the wait ends at
# whichever comes first: every measured country's takes row done, or the run done (cancelled included). The jobs come
# from `run view --json jobs` (github.com: "<country> / takes"); Forgejo serves no run's jobs, but posts each job's
# result on the commit as a status, "Identity model convergence / takes (<country>)", whose link is the run's -- by its id
# (.../actions/runs/968), where the run's own url names its number (.../runs/435).
# Only where the RUN drops its own branch (Forgejo, run_drops_branch): on github.com this script deletes the branch at exit,
# which would pull it from under the run's tail. IDENTITY_MEASURE_EARLY_COLLECT=1|0 overrides (the self-test).
early_collect=${IDENTITY_MEASURE_EARLY_COLLECT:-$run_drops_branch}
[ "$early_collect" = 0 ] && early_collect=""
takes_rows_done() { # <run id> <sha>: every measured country's takes row has ended
  local id=$1 sha=$2 rows url slug cc state
  rows=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json jobs --jq '(.jobs // [])[] | [.name, .status] | @tsv') || return 1
  if [ -z "$rows" ]; then
    url=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json url --jq .url) || return 1
    slug=${url%/actions/runs/*}; slug=${slug#*://*/}
    rows=$(identity_gh "$DISPATCH_GH_TIMEOUT" api "repos/$slug/commits/$sha/statuses?limit=100" \
      --jq ".[] | select(.target_url == \"$url\" or (.target_url | endswith(\"/actions/runs/$id\"))) | [(.context | sub(\"^Identity model convergence / \"; \"\")), (.status // .state)] | @tsv") || return 1
    rows=$(sed -E 's/^takes \(([a-z-]+)\)/\1 \/ takes/' <<< "$rows")
  fi
  for cc in ${countries//,/ }; do
    state=$(awk -F'\t' -v n="$(identity_country_name "$cc") / takes" '$1 == n { print $2; exit }' <<< "$rows")
    case $state in completed|success|failure|error|cancelled|skipped) ;; *) return 1 ;; esac
  done
}
# --wait: the run and its ETA said once, before the wait (scripts/ci/dispatch.sh's run_eta)
say_eta() { # <run id>
  [ -n "$wait_eta" ] || return 0
  if run_eta "$workflow" measure/; then say "run $1: ETA $RUN_ETA_SAID -- waiting with backoff (60 s, x1.5, at most 5 min)"
  else say "run $1: no ETA (no recent measure run to time) -- waiting with backoff (60 s, x1.5, at most 5 min)"; fi
}
wait_for_takes() { # <run id> <sha> <seconds>: sets RUN_CONCLUSION -- the run's own, or `takes-done`; fails at the deadline
  local id=$1 sha=$2 end=$((SECONDS + $3)) view unread=0 delay=${IDENTITY_MEASURE_WAIT_FIRST:-60}
  RUN_CONCLUSION=""
  while :; do
    # ten unreadable reads in a row end the wait, as scripts/ci-wait's: one is a blip, ten are no answer
    if view=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$id" --json status,conclusion | jq -er '[.status, .conclusion // ""] | @tsv'); then unread=0
    else unread=$((unread + 1)); view=""; [ "$unread" -lt 10 ] || { say "run $id could not be read ten times in a row"; return 1; }; fi
    if [ "${view%%$'\t'*}" = completed ]; then RUN_CONCLUSION=${view#*$'\t'}; return 0; fi
    [ -n "$early_collect" ] && takes_rows_done "$id" "$sha" && { RUN_CONCLUSION=takes-done; return 0; }
    [ "$SECONDS" -lt "$end" ] || return 1
    if [ -n "$wait_eta" ]; then sleep "$delay"; delay=$(dispatch_backoff_next "$delay")
    else sleep "${DISPATCH_POLL_SECONDS:-30}"; fi
  done
}

if [ -n "$run" ]; then
  view=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$run" --json status,headBranch,headSha --jq '[.status, .headBranch, .headSha] | @tsv') \
    || die "could not read run $run"
  IFS=$'\t' read -r status run_branch run_sha <<< "$view"
  if [ "$status" != completed ]; then
    [ -z "$nowait" ] || { say "run $run is $status: collect it once it completes"; exit 2; }
    # wait here, bounded, rather than leave every caller its own poll loop (agents spent ~10 min a measurement on one)
    say "waiting for run $run ($status), at most --timeout $timeout_min minutes"
    say_eta "$run"
    wait_for_takes "$run" "$run_sha" $((timeout_min * 60)) || die "run $run gave no conclusion within --timeout $timeout_min minutes"
  fi
  case "$run_branch" in measure/*) branch=$run_branch ;; esac
  # its takes rows ended, the run's tail still reads the branch, and its last job deletes it
  if [ "${RUN_CONCLUSION:-}" = takes-done ]; then say "run $run: every takes row has ended -- collecting now"; [ -z "$run_drops_branch" ] || branch=""; fi
  collect "$run" "$run_sha" checkout
  verdict=$?
  # A takes-only measure run is stored for reuse: its base from the artifact, its head the commit (not main's CI laid
  # over it). A run whose head this clone lacks is not.
  run_base=$(cat "$KINOWO_IDENTITY_CACHE/measure/$run"/artifacts/identity-takes-*/base.txt 2> /dev/null | head -1)
  if [ "$verdict" -le 1 ] && [ -n "$branch" ] && [ -n "$run_base" ] && git cat-file -e "$run_sha^{commit}" 2> /dev/null; then
    [[ "$(git log -1 --format=%s "$run_sha")" == "measure: origin/main's CI over "* || "$(git log -1 --format=%s "$run_sha")" == "measure: forgejo/main's CI over "* ]] && run_sha=$(git rev-parse "$run_sha^")
    created=$(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$run" --json createdAt --jq .createdAt) \
      && created=$(python3 -I -c 'import sys, datetime; print(int(datetime.datetime.fromisoformat(sys.argv[1].replace("Z", "+00:00")).timestamp()))' "$created") \
      && store_measurement "$run_base" "$run_sha" "$run" "$created"
  fi
  # a --no-wait dispatch's verdict, stored under its request's key -- when classified with the head's own judgements
  if [ -s "$KINOWO_IDENTITY_CACHE/measure/$run/result-key" ] && [ -n "${collected_judgements:-}" ]; then
    IFS=$'\t' read -r key commit base rk_recording countries < "$KINOWO_IDENTITY_CACHE/measure/$run/result-key"
    [ "$rk_recording" = pinned ] && recording="" || recording=$rk_recording
    if [ "$(git hash-object "$collected_judgements")" = "$(git rev-parse -q --verify "$commit:test/resources/fixtures/identity-judgements.tsv" 2> /dev/null)" ]; then
      result_store_as "$key" "$verdict" "$run" "$collected_table" "$KINOWO_IDENTITY_CACHE/measure/$run/moved"
    else say "cache: not stored -- classified with this checkout's judgements, not ${commit:0:9}'s"; fi
  fi
  moved=$(cat "$KINOWO_IDENTITY_CACHE/measure/$run/moved" 2> /dev/null)
  if [ "$verdict" = 0 ] && [[ "$moved" == *,* ]]; then
    say "CROSS-COUNTRY: takes moved in $moved -- before landing, measure the other recordings too (THE RECORDINGS):"
    say "  scripts/identity-measure --head ${run_sha:0:12} --base ${run_base:0:12} --countries $moved --all-recordings"
  fi
  exit $verdict
fi

# ── measure: push, dispatch, wait, collect ────────────────────────────────────────────────────────
commit=$(git rev-parse --verify -q "${ref:-HEAD}^{commit}") || die "no commit ${ref:-HEAD}"
[ -z "$ref" ] && [ -n "$(git status --porcelain --untracked-files=no)" ] && say "WARNING: uncommitted changes are not measured -- only $commit"
if [ -z "$base" ]; then
  base=$(git merge-base "$commit" "$remote/main") || die "no merge-base of $commit and $remote/main"
  [ "$base" = "$commit" ] && base=$(git rev-parse "$commit^")
fi
base=$(git rev-parse --verify -q "$base^{commit}") || die "no base commit $base"

# ── the footprint and the recordings (THE FOOTPRINT, THE RECORDINGS above) ───────────────────────────────────────────
footprint() { # <base> <head> -> the countries the change can move a take in, in KINOWO_COUNTRIES order; empty: none
  local patterns f reach="" out="" cc
  patterns=$(convergence_patterns "$1"); [ -n "$patterns" ] || { kinowo_countries_csv; return; }
  # each take-moving path's countries, as the identity area's test-impact selection reads them (scripts/ci/identity_impact.py)
  reach=$(while IFS= read -r f; do
            [ -n "$f" ] && [ "$(printf '%s\n' "$f" | in_convergence_paths "$patterns")" = true ] && printf '%s\n' "$f"
          done < <(git diff --name-only --no-renames "$1" "$2") \
          | python3 "$here/ci/identity_impact.py" countries "$1" "$2" --tree "$(git rev-parse --show-toplevel)") || reach=all
  rm -f "$patterns"
  for cc in "${KINOWO_COUNTRIES[@]}"; do
    [[ ",$reach," == *",all,"* || ",$reach," == *",$cc,"* ]] && out+="${out:+,}$cc"
  done
  echo "$out"
}
csv_and() { local a out="" ; for a in ${1//,/ }; do [[ ",$2," == *",$a,"* ]] && out+="${out:+,}$a"; done; echo "$out"; } # <a> <b>: a ∩ b
# holds_of <run> -> the countries whose corpus the recording run holds (its scrape-fixtures-<cc> artifacts), read from the
# forge; fails when they cannot be read. A run of github.com's era (e.g. 38713274617) is on no Forgejo: it holds nothing
# there, and every leg replaying it failed "the pinned pair has expired" (runs 884-893, 2026-10-21).
repo_slug() { git remote get-url "$remote" | sed -E 's#\.git$##; s#^.*[:/]([^/:]+/[^/]+)$#\1#'; }
holds_of() {
  local names cc out=""
  names=$(identity_gh "$DISPATCH_GH_TIMEOUT" api "repos/$(repo_slug)/actions/runs/$1/artifacts" --jq '.artifacts[]?.name') || return 1
  # ...or archived: the identity-recordings release keeps the landing recordings' corpora past their artifacts
  # (scrapes-<cc>-<run>.tar.*; .github/scripts/convergence-setup.sh `corpus` reads them back). Absent release: none.
  names+=$'\n'$(identity_gh "$DISPATCH_GH_TIMEOUT" api "repos/$(repo_slug)/releases/tags/${RECORDING_ARCHIVE_TAG:-identity-recordings}" \
    --jq '.assets[]?.name' 2>/dev/null | sed -nE "s/^scrapes-([a-z]+)-$1\\.tar\\.(gz|zst)$/scrape-fixtures-\\1/p" || true)
  for cc in "${KINOWO_COUNTRIES[@]}"; do grep -qx "scrape-fixtures-$cc" <<< "$names" && out+="${out:+,}$cc"; done
  echo "$out"
}
# The other recordings: "<run> <the countries it holds>" lines, the pinned pair (or --recording) left out. A spec's
# `:<countries>` names what it holds; without one it is read from the forge (every country when it cannot be read), and
# a recording holding none is left out, said. IDENTITY_MEASURE_RECORDINGS: what is on Forgejo since the suspension --
# 528 (2026-10-20, all five; the pinned pair is 573).
other_recordings() {
  local spec rec holds
  for spec in ${IDENTITY_MEASURE_RECORDINGS-528}; do
    rec=${spec%%:*} holds=${spec#*:}
    if [ "$holds" = "$spec" ]; then holds=$(holds_of "$rec") || holds=$(kinowo_countries_csv); fi
    [ -n "$holds" ] || { say "recording $rec holds no corpus on this forge: skipped"; continue; }
    [ "$rec" != "${recording:-pinned}" ] && echo "$rec $holds"
  done
}
# fan_out <countries> <recording lines>: measure this change over each recording at once (each its own measurement, its
# own branch and run), print each one's table, and answer the worst verdict: NOT LANDABLE over could-not-measure.
fan_out() {
  local ccs=$1 rec holds on dir pids=() logs=() i worst=0 code
  dir=$(mktemp -d)
  while read -r rec holds; do
    [ -n "$rec" ] || continue
    on=$(csv_and "$ccs" "$holds"); [ -n "$on" ] || continue
    say "measuring over recording ${rec} too ($on), in parallel"
    logs+=("$dir/$rec") 
    "$0" --head "$commit" --base "$base" ${rec:+$( [ "$rec" = pinned ] || echo "--recording $rec")} --countries "$on" --one-recording \
      ${json:+--json} ${tier:+--tier "$tier"} --timeout "$timeout_min" > "$dir/$rec" 2>&1 &
    pids+=($!)
  done <<< "$2"
  for i in "${!pids[@]}"; do
    wait "${pids[$i]}"; code=$?
    echo; echo "── recording ${logs[$i]##*/} ──"; cat "${logs[$i]}"
    if [ "$code" = 1 ] || { [ "$code" = 2 ] && [ "$worst" = 0 ]; }; then worst=$code; fi
  done
  rm -rf "$dir"
  return "$worst"
}
# then_cross_country <verdict> <run>: the pre-diff's follow-up -- the other recordings, for the countries that moved, when
# the one recording was LANDABLE and two or more countries moved.
then_cross_country() {
  local verdict=$1 moved
  [ "$verdict" = 0 ] && [ "$recordings" = auto ] || return "$verdict"
  moved=$(cat "$KINOWO_IDENTITY_CACHE/measure/$2/moved" 2> /dev/null)
  [[ "$moved" == *,* ]] || return 0
  say "CROSS-COUNTRY: takes moved in $moved -- measuring the other recordings for them (--one-recording skips this)"
  fan_out "$moved" "$(other_recordings)"
}

if [ -z "$named_countries$all_countries$full" ]; then # (named_countries: dispatch.sh re-sources tool-conventions.sh, emptying SELECTED_COUNTRIES)
  reach=$(footprint "$base" "$commit")
  if [ -z "$reach" ]; then say "footprint: the change touches no path that can move a take -- measuring every country"
  elif [ "$reach" != "$countries" ]; then
    say "footprint: only $reach can move (--all-countries to measure every country)"
    countries=$reach named_countries=$reach
  fi
fi
# A named recording must hold the countries measured: one it lacks fails every leg of the run, an hour in.
if [ -n "$recording" ] && held=$(holds_of "$recording"); then
  [ -n "$held" ] || die "recording $recording holds no corpus on this forge (a github.com-era run?): use the pinned pair (no --recording) or one of IDENTITY_MEASURE_RECORDINGS"
  if [ -n "$named_countries" ] && [ -n "$(csv_and "$countries" "$held")" ] && [ "$(csv_and "$countries" "$held")" != "$countries" ] && [ -z "$all_countries" ]; then
    die "recording $recording holds only $held, not all of --countries $countries"
  fi
  narrowed=$(csv_and "$countries" "$held")
  [ -n "$narrowed" ] || die "recording $recording holds $held: none of $countries"
  [ "$narrowed" = "$countries" ] || { say "recording $recording holds $held: measuring $narrowed"; countries=$narrowed named_countries=$narrowed; }
fi
if [ -n "$plan" ]; then
  echo "footprint ${countries}"
  if [ "$recordings" = all ]; then
    echo "measure ${recording:-pinned} $countries"
    while read -r rec holds; do on=$(csv_and "$countries" "$holds"); [ -z "$rec" ] || [ -z "$on" ] || echo "measure $rec $on"; done <<< "$(other_recordings)"
  else
    echo "measure ${recording:-pinned} $countries"
    [ "$recordings" = one ] || echo "then, when LANDABLE and 2+ countries moved: $(other_recordings | tr '\n' ';' | sed 's/;$//')"
  fi
  exit 0
fi
# ── the footprint measure (THE FOOTPRINT MEASURE above) ───────────────────────────────────────────
# footprint_rule_path <path>: whether the resolve reads a change there only through the title normaliser's readings
footprint_rule_path() {
  case $1 in
    common/src/main/scala/services/titlerules/TitleRulePlaceholders.scala) return 1 ;; # FormatTags reads it directly
    common/src/main/resources/title-rules.tsv|common/src/main/scala/services/titlerules/*.scala) return 0 ;;
    common/src/main/scala/services/movies/TitleNormalizer.scala) return 0 ;;
  esac
  return 1
}
# The takes check's identity paths (its own list, read as scripts/identity-measure-test.sh reads it), and its country code:
# the key a side's trace is stored under.
footprint_code() { # <sha>
  local paths
  read -ra paths <<< "$(sed -n '/^identity_paths=(/,/)/p' "$here/ci/identity-takes-check.sh" | sed -e 's/^identity_paths=(//' -e 's/)$//' | tr '\n' ' ')"
  [ "${#paths[@]}" -gt 0 ] || return 1
  git ls-tree -r "$1" -- "${paths[@]}" | sha256 | cut -c1-24
}
# footprint_classpath <tree> -> testkit's runtime classpath in the tree, compiled once (sbt only when a source is newer)
footprint_classpath() {
  local tree=$1 cp=$1/target/identity-tools/testkit-classpath log=$1/target/identity-tools/testkit-sbt.log
  if [ -s "$cp" ] && [ -z "$(find "$tree/geodata/src" "$tree/common/src" "$tree/identity/src" "$tree/testkit/src" "$tree/build.sbt" -newer "$cp" -name '*.s*' -print -quit 2> /dev/null)" ]; then
    cat "$cp"; return 0
  fi
  mkdir -p "$(dirname "$cp")"
  say "footprint: compiling the head's title rules in $tree"
  jvm_slot_take identity-measure
  # shellcheck disable=SC2046 # jvm_cpu_options: none, or one option
  if ! (cd "$tree" && sbt $(jvm_cpu_options | sed 's/^/-J/') -batch "testkit/compile" "export testkit/Runtime/fullClasspath") > "$log" 2>&1; then
    jvm_slot_release; tail -20 "$log" >&2; say "footprint: the head's compile failed ($log)"; return 1
  fi
  jvm_slot_release
  grep -E '^/[^ ]*testkit/target/' "$log" | tail -n 1 > "$cp"
  [ -s "$cp" ] || { rm -f "$cp"; say "footprint: no classpath in sbt's output ($log)"; return 1; }
  cat "$cp"
}
# footprint_measure -> 0 and the table when no take can move; 10 (said why) when the full measure must decide
footprint_measure() {
  local f code names cc asset size trace tree cp dir rc moved="" started=$SECONDS out
  # 1. a title-rule change, and nothing else that can move a take
  local patterns; patterns=$(convergence_patterns "$commit")
  [ -n "$patterns" ] || { say "footprint: $commit has no .github/convergence-paths.txt -- the full measure"; return 10; }
  while IFS= read -r f; do
    [ -n "$f" ] && [ "$(printf '%s\n' "$f" | in_convergence_paths "$patterns")" = true ] || continue
    footprint_rule_path "$f" && continue
    rm -f "$patterns"
    say "footprint: $f can move a take outside the title rules -- no trace says what it decides: the full measure"
    return 10
  done < <(git diff --name-only --no-renames "$base" "$commit")
  rm -f "$patterns"
  # 2. the base's traces, one a footprint country, over the recording
  local traces=() ccs=()
  if [ -n "$footprint_traces" ]; then
    for cc in ${countries//,/ }; do
      [ -s "$footprint_traces/$cc.jsonl.gz" ] || { say "footprint: no $footprint_traces/$cc.jsonl.gz -- the full measure"; return 10; }
      say "footprint: $cc's base readings: $footprint_traces/$cc.jsonl.gz (--traces: you vouch they are ${base:0:9}'s)"
      traces+=("$footprint_traces/$cc.jsonl.gz"); ccs+=("$cc")
    done
  fi
  code=$(footprint_code "$base") || { say "footprint: no identity paths in the takes check -- the full measure"; return 10; }
  [ -n "$footprint_traces" ] || names=$(identity_gh "$DISPATCH_GH_TIMEOUT" release view "${FIXTURE_RELEASE_TAG:-convergence-fixtures}" --json assets \
      --jq '.assets | sort_by(.createdAt) | reverse | .[] | "\(.name) \(.size)"') \
    || { say "footprint: could not list the release's traces -- the full measure"; return 10; }
  dir=$KINOWO_IDENTITY_CACHE/footprint
  mkdir -p "$dir"
  [ -n "$footprint_traces" ] || for cc in ${countries//,/ }; do
    read -r asset size <<< "$(grep -E "^takes-trace-$cc-$code-${recording:+n$recording}${recording:-p[0-9]+}\.gz " <<< "$names" | head -1)"
    [ -n "${asset:-}" ] || { say "footprint: no trace of $cc at the base's identity code ($code, ${base:0:9}) over ${recording:+recording $recording}${recording:-the pinned pair} -- the full measure"; return 10; }
    trace=$dir/${asset%.gz}.$size.jsonl.gz
    # (kept by its name and size: the newest trace of a code over a recording replaces an older one under the same name)
    if [ ! -s "$trace" ]; then
      if ! { identity_gh 1800 release download "${FIXTURE_RELEASE_TAG:-convergence-fixtures}" -p "$asset" -O "$trace.part.gz" --clobber > /dev/null \
             && gunzip -c "$trace.part.gz" > "$trace.part"; }; then
        rm -f "$trace.part" "$trace.part.gz"; say "footprint: could not download $asset -- the full measure"; return 10
      fi
      rm -f "$trace.part.gz"; mv -f "$trace.part" "$trace"
    fi
    say "footprint: $cc's base readings: $asset"
    traces+=("$trace"); ccs+=("$cc")
  done
  # 3. each read again under the head's rules (IDENTITY_MEASURE_TRACE_CHECK: the self-test's stand-in, no tree or JVM)
  local check=()
  if [ -n "${IDENTITY_MEASURE_TRACE_CHECK:-}" ]; then check=("$IDENTITY_MEASURE_TRACE_CHECK")
  else
    tree=$(identity_tree "$commit" testkit/src/main/scala/services/movies/NormalizerTraceCheck.scala) || { say "footprint: could not lay out ${commit:0:9} -- the full measure"; return 10; }
    cp=$(footprint_classpath "$tree") || return 10
    check=("${IDENTITY_JAVA[@]}" -cp "$cp" services.movies.NormalizerTraceCheck)
  fi
  out=$(mktemp -d) || return 10
  local i
  for i in "${!ccs[@]}"; do
    cc=${ccs[$i]}
    "${check[@]}" --out "$out/differ-$cc.tsv" "${traces[$i]}" > "$out/check-$cc.txt" 2>&1
    rc=$?
    say "footprint: $cc: $(grep '^\[normalizer-trace\]' "$out/check-$cc.txt" | tail -1 | sed 's/^\[normalizer-trace\] //')"
    case $rc in
      0) ;;
      1) moved+="${moved:+,}$cc"
         say "footprint: $cc reads titles otherwise -- takes may move (the first of them: country, method, arguments, base, head):"
         head -20 "$out/differ-$cc.tsv" | sed 's/^/    /' >&2 ;;
      3) say "footprint: $cc: some readings cannot be made again (above; $out/differ-$cc.tsv) -- no proof either way"; moved+="${moved:+,}$cc" ;;
      *) cat "$out/check-$cc.txt" >&2; say "footprint: $cc's readings could not be checked -- the full measure"; return 10 ;;
    esac
  done
  if [ -n "$moved" ]; then
    say "footprint: $moved can move -- the full measure decides ($((SECONDS - started))s spent)"
    return 10
  fi
  # 4. no take can move: the measure's own table, every footprint country unmoved
  for cc in "${ccs[@]}"; do
    mkdir -p "$out/identity-takes-$cc"
    echo "$base" > "$out/identity-takes-$cc/base.txt"
    echo "identity takes ($cc): footprint -- every one of the base's title readings reads alike under the head's rules: no take can have moved" \
      > "$out/identity-takes-$cc/verdict.txt"
  done
  local judgements=$out/identity-judgements.tsv
  git show "$commit:test/resources/fixtures/identity-judgements.tsv" > "$judgements" 2> /dev/null \
    || git show "$remote/main:test/resources/fixtures/identity-judgements.tsv" > "$judgements"
  say "footprint: proved in $((SECONDS - started))s"
  say "commit $(git log --oneline -1 "$commit")"
  say "base   $(git log --oneline -1 "$base")"
  printf '{%s}\n' "$(for cc in "${ccs[@]}"; do printf '"%s": "footprint",' "$cc"; done | sed 's/,$//')" > "$out/rows.json"
  python3 -I "$here/identity_measure.py" "$out" --judgements "$judgements" --countries "$countries" --rows "$out/rows.json" \
    ${json:+--json} --kind footprint | tee "$out/table.txt"
  rc=${PIPESTATUS[0]}
  result_store footprint "$rc" footprint "$out/table.txt"
  rm -rf "$out"
  return "$rc"
}
# The result cache: the full measure's verdict answers a footprint request too (it is the stronger), then a footprint's.
cached_run=""
measure_mode=takes; [ -z "$full" ] || measure_mode=full
if [ "$recordings" != all ] || [ -n "$nowait" ]; then
  for mode in $measure_mode ${footprint_measure:+footprint}; do
    result_lookup "$mode"; rc=$?
    [ "$rc" = 10 ] && continue
    [ "$mode" = footprint ] && exit "$rc"
    then_cross_country "$rc" "$cached_run"
    exit $?
  done
fi
if [ -n "$footprint_measure" ]; then
  footprint_measure; rc=$?
  [ "$rc" = 10 ] || exit "$rc"
  [ "$footprint_measure" != only ] || { say "--footprint-only: not measured in full (run without it to dispatch the full measure)"; exit 3; }
  say "measuring in full (measure: full)"
fi

if [ "$recordings" = all ] && [ -z "$nowait" ]; then
  fan_out "$countries" "$(printf '%s %s\n' "${recording:-pinned}" "$countries"; other_recordings)"
  exit $?
fi

if [ -z "$fresh$full$recording" ] && found=$(find_measurement "$base" "$commit"); then
  read -r reused_run reused_base <<< "$found"
  if [ "$reused_base" = "$base" ]; then how="the same base"; else how="main moved only outside the paths that move a take"; fi
  say "REUSED measurement of run $reused_run (base ${reused_base:0:9}, same change, $how) -- --fresh to dispatch"
  say "commit $(git log --oneline -1 "$commit")"
  say "base   $(git log --oneline -1 "$base")"
  collect "$reused_run" "$commit"
  verdict=$?
  result_store "$measure_mode" "$verdict" "$reused_run" "$collected_table" "$KINOWO_IDENTITY_CACHE/measure/$reused_run/moved"
  then_cross_country "$verdict" "$reused_run"
  exit $?
fi

# The commit's own workflows must know the takes-only dispatch and upload the check's output; an older commit gets
# main's laid over it.
push=$commit
# (Read whole, not piped into `grep -q`: under pipefail its early exit SIGPIPEs git show and reads as "no takes-only".)
leg=$(git show "$commit:.github/workflows/country-convergence-leg.yml") || leg=""
# (takes-countries: the leg that also knows --countries and --recording, 2026-10-21)
# (takes-no-store: the leg that can resolve without the store, 2026-10-22, for --no-store)
if [[ "$leg" != *takes-countries* ]] || { [ -n "$no_store" ] && [[ "$leg" != *takes-no-store* ]]; }; then
  push=$(identity_main_ci_over "$remote" "$commit" measure) || die "could not lay main's CI over $commit"
  say "$commit predates the takes-only dispatch: measuring it under $remote/main's .github/ and scripts/ci/ ($push)"
fi

branch=$(identity_measure_branch "$commit")
say "commit $(git log --oneline -1 "$commit")"
say "base   $(git log --oneline -1 "$base")"
# A push that fails -- or times out -- may still have made the branch: the clean-up deletes it either way.
# One measure/ push at a time on this machine: identity-landing-check pushes the same commit for its spec groups at once
identity_push_measure_branch "$remote" "$push" "$branch" || die "could not push the measure branch $branch: $MEASURE_PUSH_ERROR"
say "pushed $branch"

# One deadline for the whole measurement: every (re-)dispatch and the run.
deadline=$((SECONDS + timeout_min * 60))
dispatch() { # → measured_run
  local since only=(-f takes-only=true)
  [ -n "$full" ] && only=()
  [ -z "$recording" ] || only+=(-f recording="$recording")
  [ -z "$named_countries" ] || only+=(-f takes-countries="$named_countries")
  [ -z "$no_store" ] || only+=(-f takes-no-store=true)
  [ -z "$tier" ] || only+=(-f tier="$tier")
  say "dispatching (attempt $attempts)"
  dispatched_at=$(date +%s)
  identity_dispatch_measure "$workflow" "$branch" "$push" "identity-measure ${commit:0:9} against ${base:0:9}" \
    -f takes-base="$base" ${only[@]+"${only[@]}"} || die "$IDENTITY_DISPATCH_ERROR"
  measured_run=$DISPATCHED_RUN
  say "run $(identity_gh "$DISPATCH_GH_TIMEOUT" run view "$measured_run" --json url --jq .url || echo "$measured_run")"
  say_eta "$measured_run"
}

attempts=1
dispatch
if [ -n "$nowait" ]; then
  keep=1 finished=1
  # its --run stores the verdict under this request's key (THE RESULT CACHE), classified with the head's judgements
  [ -n "$no_cache$no_store$json" ] || { mkdir -p "$KINOWO_IDENTITY_CACHE/measure/$measured_run" \
    && printf '%s\t%s\t%s\t%s\t%s\n' "$(result_key "$measure_mode")" "$commit" "$base" "${recording:-pinned}" "$countries" \
       > "$KINOWO_IDENTITY_CACHE/measure/$measured_run/result-key"; }
  say "not waiting: collect with  scripts/identity-measure --run $measured_run   (it deletes $branch)"
  exit 0
fi

while :; do
  # A read blip (a refused connection once ended a 20-minute measurement) is retried by wait_for_run.
  wait_for_takes "$measured_run" "$push" $((deadline - SECONDS)) \
    || die "run $measured_run gave no conclusion within --timeout $timeout_min minutes"
  conclusion=$RUN_CONCLUSION
  # Cancelled by hand, or by a lane shared after all: dispatch again until the deadline, not a fixed few times.
  if [ "$conclusion" = cancelled ] && [ "$SECONDS" -lt "$deadline" ]; then
    say "run $measured_run was cancelled: dispatching again"
    attempts=$((attempts + 1)); dispatch; continue
  fi
  break
done
finished=1
if [ "$conclusion" = takes-done ]; then say "run $measured_run: every takes row has ended -- collecting now, the run's tail goes on without us"
  # its tail still reads the branch, and its last job deletes it
  [ -z "$run_drops_branch" ] || branch=""
else say "run $measured_run: $conclusion"; fi
collect "$measured_run" "$commit"
verdict=$?
[ "$verdict" -gt 1 ] || [ -n "$full$recording$no_store" ] || [ "$conclusion" = cancelled ] || store_measurement "$base" "$commit" "$measured_run" "$dispatched_at"
[ "$conclusion" = cancelled ] || result_store "$measure_mode" "$verdict" "$measured_run" "$collected_table" "$KINOWO_IDENTITY_CACHE/measure/$measured_run/moved"
then_cross_country "$verdict" "$measured_run"
exit $?
