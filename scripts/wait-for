#!/usr/bin/env bash
#
# Wait for a line in a file -- the one way an agent waits on its own long run (a slice batch, a local measure, an sbt
# suite, a capture). Run it with run_in_background and act on its notification; never a hand-written
# `until grep -q ...; do sleep; done` loop in the foreground, which held 2026-10-18's agents in 10-minute polls they
# could not leave (the agent-time buckets "poll: slice" / "poll: measure").
#
#   scripts/wait-for <file> --contains <text> [--timeout DURATION]   the file has a line containing <text>
#   scripts/wait-for <file> <pattern> [--timeout DURATION]           ... a line matching <pattern> (grep -E)
#   scripts/wait-for <file> [--timeout DURATION]                     ... any content at all (`until [ -s f ]`)
#     [--poll SECONDS] [--pid PID]
#
#   --contains  a literal text (grep -F) a line must contain; instead of <pattern>
#   <pattern>   an extended regex (grep -E) a line of <file> must match; the file may not exist yet
#   --timeout   give up after this long: whole seconds, or with a unit, 90s / 30m / 2h (default 2h). Every form is
#               bounded, so it is the fix unbounded-poll-guard prints for a background `until grep ...; sleep` loop.
#   --poll      seconds between looks (default 5)
#   --pid       the process writing the file: once it is gone and nothing matched, stop waiting (it never will)
#
# Prints the first matching line (with no pattern, the file's first line) and exits 0; exits 1 when --pid's process
# ended with no match (the file's last 20 lines printed), 2 on a timeout or a usage error.
set -uo pipefail
# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
case "${1:-}" in -h|--help) usage_from_header; exit 0 ;; esac
[ $# -ge 1 ] || usage_error "a file is required"
file=$1 pattern="" fixed="" timeout=7200 poll=5 pid=""
shift
case "${1:-}" in ""|--*) ;; *) pattern=$1; shift ;; esac
while [ $# -gt 0 ]; do
  case "$1" in
    --contains) flag_value "$@"; fixed=$2; shift 2 ;;
    --timeout) flag_value "$@"; timeout=$2; shift 2 ;;
    --poll) flag_value "$@"; poll=$2; shift 2 ;;
    --pid) flag_value "$@"; pid=$2; shift 2 ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done
# a usage error is 2, never the 1 that says the writer ended
[[ -n $pattern && -n $fixed ]] && usage_error "give a <pattern> or --contains, not both"
[[ $timeout =~ ^([0-9]+)([smh]?)$ ]] || usage_error "--timeout needs whole seconds or 90s / 30m / 2h, not '$timeout'"
case "${BASH_REMATCH[2]}" in
  m) timeout=$((BASH_REMATCH[1] * 60)) ;; h) timeout=$((BASH_REMATCH[1] * 3600)) ;; *) timeout=${BASH_REMATCH[1]} ;;
esac
[[ $poll =~ ^[0-9]+(\.[0-9]+)?$ ]] || usage_error "--poll needs seconds, not '$poll'"
[[ -z $pid || $pid =~ ^[0-9]+$ ]] || usage_error "--pid needs a process id, not '$pid'"
if [ -n "$fixed" ]; then what="line containing '$fixed'"; elif [ -n "$pattern" ]; then what="line matching /$pattern/"
else what="content"; fi

# The first line that answers, on stdout; non-zero when none does yet.
first_match() {
  [ -f "$file" ] || return 1
  if [ -n "$fixed" ]; then grep -m1 -F -- "$fixed" "$file"
  elif [ -n "$pattern" ]; then grep -m1 -E -- "$pattern" "$file"
  else [ -s "$file" ] && head -1 "$file"; fi
}

SECONDS=0
while :; do
  if line=$(first_match); then echo "$line"; exit 0; fi
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    # one last look: the writer may have finished between the two checks
    if line=$(first_match); then echo "$line"; exit 0; fi
    echo "wait-for: process $pid ended with no $what in $file; its last lines:" >&2
    [ -f "$file" ] && tail -20 "$file" >&2
    exit 1
  fi
  [ "$SECONDS" -lt "$timeout" ] || { echo "wait-for: no $what in $file after ${timeout}s" >&2; exit 2; }
  sleep "$poll"
done
