#!/usr/bin/env python3
# Purpose: sbt for agents, warm: one sbt server per checkout, kept between calls
#
# sbt for agents, warm: ONE sbt server per checkout, kept between calls, and a fresh checkout's compile seeded from the
# newest local build of main — so neither the JVM start (~40 s) nor the cold compile (~4–15 min) is paid per call.
# Python (scripts/lib/sbt_warm_*.py, jvm_gate.py, cpu_meter.py; this file is main(), the composition root). THE FALLBACK:
# KINOWO_SBT_WARM_LEGACY=1 runs the shell version it replaced (scripts/sbt-warm.sh-legacy) until five real landings
# have passed through this one; the two share every lock and record, so either may meet the other's server or keeper.
#
#   scripts/sbt-warm <sbt command>...    run the commands (each one argument, e.g. "worker/testOnly services.identity.X")
#                                        in this checkout's server — started, and seeded, when there is none
#   scripts/sbt-warm --ci <command>...   run the commands on ci-runner's measure lane instead (scripts/ci-sbt: this
#                                        checkout's HEAD plus its changes, `sbt -batch`), its verdict the command's own
#   scripts/sbt-warm --local <command>...  here, whatever the governor says (below)
#   scripts/sbt-warm --serve <command>   run a command that SERVES until stopped (a `runMain` fixture server) in this
#                                        checkout's server, which it keeps in use (never idle-stopped) while it serves
#   (an it/ run -- itAll, IntegrationTest/test* -- is refused without MONGODB_URI: scripts/it-local.sh runs it)
#   scripts/sbt-warm --exclusive <who> <command>...  run <command> (an sbt of its own over this checkout's target/:
#                                        it-local.sh's) once no command runs in this checkout's server, and hold every
#                                        later call's command until it ends: ONE BUILDER PER target/ (below)
#   scripts/sbt-warm --seed              only seed this checkout's compiled output (when it has none)
#   scripts/sbt-warm --publish           put this checkout's build into the shared build cache (when it is a clean build
#                                        of a main commit, and no command runs in its server)
#   scripts/sbt-warm --status            this checkout's server, and every kept one
#   scripts/sbt-warm --stop              stop this checkout's server and its keeper, returning once the keeper is gone and
#                                        its slot free (by pid, its own only: never `sbt --client shutdown`,
#                                        which reaches whatever server active.json names). Refused in the ROOT checkout
#                                        (a tool call starts there: four agents' clean-ups on 2026-10-15 stopped its
#                                        server instead of their own); --stop --root stops it on purpose
#   scripts/sbt-warm --reap              stop every kept server whose checkout is gone, or idle past the timeout
#
# ONE SERVER: a call finding several servers in the checkout stops them all and starts one; a seed never touches
# project/target/active.json of a checkout whose server lives (that made every call start a new server, 2026-10-15).
#
# SEEDING: a checkout with no worker/target/scala-* gets the compiled classes and Zinc state of the newest local build of
# a main commit — another worktree's, the root checkout's, or an identity tool's ref tree (~/.cache/kinowo-identity/refs)
# — whose commit this checkout's HEAD contains (the nearest such: while origin/main cannot move, a GitHub outage, local
# main runs ahead of it and an origin/main ancestor is days of commits off): project/target, project/project/target and */target/scala-*, the paths the CI's
# sbt-target-cache restores (APFS clones: no bytes copied), less project/target/active.json, the source's server socket. Zinc's analysis is relative to the checkout, so the first
# compile recompiles only what differs from that commit. KINOWO_SBT_WARM_SEED=<dir> names the source instead. A class
# file the source's Zinc analysis does not list as a product (another build wrote it) is not seeded: scripts/zinc_orphans.py.
#
# THE SHARED BUILD CACHE, $KINOWO_SBT_CACHE (default ~/.cache/sbt-movies-cache): one directory per main commit,
# <sha>/, holding a build of that commit's tree -- the same paths a seed copies, as APFS clones -- and the first place a
# seed looks (an entry wins a tie with a worktree's build at the same commit). A worktree's build may be half-written by
# a compile running in it, or hold the classes of edits never committed; an entry is published only from a CLEAN
# checkout (no tracked file changed, no untracked source) whose HEAD is on a remote's main, by a call whose command
# PASSED, holding $key.busy EXCLUSIVELY (no other call's command runs in the server: else it publishes nothing); copied
# to <sha>.part-<pid>, its orphan classes pruned (zinc_orphans.py), then renamed into place, so a seed never reads a
# partial entry. An entry is replaced only by a build of more configurations (its .zincs count); the replaced one is
# renamed <sha>.retired-<time> and deleted 10 min later, so a seed copying from it finishes. The newest
# $KINOWO_SBT_CACHE_KEEP (8) entries are kept; KINOWO_SBT_CACHE_PUBLISH=0 publishes nothing. Correctness never rests
# on an entry being exact: Zinc's analysis records every source's hash, so a seed recompiles whatever differs, and a
# stale TASTy read in that first incremental compile is recovered as in CI (ONE BUILD PATH, below).
#
# THE SERVER is sbt's own (`sbt --client`, one per checkout directory; each call logs the checkout and server it uses).
# Its state: $KINOWO_SBT_WARM_STATE (default ~/.cache/kinowo-sbt-warm); every call also reaps removed checkouts' servers.
#
# ONE JVM, ONE SLOT: a kept server holds one of the machine's JVM slots (scripts/jvm-gate.sh) for its whole life, idle or
# not, and the commands run in it take none. Servers started with the slot's descriptor closed held none, yet each grew
# to its -Xmx4g heap: ~10 worktrees' idle servers were up to 40 GB nobody counted, and on 2026-10-19 the Mac reached a
# load of ~100 with 29 of 30 GB of swap used. The slot is held by THE KEEPER, a small process beside the server (this
# script's --keep, started with descriptor 7 open, so the slot's kernel lock passes to it -- jvm_gate.keeper_start -- and
# is freed the moment it ends, however it ends: the flock model needs no counting of pid files, which a server dying
# between a count and a take would race). A call that finds the checkout's keeper alive (its lock, $key.keep.flock,
# held) takes no slot; one that finds none takes a slot (waiting for one like any tool) and starts the keeper with it.
# A keeper that starts without a slot (KINOWO_JVM_SLOTS=0 then, or past the slot deadline) takes one as soon as one is
# free. The keeper ends -- and its slot is free -- once the checkout has had no server for
# KINOWO_SBT_WARM_KEEPER_GRACE_SECONDS (60; a server's start or restart falls inside it) with no call running, or when
# --stop or --reap stops it with its server. ONE KEEPER PER CHECKOUT: $key.keep.flock's lock is the keeper's for its whole
# life, and the lock files are never deleted (a --stop that deleted it left the old keeper invisible: the next call
# started a second one, and waited for the slot the first held while keeping it alive -- a deadlock, 2026-10-19).
#
# IDLE EXIT: the keeper stops the server after $KINOWO_SBT_WARM_IDLE_MINUTES (default 10) minutes without a call running
# through this script, freeing its heap and its slot; the next call starts a fresh one (~40 s of JVM start, the compile
# kept on disk). 10, not 20-30: now that an idle server holds one of 4 slots, every idle minute is a minute another
# agent's test may queue, and an agent's edit-test loop calls far more often than that. It never stops a server under a
# running command: every call holds $key.busy's lock SHARED for its life, and the keeper stops the server only holding
# it EXCLUSIVELY (so a call arriving meanwhile waits for the stop, then starts a fresh server, counted); the last-used
# mark is also kept fresh by a heartbeat while a command runs. It stops the server when the checkout is removed, too. A
# call whose KINOWO_* settings differ from the server's restarts it only once no other call runs a command in it.
#
# ONE CALL, ITS CORES (the owner, 2026-11-18: the governor admits by CPU as well as memory): the keeper's ticket is the
# server's MEMORY, idle or not, charged no cores; each command run through the server takes a cores ticket of its own
# for its life (jvm_gate.JvmGate.cpu_take), charged its job's cores -- testUnit (a testUnit* alias), test (a whole
# module's test), testOnly, compile (only compiles, reloads, exports), serve, else job -- so eight warm servers no
# longer run eight testUnits at once on 18 cores. A call that passed records its cores (the CPU of the server's process
# tree over the call, its forked test JVMs included, sampled by cpu_meter.py, over its wall time: JvmGate.usage),
# and the governor charges a job its measured p75. The keeper's 0 cores and the call's charge never count one server
# twice: the server's work is the call's.
# A WHOLE-MODULE TEST of an agent's own (testUnit, <module>/test) the governor would hold now runs on ci-runner's measure
# lane when that is free (JvmGate.route; scripts/ci-sbt), said; KINOWO_SBT_WARM_ROUTE=local|ci|auto (auto) or --local/--ci
# decide instead (KINOWO_CI_SBT names scripts/ci-sbt: the tests' seam). A check's, a red fix's or a tool's run never
# leaves the laptop on its own.
#
# EVERY STOP IS LOGGED in $State/stops.log -- when, which server or keeper, the checkout, why, and the stopping process
# with its parents -- and a server its keeper saw end without one (a crash, the JVM reaper, a stray kill) is a "vanished"
# line there, naming the reaper's kill or a crash file when one does. Each keeper's own log is $State/<key>.log.
#
# ONE COMMAND AT A TIME: sbt runs a server's commands one after another, so a command still running in it -- a serving
# runMain whose caller is gone -- holds every later call's command queued, its sbtn client silent at 0% CPU, forever
# (2026-10-27: a land's pre-push compile waited 2.5 h behind an orphaned FixtureServerMain, holding the landing lock).
# So:
#   * a --serve call marks the server serving ($key.serving: its pid, its owner, the command). With
#     KINOWO_SBT_WARM_SERVE_OWNER=<pid> (scripts/page-tests-local passes its own) it stops the server the moment that
#     owner is gone, however it ended -- fixture-server.sh nohups the serve, so nothing else would.
#   * a call finding the server serving fails AT ONCE (exit 75, `sbt-warm BLOCKED: ...`) while the serve and its owner
#     live -- its command would wait for the serve's end -- and restarts the server when either is gone (an orphan).
#   * ONE BUILD PATH: the client runs through scripts/ci/sbt-guard/sbt, as every CI sbt call does: a command that failed
#     on a stale TASTy read (project/StaleTastyRetry.scala) is followed by `staleTastyDrop` in this server and run once
#     more -- a seeded checkout's first compile is incremental over another commit's classes, where that read happens.
#   * NO PROGRESS: a call whose server (with its forked JVMs) and client use no CPU for $KINOWO_SBT_WARM_STALL_SECONDS
#     (600) -- a command queued behind one that never ends, a dead server's socket, a deadlock -- writes the server's
#     thread dump to $State/<key>.stall-<time>.txt, stops it and runs the command once more in a fresh one; stalled
#     again, it fails: exit 75, `sbt-warm STALLED: <command> ...` (scripts/stall-watch.sh: THE STALL SIGNAL). A call
#     making progress touches $KINOWO_PROGRESS_FILE when set. A --serve call is never bounded: it serves, idle.
#
# ONE BUILDER PER target/: a plain `sbt -batch` in the same checkout while the server lives would compile into the same
# target/ — two Zincs over one classes dir delete each other's classes, and a run fails on the other's half-written
# build (the pre-push hook steps around a live one). Use this script, or --stop, or --exclusive: it holds $key.busy --
# the lock every call holds SHARED while its command runs -- EXCLUSIVELY for its command's life (the command inherits
# the lock, so a killed wrapper frees nothing under a running sbt). It waits for the server's running commands to end
# (up to KINOWO_SBT_WARM_LOCK_SECONDS, 1800), and a call arriving meanwhile waits for it, saying who holds the build
# ($key.exclusive). scripts/it-local.sh runs its sbt so (2026-11-20: an itAll failed only because worker/Test was
# compiling in the server); the it/ suites run in the sbt JVM itself and read the MONGODB_URI of its environment, which
# a kept server, started before, cannot take.
from __future__ import annotations

import datetime
import fcntl
import glob
import hashlib
import os
import platform
import sys
import time
from typing import Callable, List, MutableMapping, Optional, Tuple

HERE = os.path.dirname(os.path.realpath(__file__))
SELF = os.path.join(HERE, "sbt-warm")
sys.path.insert(0, os.path.join(HERE, "lib"))
sys.path.insert(0, HERE)

import machine  # noqa: E402
from jvm_gate import Governor, Host, JvmGate, SubprocessCommands, lock_busy  # noqa: E402
from jvm_memory import Clock, MemoryGate, SlotWait  # noqa: E402
from sbt_warm_cache import Builds, Places  # noqa: E402
from sbt_warm_call import Call, Tools  # noqa: E402
from sbt_warm_keeper import Keeper, KeeperSettings  # noqa: E402
from sbt_warm_servers import Checkout, Procs, Servers, read  # noqa: E402
import tool_git  # noqa: E402
from tool_cli import UsageError, header_usage  # noqa: E402


def usage() -> str:
    """The header above, as tool-conventions.sh's usage_from_header prints a shell tool's."""
    return header_usage(os.path.realpath(__file__))


def legacy(argv: List[str]) -> None:
    """THE FALLBACK: the shell version, its $0 this file's path (its keeper is `scripts/sbt-warm --keep`, and the
    keeper's call, inheriting KINOWO_SBT_WARM_LEGACY, comes back here)."""
    machine.replace(["bash", "-c", '. "$0.sh-legacy"', SELF, *argv])


def say_to_stderr(stamped: bool, now: Callable[[], datetime.datetime]) -> Callable[[str], None]:
    def say(line: str) -> None:
        stamp = " " + now().strftime("%Y-%m-%d %H:%M:%S") if stamped else ""
        sys.stderr.write(f"[sbt-warm]{stamp} {line}\n")
        sys.stderr.flush()
    return say


def raw_stderr(line: str) -> None:
    sys.stderr.write(line + "\n")
    sys.stderr.flush()


def checkout_root() -> str:
    code, out = machine.output(["git", "rev-parse", "--show-toplevel"])
    return os.path.realpath(out.strip() if code == 0 and out.strip() else os.getcwd())


def compose(env: MutableMapping[str, str], keeper: bool) -> Tools:
    """THE COMPOSITION ROOT: every collaborator a call (or the keeper) uses."""
    home = os.path.expanduser("~")
    env.setdefault("KINOWO_IDENTITY_CACHE", os.path.join(home, ".cache/kinowo-identity"))
    state = env.get("KINOWO_SBT_WARM_STATE") or os.path.join(home, ".cache/kinowo-sbt-warm")
    os.makedirs(state, exist_ok=True)
    root = checkout_root()
    checkout = Checkout(root, hashlib.sha1(root.encode()).hexdigest()[:12], state)
    now = datetime.datetime.now
    log = say_to_stderr(keeper, now)
    host = Host(env, os.getpid(), platform.system(), home, lambda: root, raw_stderr)
    governor = Governor(host, SubprocessCommands())
    memory = MemoryGate(env, Clock(time.sleep), raw_stderr, lambda: governor.bin() is not None, platform.system())
    slots = os.path.join(env["KINOWO_IDENTITY_CACHE"], "jvm-slots")
    gate = JvmGate(host, governor, memory, SlotWait(memory, slots), slots)
    servers = Servers(Procs(), state, log, time.sleep, now)
    runner = tool_git.shared_runner()
    places = Places(root, os.path.join(env["KINOWO_IDENTITY_CACHE"], "refs"),
                    env.get("KINOWO_SBT_CACHE") or os.path.join(home, ".cache/sbt-movies-cache"))
    builds = Builds(places, lambda where: tool_git.Git(runner, env, where), env, log, os.getpid())
    return Tools(checkout, env, servers, builds, gate, log, SELF, time.sleep)


def git_dir(flag: str) -> str:
    code, out = machine.output(["git", "rev-parse", "--path-format=absolute", flag])
    return out.strip() if code == 0 else ""


def stop(t: Tools, argv: List[str]) -> int:
    root = t.checkout.root
    if argv[1:2] != ["--root"] and git_dir("--git-dir") == git_dir("--git-common-dir"):
        t.log(f"refusing --stop in the root checkout ({root}): cd into your own worktree first, or --stop --root to stop "
              "the root's server")
        return 2
    if not t.servers.stop_checkout(t.checkout, root, "--stop"):
        t.log(f"no server of {root} to stop")
    return 0


def status(t: Tools) -> int:
    pid = t.servers.pid(t.checkout.root)
    print(f"this checkout ({t.checkout.root}): " + (f"server pid {pid}" if pid is not None else "no server"))
    for mark in sorted(glob.glob(os.path.join(glob.escape(t.checkout.state), "*.root"))):
        prefix = mark[: -len(".root")]
        pid_file, keep = prefix + ".pid", prefix + ".keep.flock"
        kept = read(pid_file) if os.path.exists(pid_file) else "?"
        keeper = read(keep) if lock_busy(keep) else "none"
        try:
            used = machine.local_text("%Y-%m-%d %H:%M", os.stat(prefix + ".used").st_mtime)
        except OSError:
            used = ""
        print(f"kept: {read(mark)} (pid {kept}, keeper {keeper}, last used {used})")
    return 0


def busy_descriptor(t: Tools) -> int:
    return os.open(t.checkout.file(".busy"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)


def exclusive_now(fd: int) -> bool:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return False
    return True


def publish(t: Tools) -> int:
    if exclusive_now(busy_descriptor(t)):
        t.builds.publish()
    else:
        t.log(f"a command runs in the server of {t.checkout.root}: nothing published")
    return 0


def exclusive(t: Tools, argv: List[str]) -> int:
    """--exclusive <who> <command>...: the command run holding $key.busy exclusively (it inherits the lock)."""
    if len(argv) < 3:
        t.log("--exclusive needs who runs it and the command")
        return 2
    who, command, fd, waited = argv[1], argv[2:], busy_descriptor(t), 0
    limit = int(t.env.get("KINOWO_SBT_WARM_LOCK_SECONDS") or 1800)
    while not exclusive_now(fd):
        if waited == 0:
            t.log(f"a command runs in the server of {t.checkout.root}: {who} waits for it to end before its own sbt "
                  "builds there")
        if waited >= limit:
            t.log(f"gave up after {waited}s waiting for the server of {t.checkout.root} to go idle")
            return 75
        t.sleep(1)
        waited += 1
    with open(t.checkout.file(".exclusive"), "w") as f:
        f.write(f"{os.getpid()} {who}\n")
    os.set_inheritable(fd, True)
    machine.replace(command)


def parsed(t: Tools, argv: List[str]) -> Tuple[str, List[str], bool]:
    """(route, commands, serve) of a command call's arguments; UsageError when it names no command."""
    route = t.env.get("KINOWO_SBT_WARM_ROUTE") or "auto"
    if argv[:1] in (["--ci"], ["--local"]):
        route, argv = argv[0][2:], argv[1:]
    if not argv:
        raise UsageError("no command to run")
    serve = argv[0] == "--serve"
    if serve and len(argv) < 2:
        raise UsageError("--serve needs the command it serves")
    return route, argv[1:] if serve else argv, serve


def routed(t: Tools, call: Call, route: str) -> str:
    """Where the call runs: auto sends a whole-module test the governor would hold to ci-runner (said)."""
    if route == "auto" and call.job in ("testUnit", "test") and t.gate.route(call.job) == "ci":
        t.log(f"the governor would hold `{call.command}` now and ci-runner's measure lane is free: running it there "
              "(--local runs it here)")
        return "ci"
    return route


def command_call(t: Tools, argv: List[str]) -> int:
    try:
        route, commands, serve = parsed(t, argv)
        call = Call(t, commands, serve)
        refused = call.refused()
        if refused is not None:
            return refused
        if routed(t, call, route) == "ci":
            if serve:
                raise UsageError("--ci cannot serve")
            ci_sbt = t.env.get("KINOWO_CI_SBT") or os.path.join(HERE, "ci-sbt")
            machine.replace([ci_sbt, "--", call.command])
    except UsageError as e:
        t.log(str(e))
        return 2
    call.fetch_gitops()
    return call.run()


def keep(t: Tools) -> int:
    home = os.path.expanduser("~")
    return Keeper(t.checkout, t.servers, t.gate, KeeperSettings.read(t.env, home), t.log, time.sleep,
                  datetime.datetime.now).run()


def main(argv: List[str]) -> int:
    first = argv[0] if argv else ""
    if first in ("", "-h", "--help"):
        sys.stdout.write(usage())
        return 0
    env = machine.environment()
    if env.get("KINOWO_SBT_WARM_LEGACY") == "1":
        legacy(argv)
    t = compose(env, keeper=first == "--keep")
    if first == "--keep":
        return keep(t)
    if first == "--reap":
        t.servers.reap(float(t.env.get("KINOWO_SBT_WARM_IDLE_MINUTES") or 10))
        return 0
    if first == "--seed":
        t.builds.seed()
        return 0
    actions = {"--publish": lambda: publish(t), "--exclusive": lambda: exclusive(t, argv), "--stop": lambda: stop(t, argv),
               "--status": lambda: status(t)}
    action: Optional[Callable[[], int]] = actions.get(first)
    return action() if action is not None else command_call(t, argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
