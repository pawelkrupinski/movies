#!/usr/bin/env bash
# Purpose: Print a directory whose python3 imports timezonefinder, for the pre-push drift check
# Prints a directory whose python3 imports timezonefinder, for the pre-push `drift` check to put first on PATH
# (data/us/scripts/generate_roster.py needs it; every other roster generator is stdlib-only, so the same python3 runs
# them all).
#
#   scripts/timezonefinder-python        # -> /Users/x/.cache/kinowo-timezonefinder/<key>/bin
#   PATH="$(scripts/timezonefinder-python):$PATH" scripts/ci/generated-artefacts-drift.sh
#
# scripts/python-venv over scripts/timezonefinder-requirements.txt (every version pinned): the PATH's python3 when it
# imports timezonefinder already (CI's), else a venv built once under $KINOWO_TIMEZONEFINDER_VENVS (default
# ~/.cache/kinowo-timezonefinder) and reused. Why a venv, not a pip install: scripts/python-venv's header.
#
# Exit 0 with the directory; 1 when the venv cannot be built, the pip log's tail on stderr.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$here/tool-conventions.sh"
case "${1:-}" in -h|--help) usage_from_header; exit 0 ;; "") ;; *) usage_error "no arguments expected: $1" ;; esac
KINOWO_PYTHON_VENVS="${KINOWO_TIMEZONEFINDER_VENVS:-${XDG_CACHE_HOME:-$HOME/.cache}/kinowo-timezonefinder}" \
    PYTHON_VENV_RERUN=scripts/timezonefinder-python \
    exec "$here/python-venv" "$here/timezonefinder-requirements.txt" timezonefinder
