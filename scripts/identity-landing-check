#!/usr/bin/env bash
# WILL THIS LAND GREEN? One command for an identity change before it is pushed to main: the measure AND the
# identity-relevant specs Main runs, one verdict.
#
# Why: on 2026-10-22 at least six Main reds came from changes `identity-measure` had called LANDABLE. The measure
# answers "did a take move", over the recording; Main's rows also hold the change to specs the measure never runs:
# MatchedTakesLabelSpec (edc0614db "Patrick Monahan", the 0089ce67e..2034c8a25 Cineamo/Jailbreakers judgements),
# IdentitySliceCasesSpec (3eee813cb's relay slice cases), UnmatchedClustersRatchetSpec, SearchQueryMarkersSpec, the
# title-rule golden/examples/mutation specs, the hard-cluster convergence (its outage recovery), FilmScheduleEndToEnd,
# IdentityCutoverEndToEnd and DocCommentPlacementSpec.
#
# usage: scripts/identity-landing-check [<commit> | --head REF] [--base SHA] [--full | --footprint-only] [--local]
#                                       [--no-measure | --no-specs] [--no-cache] [--no-what-if WHY] [--drift | --no-drift]
#   <commit>         default HEAD (committed only: uncommitted changes are neither measured nor tested)
#   --base           default the commit's merge-base with <remote>/main (identity-measure's)
#   (no mode flag)   the measure: `identity-measure --footprint` -- the footprint measure when the change is title rules
#                    alone and provably moves no take, otherwise the full measure (identity-measure falls back itself)
#   --full           the full measure, never the footprint (what a change LANDS on: the footprint is for iterating),
#                    over the whole convergence suite (identity-measure --full): every row Main's run has, so Main's run
#                    of the same tree reuses its verdict instead of running it again (scripts/ci/convergence_reuse.py)
#   --footprint-only the footprint measure or nothing (no dispatch): a measure it cannot answer is BLOCKED, said so
#   --local          the specs on the laptop (scripts/sbt-warm; the hard-cluster convergence through scripts/it-local.sh),
#                    one group after another -- each spec group's sbt-warm / it-local.sh takes a JVM slot (scripts/jvm-gate.sh). Default: on CI,
#                    each group its own `scripts/identity-ci-run` (identity-run.yml) at the commit, all at once
#   --no-measure     the specs only;  --no-specs  the measure only
#   --no-cache       passed to identity-measure: measure even when its result cache holds the verdict
#   --no-what-if WHY passed to identity-measure: dispatch without a scripts/identity-what-if verdict for the head and
#                    base (identity-measure's what-if gate refuses otherwise); name it in your report
#   --drift          the `drift` group whatever the change touches;  --no-drift  never (see THE DRIFT GROUP)
#
# THE SPECS: exactly the identity-relevant suites of Main's rows (ci.yml), each group as its row runs it:
#   unit        `test (worker-identity)` + `test (heavy1)` + `test (heavy2)` + the identity/common parts of `test (rest)` + the
#               worker lint and ratchet specs: every services.identity.* (worker and identity modules), services.titlerules.*
#               (the golden, examples and mutation specs), scripts.* (the capture re-resolves), DocCommentPlacementSpec,
#               HardClusterRatchetSpec
#   it          `integration-test (identity)`: HardClusterConvergenceIntegrationSpec (the hard clusters, outage recovery)
#   e2e-corpus  `e2e (corpus)`: FilmScheduleEndToEndSpec        } only when Main's scope would run the e2e rows for
#   e2e-rest    `e2e (rest)`'s identity specs: SearchQueryMarkers,  } this change (scripts/ci/ci-row-scope.sh e2e):
#               IdentityCutoverEndToEnd                          } judgements and identity tests alone do not
#
# THE DRIFT GROUP: the incremental = whole replay -- every `takes-drift-1|2 (<country>)` row of main's convergence run,
# the step behind 28 of 36 red convergence runs in the week to 2026-10-29 -- as scripts/identity-drift-ci's drift-only
# run (~25-40 min for all ten rows), beside the measure and the specs. On by default when
# the change touches a path in .github/identity-drift-paths.txt (the resolver, worker/src/main, the title rules, the
# replay harness, the flip predicate, the allow-lists); --full runs it anyway inside the whole suite, so not again.
# Each row is held against main's newest decided run (identity-drift-ci --against main): a row worse than main's -- more
# open findings, or red where main's is green -- BLOCKS; red only where main is, and no worse, does not (main's red has
# its own fixer).
#
# THE VERDICT, last on stdout: `LANDABLE`, or `BLOCKED` with each failing spec, the test, and a hint for its usual cause
# (e.g. MatchedTakesLabelSpec's "known-wrong in scope rows": judgement rows stale -> known-wrong scope rows). Every
# group's sbt log and the measure's output stay under target/identity-landing-check/<sha>/.
# Exit: 0 LANDABLE, 1 BLOCKED, 2 could not check (a group or the measure could not run: no verdict).
set -uo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/tool-conventions.sh
. "$here/tool-conventions.sh"
DIE_STATUS=2
ref=HEAD base="" mode=footprint local="" measure=1 specs=1 no_cache="" no_what_if="" drift=auto
while [ "$#" -gt 0 ]; do
  case "$1" in
    --head) flag_value "$@"; ref=$2; shift 2 ;;
    --base) flag_value "$@"; base=$2; shift 2 ;;
    --full) mode=full; shift ;;
    --footprint-only) mode=footprint-only; shift ;;
    --local) local=1; shift ;;
    --no-measure) measure=""; shift ;;
    --no-specs) specs=""; shift ;;
    --no-cache) no_cache=1; shift ;;
    --no-what-if) flag_value "$@"; no_what_if=$2; shift 2 ;;
    --drift) drift=1; shift ;;
    --no-drift) drift=""; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    -*) usage_error "unknown option $1" ;;
    *) ref=$1; shift ;;
  esac
done
[ -n "$measure$specs" ] || usage_error "--no-measure and --no-specs leave nothing to check"
say() { echo "identity-landing-check: $*" >&2; }
remote=${IDENTITY_MEASURE_REMOTE:-origin}
commit=$(git rev-parse --verify -q "$ref^{commit}") || die "no commit $ref"
[ "$ref" = HEAD ] && [ -n "$(git status --porcelain --untracked-files=no)" ] && say "WARNING: uncommitted changes are not checked -- only ${commit:0:9}"
if [ -z "$base" ]; then
  bounded 120 git fetch -q "$remote" main || say "could not fetch $remote main: the base is its last fetched state"
  base=$(git merge-base "$commit" "$remote/main") || die "no merge-base of $commit and $remote/main"
  [ "$base" = "$commit" ] && base=$(git rev-parse "$commit^")
fi
base=$(git rev-parse --verify -q "$base^{commit}") || die "no base commit $base"
out=${IDENTITY_LANDING_OUT:-$(git rev-parse --show-toplevel)/target/identity-landing-check/${commit:0:12}}
rm -rf "$out"; mkdir -p "$out"
say "commit $(git log --oneline -1 "$commit" | cut -c1-100)"
say "base   $(git log --oneline -1 "$base" | cut -c1-100)"

# ── the groups ─────────────────────────────────────────────────────────────────────────────────
# name <TAB> sbt command (a root testOnly runs in every aggregated module, so one command covers worker, identity and common)
groups=$'unit\ttestOnly services.identity.* services.titlerules.* scripts.* tools.DocCommentPlacementSpec tools.HardClusterRatchetSpec'
groups+=$'\nit\tworker/IntegrationTest/testOnly integration.HardClusterConvergenceIntegrationSpec'
e2e=$(git diff --name-only --no-renames "$base" "$commit" | "$here/ci/ci-row-scope.sh" e2e 2> /dev/null) || e2e=true
if [ "$e2e" = true ]; then
  groups+=$'\ne2e-corpus\te2e/testOnly services.movies.FilmScheduleEndToEndSpec'
  groups+=$'\ne2e-rest\te2e/testOnly services.movies.SearchQueryMarkersSpec services.movies.IdentityCutoverEndToEndSpec'
else
  say "e2e rows: Main's scope skips them for this change (scripts/ci/ci-row-scope.sh e2e) -- not run"
fi

# run_group <name> <command>: its sbt output in $out/<name>/sbt.log, its exit in $out/<name>/exit (0 passed, 1 failed, 2 not run)
run_group() {
  local name=$1 command=$2 dir=$out/$1 rc
  mkdir -p "$dir"
  if [ -n "$local" ]; then
    if [ "$name" = it ]; then (cd "$(git rev-parse --show-toplevel)" && "$here/it-local.sh" "$command") > "$dir/sbt.log" 2>&1
    else "$here/sbt-warm" "$command" > "$dir/sbt.log" 2>&1; fi
  else
    "${IDENTITY_LANDING_CI_RUN:-$here/identity-ci-run}" --head "$commit" --out "$dir/run" -- "$command" > "$dir/ci-run.log" 2>&1
    # the artifact's sbt.log (identity-run.yml tees it); a run that never made one is no answer
    [ ! -f "$dir/run/sbt.log" ] || cp "$dir/run/sbt.log" "$dir/sbt.log"
  fi
  # THE SBT LOG DECIDES, not the run's conclusion: the run's tail (its timings job) fails now and then and turns a run
  # whose every spec passed red (runs 1635, 1641, 1642 on 2026-10-23)
  rc=2; [ ! -f "$dir/sbt.log" ] || rc=$(sbt_verdict "$dir/sbt.log")
  echo "$rc" > "$dir/exit"
}
# sbt_verdict <sbt.log> -> 1 when sbt failed a command (a failed test, an error, a compile error), 0 when it ended with
# success, 2 when it never ended (a log cut short: no answer)
sbt_verdict() {
  local log; log=$(sed -E 's/\x1b\[[0-9;]*m//g' "$1")
  if grep -qE '\[error\] (Total time|Failed tests:|Error during tests:|.*Compilation failed)|\*\*\* (FAILED|ABORTED) \*\*\*' <<< "$log"; then echo 1
  elif grep -qE '\[success\] Total time' <<< "$log"; then echo 0
  else echo 2; fi
}
# the commit's tree, for --local: sbt-warm and it-local.sh test the working tree
if [ -n "$local" ] && [ -n "$specs" ] && [ "$(git rev-parse HEAD)" != "$commit" ]; then
  die "--local tests the working tree: check out ${commit:0:9} first (or run on CI, without --local)"
fi

# THE DRIFT GROUP (the header): on when the change touches a drift path; a --full measure runs the drift rows itself
if [ "$drift" = auto ]; then
  drift=""
  if [ "$mode" != full ] && git diff --name-only --no-renames "$base" "$commit" \
      | "$here/../.github/actions/changed-paths/matches.sh" "$here/../.github/identity-drift-paths.txt" | grep -qx true; then
    drift=1
  fi
fi

pids=()
if [ -n "$drift" ]; then
  say "drift: identity-drift-ci (every takes-drift row, drift-only)"
  "${IDENTITY_LANDING_DRIFT:-$here/identity-drift-ci}" --head "$commit" --against main --out "$out/drift/run" \
    > "$out/drift.txt" 2> "$out/drift.log" &
  drift_pid=$!
fi
if [ -n "$specs" ]; then
  if [ -n "$local" ]; then
    say "specs: on the laptop, one group after another ($(cut -f1 <<< "$groups" | tr '\n' ' '))"
    ( while IFS=$'\t' read -r name command; do run_group "$name" "$command"; done <<< "$groups" ) &
    pids+=($!)
  else
    say "specs: on CI, one identity-run per group, all at once ($(cut -f1 <<< "$groups" | tr '\n' ' '))"
    while IFS=$'\t' read -r name command; do run_group "$name" "$command" & pids+=($!); done <<< "$groups"
  fi
fi
if [ -n "$measure" ]; then
  flags=(--head "$commit" --base "$base")
  case $mode in footprint) flags+=(--footprint) ;; footprint-only) flags+=(--footprint-only) ;; full) flags+=(--full) ;; esac
  [ -z "$no_cache" ] || flags+=(--no-cache)
  [ -z "$no_what_if" ] || flags+=(--no-what-if "$no_what_if")
  say "measure: identity-measure ${flags[*]:4}"
  "${IDENTITY_LANDING_MEASURE:-$here/identity-measure}" "${flags[@]}" > "$out/measure.txt" 2> "$out/measure.log" &
  measure_pid=$!
fi
[ "${#pids[@]}" -eq 0 ] || wait "${pids[@]}"
measure_rc=""
if [ -n "$measure" ]; then wait "$measure_pid"; measure_rc=$?; fi
drift_rc=""
if [ -n "$drift" ]; then wait "$drift_pid"; drift_rc=$?; fi

# ── reading the failures ───────────────────────────────────────────────────────────────────────
# failures <sbt.log> -> "<Spec><TAB><test><TAB><its first detail line>" per failed test; a suite that failed with no
# test named (aborted, an error before its tests) as "<Spec><TAB>(the suite failed: see the log)"; a compile error as
# "compile<TAB><its first error>". Suites run in parallel and their output interleaves, so the "<Spec>:" header above a
# failure need not be its suite's. A failure is the suite its own location names ("(XSpec.scala:56)"); else the suite a
# failure worded alike was given; else the one suite sbt's summary lists failed that no failure has claimed yet; else
# the newest such unclaimed suite whose header came before it; else the newest failed suite's header above it.
failures() {
  sed -E 's/\x1b\[[0-9;]*m//g' "$1" | awk '
    function close_failure() { if (open) { loc[n] = location; open = 0 } }
    /\[error\] .*Compilation failed/ { compile = 1 }
    /\[error\] [^ ]+\.scala:[0-9]+:[0-9]+:/ && !first_error { first_error = $0; sub(/^.*\[error\] /, "", first_error) }
    /\[error\] (Failed tests|Error during tests):/ { close_failure(); summary = 1; next }
    summary && /\[error\][ \t]+[a-z][A-Za-z0-9_.$]*$/ { k = split($NF, p, "."); failed[p[k]] = 1; order[++m] = p[k]; next }
    summary { summary = 0 }
    /\[info\] +- / || match($0, /\[info\] [A-Z][A-Za-z0-9_$]*:$/) { close_failure() }
    match($0, /\[info\] [A-Z][A-Za-z0-9_$]*:$/) { spec = substr($0, RSTART + 7, RLENGTH - 8); seen = seen " " spec }
    /\*\*\* (FAILED|ABORTED) \*\*\*/ {
      t = $0; sub(/^.*\[info\] +(- )?/, "", t); aborted = ($0 ~ /ABORTED/); sub(/ \*\*\* (FAILED|ABORTED) \*\*\*.*$/, "", t)
      n++; test[n] = (aborted ? "(aborted) " : "") t; header[n] = spec; before[n] = seen; detail[n] = ""; location = ""; open = 1; lines = 0; next }
    open {
      if (++lines > 40) { close_failure(); next }
      d = $0; sub(/^.*\[info\] +/, "", d)
      if (detail[n] == "" && d != "") detail[n] = substr(d, 1, 400)
      if (location == "" && match(d, /\([A-Z][A-Za-z0-9_$]*\.scala:[0-9]+\)/)) location = substr(d, RSTART + 1, RLENGTH - 2)
    }
    END {
      close_failure()
      for (i = 1; i <= n; i++) {  # 1. the suite its own location names
        s = loc[i]; sub(/\.scala:.*/, "", s); who[i] = (s in failed) ? s : ""; if (who[i] != "") claimed[who[i]] = 1
      }
      for (i = 1; i <= n; i++) if (who[i] == "") {
        left = ""; c = 0; for (j = 1; j <= m; j++) if (!(order[j] in claimed)) { left = order[j]; c++ }
        for (j = 1; j <= n && who[i] == ""; j++) if (j != i && who[j] != "" && substr(test[j], 1, 40) == substr(test[i], 1, 40)) who[i] = who[j]  # 2. worded alike
        if (c == 1 && who[i] == "") who[i] = left  # 3. the one failed suite no failure claimed yet
        k = split(before[i], h, " ")
        for (j = k; j >= 1 && who[i] == ""; j--) if (h[j] in failed && !(h[j] in claimed)) who[i] = h[j]  # 4. the newest unclaimed header
        for (j = k; j >= 1 && who[i] == ""; j--) if (h[j] in failed) who[i] = h[j]  # 5. the newest failed header
        if (who[i] == "") who[i] = (header[i] != "" ? header[i] : "?")
        claimed[who[i]] = 1
      }
      for (i = 1; i <= n; i++) print who[i] "\t" test[i] "\t" detail[i]
      for (j = 1; j <= m; j++) if (!(order[j] in claimed)) print order[j] "\t(the suite failed: see the log)\t"
      if (compile) print "compile\t" (first_error ? first_error : "Compilation failed") "\t"
    }'
}
# hint <spec> <test> [<first detail line>] -> what usually makes it fail, and the way out
hint() {
  case "$1	$2	${3:-}" in
    MatchedTakesLabelSpec*known-wrong*)
      echo "judgement rows stale -> known-wrong scope rows: a judgement now denies a take the unified rows (IdentityUnifiedFit.Takes) hold; add it to identity-judgements.tsv as known-wrong in scope \`rows\` with why, or re-emit the rows (scripts/identity-calibrate.sh --takes)" ;;
    MatchedTakesLabelSpec*)
      echo "the unified rows' takes against the judgements: re-emit the rows (scripts/identity-calibrate.sh --takes) or fix the judgement rows the spec names" ;;
    IdentitySliceCasesSpec*unpinned*|IdentitySliceCasesSpec*not\ pinned*|IdentitySliceCasesSpec*lacks\ answers*)
      echo "slice case asks unpinned questions -> re-pin from the recording: scripts/identity-slice --emit-case over the case's listings" ;;
    IdentitySliceCasesSpec*)
      echo "a pinned slice case no longer takes its right film: the change regresses that listing (scripts/identity-slice --explain), or the case's expected.tsv is stale / asks unpinned questions -> re-pin from the recording (scripts/identity-slice --emit-case)" ;;
    UnmatchedClustersRatchetSpec*)
      echo "the capture ratchet: a new right take -> copy target/identity-unmatched/expected-matches.tsv over the checked-in one; a wrong one -> fix it, or known-wrong in scope \`capture\` with why (scripts/identity-ratchet-report)" ;;
    TitleRule*|PlaceholderExpanderSpec*|RuleScopeSpec*|SearchOnlyAffixesSpec*|PolishRewriteScopingSpec*|ProdTitlesNormalizationSpec*|FestivalTagSpec*|DiscoveredDecorationsSpec*)
      echo "title rules: the golden/examples/mutation tables hold every rule's readings -- a reading changed on purpose -> regenerate the golden/examples the spec names; otherwise the rule change reaches titles it should not" ;;
    SearchQueryMarkersSpec*)
      echo "a screening marker survives into a listing's title search: a title rule misses that spelling (add it to title-rules.tsv), or the marker vocabulary needs the word" ;;
    HardCluster*)
      echo "the hard clusters: a cluster's outage recovery or convergence lost its film -- fix it; an exemption (HardClusterExemptions) only with the user's OK, they only shrink" ;;
    FilmScheduleEndToEndSpec*|IdentityCutoverEndToEndSpec*)
      echo "end to end over the fixture corpus: the change moves a film the e2e corpus pins -- read the spec's diff in the log" ;;
    DocCommentPlacementSpec*)
      echo "a Scaladoc no longer sits directly on the member it documents (a blank line, a statement or a second doc between): move it" ;;
    compile*) echo "the commit does not compile at its tree" ;;
    *) echo "read its failure in the log" ;;
  esac
}

# why_not <log> <tool> -> ": <the tool's last word on why it stopped>" (e.g. identity-ci-run's "could not push
# measure/…: remote rejected (unable to migrate objects to permanent storage)"), or nothing when the log has none
why_not() {
  local last
  last=$(grep -E "^$2: " "$1" 2> /dev/null | tail -1)
  [ -z "$last" ] || echo ": ${last#"$2": }"
}
# ── the verdict ────────────────────────────────────────────────────────────────────────────────
blocked=() unknown=()
echo "identity landing check: ${commit:0:12} over ${base:0:12}"
if [ -n "$measure" ]; then
  verdict_line=$(grep -E '^(LANDABLE|NOT LANDABLE)' "$out/measure.txt" | head -1)
  case $measure_rc in
    0) echo "  measure     ${verdict_line:-LANDABLE}" ;;
    1) echo "  measure     NOT LANDABLE"; blocked+=("measure	NOT LANDABLE: $(sed -n '/^NOT LANDABLE/,$p' "$out/measure.txt" | sed -n '2,4p' | sed 's/^ *- //' | paste -sd';' -)	a take moved wrong or a right one was lost: the measure's table, $out/measure.txt (scripts/identity-slice --explain its listings)") ;;
    3) if grep -q 'STILL RUNNING' "$out/measure.log" 2> /dev/null; then
         echo "  measure     still running at --timeout, left running: collect with identity-measure --run <id> ($out/measure.log)"; unknown+=(measure)
       else echo "  measure     not answered by the footprint (--footprint-only)"; blocked+=("measure	--footprint-only could not answer	run without --footprint-only for the full measure"); fi ;;
    *) echo "  measure     could not measure$(why_not "$out/measure.log" identity-measure) ($out/measure.log)"; unknown+=(measure) ;;
  esac
fi
if [ -n "$drift" ]; then
  case $drift_rc in
    0) echo "  drift       $(tail -1 "$out/drift.txt")" ;;
    1) echo "  drift       $(tail -1 "$out/drift.txt")"
       blocked+=("drift	$(tail -1 "$out/drift.txt")	the incremental state ends elsewhere than a whole resolve, or a take flips on the way: each row's verdict and report lines in $out/drift.txt; a fix, never an allow-list entry (a list takes rows only at its check's birth: scripts/ci/commit_rules.py)") ;;
    *) echo "  drift       could not check$(why_not "$out/drift.log" identity-drift-ci) ($out/drift.log)"; unknown+=(drift) ;;
  esac
fi
if [ -n "$specs" ]; then
  while IFS=$'\t' read -r name _; do
    rc=$(cat "$out/$name/exit" 2> /dev/null || echo 2)
    found=""; [ ! -f "$out/$name/sbt.log" ] || found=$(failures "$out/$name/sbt.log")
    if [ "$rc" = 0 ] && [ -z "$found" ]; then echo "  $(printf '%-11s' "$name") passed"
    elif [ "$rc" = 2 ] && [ -z "$found" ]; then
      echo "  $(printf '%-11s' "$name") could not run$(why_not "$out/$name/ci-run.log" identity-ci-run) ($out/$name/)"; unknown+=("$name")
    else
      [ -n "$found" ] || found="$name	(sbt failed, no test named)"
      echo "  $(printf '%-11s' "$name") FAILED ($out/$name/sbt.log)"
      while IFS=$'\t' read -r spec test detail; do blocked+=("$spec	$test	$(hint "$spec" "$test" "$detail")"); done <<< "$found"
    fi
  done <<< "$groups"
fi
echo
if [ "${#blocked[@]}" -gt 0 ]; then
  echo "BLOCKED"
  for b in "${blocked[@]}"; do
    IFS=$'\t' read -r spec test why <<< "$b"
    echo "  - $spec: $test"
    echo "    hint: $why"
  done
  [ "${#unknown[@]}" -eq 0 ] || echo "  (and could not check: ${unknown[*]})"
  exit 1
fi
if [ "${#unknown[@]}" -gt 0 ]; then
  echo "NO VERDICT: could not check ${unknown[*]} -- see $out"
  exit 2
fi
echo "LANDABLE"
exit 0
