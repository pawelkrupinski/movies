#!/bin/sh
# Purpose: Organise imports with scalafix (.scalafix.conf: OrganizeImports, Scala 3 dialect), never by hand (a name for scalafix_organize.py)
# IMPORTS ORGANISED BY SCALAFIX -- the name its callers run (the test-layers skill, docs/landing-process.md):
# scripts/scalafix_organize.py is the tool, its header (`--help`) says what it does, and how.
exec python3 "$(dirname "$0")/scalafix_organize.py" "$@"
