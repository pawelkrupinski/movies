#!/bin/sh
# Purpose: Move a class to another package, its references rewritten compiler-checked (scalafix MoveSymbol) (a name for scalafix_move.py)
# A CLASS MOVED TO ANOTHER PACKAGE -- the name its callers run (the test-layers skill, docs/landing-process.md):
# scripts/scalafix_move.py is the tool, its header (`--help`) says what it does, and how.
exec python3 "$(dirname "$0")/scalafix_move.py" "$@"
