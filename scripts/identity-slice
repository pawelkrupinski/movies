#!/usr/bin/env bash
#
# Reproduce ONE listing's identity take — matched or not, model and agreement — from a recording, in seconds, at one or
# two git refs (docs/design/identity-slice.md). The listing's families and their corpus context are cut out of a "Record
# scrape fixtures" recording with every answer they read (TMDB, IMDb, the families, posters, catalogue links, venue pages)
# into a hermetic slice; each ref's code decides the slice again.
#
#   scripts/identity-slice <cc> SELECTOR... [--ref A [--ref B]] [--recording RUN] [--widen N] [--emit-case]
#   scripts/identity-slice <cc> --batch FILE --ref BASE --ref HEAD [--recording RUN]
#   scripts/identity-slice <cc> SELECTOR... --bisect A..B [--recording RUN]
#   scripts/identity-slice --log '<take-change log line (JSON)>'
#   scripts/identity-slice --compiles REF
#   scripts/identity-slice <cc> --faithfulness CONVERGENCE_RUN [--sample N] [--seed S]
#   scripts/identity-slice <cc> --explain [--venue S] [--title S] [--ref A [--ref B]] [--fixture SRC] [--limit N] [--no-resolve]
#
#   SELECTOR      --venue S --title S (substrings, case and accents aside; either alone), or --key 'venue|raw title' (exact)
#   --ref         decide under that ref's code (each laid out and compiled once into the cache); two refs print their takes
#                 side by side, then every listing that moved. Without --ref: this checkout's code.
#   --recording   the recording run, or `prod-latest` (the freshest complete nightly recording: prod's listings as of
#                 last night; scripts/identity-repro), default: the newest successful "Record scrape fixtures" run holding the
#                 country's corpus; older ones are tried in turn, each skip said. Every ref replays the
#                 SAME recording: the comparison is the code's, never the input's.
#   --widen N     N more rings of context: the context listings' own families joined to the slice
#   --orders N    also feed the slice to the INCREMENTAL model in N shuffled arrival orders (the worker's path) and name
#                 every listing whose take any order moves from the whole resolve's — nondeterminism, a mode flip
#   --batch FILE  one selector a line (`venue<TAB>raw title`, `*` for every venue, or `--venue S --title S`): every slice
#                 at both refs in ONE JVM per ref, and the moves tallied against the judgements — cured, lost, new-wrong
#   --bisect A..B the first commit of A..B whose take of the selected listings differs from A's (one ref compiled at a time)
#   --emit-drift-slice  pin the listing as a DRIFT SLICE (Tier 1 of the drift gate): the slice copied whole to
#                 test/resources/fixtures/drift-slices/<cc>/<selector>/, then replayed through IdentityDrift's incremental
#                 sequence (--slice --widen, $KINOWO_DRIFT_SLICE_SEEDS seeds, default 12) with every answer it lacks read from
#                 the recording and kept in it. IdentityDriftSlicesSpec replays every such slice. A drift or flip red is not
#                 closed until its listing's slice is committed (docs/landing-process.md). This checkout's code only.
#   --emit-case   pin the listing as a FAILING TEST: the slice copied to test/resources/fixtures/identity-slices/, its expected
#                 film taken from the judgements (never from the take), each shown with its own evidence; refused when
#                 they do not judge the listing. IdentitySliceCasesSpec replays every such slice.
#   --modes N     also take the slice through N CHANGED projections — the periodic one's own agreement stage again, over
#                 EVERY listing with those at a random half of the venues republished, as tickChanged reads them (the
#                 scraped venues re-read, every other venue's held) — and name every listing whose take a changed one flips
#   --drift       the WHOLE recording through production's incremental sequence instead of a slice (scripts.IdentityDrift):
#                 the model taken up with a share of the answers missing, ticks filing them, new venues' scrapes,
#                 re-scrapes, listings leaving and returning, two deploys (one changing the rules) through the stores' own
#                 BSON — and every listing whose take at a checkpoint differs from a whole resolve of the same listings
#                 named, beside the judgements; exit 1 on any test/resources/fixtures/identity-drift-allow.tsv does not
#                 name. No selector. At the first --ref (default this checkout), which must hold the tool. `--out` keeps
#                 the divergences' TSV. CI runs it in every hermetic leg's takes row (scripts/ci/identity-drift-check.sh)
#   --families P  prod's filed family answers, which no recording holds: an unmatched-cluster capture (default this
#                 checkout's test/resources/fixtures/identity-unmatched/<cc>.json.gz), or `none`. Without them the
#                 families agree on nothing — as in a hermetic leg. The slice keeps those it read, named as prod's.
#   --faithfulness capture  the agreement-taken listings (Agreed, Filled, Poster, …) of that capture as this code's agreement
#                 takes them, each sliced alone on the capture's recording and compared
#   --threads N   decide N slices at once in the one JVM (default: half the cores, at most 8); the output keeps the batch's order
#   --fresh       decide every slice again: by default a slice's result at a ref is kept (per recording, ref, tool files and
#                 filed answers, and the labels about its listings) and read back by every checkout asking it again
#   --serve       keep a JVM per (ref, recording, country) with the recording opened and the ref's index loaded, and send
#                 the batch to it: no JVM start or corpus load per call. Each kept JVM holds one of the machine's JVM
#                 slots (scripts/jvm-gate.sh) for its whole life, through a keeper process beside it; a call reaching a
#                 live one takes none. It stops after $KINOWO_IDENTITY_SLICE_IDLE_MINUTES (default 10) minutes without
#                 a request -- never during one -- freeing the slot; `scripts/identity-slice --stop-served` stops
#                 every kept one now
#   --out TSV     keep the takes (of the last --ref) as a TSV: selector key venue rawTitle film title basis … verdict
#   --labels TSV  judge the takes by this identity-judgements.tsv (default this checkout's) — the same at both refs
#   --compiles REF  lay REF out with this checkout's tool files dropped in and compile it, nothing else: the tool must
#                 compile into every ref it may be pointed at — a deployed worker's build, a bisect's oldest commit
#                 (scripts/identity-slice-old-ref-test.sh)
#   --log LINE    a prod `identity take change:` line from VictoriaLogs: its country, venue and listing, at its build
#   --explain     WHY a listing the unmatched-cluster capture holds took (or did not take) its film: the whole trace —
#                 billing and venue page, the captured model decision, the cluster re-resolved (keys, candidates, signals,
#                 refusals), the agreement stage's basis, fill rule and guards, the take and its label. Replays the capture,
#                 not a recording; a listing the MODEL took is not in it (slice it instead). scripts/identity-explain is an
#                 alias kept for the `repro` field prod's take-change lines print.
#     --fixture SRC  the capture to explain from (default: this checkout's): a directory holding <cc>.json.gz, an
#                 "Identity capture" run id, or a git ref holding one. Its judgements judge it (a run's: this checkout's).
#     --limit N, --no-resolve  at most N clusters; skip the re-resolve (the captured decision and the agreement only)
#   --faithfulness RUN  the slice's take of a sample of listings against what that "Identity model convergence" run's leg
#                 took (its convergence-diagnostics `<cc>-takes`), at the run's commit and its pinned recording
#   --prod-mirror [cc]  read prod's own state from the LOCAL prod mirror (scripts/local-mirror, :28017 — never prod): its
#                 filed family answers in preference to the capture's, the agreement stage's stored verdicts (the stage
#                 starts from them, as prod's does) and the operator pins; and print beside each take what prod's stored
#                 state takes now and why (model decision, trace, agreement verdict, correction, stored titles). With
#                 --faithfulness it also tallies the slice against prod's take. Checks the mirror's freshness first
#                 (scripts/local-mirror/freshness) and WARNs when it is older than the recording or more than
#                 $KINOWO_MIRROR_MAX_LAG_HOURS (default 6) hours behind — the slice would mix moments. [cc] must be the slice's.
#
# Everything downloaded or compiled is kept in $KINOWO_IDENTITY_CACHE (default ~/.cache/kinowo-identity), shared by every
# worktree: recordings/<run>/, slice/<run>/{index-<cc>-<code key>.json.gz, results/, slices/<selector>/}, refs/<sha>/. The
# first call on a recording resolves its corpus whole once per CODE (~25-50 s) -- keyed by content (code_key), so a commit
# or an edit changing no code reads the index another made -- later ones decide the slice alone (~1 s). A new ref's
# compile is seeded from the nearest compiled ref (identity_nearest_compiled); one with no source changed keeps its
# classpath. --emit-case goes through a kept JVM (--serve), so pinning cases one after another costs ~2 s each.
set -euo pipefail
# ONE compound command: bash reads all of it before running any, so an edit while it runs (a rebase, a pull, an agent's
# edit) cannot shift the text under its read offset (`pt: command not found`, the 2026-10-14 UK session stats)
{

# shellcheck source=scripts/tool-conventions.sh
. "$(dirname "$0")/tool-conventions.sh"
usage() { usage_from_header; }
case "${1:-}" in -h|--help) usage; exit 0 ;; "") usage >&2; exit 2 ;; esac

# shellcheck disable=SC2034 # read by identity-tools.sh's identity_log
IDENTITY_TOOL=identity-slice
# shellcheck source=scripts/identity-tools.sh
. "$(dirname "$0")/identity-tools.sh"
repo=$IDENTITY_REPO
# a ref the clone's history does not reach — a shallow clone's — fails by name, never as some other commit's code
need_ref() {
  git -C "$repo" rev-parse --verify -q "$1^{commit}" > /dev/null && return 0
  if [ "$(git -C "$repo" rev-parse --is-shallow-repository)" = true ]; then echo "no commit $1 in this SHALLOW clone: git fetch --unshallow" >&2
  else echo "no commit $1" >&2; fi
  exit 2
}

TOOL_FILES=(worker/src/test/scala/services/identity/OlderRefs.scala worker/src/test/scala/scripts/IdentitySlice.scala worker/src/test/scala/scripts/IdentityExplain.scala
  worker/src/test/scala/services/identity/IdentitySlicing.scala worker/src/fixtures/scala/tools/RecordedCorpus.scala
  worker/src/fixtures/scala/tools/SliceHttp.scala worker/src/fixtures/scala/tools/MemoLookups.scala
  worker/src/fixtures/scala/tools/CatalogueFill.scala worker/src/fixtures/scala/tools/FiledAnswers.scala
  worker/src/fixtures/scala/tools/ProdMirror.scala worker/src/fixtures/scala/tools/IdentityJudgements.scala
  worker/src/fixtures/scala/services/identity/adapters/OlderRefsPackage.scala common/src/main/scala/tools/TempDirectories.scala)

self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"
# A kept JVM's idle exit: as sbt-warm's kept server's (KINOWO_SBT_WARM_IDLE_MINUTES), 10 minutes, not 30 -- each holds a
# JVM slot while idle, and every idle minute is a minute another agent's tool may queue for it
idle_minutes=${KINOWO_IDENTITY_SLICE_IDLE_MINUTES:-10}
threads="" fresh=0 serve=0 families="" labels="" cc="" refs=() run="" pass=() batch="" bisect="" log="" faith="" sample=50 seed=1 explain=0 drift=0 fixture="" keep="" mirror="" mirror_args=() emit_drift=0
if [ "$1" = "--compiles" ]; then
  need_ref "${2:?--compiles REF}"
  t=$(identity_tree "$2" "${TOOL_FILES[@]}") && identity_classpath "$t" > /dev/null && { identity_log "$2 compiles with this checkout's tool files"; exit 0; }
  exit 1
fi
# 0 while <pid> is still an IdentitySlice server: a pid file outlives its process, and the pid comes back as someone
# else's JVM (an sbt server, another agent's run).
is_kept() { # <pid>
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  ps -o args= -p "$1" 2>/dev/null | grep -q 'scripts\.IdentitySlice'
}
# Stops the kept JVM a pid file names -- only while that pid is still one (is_kept).
stop_kept() { # <pid>
  is_kept "$1" || return 1
  kill "$1" 2>/dev/null
}
if [ "$1" = "--stop-served" ]; then
  for pidf in "$IDENTITY_CACHE"/serve/*.pid; do
    [ -f "$pidf" ] || continue
    stop_kept "$(cat "$pidf")" && identity_log "stopped the kept JVM $(cat "$pidf")"
    rm -f "$pidf" "${pidf%.pid}.sock" "${pidf%.pid}.tree" "${pidf%.pid}.keeper.log"
  done
  exit 0
fi
# THE KEEPER of a kept JVM (--keep-served <pid>, started by serve_at with the JVM slot's descriptor open: jvm-gate.sh's
# jvm_slot_keeper_start): holds that slot for the JVM's whole life, idle or not -- taking one as soon as one is free
# when it started without -- and ends once the JVM has (its idle exit, --stop-served, a crash), which frees the slot.
# Started the moment the JVM's process is, it may find it still the shell about to exec java (no IdentitySlice in its
# command line yet: under load the keeper ended at once, 2026-10-19), so that pid counts as the JVM while it lives
# until it has been seen as one; after that, only while it still is one (a pid that comes back as another process).
if [ "$1" = "--keep-served" ]; then
  identity_log "keeper of kept JVM $2: pid $$, $(jvm_slot_riding && echo "holding JVM slot ${KINOWO_JVM_SLOT_HELD##*/}" || echo "no JVM slot yet")"
  seen=0
  while kill -0 "$2" 2>/dev/null; do
    if is_kept "$2"; then seen=1; elif [ "$seen" = 1 ]; then break; fi
    if jvm_slot_take_if_free; then identity_log "took JVM slot ${JVM_SLOT##*/}"; fi
    sleep "${KINOWO_IDENTITY_SLICE_KEEPER_POLL:-10}"
  done
  identity_log "kept JVM $2 gone: done"
  exit 0
fi
if [ "$1" != "--log" ]; then cc=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]'); shift; fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --ref) flag_value "$@"; refs+=("$2"); shift 2 ;;
    --recording) flag_value "$@"; run=$2; shift 2 ;;
    --venue|--title|--key|--widen|--orders|--modes) flag_value "$@"; pass+=("$1" "$2"); shift 2 ;;
    --batch) batch=$(path_flag "$@") || exit 2; shift 2 ;;
    --bisect) flag_value "$@"; bisect=$2; shift 2 ;;
    # through a kept JVM: pinning cases one after another, each call reads the recording and the index once, not again
    # KINOWO_IDENTITY_SLICE_EMIT_ROOT pins elsewhere than the checkout's cases (scripts/identity-slice-refresh: a scratch root)
    --emit-case) pass+=(--emit-case "${KINOWO_IDENTITY_SLICE_EMIT_ROOT:-$IDENTITY_REPO/test/resources/fixtures/identity-slices}")
                 serve=${KINOWO_IDENTITY_SLICE_EMIT_SERVE:-1}; shift ;;
    --emit-drift-slice) pass+=(--emit-slice "$IDENTITY_REPO/test/resources/fixtures/drift-slices"); emit_drift=1; shift ;;
    --log) flag_value "$@"; log=$2; shift 2 ;;
    --faithfulness) flag_value "$@"; faith=$2; shift 2 ;;
    --sample) flag_value "$@"; sample=$2; shift 2 ;;
    --families) flag_value "$@"; if [ "$2" = none ]; then families=none; else families=$(path_flag "$@") || exit 2; fi; shift 2 ;;
    --seed) flag_value "$@"; seed=$2; shift 2 ;;
    --threads) flag_value "$@"; threads=$2; shift 2 ;;
    --fresh) fresh=1; shift ;;
    --serve) serve=1; shift ;;
    --explain) explain=1; shift ;;
    --drift) drift=1; shift ;;
    --out) keep=$(path_flag "$@") || exit 2; shift 2 ;;
    --prod-mirror) mirror=on
      if [ -n "${2:-}" ] && [[ $2 =~ ^[A-Za-z]{2}$ ]]; then mirror=$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]'); shift; fi; shift ;;
    --fixture) flag_value "$@"; fixture=$2; shift 2 ;;
    --limit) flag_value "$@"; pass+=("$1" "$2"); shift 2 ;;
    --no-resolve) pass+=("$1"); shift ;;
    --labels) labels=$(path_flag "$@") || exit 2; shift 2 ;;
    *) echo "unknown argument $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -n "$log" ]; then
  # a take-change line: its fields name the listing and the build that took it
  fields=$(printf '%s' "$log" | python3 -I -c 'import json,sys
d=json.load(sys.stdin)
print("\t".join([d.get("country",""), d.get("venue",""), d.get("listing",""), d.get("build",""), d.get("projection_mode","")]))')
  IFS=$'\t' read -r lcc lvenue llisting lbuild lmode <<< "$fields"
  [ -n "$lvenue" ] && [ -n "$llisting" ] || { echo "the log line names no venue and listing" >&2; exit 2; }
  [ -n "$cc" ] || cc=$lcc
  pass+=(--key "$lvenue|$llisting")
  [ "${#refs[@]}" -gt 0 ] || { [ -n "$lbuild" ] && [ "$lbuild" != unknown ] && refs+=("$lbuild"); }
  identity_log "the log line: $cc, '$lvenue' | '$llisting', build ${lbuild:-unknown}, projection ${lmode:-?} (the slice replays the whole resolve, as either mode does)"
fi
[ -n "$cc" ] || { usage >&2; exit 2; }
[ "${#refs[@]}" -le 2 ] || { echo "at most two --ref" >&2; exit 2; }
[ -z "$mirror" ] || [ "$mirror" = on ] || [ "$mirror" = "$cc" ] || { echo "--prod-mirror $mirror: the slice is $cc's — the mirror read is the slice's country" >&2; exit 2; }
[ -z "$mirror" ] || [ "$explain" = 0 ] || { echo "--prod-mirror reads prod's state beside a recording: slices and --faithfulness, not --explain" >&2; exit 2; }

# the local prod mirror, read only once its freshness is printed: WARNed loudly when it predates the recording or lags
# the clock (the slice would mix moments), refused when it is absent — never a fall-back to prod
use_mirror() {
  [ -n "$mirror" ] || return 0
  local recorded status=0
  recorded=$(python3 -I -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("recordedAt",""))
except Exception: print("")' "$recording/corpus/prod-coverage-$cc.json")
  identity_log "prod mirror: the local mirror's freshness (recording made ${recorded:-at an unknown time}):"
  "$repo/scripts/local-mirror/freshness" "$cc" --quiet --max-lag-hours "${KINOWO_MIRROR_MAX_LAG_HOURS:-6}" \
    --need identity_family_answers,identity_model_families,identity_traces,identity_agreements \
    ${recorded:+--not-before "$recorded"} >&2 || status=$?
  case "$status" in
    0) ;;
    3) identity_log "WARNING — THE PROD MIRROR IS NOT FRESH (above): prod's state it reads is not the recording's moment; read every PROD line with that in mind" ;;
    *) identity_log "no local prod mirror to read (above): scripts/local-mirror/service.sh install — --prod-mirror never reads prod itself"; exit 2 ;;
  esac
  mirror_args=(--prod-mirror "$(local_mongo_uri)")
  # whose code wrote that state: the worker build prod runs (the deploy moves `deployed-worker` once it is live)
  local deployed=${KINOWO_DEPLOYED_WORKER:-$(bounded 15 git -C "$repo" ls-remote origin refs/tags/deployed-worker 2>/dev/null | cut -f1 || true)}
  if [ -n "$deployed" ]; then
    identity_log "prod's state was written by the deployed worker ${deployed:0:9}: a PROD line of another ref's slice mixes builds"
    mirror_args+=(--deployed "$deployed")
  fi
}

work=$(mktemp -d "${TMPDIR:-/tmp}/identity-slice.XXXXXX"); trap 'rm -rf "$work"' EXIT

labels=${labels:-$repo/test/resources/fixtures/identity-judgements.tsv}
# prod's filed family answers (no recording holds them): this checkout's unmatched-cluster capture unless named
families=${families:-$repo/test/resources/fixtures/identity-unmatched/$cc.json.gz}

# Where each slice's result at <code key> is kept, shared by every checkout: per recording, the code (code_key: the ref's
# code with this checkout's tool files dropped in) and the filed answers. Nothing with --fresh, nor beside prod's moment.
results_of() { # <code key>
  [ "$fresh" = 0 ] && [ -z "$mirror" ] || return 0
  local fam=none
  [ -f "$families" ] && fam=$(shasum < "$families" | cut -c1-8)
  echo "$IDENTITY_CACHE/slice/$run/results/$1-$fam"
}
# What a whole-corpus index and a slice's result are a function of, besides the recording and the filed answers: the code
# a ref runs -- its main code, the fixtures package and the build -- with THIS checkout's tool files dropped in. Keyed by
# content, not commit: a commit that changes no code (a judgement, a spec, a doc) resolves nothing again. Measured
# 2026-10-15: recording 38547714686 held 252 indexes under 252 commits and worktree edits -- 12 distinct ones.
# The shasum of each NUL-separated path on stdin, and nothing for none -- not `xargs -0 shasum`: GNU xargs (CI's) runs
# shasum once on no input, hashing its empty stdin, so a checkout with no new file keyed otherwise than its commit.
hash_each() { local path; while IFS= read -r -d '' path; do shasum "$path" 2>/dev/null; done; }
CODE_PATHS=(geodata/src/main common/src/main identity/src/main scrapers/src/main worker/src/main worker/src/fixtures testkit/src/main build.sbt project)
code_key() { # <ref, or . for this checkout's code with its uncommitted edits>
  local listing
  if [ "$1" = "." ]; then
    listing=$( { git -C "$repo" ls-tree -r HEAD -- "${CODE_PATHS[@]}"
                 git -C "$repo" diff HEAD -- "${CODE_PATHS[@]}"
                 git -C "$repo" ls-files -z --others --exclude-standard -- "${CODE_PATHS[@]}" | (cd "$repo" && hash_each); } )
  else
    listing=$(git -C "$repo" ls-tree -r "$(git -C "$repo" rev-parse --verify "$1^{commit}")" -- "${CODE_PATHS[@]}")
  fi
  # the ref's own tool files are replaced by this checkout's: their lines go, these files' contents stand in
  { printf '%s\n' "$listing" | grep -v -F -f <(printf '\t%s\n' "${TOOL_FILES[@]}") || true
    (cd "$repo" && shasum "${TOOL_FILES[@]}"); } | shasum | cut -c1-24 | sed 's/^/code-/'
}
# run <tree> <ref label> <out.tsv> <args...> -> that tree's IdentitySlice (through its kept JVM with --serve)
run_at() {
  local tree=$1 ref=$2 out=$3 cp results code more=(); shift 3
  code=$(code_key "$(ref_of "$ref")")
  more+=(--index-key "$code")
  results=$(results_of "$code")
  [ -z "$results" ] || more+=(--results "$results")
  [ -z "$threads" ] || more+=(--threads "$threads")
  if [ "$serve" = 1 ] && [ -z "$mirror" ] && [ -z "$faith" ]; then serve_at "$tree" "$ref" "$out" "${more[@]}" "$@"; return; fi
  cp=$(identity_classpath "$tree") || return 1
  local rc=0
  jvm_slot_take identity-slice
  (cd "$tree" && "${IDENTITY_JAVA[@]}" -cp "$cp" scripts.IdentitySlice "$cc" --recording "$recording" --cache "$IDENTITY_CACHE/slice/$run" \
    --ref "$ref" --labels "$labels" --families "$families" --out "$out" ${mirror_args[@]+"${mirror_args[@]}"} ${more[@]+"${more[@]}"} "$@") || rc=$?
  jvm_slot_release
  return "$rc"
}
# The batch sent to the ref's kept JVM (IdentitySlice --serve), started when none is: the recording opened and the index
# loaded once per (tree, ref, country, recording, filed answers), not once per call. A JVM that died is started again.
serve_at() { # <tree> <ref key> <out.tsv> <args...>
  local tree=$1 ref=$2 out=$3 key sock cp rc=0; shift 3
  key=$(printf '%s\n' "$tree" "$ref" "$cc" "$recording" "$families" | shasum | cut -c1-16)
  sock=$IDENTITY_CACHE/serve/$key.sock
  for _ in 1 2; do
    if [ ! -S "$sock" ] || ! kill -0 "$(cat "$IDENTITY_CACHE/serve/$key.pid" 2>/dev/null || echo 0)" 2>/dev/null; then
      cp=$(identity_classpath "$tree") || return 1
      mkdir -p "$IDENTITY_CACHE/serve"; rm -f "$sock"
      retire_served "$tree" "$key"
      identity_log "starting a kept JVM for ${ref:0:24} (log $IDENTITY_CACHE/serve/$key.log; stops after $idle_minutes idle minutes)"
      # ONE JVM, ONE SLOT: up to 6 GB for its idle life too, so it is counted like sbt-warm's kept server -- this call
      # takes a slot (the memory gate first) and hands it to a keeper beside the JVM, which holds it until the JVM has
      # gone. The JVM is its own process group (set -m): it outlives this call and the shell or tool that ran it, so it
      # starts with the lock descriptors closed (jvm-gate.sh). A call reaching a live kept JVM takes no slot.
      jvm_slot_take identity-slice
      (cd "$tree" && set -m && { nohup "${IDENTITY_JAVA[@]}" -cp "$cp" scripts.IdentitySlice "$cc" --recording "$recording" \
          --cache "$IDENTITY_CACHE/slice/$run" --ref "$ref" --index-key "$(code_key "$(ref_of "$ref")")" --families "$families" --serve "$sock" \
          --idle-minutes "$idle_minutes" > "$IDENTITY_CACHE/serve/$key.log" 2>&1 < /dev/null 6>&- 7>&- 8>&- &
        echo $! > "$IDENTITY_CACHE/serve/$key.pid"; printf '%s\n' "$tree" > "$IDENTITY_CACHE/serve/$key.tree"; })
      jvm_slot_keeper_start "$repo" "$IDENTITY_CACHE/serve/$key.keeper.log" "$self" --keep-served "$(cat "$IDENTITY_CACHE/serve/$key.pid")"
      # a JVM alive but never listening (stuck loading, a deadlock) is stopped at the deadline, not waited on forever
      local started=$SECONDS limit=${KINOWO_IDENTITY_SLICE_START_SECONDS:-900}
      until [ -S "$sock" ]; do
        kill -0 "$(cat "$IDENTITY_CACHE/serve/$key.pid")" 2>/dev/null || { tail -20 "$IDENTITY_CACHE/serve/$key.log" >&2; identity_log "the kept JVM did not start"; return 1; }
        if [ $(( SECONDS - started )) -ge "$limit" ]; then
          stop_kept "$(cat "$IDENTITY_CACHE/serve/$key.pid")" || true
          rm -f "$IDENTITY_CACHE/serve/$key.pid"
          tail -20 "$IDENTITY_CACHE/serve/$key.log" >&2
          identity_log "the kept JVM did not listen within ${limit}s: stopped (\$KINOWO_IDENTITY_SLICE_START_SECONDS)"
          return 1
        fi
        sleep 1
      done
    fi
    rc=0
    python3 -I - "$sock" --labels "$labels" --out "$out" "$@" <<'PY' || rc=$?
import socket, struct, sys
path, args = sys.argv[1], sys.argv[2:]
s = socket.socket(socket.AF_UNIX)
try:
    s.connect(path)
except OSError:
    sys.exit(111)
payload = "\0".join(args).encode()
s.sendall(struct.pack(">i", len(payload)) + payload)
marker, held, out = b"\0EXIT ", b"", sys.stdout.buffer
while True:
    chunk = s.recv(65536)
    if not chunk:
        break
    held += chunk
    at = held.find(marker)
    if at >= 0:
        out.write(held[:at]); out.flush()
        sys.exit(int(held[at + len(marker):].split(b"\n")[0] or b"1"))
    keep = len(marker) - 1
    out.write(held[:-keep]); held = held[-keep:]
out.write(held); out.flush()
sys.exit(112)
PY
    [ "$rc" = 111 ] || [ "$rc" = 112 ] || return "$rc"
    identity_log "the kept JVM went away ($rc): starting another"
    rm -f "$sock"
  done
  return 1
}
# Stops the kept JVMs of <tree> under any key but <key>: a checkout's uncommitted edit is a new ref key, and each kept
# JVM holds up to 6 GB -- an emit-case after every edit would otherwise leave one behind per edit.
retire_served() { # <tree> <key>
  local f other
  for f in "$IDENTITY_CACHE"/serve/*.tree; do
    [ -f "$f" ] || continue
    other=$(basename "$f" .tree)
    [ "$other" != "$2" ] && [ "$(cat "$f")" = "$1" ] || continue
    stop_kept "$(cat "$IDENTITY_CACHE/serve/$other.pid" 2>/dev/null)" && identity_log "stopped the kept JVM of an older state of $1"
    rm -f "$f" "$IDENTITY_CACHE/serve/$other.pid" "$IDENTITY_CACHE/serve/$other.sock"
  done
}
tree_of() { if [ "$1" = "." ]; then echo "$repo"; else need_ref "$1"; identity_tree "$1" "${TOOL_FILES[@]}"; fi; }
# this checkout's code, keyed by WHICH checkout, its commit and its uncommitted code (tracked edits and new files): the
# whole-corpus index cached under the key is never another worktree's, an older commit's or an earlier edit's
worktree_key() {
  local where head edits
  where=$(printf '%s' "$repo" | shasum | cut -c1-8)
  head=$(git -C "$repo" rev-parse --short=12 HEAD)
  # every module the tool's classpath compiles (the scrapers and geodata reach the resolver too: a venue's details)
  local modules=(geodata common identity scrapers worker testkit)
  edits=$( { git -C "$repo" diff HEAD -- "${modules[@]}" build.sbt project
             # hashed from the repository's root, where ls-files' paths are -- from anywhere else a new file hashed nothing
             git -C "$repo" ls-files -z --others --exclude-standard -- "${modules[@]}" project \
               | (cd "$repo" && hash_each); } | shasum | cut -c1-8)
  echo "worktree-$where-$head-$edits"
}
sha_of() { if [ "$1" = "." ]; then worktree_key; else git -C "$repo" rev-parse --verify "$1^{commit}"; fi; }
# sha_of's key back to what code_key reads: a worktree key is this checkout's code
ref_of() { case "$1" in worktree-*) echo . ;; *) echo "$1" ;; esac; }
if [ "$explain" = 1 ]; then
  captured=$(identity_capture "$fixture" "$cc")
  [ -f "$captured/$cc.json.gz" ] || { echo "no capture $captured/$cc.json.gz" >&2; exit 1; }
  explain_at() { # <tree> -> the trace under that tree's code
    local cp
    cp=$(identity_classpath "$1") || return 1
    local rc=0
    jvm_slot_take identity-slice
    (cd "$1" && "${IDENTITY_JAVA[@]}" -cp "$cp" scripts.IdentityExplain "$cc" --fixture "$captured/$cc.json.gz" \
      --labels "$(identity_judgements "$captured")" ${pass[@]+"${pass[@]}"}) || rc=$?
    jvm_slot_release
    return "$rc"
  }
  [ "${#refs[@]}" -gt 0 ] || { explain_at "$repo"; exit; }
  for i in "${!refs[@]}"; do
    t=$(tree_of "${refs[$i]}") || exit 1
    explain_at "$t" > "$work/$i.txt" || { cat "$work/$i.txt"; exit 1; }
  done
  [ "${#refs[@]}" -eq 2 ] || { cat "$work/0.txt"; exit; }
  # the two refs' outcomes side by side — each cluster's heading, agreement and takes — then the traces' diff
  python3 -I - "$work/0.txt" "$work/1.txt" "${refs[0]}" "${refs[1]}" "${COLUMNS:-200}" <<'PY'
import sys
a, b, ra, rb, cols = sys.argv[1:]
half = int(cols) // 2 - 2
def summary(path):
    return [l.rstrip("\n") for l in open(path, encoding="utf-8") if l.startswith(("== ", "agreement ", "TAKE "))]
def fit(s):
    return s if len(s) <= half else s[: half - 1] + "…"
left, right = summary(a), summary(b)
print(f"{fit(ra):<{half}} | {rb}")
for i in range(max(len(left), len(right))):
    l = left[i] if i < len(left) else ""
    r = right[i] if i < len(right) else ""
    print(f"{fit(l):<{half}} | {fit(r)}")
PY
  echo
  if cmp -s "$work/0.txt" "$work/1.txt"; then echo "the two refs' traces are identical"
  else echo "--- ${refs[0]}"; echo "+++ ${refs[1]}"; diff -u "$work/0.txt" "$work/1.txt" | tail -n +3 || true; fi
  exit
fi

if [ "$faith" = capture ]; then
  # the agreement-taken listings: the unmatched-cluster capture's, as this code's agreement takes them over prod's filed
  # answers, on the recording the capture was made from — what no hermetic leg takes
  [ "$families" != none ] && [ -f "$families" ] || { echo "--faithfulness capture needs the capture (--families PATH)" >&2; exit 2; }
  [ -n "$run" ] || run=$(awk -F'\t' '$1 == "recording" { print $2 }' "${families%.json.gz}.inputs" 2>/dev/null || true)
  [ -n "$run" ] || { echo "no recording named beside $families (${families%.json.gz}.inputs): name it with --recording" >&2; exit 1; }
  recording=$(identity_recording "$run" "$cc")
  use_mirror
  ref=${refs[0]:-.}
  identity_log "faithfulness of the agreement takes: $families at ${ref} on recording $run, $sample listing(s)"
  run_at "$(tree_of "$ref")" "$(sha_of "$ref")" "$work/faith.tsv" --faithfulness "$families" --sample "$sample" --seed "$seed"
  exit
fi
if [ -n "$faith" ]; then
  # the leg's own takes, its commit and its pinned recording
  diag=$IDENTITY_CACHE/diagnostics/$faith
  # the leg's diagnostics artifact, downloaded beside the cache's copy and moved in whole. A subshell of its own, so its
  # trap removes the download directory however it ends (a Ctrl-C mid-download too) without replacing the trap of
  # identity_locked's subshell, which gives the lock back.
  faith_download() (
    [ -f "$diag/$cc-takes/$cc.json.gz" ] && exit 0
    mkdir -p "$diag"; dl=$(mktemp -d "$diag.dl.XXXXXX") || exit 1
    # every ending signal made an exit, so the EXIT trap runs: bash 3.2 can end a subshell on TERM without it
    trap 'rm -rf "$dl"' EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
    if gh_download "$IDENTITY_GH_DOWNLOAD" run download "$faith" -R "$KINOWO_GH_REPO" \
         --name "convergence-diagnostics-$cc-convergence" --dir "$dl" >&2 && [ -f "$dl/$cc-takes/$cc.json.gz" ]; then
      rm -rf "$diag/$cc-takes"; mv "$dl/$cc-takes" "$diag/$cc-takes"
    else
      identity_log "could not download run $faith's convergence-diagnostics-$cc-convergence (gh failed or timed out, or it holds no $cc-takes)"; exit 1
    fi
  )
  [ -f "$diag/$cc-takes/$cc.json.gz" ] || identity_locked "diagnostics-$faith-$cc" faith_download || exit 1
  if [ -z "$run" ]; then
    log_text=$(identity_gh "$IDENTITY_GH_DOWNLOAD" run view "$faith" -R "$KINOWO_GH_REPO" --log) ||
      { echo "could not read run $faith's log (gh failed or timed out): name its recording with --recording" >&2; exit 1; }
    run=$(grep -m1 -oE 'KINOWO_CONVERGENCE_PIN_CORPUS_RUN: [0-9]+' <<< "$log_text" | grep -oE '[0-9]+$' || true)
  fi
  [ -n "$run" ] || { echo "no pinned recording in run $faith's log: name it with --recording" >&2; exit 1; }
  head=$(identity_gh "$IDENTITY_GH_READ" run view "$faith" -R "$KINOWO_GH_REPO" --json headSha -q .headSha) && [ -n "$head" ] ||
    { echo "could not read run $faith's commit (gh failed or timed out)" >&2; exit 1; }
  recording=$(identity_recording "$run" "$cc")
  use_mirror
  identity_log "faithfulness: run $faith (commit ${head:0:9}) on recording $run, $sample listing(s)"
  run_at "$(tree_of "$head")" "$head" "$work/faith.tsv" --faithfulness "$diag/$cc-takes/$cc.json.gz" --sample "$sample" --seed "$seed"
  exit
fi

[ -n "$run" ] || run=$(identity_newest_recording "$cc") || exit 1
run=$(identity_recording_run "$run" "$cc") || exit 1
recording=$(identity_recording "$run" "$cc")
use_mirror
if [ "$drift" = 1 ]; then
  t=$(tree_of "${refs[0]:-.}") || exit 1
  cp=$(identity_classpath "$t") || exit 1
  jvm_slot_take identity-slice
  rc=0
  (cd "$t" && "${IDENTITY_JAVA[@]}" -cp "$cp" scripts.IdentityDrift "$cc" --recording "$recording" --families "$families" --labels "$labels" \
    --allow "$repo/test/resources/fixtures/identity-drift-allow.tsv" --out "$work/drift") || rc=$?
  jvm_slot_release
  [ -z "$keep" ] || [ ! -f "$work/drift/drift-$cc.tsv" ] || cp "$work/drift/drift-$cc.tsv" "$keep"
  exit "$rc"
fi
[ -z "$batch" ] || pass+=(--batch "$batch")
[ "${#pass[@]}" -gt 0 ] || { echo "no selector" >&2; usage >&2; exit 2; }

if [ -n "$bisect" ]; then
  from=${bisect%%..*} to=${bisect##*..}; need_ref "$from"; need_ref "$to"
  commits=(); while IFS= read -r c; do commits+=("$c"); done < <(git -C "$repo" rev-list --reverse --first-parent "$from..$to")
  [ "${#commits[@]}" -gt 0 ] || { echo "no commit in $bisect" >&2; exit 2; }
  takes() { tail -n +2 "$1" | cut -f2,5 | sort; }
  run_at "$(tree_of "$from")" "$(sha_of "$from")" "$work/base.tsv" "${pass[@]}" > /dev/null
  identity_log "bisecting ${#commits[@]} commit(s) after ${from}: the take at $from is $(takes "$work/base.tsv" | cut -f2 | sort | uniq -c | tr '\n' ';')"
  lo=0 hi=$(( ${#commits[@]} - 1 )) first=""
  # is the take at the LAST commit moved at all?
  run_at "$(tree_of "${commits[$hi]}")" "${commits[$hi]}" "$work/probe.tsv" "${pass[@]}" > /dev/null
  if cmp -s <(takes "$work/base.tsv") <(takes "$work/probe.tsv"); then echo "no commit of $bisect moves the take"; exit 0; fi
  while [ "$lo" -lt "$hi" ]; do
    mid=$(( (lo + hi) / 2 ))
    run_at "$(tree_of "${commits[$mid]}")" "${commits[$mid]}" "$work/probe.tsv" "${pass[@]}" > /dev/null
    if cmp -s <(takes "$work/base.tsv") <(takes "$work/probe.tsv"); then lo=$(( mid + 1 )); else hi=$mid; fi
  done
  first=${commits[$lo]}
  echo "first commit moving the take: $(git -C "$repo" log -1 --format='%h %s' "$first")"
  run_at "$(tree_of "$first")" "$first" "$work/first.tsv" "${pass[@]}" > /dev/null
  python3 -I "$repo/scripts/identity_slice_diff.py" "$work/base.tsv" "$work/first.tsv" "$(git -C "$repo" rev-parse --short "$first")~1" "$(git -C "$repo" rev-parse --short "$first")"
  exit
fi

[ "${#refs[@]}" -gt 0 ] || refs=(.)
for i in "${!refs[@]}"; do
  t=$(tree_of "${refs[$i]}") || exit 1
  # 3: every take written, but some slice met a request it does not hold (read as unknown, as a leg reads a gap) — said, kept
  rc=0; run_at "$t" "$(sha_of "${refs[$i]}")" "$work/$i.tsv" "${pass[@]}" > "$work/$i.txt" || rc=$?
  case $rc in
    0) ;;
    3) identity_log "${refs[$i]}: some slices are incomplete (above) — their takes read the missing requests as unknown" ;;
    *) cat "$work/$i.txt"; exit 1 ;;
  esac
done
if [ "$emit_drift" = 1 ]; then
  # each slice emitted, widened by the incremental sequence's own reads, then replayed from its answers alone
  [ "${#refs[@]}" -eq 1 ] && [ "${refs[0]}" = . ] || { echo "--emit-drift-slice cuts with this checkout's code: no --ref" >&2; exit 2; }
  cat "$work/0.txt"
  cp=$(identity_classpath "$repo") || exit 1
  emitted=0
  while IFS= read -r dir; do
    emitted=$((emitted + 1))
    for mode in widen replay; do
      more=(); [ "$mode" = widen ] && more=(--widen --recording "$recording" --families "$families")
      rc=0
      jvm_slot_take identity-slice
      (cd "$repo" && "${IDENTITY_JAVA[@]}" -cp "$cp" scripts.IdentityDrift "$cc" --slice "$dir" --seeds "${KINOWO_DRIFT_SLICE_SEEDS:-12}" \
        --allow "$repo/test/resources/fixtures/identity-drift-allow.tsv" --flips-allow "$repo/test/resources/fixtures/identity-flips-allow.tsv" \
        --out "$work/drift-$mode" "${more[@]}") 2> "$work/drift-$mode.log" || rc=$?
      jvm_slot_release
      [ "$rc" = 0 ] || [ "$rc" = 1 ] || { tail -20 "$work/drift-$mode.log" >&2; identity_log "$dir: the $mode replay failed ($rc)"; exit 1; }
    done
    identity_log "drift slice $dir: $( [ "$rc" = 0 ] && echo "replays clean" || echo "REPLAYS RED (above): the regression it guards is open -- commit it with the fix")"
  done < <(sed -n 's/^--emit-slice: //p' "$work/0.txt")
  [ "$emitted" -gt 0 ] || { identity_log "no drift slice emitted (no listing matched?)"; exit 1; }
  exit 0
fi
[ -z "$keep" ] || cp "$work/$(( ${#refs[@]} - 1 )).tsv" "$keep"
if [ "${#refs[@]}" -eq 1 ]; then
  [ -n "$batch" ] || cat "$work/0.txt"
else
  [ -n "$batch" ] || { echo "### ${refs[0]}"; cat "$work/0.txt"; echo; echo "### ${refs[1]}"; cat "$work/1.txt"; echo; }
  python3 -I "$repo/scripts/identity_slice_diff.py" "$work/0.tsv" "$work/1.tsv" "${refs[0]}" "${refs[1]}"
fi
exit
}
