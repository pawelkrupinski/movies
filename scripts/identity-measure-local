#!/usr/bin/env bash
#
# THE IDENTITY MEASURE, LOCALLY: scripts/identity-measure's whole-corpus base-vs-head verdict with no GitHub -- the
# same resolve (integration.IdentityResolveDump, the model's takes), the same final takes (the unmatched-cluster
# ratchet's --measure) and the same diff (scripts/ci/identity_takes_diff.py) the convergence suite's `takes` rows run,
# over a recording already in the identity cache.
#
#   scripts/identity-measure-local --base REF [--head REF] [--countries pl,de,uk,us,es] [--recording RUN] [--out DIR]
#
#   --base       the commit to measure against (required: no commit status is read to find one)
#   --head       the commit measured (default HEAD)
#   --countries  default every country the recording holds
#   --recording  a "Record scrape fixtures" run whose laid pair is cached
#                ($KINOWO_IDENTITY_CACHE/recordings/<run>/pair, as identity-slice lays it); default the newest cached one
#   --out        default target/identity-measure-local/<base>..<head> (…-live with --live-gaps)
#   --live-gaps  ask TMDB and IMDb live what the recording cannot answer, at both refs alike: the measure of a change that
#                asks NEW questions (a search spelling, a query), which a hermetic replay answers with nothing. Needs
#                TMDB_API_KEY (`secrets run movies TMDB_API_KEY -- scripts/identity-measure-local … --live-gaps`); CI's
#                convergence fill records those answers once GitHub can run it
#
# Each ref resolves in a detached worktree of its own, its compile seeded from the newest local build (sbt-warm --seed),
# in ONE sbt session over a mongod of its own (scripts/it-local.sh): every country's dump, then the ratchet's final
# takes. A ref's takes are a pure function of the commit and the recording, so they are SHARED across checkouts: kept in
# $KINOWO_IDENTITY_CACHE/measure-local/<recording>/<sha>/ (each country's dump on its own, the final takes per country
# set) with the ref's worktree beside them, and <out>/<sha> links to them. A ref another run is resolving is waited for,
# not resolved twice (agents measuring against one base resolved it five times over on 2026-10-18), and each resolve
# holds one of the machine's JVM slots with its sbt sized for KINOWO_JVM_CPUS cores (scripts/jvm-gate.sh). --live-gaps answers change with time, so
# those resolves stay in <out>. Prints each country's model and final
# verdicts as identity_takes_diff.py words them, and exits 1 when any fails (a right take lost or turned wrong, a new
# wrong take, an unjudged move), 0 when none does, 2 on a usage or setup error.
#
# The verdict is scripts/identity_measure.py's, as CI's measure classifies it (cure, right lost, right->wrong, new
# wrong, gained...), after each country's identity_takes_diff.py report. BLIND SPOT, as in CI: the final stage replays
# only the checked-in capture's clusters (the ones the model left unmatched when it was captured), so a listing the head
# newly leaves unmatched at the model stage never reaches it -- a final 0 there is "not seen", not "the agreement refilled
# it"; the model rows bound what is served.
#
# What it does not do that CI does: read the base from the commit statuses, reuse a stored base, run the corpus-shape
# specs. Use it while GitHub is unreachable; scripts/identity-measure is the verdict of record.
set -uo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=scripts/tool-conventions.sh
. "$here/scripts/tool-conventions.sh"
# shellcheck source=scripts/jvm-gate.sh
. "$here/scripts/jvm-gate.sh"
DIE_STATUS=2 # a usage or setup error; 1 is the verdict "not landable"
cache=$KINOWO_IDENTITY_CACHE
base="" head=HEAD recording="" out="" live=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base) flag_value "$@"; base=$2; shift 2 ;;
    --head) flag_value "$@"; head=$2; shift 2 ;;
    --country|--countries|--country=*|--countries=*) country_flag "$@"; shift "$COUNTRY_FLAG_ARGS" ;;
    --recording) flag_value "$@"; recording=$2; shift 2 ;;
    --out) flag_value "$@"; out=$2; shift 2 ;;
    --live-gaps) live=1; shift ;;
    -h|--help) usage_from_header; exit 0 ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done
[ -n "$base" ] || usage_error "--base REF is required"
base_sha=$(git -C "$here" rev-parse --short=12 "$base^{commit}" 2>/dev/null) || die "no commit $base"
head_sha=$(git -C "$here" rev-parse --short=12 "$head^{commit}" 2>/dev/null) || die "no commit $head"

if [ -z "$recording" ]; then
  recording=$(for laid in "$cache"/recordings/*/pair/test/resources/fixtures/corpus; do
    run=${laid#"$cache"/recordings/}; run=${run%%/*}; [[ $run =~ ^[0-9]+$ ]] && echo "$run"; done | sort -n | tail -1)
  [ -n "$recording" ] || die "no laid recording in $cache/recordings (lay one with scripts/identity-slice first)"
fi
pair="$cache/recordings/$recording/pair/test/resources/fixtures"
[ -d "$pair/corpus" ] || die "recording $recording has no laid pair at $pair"
if [ ${#SELECTED_COUNTRIES[@]} -gt 0 ]; then countries=$(selected_countries_csv)
else countries=$(for dir in "$pair"/enrichment-*; do [ -d "$dir" ] && basename "$dir" | sed 's/^enrichment-//'; done | paste -sd, -)
fi
IFS=, read -r -a ccs <<< "$countries"
if [ -n "$live" ]; then
  key=${KINOWO_IDENTITY_LIVE_GAPS_TMDB_KEY:-${TMDB_API_KEY:-}}
  [ -n "$key" ] || die "--live-gaps needs TMDB_API_KEY (secrets run movies TMDB_API_KEY -- $0 …)"
  export KINOWO_IDENTITY_LIVE_GAPS_TMDB_KEY=$key
fi
out=${out:-$here/target/identity-measure-local/$base_sha..$head_sha${live:+-live}}
mkdir -p "$out"
# absolute: each ref's commands run from its own worktree, where a relative path would land the takes
out=$(cd "$out" && pwd)
if [ -n "$live" ]; then store="$out"; else store="$cache/measure-local/$recording"; fi
mkdir -p "$store/trees"
ratchet_key=$(printf '%s\n' "${ccs[@]}" | sort | paste -sd- -)
echo "identity-measure-local: base $base_sha, head $head_sha, recording $recording, countries ${ccs[*]}${live:+, live gaps}, out $out"

held_lock=""
trap 'jvm_slot_release; jvm_unlock "$held_lock"' EXIT

resolve() { # <sha>: every country's model takes and the final ones, in the ref's own worktree, shared across checkouts
  local sha=$1 tree="$store/trees/$1" dir="$store/$1" commands=() said=""
  mkdir -p "$dir"
  until jvm_lock "$dir.flock"; do
    [ -n "$said" ] || { echo "identity-measure-local: $sha is being resolved by pid $(cat "$dir.flock" 2>/dev/null): waiting for it"; said=1; }
    sleep "${KINOWO_MEASURE_LOCAL_POLL:-5}"
  done
  held_lock="$dir.flock"
  # each country's dump and the final takes for this country set are a pure function of the commit and the recording:
  # what any run already resolved is kept, and only what is missing is resolved
  for cc in "${ccs[@]}"; do
    [ -s "$dir/decisions-$cc.jsonl" ] ||
      commands+=("worker/IntegrationTest/runMain integration.IdentityResolveDump --out $dir --full $cc --corpus-dir $pair/corpus --fixtures $pair")
  done
  [ -s "$dir/ratchet-$ratchet_key/ratchet-takes.tsv" ] ||
    commands+=("worker/IntegrationTest/runMain scripts.UnmatchedClustersRatchet --measure --out $dir/ratchet-$ratchet_key --countries $countries")
  if [ ${#commands[@]} = 0 ]; then
    echo "identity-measure-local: $sha already resolved in $dir"
  else
    [ -d "$tree" ] || git -C "$here" worktree add --detach --quiet "$tree" "$sha" || { jvm_unlock "$held_lock"; return 1; }
    jvm_slot_take identity-measure-local
    SECONDS=0
    # a fresh worktree compiles cold (~10 min under load); the newest local build's classes cut that to the diff
    [ -x "$tree/scripts/sbt-warm" ] && ( cd "$tree" && scripts/sbt-warm --seed ) > "$dir.log" 2>&1
    ( cd "$tree" && SBT_OPTS="${SBT_OPTS:-} $(jvm_cpu_options)" scripts/it-local.sh "${commands[@]}" ) >> "$dir.log" 2>&1
    local status=$?
    jvm_slot_release
    echo "identity-measure-local: $sha resolved in ${SECONDS}s (exit $status, log $dir.log)"
  fi
  jvm_unlock "$held_lock"; held_lock=""
  # <out>/<sha>: this run's view of the shared takes, laid as before (decisions-<cc>.jsonl, ratchet/ratchet-takes.tsv)
  if [ "$store" != "$out" ]; then
    mkdir -p "$out/$sha"
    for cc in "${ccs[@]}"; do ln -sfn "$dir/decisions-$cc.jsonl" "$out/$sha/decisions-$cc.jsonl"; done
    ln -sfn "$dir/ratchet-$ratchet_key" "$out/$sha/ratchet"
    [ -e "$dir.log" ] && ln -sfn "$dir.log" "$out/$sha.log"
  else
    [ -d "$dir/ratchet-$ratchet_key" ] && ln -sfn "ratchet-$ratchet_key" "$dir/ratchet"
  fi
  for cc in "${ccs[@]}"; do [ -s "$dir/decisions-$cc.jsonl" ] || { echo "identity-measure-local: $sha wrote no decisions-$cc.jsonl" >&2; return 1; }; done
  [ -s "$dir/ratchet-$ratchet_key/ratchet-takes.tsv" ] || echo "identity-measure-local: $sha wrote no final takes ($dir/ratchet-$ratchet_key)" >&2
  return 0
}

resolve "$base_sha" || die "the base did not resolve (log $out/$base_sha.log)"
resolve "$head_sha" || die "the head did not resolve (log $out/$head_sha.log)"

failed=0
# the head's own judgements, read from the commit: a head another run resolved has no worktree made by this one
judgements="$out/judgements-$head_sha.tsv"
git -C "$here" show "$head_sha:test/resources/fixtures/identity-judgements.tsv" > "$judgements" || die "no judgements at $head_sha"
for cc in "${ccs[@]}"; do
  echo "== $cc model"
  python3 "$here/scripts/ci/identity_takes_diff.py" "$cc" "$out/$base_sha/decisions-$cc.jsonl" "$out/$head_sha/decisions-$cc.jsonl" \
    --judgements "$judgements" --base-name "$base_sha" --head-name "$head_sha" || failed=1
  if [ -s "$out/$base_sha/ratchet/ratchet-takes.tsv" ] && [ -s "$out/$head_sha/ratchet/ratchet-takes.tsv" ]; then
    echo "== $cc final"
    python3 "$here/scripts/ci/identity_takes_diff.py" "$cc" "$out/$base_sha/ratchet/ratchet-takes.tsv" "$out/$head_sha/ratchet/ratchet-takes.tsv" \
      --final --judgements "$judgements" --base-name "$base_sha" --head-name "$head_sha" || failed=1
  else
    echo "== $cc final: not measured (a ratchet wrote no takes)"; failed=1
  fi
done
# The verdict CI's measure prints: the moves split by the judgements (cure, right lost, new wrong, ...), from the two
# refs' takes laid out as each takes row's artifact is.
classified="$out/classified"
rm -rf "$classified"
for cc in "${ccs[@]}"; do
  for side in "base:$base_sha" "head:$head_sha"; do
    dir="$classified/identity-takes-$cc/${side%%:*}"
    mkdir -p "$dir"
    ln -s "$out/${side#*:}/decisions-$cc.jsonl" "$dir/"
    [ -s "$out/${side#*:}/ratchet/ratchet-takes.tsv" ] && ln -s "$out/${side#*:}/ratchet/ratchet-takes.tsv" "$dir/"
  done
done
echo
classification=0
python3 -I "$here/scripts/identity_measure.py" "$classified" --judgements "$judgements" --countries "$countries" || classification=1
echo "identity-measure-local: the final stage replays the checked-in capture's clusters only -- a listing the head newly"
echo "  leaves unmatched at the model stage never reaches it, so its final 0 means not seen, not refilled: the model rows"
echo "  bound what is served."
# the classification decides (a right take lost or turned wrong, a new wrong one); a move nobody judged fails the takes
# diff alone, and must be judged before landing, as CI's measure says
if [ "$classification" != 0 ]; then echo "NOT LANDABLE (local): see the classification above"; exit 1
elif [ "$failed" != 0 ]; then echo "LANDABLE ONCE JUDGED (local): judge every unjudged move listed above first"; exit 1
else echo "LANDABLE (local)"; exit 0; fi
