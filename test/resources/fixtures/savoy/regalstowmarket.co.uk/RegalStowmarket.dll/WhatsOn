   function Populate(aEvents, aContainer, aSearchResultsProgrammeIDs, aProgrammeTypesIDs, aProgrammeIDs, aPerformanceUDFs, aPriceGroupIDs, aLimitToNumberOfDays = false, aSeasonsToDisplayIDs = []){
