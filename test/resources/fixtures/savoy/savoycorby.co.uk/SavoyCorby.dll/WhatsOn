            }; 
            items.dd < 10 && (items.dd = "0" + items.dd); 
            items.mm < 10 && (items.mm = "0" + items.mm); 
            items.D = options.weekDayLabels[items.D ? items.D - 1 : 6]; 
            items.M = options.shortMonthLabels[items.M]; 
            items.MM = options.singleMonthLabels[items.MM]; 
