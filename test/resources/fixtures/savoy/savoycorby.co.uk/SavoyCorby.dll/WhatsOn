        var el = document.createElement(tag); 
        for (var i = classes.length; i--; el.classList.add(classes[i])); 
        title && (el.title = title); 
        el.innerHTML = html || ""; 
        parent instanceof Element && parent.appendChild(el); 
        return el; 
