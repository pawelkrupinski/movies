sday 19 Nov 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus"><a class="Button" href="https://book.ilkleycinema.co.uk/IlkleyCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1030.TcsWebTab_1031.TcsPerformance_12663525.TcsSection_596618" title="Click to Book">17:00</a></span></td></tr><tr><td class="PeformanceListDate">Friday 20 Nov 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus"><a class="Button" href="https://book.ilkleycinema.co.uk/IlkleyCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1030.TcsWebTab_1031.TcsPerformance_12663527.TcsSection_523880" title="Click to Book">19:15</a><span class="PerformanceStatusSmall"> (Closed)</span></span></td></tr><tr><td class="PeformanceListDate">Sunday 22 Nov 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus"><a class="Button" href="https://book.ilkleycinema.co.uk/IlkleyCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1030.TcsWebTab_1031.TcsPerformance_12663886.TcsSection_596618" title="Click to Book">16:15</a><span class="PerformanceStatusSmall"> (Closed)</span></span></td></tr><tr><td class="PeformanceListDate">Tuesday 24 Nov 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus"><a class="Button" href="https://book.ilkleycinema.co.uk/IlkleyCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1030.TcsWebTab_1031.TcsPerformance_12663888.TcsSection_596618" title="Click to Book">20:00</a><span class="PerformanceStatusSmall"> (Closed)</span></span></td></tr></table></td></tr></table>
