<!DOCTYPE html>
<html lang="en" id="HTMLBooking">
<head><title>Ilkley Cinema</title><meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1" />
<style>

/*-------------------------------------------*/
/*-BROWSER RESET ----------------------------*/
/*-------------------------------------------*/

article,aside,details,figcaption,figure,footer,header,hgroup,main,nav,section,summary{display:block;}audio,canvas,video{display:inline-block;}audio:not([controls]){display:none;height:0;}[hidden]{display:none;}html{font-family:sans-serif;-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;}body{margin:0;}a:focus{outline:thin dotted;}a:active,a:hover{outline:0;}h1{font-size:2em;margin:0.67em 0;}abbr[title]{border-bottom:1px dotted;}b,strong{font-weight:bold;}dfn{font-style:italic;}hr{-moz-box-sizing:content-box;box-sizing:content-box;height:0;}mark{background:#ff0;color:#000;}code,kbd,pre,samp{font-family:monospace,serif;font-size:1em;}pre{white-space:pre-wrap;}q{quotes:"\201C" "\201D" "\2018" "\2019";}small{font-size:80%;}sub,sup{font-size:75%;line-height:0;position:relative;vertical-align:baseline;}sup{top:-0.5em;}sub{bottom:-0.25em;}img{border:0;}svg:not(:root){overflow:hidden;}figure{margin:0;}fieldset{border:1px solid #c0c0c0;margin:0 2px;padding:0.35em 0.625em 0.75em;}legend{border:0;padding:0;}button,input,select,textarea{font-family:inherit;font-size:100%;margin:0;}button,input{line-height:normal;}button,select{text-transform:none;}button,html input[type="button"],input[type="reset"],input[type="submit"]{-webkit-appearance:button;cursor:pointer;}button[disabled],html input[disabled]{cursor:default;}input[type="checkbox"],input[type="radio"]{box-sizing:border-box;padding:0;}input[type="search"]{-webkit-appearance:textfield;-moz-box-sizing:content-box;-webkit-box-sizing:content-box;box-sizing:content-box;}input[type="search"]::-webkit-search-cancel-button,input[type="search"]::-webkit-search-decoration{-webkit-appearance:none;}button::-moz-focus-inner,input::-moz-focus-inner{border:0;padding:0;}textarea{overflow:auto;vertical-align:top;}table{border-collapse:collapse;border-spacing:0;}

/*-------------------------------------------*/
/*-BOX SIZING -------------------------------*/
/*-------------------------------------------*/

* {
  box-sizing: border-box;
}

iframe {
width: 100%;
  max-width: var(--max-width);
}
/*-------------------------------------------*/
/*-FONTS ------------------------------------*/
/*-------------------------------------------*/

@font-face {
    font-family: 'museo-sans',
    url('/IlkleyCinema/fonts/MuseoSans-300.woff2') format('woff2'),
    url('/IlkleyCinema/fonts/MuseoSans-300.woff') format('woff'), 
    url('/IlkleyCinema/fonts/MuseoSans-300.ttf') format('truetype') 
}   

/*-------------------------------------------*/
/*-CONSTANTS --------------------------------*/
/*-------------------------------------------*/

:root {
  --color-brand: #6e286a;
  --color-text-highlight: rgb(206, 126, 201);
  --color-bg: #000;
  --color-card-bg: #231f20;
  --color-text: #FFF;
  --color-error: red;
  --font-regular: "museo-sans", sans-serif;
  --font-size-heading: 28px;
  --font-size-subheading: 16px;
  --font-size-regular: 14px;
  --max-width: 1600px;
  --content-width: 980px;
  --image-aspect-ratio: 8/5;
  --border-radius: 4px;
  
  --color-button-bg: var(--color-brand);
  --color-button-text: var(--color-text);
  --button-border-radius: var(--border-radius);
  --color-button-hover-bg: var(--color-text);
  --color-button-hover-text: var(--color-brand);
}

/*-------------------------------------------*/
/*-HELPERS ----------------------------------*/
/*-------------------------------------------*/

.d-flex {
  display: flex;
}

.flex-column {
  flex-direction: column;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

/*-------------------------------------------*/
/*-COMMON -----------------------------------*/
/*-------------------------------------------*/

body {
  font-family: var(--font-regular);
  font-size: var(--font-size-regular);
  background: var(--color-bg);
  color: var(--color-text);
  width: 100vw;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6, .title {
  font-size: var(--font-size-heading);
  text-transform: uppercase;
  text-decoration: none;
  font-weight: 300;
  line-height: 1.25;
}

span.highlight {
  color: var(--color-text-highlight);
}

a:link, a:visited {
  font-weight: 700;
  text-decoration: underline;
  color: var(--color-text);
}

/*-------------------------------------------*/
/*-MAIN -------------------------------------*/
/*-------------------------------------------*/

#Main {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: var(--max-width);
  margin: 20px auto;
  padding: 0 26px;
  width: 100%;
}

#Content {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  width: 100%;
}

.clearfix {
  display: none;
}

/*-------------------------------------------*/
/*-SIDEBAR ----------------------------------*/
/*-------------------------------------------*/

#SideBarToggleMenu {
  display: none;
}

#SideBar, #WizardSteps {
  display: none;
}

#SideBar {
  display: flex;
  position: relative;
  width: 100%;
  max-width: var(--content-width);
  margin: 0 auto 20px;
  justify-content: end;  
}

#SideBar > * {
    display: none;
}

#MyOrderSimpleMenu,
#MyAccountMenu,
#MyOrderMenu {
    display: flex !important;
}

.SideBarHeading,
#MyOrderMenu .SideBarItem,
#MyAccountMenu .SideBarItem {
    display: none;
}

#MyOrderSimpleMenu {
  display: block;
}

#AccountLogIn,
#AccountMySettings,
#AccountMyTickets,
#AccountLogOut {
    display: block !important;
}

#AccountLogIn a,
#MyOrderSimpleMenu a,
#AccountMySettings a,
#AccountMyTickets a,
#AccountLogOut a{
  background: var(--color-button-bg);
  padding: 5px;
  display: flex !important;
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius);
  margin: 0 0.2rem;
  font-size: 0.8rem;
  text-decoration: none;
  font-weight: 300;
}

#MyOrderSimpleMenu a,
#AccountLoggedIn {
    
}

#MyOrderSimpleMenu a {
    position:relative;
}

/*-------------------------------------------*/
/*-DETAIL -----------------------------------*/
/*-------------------------------------------*/

#Detail {
  display: flex;
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 50vh;
}

.DetailHeading, .DetailSubHeading {
  display: none;
}

#Detail:not(.PerformanceList) .DetailSubHeading {
  display: flex;
}

p:has(#AddTicketsToOrder.AddToOrder1) {
  display: none !important;
}

/*-------------------------------------------*/
/*-BUTTON -----------------------------------*/
/*-------------------------------------------*/

.button, .Button {
  border-radius: var(--border-radius);
  font-size: var(--font-size-regular);
  font-weight: 300;
  line-height: 1.25;
  padding: 8px 18px;
  text-align: center;
  text-transform: uppercase;
  margin: 0;
  text-decoration: none !important;
  background-color: var(--color-button-bg);
  color: var(--color-button-text);
  transition: background-color 200ms ease,color 200ms ease;
  border: 0;
}

.button:hover, .Button:hover {
  background-color: var(--color-button-hover-bg);
  color: var(--color-button-hover-text);
}

.PrevNext {
  width: 100%;
  max-width: var(--max-width);
  margin: 20px auto;
  display: flex;
  justify-content: center;
  align-items: center;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
  max-width: var(--content-width);
}

/*-------------------------------------------*/
/*-PROGRAMME --------------------------------*/
/*-------------------------------------------*/

.programme {
  flex-grow: 1;
  margin-bottom: 20px;
  width: 100%;
}

.programme .title {
  margin: 5px;
}

.programme .title a{
  text-decoration: none;
  font-weight: normal;
}

.details-wrapper, .performance-list-wrapper {
  margin: 13px;
}

.programme .auditorium-name{
  margin: 0;
}

@media(min-width: 981px){
  .details-wrapper {
    max-width: 510px;
  }
}

@media(max-width: 980px) {
  .performance-list-wrapper {
    margin: 13px 0;
  }
  
}

.performance-list-wrapper {
  padding: 18px 26px;
  background-color: var(--color-card-bg);
  flex-grow: 1;
  border-radius: var(--border-radius);
}

.performance-list-wrapper .title {
  margin: 2px 0 0 0;
    margin-bottom: 0px;
  border-bottom: 1px solid rgba(235,235,235,.3);
  padding-bottom: 22px;
  margin-bottom: 35px;
}

.programme-image {
  aspect-ratio: var(--image-aspect-ratio);
  border-radius: var(--border-radius);
  box-shadow: 0 0 0 1px #fff;  
  justify-content: center;  
  align-items: center;  
  display: flex;
  position: relative;
  overflow: hidden;
  position: relative;
}

.image {
  display: block;
  object-fit: cover;
  height: 100%;
  width: 100%;
}

.synopsis > span, .synopsis > div {
  margin: 20px 0 0 0;
  display: inline-flex;
  flex-direction: column;
}

.synopsis > span {
  padding: 18px;
  border-radius: 18px;
  background-color: var(--color-brand);
  color: var(--color-text);  
}

@media(max-width: 980px) {
  .programme {
    flex-direction: column;
  }

  .programme .title {
    font-size: 1.3rem;
  }

  .details-wrapper {
    max-width: revert;
  }
}

/*-------------------------------------------*/
/*-PERFORMANCE LIST TABLE -------------------*/
/*-------------------------------------------*/

#Detail.PerformanceList table, .performance-list > table > tbody > tr > td {
  width: 100%;
}

#Detail.PerformanceList td {
  padding: 6px 0;
  display: flex;
  gap: 1rem;
}

@media (max-width: 980px) {
  #Detail.PerformanceList td {
    /*width: 100%;*/
  }  
  
  .PeformanceListTimes {
    display: flex;
    align-content: end;
    gap: .5rem;
    flex-direction: column;
  }
}

#Detail.PerformanceList tr {
  border-bottom: 1px solid #000;
  display: flex;
  padding: 0;
  align-items: center;
  flex-direction: row;  
  border-top: none;
}

#Detail.PerformanceList td.PeformanceListDate {
  text-align: left;
  text-transform: uppercase;
  font-weight: 300;
  white-space: nowrap;
  padding: 5px 0;
  min-width: 160px;  
  text-transform: uppercase;
  font-size: var(--font-size-subheading);
  min-width: 220px;
  
}

.StartTimeAndStatus {
  display: inline-flex;
}

/*-------------------------------------------*/
/*-MODALS -----------------------------------*/
/*-------------------------------------------*/

#PopupException {
    position: fixed !important;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(400px, 80vw);
    background: white;
    border-radius: 14px;
    padding: 30px;
    box-shadow:
        0 20px 60px rgba(0,0,0,.35),
        0 0 0 100vmax rgba(0,0,0,.55);
    z-index: 10000;
}

#PopupException .ExceptionMessage {
    text-align: center;
    margin-bottom: 24px;
    line-height: 1.5;
  color: #000;
}

#PopupException .Close {
    display: block;
    margin: 0 auto;
    min-width: 120px;
}

#dlgVoucherPayment, 
#dlgAddMembers, 
.PopupDialogBox,
#PopupDialogDiscountCode {
    position: fixed !important;

    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);

    z-index: 10000;

    width: min(500px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);

    overflow-y: auto;

    background: var(--color-card-bg);
    color: var(--color-text);

    border-radius: 12px;
    padding: 2rem;

    box-sizing: border-box;

    box-shadow:
        0 20px 60px rgba(0,0,0,.45),
        0 0 0 100vmax rgba(0,0,0,.65);
}

.PopupDialogHeading {
    margin: 0 0 1.5rem;

    padding-bottom: .75rem;

    font-size: var(--font-size-heading);
    font-weight: 600;

    border-bottom: 1px solid rgba(255,255,255,.1);
}

#Membership_Duration {
  display: inline-flex;
  line-height: 3rem;
}

#dlgMembership1051_1046 > div {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

#dlgVoucherPayment form, 
#dlgAddMembers form, 
.PopupDialogBox form, 
#PopupDialogDiscountCode form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

#dlgVoucherPayment form > div, 
#dlgAddMembers form > div, 
.PopupDialogBox form > div, 
#PopupDialogDiscountCode form > div {
    line-height: 1.6;
    color: rgba(255,255,255,.85);
}

#dlgVoucherPayment b, 
#dlgAddMembers b, 
.PopupDialogBox b, 
#PopupDialogDiscountCode b {
    color: white;
}

#dlgVoucherPayment label, 
#dlgAddMembers label, 
.PopupDialogBox label, 
#PopupDialogDiscountCode label {
    display: block;
    margin-top: .5rem;
    margin-bottom: .4rem;
}

#dlgVoucherPayment input[type=text], 
#dlgAddMembers input[type=text], 
.PopupDialogBox input[type=text], 
.PopupDialogBox input[type=date], 
#PopupDialogDiscountCode input[type=text] {
    width: 100%;
    box-sizing: border-box;

    padding: .9rem 1rem;

    background: #2d2829;
    color: white;

    border: 1px solid rgba(255,255,255,.15);
    border-radius: var(--border-radius);

    font: inherit;
}

#dlgVoucherPayment input[type=text]:focus, 
#dlgAddMembers input[type=text]:focus, 
.PopupDialogBox input[type=text]:focus, 
.PopupDialogBox input[type=date]:focus, 
#PopupDialogDiscountCode input[type=text]:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(110,40,106,.25);
}

#dlgVoucherPayment input[type=submit], 
#dlgAddMembers input[type=submit], 
.PopupDialogBox input[type=submit], 
#PopupDialogDiscountCode input[type=submit] {
    margin-top: .5rem;
    width: 100%;
}

#dlgVoucherPayment .Close, 
#dlgAddMembers .Close, 
.PopupDialogBox .Close, 
#PopupDialogDiscountCode .Close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent !important;
    font-size: 0;
    cursor: pointer;
}

#dlgVoucherPayment .Close::before, 
#dlgAddMembers .Close::before, 
.PopupDialogBox .Close::before, 
#PopupDialogDiscountCode .Close::before {
    content: "X";

    font-size: 22px;
    color: rgba(255,255,255,.7);
}

#dlgVoucherPayment .Close:hover, 
#dlgAddMembers .Close:hover, 
.PopupDialogBox .Close:hover, 
#PopupDialogDiscountCode .Close:hover {
    background: rgba(255,255,255,.08);
}

#dlgVoucherPayment .Close:hover::before, 
#dlgAddMembers .Close:hover::before, 
.PopupDialogBox .Close:hover::before, 
#PopupDialogDiscountCode .Close:hover::before {
    color: white;
}

#dlgVoucherPayment .clearfix, 
#dlgAddMembers .clearfix, 
.PopupDialogBox .clearfix, 
#PopupDialogDiscountCode .clearfix {
    display: none;
}

#dlgVoucherPayment, 
#dlgAddMembers, 
.PopupDialogBox, 
#PopupDialogDiscountCode {
    animation: modalPopup .18s ease;
}

@keyframes modalPopup {
    from {
        opacity: 0;
        transform: translate(-50%, -46%) scale(.96);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

#dlgVoucherPayment b, 
.PopupDialogBox b, 
#PopupDialogDiscountCode b {
    display: inline-block;
    padding: .15rem .4rem;
    border-radius: 4px;
    background: rgba(255,255,255,.08);
    font-family: monospace;
}

/*-------------------------------------------*/
/*-MEMBERSHIP SECTION -----------------------*/
/*-------------------------------------------*/

#MembersInTheGroupHeading {display: none;}
#MembersInTheGroup {
  display: flex !important;
  gap: 1rem;
}

.DiscountSection {
    max-width: 1100px;
    margin: 0.6rem auto;
    color: var(--color-text);
}

.DiscountHeading {
    font-size: var(--font-size-heading);
    text-transform: uppercase;
  font-weight: 300;
    text-align: center;
}

.MembershipSection, .DeliveryNameAndAddress {
    background: var(--color-card-bg);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--border-radius);
    overflow: hidden;
  width: 100%;
}

.MembershipSectionHeading, .DeliverTo {
    background: rgba(255,255,255,.04);
    padding: 1rem 1.5rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-highlight);
}

.DeliverTo {
  width: var(--content-width);
  margin-top: 20px;
  border-radius: 4px 4px 0;
}

.DeliveryNameAndAddress {
  max-width: var(--content-width);
  display: flex;
  padding: 18px;
  border-radius: 0 0 4px 4px;
}

.MembershipSectionHeading .plus,
.MembershipSectionHeading .minus {
    display: none;
}

.MembershipSectionContent {
    display: block !important;
    padding: 1.5rem;
}

.member {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--border-radius);
    padding: 1.25rem; 
  display: flex !important;
  justify-content: space-between;
  align-items: center;  
}

@media (max-width: 900px) {
  .member {
    flex-direction: column;
  }
}

.member_name {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: .5rem;
}

.membership_sale {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

.membership_description {
    font-weight: 600;
}

.membership_period {
    color: rgba(255,255,255,.7);
}

.membership_status {
    padding: .3rem .75rem;
    border-radius: 100px;
    font-size: .8rem;
    font-weight: 600;
}

.membership_status_active {
    background: #1d7c43;
    color: white;
}

.membership_info .Button,
.selectable_benefit_membership_info .Button {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    padding: 0;
    font-weight: bold;
}

#btnAddMembers {
  display: inline-flex;
  height: 100%;
  align-items: center;
}

form[name=frmApplyMembershipBenefits] {
  margin-top: 0;
}

.selectable_benefit_heading,
.ticket_sale_heading {
    display: none;
}

.selectable_benefit {
    display: grid;
    grid-template-columns: 220px 1fr 320px;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255,255,255,.08);
}

.selectable_benefit:first-of-type {
    border-top: none;
}

.selectable_benefit_member_name {
    font-weight: 700;
    font-size: 1.05rem;
}

.selectable_benefit_membership_details {
    color: rgba(255,255,255,.7);
}

.selectable_benefits_list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.selectable_benefits_list li {
    margin-bottom: .75rem;
  display: flex;
  justify-content: center;
  gap: 1rem;
}

.selectable_benefits_list label {
    display: flex;
    align-items: center;
    gap: .75rem;
    cursor: pointer;
    user-select: none;
}

.selectable_benefits_list input[type=checkbox] {
    width: 20px;
    height: 20px;
    accent-color: var(--color-brand);
}

.ticket_sale {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1.5fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255,255,255,.08);
}

.ticket_sale:first-of-type {
    border-top: none;
}

.ticket_description {
    font-weight: 500;
    line-height: 1.6;
}

.ticket_member ul {
    list-style: none;
    margin: 0;
    padding: 0;
}

.ticket_member li {
    margin-bottom: .75rem;
  display: flex;
  justify-content: center;
  gap: 1rem;
}

.ticket_member label {
    display: flex;
    align-items: center;
    gap: .75rem;
    cursor: pointer;
}

.ticket_member input[type=radio] {
    accent-color: var(--color-brand);
    width: 20px;
    height: 20px;
}

.ticket_discount_detail {
    background: rgba(110,40,106,.15);
    border-left: 4px solid var(--color-brand);
    padding: 1rem;
    border-radius: var(--border-radius);
    color: var(--color-text-highlight);
    line-height: 1.5;
}

#ApplyMembershipDiscounts {
    display: block;
    margin: 0.6rem auto 0;
    min-width: 280px;
}

@media (max-width: 900px) {

    .selectable_benefit,
    .ticket_sale {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .membership_sale {
        flex-direction: column;        
    }

    #ApplyMembershipDiscounts {
        width: 100%;
    }
}

.error_member_has_not_been_assigned_to_ticket {
  color: var(--color-error);
}

/*-------------------------------------------*/
/*-NOTIFICATION -----------------------------*/
/*-------------------------------------------*/

.notification, .Exception {
  padding: 0px 12px;
  background: var(--color-brand);
  background: rgba(110, 40, 106, 0.1);
  border: 1px solid rgba(255,255,255,.15);  
  border-radius: var(--border-radius);
  margin: 8px 0;
}

.Exception, .TicketReservationsExpired {
  background: var(--color-error);
}

/*-------------------------------------------*/
/*-ORDER TABLE ------------------------------*/
/*-------------------------------------------*/

#Detail.ViewOrder table, 
#Detail.DiscountsPrompt table, 
#Detail.PaymentPrompt table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--color-card-bg);
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(0,0,0,.08);
    font-size: 0.95rem;
  max-width: var(--content-width);
}

#Detail.ViewOrder table th, 
#Detail.DiscountsPrompt table th, 
#Detail.PaymentPrompt table th {
    background: var(--color-text-highlight);    
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    font-size: .8rem;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-bg);
}

#Detail.ViewOrder table td, 
#Detail.DiscountsPrompt table td, 
#Detail.PaymentPrompt table td  {
    padding: 16px 18px;
    vertical-align: top;
}


#Detail.ViewOrder table tr:not(:last-child) td, 
#Detail.DiscountsPrompt table tr:not(:last-child) td, 
#Detail.PaymentPrompt table tr:not(:last-child) td {
    border-bottom: 1px solid var(--color-bg);
}

#Detail.ViewOrder table tr[height], 
#Detail.DiscountsPrompt table tr[height], 
#Detail.PaymentPrompt table tr[height] {
    display: none;
}

#Detail.ViewOrder .OrderItem a, 
#Detail.DiscountsPrompt .OrderItem a, 
#Detail.PaymentPrompt .OrderItem a {
    font-weight: 600;
    text-decoration: none;
    color: inherit;
}

#Detail.ViewOrder .OrderItem a:hover, 
#Detail.DiscountsPrompt .OrderItem a:hover, 
#Detail.PaymentPrompt .OrderItem a:hover {
    text-decoration: underline;
}

#Detail.ViewOrder .OrderDetails, 
#Detail.DiscountsPrompt .OrderDetails, 
#Detail.PaymentPrompt .OrderDetails {    
    line-height: 1.5;
}

#Detail.ViewOrder .OrderPriceToPay, 
#Detail.DiscountsPrompt .OrderPriceToPay, 
#Detail.PaymentPrompt .OrderPriceToPay {
    white-space: nowrap;
    font-weight: 600;
    font-size: 1rem;
}

#Detail.ViewOrder .OrderDetails:only-child,
#Detail.ViewOrder .OrderItem:empty + .OrderDetails,
#Detail.DiscountsPrompt .OrderDetails:only-child,
#Detail.DiscountsPrompt .OrderItem:empty + .OrderDetails,
#Detail.PaymentPrompt .OrderDetails:only-child,
#Detail.PaymentPrompt .OrderItem:empty + .OrderDetails {
    font-style: italic;
}

#Detail.ViewOrder table tr:last-child td, 
#Detail.DiscountsPrompt table tr:last-child td, 
#Detail.PaymentPrompt table tr:last-child td {
    border-top: 1px solid var(--color-bg);
    padding-top: 20px;
    font-size: 1.15rem;
}

#Detail.ViewOrder table tr:last-child b, 
#Detail.DiscountsPrompt table tr:last-child b, 
#Detail.PaymentPrompt table tr:last-child b {
    font-weight: 700;
}

#Detail.ViewOrder .OrderDelete {
    white-space: nowrap;
}

#Detail.ViewOrder .OrderDelete .Button {
    display: inline-block;
    padding: 7px 14px;
    margin-left: 6px;
    border-radius: 999px;
    text-decoration: none;
    font-size: .85rem;
    font-weight: 600;
    transition: .15s;
}

.DiscountDetail {
  color: var(--color-text-highlight);
}

@media (max-width: 768px) {

    #Detail.ViewOrder table, 
  #Detail.PaymentPrompt table,
  #Detail.DiscountPrompt table {
        display: block;
        overflow-x: auto;
    }

    #Detail.ViewOrder > table > tbody, 
  #Detail.PaymentPrompt > table > tbody,
  #Detail.DiscountPrompt > table > tbody {
        display: flex;
    flex-direction: column;
    }

    #Detail.ViewOrder table th,
    #Detail.ViewOrder table td, 
    #Detail.DiscountsPrompt table th,
    #Detail.DiscountsPrompt table td, 
    #Detail.PaymentPrompt table th,
    #Detail.PaymentPrompt table td {
        padding: 12px;
    }

    #Detail.ViewOrder .OrderDelete {
        min-width: 120px;
    }

    #Detail.ViewOrder .OrderDelete .Button {
        display: block;
        margin: 6px 0;
        text-align: center;
    }
}

@media(max-width: 768px){
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(4),
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(4),
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(4){
    display: flex;
    justify-content: space-between;
  }
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(1),
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(1),
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:nth-child(1){
    display: none;
  }
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) > tr[valign="top"],
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) > tr[valign="top"],
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) > tr[valign="top"] {
    display: flex;
    flex-direction: column;
  }
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) tr[height="5px"],
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) tr[height="5px"],
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) tr[height="5px"] {
    display: none;
  }
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) > tr:last-child, 
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:last-child,
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:last-child {
    display: flex;
    justify-content: space-between;
  }
  .ViewOrder > table:nth-child(3) > tbody:nth-child(1) > tr:last-child > td:last-child,
  .DiscountsPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:last-child > td:last-child,
  .PaymentPrompt > table:nth-child(3) > tbody:nth-child(1) > tr:last-child > td:last-child {
    display: none;
  }
  
  .OrderDelete {
    display: flex;
  }
}

.DiscountSection {
  padding: 18px;
  width: 100%;
  max-width: var(--content-width);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1rem;
  margin: 20px 0 40px;
  border-radius: var(--border-radius);
}

.DiscountSection .Button {  
  background-color: var(--color-bg);
  color: var(--color-button-text);
  border: solid 2px var(--color-brand);
  margin-top: 6px;
}

/*-------------------------------------------*/
/*-SEAT SELECTION ---------------------------*/
/*-------------------------------------------*/

.SelectPersonTypeOverlay {
    position: fixed !important;
    inset: 0 !important;
    z-index: 10000 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0,0,0,.65);
}

.SelectPersonTypeOverlay {
    width: auto;
    height: auto;
}

.SelectPersonTypeOverlay > div {
    
}

.SelectPersonTypeOverlay {
    position: fixed !important;
    inset: 0;
}

.SelectPersonTypeOverlay {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%);
    width: min(420px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    height: 700px;
    overflow-y: auto;
    background: var(--color-card-bg);
    color: var(--color-text);
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow:
        0 20px 60px rgba(0,0,0,.45),
        0 0 0 100vmax rgba(0,0,0,.65);
    box-sizing: border-box;
    animation: seatModalIn .18s ease;
  display: flex;
  flex-direction: column;
  justify-content: start;
}

@keyframes seatModalIn {
    from {
        opacity: 0;
        transform: translate(-50%, -48%) scale(.96);
    }
    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

.SelectPersonTypeOverlaySeatNumber {
    color: var(--color-text);
  margin: 0 0 1.5rem;
  padding-bottom: .75rem;
  font-size: var(--font-size-heading);
  font-weight: 600;
  border-bottom: 1px solid rgba(255,255,255,.1);
  width: 100%;
}

.SelectPersonTypeOverlaySeatType {
    font-size: var(--font-size-subheading);
    color: rgba(255,255,255,.7);

    margin-bottom: 1rem;
}

.PersonTypeOverlayPersonTypeAndPrice {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    padding: .9rem 1rem;
    margin: .5rem 0;
    border-radius: var(--border-radius);
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.08);
    cursor: pointer;
    transition: .15s ease;
  width: 100%;
  padding-top: 40px;
  position: relative;
}

.PersonTypeOverlayPersonTypeAndPrice:hover {
    background: rgba(110,40,106,.15);
    border-color: rgba(110,40,106,.4);
}

.PersonTypeOverlayPersonTypeAndPrice a {
  font-weight: 600;
  text-decoration: none;
  color: var(--color-text);
  display: flex;
  position: absolute;
  inset: 0;
  justify-content: start;
  align-items: start;
  padding: 15px;
  font-size: 1.5em;
}

.PersonTypeOverlayPersonTypeAndPrice a:hover {
    color: var(--color-text-highlight);
}

.PersonTypeOverlayConditionsOfEntry {
    font-size: .85rem;
    color: rgba(255,255,255,.65);

    line-height: 1.4;
}

.SelectPersonTypeOverlayCancel {
    position: absolute;

    top: 12px;
    right: 12px;
}

.SelectPersonTypeOverlayCancel a {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    font-size: 0;

    background: transparent;
    border: none;

    cursor: pointer;
}

.SelectPersonTypeOverlayCancel a::before {
    content: "X";
    font-size: 20px;
    color: rgba(255,255,255,.7);
}

.SelectPersonTypeOverlayCancel a:hover {
    background: rgba(255,255,255,.08);
}

.SelectPersonTypeOverlayCancel a:hover::before {
    color: white;
}

.SelectPersonTypeOverlay input[type="hidden"] {
    display: none !important;
}

.SelectPersonTypeOverlaySeatNumber::before {
    content: "Seat ";
    font-weight: 400;
    color: rgba(255,255,255,.6);
}

.SelectedSeat {
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  background: var(--color-brand);
  border-radius: var(--border-radius);
  cursor: pointer;
}

.PriceGroup {
  display: none;
}

/*-------------------------------------------*/
/*-PRICE GROUP ------------------------------*/
/*-------------------------------------------*/

.PriceGroup {
    margin: 0.4rem 0;
  display: flex;
  width: 100%;
}

.PriceGroupSeatType {
  flex-grow: 1;
}

.PriceGroupSeatType .PriceGroupPersonTypePrice{
  font-size: 1.2em;
}

@media(max-width: 900px) {
  .PriceGroup {
    flex-direction: column;
  }
}
@media(max-width: 480px) {
  .PriceGroup {
    /*display: none;*/
  }
}

.PriceGroup table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-card-bg);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--border-radius);
    overflow: hidden;
}

.PriceGroupSeatTypeHeading {
    background: rgba(255,255,255,.05);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.SeatType {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-text-highlight);
}

.SeatTypeNotes {
    margin-top: .35rem;
    color: rgba(255,255,255,.7);
    font-size: .9rem;
}

.PriceGroup table tr:not(:first-child) {
    transition: background .2s ease;
}

.PriceGroup table tr:not(:first-child):hover {
    background: rgba(255,255,255,.03);
}

.PriceGroup table td {
    padding: .85rem 1.5rem;
    vertical-align: middle;  
}

.PriceGroup table tr:last-child td {
    border-bottom: none;
}

.PriceGroupPersonTypeQuantity {
    width: 70px;
    text-align: center;
  justify-content: center !important;
}

.PriceGroupPersonTypeQuantity span {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 30px;
    min-height: 30px;

    background: var(--color-brand);
    color: white;

    border-radius: 999px;
    font-weight: 700;
}

.PriceGroupPersonTypeQuantity span:empty {
    visibility: hidden;
}

.PriceGroupPersonTypeDescription {
    font-weight: 500;
    color: var(--color-text);  
  width: 30%;
}

.PriceGroupPersonTypePrice {
    width: 170px;
    text-align: right;

    white-space: nowrap;

    font-weight: 700;
    color: var(--color-text-highlight);
}

.PriceGroup .PriceGroupPersonTypeGroupCalculation {
    display: block;
    /* margin-top: .25rem; */
    font-size: inherit;
    font-weight: bold;
    color: var(--color-text-highlight);
}

@media (max-width:700px){

    .PriceGroup table td{
        padding:.75rem;
    }

    .PriceGroupPersonTypePrice{
        width:90px;
        font-size:.95rem;
    }

    .PriceGroupPersonTypeQuantity{
        width:50px;
    }

}

/*-------------------------------------------*/
/*-FORMS ------------------------------------*/
/*-------------------------------------------*/

.row {
  display: flex;
}

form {
  padding: 18px 26px;
  background: var(--color-card-bg);
  border-radius: var(--border-radius);
  display: flex;
  flex-direction: column;
  align-items: center;
    max-width: var(--content-width);
  width: 100%;
    margin: 0.6rem auto;
    gap: 2.5rem;
}

.InlineValidationMessage {
  color: var(--color-text-highlight);
  font-weight: 700;
  padding: 10px;
}

#Detail.PerformanceList form {
  max-width: revert;
  width: auto;
  gap: 0;
  margin: 0 auto;
}

#Detail.PerformanceList form p{
  margin: 5px;
}

#Detail.PerformanceList .programme {
  margin: 0;
}

#PatronDetails, .PaymentMethod {
  width: 100%;
}

#Detail.PaymentPrompt > .PaymentMethod {
  max-width: var(--content-width);
  padding: 18px;
  margin: 30px 0 0;
  border-radius: var(--border-radius);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

#Detail.PaymentPrompt > .PaymentMethod .Button {
  background-color: var(--color-bg);
  color: var(--color-button-text);
  border: solid 2px var(--color-brand);
  margin-top: 15px;
}

.EditPatronHeading {display: none;}

.row {
    display: block;
  width: 100%;
}

.sixcol,
.sixcol.last {
    width: 100%;
    display: block;
  text-align: center;
}

.TextLabel {
    display: block;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-size: var(--font-size-regular);
    font-weight: 600;
    color: var(--color-text);
}

input[type=text],
input[type=email],
input[type=date],
input[type=password] {
    width: 100%;
    box-sizing: border-box;

    padding: .9rem 1rem;

    background: rgba(110, 40, 106, 0.1);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: var(--border-radius);

    color: var(--color-text);
    font: inherit;

    transition: .2s;
}

input[type=text]::placeholder,
input[type=email]::placeholder,
input[type=date]::placeholder,
input[type=password]::placeholder {
    color: rgba(255,255,255,.45);
}

input[type=text]:focus,
input[type=email]:focus,
input[type=date]:focus,
input[type=password]:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px rgba(110,40,106,.25);
}

#Password + div {
    margin-top: .75rem;    
  width: 100%;
}

#Password + div a {
    font-size: .9rem;
    color: var(--color-text-highlight);
    text-decoration: none;
}

#Password + div a:hover {
    text-decoration: underline;
}

input[type=submit].Button {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: var(--button-border-radius);
    background: var(--color-button-bg);
    color: var(--color-button-text);
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
  margin-bottom: 20px;
}

input[type=submit].Button:hover {
    background: var(--color-button-hover-bg);
    color: var(--color-button-hover-text);
}

.row:last-of-type {
  display: flex;
    flex-direction: column;        
}

.row.TransactionHistoryRow:last-of-type,
.row.price-and-description:last-of-type {
    display: flex;
    flex-direction: row;      
}

.sixcol.last {
    display: flex;
    align-items: center;    
  flex-direction: column;
}

@media (min-width: 900px) {
  #Detail.PaymentPrompt form .sixcol, 
  #Detail.PaymentPrompt form .sixcol.last {
    display: flex;
    flex-direction: row;    
  }
  
  #Detail.PaymentPrompt .TextLabel {
    text-align: right;
    margin-right: 1rem;
    flex-grow: 1;
    padding-top: 0.5rem;
  }
  
  form .sixcol input[type=text],
  form .sixcol input[type=email],
  form .sixcol input[type=date],
  form .sixcol input[type=password] {
    width: 60%;
    margin-top: 0.5rem;
  }
  
  #Detail:not(.PaymentPrompt) form .sixcol,
  #Detail:not(.PaymentPrompt) form .sixcol.last {
    display: flex;
    flex-wrap: wrap;
  }
  
  #Detail:not(.PaymentPrompt) .TextLabel {
    width: 40%;
    padding-right: 1rem;
    text-align: right;
    padding-top: 0.5rem;
  }  
}

#ShouldRememberLogin {
    accent-color: var(--color-brand);
}

#SkipThisStep,
#CreateAnAccount {
    margin: 0;
    text-align: center;
    color: rgba(255,255,255,.75);
}

#SkipThisStep a,
#CreateAnAccount a {
    color: var(--color-text-highlight);
    font-weight: 600;
    text-decoration: none;
}

#SkipThisStep a:hover,
#CreateAnAccount a:hover {
    text-decoration: underline;
}

#SkipThisStep{
  font-size: 0;
  margin-bottom: 1rem;
}

#SkipThisStep a::after{
  content: 'Continue as guest';
  font-weight: bold;
  color: var(--color-button-text);
  background: var(--color-button-bg);
  border-radius: var(--border-radius);
  padding: 0.75rem 1rem;
  line-height: 3rem;
  font-size: 1rem;
  text-transform: uppercase;
}

form a {
    color: var(--color-text-highlight);
}

form a:hover {
    color: white;
}

input,
.Button {
    font-family: var(--font-regular);
    font-size: var(--font-size-regular);
}

form {
    animation: fadeIn .25s ease;
}

@keyframes fadeIn {
    from {
        opacity:0;
        transform:translateY(8px);
    }
    to {
        opacity:1;
        transform:none;
    }
}

.ToolTip, .PaymentHeading {display: none;}

.twelvecol.TermsAndConditions {
    display: flex;
    align-items: center;
  justify-content: center;
    gap: 14px;
    padding: 16px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: var(--border-radius);
    transition: all 0.25s ease;
}

.twelvecol.TermsAndConditions:hover {
    border-color: var(--color-brand);
    background: rgba(255,255,255,0.06);
}

.twelvecol.TermsAndConditions input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    min-width: 22px;
    border: 2px solid var(--color-brand);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    margin: 0;
}

.twelvecol.TermsAndConditions input[type="checkbox"]:checked {
    background: var(--color-brand);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.06);
}

.twelvecol.TermsAndConditions input[type="checkbox"]:checked::after {
    content: "";
    position: absolute;
    left: 6px;
    top: 2px;
    width: 5px;
    height: 10px;
    border: solid var(--color-Font);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}

.twelvecol.TermsAndConditions input[type="checkbox"]:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(255,255,255,0.12);
}

.twelvecol.TermsAndConditions label {
    color: var(--color-Font);
    font-size: 15px;
    line-height: 1.5;
    cursor: pointer;
    margin: 0;
}

.twelvecol.TermsAndConditions label a {
    color: var(--color-One);
    text-decoration: underline;
}

/*-------------------------------------------*/
/*-UPSELL RETAIL (QUITE SPECIFIC TO ILKLEY)--*/
/*-------------------------------------------*/

#UpsellForm {
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    color: var(--color-text);
}

.SelectedWebTab {
    display: inline-block;
    margin-bottom: 1rem;
  width: 100%;
}

.SelectedWebTab a {
    display: inline-block;
    padding: .6rem 1rem;
    color: var(--color-text);
    font-weight: 300;
  font-size: var(--font-size-heading);
  text-transform: uppercase;
  border-bottom: solid 1px var(--color-bg);
    text-decoration: none;
  width: 100%;
}

.NewStyleWebTab {
  width: 100%;
  flex-wrap: wrap;
}

.retailgroup.SaleItem {
    background: var(--color-card-bg);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.35);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  width: calc(50% - 20px);
  margin: 10px;
}

@media(max-width: 980px) {
  .retailgroup.SaleItem {
    width: 100%;
    margin: 0 0 20px;
  }
}

.grouptitle {
    font-size: var(--font-size-subheading);
    font-weight: 300;
  text-transform: uppercase;
    margin-bottom: .5rem;
    border-bottom: 1px solid rgba(255,255,255,.1);
    padding-bottom: .5rem;
}

.retailgroup > img.groupimage {
    border: solid 1px var(--color-text);
  border-radius: var(--border-radius);
  aspect-ratio: var(--image-aspect-ratio);
}

.groupeditem {
  display: flex;
  flex-direction: column;
  border-bottom: solid 1px var(--color-bg);
  padding: 0 0 20px 0;
}

.upsell-image img {
    display: none;
}

.row.price-and-description {
    display: flex;
    flex-wrap: wrap;
  flex-direction: row-reverse;
    align-items: center;
    gap: .2rem;
    font-size: 1.2em;
}

.SaleMinus,
.SalePlus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
  padding: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    font-weight: 700;
}

.SaleMinus:hover,
.SalePlus:hover {
    background: var(--color-brand);
}

.price-and-description input {
  width: 20px;
  text-align: center;
  background: transparent;
  color: var(--color-text);
  padding: .2rem;
  border: none;
  pointer-events: none;
}

.price-and-description .itemname {
    font-weight: 600;
    margin-left: auto;
  width: 50%;
    color: var(--color-text-highlight);
}

.price-and-description {
    gap: .75rem;
}

.upsell-detail {
  color: rgba(255,255,255,.7);
  line-height: 1.4;
  text-align: right;
  font-style: italic;
}

.EndOfSaleItems,
.EndOfUpsellItems {
    display: none;
}

@media (max-width: 700px) {
  .price-and-description .itemname {
    width: 100%;
  }
    .groupeditem {
        grid-template-columns: 1fr;
    }

    .upsell-image img {
        height: 160px;
    }

    .price-and-description {
        justify-content: space-between;
    }
}

/*-------------------------------------------*/
/*-ILKLEY SPECIFIC HEADER/FOOTER ------------*/
/*-------------------------------------------*/

.site-header {
  width:100%;
  background-color:#000
}
.logo_nav_holder {
  width:90%;
  margin:0 auto;
  position:relative;
  z-index:5000
}
.logo_nav_holder .logo_ctas {
  width:100%;
  padding:20px 0;
  display:-ms-flexbox;
  display:flex;
  -ms-flex-wrap:wrap;
  flex-wrap:wrap;
  gap:10px
}
.logo_nav_holder .logo_ctas .cta_btn {
  padding:0;
  -ms-flex:1;
  flex:1
}
.logo_nav_holder .logo_ctas .cta_btn .btn {
  width:100%;
  display:inline-block;
  margin:0;
  border:1px solid #fff;
  text-align:center;
}

@media(max-width: 480px) {
  .cta_btn.coming_soon a, .cta_btn.whats_on a{
    font-size: 1rem !important;
  }
}

.logo_nav_holder .logo {
  width:100%;
  display:-ms-flexbox;
  display:flex;
  -ms-flex-align:center;
  align-items:center;
  -ms-flex-pack:center;
  justify-content:center;
  position:relative;
  z-index:1;
  padding-bottom:10px
}
.logo_nav_holder .logo .hamburger {
  position:absolute;
  right:0;
  top:50%;
  transform:translateY(-50%)
}
.logo_nav_holder .logo .hamburger:active,
.logo_nav_holder .logo .hamburger:focus {
  border:1px solid #fff
}
.logo_nav_holder .logo a {
  display:block
}
.logo_nav_holder .logo a:focus-visible {
  border:1px solid #fff
}
.logo_nav_holder .logo picture,
.logo_nav_holder .logo img {
  width:100%;
  max-width:100px;
  margin:0 auto;
  height:auto;
  display:block;
  margin-top:3px
}
.logo_nav_holder .nav_wrapper {
  position:relative
}
.logo_nav_holder .main_nav {
  position:relative;
  top:100%;
  background:#000;
  max-height:0;
  overflow:hidden;
  transition:max-height .4s ease;
  z-index:999
}
.logo_nav_holder .main_nav.open {
  max-height:600px;
  border-bottom:1px solid
}
.logo_nav_holder .main_nav #primary-menu {
  list-style:none;
  margin:0;
  padding:0
}
.logo_nav_holder .main_nav #primary-menu li {
  border-bottom:1px solid hsla(0,0%,100%,.1)
}
.logo_nav_holder .main_nav #primary-menu li a {
  display:block;
  text-align:center;
  color:#fff;
  letter-spacing:.1em;
  text-transform:uppercase;
  text-decoration:none
}
.logo_nav_holder .main_nav #primary-menu li a:hover {
  color:hsla(0,0%,100%,.7)
}
.logo_nav_holder .hamburger {
  background:none;
  border:none;
  cursor:pointer;
  padding:10px
}
.logo_nav_holder .hamburger span {
  display:block;
  width:25px;
  height:2px;
  background:#fff;
  margin:5px 0;
  transition:.3s
}
.logo_nav_holder .hamburger span:nth-child(2) {
  width:16px;
  margin-left:auto
}
.logo_nav_holder .hamburger.active span:nth-child(1) {
  transform:translateY(7px) rotate(45deg)
}
.logo_nav_holder .hamburger.active span:nth-child(2) {
  opacity:0
}
.logo_nav_holder .hamburger.active span:nth-child(3) {
  transform:translateY(-7px) rotate(-45deg)
}
@media screen and (min-width: 500px) {
  .logo_nav_holder .logo picture,
  .logo_nav_holder .logo img {
    max-width:140px
  }
}
@media screen and (min-width: 768px) {
  .logo_nav_holder .logo_ctas {
    padding:30px 0
  }
  .logo_nav_holder .logo_ctas .cta_btn {
    width:250px;
    text-align:right
  }
  .logo_nav_holder .logo_ctas .cta_btn .btn {
    width:auto;
    display:inline-block
  }
  .logo_nav_holder .logo_ctas .cta_btn.whats_on {
    text-align:left
  }
}
@media screen and (min-width: 1200px) {
  .logo_nav_holder {
    width:100%
  }
  .logo_nav_holder .logo_ctas {
    width:100%;
    padding:47px 0 43px 0;
    display:-ms-flexbox;
    display:flex;
    -ms-flex-wrap:nowrap;
    flex-wrap:nowrap;
    -ms-flex-pack:center;
    justify-content:center;
    -ms-flex-align:center;
    align-items:center;
    gap:106px
  }
  .logo_nav_holder .logo_ctas .cta_btn {
    -ms-flex:none;
    flex:none
  }
  .logo_nav_holder .logo_ctas .cta_btn.whats_on {
    -ms-flex-order:-1;
    order:-1
  }
  .logo_nav_holder .logo_ctas .logo {
    padding:0
  }
  .logo_nav_holder .logo {
    width:140px
  }
  .logo_nav_holder .logo picture,
  .logo_nav_holder .logo img {
    max-width:140px;
  min-width: 140px;
  }
  .logo_nav_holder .hamburger {
    display:none
  }
  .logo_nav_holder .main_nav {
    position:static;
    max-height:none;
    overflow:visible;
    background:rgba(0,0,0,0);
    transition:none
  }
  .logo_nav_holder .main_nav #primary-menu {
    display:-ms-flexbox;
    display:flex
  }
  .logo_nav_holder .main_nav #primary-menu li {
    border-bottom:none
  }
  .logo_nav_holder .nav_wrapper {
    display:-ms-flexbox;
    display:flex;
    -ms-flex-align:center;
    align-items:center;
    border-top:1px solid #fff;
    border-bottom:1px solid #fff
  }
}

.btn {
  display:inline-block;
  width:fit-content;
  border:none;
  margin-right:10px;
  margin-bottom:10px;
  padding: 8px 18px;
  color:#fff;
  background-color:#6e286a;
  border-radius:0px;
  text-transform:uppercase;
  font-size:20px !important;  
  line-height:1.25;
  font-family:"museo-sans",sans-serif;
  font-weight:300 !important;
  transition: background-color 200ms ease,color 200ms ease;
  text-decoration:none !important;
  cursor:pointer;
  border-radius: var(--border-radius);
}

.main-navigation {
  clear:both;
  width:auto;
  position:relative;
  z-index:100
}
.main-navigation ul li a {
  padding:10px 20px;
  font-size:16px;
  font-weight: 300;  
}
@media screen and (min-width: 1200px) {
  .nav_icon {
    display:none
  }
  .main_nav {
    width:100%
  }
  .main_nav .main-navigation {
    width:100%
  }
  .main_nav .main-navigation.hover_sub_nav ul li:hover>.sub-menu,
  .main_nav .main-navigation.hover_sub_nav ul li.focus>.sub-menu {
    display:block
  }
  .main_nav .main-navigation.hover_sub_nav ul li:focus-within>.sub-menu {
    display:block
  }
  .main_nav .main-navigation.click_sub_nav ul li .item-has-sub-nav {
    display:-ms-flexbox;
    display:flex;
    -ms-flex-align:center;
    align-items:center
  }
  .main_nav .main-navigation.click_sub_nav ul li .item-has-sub-nav .sub-nav-icon a {
    width:20px;
    height:20px;
    padding:0;
    background-image:url("images/icon-menu-arrow.svg");
    background-size:20px;
    background-position:center center;
    transition:transform 300ms ease
  }
  .main_nav .main-navigation.click_sub_nav ul li .item-has-sub-nav .sub-nav-icon a.sub_nav_active {
    transform:rotate(180deg)
  }
  .main_nav .main-navigation ul {
    position:relative;
    z-index:999999;
    margin:0;
    padding:0;
    list-style:none;
    display:-ms-flexbox;
    display:flex;
    -ms-flex-pack:center;
    justify-content:center
  }
  .main_nav .main-navigation ul li {
    font-size:15px;
    font-size:1.5rem;
    line-height:1;
    font-weight:300;
    text-transform:uppercase;
    position:relative;
    z-index:999999
  }
  .main_nav .main-navigation ul li a {
    display:block;
    padding:16px 12px;
    color:#fff;
    transition:background-color 400ms ease
  }
  .main_nav .main-navigation ul li a:hover,
  .main_nav .main-navigation ul li a:focus {
    color:#fff;
    background-color:#6e286a
  }
  .main_nav .main-navigation ul ul {
    min-width:100%;
    white-space:nowrap;
    padding:10px 0;
    display:none;
    position:absolute;
    top:100%;
    right:0;
    z-index:99999;
    background-color:#231f20
  }
  .main_nav .main-navigation ul ul li {
    width:100%;
    height:auto;
    margin:0;
    font-size:12px;
    font-size:1.2rem
  }
  .main_nav .main-navigation ul ul li a {
    display:block;
    width:100%;
    height:auto;
    padding:10px 20px;
    line-height:1;
    color:#fff
  }
  .main_nav .main-navigation ul ul li.current-menu-item a {
    color:#007d80;
    background:none;
    border-bottom:none;
    background-color:rgba(0,0,0,0)
  }
  .main_nav .main-navigation ul ul li ul {
    min-width:100%;
    white-space:nowrap;
    display:none;
    position:absolute;
    top:0;
    right:100%;
    margin-right:-10px;
    z-index:99999
  }
  .search_icon {
    margin-right:20px
  }
}
@media screen and (min-width: 1200px) {
  .main_nav .main-navigation ul li {
    font-size:15px;
    font-size:1.5rem
  }
  .main_nav .main-navigation ul li a {
    padding:18px 20px
  }
}

.site-footer {
  width:100%;
  padding:20px 0;
  background-image:linear-gradient(90deg, #6e286a, #000);
  color:#fff
}
.footer_content {
  width:100%;
  max-width:1600px;
  margin:0 auto;
  padding:18px;
  font-size:14px;  
  display:-ms-flexbox;
  display:flex;
  -ms-flex-direction:column;
  flex-direction:column;
  gap:12px
}
.footer_content a {
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid rgba(0,0,0,0);
  transition:border-color 200ms ease
}
.footer_content a:hover {
  color:#fff;
  text-decoration:none;
  border-bottom:1px solid #fff
}
.footer_content__divide {
  display:none;
  width:1px;
  background-color:#fff
}
.footer_content__divide--invisible {
  background-color:rgba(0,0,0,0)
}
.footer_content__col {
  width:100%;
  display:-ms-flexbox;
  display:flex;
  -ms-flex-direction:column;
  flex-direction:column
}
.footer_content__col_inner {
  display:-ms-flexbox;
  display:flex;
  -ms-flex-direction:column;
  flex-direction:column;
  gap:5px
}
.footer_content__col_inner ul {
  padding:0;
  margin:0;
  list-style:none
}
.footer_content__col_inner ul li {
  font-weight:700;
  margin:5px 0
}
.footer_content__title {
  font-weight:700;
  margin:0
}
.footer_content__logo {
  width:100%;
  max-width:120px
}
.footer_content__logo picture,
.footer_content__logo img {
  width:100%;
  height:auto;
  display:block
}
.footer_content__social_icons {
  width:100%;
  display:-ms-flexbox;
  display:flex;
  -ms-flex-wrap:nowrap;
  flex-wrap:nowrap;
  -ms-flex-align:center;
  align-items:center;
  column-gap:10px
}
.footer_content__social_icons--icon {
  width:36px
}
.footer_content__social_icons--icon a {
  width:36px;
  padding:2px;
  display:block;
  border-radius:50px;
  border:2px solid #fff;
  transition:border-width .2s,background-color .2s
}
.footer_content__social_icons--icon a:hover,
.footer_content__social_icons--icon a:focus {
  border-width:1px;
  background-color:#6e286a
}
.footer_content__social_icons--icon picture,
.footer_content__social_icons--icon img {
  width:100%;
  height:auto;
  display:block
}
@media screen and (min-width: 600px) {
  .footer_content {
    -ms-flex-direction:row;
    flex-direction:row;
    -ms-flex-wrap:wrap;
    flex-wrap:wrap;
    -ms-flex-pack:justify;
    justify-content:space-between
  }
  .footer_content__col {
    width:auto;
    -ms-flex-pack:center;
    justify-content:center
  }
  .footer_content__col--contact {
    max-width:400px
  }
  .footer_content__divide {
    display:block
  }
  .footer_content__divide--links {
    background-color:rgba(0,0,0,0)
  }
  .footer_content__divide--break {
    background-color:rgba(0,0,0,0);
    -ms-flex-preferred-size:100%;
    flex-basis:100%;
    width:0
  }
}
@media screen and (min-width: 768px) {
  .site-footer {
    padding:18px 0
  }
  .footer_content {
    padding:20px;
    font-size:16px;    
    gap:14px
  }
  .footer_content__col_inner {
    gap:6px
  }
  .footer_content__col_inner ul li {
    margin:6px 0
  }
}
@media screen and (min-width: 1024px) {
  .site-footer {
    padding:22px 0
  }
  .footer_content {
    padding:22px;
    gap:16px
  }
  .footer_content__divide--links {
    background-color:#fff
  }
  .footer_content__divide--break {
    display:none
  }
  .footer_content__col_inner {
    gap:7px
  }
  .footer_content__col_inner ul li {
    margin:7px 0
  }
  .footer_content__social_icons--icon {
    width:42px
  }
  .footer_content__social_icons--icon a {
    width:42px
  }
}
@media screen and (min-width: 1200px) {
  .site-footer {
    padding:26px 0
  }
  .footer_content {
    padding:26px;
    gap:18px
  }
  .footer_content__col_inner {
    gap:8px
  }
  .footer_content__col_inner ul li {
    margin:8px 0
  }
}

/*-------------------------------------------*/
/*-MY TICKETS / TRANSACTION HISTORY ---------*/
/*-------------------------------------------*/

#Detail:has(.TransactionHistoryRow) {
  width: 100%;
}

/*-------------------------------------------*/
/*-TRANSACTION CARD -------------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow {
  width: 100%;
  max-width: var(--content-width);
  margin: 0.75rem auto;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;

  background: var(--color-card-bg);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: var(--border-radius);

  overflow: hidden;

  box-shadow: 0 4px 20px rgba(0,0,0,.2);
}

/*-------------------------------------------*/
/*-TRANSACTION HEADER -----------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow > .DetailSubHeading {
  width: 100%;
  margin: 0;
  padding: 1rem 1.5rem;

  background: rgba(255,255,255,.04);
  border-bottom: 1px solid rgba(255,255,255,.08);

  color: var(--color-text-highlight);
  font-size: var(--font-size-subheading);
  font-weight: 600;
  line-height: 1.4;
}

/*
 * The three pieces underneath the heading:
 *
 * sixcol   = description
 * fourcol  = transaction type/date
 * twocol   = View/Hide button
 */

.TransactionHistoryRow > .sixcol,
.TransactionHistoryRow > .fourcol,
.TransactionHistoryRow > .twocol {
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
}

/* Description */

.TransactionHistoryRow > .sixcol {
  flex: 1 1 45%;
  font-weight: 600;
  font-size: var(--font-size-subheading);
}

/* Date / transaction type */

.TransactionHistoryRow > .fourcol {
  flex: 1 1 35%;
  color: rgba(255,255,255,.65);
  font-size: .9rem;
}

/* Button container */

.TransactionHistoryRow > .twocol {
  flex: 0 0 auto;
  justify-content: flex-end;
}

/* View / Hide button */

.TransactionHistoryRow .LoadTransactionButton {
  min-width: 90px;
  margin: 0;
}

/*-------------------------------------------*/
/*-TRANSACTION DETAIL -----------------------*/
/*-------------------------------------------*/

#TransactionDetail145,
.TransactionHistoryRow > section {
  width: 100%;
}

/*
 * When the transaction is open, the dynamically
 * loaded content sits below the header.
 */

.TransactionHistoryRow > section:not(:empty) {
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 1.5rem;
}

/*-------------------------------------------*/
/*-SALE CONTENT -----------------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow .ninecol {
  /*width: calc(100% - 180px); QR code is hidden so making full width */
  width: 100%;
  float: left;
  padding-right: 1.5rem;
}

/*-------------------------------------------*/
/*-SALE ITEMS HEADING -----------------------*/
/*-------------------------------------------*/

.SaleItemsHeading,
.PaymentItemsHeading {
  padding: .75rem 1rem;

  background: rgba(255,255,255,.04);
  border-left: 3px solid var(--color-brand);
  border-radius: var(--border-radius);

  color: var(--color-text-highlight);
  font-size: var(--font-size-subheading);
  font-weight: 600;
  text-transform: uppercase;
}

.SaleItemsHeading {
  margin-bottom: .75rem;
}

.PaymentItemsHeading {
  margin-top: 1.5rem;
  margin-bottom: .75rem;
}

/*-------------------------------------------*/
/*-TICKET TABLE ----------------------------*/
/*-------------------------------------------*/

.SaleItems.Tickets table,
.TransactionHistoryRow table.SaleItems {
  width: 100%;
  border-collapse: collapse;
  background: transparent;
}

/* Individual ticket rows */

.SaleItems.Tickets tr.SaleItem {
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.SaleItems.Tickets tr.SaleItem:last-child {
  border-bottom: none;
}

/* Ticket cells */

.SaleItems.Tickets td {
  padding: .85rem .75rem;
  vertical-align: middle;
}

/* Quantity */

.SaleItems.Tickets td.Quantity {
  width: 45px;

  color: var(--color-text-highlight);
  font-weight: 700;
  text-align: center;
}

/* Person type */

.SaleItems.Tickets td.PersonType {
  font-weight: 600;
}

/* Seat */

.SaleItems.Tickets td.SeatType {
  color: rgba(255,255,255,.75);
  font-size: var(--font-size-subheading);
}

/* Screen */

.SaleItems.Tickets td.AuditoriumSectionName {
  color: rgba(255,255,255,.55);
  font-size: .85rem;
  text-transform: uppercase;
  white-space: nowrap;
}

/* Discount */

.SaleItems.Tickets td.Discount {
  color: var(--color-text-highlight);
  font-size: .85rem;
}

/* Price */

.SaleItems.Tickets td.PriceToPay {
  width: 100px;
  color: var(--color-text-highlight);
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
}

/* Hover */

.SaleItems.Tickets tr.SaleItem:hover {
  background: rgba(255,255,255,.025);
}

/*-------------------------------------------*/
/*-DELIVERY OPTION --------------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow .DeliveryOption {
  margin-top: .75rem;
  padding: .75rem 1rem;

  background: rgba(110,40,106,.12);
  border-radius: var(--border-radius);

  color: rgba(255,255,255,.75);
  font-size: .9rem;
}

/*-------------------------------------------*/
/*-PAYMENT ---------------------------------*/
/*-------------------------------------------*/

.PaymentItems table {
  width: 100%;
  border-collapse: collapse;
}

.PaymentItems .PaymentItem {
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.PaymentItems .PaymentItem:last-child {
  border-bottom: none;
}

.PaymentItems td {
  padding: .85rem .75rem;
}

.PaymentItems td.Description {
  color: rgba(255,255,255,.8);
}

.PaymentItems td.Amount {
  color: var(--color-text-highlight);
  font-weight: 700;
  text-align: right;
  white-space: nowrap;
}

/*-------------------------------------------*/
/*-QR CODE ----------------------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow .threecol {
  width: 180px;
  float: right;

  display: flex;
  align-items: flex-start;
  justify-content: center;

  padding: 0 0 0 1rem;
  display: none;
}

.TransactionHistoryRow .threecol img {
  display: block;
  width: 100%;
  max-width: 160px;
  height: auto;

  background: white;
  padding: 8px;

  border-radius: var(--border-radius);
}

/*-------------------------------------------*/
/*-CLEARFIX ---------------------------------*/
/*-------------------------------------------*/

.TransactionHistoryRow .clearfix {
  display: none;
}

/*-------------------------------------------*/
/*-MOBILE -----------------------------------*/
/*-------------------------------------------*/

@media (max-width: 768px) {

  .TransactionHistoryRow {
    margin: .75rem 0;
  }

  .TransactionHistoryRow > .DetailSubHeading {
    padding: .9rem 1rem;
  }

  .TransactionHistoryRow > .sixcol,
  .TransactionHistoryRow > .fourcol {
    flex: 1 1 100%;
    padding: .65rem 1rem;
  }

  .TransactionHistoryRow > .sixcol {
    padding-bottom: .25rem;
  }

  .TransactionHistoryRow > .fourcol {
    padding-top: .25rem;
  }

  .TransactionHistoryRow > .twocol {
    width: 100%;
    padding: .75rem 1rem 1rem;
    justify-content: stretch;
  }

  .TransactionHistoryRow .LoadTransactionButton {
    width: 100%;
  }

  .TransactionHistoryRow > section:not(:empty) {
    padding: 1rem;
  }

  /*
   * Put the QR code above the ticket information
   * on smaller screens.
   */

  .TransactionHistoryRow > section {
    display: flex;
    flex-direction: column;
  }

  .TransactionHistoryRow .ninecol {
    width: 100%;
    padding: 0;
    order: 2;
  }

  .TransactionHistoryRow .threecol {
    width: 100%;
    float: none;
    padding: 0 0 1.5rem;

    justify-content: center;
    order: 1;
  }

  .TransactionHistoryRow .threecol img {
    width: 150px;
  }

  /*-----------------------------------------*/
  /*-MOBILE TICKET TABLE -------------------*/
  /*-----------------------------------------*/

  .SaleItems.Tickets table,
  .SaleItems.Tickets tbody {
    display: block;
    width: 100%;
  }

  .SaleItems.Tickets tr.SaleItem {
    display: grid;

    grid-template-columns: 1fr auto;
    gap: 0;

    padding: .75rem 0;
  }

  .SaleItems.Tickets td {
    padding: .25rem 0;
  }

  .SaleItems.Tickets td.Quantity {
    display: none;
  }

  .SaleItems.Tickets td.PersonType {
    grid-column: 1;
    grid-row: 1;

    font-size: 1rem;
  }

  .SaleItems.Tickets td.PriceToPay {
    grid-column: 2;
    grid-row: 1;

    width: auto;
    font-size: 1rem;
  }

  .SaleItems.Tickets td.SeatType {
    grid-column: 1 / -1;
    grid-row: 2;

    font-size: .9rem;
  }

  .SaleItems.Tickets td.AuditoriumSectionName {
    grid-column: 1;
    grid-row: 3;

    font-size: .75rem;
  }

  .SaleItems.Tickets td.Discount {
    grid-column: 2;
    grid-row: 3;

    text-align: right;
  }

  /*-----------------------------------------*/
  /*-MOBILE PAYMENT ------------------------*/
  /*-----------------------------------------*/

  .PaymentItems td {
    padding: .75rem 0;
  }

}

/*-------------------------------------------*/
/*-SMALL MOBILE -----------------------------*/
/*-------------------------------------------*/

@media (max-width: 480px) {

  .TransactionHistoryRow > .DetailSubHeading {
    font-size: 14px;
  }

  .TransactionHistoryRow > .sixcol {
    font-size: .9rem;
  }

  .TransactionHistoryRow > .fourcol {
    font-size: .8rem;
  }

  .SaleItemsHeading,
  .PaymentItemsHeading {
    font-size: .9rem;
  }

  .TransactionHistoryRow .threecol img {
    width: 130px;
  }

}

</style>


<script>
  function showOverlayAndPopup(aPopupElementID) { 
    document.getElementById(aPopupElementID).style.display = "block";
    if (document.getElementById("Overlay"))
      document.getElementById("Overlay").style.display = "block";
  }
  function hideOverlayAndPopup(aPopupElementID) {
    document.getElementById(aPopupElementID).style.display = "none";
    if (document.getElementById("Overlay"))
      document.getElementById("Overlay").style.display = "none";
  }
</script>
<script>
  function getXMLHttp() { 
    if (window.XMLHttpRequest) 
      return(new XMLHttpRequest()) // code for IE7+, Firefox, Chrome, Opera, Safari 
    else 
      return(new ActiveXObject("Microsoft.XMLHTTP")); // code for IE6, IE5 
  }
</script><script type="text/javascript">

  function ShowSaleItemPrompt(itemid) {
    var elem = document.getElementById("SaleItem" + itemid + "_Prompt");
    var spans = elem.querySelectorAll("span");
    for(var i = 0; i < spans.length; i++) {
      if (spans[i].classList.contains("activeoption"))
        spans[i].classList.remove("activeoption");
      if (spans[i].getAttribute("_def") == "1")
        spans[i].classList.add("activeoption");
    }
    var divs = elem.querySelectorAll("div.ProductComponents");
    for(var i = 0; i < divs.length; i++) {
      if (divs[i].getAttribute("_def") == "0")
        divs[i].style.display = 'none';
    }
    var err = elem.querySelectorAll(".Error");
    if (err.length > 0)
      err[0].textContent = "";
    elem.style.display = 'block';
  }
  function SaleItemQuantity(itemid, qty) {
    var q = parseInt(document.getElementById(itemid).value);
    q += qty;
    if (q < 0) q = 0;
    document.getElementById(itemid).value = q;
  }
  function PostbackBasketToServer() {
  }

  function RemoveSaleItem(itemid, inputid, itemnum, itemprice) {
    var elem = document.getElementById("SaleItem" + itemid + "_" + itemnum);
    if (elem != null) {
      elem.parentNode.removeChild(elem);
      var input = document.getElementById(inputid);
      if (input)
        input.parentNode.removeChild(input);
      var bCounts = document.getElementsByClassName("basket-count");
      for (i = 0; i < bCounts.length; i++)
        bCounts[i].textContent = parseInt(bCounts[i].textContent) - 1;
      var bTotal = document.getElementById("basket-total");
      if (bTotal)
        bTotal.textContent = (parseFloat(bTotal.textContent) - itemprice).toFixed(2);
      PostbackBasketToServer();
    }
  }

  function AddSaleItemWithOptions(itemid, name, baseprice, shouldPostback) {
    var values = "";
    var options = [];
    var prices = [];
    var i = 0;
    do {
      var container = document.getElementById("SaleItem" + itemid + "_Option" + i);
      if (container == null) break;
      if (container.parentNode.style.display != 'none') {
        var children = container.getElementsByClassName("option");
        var selOptions = 0;
        var minOptions = 0;
        for (var j = 0; j < children.length; j++) {
          minOptions = parseInt(children[j].getAttribute("_min"));
          if (children[j].classList.contains("activeoption")) {
            values += children[j].getAttribute("_value") + "_";
            prices.push(parseFloat(children[j].getAttribute("_price")));
            options.push(children[j].getAttribute("_name"));
            selOptions++;
          }
        }
        if (selOptions < minOptions) {
          var errDiv = document.getElementById("SaleItem" + itemid + "_Error");
          errDiv.textContent = "Error - please select at least " + minOptions + " option(s) before continuing";
          container.classList.add("is-danger");
          return;
        }
      }
      i++;
    } while (true);
    values = values.substring(0, values.length - 1);
    AddSaleItem(itemid, name, values, baseprice, prices, options, shouldPostback);
  }

  function AddSaleItem(itemid, name, optionvalues, baseprice, optionprices, optionnames, shouldPostback) {
    var TheAddToOrderButton = document.getElementById("SaleItem" + itemid + "_button");
    TheAddToOrderButton.classList.add("is-loading");
    var parent = document.getElementById("basket-items");
    var formParent = document.getElementById("SaleItemAddedItems" + itemid);
    if (parent == null)
      parent = formParent;

    var itemCount = 1;
    while (document.getElementById("SaleItem" + itemid + "_" + itemCount) != null)
      itemCount++;

    var itemDiv = document.createElement("div");
    itemDiv.className = "SaleAddedItem";
    itemDiv.id = "SaleItem" + itemid + "_" + itemCount;
    var itemInput = document.createElement("input");
    itemInput.id = "RetailItemPopup" + "_" + itemid + "_" + itemCount;
    itemInput.name = itemInput.id;
    itemInput.type = "hidden";
    if (optionvalues == "")
      itemInput.value = "_";
    else
      itemInput.value = optionvalues;
    formParent.appendChild(itemInput);

    var nameDiv = document.createElement("div");
    nameDiv.className = "basketItemName";
    itemDiv.appendChild(nameDiv);
    var nameSpan = document.createElement("span");
    nameSpan.textContent = name;
    nameDiv.appendChild(nameSpan);
    nameSpan = document.createElement("span");
    nameSpan.textContent = String.fromCharCode(163) + baseprice.toFixed(2);
    nameSpan.className = "itemPrice";
    nameDiv.appendChild(nameSpan);

    var descDiv = document.createElement("div");
    descDiv.className = "basketItemOptions";
    itemDiv.appendChild(descDiv);
    var optDiv = document.createElement("div");
    descDiv.appendChild(optDiv);
    var price = baseprice;

    var lastID = "";
    var options = optionvalues.split('_');
    for (var i = 0; i < optionprices.length; i++) {
      var pID = options[i].split('-')[0];
      if (lastID != "") {
        if ((pID != lastID) && (lastID != "")) {
          var optDiv = document.createElement("div");
          descDiv.appendChild(optDiv);
        }
      }
      lastID = pID;
      var optSpan = document.createElement("span");
      optDiv.appendChild(optSpan);
      optSpan.textContent = optionnames[i];
      if (optionprices[i] > 0) {
        var priceSpan = document.createElement("span");
        priceSpan.textContent += " (+" + String.fromCharCode(163) + optionprices[i].toFixed(2) + ") ";
        priceSpan.className = "itemPrice";
        optSpan.appendChild(priceSpan);
      }
      price += optionprices[i];
    }
    var optDiv = document.createElement("div");
    optDiv.classList.add("totalPrice");
    optDiv.textContent = "Total price "
    descDiv.appendChild(optDiv);
    var priceSpan = document.createElement("span");
    priceSpan.textContent += String.fromCharCode(163) + price.toFixed(2);
    priceSpan.className = "itemPrice";
    optDiv.appendChild(priceSpan);
    var span = document.createElement("span");
    span.className = "basketItemRemove";
    span.textContent = "X";
    span.setAttribute("onclick", "RemoveSaleItem('" + itemid + "', '" + itemInput.id + "', '" + itemCount + "', " + price + ")");
    span.className = "Button Close";
    itemDiv.appendChild(span);

    parent.appendChild(itemDiv);
    setTimeout(function(){
      TheAddToOrderButton.classList.add("complete");
      TheAddToOrderButton.classList.remove("is-loading");
      setTimeout(function(){
        document.getElementById("SaleItem" + itemid + "_Prompt").style.display = 'none';
        TheAddToOrderButton.classList.remove("complete");
      }, 0);
    }, 0);

    var bCounts = document.getElementsByClassName("basket-count");
    for (i = 0; i < bCounts.length; i++)
      bCounts[i].textContent = parseInt(bCounts[i].textContent) + 1;

    var bTotal = document.getElementById("basket-total");
    if (bTotal)
        bTotal.textContent = (parseFloat(bTotal.textContent) + price).toFixed(2);
    if (shouldPostback)
      PostbackBasketToServer();
  }
  function SetActiveTab(num) {
    var x = document.getElementsByClassName("NewStyleWebTab");
    for (var i = 0; i < x.length; i++) {
      document.getElementById("span_tab" + i).classList.remove("SelectedWebTab");
      document.getElementById("span_tab" + i).classList.remove("WebTab");

      if (x[i].id == "div_tab" + num) {
        x[i].style.display = "flex";
        document.getElementById("span_tab" + i).classList.add("SelectedWebTab");
      } else {
        x[i].style.display = "none";
        document.getElementById("span_tab" + i).classList.add("WebTab");
      }
    }
  }

  function SelectSaleItemOptionMulti(itemid, optnumber, optvalue, numoptions) {
    var container = document.getElementById("SaleItem" + itemid + "_Option" + optnumber);
    var children = container.getElementsByClassName("option");
    var selected = 0;
    for (var i = 0; i < children.length; i++) {
      if (children[i].classList.contains("activeoption")) {
        selected++;
        if (children[i].getAttribute("_value") == optvalue) {
          //deselect
          children[i].classList.remove("activeoption");
          SetDisplay(children[i].getAttribute("_prompt"), false);
          return;
        }
      }
    }
    if (selected < numoptions) {
      for (var i = 0; i < children.length; i++)
        if (children[i].getAttribute("_value") == optvalue) {
          children[i].classList.add("activeoption");
          SetDisplay(children[i].getAttribute("_prompt"), true);
        }
    }
  }

  function SetDisplay(which, isVisible) {
      var elem = document.getElementById(which);
      if (elem != null) {
        if (isVisible)
          elem.style.display = 'block';
        else
          elem.style.display = 'none';
      }
  }

  function SelectSaleItemOption(itemid, optnumber, optvalue) {
    var container = document.getElementById("SaleItem" + itemid + "_Option" + optnumber);
    container.classList.remove("is-danger");
    var children = container.getElementsByClassName("option");
    for (var i = 0; i < children.length; i++) {
      if (children[i].getAttribute("_value") == optvalue) {
          children[i].classList.add("activeoption");
          SetDisplay(children[i].getAttribute("_prompt"), true);
      } else {
          children[i].classList.remove("activeoption");
          SetDisplay(children[i].getAttribute("_prompt"), false);
      }
    }
  }
  function ShowUpsellPopup() {
    var theForm = document.getElementById("UpsellForm");
    var popupContainer = document.getElementById("UpsellPopupFormContainer");
    if (theForm && popupContainer) {
      var placeholderDiv = document.createElement("div");
      placeholderDiv.id = "UpsellFormPlaceholder";
      theForm.parentElement.insertBefore(placeholderDiv, theForm);
      popupContainer.appendChild(theForm);
    }

    showOverlayAndPopup("UpsellPopup");
  }

  function HideUpsellPopup() {
    var theForm = document.getElementById("UpsellForm");
    var placeholderDiv = document.getElementById("UpsellFormPlaceholder");
    if (theForm && placeholderDiv) {
      placeholderDiv.parentElement.replaceChild(theForm, placeholderDiv);
    }

    hideOverlayAndPopup("UpsellPopup");
  }
</script>
<script type="text/javascript">

function ValidateMembershipPatronDetails(aPatronNumberOrEmailAddress, aPatronPostcode, aOnComplete) { 
  var xmlhttp = getXMLHttp(); 
  xmlhttp.onreadystatechange = function () {
      if ((xmlhttp.readyState == 4) && (xmlhttp.status == 200)) {
        var TheResponse = JSON.parse(xmlhttp.responseText);
        if (TheResponse.Response == "OK") 
          aOnComplete(true, TheResponse.PatronFullName, TheResponse.PatronNumber);
        else
          aOnComplete(false, "", "");
      }
  }
  xmlhttp.open("POST", "https://book.ilkleycinema.co.uk/IlkleyCinema.dll/ValidatePatronDetails");
  xmlhttp.setRequestHeader('Content-type', 'application/x-www-form-urlencoded')
  xmlhttp.send("PatronNumberOrEmailAddress=" + encodeURI(aPatronNumberOrEmailAddress) + "&PatronPostcode=" + encodeURI(aPatronPostcode), true);
}
            var membershipItem = {
                isRenewal: null,
                autoRenew: null,
                priceToPay: null,
                startDate: null,
                isForMe: null,
                otherPatronNumber: null,
                otherPatronPostCode: null,
                otherPatronFullName: null,
                validationCode: null,
                shouldCreatePatron: null
            }

            function AddMembershipDiv(aParentElement, aId, aClassName, aInnerHTML) {
                var div = document.createElement('div');
                div.id = aId;
                div.className = aClassName
                div.innerHTML = aInnerHTML;

                aParentElement.appendChild(div);

                return div;
            }

            function AddMembershipLabelledInput(aParentElement, aInputType, aId, aName, aLabelHTML, aValue) {
                var div = document.createElement('div');
                div.classList.add("field");

                var label = document.createElement('label');
                label.innerHTML = aLabelHTML;
                label.classList.add("label");
                label.setAttribute('for', aId);

                var input = document.createElement('input');
                if ((aInputType !== 'checkbox') && (aInputType !== 'radio')){
                  input.classList.add("input");
                  input.setAttribute("placeholder", aLabelHTML);
                }
                input.type = aInputType;
                input.id = aId;
                input.name = aName;
                input.value = aValue;
                var Control = document.createElement("div");
                Control.classList.add("control");
                if ((aInputType == 'checkbox') || (aInputType == 'radio')) {
                    Control.appendChild(label);
                    label.classList.add("checkbox");
                    label.prepend(input);
                }
                else {
                    div.appendChild(label);
                    Control.appendChild(input);
                }
                div.appendChild(Control);

                aParentElement.appendChild(div);

                return input;
            }

            function AddMembershipButton(aParentElement, aCaption, aOnClick) {
                var button = document.createElement('a');
                button.innerHTML = aCaption;
                button.classList.add("Button");
                button.classList.add("button");
                button.addEventListener('click', aOnClick);

                var div = document.createElement('div');
                div.appendChild(button);

                aParentElement.appendChild(div);

                return button;
            }

            function InitMembershipDialog(aDialogContentId, aHeading) {
                divContent = document.getElementById(aDialogContentId);
                divContent.innerHTML = '';

                AddMembershipDiv(divContent, '', 'PopupDialogHeading', aHeading);
                AddMembershipDiv(divContent, aDialogContentId + 'dialogErrorMessage', 'DialogErrorMessage', '');

                return divContent;
            }

            function SetMembershipDialogErrorMessage(aDialogContentId, aErrorMessageHTML) {
                document.getElementById(aDialogContentId + 'dialogErrorMessage').innerHTML = aErrorMessageHTML;
            }


            function ShowMembershipPageOne(aDialogContentId, aMembershipType, aIsRenewal, aStartDate, aIsForMe, aOtherPatronNumber, aOtherPatronPostCode, aOtherPatronFullName) {
                // Reset everything
                membershipItem.isRenewal = aIsRenewal;
                membershipItem.autoRenew = null;
                membershipItem.priceToPay = null;
                membershipItem.startDate = aStartDate;
                membershipItem.isForMe = aIsForMe;
                membershipItem.otherPatronNumber = aOtherPatronNumber;
                membershipItem.otherPatronPostCode = aOtherPatronPostCode;
                membershipItem.otherPatronFullName = aOtherPatronFullName;
                membershipItem.validationCode = "";
                membershipItem.shouldCreatePatron = null;

                var divContent = InitMembershipDialog(aDialogContentId, '');

                // Start Date (if editable)
                if (aMembershipType.allowEditStartDate) {
                    var inputStartDate = AddMembershipLabelledInput(divContent, 'date', 'Membership_StartDate', '', 'Start Date');
                    inputStartDate.addEventListener('input', () => UpdateDuration(aMembershipType));
                    inputStartDate.value = membershipItem.startDate;
                }

                // Duration
                AddMembershipDiv(divContent, 'Membership_Duration', 'duration', MembershipDurationFmt(aMembershipType, membershipItem, ''));

                // Auto-Renew (if allowed)
                if (aMembershipType.allowAutoRenew) {

                    chkAutoRenew = AddMembershipLabelledInput(divContent, 'checkbox', 'Membership_AutoRenew', '',  'Automatically Renew');

                }

                // Overpaymnet (if allowed)
                if (aMembershipType.allowOverpayment) {
                    inputPriceToPay = AddMembershipLabelledInput(divContent, 'input', 'Membership_PriceToPay', '',  'Price to Pay', aMembershipType.currentPrice.toFixed(2));
                }

                // Validation Code (if required)
                if (aMembershipType.isValidationCodeRequired) {
                    inputValidationCode = AddMembershipLabelledInput(divContent, 'input', 'Membership_ValidationCode', '',  aMembershipType.validationCodePromptText, '');
                }

                var shouldSkipPrompts =   !aMembershipType.allowEditStartDate &&   !aMembershipType.allowOverpayment &&   !aMembershipType.isValidationCodeRequired &&   !membershipItem.isRenewal &&   !aMembershipType.isJoint &&   !aMembershipType.allowPurchaseForSomeoneElse &&   !aMembershipType.allowAutoRenew; 
                // Next button
                var doNext = () => {
                    if (aMembershipType.isValidationCodeRequired && (inputValidationCode.value.trim() == '')) {
                        SetMembershipDialogErrorMessage(aDialogContentId, aMembershipType.validationCodePromptText + ' is required');
                        return;
                    }
                    if (aMembershipType.allowEditStartDate && (inputStartDate.value == '')) {
                        SetMembershipDialogErrorMessage(aDialogContentId, 'Start Date is required');
                        return;
                    }
                    membershipItem.autoRenew = aMembershipType.allowAutoRenew && chkAutoRenew.checked;

                    if (aMembershipType.allowEditStartDate)
                        membershipItem.startDate = inputStartDate.value;

                    if (aMembershipType.allowOverpayment) 
                        membershipItem.priceToPay = parseFloat(inputPriceToPay.value);

                    if (aMembershipType.isValidationCodeRequired) 
                        membershipItem.validationCode = inputValidationCode.value;

                    if (membershipItem.isRenewal) 
                        ShowMembershipPage_Summary(aDialogContentId, aMembershipType, false);
                    else if (!aMembershipType.isJoint && membershipItem.autoRenew) {
                        membershipItem.isForMe = true;
                        ShowMembershipPage_Summary(aDialogContentId, aMembershipType, false);
                    }
                    else if (aMembershipType.isJoint) {
                        membershipItem.isForMe = true;
                        ShowMembershipPage_SelectPatron(aDialogContentId, aMembershipType);
                    }
                    else {
                      if (aMembershipType.allowPurchaseForSomeoneElse)
                        ShowMembershipPage_SelectForMeOrSomeoneElse(aDialogContentId, aMembershipType);
                      else {
                        membershipItem.isForMe = true;
                        ShowMembershipPage_Summary(aDialogContentId, aMembershipType, shouldSkipPrompts);
                      }
                    }
                };
                if (shouldSkipPrompts) 
                  doNext();
                else 
                  AddMembershipButton(divContent, 'Next', doNext);
            }

            function ShowMembershipPage_SelectForMeOrSomeoneElse(aDialogContentId, aMembershipType) {
                var divContent = InitMembershipDialog(aDialogContentId, 'Who is the Membership for?');

                // Membership is for me
                rdoForMe = AddMembershipLabelledInput(divContent, 'radio', 'ForMe', 'ForWhom', 'Membership is for me', 'Y');
                // Membership is for someone else
                rdoForSomeoneElse = AddMembershipLabelledInput(divContent, 'radio', 'ForSomeoneElse', 'ForWhom', 'Membership is for someone else', 'N');

                // Next button
                AddMembershipButton(divContent, 'Next', () => {
                    if (!rdoForMe.checked && !rdoForSomeoneElse.checked) {
                        SetMembershipDialogErrorMessage(aDialogContentId, 'Please choose who the Membership is for');
                        return;
                    }

                    membershipItem.isForMe = rdoForMe.checked;

                    if (rdoForMe.checked)
                        ShowMembershipPage_Summary(aDialogContentId, aMembershipType, false)
                    else
                        ShowMembershipPage_SelectPatron(aDialogContentId, aMembershipType);
                });
            }            

            function ShowMembershipPage_SelectPatron(aDialogContentId, aMembershipType) {

                var divContent = InitMembershipDialog(aDialogContentId, aMembershipType.isJoint ? 'Choose Joint Member' : 'Choose Member');

                var blurb = document.createElement('div');
                blurb.classList.add('SelectOtherPatronBlurb');
                divContent.appendChild(blurb);

                if (aMembershipType.isJoint)
                  blurb.innerHTML = 'NB: The Patron with whom you are becoming a joint member must already have an Account on the system';
                else
                  blurb.innerHTML = 'NB: The Patron for whom you are purchasing this membership must already have an Account on the system';

                var inputPatronNumberOrEmailAddress = AddMembershipLabelledInput(divContent, 'text', '', '', 'Patron Number / Email Address', '');
                var inputPostCode = AddMembershipLabelledInput(divContent, 'text', '', '', 'Post Code', '');

                var divProgress = AddMembershipDiv(divContent, '', '', 'Please wait...');
                divProgress.style.visibility = 'hidden';

                // Next button
                AddMembershipButton(divContent, 'Check Details', () => {
                    if (inputPatronNumberOrEmailAddress.value == '') {
                        SetMembershipDialogErrorMessage(aDialogContentId,
                            'Please specify the ' + (aMembershipType.isJoint ? 'Joint ' : '') + 'Member\'s Patron Number / Email Address');
                        return;
                    }

                    if (inputPostCode.value == '') {
                        SetMembershipDialogErrorMessage(aDialogContentId,
                            'Please specify the ' + (aMembershipType.isJoint ? 'Joint ' : '') + 'Member\'s Post Code');
                        return;
                    }

                    divProgress.style.visibility = 'visible';

                    ValidateMembershipPatronDetails(inputPatronNumberOrEmailAddress.value, inputPostCode.value,   (aDoesPatronExist, aPatronFullName, aPatronNumber) => {
                         if (aDoesPatronExist) {
                            membershipItem.otherPatronNumber = aPatronNumber;
                            membershipItem.otherPatronPostCode = inputPostCode.value;
                            membershipItem.otherPatronFullName = aPatronFullName;

                            ShowMembershipPage_Summary(aDialogContentId, aMembershipType, false);
                        }
                        else {
                            ShowMembershipPage_TryAgainSelectPatronOrCreateNew(aDialogContentId, aMembershipType);
                        }
                    });
                });
            }

            function ShowMembershipPage_TryAgainSelectPatronOrCreateNew(aDialogContentId, aMembershipType) {
                var divContent = InitMembershipDialog(aDialogContentId, 'Check Failed');

                AddMembershipDiv(divContent, '', '', 'We were unable to find a match in the system');

                AddMembershipButton(divContent, 'Try Again', () => {
                    ShowMembershipPage_SelectPatron(aDialogContentId, aMembershipType);
                });

            }

            function ShowMembershipPage_Summary(aDialogContentId, aMembershipType, aAddAndGoToBasketImmediately) {
                var divContent = InitMembershipDialog(aDialogContentId, 'Summary');

                AddMembershipDiv(divContent, '', '', MembershipItemFmt(aMembershipType, membershipItem, '<br/>'))
                if (membershipItem.autoRenew){
                  var blurb = document.createElement('div');
                  blurb.classList.add('AutoRenewMembershipBlurb');
                  blurb.classList.add('notification');
                  divContent.appendChild(blurb);
                  blurb.innerHTML = 'By selecting Automatically Renew I accept that the Credit/Debit Card I use to complete this purchase will be charged again every time my Membership expires';
                }

                // Add to Order button
                var doAdd = () => {
                    aMembershipType.doAddMembership(aMembershipType, membershipItem);
                    hideOverlayAndPopup(aMembershipType.popupId);
                };
                if (aAddAndGoToBasketImmediately) 
                  doAdd();
                else 
                  AddMembershipButton(divContent, 'Add to Order', doAdd); 
            }
   function ForCommaText(aString) {
            return (aString == null ? null : '"' + aString.replace('"', '""') + '"');
        }
   function DateToStr_(aDate) {
       var d = new Date(aDate),
           month = '' + (d.getMonth() + 1),
           day = '' + d.getDate(),
           year = d.getFullYear();

       if (month.length < 2)
           month = '0' + month;
       if (day.length < 2)
           day = '0' + day;
       return [year, month, day].join('-');
   }
   function DateFmtDMMMYYYY(aDate) {
     var ShortMonths = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
     return aDate.getDate() + ' ' + ShortMonths[aDate.getMonth()] + ' ' + aDate.getFullYear();
   }
   function getAutoRenewPrice(aDate, aMembershipType) {
     var theDate = new Date(aDate);
     for (var i = 0; i < aMembershipType.autoRenewPricingRules.length; i++) {
       var startDate = new Date(aMembershipType.autoRenewPricingRules[i].start);
       var endDate = new Date(aMembershipType.autoRenewPricingRules[i].end);
       if ((theDate >= startDate) && (theDate <= endDate))
         return aMembershipType.autoRenewPricingRules[i].price;
     }
     return aMembershipType.autoRenewPricingRules[0].price;
   }
   function IntDiv(a,b) {
     var result = a/b;
     if(result >= 0)
       return Math.floor(result);
     else
       return Math.ceil(result);
   }
   function IsLeapYear(aYear) {
     return (aYear % 4 == 0) && ((aYear % 100 != 0) || (aYear % 400 == 0));
   }
   function IncMonths(aDate, aNumberOfMonths) {
     var sign = aNumberOfMonths >= 0 ? 1 : -1;
     var year = aDate.getFullYear() + IntDiv(aNumberOfMonths, 12);
     var month = aDate.getMonth() + aNumberOfMonths % 12;
     if (month > 11) {
       year = year + sign;
       month = month -12 * sign;
     }
    var MonthDays;
    if (IsLeapYear(year))
   	   MonthDays = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
     else
       MonthDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
     var day = aDate.getDate();
     if (day > MonthDays[month])
       day = MonthDays[month];
     return new Date(year, month, day);
   }
   function getEndDate(aStartDate, aMembershipType) {
     var result = new Date(aStartDate);
     if (aMembershipType.validityType == 'DAYS')
       result.setDate(result.getDate() + aMembershipType.validityNumPeriods);
     else if (aMembershipType.validityType == 'WEEKS')
       result.setDate(result.getDate() + 7 * aMembershipType.validityNumPeriods);
     else if (aMembershipType.validityType == 'MONTHS')
       result = IncMonths(result, aMembershipType.validityNumPeriods);
     else if (aMembershipType.validityType == 'YEARS')
       result = IncMonths(result, aMembershipType.validityNumPeriods * 12);
     result.setDate(result.getDate() - 1);
     return result;
   }
function MembershipDurationFmt(aMembershipType, aMembershipItem, aDelimiter) {
    details = aMembershipType.durationIfFixedFmt;
    if (aMembershipType.allowEditStartDate) {
        if (aMembershipItem.startDate != '') {
            var startDate = new Date(aMembershipItem.startDate);
            details += DateFmtDMMMYYYY(startDate) + ' to ' + DateFmtDMMMYYYY(getEndDate(startDate, aMembershipType));
        } else {
            details += '&nbsp;';
        }
    }
    if (details != '') details = aDelimiter + details;
    return details;
}
function UpdateDuration(aMembershipType) {
    membershipItem.startDate =  document.getElementById('Membership_StartDate').value;
    document.getElementById('Membership_Duration').innerHTML = MembershipDurationFmt(aMembershipType, membershipItem, '');
}
function MembershipItemFmt(aMembershipType, aMembershipItem, aDelimiter) {
    var details = "Price: \xA3";
    if (aMembershipType.allowOverpayment)
        details += aMembershipItem.priceToPay.toFixed(2);
    else if (aMembershipItem.autoRenew)
        details += getAutoRenewPrice(aMembershipItem.startDate, aMembershipType).toFixed(2);
    else
        details += aMembershipType.currentPrice.toFixed(2);
    details += aDelimiter + "For ";
    if (aMembershipItem.isForMe && !aMembershipType.isJoint) details += "me";
    if (aMembershipItem.isForMe && aMembershipType.isJoint) details += "me and " + aMembershipItem.otherPatronFullName;
    if (!aMembershipItem.isForMe) details += aMembershipItem.otherPatronFullName;
    details += MembershipDurationFmt(aMembershipType, aMembershipItem, aDelimiter);
    if (aMembershipItem.autoRenew) details += " (Auto-renew)";
    return details;
}
function EncodeAddMembershipRenewalParameters(aMembershipType, aMembershipItem) {
    details = '.';
    details += (aMembershipItem.autoRenew ? 'Y' : 'N');
    details += DateToStr_(aMembershipItem.startDate);
    details += '.';
    if (aMembershipType.allowOverpayment)
        details += (aMembershipItem.priceToPay * Math.pow(10, 2)).toFixed(0);
    else if (aMembershipItem.autoRenew)
        details += (getAutoRenewPrice(aMembershipItem.startDate, aMembershipType) * Math.pow(10, 2)).toFixed(0);
    else
        details += (aMembershipType.currentPrice * Math.pow(10, 2)).toFixed(0);
    details += '.';
    details += encodeURI(aMembershipItem.validationCode);
    return details;
}
function AddMembershipItemToPageAndCreateHiddenInput(aMembershipType, aMembershipItem) {
    const MEMBERSHIP_ITEMS_FOR_MEMBERSHIP_TYPE_ID_PREFIX = 'MembershipItemsForType';

    var parent = document.getElementById(MEMBERSHIP_ITEMS_FOR_MEMBERSHIP_TYPE_ID_PREFIX + aMembershipType.membershipTypeUniqueId);

    var itemIndex = 1;
    while (document.getElementById(aMembershipType.membershipItemUniqueIDPrefix + itemIndex) != null)
        itemIndex++;

    var divMembershipItem = document.createElement("div");
    divMembershipItem.className = "MembershipSaleAddedItem SaleAddedItem";
    divMembershipItem.id = aMembershipType.membershipItemUniqueIDPrefix + itemIndex;

    var hiddenInput = document.createElement("input");
    hiddenInput.type = "hidden";
    hiddenInput.name = aMembershipType.membershipItemUniqueIDPrefix + itemIndex;
    hiddenInput.value =
        "AutoRenew=" + (aMembershipItem.autoRenew ? "Y" : "N") +
        ",IsForMe=" + (aMembershipItem.isForMe ? "Y" : "N") +
        ",OtherPatronNumber=" + aMembershipItem.otherPatronNumber +
        ",OtherPatronPostCode=" + ForCommaText(aMembershipItem.otherPatronPostCode) +
        ",PriceToPay=" + aMembershipItem.priceToPay +
        ",ValidationCode=" + ForCommaText(aMembershipItem.validationCode) +
        ",StartDate=" + DateToStr_(aMembershipItem.startDate);
    divMembershipItem.appendChild(hiddenInput);

    parent.appendChild(divMembershipItem);
}

</script>
</head>
