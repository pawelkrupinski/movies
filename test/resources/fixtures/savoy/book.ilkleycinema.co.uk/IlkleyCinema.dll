			<table cellpadding="0"><tr valign="top"><td><table cellpadding="0"><tr><td class="PeformanceListDate">Tuesday 20 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus"><a class="Button" href="https://book.ilkleycinema.co.uk/IlkleyCinema.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_1030.TcsWebTab_1031.TcsPerformance_12240126.TcsSection_523880" title="Click to Book">18:00</a></span></td></tr></table></td></tr></table>
