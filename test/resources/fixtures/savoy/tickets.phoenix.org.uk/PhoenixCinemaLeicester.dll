    </h3>
    <div class="filmtimes"><table cellpadding="0"><tr valign="top"><td><table cellpadding="0"><tr><td class="PeformanceListDate">Thursday 18 Feb 2027</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">7:00pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14089124.TcsSection_528">Book Now</a></span></td></tr><tr><td class="PeformanceListDate">Saturday 20 Feb 2027</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">5:00pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14089132.TcsSection_4075334">Book Now</a><span class="PerformanceNotesSmall"> (Descriptive subtitles)</span></span></td></tr><tr><td class="PeformanceListDate">Sunday 21 Feb 2027</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">3:00pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14089140.TcsSection_528">Book Now</a></span></td></tr></table></td></tr></table></div>
