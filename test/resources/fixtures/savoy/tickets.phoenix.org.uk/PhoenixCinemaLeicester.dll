@media (min-width: 767px) {
  #SideBar{
    display: block !important;
  }
}
@media (max-width: 767px) {
  #SideBar{
    display: none;
    position: fixed;
    bottom: 26px;
    width: 100%;
    left: 0px;
    z-index: 9;
    background: #FFF;
  }
  .SideBarFirstHeading, .SideBarHeading {
    display: none;
  }

  .SideBarItem a{
    text-indent: 5px;
    display: block;
    background: #ECECEC;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 2px;
    text-align: center;
    line-height: 2.5em;
  }

  .SideBarItem a:hover {
    background: #CCC;
    color: #060606;
  }

  .SideBarToggle{
    display: block;
    width: 100%;
    position: relative;
    margin: 0;
    cursor: pointer;
    padding: 10px;
    background: #ECECEC;
    text-transform: uppercase;
  }
  .SideBarToggle:hover{
    background: #CCC;
  }
  .SideBarToggle span{
    position: absolute;
    right: 5px;
    font-size: 2.5em;
    line-height: 2em;
    line-height: 0.6em;
    color: #666;
  }
  #SideBarToggleMenu{
    display: block;
    position: fixed;
    bottom: 0px;
    width: 100%;
    left: 0px;
    z-index: 9;
  }
}

