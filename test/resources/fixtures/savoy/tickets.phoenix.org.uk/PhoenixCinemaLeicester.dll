    </h3>
    <div class="filmtimes"><table cellpadding="0"><tr valign="top"><td><table cellpadding="0"><tr><td class="PeformanceListDate">Friday 30 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">12:30pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_13957780.TcsSection_4075334">Book Now</a></span></td></tr><tr><td class="PeformanceListDate">Friday 30 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">5:30pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_13945437.TcsSection_4075334">Book Now</a><span class="PerformanceNotesSmall"> (Descriptive subtitles)</span></span></td></tr><tr><td class="PeformanceListDate">Friday 30 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">8:15pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_13945439.TcsSection_4075334">Book Now</a></span></td></tr><tr><td class="PeformanceListDate">Saturday 31 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">12:00pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14058583.TcsSection_4078727">Book Now</a></span></td></tr><tr><td class="PeformanceListDate">Saturday 31 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">5:30pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_13945442.TcsSection_407872