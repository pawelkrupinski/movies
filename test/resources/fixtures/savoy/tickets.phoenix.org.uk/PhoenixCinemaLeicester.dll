    <div class="filmtimes"><table cellpadding="0"><tr valign="top"><td><table cellpadding="0"><tr><td class="PeformanceListDate">Monday 12 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">5:15pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14032715.TcsSection_4078727">Book Now</a><span class="PerformanceNotesSmall"> (Descriptive subtitles)</span></span></td></tr><tr><td class="PeformanceListDate">Thursday 15 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">1:30pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14081018.TcsSection_851">Book Now</a></span></td></tr><tr><td class="PeformanceListDate">Thursday 15 Oct 2026</td><td width="10px"></td><td class="PeformanceListTimes"><span class="StartTimeAndStatus">8:20pm <a class="Button" href="https://tickets.phoenix.org.uk/PhoenixCinemaLeicester.dll/TSelectItems.waSelectItemsPrompt.TcsWebMenuItem_437.TcsWebTab_438.TcsPerformance_14032717.TcsSection_4075334">Book Now</a></span></td></tr></table></td></tr></table></div>
