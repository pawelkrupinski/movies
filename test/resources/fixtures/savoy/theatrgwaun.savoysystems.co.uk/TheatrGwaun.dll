@import url(https://fonts.googleapis.com/css?family=Arimo:400,600,700,300,400italic,300italic,600italic,700italic);

@font-face {
  font-family: 'icomoon';
  src:url('/TheatrGwaun/fonts/icomoon.eot?-jueuzf');
  src:url('/TheatrGwaun/fonts/icomoon.eot?#iefix-jueuzf') format('embedded-opentype'),
    url('/TheatrGwaun/fonts/icomoon.woff?-jueuzf') format('woff'),
    url('/TheatrGwaun/fonts/icomoon.ttf?-jueuzf') format('truetype'),
    url('/TheatrGwaun/fonts/icomoon.svg?-jueuzf#icomoon') format('svg');
  font-weight: normal;
  font-style: normal;
}

[class^="icon-"], [class*=" icon-"] {
  font-family: 'icomoon';
  speak: none;
  font-style: normal;
  font-weight: normal;
  font-variant: normal;
  text-transform: none;
  line-height: 1;

  /* Better Font Rendering =========== */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

