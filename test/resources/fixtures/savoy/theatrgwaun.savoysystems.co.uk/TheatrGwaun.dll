    width: 98% !important;
    font-size: 1.2em;
    line-height: 1.5em;
  }
  #SeatingPlanDiv{
    /*width: 100% !important;*/
  }
  .SeatingPlanProtector{
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    background: #333;
    /* IE 8 */
    -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=50)";
    /* IE 5-7 */
    filter: alpha(opacity=50);
    /* Netscape */
    -moz-opacity: 0.5;
    /* Safari 1.x */
    -khtml-opacity: 0.5;
    /* Good browsers */
    opacity: 0.5;
  }
  .PersonTypeOverlayPersonTypeAndPrice a {
    display: inline-block;
