    <div class="twelvecol synopsis hide-for-small last">
        <p style="text-align: left; text-indent: 0px; padding: 0px 0px 0px 0px; margin: 0px 0px 0px 0px;"><span style=" ignore-font-size: 10pt; ignore-font-family: 'Arial', 'Helvetica', sans-serif; font-style: normal; font-weight: bold; ignore-color: #000000; background-color: transparent; text-decoration: none;">CARMEN</span></p>
