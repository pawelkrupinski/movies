  <div data-astro-cid-idhbdnaf>
   <h3 data-astro-cid-idhbdnaf="true"><a class="card-link" data-ga-event="showcard_click" data-ga-show-title="Whispers in the Woods" href="/whats-on/whispers-in-the-woods" data-astro-cid-idhbdnaf>Whispers in the Woods<span data-astro-cid-idhbdnaf> - UK Premiere</span></a></h3>
