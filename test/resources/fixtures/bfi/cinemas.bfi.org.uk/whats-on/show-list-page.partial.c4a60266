  <div data-astro-cid-idhbdnaf>
   <h3 data-astro-cid-idhbdnaf="true"><a class="card-link" data-ga-event="showcard_click" data-ga-show-title="Mona Lisa" href="/whats-on/mona-lisa" data-astro-cid-idhbdnaf>Mona Lisa</a></h3>
