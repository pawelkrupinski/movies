CXZZdlmvx3Loa55SaePd0UECw.jpg","media_type":"movie","original_language":"fr","genre_ids":[99],"popularity":1.2076,"release_date":"1970-02-11","softcore":false,"video":false,"vote_average":9.0,"vote_count":1},{"adult":false,"backdrop_path":null,"id":845467,"title":"Rio Chiquito","original_title":"Rio Chiquito","overview":"Documentary filmed in 1965 by two journalists in the remote town of Rio Chiquito, Colombia, a self-proclaimed communist \"republic.\" The film shows the live of villagers and guerilleros before and after an attack by Colombian government forces.","poster_path":"/zn971ny4yh1LF0kG1wZ5tDmROVc.jpg","media_type":"movie","original_language":"fr","genre_ids":[],"popularity":1.0511,"release_date":"1965-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]},{"adult":false,"gender":2,"id":109476,"known_for_department":"Directing","name":"Jean-Pierre Sinapi","original_name":"Jean-Pierre Sinapi","popularity":0.3914,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":null,"id":39190,"title":"Camping à la ferme","original_title":"Camping à la ferme","overview":"Six jeunes en difficulté de la banlieue parisienne débarquent au fin fond de la campagne française, escortés par leur éducateur. Ils doivent montrer leur bonne volonté en effectuant des travaux d'intérêts généraux décidés par la pétillante juge d'application des peines, qui veut ainsi leur donner une dernière chance. Entre le portable vissé à l'oreille de l'un, le pit-bull de l'autre ou encore les prières musulmanes du troisième, ces adolescents vont bouleverser la vie paisible du petit village.","poster_path":"/rA1MpQuflaX25AJtOV8mrb4qBjG.jpg","media_type":"movie","original_language":"fr","genre_ids":[35],"popularity":3.119,"release_date":"2005-06-29","softcore":false,"video":false,"vote_average":5.689,"vote_count":45},{"adult":false,"backdrop_path":"/gT8iwfb0vty8LPUYDk8vDCgsauK.jpg","id":81852,"title":"Nationale 7","original_title":"Nationale 7","overview":"In a nursing home for disabled near Toulon, René is unanimously hated by all. With fifty years and suffering from myopathy, has an irascible, rebellious character. But not resist provocations candor and uprightness of Julie, a special educator rookie. He confesses he wants to make love to a woman before her degenerative disease definitely catch it. Then Julie goes after one of the prostitutes who work in caravans along the N7.","poster_path":"/y50LVIWmLTvMBAaxSqcKDgRuoKG.jpg","media_type":"movie","original_language":"fr","genre_ids":[35,18],"popularity":0.8455,"release_date":"2000-12-06","softcore":false,"video":false,"vote_average":5.773,"vote_count":11},{"adult":false,"backdrop_path":"/ou8Fu6BxGIyrepiGwRSAJBaCGvf.jpg","id":49824,"title":"Life Kills Me","original_title":"Vivre me tue","overview":"Paul is a smart, university educated Frenchman of North African ancestry. He's a smooth talker, but he can't seem to get a job worthy of his skills. He ends up living in a single room, struggling to get by while going on many fruitless job interviews, during which he tries to impress his potential employers by turning his pizza delivery job into a tall tale about revamping the whole pizza chain. But at some point, they always seem to \"see through him.\" He retreats into the boxing ring.  His secretly gay brother Daniel also has trouble finding his place in the world. He spends all his time bodybuilding and takes dangerous drugs to enhance his physique. He dreams of being the next Schwarzenegger, but is forced to settle for a demeaning job as a \"star\" in a Hamburg sex club.  Based on Jack-Alain Léger's novel","poster_path":"/dt1GinGMVMeTGFGwAXlUwMeVEGv.jpg","media_type":"movie","original_language":"fr","genre_ids":[18],"popularity":1.531,"release_date":"2002-05-26","softcore":false,"video":false,"vote_average":5.3,"vote_count":5}]},{"adult":false,"gender":0,"id":4591057,"known_for_department":"Acting","name":"Jean Pierre","original_name":"Jean Pierre","popularity":0.0,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/m6PIE3VAXm45WO5dTXOEQpYHQon.jpg","id":3917,"name":"Special Rescue Police Winspector","original_name":"特警ウインスペクター","overview":"In 1999, advanced science and technology enriched people's lives, but the damage caused when they were misused for crimes or went out of control and went out of control was also great. The Special Rescue Police Winspector (abbreviated as WSP) was established to deal with such a situation. Their purpose is not only to investigate crimes and arrest suspects but also to save the lives of those involved in crimes and disasters.","poster_path":"/itQUGtMTczHI0zuSksGBEGVWPBk.jpg","media_type":"tv","original_language":"ja","genre_ids":[10759],"popularity":8.3351,"first_air_date":"1990-02-04","softcore":false,"vote_average":8.0,"vote_count":16,"origin_country":["JP"]}]},{"adult":false,"gender":0,"id":1582926,"known_for_department":"Acting","name":"Jean-Pierre Hebrard","original_name":"Jean-Pierre Hebrard","popularity":0.1479,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/wXf4G2Urk0Vq42hD2w5mSmW47N8.jpg","id":73764,"title":"My Nights Are More Beautiful Than Your Days","original_title":"Mes nuits sont plus belles que vos jours","overview":"Lucas has invented a new computer language but at the same time he has been informed about his strange terminal illness during which he has been gradually losing his memory. Shortly after that he meets Blanche who acts as a medium in a bizarre traveling show. Dying Lucas follows her to the sea resort where they spend together several days and nights.","poster_path":"/jrQHMMVBRIlGREEvPzvgC5HkVd4.jpg","media_type":"movie","original_language":"fr","genre_ids":[18,10749],"popularity":1.81,"release_date":"1989-04-19","softcore":false,"video":false,"vote_average":6.059,"vote_count":68},{"adult":false,"backdrop_path":"/piN9DKILTUfGun1S2bAq1Z8ydGx.jpg","id":82162,"title":"Frou-Frou","original_title":"Frou-Frou","overview":"A story of the love of Frou-Frou - an actress and singer in the in the beginning of her career.","poster_path":"/b4GYQ4XGkgrSZyYWR3BPJTXdeh4.jpg","media_type":"movie","original_language":"fr","genre_ids":[10749,35,18],"popularity":0.8425,"release_date":"1955-06-19","softcore":false,"video":false,"vote_average":5.955,"vote_count":11},{"adult":false,"backdrop_path":null,"id":348592,"title":"La Dame aux camélias","original_title":"La Dame aux camélias","overview":"Young and handsome Armand Duval falls in love with Marguerite Gautier, a 'demi-mondaine'. He manages to persuade her to give up her life as a courtesan and they both settle down in the country. Tthe beginning of their idyll is like a dream but a short-lived one as their relationship is considered scandalous by Armand's family. During a secret visit to Marguerite, Armand's father convinces her to leave his son, which she does broken-heartedly but out of love for Armand. Her end will be doubly tragic; not only does she suffer from terminal tuberculosis but she is abandoned by everyone, including by Armand, who believes she has betrayed her. At long last, learning the truth, Armand rushes to her bedside and Marguerite has the joy to breathe her last in his arms.","poster_path":"/b6glO2pRWcVmYaflJTuw0yyVXDe.jpg","media_type":"movie","original_language":"fr","genre_ids":[18],"popularity":0.6512,"release_date":"1953-11-06","softcore":false,"video":false,"vote_average":5.333,"vote_count":3}]},{"adult":false,"gender":0,"id":2077788,"known_for_department":"Acting","name":"Jean Pierre Prats","original_name":"Jean Pierre Prats","popularity":0.3205,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/uzIGtyS6bbnJzGsPL93WCF1FWm8.jpg","id":1865,"title":"Pirates of the Caribbean: On Stranger Tides","original_title":"Pirates of the Caribbean: On Stranger Tides","overview":"When Jack crosses paths with a woman from his past, he's not sure if it's love...or if she's a ruthless con artist using him to find the fabled Fountain of Youth.","poster_path":"/keGfSvCmYj7CvdRx36OdVrAEibE.jpg","media_type":"movie","original_language":"en","genre_ids":[12,28,14],"popularity":20.8748,"release_date":"2011-05-15","softcore":false,"video":false,"vote_average":6.573,"vote_count":15109},{"adult":false,"backdrop_path":"/kdyYOwpKvvD2fSbwfnMM2YPAzfq.jpg","id":187017,"title":"22 Jump Street","original_title":"22 Jump Street","overview":"After making their way through high school (twice), big changes are in store for officers Schmidt and Jenko when they go deep undercover at a local college. But when Jenko meets a kindred spirit on the football team, and Schmidt infiltrates the bohemian art major scene, they begin to question their partnership. Now they don't have to just crack the case - they have to figure out if they can have a mature relationship. If these two overgrown adolescents can grow from freshmen into real men, college might be the best thing that ever happened to them.","poster_path":"/850chzYHYbT3IISl6Q7dbBuFP2B.jpg","media_type":"movie","original_language":"en","genre_ids":[80,35,28],"popularity":11.0058,"release_date":"2014-06-05","softcore":false,"video":false,"vote_average":6.827,"vote_count":8625},{"adult":false,"backdrop_path":"/ifBIpsuutQlul3Mexjw2QdkFXG4.jpg","id":641790,"title":"Trauma Center","original_title":"Trauma Center","overview":"Lt. Wakes is a vengeful police detective determined to solve the murders of his partner and an informant, and joins forces with a witness injured during the shootings. After the killers pursue the witness across the abandoned floor of a hospital, she confirms Wakes's worst fears.","poster_path":"/8K73wvCTBA3XKgZTtOZWgENUnis.jpg","media_type":"movie","original_language":"en","genre_ids":[28,53],"popularity":2.953,"release_date":"2019-12-06","softcore":false,"video":false,"vote_average":5.428,"vote_count":408}]},{"adult":false,"gender":0,"id":1935710,"known_for_department":"Acting","name":"Jean-Pierre Bourguignon","original_name":"Jean-Pierre Bourguignon","popularity":0.2082,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":null,"id":241196,"title":"Comment j'ai détesté les maths","original_title":"Comment j'ai détesté les maths","overview":"What is striking when you talk with mathematicians is that sparkle in their eyes, and their sudden joyful voice trying to share with you a concept, a theory. They continuously use words such as invention, beauty, freedom. You then ask yourself : how such a rich language, this quasi-philosophical proposition about the world becomes rejected by a majority, 'the only discipline where one prides itself to be bad at it'!","poster_path":"/iExxYjFXJjZrtuoX2TuJcsKLkK0.jpg","media_type":"movie","original_language":"fr","genre_ids":[99,9648],"popularity":0.558,"release_date":"2013-11-27","softcore":false,"video":false,"vote_average":5.7,"vote_count":28},{"adult":false,"backdrop_path":"/qU6gXoGEK65ztcBJ9oqB4j6fAje.jpg","id":1657275,"title":"Solving the Bonnet Problem","original_title":"Solving the Bonnet Problem","overview":"The documentary \"Solving the Bonnet Problem\" follows the work of three mathematicians as they collaborate to solve a long-standing geometrical problem proposed by Pierre Ossian-Bonnet. Alongside their work, the film explores the lives and contributions of Bonnet and his contemporary Gaston Darboux, as well as the history of French mathematics in the 19th century. Captivating computer graphics help unravel intricate concepts and make them accessible to all.","poster_path":"/aM4iC8ol5ht6PphoNuAlqNPj2iE.jpg","media_type":"movie","original_language":"en","genre_ids":[99],"popularity":1.5323,"release_date":"2023-09-24","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]},{"adult":false,"gender":2,"id":1156936,"known_for_department":"Acting","name":"Pierre Jean","original_name":"Pierre Jean","popularity":0.3804,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/An4QeEvTDmWBnDmorMo0H8xxn6w.jpg","id":166,"title":"The Party","original_title":"La Boum","overview":"A thirteen-year-old French girl deals with moving to a new city and school in Paris, while at the same time her parents are getting a divorce.","poster_path":"/usGV1Q7KWR0Uq4dOIppGZ0ba8kz.jpg","media_type":"movie","original_language":"fr","genre_ids":[18,10749,35],"popularity":4.0359,"release_date":"1980-12-17","softcore":false,"video":false,"vote_average":6.597,"vote_count":1222},{"adult":false,"backdrop_path":"/7pb1NIgmf7odcpnwkZU0Qx4wZqi.jpg","id":173999,"title":"The Husbands, the Wives, the Lovers","original_title":"Les Maris, les Femmes, les Amants","overview":"In the summer holidays, a group of women stay behind in Paris whilst their husbands and children take a vacation on the sunny Island of Ré. The women – wives, frustrated spinsters and adolescents – profit from their new-found freedom to sort out their love lives and the men indulge their earthy passions with no less enthusiasm. Only the children seems capable of rising above this infantile summer madness...","poster_path":"/eVMqtah7eqq9aZxAc4ZWXEtDhQY.jpg","media_type":"movie","original_language":"fr","genre_ids":[18,35],"popularity":1.0482,"release_date":"1989-01-04","softcore":false,"video":false,"vote_average":5.115,"vote_count":13},{"adult":false,"backdrop_path":null,"id":565880,"title":"La frisée aux lardons","original_title":"La frisée aux lardons","overview":"It’s summer in a small port town in Brittany. Isabelle (Pascale Rocard), who has just graduated from high school, comes to join her mother Micheline (Bernadette Lafont). Micheline is being courted by a beach boy, Maurice—whom everyone calls Doudoune (Bernard Menez). Isabelle soon begins a sweet romance with one of his friends, Pascal (Pascal Meynier). Meanwhile, her father (Michel Aumont) has stayed behind in Soissons, where he runs a medical laboratory, and is bored to death. Every weekend, he comes to spend 48 hours with Micheline and sometimes splurges a little extra in Paris, hitting on girls in nightclubs. Efforts that are not crowned with success. On the contrary, in Brittany, that ladies’ man Doudoune gets what he wants... But when the family man comes to join his loved ones, the blunders and misunderstandings multiply...","poster_path":"/rLTo13MLaqYguBivb74GB35qAOT.jpg","media_type":"movie","original_language":"fr","genre_ids":[35],"popularity":1.2922,"release_date":"1979-01-17","softcore":false,"video":false,"vote_average":4.0,"vote_count":2}]},{"adult":false,"gender":0,"id":1662900,"known_for_department":"Acting","name":"Jean-Pierre Gaillet","original_name":"Jean-Pierre Gaillet","popularity":0.0639,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/dGrGD7oWQ62dUAXouSnFjMN6BcF.jpg","id":65849,"title":"Normal People Are Nothing Exceptional","original_title":"Les gens normaux n'ont rien d'exceptionnel","overview":"Martine is 25. Since breaking up with François, she has the feeling that the world is caving in on her. Between small jobs and one-night stands, she can't seem to get a fix on herself. In desperation, after a last quarrel with François, she unintentionally causes an accident that leads her to the emergency ward of a psychiatric hospital. During her brief stay, she unexpectedly sparks into life. She takes an interest in two young patients, Pierre and Anne, convinced that she is doing the right thing in supervising their love life...","poster_path":"/fXnhW8Kk6bCAsPV9jBl6pPTs4X8.jpg","media_type":"movie","original_language":"fr","genre_ids":[18,35],"popularity":0.6627,"release_date":"1993-11-23","softcore":false,"video":false,"vote_average":6.727,"vote_count":11},{"adult":false,"backdrop_path":null,"id":410375,"title":"Too Close to the Gods","original_title":"Trop près des dieux","overview":"Ramses is a \"life organs\" smugler and a millionaire. He wishes to have the tower of Babel rebuilt and hires a detective to find the architect who disappeared with the original plans.","poster_path":"/1QEHjwRsLVfhyosJ2boO9yLfdr1.jpg","media_type":"movie","original_language":"fr