nder":0,"id":92785,"known_for_department":"Acting","name":"Barry Jenkins","original_name":"Barry Jenkins","popularity":0.1782,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":null,"id":224751,"title":"Somewhere in the Darkness","original_title":"Somewhere in the Darkness","overview":"In this Australian drama, a department store collapses, trapping an old man (Barry Jenkins) and a young boy (Rowan Whitt) underneath. In hopes of keeping the child calm, the man tells him a series of folk tales which teach a moral lesson while they entertain. Somewhere In The Darkness received its world premier at the 1999 Slamdance Film Festival in the United States; it was later screened at Australia's Sydney Film Festival the same year. ~ Mark Deming, Rovi","poster_path":"/i8kphmIMFQchODZoDrbqnibhqfp.jpg","media_type":"movie","original_language":"en","genre_ids":[14],"popularity":0.6748,"release_date":"1999-01-25","softcore":false,"video":false,"vote_average":9.333,"vote_count":3},{"adult":false,"backdrop_path":"/2lbtJSCMvSODtLE45DsztJ2pCnW.jpg","id":225439,"title":"Wendy Cracked a Walnut","original_title":"Wendy Cracked a Walnut","overview":"An Australian salesman's bored wife escapes in a fantasy world with her dream lover.","poster_path":"/s9cCDuNPFXoMsc1YodXAX55ZXdD.jpg","media_type":"movie","original_language":"en","genre_ids":[18,14,10749],"popularity":0.821,"release_date":"1990-08-02","softcore":false,"video":false,"vote_average":4.6,"vote_count":10}]},{"adult":false,"gender":2,"id":1120061,"known_for_department":"Acting","name":"Barry Jenkins","original_name":"Barry Jenkins","popularity":0.0639,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/qSiVTAtDU0kJd8KjHHpMfGusIMt.jpg","id":42632,"title":"Monterey Pop","original_title":"Monterey Pop","overview":"Featuring performances by popular artists of the 1960s, this concert film highlights the music of the 1967 California festival. Although not all musicians who performed at the Monterey Pop Festival are on film, some of the notable acts include the Mamas and the Papas, Simon & Garfunkel, Jefferson Airplane, the Who, Otis Redding, and the Jimi Hendrix Experience. Hendrix's post-performance antics -- lighting a guitar on fire, breaking it and tossing a part into the audience -- are captured.","poster_path":"/wEB3c5Y5spAHOQaFWcsfFky3SWb.jpg","media_type":"movie","original_language":"en","genre_ids":[10402,99],"popularity":1.0606,"release_date":"1968-12-26","softcore":false,"video":false,"vote_average":7.3,"vote_count":96},{"adult":false,"backdrop_path":"/sWCwGKHbrYWntWKBY0hjmgKENMy.jpg","id":211747,"title":"Pop Gear","original_title":"Pop Gear","overview":"A compilation of proto-music videos featuring leading British rock bands of the 60s, including The Animals, The Spencer Davis Group, and Herman's Hermits.","poster_path":"/aKL2Wfv8aqFmkfAYegRxeUzBkDw.jpg","media_type":"movie","original_language":"en","genre_ids":[10402],"popularity":1.6233,"release_date":"1965-05-19","softcore":false,"video":false,"vote_average":7.8,"vote_count":5}]},{"adult":false,"gender":0,"id":2523579,"known_for_department":"Production","name":"Barry M. Jenkins","original_name":"Barry M. Jenkins","popularity":0.0996,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/kEY6RjklHdwJfg5Wxnu20aAc618.jpg","id":302349,"title":"Iron Sky: The Coming Race","original_title":"Iron Sky: The Coming Race","overview":"29 years after the events of Iron Sky, the former Nazi Moonbase has become the last refuge of mankind. Earth was devastated by a nuclear war, but buried deep under the wasteland lies a power that could save the last of humanity - or destroy it once and for all. An old enemy leads our heroes on an adventure into the Hollow Earth. To save humanity, they must battle the Vril, an ancient shapeshifting reptilian race, and their army of dinosaurs.","poster_path":"/l5t2Nf1F7iQUKTrODg93xmQzZLj.jpg","media_type":"movie","original_language":"en","genre_ids":[28,35,14,878],"popularity":4.