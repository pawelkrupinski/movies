{"page":1,"results":[{"adult":false,"gender":0,"id":4870243,"known_for_department":"Directing","name":"Filip Pawlak","original_name":"Filip Pawlak","popularity":0.0214,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/gXmeYiZjJqCrd0m0EtAo9MaubNQ.jpg","id":1451034,"title":"Freak Show","original_title":"Freak Show","overview":"A documentary that follows a group of young performers with disabilities invited by the Museum of Modern Art in Warsaw (MSN). As the grand opening of the museum's new building approaches, the group prepares a provocative performance scheduled for Halloween night. The film captures the intense rehearsals led by artists Nadia Markiewicz, Agata Wąsik, Daniel Kotowski, and \"Babcia.\" Together, they reclaim the dark history of 19th-century \"freak shows\" to turn it into a tool for subversion. Through drag, opera, and monologues, each performer stages their own body and personal experiences on camera. The narrative culminates in the official premiere at the museum. This performative climax transforms their vulnerability into a radical manifesto, shocking the audience, breaking taboos surrounding marginalized bodies, and redefining contemporary standards of beauty.","poster_path":"/66t1qAb0084rjL5pIXfeBpUUyep.jpg","media_type":"movie","original_language":"pl","genre_ids":[99],"popularity":1.1389,"release_date":"2026-05-09","softcore":false,"video":false,"vote_average":4.0,"vote_count":1}]}],"total_pages":1,"total_results":1}