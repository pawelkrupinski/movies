{"page":1,"results":[{"adult":false,"gender":2,"id":1387582,"known_for_department":"Directing","name":"David Borenstein","original_name":"David Borenstein","popularity":0.4773,"profile_path":"/hnZXlNc9eNmOkpU5iU6pMAa75iW.jpg","known_for":[{"adult":false,"backdrop_path":"/euEHCRdfV1ZTDgfhZm1XKHVkZ2K.jpg","id":3562,"name":"NOVA","original_name":"NOVA","overview":"PBS' premier science series helps viewers of all ages explore the science behind the headlines. Along the way, NOVA demystifies science and technology, and highlights the people involved in scientific pursuits.","poster_path":"/giUBXYnDAaJgNqA6iE3BMVE2EHp.jpg","media_type":"tv","original_language":"en","genre_ids":[99],"popularity":53.57,"first_air_date":"1974-03-03","softcore":false,"vote_average":7.0,"vote_count":140,"origin_country":["US"]},{"adult":false,"backdrop_path":"/3A0dDfZq5WxdDGt8qzmhFXqVZxJ.jpg","id":1393151,"title":"Mr. Nobody Against Putin","original_title":"Mr. Nobody mod Putin","overview":"As Russia launches its full-scale invasion of Ukraine, primary schools across Russia’s hinterlands are transformed into recruitment stages for the war. Facing the ethical dilemma of working in a system defined by propaganda and violence, a brave teacher goes undercover to film what’s really happening in his own school.","poster_path":"/ss4NEGmPxgm4D73iMFeyjbE1m9b.jpg","media_type":"movie","original_language":"da","genre_ids":[99],"popularity":3.253,"release_date":"2025-06-06","softcore":false,"video":false,"vote_average":7.401,"vote_count":121},{"adult":false,"backdrop_path":"/apBEQ0shKkZ1jYdk7Gd2si3duvd.jpg","id":1220044,"title":"Can't Feel Nothing","original_title":"Grosse fatigue sur le Net","overview":"A man lies in bed illuminated by the blue-white light of his mobile phone. He doom scrolls past cute pets, outraged opinion pieces and haunting images from the world's hotspots – and he feels absolutely nothing. With curiousity and humour, director David Borenstein travels the world to investigate how bad things really are. Who is pulling the strings when the internet makes us angry, sad, horny or just plain indifferent? And is there any way back? From the American internet troll, a burnt-out superstar in the Asian influencer industry, a cynical fake-news factory in Eastern Europe, Russian state propagandists and an online dominatrix, this is an alarming contemporary diagnosis, with a bold attempt to also look at solutions.","poster_path":"/9sAs1DSymyqRmcbqSW4TuX1y5Zu.jpg","media_type":"movie","original_language":"en","genre_ids":[99],"popularity":0.675,"release_date":"2024-03-13","softcore":false,"video":false,"vote_average":8.0,"vote_count":3}]}],"total_pages":1,"total_results":1}