{"page":1,"results":[{"adult":false,"gender":0,"id":4400284,"known_for_department":"Directing","name":"Jan Sobierajski","original_name":"Jan Sobierajski","popularity":0.1364,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":null,"id":995352,"title":"Powolany","original_title":"Powołany","overview":"","poster_path":null,"media_type":"movie","original_language":"pl","genre_ids":[99,18],"popularity":0.9052,"release_date":"2022-04-14","softcore":false,"video":false,"vote_average":10.0,"vote_count":1},{"adult":false,"backdrop_path":null,"id":1221456,"title":"Powolany 2","original_title":"Powołany 2","overview":"","poster_path":"/81Orm4YdoXvL9DnQyLxUT5krwty.jpg","media_type":"movie","original_language":"pl","genre_ids":[99,18],"popularity":1.9913,"release_date":"2024-03-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0},{"adult":false,"backdrop_path":null,"id":1370644,"title":"Tętno","original_title":"Tętno","overview":"A documentary about life and the struggle for its existence. In it, the authors lean over the arguments of abortion supporters, trying to find answers to them in the world of science. Each argument is dissected and thoroughly analyzed. The film features numerous authorities: whether from the field of genetics itself, gynecology or obstetrics. But also parents. People who were personally affected by the problems raised in the documentary. \"Pulse\" is not just a film about abortion. It's not just a documentary trying to show it in the light of scientific research. It is not only a production showing abortion through the eyes of people who usually prefer not to speak about abortion. But above all, it is a film showing an alternative. An alternative, that is, a whole range of solutions and options to help women facing the possibility of aborting their own child make a different decision. A decision about life.","poster_path":null,"media_type":"movie","original_language":"pl","genre_ids":[99],"popularity":0.2665,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]}],"total_pages":1,"total_results":1}