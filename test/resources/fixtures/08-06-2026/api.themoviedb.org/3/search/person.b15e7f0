{"page":1,"results":[{"adult":false,"gender":0,"id":3383604,"known_for_department":"Directing","name":"Urszula Morga","original_name":"Urszula Morga","popularity":0.3032,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":"/mWgbYGP6PGsx2JC70Mem59OPDWR.jpg","id":912781,"title":"Milk","original_title":"Mleko","overview":"Ewa takes her daughter to their lake house to prepare for her 18th birthday party. Unbeknownst to her mother, Julka brings along her boyfriend. The mother openly disapproves his presence and wants to get rid of him. However, the more she tries, the more obvious it becomes that the hardest battle she will have to fight is the battle with herself.","poster_path":"/kPkpe9kM41SMFilASFY7XvLB2Dv.jpg","media_type":"movie","original_language":"pl","genre_ids":[18],"popularity":2.3054,"release_date":"2017-12-13","softcore":false,"video":false,"vote_average":6.0,"vote_count":2},{"adult":false,"backdrop_path":null,"id":1556638,"title":"Signs of Mr. Plum","original_title":"Znaki Pana Śliwki","overview":"Contrary to his family’s expectations and despite having lost one eye, Karol Śliwka leaves his rural home to study art in Warsaw. He decides to be a designer of graphic signs. He fills communist Poland with his works and defines the country’s visual landscape. His signs do not hang in galleries, but are present in Polish homes, in Polish streets, at institutions and workplaces. At the same time, he leads an ordinary family life, which he documents passionately over the years. This extremely gifted artist is still considered one of the greatest sign designers in the world.","poster_path":"/itOZvCQjANQno1G0aoT9RisF3Et.jpg","media_type":"movie","original_language":"pl","genre_ids":[99],"popularity":0.8399,"release_date":"2026-05-16","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]}],"total_pages":1,"total_results":1}