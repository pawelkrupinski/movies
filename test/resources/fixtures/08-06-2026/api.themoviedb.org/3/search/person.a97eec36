{"page":1,"results":[{"adult":false,"gender":2,"id":591296,"known_for_department":"Directing","name":"Witold Leszczyński","original_name":"Witold Leszczyński","popularity":0.3357,"profile_path":"/h20YDR4W5mByLEDVoFBTAI9FmiU.jpg","known_for":[{"adult":false,"backdrop_path":"/1KPjTsAREBwmCXDbq2PdH8n5vjS.jpg","id":81231,"title":"The Linnet","original_title":"Konopielka","overview":"Kaziuk, a stubborn peasant and his pregnant wife live in a backwood village, unaffected by the civilization. The village is once visited by a couple of wanderers, and strange things start to happen afterward. A new schoolteacher is sent to the area. She stirs erotic fantasies in Kaziuk. In a stir of frustration Kaziuk cuts down a family tree - a sacrilegious act in the eyes of his family. Going a step further and using a scythe for cutting the rye instead of a sickle brings the whole village against him.","poster_path":"/cOzGlHBlvmEfCbDWdyjNmlP6E9Q.jpg","media_type":"movie","original_language":"pl","genre_ids":[35,18],"popularity":0.6903,"release_date":"1982-09-13","softcore":false,"video":false,"vote_average":6.714,"vote_count":35},{"adult":false,"backdrop_path":"/ofplZMrZNnG8st00OK6HK94tzX1.jpg","id":270382,"title":"Axiliad","original_title":"Siekierezada","overview":"A young, idealistic poet, turns his back on civilization and goes to small, backwood village, rents a bed in the house of an old woman, and decides to make his living as a lumberjack. Soon he realizes that the world around him is far from perfect.","poster_path":"/QPM2BvyZOleI9yqi1ETwrQFd7O.jpg","media_type":"movie","original_language":"pl","genre_ids":[18],"popularity":1.1052,"release_date":"1986-10-13","softcore":false,"video":false,"vote_average":6.75,"vote_count":16},{"adult":false,"backdrop_path":"/lILGmH0HWOXziENZIFcOdZTJIuh.jpg","id":198782,"title":"Matthew's Days","original_title":"Żywot Mateusza","overview":"A man who is socially inept and out of touch with the world lives with his sister in a small farmhouse. The overly sensitive man lives off his hard-working sibling, taking odd jobs as he gets them to secure his meager earnings. When he brings home a woodcutter from the forest, the sister and the newcomer fall in love. Terrified over a life without his sister, the man can't cope.","poster_path":"/bLCcu3AfD7BZdHZKFeU4dg1LDGV.jpg","media_type":"movie","original_language":"pl","genre_ids":[18],"popularity":0.7215,"release_date":"1968-02-16","softcore":false,"video":false,"vote_average":6.125,"vote_count":11}]}],"total_pages":1,"total_results":1}