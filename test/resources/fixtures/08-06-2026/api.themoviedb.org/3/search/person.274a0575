{"page":1,"results":[{"adult":false,"gender":0,"id":4466378,"known_for_department":"Editing","name":"Mateusz Kmieć","original_name":"Mateusz Kmieć","popularity":0.1933,"profile_path":null,"known_for":[{"adult":false,"backdrop_path":null,"id":1447108,"title":"Niesamowite przygody skarpetek","original_title":"Niesamowite przygody skarpetek","overview":"Have you ever wondered what happens to all those missing socks? We've all had that experience - we throw a pair of socks into a drawer, closet or laundry basket and then take them out... just one sock! Where do they disappear to? Perhaps they secretly dream of a more fascinating life than serving our feet? Perhaps they would like to become movie stars or politicians? Or maybe, dropping into a corner of our room, they travel back in time to prehistory? Wherever they end up, their adventures are sure to be filled with fun!","poster_path":"/7fAe9ZgTQeMdEqMJlHu0RSgLF4v.jpg","media_type":"movie","original_language":"pl","genre_ids":[16,14,10751,12],"popularity":0.9679,"release_date":"2025-04-25","softcore":false,"video":false,"vote_average":0.0,"vote_count":0},{"adult":false,"backdrop_path":"/1FEL6K0GKE39M7xwAXAuhIIK8Xp.jpg","id":1514217,"title":"Niesamowite przygody skarpetek 2. Skarpetki górą!","original_title":"Niesamowite przygody skarpetek 2. Skarpetki górą!","overview":"","poster_path":"/hUxSNPM3biIBDnmnxJEEgChEHaa.jpg","media_type":"movie","original_language":"pl","genre_ids":[16,12,10751],"popularity":0.9682,"release_date":"2025-09-12","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]}],"total_pages":1,"total_results":1}