{"page":1,"results":[{"adult":false,"gender":1,"id":2363766,"known_for_department":"Directing","name":"Maura Delpero","original_name":"Maura Delpero","popularity":0.6306,"profile_path":"/7aE4NFTGTe8Yb9dCmSHT1zGM9YB.jpg","known_for":[{"adult":false,"backdrop_path":"/fYepNPcgAYHQRMNZW95oOykLRgQ.jpg","id":1151244,"title":"Vermiglio","original_title":"Vermiglio","overview":"In the last days of the Second World War, a deserting soldier disrupts a tranquil and isolated mountain community. For one family, his arrival brings excitement and romance, but tragedy lies in wait.","poster_path":"/aeCwM7c1Y1IAu3Oqqj5A2tSziWR.jpg","media_type":"movie","original_language":"it","genre_ids":[18],"popularity":2.3084,"release_date":"2024-09-19","softcore":false,"video":false,"vote_average":7.038,"vote_count":320},{"adult":false,"backdrop_path":"/kOFHspLRtZepdEWck3QJjwJBDwb.jpg","id":616221,"title":"Maternal","original_title":"Hogar","overview":"Lu and Fati are teen mums living in a religious shelter in Buenos Aires. Sister Paola arrives there to take her final vows. But the girls’ impending motherhood faces her with a challenging situation.","poster_path":"/4go0AbNNOAcBhbdekhPyeWNe9ys.jpg","media_type":"movie","original_language":"es","genre_ids":[18],"popularity":2.0257,"release_date":"2019-12-12","softcore":false,"video":false,"vote_average":6.768,"vote_count":28},{"adult":false,"backdrop_path":"/vIwSDMytjZASeP8QFy14lKf5OY8.jpg","id":651591,"title":"Nadea e Sveta","original_title":"Nadea e Sveta","overview":"Nadea and Sveta is a film about friendship and complicity between migrant women. It tells a story about motherhood, love, escape from loneliness and search for home. A film between Eastern and Western Europe. Like many other Moldovan women, Nadea and Sveta moved to Italy for economic reasons. They had to leave their families back home in Moldova. Nadea's sons are grown up, whereas Sveta has left her 3-year old daughter with her grandmother. In 2010, after more than two years, Sveta can finally go back home to meet her daughter again. With her friend leaving Italy, Nadea reacts to loneliness and begins to go out in order to meet new people. The stories of the two friends will cross and their destiny will be reversed.","poster_path":"/kB7RjDJASUMmUIfXTNi7HxkpGop.jpg","media_type":"movie","original_language":"en","genre_ids":[99,18],"popularity":0.9337,"release_date":"2012-11-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0}]}],"total_pages":1,"total_results":1}