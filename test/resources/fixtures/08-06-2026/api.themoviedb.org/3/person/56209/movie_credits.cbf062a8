5.736,"vote_count":36,"credit_id":"625c114c9661fc00a5392528","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/orvA4fru7azuBkPDcxpNtk4MSWi.jpg","genre_ids":[18,53],"id":467679,"title":"Carnivores","original_language":"fr","original_title":"Carnivores","overview":"","popularity":1.4012,"poster_path":"/mTJ3EeRMGvSP0T3cCBtxLChLQeA.jpg","release_date":"2018-03-28","softcore":false,"video":false,"vote_average":5.5,"vote_count":88,"credit_id":"625c1fd7ae366800663d7161","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/gpspruXYu8zZu822wF63KEj0KBq.jpg","genre_ids":[18],"id":320003,"title":"Dziennik Panny Służącej","original_language":"fr","original_title":"Journal d'une femme de chambre","overview":"Początek XX wieku. Célestine, śliczna młoda służąca oczekuje od życia więcej, niż los może jej zaoferować. Świadoma swojej seksualności dziewczyna zauważa, że jest obiektem fascynacji kolejnych panów domu. Odruchowo broni się przed tym, ale szybko uczy się czerpać przyjemność z coraz bardziej odważnych erotycznych przygód.","popularity":2.3351,"poster_path":"/2Odfq5Li6TxPpK5Brm2GvldckLa.jpg","release_date":"2015-04-01","softcore":false,"video":false,"vote_average":5.2,"vote_count":171,"credit_id":"625c2262a284eb009be67dfe","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":963907,"title":"Why We Can't See Each Other Outside When the Sun is Shining","original_language":"fr","original_title":"Why We Can't See Each Other Outside When the Sun is Shining","overview":"","popularity":0.238,"poster_path":null,"release_date":"2007-04-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"625c17ada284eb005130c856","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":394064,"title":"Ion","original_language":"fr","original_title":"Ion","overview":"","popularity":1.1718,"poster_path":"/mUL46OWA3dd17X3nbvSQRQymg91.jpg","release_date":"2013-07-08","softcore":false,"video":false,"vote_average":1.0,"vote_count":1,"credit_id":"625c2485df86a8005120ec51","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/qpytCm6780mNs3z7ps9twm9oJAo.jpg","genre_ids":[18],"id":926332,"title":"Niebieska Linia","original_language":"fr","original_title":"La ligne","overview":"Margaret podczas kłótni uderza swoją matkę. Rezultat: zakaz zbliżania się na sto metrów do domu rodzinnego. Bezpieczną strefę wyznacza namalowana na ziemi niebieska linia. Margaret, spragniona kontaktu, codziennie podchodzi pod tą symboliczną granicę. Ursula Meier, laureatka Srebrnego Niedźwiedzia za „Twoją siostrę”, przedstawia opowieść o skomplikowanych relacjach rodzinnych.","popularity":1.1552,"poster_path":"/vjKCbz0z2aDipc1PsLjpyo9HL8I.jpg","release_date":"2023-01-11","softcore":false,"video":false,"vote_average":5.655,"vote_count":29,"credit_id":"625c21d79661fc00506762ac","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/r1O9DyxqNzMJqzIkQjvkzD4lxMK.jpg","genre_ids":[18,10749],"id":854363,"title":"Ma nuit","original_language":"fr","original_title":"Ma nuit","overview":"","popularity":2.6656,"poster_path":"/rm12Gi7epSX6upo0miWQeCd5E8z.jpg","release_date":"2022-03-09","softcore":false,"video":false,"vote_average":5.8,"vote_count":16,"credit_id":"625c218ed266a20067b313cd","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":553577,"title":"فتوى","original_language":"ar","original_title":"فتوى","overview":"","popularity":0.8877,"poster_path":"/kF2Nk4SLgcPDahfhvPGtUaUfi7I.jpg","release_date":"2018-10-12","softcore":false,"video":false,"vote_average":6.2,"vote_count":3,"credit_id":"625c206dbb26021184ee9f1c","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/dmj6rictIMGfDbTv6pxeifyqs3I.jpg","genre_ids":[18,10749],"id":97365,"title":"Z krwi i kości","original_language":"fr","original_title":"De rouille et d'os","overview":"Ali musi zająć się swoim pięcioletnim synem, Samem, który do tej pory wychowywał się bez ojca. Nie posiadając pieniędzy ani przyjaciół wyjeżdża do Antibes do siostry. Znajduje tam pracę jako ochroniarz w lokalnym klubie nocnym. Pewnego wieczoru, poznaje Stephanie, która zajmuje się tresurą orek w lokalnym oceanarium.","popularity":2.7481,"poster_path":"/oLNJXJiuowxQ8C2TzbTB5bWXz0d.jpg","release_date":"2012-05-17","softcore":false,"video":false,"vote_average":7.161,"vote_count":1470,"credit_id":"625c241313af5f158f68ccda","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/1slp0YjWUZKP9YznTZhvqwX0KJ2.jpg","genre_ids":[35],"id":380830,"title":"Good Luck Algeria","original_language":"fr","original_title":"Good Luck Algeria","overview":"","popularity":0.8427,"poster_path":"/ttsEDwS5xIH40XTlCKtvyDOJZ1c.jpg","release_date":"2016-03-30","softcore":false,"video":false,"vote_average":5.49,"vote_count":52,"credit_id":"625c2309a284eb009be6804e","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":224918,"title":"À ciel ouvert","original_language":"fr","original_title":"À ciel ouvert","overview":"","popularity":1.8306,"poster_path":"/uODPCwOoh9S9D7kYhQe9IzyslIp.jpg","release_date":"2014-01-08","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"625c24f4bf09d10066bc4b3c","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/6S8PK2JrPkWRtJ5O5f2XIOSadla.jpg","genre_ids":[10749,18,10402],"id":229582,"title":"Marina","original_language":"nl","original_title":"Marina","overview":"","popularity":1.1529,"poster_path":"/ccD3qO0TC3fQwtMXHsrp1j03qwb.jpg","release_date":"2013-11-06","softcore":false,"video":false,"vote_average":6.842,"vote_count":98,"credit_id":"625c25a013af5f158f68d3a6","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/7O4RcjTNHLFuogbjbF7sWPIxIXX.jpg","genre_ids":[18,53,37],"id":336811,"title":"Szukając Kelly","original_language":"fr","original_title":"Les Cowboys","overview":"Nastoletnia Kelly opuszcza swoją rodzinę i ucieka z muzułmaninem Ahmedem, aby żyć w zgodzie z Koranem. Jej ojciec Alain nie jest w stanie się z tym pogodzić. Obsesyjnie szuka córki przez 10 lat, zostawiając wszystko, co do tej pory kochał. Jedynym sojusznikiem w tych wieloletnich poszukiwaniach jest jego syn Kid, który poświęca młodość na znalezienie siostry.","popularity":1.4571,"poster_path":"/wwp69bv15I11m0LbHANRS2Paag4.jpg","release_date":"2015-11-25","softcore":false,"video":false,"vote_average":6.4,"vote_count":136,"credit_id":"625c22bef10a1a15ea539d11","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/uePmJAkRrM1fteB7deiXG7T0jpz.jpg","genre_ids":[18],"id":958173,"title":"Black Box: Wem kannst du vertrauen?","original_language":"de","original_title":"Black Box: Wem kannst du vertrauen?","overview":"","popularity":0.8134,"poster_path":"/Mwu5mdHJ5AqHhbthwXYpOrYIqH.jpg","release_date":"2023-08-10","softcore":false,"video":false,"vote_average":4.971,"vote_count":17,"credit_id":"625c26ed9661fc00a5397ed7","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/gHV04QBbbDfYVPJsblApLXAfBYJ.jpg","genre_ids":[18],"id":712120,"title":"Czerwona Ziemia","original_language":"fr","original_title":"Rouge","overview":"Świeżo zatrudniona jako pielęgniarka porodowa w fabryce chemicznej, Nour odkrywa, że ​​między kierownictwem a jej ojcem, Slimane'em, przedstawicielem personelu i osią firmy, istnieją drobne porozumienia. Kłamie o zanieczyszczających zrzutach, ukrytych chorobach pracowników, ukrytych wypadkach… Nour, krok po kroku, nie akceptuje już kompromisów swojego ojca, aby zachować wizerunek firmy. Postanawia uruchomić alarm.","popularity":1.5259,"poster_path":"/iyi1TmBTLjAZRe1h47dyP3ZfDnh.jpg","release_date":"2021-08-11","softcore":false,"video":false,"vote_average":6.52,"vote_count":74,"credit_id":"625c20ca85702e0066d41c70","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/6WVFYe3khJwstiNgCnJceLcNXxR.jpg","genre_ids":[18],"id":377475,"title":"Achter de wolken","original_language":"nl","original_title":"Achter de wolken","overview":"","popularity":0.828,"poster_path":"/Vhj0VveImEh41uO1S1Gxzc3nGc.jpg","release_date":"2016-02-10","softcore":false,"video":false,"vote_average":5.321,"vote_count":14,"credit_id":"625c237b85702e0051e9fc49","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/9rt3zcWgSWp4s7wKzXYcQlJleJp.jpg","genre_ids":[18],"id":378697,"title":"Hedi","original_language":"ar","original_title":"نحبك هادي","overview":"Hedi to młody człowiek zmagający się z problemami życia codziennego oraz konwencjami społecznymi w Tunezji. Hediemu niewiele rzeczy się udaje. Wykonuje pracę, która nie daje mu satysfakcji i w której się nie sprawdza. Nie posiada przyjaciół. Nie ma ambicji. Ma za to opiekuńczą matkę, która próbuje decydować za niego. Aranżowanie życia młodszego syna rozpoczyna od znalezienia idealnej synowej z właściwego domu. Przygotowania do ślubu trwają. W międzyczasie Hedi okrywa swoją drogę do szczęścia, ale u boku innej kobiety. Zakochuje się w bezpretensjonalnej Rym i postanawia wykroczyć poza konwencje.","popularity":3.0917,"poster_path":"/g1iA1dZEMAYIsFIauYxOHuaLb39.jpg","release_date":"2016-03-14","softcore":false,"video":false,"vote_average":6.759,"vote_count":27,"credit_id":"625c23caae366800663d83c9","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/veUROBYQZSWrhW61y5GTbi0Klao.jpg","genre_ids":[18],"id":421452,"title":"W kręgu przemocy","original_language":"fr","original_title":"Espèces menacées","overview":"Trzy przeplatające się i naszpikowane emocjami historie, zorientowane na przedstawienie relacji między dorosłym już dzieckiem i rodzicem. Bohaterowie pierwszej z nich, Joséphine i Tomasz, to młode małżeństwo, sprawiające pozory szczęśliwej pary. Rodzice kobiety mają jednak wkrótce przekonać się, że prawda jest zgoła inna - ich interwencja jednak nie przyniesie żadnego skutku. W drugiej opowieści poznamy Mélanie, która spodziewa się dziecka, oraz jej matkę Marie i ojca Vincenta. Żadne z nich nie akceptuje partnera córki. W trzeciej historii mamy do czynienia z Anthonym. W życiu tego młodego mężczyzny niewiele się dzieje do momentu, kiedy spada na niego obowiązek opieki nad matką.","popularity":1.2315,"poster_path":"/mQGhLaAS9dy88Gl3LuqEnIw46EJ.jpg","release_date":"2017-09-27","softcore":false,"video":false,"vote_average":6.512,"vote_count":42,"credit_id":"625c253add731b0067069345","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/bKhhWhoV6B1Kq1wKRSWGDBhLv9Z.jpg","genre_ids":[16,18,36],"id":842859,"title":"Bezcenny pakunek","original_language":"fr","original_title":"La Plus Précieuse des marchandises","overview":"W lesie mieszkają drwal i jego żona. Mają tylko psa, trwa zima, cierpią głód. Kobieta codziennie modli się o coś z przejeżdżającego nieopodal pociągu — coś, co pomoże im przetrwać. Znajduje w lesie owinięte w biało-niebieski tałes dziecko, wyrzucone z pociągu jadącego do obozu śmierci. Drwal nie chce przyjąć dziecka, ale ostatecznie ulega, nie mogąc oprzeć się jego urokowi.","popularity":2.2585,"poster_path":"/tPakN7T2T6VHd3Q7kPmASbHfq9P.jpg","release_date":"2024-11-20","softcore":false,"video":false,"vote_average":7.729,"vote_count":199,"credit_id":"625c274dcb3084185e274ba6","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/jNehDJO59I7ERIC5eZaNjzT2nkC.jpg","genre_ids":[18],"id":392816,"title":"Pericle il nero","original_language":"it","original_title":"Pericle il nero","overview":"","popularity":0.6467,"poster_path":"/jArsF6gCnlQ6xKKOW8L6dJrnMPo.jpg","release_date":"2016-05-12","softcore":false,"video":false,"vote_average":5.435,"vote_count":46,"credit_id":"625c27da3dd12600681af411","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":963929,"title":"Un été avec Anton","original_language":"fr","original_title":"Un été avec Anton","overview":"","popularity":0.8128,"poster_path":"/7PVIvQyzWTRX6yase1KerMu2jIh.jpg","release_date":"2012-04-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"625c2904bf09d1009932d77f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7bfrhqVhbEPN0wpIKedWCSaYSYD.jpg","genre_ids":[],"id":59062,"title":"Le Soleil Assassiné","original_language":"fr","original_title":"Le Soleil Assassiné","overview":"","popularity":1.3619,"poster_path":"/fyBcuJe3RKf8a4pCznLYAtCda3c.jpg","release_date":"2004-08-18","softcore":false,"video":false,"vote_average":5.3,"vote_count":10,"credit_id":"52fe497fc3a36847f819d441","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/8dzhOaD3C3oadvpos1goB3UvLt8.jpg","genre_ids":[18],"id":95448,"title":"Minister","original_language":"fr","original_title":"L'Exercice de l'État","overview":"Minister transportu, Bertrand Saint-Jean budzi się w środku nocy. Dzwoni jego osobista sekretarka. Autobus z dziećmi wpadł do rowu w ośnieżonych Ardenach. Jest kilka śmiertelnych ofiar. Minister nie ma wyjścia, musi jechać na miejsce tragedii, bo tego oczekują od niego wyborcy i media. W świetle kamer współczuje rodzinom ofiar i buduje własny wizerunek medialny. W ten sposób uruchamia szalony wir nieoczekiwanych zdarzeń, które wymagają szybkich i przemyślanych decyzji. Aby przetrwać w skomplikowanym świecie polityki, trzeba działać strategicznie, bez względu na konsekwencje. Trudno jednak zapomnieć o ludzkich dramatach, śmiertelnej tragedii, politycznych walkach i wszechobecnym kryzysie. W obłąkanej plątaninie zdarzeń, w których jedna kolizja następuje po drugiej, minister stara się zachować twarz, obronić własne interesy i pozycję. Pomocne okazują się żelazne nerwy, niezłomność i odporność na stres, jednak to nie wszystko, czego wymaga od niego sytuacja.","popularity":1.3503,"poster_path":"/8tJlPbwTQXOG6Ib9g7YSPQmvKE0.jpg","release_date":"2011-10-26","softcore":false,"video":false,"vote_average":6.422,"vote_count":148,"credit_id":"52fe49849251416c750caa57","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/bq5U9148k5yZXmO0yfa5vfNJl2z.jpg","genre_ids":[18,80,53],"id":833393,"title":"La Civil","original_language":"es","original_title":"La Civil","overview":"Członkowie kartelu narkotykowego uprowadzają nastolatkę w północnym Meksyku. Jej zrozpaczona matka, Cielo (Arcelia Ramírez), liczy na pomoc władz, ale wszystko wskazuje na to, że policja nie zamierza nic z tym zrobić. Zrozpaczona kobieta postanawia więc wziąć sprawy we własne ręce. Z gospodyni domowej przeistacza się w nieustępliwą bojowniczkę, która nie spocznie, dopóki nie dopadnie porywaczy. Jej determinacja wzbudza szacunek porucznika Lamarque'e (Jorge A. Jiménez), który postanawia pomóc jej w prywatnym śledztwie. Informacje przez nią zdobyte jemu także mogą się przydać. Kolejne decyzje zmuszają ten niekonwencjonalny duet do stawienia czoła nieprzewidzianym konsekwencjom.","popularity":1.3974,"poster_path":"/11DDA8vryhVHhjSHGKO51MtDhsl.jpg","release_date":"2021-07-08","softcore":false,"video":false,"vote_average":7.86,"vote_count":100,"credit_id":"60cc4f45a217c0006d068bc1","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":187529,"title":"Il court, il court, le monde","original_language":"fr","original_title":"Il court, il court, le monde","overview":"","popularity":0.5283,"poster_path":"/3RslUFjq5wufST6NbmA2jcftmXx.jpg","release_date":"1987-01-01","softcore":false,"video":false,"vote_average":5.667,"vote_count":6,"credit_id":"52fe4d1d9251416c751305c1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/PS5u6V1ZWzkZYFHYUCCStz1Yhu.jpg","genre_ids":[18],"id":221902,"title":"Dwa dni, jedna noc","original_language":"fr","original_title":"Deux jours, une nuit","overview":"Sandra staje przed zadaniem na pozór niemożliwym. Musi przekonać wszystkich ludzi, z którymi pracuje, aby zrezygnowali ze swoich premii. Jeżeli jej się nie powiedzie – ona sama straci pracę. Wspierana przez męża, kobieta wyrusza na spotkania z kolegami i koleżankami z pracy. Ma tylko jeden weekend, by uratować posadę.","popularity":2.8654,"poster_path":"/8ZpMA37iZdy8jvs3Toq67z5xRd7.jpg","release_date":"2014-05-21","softcore":false,"video":false,"vote_average":6.9,"vote_count":1023,"credit_id":"52fe4dd79251416c75142bcf","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kuBcEgTWcDnxdv70oDP1HzhPTWE.jpg","genre_ids":[35],"id":225719,"title":"Sprawa dla dwojga","original_language":"fr","original_title":"Je fais le mort","overview":"Jean Renault to czterdziestoletni aktor, któremu nie wiedzie się w życiu. Mężczyzna uchodzi za trudnego we współpracy, od lat nie zagrał ważnej roli. Pewnego dnia otrzymuje nietypową propozycję - ma wziąć udział w policyjnej rekonstrukcji brutalnego morderstwa. Przypada mu do odegrania rola ofiary. Nieoczekiwanie Jean angażuje się w śledztwo prowadzone przez wymagającą panią prokurator.","popularity":1.8226,"poster_path":"/8gEx7ONkRg3yMzbf5EdczT9rfzg.jpg","release_date":"2013-12-11","softcore":false,"video":false,"vote_average":5.371,"vote_count":140,"credit_id":"52fe4e679251416c7515551b","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/emX0jjs6Hnm82PVHGr0ukbYyEfb.jpg","genre_ids":[18],"id":989496,"title":"Holly","original_language":"nl","original_title":"Holly","overview":"15-letnia Holly dzwoni do szkoły, aby powiedzieć, że tego dnia zostnie w domu. Wkrótce potem w szkole wybucha pożar, w którym ginie kilku uczniów.","popularity":0.7366,"poster_path":"/yOH7hUHXgpVo58Oem4HPLKcVfCE.jpg","release_date":"2023-11-22","softcore":false,"video":false,"vote_average":5.357,"vote_count":21,"credit_id":"62b454053e6f2b1127d1dda3","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/PS5u6V1ZWzkZYFHYUCCStz1Yhu.jpg","genre_ids":[18],"id":221902,"title":"Dwa dni, jedna noc","original_language":"fr","original_title":"Deux jours, une nuit","overview":"Sandra staje przed zadaniem na pozór niemożliwym. Musi przekonać wszystkich ludzi, z którymi pracuje, aby zrezygnowali ze swoich premii. Jeżeli jej się nie powiedzie – ona sama straci pracę. Wspierana przez męża, kobieta wyrusza na spotkania z kolegami i koleżankami z pracy. Ma tylko jeden weekend, by uratować posadę.","popularity":2.8654,"poster_path":"/8ZpMA37iZdy8jvs3Toq67z5xRd7.jpg","release_date":"2014-05-21","softcore":false,"video":false,"vote_average":6.9,"vote_count":1023,"credit_id":"537b887b0e0a267f13000176","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":5724,"title":"Madonnen","original_language":"de","original_title":"Madonnen","overview":"","popularity":1.2062,"poster_path":"/9ljMpaeuvlG6pIzTHRTISath1mk.jpg","release_date":"2007-02-11","softcore":false,"video":false,"vote_average":5.978,"vote_count":23,"credit_id":"537b86d70e0a267f23000083","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/rCNR48c7ysIXmF2uqn8alwF4HKi.jpg","genre_ids":[18],"id":11490,"title":"Dziecko","original_language":"fr","original_title":"L'enfant","overview":"Bruno i Sonia są jeszcze bardzo młodzi. Ona ma osiemnaście lat, on dwadzieścia, żyją z jej zasiłku i kradzieży popełnianych przez Bruna i jego gang złożony z nieletnich chłopców. Kiedy pojawi się Jimmy, ich dziecko, nadejdzie czas, gdy Bruno będzie musiał dokonać wyboru, czy wziąć odpowiedzialność za synka, czy nadal żyć jak do tej pory, zaspokajając jedynie własne potrzeby.","popularity":2.019,"poster_path":"/kLY1xQM0VLzB8kaPOMyV5aP3LBz.jpg","release_date":"2005-09-14","softcore":false,"video":false,"vote_average":7.1,"vote_count":285,"credit_id":"53dabcd9c3a36872a60003a7","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/ya2nGkcaCrIQVQq8Ul5d6gVxHds.jpg","genre_ids":[18],"id":290829,"title":"Terre Battue","original_language":"fr","original_title":"Terre Battue","overview":"","popularity":0.7492,"poster_path":"/pgMwhLcMUpJ11StVGglhZbg9nml.jpg","release_date":"2014-12-17","softcore":false,"video":false,"vote_average":5.538,"vote_count":26,"credit_id":"540adc150e0a262b430021bc","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7cIwJvviym6hL1cQs6IOTsrrbPB.jpg","genre_ids":[18],"id":517288,"title":"وِلْدي","original_language":"ar","original_title":"وِلْدي","overview":"","popularity":1.7044,"poster_path":"/mdCudCSTGY0m4IUd6SOTwFCVIPX.jpg","release_date":"2018-11-14","softcore":false,"video":false,"vote_average":6.4,"vote_count":12,"credit_id":"618b5cadddd52d0042c50a9a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/hZuFiZJJTKzmP4haYPA6aiRso99.jpg","genre_ids":[53,18,80],"id":340481,"title":"Nieznajoma dziewczyna","original_language":"fr","original_title":"La Fille inconnue","overview":"Lekarka Jenny (Adele Haenel) próbuje nauczyć swojego praktykanta przestrzegania godzin pracy. Nie wie jeszcze, że te same zasady wkrótce zmienią jej życie. Pewnego dnia do drzwi gabinetu puka pewna młoda kobieta. Jenny skończyła już jednak swój dyżur, więc nie przyjmuje chorej. Nazajutrz policja znajduje ciało niedoszłej pacjentki niedaleko kliniki. Jenny ma ogromne wyrzuty sumienia, więc postanawia samodzielnie ustalić tożsamość zmarłej, a także zapewnić jej godny pochówek.","popularity":2.1806,"poster_path":"/dUoTKphxbtKDJPGcubw6IP6D8w5.jpg","release_date":"2016-10-05","softcore":false,"video":false,"vote_average":6.18,"vote_count":433,"credit_id":"555769c29251411e51006248","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9UqogJL0ucnHAP9zujJLGvTkF81.jpg","genre_ids":[],"id":903992,"title":"Premier Amour","original_language":"fr","original_title":"Premier Amour","overview":"","popularity":0.379,"poster_path":"/4o0nw1hqiggSwdDviNrxpg2zq98.jpg","release_date":"2002-01-03","softcore":false,"video":false,"vote_average":4.75,"vote_count":4,"credit_id":"61a1307457530e0064fa737f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7NMVF3Af9wGvH3ceKaDUWuWUAt4.jpg","genre_ids":[18],"id":914203,"title":"Tori i Lokita","original_language":"fr","original_title":"Tori et Lokita","overview":"Tori jest małym chłopcem, Lokita zaledwie nastolatką, oboje uciekli przed przemocą i biedą z Afryki Zachodniej i chcieliby razem ułożyć sobie życie w Belgii. Obojętność imigracyjnych urzędników, rodziny domagające się wsparcia i długi zaciągnięte u przemytników spychają jednak bohaterów w szarą strefę, gdzie do eksploatowania pozbawionych opieki i praw dzieci przyłączają się przestępcy. Podejrzani dla urzędów, bezbronni wobec przemocy, chłopak i dziewczyna mają tylko siebie. „Tori i Lokita” to opowieść o odwadze i nadziei, których nie sposób złamać. O sile przyjaźni w świecie, który niszczy więzi, o wartości wzajemnej troski, choć wokół liczą się tylko pieniądze.","popularity":1.9903,"poster_path":"/jqotkLiIdKmnix881XNtQTfpSos.jpg","release_date":"2022-10-05","softcore":false,"video":false,"vote_average":6.853,"vote_count":95,"credit_id":"61b3e7a9ec455200602955c3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364370,"title":"Pour que la guerre s'acheve, les murs devaient s'ecrouter","original_language":"fr","original_title":"Pour que la guerre s'acheve, les murs devaient s'ecrouter","overview":"","popularity":0.6993,"poster_path":"/nR40WeK9DnCK5VyEVOfn6jsZhRk.jpg","release_date":"1980-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"56238ec7c3a3680e1600cde5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364371,"title":"R... ne repond plus","original_language":"fr","original_title":"R... ne repond plus","overview":"","popularity":0.6097,"poster_path":"/wAa93kbui9JMYFz7RNLrXO9XKuh.jpg","release_date":"1981-01-01","softcore":false,"video":false,"vote_average":6.375,"vote_count":8,"credit_id":"56238f8ec3a368240d00689c","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364371,"title":"R... ne repond plus","original_language":"fr","original_title":"R... ne repond plus","overview":"","popularity":0.6097,"poster_path":"/wAa93kbui9JMYFz7RNLrXO9XKuh.jpg","release_date":"1981-01-01","softcore":false,"video":false,"vote_average":6.375,"vote_count":8,"credit_id":"56238f96c3a3680e1900dc3c","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/eZ3o2y0nFaJz6tez9Bw7sTV0EoM.jpg","genre_ids":[99],"id":364368,"title":"Lorsque le bateau de Leon M. descendit la Meuse pour la premiere fois","original_language":"fr","original_title":"Lorsque le bateau de Leon M. descendit la Meuse pour la premiere fois","overview":"","popularity":0.608,"poster_path":"/f68EG1jlG7RBJA29gMC6w4dwQGr.jpg","release_date":"1979-01-01","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"56238729c3a3680e0e00e8f7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eZ3o2y0nFaJz6tez9Bw7sTV0EoM.jpg","genre_ids":[99],"id":364368,"title":"Lorsque le bateau de Leon M. descendit la Meuse pour la premiere fois","original_language":"fr","original_title":"Lorsque le bateau de Leon M. descendit la Meuse pour la premiere fois","overview":"","popularity":0.608,"poster_path":"/f68EG1jlG7RBJA29gMC6w4dwQGr.jpg","release_date":"1979-01-01","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"5623873cc3a3680e2000eed6","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364372,"title":"Leçons d'une université volante","original_language":"fr","original_title":"Leçons d'une université volante","overview":"","popularity":0.551,"poster_path":"/sN5s3Wrhj5xOIcwM8NRdp1WzJAF.jpg","release_date":"1982-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":5,"credit_id":"56239037c3a3680e1000db28","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364370,"title":"Pour que la guerre s'acheve, les murs devaient s'ecrouter","original_language":"fr","original_title":"Pour que la guerre s'acheve, les murs devaient s'ecrouter","overview":"","popularity":0.6993,"poster_path":"/nR40WeK9DnCK5VyEVOfn6jsZhRk.jpg","release_date":"1980-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"56238ed0c3a3680e1900dc1e","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":364372,"title":"Leçons d'une université volante","original_language":"fr","original_title":"Leçons d'une université volante","overview":"","popularity":0.551,"poster_path":"/sN5s3Wrhj5xOIcwM8NRdp1WzJAF.jpg","release_date":"1982-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":5,"credit_id":"5623903ec3a3680e1000db2a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/3FYlk1DlXulq5gE7PZ3lIHbYbOA.jpg","genre_ids":[18,53,80],"id":848950,"title":"Kręgielnia Saturn","original_language":"fr","original_title":"Bowling Saturne","overview":"Po śmierci ojca policjant Guillaume dziedziczy rodzinną kręgielnię i postanawia przekazać ją przyrodniemu bratu Armandowi. Okazuje się jednak, że miejsce jest nawiedzone, a bracia zostają wciągnięci w otchłań i muszą stawić czoła swojemu dziedzictwu.","popularity":0.8707,"poster_path":"/lyIqihYpiIXLSPYwGEvg0ImnTHK.jpg","release_date":"2022-10-26","softcore":false,"video":false,"vote_average":5.659,"vote_count":44,"credit_id":"63569f71d18fb900825e8630","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/kC7YmW69fEdM0cazeVIVdmj7644.jpg","genre_ids":[18,10749],"id":103740,"title":"Za wzgórzami","original_language":"ro","original_title":"După dealuri","overview":"Mały kościół i kilka drewnianych domków pośrodku polany – w tej skromnej scenerii atmosfera ukojenia boskością obecna w żeńskim klasztorze wydaje się nie do zachwiania. Lasy dookoła nie drgną, zastygłą ciszę wstyd zakłócać nawet szeptem, odcięcie od świata otula miasteczko poczuciem bezpieczeństwa. Szczelna granica wyznaczana przez strzegącą spokoju naturę okazuje się niewystarczająca. Zagrożenie wślizguje się do klasztoru niepostrzeżenie, wraz z przybyciem Aliny, przyjaciółki mniszki Voichiţy. Wbrew jej zapewnieniom zakon nie zdołał stłamsić miłosnego uczucia Voichiţy do koleżanki, której obecność na nowo rozbudza szmer niepokoju w jej ciele, duszy i sercu. Z kolei uparte awanse Aliny w końcu przeradzają się w dręczące ją epileptyczne ataki, uznane przez religijną wspólnotę za diabelskie opętanie. Z wolna rozsadzane życie zakonu przywodzi mniszki do momentu, w którym miłosierdzie zaczyna przegrywać ze strachem.","popularity":1.2697,"poster_path":"/7L1fl6iOgfVhhZWT3ZyhBWB5yKi.jpg","release_date":"2012-10-25","softcore":false,"video":false,"vote_average":7.115,"vote_count":213,"credit_id":"566a02b39251417383002158","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/2cI0rmMgoZOqP78iQDZwQASkKT3.jpg","genre_ids":[37,18,35],"id":440161,"title":"Bracia Sisters","original_language":"en","original_title":"The Sisters Brothers","overview":"Lata 50. XIX wieku, Oregon. Bracia Charlie (Joaquin Phoenix) i Eli (John C. Reilly) przyjmują zlecenie odnalezienia i zabicia znanego poszukiwacza złota, Hermanna Kermita Warma (Riz Ahmed). Podróż wystawi na próbę rodzinne więzi.","popularity":5.6542,"poster_path":"/3SxxMfkje7UqyXke3LdE4A9p4uo.jpg","release_date":"2018-09-19","softcore":false,"video":false,"vote_average":6.832,"vote_count":2109,"credit_id":"620572e9d7fbda0044ded71a","department":"Production","job":"Associate Producer"},{"adult":false,"backdrop_path":"/LLVvgPXBmIvVPG6MQaPLYVE9HE.jpg","genre_ids":[18],"id":374458,"title":"Egzamin","original_language":"ro","original_title":"Bacalaureat","overview":"Dla Romea Aldei najważniejsza jest córka, która właśnie zdaje maturę i wybiera się na studia do Wielkiej Brytanii. Tuż przed egzaminami zostaje napadnięta, a ojciec próbuje zrobić wszystko, aby załatwić córce dobry wynik.","popularity":2.427,"poster_path":"/utSSOHhWuBaBBlHlKdl0RrQn3Ac.jpg","release_date":"2016-05-20","softcore":false,"video":false,"vote_average":6.76,"vote_count":312,"credit_id":"57307373c3a3687cc90046d5","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/7UsW6pKkCdCmceBmdQ0MvV6zKhL.jpg","genre_ids":[18],"id":1242015,"title":"Młode matki","original_language":"fr","original_title":"Jeunes mères","overview":"Pięć młodych matek żyjących w schronisku stara się o lepszą przyszłość dla siebie i dzieci wśród trudnych warunków wychowania.","popularity":2.9228,"poster_path":"/7M6FM9sI7EE7lwfYu7hUYgVRoOX.jpg","release_date":"2025-05-23","softcore":false,"video":false,"vote_average":6.508,"vote_count":64,"credit_id":"65c4119199259c017da4bdc0","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/7UsW6pKkCdCmceBmdQ0MvV6zKhL.jpg","genre_ids":[18],"id":1242015,"title":"Młode matki","original_language":"fr","original_title":"Jeunes mères","overview":"Pięć młodych matek żyjących w schronisku stara się o lepszą przyszłość dla siebie i dzieci wśród trudnych warunków wychowania.","popularity":2.9228,"poster_path":"/7M6FM9sI7EE7lwfYu7hUYgVRoOX.jpg","release_date":"2025-05-23","softcore":false,"video":false,"vote_average":6.508,"vote_count":64,"credit_id":"65c4115655bc350164abb742","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7NMVF3Af9wGvH3ceKaDUWuWUAt4.jpg","genre_ids":[18],"id":914203,"title":"Tori i Lokita","original_language":"fr","original_title":"Tori et Lokita","overview":"Tori jest małym chłopcem, Lokita zaledwie nastolatką, oboje uciekli przed przemocą i biedą z Afryki Zachodniej i chcieliby razem ułożyć sobie życie w Belgii. Obojętność imigracyjnych urzędników, rodziny domagające się wsparcia i długi zaciągnięte u przemytników spychają jednak bohaterów w szarą strefę, gdzie do eksploatowania pozbawionych opieki i praw dzieci przyłączają się przestępcy. Podejrzani dla urzędów, bezbronni wobec przemocy, chłopak i dziewczyna mają tylko siebie. „Tori i Lokita” to opowieść o odwadze i nadziei, których nie sposób złamać. O sile przyjaźni w świecie, który niszczy więzi, o wartości wzajemnej troski, choć wokół liczą się tylko pieniądze.","popularity":1.9903,"poster_path":"/jqotkLiIdKmnix881XNtQTfpSos.jpg","release_date":"2022-10-05","softcore":false,"video":false,"vote_average":6.853,"vote_count":95,"credit_id":"639a5727988afd00e6361193","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":409930,"title":"Regard Jonathan/Jean Louvet, son oeuvre","original_language":"fr","original_title":"Regard Jonathan/Jean Louvet, son oeuvre","overview":"","popularity":0.5903,"poster_path":"/rJkpu7AkmJTUj5bxtGYjvfUfMuS.jpg","release_date":"1983-01-01","softcore":false,"video":false,"vote_average":6.25,"vote_count":4,"credit_id":"57aefdb7925141289d003175","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9HRReetyFFz5OVGRoahQQhDO0yO.jpg","genre_ids":[18,14,9648],"id":374464,"title":"Planetarium","original_language":"fr","original_title":"Planetarium","overview":"Piękne i tajemnicze siostry Laura (Natalie Portman) i Kate (Lily-Rose Depp) posiadają nadprzyrodzone zdolności i potrafią komunikować się z duchami. Na zakończenie swojego tournée po Europie ruszają do Paryża, gdzie spotykają pewnego charyzmatycznego producenta filmowego (Emmanuel Salinger). Laura i Kate odkryją przed nim klimatyczny świat pełen magii i zmysłowości. I nieodwracalnie zmienią jego życie.","popularity":2.2075,"poster_path":"/cuwYVBOxIGwXAJH89yHnkqe3SbV.jpg","release_date":"2016-11-16","softcore":false,"video":false,"vote_average":4.623,"vote_count":215,"credit_id":"57d08c729251417fb30002fa","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/hZuFiZJJTKzmP4haYPA6aiRso99.jpg","genre_ids":[53,18,80],"id":340481,"title":"Nieznajoma dziewczyna","original_language":"fr","original_title":"La Fille inconnue","overview":"Lekarka Jenny (Adele Haenel) próbuje nauczyć swojego praktykanta przestrzegania godzin pracy. Nie wie jeszcze, że te same zasady wkrótce zmienią jej życie. Pewnego dnia do drzwi gabinetu puka pewna młoda kobieta. Jenny skończyła już jednak swój dyżur, więc nie przyjmuje chorej. Nazajutrz policja znajduje ciało niedoszłej pacjentki niedaleko kliniki. Jenny ma ogromne wyrzuty sumienia, więc postanawia samodzielnie ustalić tożsamość zmarłej, a także zapewnić jej godny pochówek.","popularity":2.1806,"poster_path":"/dUoTKphxbtKDJPGcubw6IP6D8w5.jpg","release_date":"2016-10-05","softcore":false,"video":false,"vote_average":6.18,"vote_count":433,"credit_id":"5843f8c29251416a8000861a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/zLPauPgoxZDtECDRSod5Ku1OIlb.jpg","genre_ids":[18],"id":356380,"title":"Viva la sposa","original_language":"it","original_title":"Viva la sposa","overview":"","popularity":0.5847,"poster_path":"/rV00t0Vc5D5TT8NnE2yrU7F0TdW.jpg","release_date":"2015-09-07","softcore":false,"video":false,"vote_average":3.6,"vote_count":4,"credit_id":"5861f096c3a3681a650354c8","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1263620,"title":"Être amoureux","original_language":"fr","original_title":"Être amoureux","overview":"","popularity":1.2521,"poster_path":"/hTrUNPaBfmCTQJ1qKgsxhTTNsJj.jpg","release_date":"2005-02-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"65ff08cb378062017c39d540","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/yXwJzc6beR82pg6R3BMaurH4lwq.jpg","genre_ids":[18],"id":1187308,"title":"Milczenie Julie","original_language":"nl","original_title":"Julie zwijgt","overview":"","popularity":1.7314,"poster_path":"/bUiLWLFB9UQICxdyFJegzjA6m53.jpg","release_date":"2024-10-16","softcore":false,"video":false,"vote_average":6.25,"vote_count":36,"credit_id":"66410ac6feaefb20b2014b14","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/bRiFQLsuocS95owFwOyNANHY6D9.jpg","genre_ids":[18],"id":803690,"title":"Język obcy","original_language":"fr","original_title":"Langue étrangère","overview":"Fanny, 17-letnia uczennica z Francji, wyjeżdża na wymianę językową do Niemiec. W Lipsku poznaje swoją korespondencyjną przyjaciółkę Lenę, która jest w jej wieku i pragnie zaangażować się w działalność polityczną. Aby zaimponować Lenie, dość nieśmiała i zacofana Fanny wymyśla dla siebie inne życie – ale szybko wpada w pułapkę swojego oszustwa.","popularity":3.0572,"poster_path":"/avdTY8hBwRCQTT5BSrzYJT1x7hC.jpg","release_date":"2024-09-11","softcore":false,"video":false,"vote_average":6.8,"vote_count":50,"credit_id":"6658db57512f151cfa93f11d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/hJzE5xbxapBjlB3F4SZHNUkNsFL.jpg","genre_ids":[18],"id":288587,"title":"Vie Sauvage","original_language":"fr","original_title":"Vie Sauvage","overview":"","popularity":0.8197,"poster_path":"/7EwY1JFY6j120Wg66cxG7CtKPu.jpg","release_date":"2014-10-29","softcore":false,"video":false,"vote_average":6.4,"vote_count":52,"credit_id":"5aa419c5c3a3687bfc0117cc","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/4hTeAZTYzPqKOEWwXd27WCqkoqH.jpg","genre_ids":[18,10751],"id":479813,"title":"Słoń i motyl","original_language":"fr","original_title":"Drôle de père","overview":"Antoine wraca do swojego belgijskiego miasta rodzinnego, gdzie spotyka swoją byłą kochankę i matkę ich pięcioletniej córki Elsy, której nigdy nie poznał. Przez nieoczekiwany zwrot wydarzeń Antoine musi zająć się dociekliwym i żywiołowym dzieckiem.","popularity":1.3377,"poster_path":"/15ptRIWnTLPmRJbE1f84noUGAEh.jpg","release_date":"2017-11-22","softcore":false,"video":false,"vote_average":7.0,"vote_count":13,"credit_id":"5aace4e4c3a36846e400f909","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/y31BYaEd4IEtcUyMqmIoUhvm1OP.jpg","genre_ids":[18],"id":522373,"title":"Młody Ahmed","original_language":"fr","original_title":"Le jeune Ahmed","overview":"Ahmed, który nie wyróżniał się wśród rówieśników, ze zwykłego nastolatka zmienia się w islamskiego ekstremistę, wierzącego w konieczność prowadzenia świętej wojny. Bracia Dardenne, mistrzowie filmowego realizmu, starają się odpowiedzieć na pytanie, czy zindoktrynowana i zagubiona jednostka może wrócić na łono społeczeństwa.","popularity":0.8507,"poster_path":"/l6oPDEJROzR3oVHXJDTkdrzPHFN.jpg","release_date":"2019-05-22","softcore":false,"video":false,"vote_average":6.292,"vote_count":172,"credit_id":"5aeccc70c3a368345e002060","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/y31BYaEd4IEtcUyMqmIoUhvm1OP.jpg","genre_ids":[18],"id":522373,"title":"Młody Ahmed","original_language":"fr","original_title":"Le jeune Ahmed","overview":"Ahmed, który nie wyróżniał się wśród rówieśników, ze zwykłego nastolatka zmienia się w islamskiego ekstremistę, wierzącego w konieczność prowadzenia świętej wojny. Bracia Dardenne, mistrzowie filmowego realizmu, starają się odpowiedzieć na pytanie, czy zindoktrynowana i zagubiona jednostka może wrócić na łono społeczeństwa.","popularity":0.8507,"poster_path":"/l6oPDEJROzR3oVHXJDTkdrzPHFN.jpg","release_date":"2019-05-22","softcore":false,"video":false,"vote_average":6.292,"vote_count":172,"credit_id":"5aeccc970e0a2635a3001bc5","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/umRF7F8Ooj8i3xZ38guSc1P7bDQ.jpg","genre_ids":[35,18],"id":377287,"title":"Le Fils de Joseph","original_language":"fr","original_title":"Le Fils de Joseph","overview":"","popularity":1.0662,"poster_path":"/ceXyN6oDeetqh3INFps0UwF1zsU.jpg","release_date":"2016-04-20","softcore":false,"video":false,"vote_average":6.7,"vote_count":27,"credit_id":"5b1aaa88c3a36848f6018501","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/l4daPg7vIVbtMyOMBYheFzmdLuC.jpg","genre_ids":[99],"id":595096,"title":"Deux Soeurs","original_language":"fr","original_title":"Deux Soeurs","overview":"","popularity":1.3492,"poster_path":"/elyeFQf2FEw0NM1ZPRb2h6ChVjn.jpg","release_date":"2002-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"668d3e4ee8f36876b5c0f88d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/oX67zLRjfrCpt41YiYjh9Hxm0Ds.jpg","genre_ids":[99],"id":913677,"title":"Do You Remember Revolution?","original_language":"it","original_title":"Do You Remember Revolution?","overview":"","popularity":0.885,"poster_path":"/voNc7YdslC0uB7EAmKk53Aubhas.jpg","release_date":"1997-10-04","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"668d465bdbfa8300bc2c294a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/vy9HN4xHubJt3FVAqF1RZvLSNSC.jpg","genre_ids":[35],"id":537109,"title":"Como Fernando Pessoa Salvou Portugal","original_language":"pt","original_title":"Como Fernando Pessoa Salvou Portugal","overview":"","popularity":0.636,"poster_path":"/4AlgskylC2M6VrBYZkMGo3Yk152.jpg","release_date":"2018-10-11","softcore":false,"video":false,"vote_average":6.3,"vote_count":20,"credit_id":"5b57371b9251416dcc0348f6","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/1pfkf2gOSmDpayNB9U81B69Vuz6.jpg","genre_ids":[18],"id":1293858,"title":"Dla dobra Adama","original_language":"fr","original_title":"L'Intérêt d'Adam","overview":"Lucy pracuje w szpitalu na oddziale pediatrycznym, gdzie brakuje personelu. Pod jej opiekę zostaje oddany 4-letni Adam, który trafił do szpitala z powodu niedożywienia. Pojawia się jednak problem – . pomimo wydanego sądownego nakazu, dziecka w szpitalu nie chce zostawić jego matka, Rebeka. Dla dobra Adama Lucy zrobi wszystko, co w jej mocy, aby pomóc zarówno dziecku, jak i matce.","popularity":1.0323,"poster_path":"/iECTrYSSa1AilRsXFOPxn7oxOI9.jpg","release_date":"2025-09-17","softcore":false,"video":false,"vote_average":6.7,"vote_count":35,"credit_id":"66bce1db362232b6c2826072","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7atlokNf3cC4gxj3Jq0JYaGnMED.jpg","genre_ids":[18,36],"id":550244,"title":"Nie strzelać","original_language":"nl","original_title":"Niet Schieten","overview":"9 listopada 1985 roku gang przeprowadził krwawy nalot na supermarket Delhaize w Aalst w Belgii, w którym zginęło ośmioro niewinnych ludzi - w tym trzech członków rodziny Van de Steen. Należący do niej dziewięcioletni David, pomimo licznych obrażeń, przeżył masakrę. Sierotą postanowili zająć się dziadkowie. Jego dziadek - Albert - ze wszystkich sił pragnie zapewnić dobrą przyszłość wnuczkowi i doprowadzić morderców przed wymiar sprawiedliwości.","popularity":1.8949,"poster_path":"/lMjqg9QFEFvcfJXlDgw09jIZmTt.jpg","release_date":"2018-10-04","softcore":false,"video":false,"vote_average":7.295,"vote_count":44,"credit_id":"5bdc8b530e0a26284e0021b4","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/2cI0rmMgoZOqP78iQDZwQASkKT3.jpg","genre_ids":[37,18,35],"id":440161,"title":"Bracia Sisters","original_language":"en","original_title":"The Sisters Brothers","overview":"Lata 50. XIX wieku, Oregon. Bracia Charlie (Joaquin Phoenix) i Eli (John C. Reilly) przyjmują zlecenie odnalezienia i zabicia znanego poszukiwacza złota, Hermanna Kermita Warma (Riz Ahmed). Podróż wystawi na próbę rodzinne więzi.","popularity":5.6542,"poster_path":"/3SxxMfkje7UqyXke3LdE4A9p4uo.jpg","release_date":"2018-09-19","softcore":false,"video":false,"vote_average":6.832,"vote_count":2109,"credit_id":"5c1a6d4b92514152eee2af8e","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":102533,"title":"Stormviðri","original_language":"is","original_title":"Stormviðri","overview":"","popularity":1.4215,"poster_path":"/zgDyhaz7o3qxls8leConDH07zP3.jpg","release_date":"2003-09-07","softcore":false,"video":false,"vote_average":5.3,"vote_count":12,"credit_id":"5ce8dc2192514175e8b857a6","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7yAGWTGgVFYHl2SrEInQFzBlHn6.jpg","genre_ids":[99],"id":608320,"title":"Il fare politica","original_language":"it","original_title":"Il fare politica","overview":"","popularity":0.4464,"poster_path":"/t1V8RWYtbOTty56p5kGx1FEJBww.jpg","release_date":"2005-05-13","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5d00bd01c3a368445b236aaa","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/xdoQAFJFYP4YkBEgDetDwRSsr71.jpg","genre_ids":[18,14],"id":126100,"title":"Le Monde vivant","original_language":"fr","original_title":"Le Monde vivant","overview":"","popularity":1.4214,"poster_path":"/hcC31uGdUWVAuR8a20f85DeY2kF.jpg","release_date":"2003-11-26","softcore":false,"video":false,"vote_average":6.636,"vote_count":11,"credit_id":"5d2c75c8caab6d1e819d3df5","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/nYoFhxq3WOL7NotlkGkczp8xdF9.jpg","genre_ids":[18],"id":660337,"title":"Atarrabi & Mikelats","original_language":"eu","original_title":"Atarrabi & Mikelats","overview":"","popularity":1.5917,"poster_path":"/7sqfz6ghmzudLADL2l3JDcSRfb9.jpg","release_date":"2020-09-23","softcore":false,"video":false,"vote_average":4.714,"vote_count":7,"credit_id":"5f37d3755c071b0035ab8590","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/svDBHdJ37rDYZM0vvvJxZULbt5r.jpg","genre_ids":[18,10749],"id":504605,"title":"Casanova: Ostatnia miłość","original_language":"fr","original_title":"Dernier amour","overview":"Londyn, XVIII wiek. Casanova, słynący z uwielbienia do uciech i hazardu oraz kobiet, zmuszony do emigracji z Francji, przyjeżdża do Londynu. Tutaj poznaje młodą kurtyzanę Marianne de Charpillon, która intryguje go do tego stopnia, że przestaje zwracać uwagę na inne kobiety. Marianne jednak okazuje się pierwszą, która mu się opiera, co doprowadza Casanovę do szaleństwa. Uwodzi go, a jednocześnie sprytnie unika zbliżenia, w końcu stawia mu warunek: ,,Oddam ci się, jeśli przestaniesz mnie pożądać.’’","popularity":1.9301,"poster_path":"/eC1mz2PtoAxXaO8ao5SFeQPrGd8.jpg","release_date":"2019-03-20","softcore":false,"video":false,"vote_average":4.817,"vote_count":41,"credit_id":"5f4de43efea0d700353f64d2","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/tLmr7yhyfybVniH8LZGYeEDkaLf.jpg","genre_ids":[18],"id":661932,"title":"Słodkie cygaro","original_language":"fr","original_title":"Cigare au miel","overview":"Paryż, 1993. Selma, 17 lat, mieszka w burżuazyjnej i świeckiej rodzinie berberyjskiej. Kiedy spotyka Juliena, szykownego młodzieńca i bardzo go pociąga, po raz pierwszy uświadamia sobie surowe zasady jej patriarchalnej rodziny i ich wpływ na jej intymność. Gdy islamizm przejmuje jej kraj pochodzenia, a jej rodzina rozpada się, Selma odkrywa siłę własnego pragnienia. Musi stawiać opór i walczyć. Dzięki sile swojego ludu zaczyna kroczyć ścieżką, co to znaczy stać się wolną kobietą?.","popularity":1.49,"poster_path":"/7N7o8sEMQwiryb7OQsaBXHeXYrj.jpg","release_date":"2020-09-02","softcore":false,"video":false,"vote_average":5.7,"vote_count":36,"credit_id":"5f3fd497904f6d0034a8b160","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/20vIC3JXCFrsLwv0TpiBbK7IKh2.jpg","genre_ids":[35,18],"id":36108,"title":"Kocham kino","original_language":"fr","original_title":"Chacun son cinema ou Ce petit coup au coeur quand la lumiere s'eteint et que le film commence","overview":",,Chacun son cinéma\" to hołd złożony magii kina. Film, powstał na 60. urodziny Festiwalu w Cannes w 2007r. Obraz składa się z 33 etiud słynnych światowych reżyserów. Motywem łączącym je wszystkie jest nieśmiertelny temat kina. Pomysłodawcą obrazu jest pan Gilles Jacob.","popularity":2.1872,"poster_path":"/oqsHDWIh26sJXz9Ua3lPQhUx3lK.jpg","release_date":"2007-10-31","softcore":false,"video":false,"vote_average":6.5,"vote_count":155,"credit_id":"5f727e8cfbe36f003776df9a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/ki93pD6cBIvzFMw9wW7doZZRwxH.jpg","genre_ids":[18,36],"id":392794,"title":"Tancerka","original_language":"fr","original_title":"La Danseuse","overview":"Loïe co wieczór elektryzuje publiczność tańcem, który nazwano serpentynowym.","popularity":2.2428,"poster_path":"/yhRH3XTIyhPwG3iqNriwa2zq2ga.jpg","release_date":"2016-09-28","softcore":false,"video":false,"vote_average":6.549,"vote_count":206,"credit_id":"5fe8ac1e1d3563003ddae352","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/1rW5K8MnptQh4TfelcTDODhBtVv.jpg","genre_ids":[80,18],"id":802714,"title":"Animals","original_language":"fr","original_title":"Animals","overview":"","popularity":0.8778,"poster_path":"/61ABo2Tkz30OqOPlO1efUAbNDpb.jpg","release_date":"2022-06-23","softcore":false,"video":false,"vote_average":5.0,"vote_count":16,"credit_id":"6041d7cdd4cc8e00785d4a8e","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/tyMzyCXUR91T5eKsJoEjNwFCNky.jpg","genre_ids":[18],"id":1256408,"title":"Manas","original_language":"pt","original_title":"Manas","overview":"","popularity":2.3892,"poster_path":"/sGLx3nUukO3ysgyuvuO8XrplTjV.jpg","release_date":"2025-03-26","softcore":false,"video":false,"vote_average":8.3,"vote_count":37,"credit_id":"66dd1c42400c5c39e99a9888","department":"Production","job":"Associate Producer"},{"adult":false,"backdrop_path":"/7UsW6pKkCdCmceBmdQ0MvV6zKhL.jpg","genre_ids":[18],"id":1242015,"title":"Młode matki","original_language":"fr","original_title":"Jeunes mères","overview":"Pięć młodych matek żyjących w schronisku stara się o lepszą przyszłość dla siebie i dzieci wśród trudnych warunków wychowania.","popularity":2.9228,"poster_path":"/7M6FM9sI7EE7lwfYu7hUYgVRoOX.jpg","release_date":"2025-05-23","softcore":false,"video":false,"vote_average":6.508,"vote_count":64,"credit_id":"67f9519a7f70ac1a21d971f7","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/EpHSk8F5ZrO952t0d5hJR8KS7w.jpg","genre_ids":[53],"id":499728,"title":"Paul Sanchez est revenu !","original_language":"fr","original_title":"Paul Sanchez est revenu !","overview":"","popularity":1.0786,"poster_path":"/1VKN39sCzPsxV4lGSTG5t11sRjB.jpg","release_date":"2018-07-18","softcore":false,"video":false,"vote_average":5.258,"vote_count":60,"credit_id":"680baf09271ecb3ae08a8922","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/aF9RJKjSKt42ay27Zc9puPqeyHH.jpg","genre_ids":[18],"id":1268912,"title":"Najeźdźcy","original_language":"ro","original_title":"Jaful secolului","overview":"Natalia i Ginel opuszczają swoją małą rumuńską wioskę nad Dunajem, aby pracować za granicą w dużym flamandzkim mieście. Pewnego wieczoru, po tym, jak zostaje zaatakowana po spotkaniu z miejscowym, Natalia prosi Ita, przyjaciela z domu, który stał się oszustem, o pomoc. Ita wykorzystuje ich frustrację przeciwko wartościom świata, który uważają za arogancki, dekadencki i historycznie winny ich nędzy jako obywateli drugiej kategorii — niewidzialnych migrantów. Rezultatem jest tragikomiczny ideologiczny napad, ujawniający jedynie całkowity brak komunikacji między Wschodem a Zachodem, między bogatymi a biednymi, między panami a niewolnikami.","popularity":0.7809,"poster_path":"/3KvHMTnVzVIstHXmkr1WTPZNs79.jpg","release_date":"2025-08-07","softcore":false,"video":false,"vote_average":7.2,"vote_count":4,"credit_id":"682e0a0c6299b61e73649888","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1508824,"title":"Bella","original_language":"he","original_title":"Bella","overview":"","popularity":1.6912,"poster_path":"/hdxNGEEkeiVS1WYOesQM3vzlRu.jpg","release_date":"2025-07-22","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"68696045a5a9370ce310311f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/yKy43nb02I0Gq4vgMLXAaaxCCP9.jpg","genre_ids":[18],"id":1509930,"title":"Bella","original_language":"he","original_title":"בלה","overview":"Kiedy Yaki dowiaduje się o prawdziwej tożsamości Belli – kędzierzawej, niezwykle cennej gołębicy i jedynego spadku – jest już za późno. Yaki wyrusza z Bilalem, swoim przyjacielem z dzieciństwa, i ich żonami w podróż przez Izrael i Palestynę, aby sprowadzić Bellę z powrotem. Po drodze przechodzą przez punkty kontrolne, psują ślub, kradną samochód nowożeńców, uczestniczą w rodzinnej ceremonii pojednania i ożywiają nieprzytomną gołębicę… Wszystko po to, by zdążyć na konkurs piękności gołębi w Jerozolimie.","popularity":1.2646,"poster_path":"/6rFmiByYsQBVoyJ9Kz1JPmW4GmA.jpg","release_date":"2025-07-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"686c0116913b1e9b1351e078","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/jl2An3tvhvJKOFWRngBkAe9PCqY.jpg","genre_ids":[18],"id":1421539,"title":"Julian","original_language":"fr","original_title":"Julian","overview":"","popularity":0.8431,"poster_path":"/83viwjTeBtJP4KbOmxDCF3Q2cqY.jpg","release_date":"2025-10-29","softcore":false,"video":false,"vote_average":6.7,"vote_count":9,"credit_id":"68bb3a5066584852359bb9b2","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/adqzbot8B2wH04il51092W4F5uH.jpg","genre_ids":[18],"id":65977,"title":"Je pense à vous","original_language":"fr","original_title":"Je pense à vous","overview":"","popularity":0.8969,"poster_path":"/gdF4ovuLeSiwla3C70CAWIupTBv.jpg","release_date":"1993-06-01","softcore":false,"video":false,"vote_average":5.389,"vote_count":9,"credit_id":"68d1b88cead97b3744cc3cf2","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":187529,"title":"Il court, il court, le monde","original_language":"fr","original_title":"Il court, il court, le monde","overview":"","popularity":0.5283,"poster_path":"/3RslUFjq5wufST6NbmA2jcftmXx.jpg","release_date":"1987-01-01","softcore":false,"video":false,"vote_average":5.667,"vote_count":6,"credit_id":"68d1b92a3c2aefb468749f90","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/1ZBPashbl6CQ3IhfbM38A67tNnj.jpg","genre_ids":[18],"id":11489,"title":"Rosetta","original_language":"fr","original_title":"Rosetta","overview":"Młoda i impulsywna Rosetta, mieszkająca z matką alkoholiczką, jest gotowa na wszystko, aby zdobyć pracę.","popularity":1.7422,"poster_path":"/zdWX3mNm9rzEU9f363y0NPehFrS.jpg","release_date":"1999-09-29","softcore":false,"video":false,"vote_average":7.137,"vote_count":343,"credit_id":"68d1b969bf472f00a3cc3cb0","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/rnxoI9ojYhReuBgb1gxkejpS55i.jpg","genre_ids":[80,18],"id":8899,"title":"Le Silence de Lorna","original_language":"fr","original_title":"Le Silence de Lorna","overview":"","popularity":1.3007,"poster_path":"/nl1Z38PmmLhIZDP70FoVXRo5vDN.jpg","release_date":"2008-08-27","softcore":false,"video":false,"vote_average":6.8,"vote_count":169,"credit_id":"68d1b9899cd23d1be7cc3ba3","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/59NaUtfZuK2f0lQedSDQwVF7X9E.jpg","genre_ids":[18],"id":63831,"title":"Chłopiec na rowerze","original_language":"fr","original_title":"Le Gamin au vélo","overview":"Porzucony przez ojca Cyryl nie może zaakceptować jego nieobecności i nieustannie ucieka z domu dziecka, by go szukać. Wkrótce chłopiec poznaje fryzjerkę, Samantę, która zaczyna mu pomagać.","popularity":2.1159,"poster_path":"/3U9zxuJCZrzI5Nd5BvHDMih4DMx.jpg","release_date":"2011-05-18","softcore":false,"video":false,"vote_average":7.075,"vote_count":465,"credit_id":"68d1b9ac5d5442f1e1cc3d49","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/PS5u6V1ZWzkZYFHYUCCStz1Yhu.jpg","genre_ids":[18],"id":221902,"title":"Dwa dni, jedna noc","original_language":"fr","original_title":"Deux jours, une nuit","overview":"Sandra staje przed zadaniem na pozór niemożliwym. Musi przekonać wszystkich ludzi, z którymi pracuje, aby zrezygnowali ze swoich premii. Jeżeli jej się nie powiedzie – ona sama straci pracę. Wspierana przez męża, kobieta wyrusza na spotkania z kolegami i koleżankami z pracy. Ma tylko jeden weekend, by uratować posadę.","popularity":2.8654,"poster_path":"/8ZpMA37iZdy8jvs3Toq67z5xRd7.jpg","release_date":"2014-05-21","softcore":false,"video":false,"vote_average":6.9,"vote_count":1023,"credit_id":"68d1b9d227c236f3c1cd7def","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/hZuFiZJJTKzmP4haYPA6aiRso99.jpg","genre_ids":[53,18,80],"id":340481,"title":"Nieznajoma dziewczyna","original_language":"fr","original_title":"La Fille inconnue","overview":"Lekarka Jenny (Adele Haenel) próbuje nauczyć swojego praktykanta przestrzegania godzin pracy. Nie wie jeszcze, że te same zasady wkrótce zmienią jej życie. Pewnego dnia do drzwi gabinetu puka pewna młoda kobieta. Jenny skończyła już jednak swój dyżur, więc nie przyjmuje chorej. Nazajutrz policja znajduje ciało niedoszłej pacjentki niedaleko kliniki. Jenny ma ogromne wyrzuty sumienia, więc postanawia samodzielnie ustalić tożsamość zmarłej, a także zapewnić jej godny pochówek.","popularity":2.1806,"poster_path":"/dUoTKphxbtKDJPGcubw6IP6D8w5.jpg","release_date":"2016-10-05","softcore":false,"video":false,"vote_average":6.18,"vote_count":433,"credit_id":"68d1b9f432ea51ff01ac8bc8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/y31BYaEd4IEtcUyMqmIoUhvm1OP.jpg","genre_ids":[18],"id":522373,"title":"Młody Ahmed","original_language":"fr","original_title":"Le jeune Ahmed","overview":"Ahmed, który nie wyróżniał się wśród rówieśników, ze zwykłego nastolatka zmienia się w islamskiego ekstremistę, wierzącego w konieczność prowadzenia świętej wojny. Bracia Dardenne, mistrzowie filmowego realizmu, starają się odpowiedzieć na pytanie, czy zindoktrynowana i zagubiona jednostka może wrócić na łono społeczeństwa.","popularity":0.8507,"poster_path":"/l6oPDEJROzR3oVHXJDTkdrzPHFN.jpg","release_date":"2019-05-22","softcore":false,"video":false,"vote_average":6.292,"vote_count":172,"credit_id":"68d1ba1019a93df4e37a4d15","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5BFpmELJKE5cZxtOpGJYAdIRybF.jpg","genre_ids":[18,36,10749],"id":921452,"title":"Kochanica króla Jeanne du Barry","original_language":"fr","original_title":"Jeanne du Barry","overview":"Oparta na faktach historia kochanki francuskiego króla (Johnny Depp jako Ludwik XV) przedstawia losy Jeanne Vaubernier (w tej roli Maïwenn), młodej, ambitnej kobiety z nizin społecznych, która śmiało używa swojej inteligencji i urody, by wspinać się po szczeblach dworskiej hierarchii. Droga z paryskiej ulicy do Wersalu wiedzie przez liczne upokorzenia, przeszkody, groźby i intrygi. „Kochanica króla Jeanne du Barry” to zmysłowa superprodukcja o kobiecie, która ośmieliła się złamać zasady epoki, by sięgnąć po miłość i władzę.","popularity":3.7139,"poster_path":"/csOM9ekSPUjCjHVvsjYd0jFaaL9.jpg","release_date":"2023-05-16","softcore":false,"video":false,"vote_average":6.878,"vote_count":695,"credit_id":"6976a1f17096a8ab1f694a92","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[53,18],"id":1623841,"title":"Fonda","original_language":"fr","original_title":"Fonda","overview":"","popularity":2.4009,"poster_path":"/cUUQoOW0nQxOAkRdaHjkCDBGtdm.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69cd04897a8d317d7dce05e5","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/u2eA9pqi1q3DvevT7RuDuJHxxBT.jpg","genre_ids":[18,53],"id":974950,"title":"Emilia Pérez","original_language":"fr","original_title":"Emilia Pérez","overview":"Budzący postrach przywódca meksykańskiego kartelu przechodzi zmianę płci, aby uciec od prawa i stać się kobietą, jaką zawsze chciał być. Dziesięć lat później ogromnie tęskni za swoimi dziećmi i wraca jako ich ciotka.","popularity":13.4006,"poster_path":"/fko8fTfL6BcAqOUh6BZYUjt4SQP.jpg","release_date":"2024-08-21","softcore":false,"video":false,"vote_average":6.441,"vote_count":2004,"credit_id":"69e6fb1ab55f125477cf4182","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/y1JMqbxHEa95Jg67bgm0F9A35SM.jpg","genre_ids":[18],"id":920647,"title":"Butterfly Jam","original_language":"en","original_title":"Butterfly Jam","overview":"","popularity":3.9045,"poster_path":"/uMzoqNeHwZ9SKqbzwIB2RUOiFSG.jpg","release_date":"2026-10-07","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6a04913c3b4a7bbf7864e46e","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1387504,"title":"Les yeux verts","original_language":"fr","original_title":"Les yeux verts","overview":"","popularity":0.8229,"poster_path":"/huXtt6bsXMqMLNhSaMDMttEGpGb.jpg","release_date":"2026-11-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6a50344f9c73fa373d91084c","department":"Production","job":"Co-Producer"}],"id":56209}