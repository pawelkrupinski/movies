999-11-01","softcore":false,"video":false,"vote_average":10.0,"vote_count":1,"credit_id":"625be840875d1a005110465e","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/b3rDIal5p9EeuAo0S2zguC35F7T.jpg","genre_ids":[18,35],"id":57945,"title":"Mleko ludzkich uczuć","original_language":"fr","original_title":"Le Lait de la tendresse humaine","overview":"Trzydziestoletnia Christelle pracuje w regionie Besançon. Właśnie urodziła córkę, Cendrine, po dwóch synach, Rémim i Cédricu. Christelle z trudem radzi sobie z wstrząsem, jaki niesie ze sobą ten poród. Ucieka z domu. Przygarnia ją sąsiadka z góry, Claire, bibliotekarka. Claire troszczy się o Christelle i słucha jej rad. Jej życie wywraca się do góry nogami. Laurent, mąż Christelle, szuka jej, wypytując jej ojca, matkę, siostrę i przyjaciół.","popularity":0.9398,"poster_path":"/xHQgya5blUynXzLLhkMgQmyJ4ec.jpg","release_date":"2001-09-19","softcore":false,"video":false,"vote_average":5.7,"vote_count":11,"credit_id":"625bebfdd38b58117e155f00","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":504106,"title":"La devinière","original_language":"fr","original_title":"La devinière","overview":"","popularity":0.9109,"poster_path":"/heNVqaE06fXQAGviqvxqvlLSKph.jpg","release_date":"2000-04-01","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"625c0e69d38b5817adc4818d","department":"Production","job":"Line Producer"},{"adult":false,"backdrop_path":"/zrr7IratgVn45WJ0yR5F44DNAi9.jpg","genre_ids":[80,53,35,18],"id":289779,"title":"Vous êtes de la police ?","original_language":"fr","original_title":"Vous êtes de la police ?","overview":"","popularity":0.5881,"poster_path":"/e6q6pLHzyLla1eExOLFst9DjvV9.jpg","release_date":"2007-12-19","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"625c10a2f10a1a15ea5351ed","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[1