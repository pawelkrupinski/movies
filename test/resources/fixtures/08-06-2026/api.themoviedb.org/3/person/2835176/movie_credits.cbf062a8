ore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5f9ae35fb4a5430039381432","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/365MJNDbx4ewOUNDQAe2Vd9FfSs.jpg","genre_ids":[878],"id":758678,"title":"Tomorrow","original_language":"pl","original_title":"Tomorrow","overview":"","popularity":0.5009,"poster_path":"/3il6u5o3fEdR26Hqnhigue4hu2s.jpg","release_date":"2019-09-21","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5f9ae56766a7c30038979c8a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/xQJIFz6TTMCt6h5hdTrDr8zaZeE.jpg","genre_ids":[35],"id":1379458,"title":"Teściowie 3","original_language":"pl","original_title":"Teściowie 3","overview":"Bohaterowie spotykają się z okazji chrztu wnuczki. Wanda i Tadeusz organizują uroczystość, na którą – niechętnie – zapraszają Małgorzatę oraz jej przyjaciółkę, psychoterapeutkę Grażynę. Wydawałoby się, że gorzej już być nie może… Ale do Polski wraca Andrzej i nie jest sam. Chrzciny w teorii – piękna, ciepła, rodzinna uroczystość. W praktyce? Pole bitwy, na którym nikt nie zamierza ustąpić.","popularity":1.3599,"poster_path":"/2oweH2TMqb9KyalKYtJD7c5945i.jpg","release_date":"2025-09-12","softcore":false,"video":false,"vote_average":6.368,"vote_count":19,"credit_id":"67210ef1d1ed017fed2564cc","department":"Directing","job":"Director"}],"id":2835176}