"/Adehm187pA5lU5coIfIIdVOkyte.jpg","genre_ids":[18,10749],"id":15712,"title":"Welcome","original_language":"fr","original_title":"Welcome","overview":"","popularity":1.4374,"poster_path":"/7UmvcGMv3j1wCuTknncmxJfNfXA.jpg","release_date":"2009-03-11","softcore":false,"video":false,"vote_average":7.155,"vote_count":262,"credit_id":"52fe46759251416c75078efd","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/5qSf4Wz3YJgPXFrMlOGzofpivQT.jpg","genre_ids":[18],"id":71179,"title":"Toutes nos envies","original_language":"fr","original_title":"Toutes nos envies","overview":"","popularity":0.9162,"poster_path":"/rOEauICjqF3Lc7ZAxxtLuGSEG0m.jpg","release_date":"2011-11-09","softcore":false,"video":false,"vote_average":6.577,"vote_count":71,"credit_id":"52fe4827c3a368484e0ebb1b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/fIbr7oWorx5rOzdjOiIFtfFUXzp.jpg","genre_ids":[35,18,10402],"id":1000866,"title":"Wysokie i niskie tony","original_language":"fr","original_title":"En fanfare","overview":"Thibaut to światowej sławy dyrygent, który podróżuje po świecie. Kiedy dowiaduje się, że został adoptowany, odkrywa istnienie brata Jimmy'ego, pracownika szkolnej stołówki, który gra na puzonie w orkiestrze dętej na północy Francji. Podobno dzieli ich wszystko oprócz miłości do muzyki. Wykrywając wyjątkowe zdolności muzyczne swojego brata, Thibaut wyznacza sobie misję naprawienia niesprawiedliwości losu. Jimmy zaczyna marzyć o innym życiu...","popularity":3.4935,"poster_path":"/livUPZpqAZMYaK9ndiPWMnHTJ1g.jpg","release_date":"2024-11-27","softcore":false,"video":false,"vote_average":7.273,"vote_count":505,"credit_id":"62d3dfa9f90b19004cb8ea46","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/fIbr7oWorx5rOzdjOiIFtfFUXzp.jpg","genre_ids":[35,18,10402],"id":1000866,"title":"Wysokie i niskie tony","original_language":"fr","original_title":"En fanfare","overview":"Thibaut to światowej sławy dyrygent, który podróżuje po świecie. Kiedy dowiaduje się, że został adoptowany, odkrywa istnienie brata Jimmy'ego, pracownika szkolnej stołówki, który gra na puzonie w orkiestrze dętej na północy Francji. Podobno dzieli ich wszystko oprócz miłości do muzyki. Wykrywając wyjątkowe zdolności muzyczne swojego brata, Thibaut wyznacza sobie misję naprawienia niesprawiedliwości losu. Jimmy zaczyna marzyć o innym życiu...","popularity":3.4935,"poster_path":"/livUPZpqAZMYaK9ndiPWMnHTJ1g.jpg","release_date":"2024-11-27","softcore":false,"video":false,"vote_average":7.273,"vote_count":505,"credit_id":"62d3dfb09f51af0767b90fe4","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[35,18],"id":309339,"title":"Géraldine je t'aime","original_language":"fr","original_title":"Géraldine je t'aime","overview":"","popularity":0.8299,"poster_path":"/f1aTv6MyGfe1zZ7zxZOi06UjQWn.jpg","release_date":"2013-11-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5486f6bd92514176000017d5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/3OODjz1SnzEXuJIVNkVU3MixaWF.jpg","genre_ids":[35,18],"id":919950,"title":"Grazie ragazzi","original_language":"it","original_title":"Grazie ragazzi","overview":"","popularity":1.3666,"poster_path":"/7vykcxsJeVVEcrrmFORF519Di1A.jpg","release_date":"2023-01-12","softcore":false,"video":false,"vote_average":7.043,"vote_count":186,"credit_id":"61c7a258d861af001b10f662","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":364135,"title":"Tête baissée","original_language":"fr","original_title":"Tête baissée","overview":"","popularity":0.9831,"poster_path":"/2fF6Sz4NRDOSjYYeprHSCYUX7DW.jpg","release_date":"2015-10-14","softcore":false,"video":false,"vote_average":5.9,"vote_count":7,"credit_id":"568ede2b9251416b4700374a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/fV8jmUgUHi5HxVmW5MXAhjDRH62.jpg","genre_ids":[18,10749],"id":78210,"title":"Mademoiselle","original_language":"fr","original_title":"Mademoiselle","overview":"Claire Canselier, mężatka z dwójką dzieci, jest przedstawicielką medyczną firmy farmaceutycznej. Pierre Cassini jest improwizatorem, ale nie aktorem. On i dwoje jego przyjaciół, Alice Cohen i Karim Coutard, prowadzą seminaria korporacyjne. Spotykają się na konwencie niedaleko Lyonu. W ciągu 24 godzin, poprzez serię zmarnowanych okazji, odkrywają się i czują do siebie pociąg, co prowadzi do krótkiego, romantycznego spotkania. Ale czy jest ono z góry skazane na porażkę?","popularity":0.6803,"poster_path":"/tuKqpN1QWwAxxgY3eIKl4lhPosK.jpg","release_date":"2001-03-21","softcore":false,"video":false,"vote_average":6.021,"vote_count":24,"credit_id":"56b8fd2ac3a3687476000e50","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/rxcYCxULNWgV67PdMs2VDtqrBGM.jpg","genre_ids":[99],"id":1051718,"title":"Boxer les mots","original_language":"fr","original_title":"Boxer les mots","overview":"","popularity":0.7563,"poster_path":"/y7qtnpZ0sWy9qN0mab8ZW5ezMxn.jpg","release_date":"2022-12-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"637c006339a1a600d519d2b3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8tDr1OZhLPpDAvmFDHjLnrKLOQH.jpg","genre_ids":[18],"id":1062644,"title":"Zielone piekło","original_language":"fr","original_title":"La Promesse verte","overview":"Carole (Alexandra Lamy) wiedzie spokojne życie na zachodzie Francji, gdzie uczy języka angielskiego. Aż do dnia, w którym wszystko się wali: jej syn Martin (Félix Moati), który wyjechał na studia na Borneo, właśnie został aresztowany. Oskarżony o handel narkotykami i skazany na śmierć chłopak jest przede wszystkim świadkiem nadużyć popełnianych związanych z pozyskiwaniem oleju palmowego. Próbując uratować syna, Carole stawia czoła potężnemu lobby, które bronią ekonomicznych i politycznych interesów tak zwanych \"biopaliw\".","popularity":0.73,"poster_path":"/2XHjrd8YJPfkXWMTSdjnpD3DtLO.jpg","release_date":"2024-03-27","softcore":false,"video":false,"vote_average":6.587,"vote_count":63,"credit_id":"639e1dd38ddc3400c6a8e141","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/9W6QGlWLUUaJldhFdg0GRCO8e3c.jpg","genre_ids":[18],"id":407201,"title":"Cessez-le-feu","original_language":"fr","original_title":"Cessez-le-feu","overview":"","popularity":0.8731,"poster_path":"/fZW5XxyoWS03gEguz3dENEJWijk.jpg","release_date":"2017-04-19","softcore":false,"video":false,"vote_average":6.082,"vote_count":55,"credit_id":"578e0767925141540700857f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9W6QGlWLUUaJldhFdg0GRCO8e3c.jpg","genre_ids":[18],"id":407201,"title":"Cessez-le-feu","original_language":"fr","original_title":"Cessez-le-feu","overview":"","popularity":0.8731,"poster_path":"/fZW5XxyoWS03gEguz3dENEJWijk.jpg","release_date":"2017-04-19","softcore":false,"video":false,"vote_average":6.082,"vote_count":55,"credit_id":"578e075e925141188a002c12","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/nX9KhYw8gwOIjeD078wtIPjs0Fd.jpg","genre_ids":[18],"id":2299,"title":"Pomocnik","original_language":"fr","original_title":"L'Équipier","overview":"Mabé (Sandrine Bonnaire) i Yvon Le Guen (Philippe Torreton) mieszkają na małej bretońskiej wyspie Ouessant. Są szczęśliwym i zgodnym małżeństwem. Na wyspę rzadko przybywają nieznajomi, więc kiedy pojawia się nowy latarnik Antoine Cassendi (Grégori Derangére), mieszkańcy traktują go z nieufnością. Yvon jest przełożonym Antoine'a. Mimo początkowej niechęci, długi pobyt na latarni sprawia, że zaczynają się przyjaźnić. Także Mabé okazuje mu sympatię, która z czasem przeradza się w głębsze uczucie. Relacje trójki bohaterów stają się coraz bardziej skomplikowane, więc Antoine wyjeżdża po 2 miesiącach.","popularity":1.002,"poster_path":"/l7fJ1TmyaNVLHBtjz4QbUW5qLVs.jpg","release_date":"2004-11-03","softcore":fal