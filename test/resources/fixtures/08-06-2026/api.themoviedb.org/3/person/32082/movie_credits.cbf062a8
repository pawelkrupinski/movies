{"cast":[{"adult":false,"backdrop_path":"/kgozbffjPkJ4pKgTzvLVLACPvES.jpg","genre_ids":[99],"id":862416,"title":"Ucieczka na Srebrny Glob","original_language":"pl","original_title":"Ucieczka na Srebrny Glob","overview":"Portret reżysera Andrzeja Żuławskiego, jego burzliwego życia zawodowego i miłosnego oraz niespełnionego marzenia o stworzeniu arcydzieła kina science fiction.","popularity":0.8173,"poster_path":"/17Y1rucRmoGl5VOOsBna4gyIM4k.jpg","release_date":"2021-09-05","softcore":false,"video":false,"vote_average":7.2,"vote_count":5,"character":"Self (archive footage)","credit_id":"6171d984a097dc00920e6bca","order":0},{"adult":false,"backdrop_path":"/uP3nXeSH6ZD9L76ycGHH9JmUhIf.jpg","genre_ids":[10752,18,36],"id":149511,"title":"Popioły","original_language":"pl","original_title":"Popioły","overview":"Ekranizacja powieści Stefana Żeromskiego. Akcja filmu rozpoczyna się latem 1798 roku, w chwili, gdy podróżujący po Włoszech książę Gintułt wraca do Polski. Los styka go tu z młodym szlachcicem Rafałem Olbromskim, który zostaje jego sekretarzem. Podróżując wraz z Gintułtem po kraju, Rafał wchodzi w kręgi masonerii. Nawiązuje tragiczny romans z żoną dostojnika loży, by wreszcie wspólnie z poznanym Krzysztofem Cedrą wstąpić do armii Napoleona.","popularity":0.8787,"poster_path":"/t0ytkejwNei7UbArOj8nPs4wC8r.jpg","release_date":"1965-09-25","softcore":false,"video":false,"vote_average":6.667,"vote_count":18,"character":"(uncredited)","credit_id":"625eddf83dd1263749cb5662","order":66},{"adult":false,"backdrop_path":"/hOgw7NAorkYBuUsayq598owknOO.jpg","genre_ids":[18],"id":264003,"title":"Tristesse et beauté","original_language":"fr","original_title":"Tristesse et beauté","overview":"","popularity":0.9674,"poster_path":"/qnS121qilDdWcgcyudJ8YMCAln4.jpg","release_date":"1985-08-28","softcore":false,"video":false,"vote_average":3.5,"vote_count":5,"character":"Hugo Pierjoyre","credit_id":"545fb6b20e0a261fbd0096b5","order":2},{"adult":false,"backdrop_path":"/5nZ0ax5n5k9MogcGX3IxVjlCMRt.jpg","genre_ids":[878,18],"id":27072,"title":"Na Srebrnym Globie","original_language":"pl","original_title":"Na Srebrnym Globie","overview":"Na jakiejś planecie . . . Jeździec przywozi kosmonautom tajemniczy przedmiot, który spadł z nieba. Rozpoznają oni system przekaźnikowy sprzed kilkudziesięciu lat. Schodzą do starej hali komputerów, gdzie odczytują wideo-pamiętnik rozpoczynający się lotem kabiny kosmicznej i rozbiciem się w górach jakiejś planety.","popularity":2.9482,"poster_path":"/r2Mj0Kbpe00y3csBcRJCZ9VFVbn.jpg","release_date":"1989-02-10","softcore":false,"video":false,"vote_average":7.7,"vote_count":178,"character":"Self (uncredited)","credit_id":"6589ec0a5aba32660cbaa6e9","order":26},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":275880,"title":"The Other Side of the Wall: The Making of Possession","original_language":"en","original_title":"The Other Side of the Wall: The Making of Possession","overview":"","popularity":0.4883,"poster_path":"/lOgQRjyUcFrtTyKb1uwiBGkhW4m.jpg","release_date":"2009-04-06","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"character":"Self","credit_id":"56c82c3e9251411742001e97","order":0},{"adult":false,"backdrop_path":"/A5lLdAr0aXu6XqXq35Sb432732J.jpg","genre_ids":[12],"id":204196,"title":"Samson","original_language":"pl","original_title":"Samson","overview":"","popularity":0.6413,"poster_path":"/xF4QU8J4UNFrUyeRi19t9KbkCVX.jpg","release_date":"1961-09-11","softcore":false,"video":false,"vote_average":4.8,"vote_count":12,"character":"Killed Student (uncredited)","credit_id":"595fad1d9251410a590a1da0","order":28},{"adult":false,"backdrop_path":"/yn2oo4nJebeuRj0dktyaT2Push8.jpg","genre_ids":[99,10770],"id":696212,"title":"Żuławski o Żuławskim","original_language":"pl","original_title":"Żuławski o Żuławskim","overview":"","popularity":0.6269,"poster_path":"/aPPq1zSJ7Zay1fapZVXksj6qjIu.jpg","release_date":"2000-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"character":"Self","credit_id":"5ea13d81b7b69d0026447241","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1482169,"title":"Short Life, Long Death: The Making and Un-Making of On The Silver Globe","original_language":"en","original_title":"Short Life, Long Death: The Making and Un-Making of On The Silver Globe","overview":"","popularity":0.8378,"poster_path":"/8qwRcjV2VbURC9gflzQat1mB4oi.jpg","release_date":"2025-05-31","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6827576f5dbcda6de176823d","order":0},{"adult":false,"backdrop_path":"/AkxhKElcgsKqbjFGWh1KrMThBDV.jpg","genre_ids":[99],"id":1496961,"title":"Boris Godounov, une conscience tourmentée","original_language":"fr","original_title":"Boris Godounov, une conscience tourmentée","overview":"","popularity":0.5045,"poster_path":"/t9aqHwjsrkpeHRDuZjwziFl0o2m.jpg","release_date":"2014-11-19","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"self","credit_id":"684adeddf9743db94b3fd86a","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1552327,"title":"Dwa oblicza Andrzeja Zulawskiego","original_language":"pl","original_title":"Dwa oblicza Andrzeja Zulawskiego","overview":"","popularity":0.3758,"poster_path":null,"release_date":"1991-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"68d5ba53a535873c23d3cc07","order":0}],"crew":[{"adult":false,"backdrop_path":"/jqj5GL6OT1QWM6EASYjm3rbR50W.jpg","genre_ids":[18,10749],"id":3476,"title":"Najważniejsze to kochać","original_language":"fr","original_title":"L'Important c'est d'aimer","overview":"Nadine staje przed trudnym wyborem, pozostać w związku z poczciwym acz niezaradnym życiowo mężem czy wdać się w romans z młodym fotografem.","popularity":1.6979,"poster_path":"/vYqTNt1M73svh2pXrTOPuIiKeaP.jpg","release_date":"1975-02-12","softcore":false,"video":false,"vote_average":7.008,"vote_count":131,"credit_id":"52fe4395c3a36847f805f5a1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/zfw3fcF7d4KcWYEvps4zUfl303b.jpg","genre_ids":[27],"id":21484,"title":"Opętanie","original_language":"en","original_title":"Possession","overview":"Po dłuższej nieobecności Marc  powraca do Berlina Zachodniego, gdzie ze zgrozą dowiaduje się od żony, Anny , że ta ma kochanka. Dodatkowo zaniepokojony jej dziwnym zachowaniem wynajmuje detektywa, który ma wyjaśnić sprawę. Okazuje się, że kochankiem Anny jest potwór, bardziej zwierzę niż człowiek. Anna zabija detektywa, to samo czyni z kolejnym, który poszukuje zaginionego kolegi. Marc sam idzie pod wskazany adres. Na miejscu postanawia ukryć ślady zbrodni.","popularity":14.0355,"poster_path":"/A9bnRn05riOKWftvQlLKa2gl51n.jpg","release_date":"1981-05-27","softcore":false,"video":false,"vote_average":7.3,"vote_count":1377,"credit_id":"52fe441bc3a368484e00fd91","department":"Writing","job":"Adaptation"},{"adult":false,"backdrop_path":"/5nZ0ax5n5k9MogcGX3IxVjlCMRt.jpg","genre_ids":[878,18],"id":27072,"title":"Na Srebrnym Globie","original_language":"pl","original_title":"Na Srebrnym Globie","overview":"Na jakiejś planecie . . . Jeździec przywozi kosmonautom tajemniczy przedmiot, który spadł z nieba. Rozpoznają oni system przekaźnikowy sprzed kilkudziesięciu lat. Schodzą do starej hali komputerów, gdzie odczytują wideo-pamiętnik rozpoczynający się lotem kabiny kosmicznej i rozbiciem się w górach jakiejś planety.","popularity":2.9482,"poster_path":"/r2Mj0Kbpe00y3csBcRJCZ9VFVbn.jpg","release_date":"1989-02-10","softcore":false,"video":false,"vote_average":7.7,"vote_count":178,"credit_id":"52fe452bc3a368484e04c3c7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/5nZ0ax5n5k9MogcGX3IxVjlCMRt.jpg","genre_ids":[878,18],"id":27072,"title":"Na Srebrnym Globie","original_language":"pl","original_title":"Na Srebrnym Globie","overview":"Na jakiejś planecie . . . Jeździec przywozi kosmonautom tajemniczy przedmiot, który spadł z nieba. Rozpoznają oni system przekaźnikowy sprzed kilkudziesięciu lat. Schodzą do starej hali komputerów, gdzie odczytują wideo-pamiętnik rozpoczynający się lotem kabiny kosmicznej i rozbiciem się w górach jakiejś planety.","popularity":2.9482,"poster_path":"/r2Mj0Kbpe00y3csBcRJCZ9VFVbn.jpg","release_date":"1989-02-10","softcore":false,"video":false,"vote_average":7.7,"vote_count":178,"credit_id":"52fe452bc3a368484e04c405","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/y9NXfEz8p1IiR8Ug4vpa3MiI8lJ.jpg","genre_ids":[10752,18,27],"id":46799,"title":"Trzecia część nocy","original_language":"pl","original_title":"Trzecia część nocy","overview":"II wojna światowa. Żona, matka i syn Michała zostali zamordowani przez Niemców. Mężczyzna wstępuje do organizacji podziemnej. Jedna z akcji bojowych z udziałem Michała kończy się niepowodzeniem. Z ukrycia jest świadkiem aresztowania podobnego do siebie mężczyzny. Ciężarna żona aresztowanego, Marta, przypomina zabitą Helenę. Kobieta zaczyna rodzić, Michał pomaga przyjść dziecku na świat, a potem traci przytomność. Po jej odzyskaniu okazuje się, że matka i noworodek zniknęli. Michał za wszelką cenę chce odnaleźć Martę.","popularity":1.6247,"poster_path":"/cRHc7JFmWjCtXz3rOfk07zuCyW9.jpg","release_date":"1972-01-04","softcore":false,"video":false,"vote_average":6.984,"vote_count":94,"credit_id":"52fe470dc3a36847f8120ce5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/v1zYiJJYeRoacgQWcJNVjmwauVC.jpg","genre_ids":[18],"id":49979,"title":"Wierność","original_language":"fr","original_title":"La Fidélité","overview":"Fotoreporterka Clelia przyjeżdża do Paryża, gdzie dostaję pracę w jednej z tamtejszych gazet. Jakiś czas później poznaje redaktora książek dla dzieci Cleve'a, który zakochuje się w niej i prosi o rękę. Wszystko byłoby w porządku, gdyby Clelia nie poznała Nemo, szalonego mężczyznę, który jest całkowitym przeciwieństwem Cleve'a. Nie może ona zdecydować się, którego z nich wybrać, jednak w końcu przyjmuje oświadczyny dobrze sytuowanego Cleve'a. Mimo przysięgi wciąż nie może ona zapomnieć o Nemo.","popularity":2.1966,"poster_path":"/ef04eFVWVCZQ6qGFoRmG7PqdJ0.jpg","release_date":"2000-04-05","softcore":false,"video":false,"vote_average":5.807,"vote_count":57,"credit_id":"52fe47b3c3a36847f8143979","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/v1zYiJJYeRoacgQWcJNVjmwauVC.jpg","genre_ids":[18],"id":49979,"title":"Wierność","original_language":"fr","original_title":"La Fidélité","overview":"Fotoreporterka Clelia przyjeżdża do Paryża, gdzie dostaję pracę w jednej z tamtejszych gazet. Jakiś czas później poznaje redaktora książek dla dzieci Cleve'a, który zakochuje się w niej i prosi o rękę. Wszystko byłoby w porządku, gdyby Clelia nie poznała Nemo, szalonego mężczyznę, który jest całkowitym przeciwieństwem Cleve'a. Nie może ona zdecydować się, którego z nich wybrać, jednak w końcu przyjmuje oświadczyny dobrze sytuowanego Cleve'a. Mimo przysięgi wciąż nie może ona zapomnieć o Nemo.","popularity":2.1966,"poster_path":"/ef04eFVWVCZQ6qGFoRmG7PqdJ0.jpg","release_date":"2000-04-05","softcore":false,"video":false,"vote_average":5.807,"vote_count":57,"credit_id":"52fe47b3c3a36847f8143983","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/wXf4G2Urk0Vq42hD2w5mSmW47N8.jpg","genre_ids":[18,10749],"id":73764,"title":"Moje noce są piękniejsze niż wasze dni","original_language":"fr","original_title":"Mes nuits sont plus belles que vos jours","overview":"Tracący pamięć Lucas poznaje aktorkę Blanche. Razem spędzają kilka dni i nocy w nadmorskiej miejscowości.","popularity":1.81,"poster_path":"/ybrHgmo4fOYEXxDcgyckS1SgqKj.jpg","release_date":"1989-04-19","softcore":false,"video":false,"vote_average":6.059,"vote_count":68,"credit_id":"52fe48abc3a368484e104b4d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/t28kCBe0hngvt4ViIsnrwNBrhq8.jpg","genre_ids":[18],"id":70410,"title":"Kobieta publiczna","original_language":"fr","original_title":"La Femme publique","overview":"Niedoświadczona, młoda aktorka zostaje zaproszona do zagrania w filmie na podstawie \"Biesów\" Dostojewskiego. Wkrótce zacierają się jej granice pomiędzy sztuką a rzeczywistością.","popularity":4.4748,"poster_path":"/cIWSdfPkPvfNzPZPJBz8CVCsQSx.jpg","release_date":"1984-06-16","softcore":false,"video":false,"vote_average":5.949,"vote_count":59,"credit_id":"52fe47f6c3a368484e0e2b75","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tW1azZ2j0ObJj4d0QMay30AFNTL.jpg","genre_ids":[18,53],"id":81217,"title":"Szamanka","original_language":"pl","original_title":"Szamanka","overview":"Antropolog Michał  poznaje studentkę AGH - \"Włoszkę\", z którą nawiązuje namiętny i burzliwy romans. W tym samym czasie zostaje wydobyte z bagien znakomicie zachowane ciało szamana żyjącego przed trzema tysiącami lat. Badający zwłoki Michał wpada w mistyczny trans i nawiązuje kontakt z duchem zmarłego...","popularity":1.9391,"poster_path":"/yg3Bs608W9sHuGH5XhR5UKJTLfY.jpg","release_date":"1996-05-10","softcore":false,"video":false,"vote_average":6.1,"vote_count":67,"credit_id":"52fe48019251416c9107cdc5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/4BXnjJ7nutiI1c5BgbuwFvqffRC.jpg","genre_ids":[10402,18,10749],"id":96642,"title":"Błękitna nuta","original_language":"fr","original_title":"La Note bleue","overview":"Andrzej Żuławski opowiada o ostatnich chwilach, które Fryderyk Chopin i George Sand spędzili razem. Akcja rozgrywa się latem 1846 r., w Nohant, dworku należącym do Sand. Gospodyni wyprawia przyjęcie, a wśród gości są m.in. malarz Eugène Delacroix, śpiewaczka operowa Pauline Viardot i rosyjski pisarz Iwan Turgieniew. Długo trwający związek Sand z Chopinem zmierza ku końcowi. Sytuację stara się wykorzystać jej córka, Solange, zakochana w polskim pianiście.","popularity":1.2287,"poster_path":"/z4KQOjV2kW61uRUeHGTu1yvUX3L.jpg","release_date":"1991-06-05","softcore":false,"video":false,"vote_average":5.435,"vote_count":23,"credit_id":"52fe49bb9251416c750d191d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/f3lrCW306jyBkh16QwM5gEtH1kI.jpg","genre_ids":[27,36,18],"id":95043,"title":"Diabeł","original_language":"pl","original_title":"Diabeł","overview":"Styczeń 1793 roku. Wojska pruskie na mocy układów rozbiorowych wkraczają do Wielkopolski. Z klasztoru, w którym żołnierze dokonują rzezi, nieznajomy wyprowadza Jakuba, niedoszłego królobójcę, i młodą zakonnicę. Jakub jest świadkiem ślubu zawieranego przez jego dawną narzeczoną, teraz brzemienną, z jego przyjacielem oraz wyuzdanego aktu miłosnego, po którym dostaje ataku epilepsji. Nieznajomy daje Jakubowi brzytwę mówiąc, że może być Jezusem oczyszczającym świat od zła i grzechu.","popularity":2.1625,"poster_path":"/dKoWmSs6btbp3qKJlhUrp5vU52S.jpg","release_date":"1972-01-01","softcore":false,"video":false,"vote_average":7.31,"vote_count":92,"credit_id":"52fe49749251416c750c88dd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8yHPjRj7xAYEAvtHN8NkzFuVd2N.jpg","genre_ids":[18,80,10749,35],"id":98927,"title":"Narwana miłość","original_language":"fr","original_title":"L'Amour braque","overview":"Micky pragnie odzyskać dawną ukochaną, Mary. Kobietą zauroczony jest też jego nowy przyjaciel Leon, podający się za węgierskiego księcia.","popularity":2.4781,"poster_path":"/ijXqFpUKpO9MWHpKacshV2MT1ww.jpg","release_date":"1985-02-27","softcore":false,"video":false,"vote_average":5.741,"vote_count":54,"credit_id":"52fe4a229251416c750ded11","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7Gn8vZEE31N7h2TzJZONd1lSXiT.jpg","genre_ids":[10402,18,36],"id":99686,"title":"Boris Godounov","original_language":"fr","original_title":"Boris Godounov","overview":"","popularity":0.6919,"poster_path":"/9dOCt1HtJaO7p7QpUUTWfZDY8pX.jpg","release_date":"1989-12-20","softcore":false,"video":false,"vote_average":7.5,"vote_count":14,"credit_id":"52fe4a3c9251416c750e2459","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/A5lLdAr0aXu6XqXq35Sb432732J.jpg","genre_ids":[12],"id":204196,"title":"Samson","original_language":"pl","original_title":"Samson","overview":"","popularity":0.6413,"poster_path":"/xF4QU8J4UNFrUyeRi19t9KbkCVX.jpg","release_date":"1961-09-11","softcore":false,"video":false,"vote_average":4.8,"vote_count":12,"credit_id":"64d52037bf31f201ca8ad970","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/uP3nXeSH6ZD9L76ycGHH9JmUhIf.jpg","genre_ids":[10752,18,36],"id":149511,"title":"Popioły","original_language":"pl","original_title":"Popioły","overview":"Ekranizacja powieści Stefana Żeromskiego. Akcja filmu rozpoczyna się latem 1798 roku, w chwili, gdy podróżujący po Włoszech książę Gintułt wraca do Polski. Los styka go tu z młodym szlachcicem Rafałem Olbromskim, który zostaje jego sekretarzem. Podróżując wraz z Gintułtem po kraju, Rafał wchodzi w kręgi masonerii. Nawiązuje tragiczny romans z żoną dostojnika loży, by wreszcie wspólnie z poznanym Krzysztofem Cedrą wstąpić do armii Napoleona.","popularity":0.8787,"poster_path":"/t0ytkejwNei7UbArOj8nPs4wC8r.jpg","release_date":"1965-09-25","softcore":false,"video":false,"vote_average":6.667,"vote_count":18,"credit_id":"64da49bb7719d700afbf25f2","department":"Directing","job":"First Assistant Director"},{"adult":false,"backdrop_path":"/rBIEG6gKQlTtezNHHAAzHxiXXqD.jpg","genre_ids":[18,10749,10770],"id":264383,"title":"Pavoncello","original_language":"pl","original_title":"Pavoncello","overview":"","popularity":0.5687,"poster_path":"/7rlVxEFEWmfb5n9gwrGwCgLl2px.jpg","release_date":"1967-01-01","softcore":false,"video":false,"vote_average":6.0,"vote_count":8,"credit_id":"5349e01bc3a3682dfe0008c9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lPP0tEvCol4LVr8dJBJ73v3Fv44.jpg","genre_ids":[18,27,10770],"id":264384,"title":"Pieśń triumfującej miłości","original_language":"pl","original_title":"Pieśń triumfującej miłości","overview":"","popularity":0.5388,"poster_path":"/lv6AZMZPS7G7dr0uCMj4Q2zh4Li.jpg","release_date":"1969-05-28","softcore":false,"video":false,"vote_average":6.2,"vote_count":8,"credit_id":"5349e0a30e0a2640b9000a70","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lPP0tEvCol4LVr8dJBJ73v3Fv44.jpg","genre_ids":[18,27,10770],"id":264384,"title":"Pieśń triumfującej miłości","original_language":"pl","original_title":"Pieśń triumfującej miłości","overview":"","popularity":0.5388,"poster_path":"/lv6AZMZPS7G7dr0uCMj4Q2zh4Li.jpg","release_date":"1969-05-28","softcore":false,"video":false,"vote_average":6.2,"vote_count":8,"credit_id":"538c5dfdc3a3687152002921","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/wXf4G2Urk0Vq42hD2w5mSmW47N8.jpg","genre_ids":[18,10749],"id":73764,"title":"Moje noce są piękniejsze niż wasze dni","original_language":"fr","original_title":"Mes nuits sont plus belles que vos jours","overview":"Tracący pamięć Lucas poznaje aktorkę Blanche. Razem spędzają kilka dni i nocy w nadmorskiej miejscowości.","popularity":1.81,"poster_path":"/ybrHgmo4fOYEXxDcgyckS1SgqKj.jpg","release_date":"1989-04-19","softcore":false,"video":false,"vote_average":6.059,"vote_count":68,"credit_id":"53f91863c3a368734f001d23","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/euAyS2Z9VXf0A8F2IOC2SOLZNdA.jpg","genre_ids":[18,35,14],"id":315868,"title":"Kosmos","original_language":"fr","original_title":"Cosmos","overview":"Ostatni film Andrzeja Żuławskiego jest jak artystyczny testament spisany młodzieżowym slangiem. Enfant terrible polskiego kina traktuje literacki pierwowzór Witolda Gombrowicza z właściwą sobie dezynwolturą. Akcja filmowego Kosmosu nie toczy się już w Zakopanem, lecz w zachodniej Europie, a z czasów międzywojnia została przeniesiona do współczesności. Przede wszystkim jednak powieść uważana przez wielu za najmroczniejszą w dorobku Gombrowicza została przekształcona w autentycznie zabawną farsę. Choć mamy do czynienia z ewidentną twórczą zdradą, słynącemu z prowokacji pisarzowi zapewniłaby ona zapewne maksimum satysfakcji. W Kosmosie Żuławski, jak za najlepszych czasów, mknie przez fabułę w szaleńczym tempie, uwodzi nas pięknem pojedynczych kadrów i finezją językowych gier. W historii początkującego pisarza Witolda znajduje także pretekst do podzielenia się z widzem radością płynącą ze snucia opowieści i kreowania ekranowego świata.","popularity":1.2036,"poster_path":"/wwXH9llp4WWhuNN3lcVLBbSWYlm.jpg","release_date":"2015-12-03","softcore":false,"video":false,"vote_average":6.489,"vote_count":93,"credit_id":"54ab1a60c3a3680c21008337","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/euAyS2Z9VXf0A8F2IOC2SOLZNdA.jpg","genre_ids":[18,35,14],"id":315868,"title":"Kosmos","original_language":"fr","original_title":"Cosmos","overview":"Ostatni film Andrzeja Żuławskiego jest jak artystyczny testament spisany młodzieżowym slangiem. Enfant terrible polskiego kina traktuje literacki pierwowzór Witolda Gombrowicza z właściwą sobie dezynwolturą. Akcja filmowego Kosmosu nie toczy się już w Zakopanem, lecz w zachodniej Europie, a z czasów międzywojnia została przeniesiona do współczesności. Przede wszystkim jednak powieść uważana przez wielu za najmroczniejszą w dorobku Gombrowicza została przekształcona w autentycznie zabawną farsę. Choć mamy do czynienia z ewidentną twórczą zdradą, słynącemu z prowokacji pisarzowi zapewniłaby ona zapewne maksimum satysfakcji. W Kosmosie Żuławski, jak za najlepszych czasów, mknie przez fabułę w szaleńczym tempie, uwodzi nas pięknem pojedynczych kadrów i finezją językowych gier. W historii początkującego pisarza Witolda znajduje także pretekst do podzielenia się z widzem radością płynącą ze snucia opowieści i kreowania ekranowego świata.","popularity":1.2036,"poster_path":"/wwXH9llp4WWhuNN3lcVLBbSWYlm.jpg","release_date":"2015-12-03","softcore":false,"video":false,"vote_average":6.489,"vote_count":93,"credit_id":"54ab1a70c3a3682352002652","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/rBIEG6gKQlTtezNHHAAzHxiXXqD.jpg","genre_ids":[18,10749,10770],"id":264383,"title":"Pavoncello","original_language":"pl","original_title":"Pavoncello","overview":"","popularity":0.5687,"poster_path":"/7rlVxEFEWmfb5n9gwrGwCgLl2px.jpg","release_date":"1967-01-01","softcore":false,"video":false,"vote_average":6.0,"vote_count":8,"credit_id":"56149fc992514172d600418d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/f3lrCW306jyBkh16QwM5gEtH1kI.jpg","genre_ids":[27,36,18],"id":95043,"title":"Diabeł","original_language":"pl","original_title":"Diabeł","overview":"Styczeń 1793 roku. Wojska pruskie na mocy układów rozbiorowych wkraczają do Wielkopolski. Z klasztoru, w którym żołnierze dokonują rzezi, nieznajomy wyprowadza Jakuba, niedoszłego królobójcę, i młodą zakonnicę. Jakub jest świadkiem ślubu zawieranego przez jego dawną narzeczoną, teraz brzemienną, z jego przyjacielem oraz wyuzdanego aktu miłosnego, po którym dostaje ataku epilepsji. Nieznajomy daje Jakubowi brzytwę mówiąc, że może być Jezusem oczyszczającym świat od zła i grzechu.","popularity":2.1625,"poster_path":"/dKoWmSs6btbp3qKJlhUrp5vU52S.jpg","release_date":"1972-01-01","softcore":false,"video":false,"vote_average":7.31,"vote_count":92,"credit_id":"55fd098ec3a3681328000189","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/7Gn8vZEE31N7h2TzJZONd1lSXiT.jpg","genre_ids":[10402,18,36],"id":99686,"title":"Boris Godounov","original_language":"fr","original_title":"Boris Godounov","overview":"","popularity":0.6919,"poster_path":"/9dOCt1HtJaO7p7QpUUTWfZDY8pX.jpg","release_date":"1989-12-20","softcore":false,"video":false,"vote_average":7.5,"vote_count":14,"credit_id":"56ce2822c3a368777c000128","department":"Writing","job":"Scenario Writer"},{"adult":false,"backdrop_path":"/t28kCBe0hngvt4ViIsnrwNBrhq8.jpg","genre_ids":[18],"id":70410,"title":"Kobieta publiczna","original_language":"fr","original_title":"La Femme publique","overview":"Niedoświadczona, młoda aktorka zostaje zaproszona do zagrania w filmie na podstawie \"Biesów\" Dostojewskiego. Wkrótce zacierają się jej granice pomiędzy sztuką a rzeczywistością.","popularity":4.4748,"poster_path":"/cIWSdfPkPvfNzPZPJBz8CVCsQSx.jpg","release_date":"1984-06-16","softcore":false,"video":false,"vote_average":5.949,"vote_count":59,"credit_id":"56cf7bf29251413e6a003c5b","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/8yHPjRj7xAYEAvtHN8NkzFuVd2N.jpg","genre_ids":[18,80,10749,35],"id":98927,"title":"Narwana miłość","original_language":"fr","original_title":"L'Amour braque","overview":"Micky pragnie odzyskać dawną ukochaną, Mary. Kobietą zauroczony jest też jego nowy przyjaciel Leon, podający się za węgierskiego księcia.","popularity":2.4781,"poster_path":"/ijXqFpUKpO9MWHpKacshV2MT1ww.jpg","release_date":"1985-02-27","softcore":false,"video":false,"vote_average":5.741,"vote_count":54,"credit_id":"56cf79fbc3a3681e50003294","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/tpycIXVcWpesXqTnOa0RQ3cLHLT.jpg","genre_ids":[18,10749],"id":97844,"title":"Maladie d'amour","original_language":"fr","original_title":"Maladie d'amour","overview":"","popularity":0.9117,"poster_path":"/wbIYolgOrrClsIg5QinODJe8myK.jpg","release_date":"1987-09-30","softcore":false,"video":false,"vote_average":5.077,"vote_count":13,"credit_id":"56e2f6d4c3a3685aa40000a2","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/4BXnjJ7nutiI1c5BgbuwFvqffRC.jpg","genre_ids":[10402,18,10749],"id":96642,"title":"Błękitna nuta","original_language":"fr","original_title":"La Note bleue","overview":"Andrzej Żuławski opowiada o ostatnich chwilach, które Fryderyk Chopin i George Sand spędzili razem. Akcja rozgrywa się latem 1846 r., w Nohant, dworku należącym do Sand. Gospodyni wyprawia przyjęcie, a wśród gości są m.in. malarz Eugène Delacroix, śpiewaczka operowa Pauline Viardot i rosyjski pisarz Iwan Turgieniew. Długo trwający związek Sand z Chopinem zmierza ku końcowi. Sytuację stara się wykorzystać jej córka, Solange, zakochana w polskim pianiście.","popularity":1.2287,"poster_path":"/z4KQOjV2kW61uRUeHGTu1yvUX3L.jpg","release_date":"1991-06-05","softcore":false,"video":false,"vote_average":5.435,"vote_count":23,"credit_id":"56e965a49251414a4d00012f","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/zfw3fcF7d4KcWYEvps4zUfl303b.jpg","genre_ids":[27],"id":21484,"title":"Opętanie","original_language":"en","original_title":"Possession","overview":"Po dłuższej nieobecności Marc  powraca do Berlina Zachodniego, gdzie ze zgrozą dowiaduje się od żony, Anny , że ta ma kochanka. Dodatkowo zaniepokojony jej dziwnym zachowaniem wynajmuje detektywa, który ma wyjaśnić sprawę. Okazuje się, że kochankiem Anny jest potwór, bardziej zwierzę niż człowiek. Anna zabija detektywa, to samo czyni z kolejnym, który poszukuje zaginionego kolegi. Marc sam idzie pod wskazany adres. Na miejscu postanawia ukryć ślady zbrodni.","popularity":14.0355,"poster_path":"/A9bnRn05riOKWftvQlLKa2gl51n.jpg","release_date":"1981-05-27","softcore":false,"video":false,"vote_average":7.3,"vote_count":1377,"credit_id":"58a61a079251413466000317","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/zfw3fcF7d4KcWYEvps4zUfl303b.jpg","genre_ids":[27],"id":21484,"title":"Opętanie","original_language":"en","original_title":"Possession","overview":"Po dłuższej nieobecności Marc  powraca do Berlina Zachodniego, gdzie ze zgrozą dowiaduje się od żony, Anny , że ta ma kochanka. Dodatkowo zaniepokojony jej dziwnym zachowaniem wynajmuje detektywa, który ma wyjaśnić sprawę. Okazuje się, że kochankiem Anny jest potwór, bardziej zwierzę niż człowiek. Anna zabija detektywa, to samo czyni z kolejnym, który poszukuje zaginionego kolegi. Marc sam idzie pod wskazany adres. Na miejscu postanawia ukryć ślady zbrodni.","popularity":14.0355,"poster_path":"/A9bnRn05riOKWftvQlLKa2gl51n.jpg","release_date":"1981-05-27","softcore":false,"video":false,"vote_average":7.3,"vote_count":1377,"credit_id":"58a61a39c3a368168c000362","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/vGfM3PWJq17bypFrJwPOUxIYeQv.jpg","genre_ids":[53,9648,10752,80],"id":42700,"title":"Noc Generałów","original_language":"en","original_title":"The Night of the Generals","overview":"Zabójstwo prostytutki w nazistowskiej i okupowanej Warszawie podejmuje major Wehrmachtu Grau (Omar Sharif). W śledztwie dowody wskazują, na jednego z trzech wysokich rangą generałów. Poszlaka prowadziła z Warszawy do Paryża, prosto do 1944 roku, do spisku przeciwko Hitlerowi. Sprawa majora nie została zakończona, aż do 1965 roku, kiedy to prawdziwy zabójca został doprowadzony przed sąd.","popularity":3.0985,"poster_path":"/jsjt64jVSFAqjkUqQUfdWJdDCot.jpg","release_date":"1967-01-29","softcore":false,"video":false,"vote_average":6.8,"vote_count":184,"credit_id":"661ebf3fecaef50149f88b48","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/y9NXfEz8p1IiR8Ug4vpa3MiI8lJ.jpg","genre_ids":[10752,18,27],"id":46799,"title":"Trzecia część nocy","original_language":"pl","original_title":"Trzecia część nocy","overview":"II wojna światowa. Żona, matka i syn Michała zostali zamordowani przez Niemców. Mężczyzna wstępuje do organizacji podziemnej. Jedna z akcji bojowych z udziałem Michała kończy się niepowodzeniem. Z ukrycia jest świadkiem aresztowania podobnego do siebie mężczyzny. Ciężarna żona aresztowanego, Marta, przypomina zabitą Helenę. Kobieta zaczyna rodzić, Michał pomaga przyjść dziecku na świat, a potem traci przytomność. Po jej odzyskaniu okazuje się, że matka i noworodek zniknęli. Michał za wszelką cenę chce odnaleźć Martę.","popularity":1.6247,"poster_path":"/cRHc7JFmWjCtXz3rOfk07zuCyW9.jpg","release_date":"1972-01-04","softcore":false,"video":false,"vote_average":6.984,"vote_count":94,"credit_id":"66a3eb87ba2628ba16ad4a95","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/jqj5GL6OT1QWM6EASYjm3rbR50W.jpg","genre_ids":[18,10749],"id":3476,"title":"Najważniejsze to kochać","original_language":"fr","original_title":"L'Important c'est d'aimer","overview":"Nadine staje przed trudnym wyborem, pozostać w związku z poczciwym acz niezaradnym życiowo mężem czy wdać się w romans z młodym fotografem.","popularity":1.6979,"poster_path":"/vYqTNt1M73svh2pXrTOPuIiKeaP.jpg","release_date":"1975-02-12","softcore":false,"video":false,"vote_average":7.008,"vote_count":131,"credit_id":"5ca01b38c3a368734482d0f2","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/iZMiNFaaVigh9HNal3fTasmuQAH.jpg","genre_ids":[18],"id":618221,"title":"Mowa ptaków","original_language":"pl","original_title":"Mowa ptaków","overview":"Tytułowa mowa ptaków jest językiem, jakim posługują się wykluczeni z agresywnej, hałaśliwej większości: dręczony przez dzieci nauczyciel historii, wyrzucony z pracy polonista, trędowaty kompozytor, dziewczyna sprzątająca w domu bankiera, szpotawa kwiaciarka i zafascynowana kinem uczennica. Zepchnięci na out przez reprodukujący bezmyślność system, przez skandujące „Nie-na-wi-dzę! Nie-na-wi-dzę!” stadionowe bandy nazioli; na swoją obronę mają tylko ironię, kwiaty i cytaty z klasyków","popularity":1.6321,"poster_path":"/p537XYJ241MJqMpnBhjuXxi9jv6.jpg","release_date":"2019-09-27","softcore":false,"video":false,"vote_average":4.5,"vote_count":13,"credit_id":"5d398937ab68496bf785b0f6","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/uJlc4aNPF3Y8yAqahJTKBwgwPVW.jpg","genre_ids":[18,10749],"id":8773,"title":"Miłość dwudziestolatków","original_language":"fr","original_title":"L'Amour à vingt ans","overview":"Film nowelowy. Poza nowelą polską zawiera także nowele: francuską w reżyserii Françoisa Truffauta; włoską w reżyserii Renzo Rosselliniego; niemiecką w reżyserii Marcela Ophülsa i japońską w reżyserii Shintarô Ishihary.","popularity":0.9326,"poster_path":"/gNzLjEuxtV8yzyjeZ572QKFC7SN.jpg","release_date":"1962-06-22","softcore":false,"video":false,"vote_average":6.722,"vote_count":54,"credit_id":"5e1a44f05c5634001382f553","department":"Directing","job":"Second Unit Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":716153,"title":"La Sorcière","original_language":"fr","original_title":"La Sorcière","overview":"","popularity":1.2119,"poster_path":null,"release_date":"1958-12-01","softcore":false,"video":false,"vote_average":3.5,"vote_count":2,"credit_id":"5ee91acaafa1b00022c4cf55","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":716153,"title":"La Sorcière","original_language":"fr","original_title":"La Sorcière","overview":"","popularity":1.2119,"poster_path":null,"release_date":"1958-12-01","softcore":false,"video":false,"vote_average":3.5,"vote_count":2,"credit_id":"5ee91ad568b7660023bab3d4","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/vfDtefTizhdyT3Qhj649QcW80d4.jpg","genre_ids":[18,27,53],"id":1134748,"title":"Possession: Kerasukan","original_language":"id","original_title":"Possession: Kerasukan","overview":"","popularity":1.0701,"poster_path":"/rdUGzZnY97TbxEM78eO5rHr6Ap2.jpg","release_date":"2024-05-08","softcore":false,"video":false,"vote_average":6.0,"vote_count":7,"credit_id":"66e25bec0000000000950bb2","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":"/iZMiNFaaVigh9HNal3fTasmuQAH.jpg","genre_ids":[18],"id":618221,"title":"Mowa ptaków","original_language":"pl","original_title":"Mowa ptaków","overview":"Tytułowa mowa ptaków jest językiem, jakim posługują się wykluczeni z agresywnej, hałaśliwej większości: dręczony przez dzieci nauczyciel historii, wyrzucony z pracy polonista, trędowaty kompozytor, dziewczyna sprzątająca w domu bankiera, szpotawa kwiaciarka i zafascynow