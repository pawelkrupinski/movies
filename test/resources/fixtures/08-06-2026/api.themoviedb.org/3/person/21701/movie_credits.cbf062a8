{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[10749,18,14],"id":1184877,"title":"Goodbye, Casanova","original_language":"en","original_title":"Goodbye, Casanova","overview":"","popularity":0.6595,"poster_path":"/4c4Nx9NltqrtK2NWsNYEshjMSho.jpg","release_date":"2000-01-01","softcore":false,"video":false,"vote_average":8.0,"vote_count":1,"character":"Priest","credit_id":"679d29aaebb996240326103a","order":17}],"crew":[{"adult":false,"backdrop_path":"/tYvVy9fZWkvWHiNe8qzXDGvvMIt.jpg","genre_ids":[27],"id":39171,"title":"Haunted Forest","original_language":"en","original_title":"Haunted Forest","overview":"","popularity":0.6607,"poster_path":"/x6AqBfOh10YRkXWXryYzztJEa3M.jpg","release_date":"2007-06-27","softcore":false,"video":false,"vote_average":3.738,"vote_count":21,"credit_id":"52fe46ff9251416c91066dbb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tYvVy9fZWkvWHiNe8qzXDGvvMIt.jpg","genre_ids":[27],"id":39171,"title":"Haunted Forest","original_language":"en","original_title":"Haunted Forest","overview":"","popularity":0.6607,"poster_path":"/x6AqBfOh10YRkXWXryYzztJEa3M.jpg","release_date":"2007-06-27","softcore":false,"video":false,"vote_average":3.738,"vote_count":21,"credit_id":"52fe46ff9251416c91066dc1","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/k4Cw6NeWhOArl4Zv3LP6HC6m2tp.jpg","genre_ids":[27,878,53],"id":122372,"title":"Po drugiej stronie trumny","original_language":"en","original_title":"The Ghostmaker","overview":"Młody student Kyle zarabia ekstra pieniądze, sprzątając domy innych. Pewnego razu podczas pracy napotyka w piwnicy na starożytną trumnę. Myśląc, że może zarobić na niej łatwą kasę, zabiera ją do siebie. Okazuje się, że nie jest to zwykła trumna, gdyż posiada mechaniczne przekładnie i ukrytą wewnątrz pozytywkę. Kyle wraz z grupą przyjaciół starają się dowiedzieć czegoś więcej o tajemniczym znalezisku. Wkrótce odkrywają, że skrzynia zbudowana została w XV w. przez człowieka zwanego Rzemieślnikiem Diabła, który zafascynowany śmiercią i urządzeniami tortur, dzięki \"maszynie\" opuścił swe ciało i żył jako duch. Zainteresowani historią studenci, postanawiają również doświadczyć tego uczucia, ale początkowo niewinne zabawy szybko zmieniają się w przerażający flirt ze śmiercią.","popularity":1.2347,"poster_path":"/lWDX11KWm3Sq2FGs7XUBXeW5fgm.jpg","release_date":"2011-08-01","softcore":false,"video":false,"vote_average":5.273,"vote_count":88,"credit_id":"52fe4a7cc3a368484e155ff1","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/k4Cw6NeWhOArl4Zv3LP6HC6m2tp.jpg","genre_ids":[27,878,53],"id":122372,"title":"Po drugiej stronie trumny","original_language":"en","original_title":"The Ghostmaker","overview":"Młody student Kyle zarabia ekstra pieniądze, sprzątając domy innych. Pewnego razu podczas pracy napotyka w piwnicy na starożytną trumnę. Myśląc, że może zarobić na niej łatwą kasę, zabiera ją do siebie. Okazuje się, że nie jest to zwykła trumna, gdyż posiada mechaniczne przekładnie i ukrytą wewnątrz pozytywkę. Kyle wraz z grupą przyjaciół starają się dowiedzieć czegoś więcej o tajemniczym znalezisku. Wkrótce odkrywają, że skrzynia zbudowana została w XV w. przez człowieka zwanego Rzemieślnikiem Diabła, który zafascynowany śmiercią i urządzeniami tortur, dzięki \"maszynie\" opuścił swe ciało i żył jako duch. Zainteresowani historią studenci, postanawiają również doświadczyć tego uczucia, ale początkowo niewinne zabawy szybko zmieniają się w przerażający flirt ze śmiercią.","popularity":1.2347,"poster_path":"/lWDX11KWm3Sq2FGs7XUBXeW5fgm.jpg","release_date":"2011-08-01","softcore":false,"video":false,"vote_average":5.273,"vote_count":88,"credit_id":"52fe4a7cc3a368484e155feb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/qyOO0dgss0oeUYFPWbbdALDgOSm.jpg","genre_ids":[28,12,16,14,878],"id":2114,"title":"Final Fantasy. Wojna dusz","original_language":"en","original_title":"Final Fantasy: The Spirits Within","overview":"Jest rok 2065. Ziemię opanowały istoty z kosmosu i rodzaj ludzki staje w obliczu całkowitej zagłady. Za namową swego mentora, szanowanego doktora Sida, młoda lekarka - naukowiec Aki Ross, którą nawiedzają niezwykłe sny, postanawia zebrać osiem mitycznych dusz. Ma nadzieję, że z ich pomocą pokona najeźdźców i zapobiegnie katastrofie. Wspomagana przez żołnierzy z elitarnego szwadronu, Aki musi uchronić Ziemię przed unicestwieniem i sprawić, by ziściły się najgłębiej skrywane marzenia - Final Fantasy. FINAL FANTASY to film wykorzystujący najnowocześniejsze techniki animacji komputerowej, zrealizowany przez twórców bijącej rekordy popularności gry komputerowej.","popularity":5.8762,"poster_path":"/47b1EwFqqSWxYna7NtUM7iML4oT.jpg","release_date":"2001-07-02","softcore":false,"video":false,"vote_average":6.204,"vote_count":1629,"credit_id":"550aead392514146a000180a","department":"Art","job":"Production Design"},{"adult":false,"backdrop_path":"/mTupUmnuwwAyA0CNqpwaZn5mqjk.jpg","genre_ids":[28,27,53,10752,14],"id":697799,"title":"WarHunt. Demony wojny","original_language":"en","original_title":"WarHunt","overview":"1945. Amerykański wojskowy samolot transportowy traci kontrolę i gwałtownie rozbija się za liniami wroga w środku niemieckiego czarnego lasu. Major Johnson wysyła oddział swoich najodważniejszych żołnierzy na misję ratunkową, aby odzyskać ściśle tajne materiały przewożone przez samolot, dowodzoną przez sierżantów Brewera i Walsha. Wkrótce odkrywają powieszonych nazistowskich żołnierzy i inne martwe ciała noszące starożytne, magiczne symbole. Nagle ich kompasy zawodzą, ich percepcje skręcają się i oddalanie się od grupy prowadzi do głębokiego horroru, gdy zostają zaatakowani przez potężną, nadprzyrodzoną siłę.muszą stawić czoła sabatowi czarownic.","popularity":1.9938,"poster_path":"/6bRkt3A2Drr6AnR9lZttnP1TKlo.jpg","release_date":"2022-01-21","softcore":false,"video":false,"vote_average":4.99,"vote_count":103,"credit_id":"61b369f374d6c000400f939e","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/mTupUmnuwwAyA0CNqpwaZn5mqjk.jpg","genre_ids":[28,27,53,10752,14],"id":697799,"title":"WarHunt. Demony wojny","original_language":"en","original_title":"WarHunt","overview":"1945. Amerykański wojskowy samolot transportowy traci kontrolę i gwałtownie rozbija się za liniami wroga w środku niemieckiego czarnego lasu. Major Johnson wysyła oddział swoich najodważniejszych żołnierzy na misję ratunkową, aby odzyskać ściśle tajne materiały przewożone przez samolot, dowodzoną przez sierżantów Brewera i Walsha. Wkrótce odkrywają powieszonych nazistowskich żołnierzy i inne martwe ciała noszące starożytne, magiczne symbole. Nagle ich kompasy zawodzą, ich percepcje skręcają się i oddalanie się od grupy prowadzi do głębokiego horroru, gdy zostają zaatakowani przez potężną, nadprzyrodzoną siłę.muszą stawić czoła sabatowi czarownic.","popularity":1.9938,"poster_path":"/6bRkt3A2Drr6AnR9lZttnP1TKlo.jpg","release_date":"2022-01-21","softcore":false,"video":false,"vote_average":4.99,"vote_count":103,"credit_id":"61b369e265686e008f26e7f5","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/ekZUWo5XtSrfe10RKWrL0YKkq9b.jpg","genre_ids":[9648,53,80],"id":1043565,"title":"Naśladowca","original_language":"en","original_title":"Mindcage","overview":"W tym wciągającym thrillerze detektywi Jake Doyle i Mary Kelly proszą o pomoc uwięzionego seryjnego mordercę o imieniu Artysta, gdy jego naśladowca atakuje. Podczas gdy Mary szuka wskazówek w genialnej, ale pokręconej psychice Artysty, zostają wciągnięci w diabelską grę w kotka i myszkę, ścigając się z czasem, aby być o krok przed Artystą i jego naśladowcą.","popularity":4.2539,"poster_path":"/swpgDCGk0NSRiqWRi1sZPGzzLNn.jpg","release_date":"2022-12-16","softcore":false,"video":false,"vote_average":5.908,"vote_count":434,"credit_id":"6362baaa0c3ec80090b62ded","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8vQBXqDbb30qNpBcNYwTesSg75.jpg","genre_ids":[878,12,28],"id":1927,"title":"Hulk","original_language":"en","original_title":"Hulk","overview":"Eric Bana \"Helikopter w ogniu\" wciela się w postać naukowca Bruce'a Bannera, który w wyniku nieudanego eksperymentu przeistacza się w niezwykłego zielonego demona. Bana gra zarówno postać naukowca jak i stworzonego przez Industrial Light and Magic nadczłowieka Hulka. Zdobywczyni Oscara Jennifer Connelly \"Piękny umysł\" wcieliła się w naukowca, której niestety przypadkiem udało się uwolnić Hulka. Nick Nolte \"Cienka czerwona linia\" gra ojca Bruce'a, a Sam Elliot \"Ukryta prawda\" odtwarza postać agenta top-secret.","popularity":15.6034,"poster_path":"/UllIft2jLSBaay3zQyMV4GNdfy.jpg","release_date":"2003-06-19","softcore":false,"video":false,"vote_average":5.589,"vote_count":6355,"credit_id":"56f2fef1c3a3681cc9000081","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":"/i0M3a8Z2hfj5Oj4msArajhLjGvV.jpg","genre_ids":[12,35,10751],"id":11774,"title":"Lemony Snicket: Seria niefortunnych zdarzeń","original_language":"en","original_title":"Lemony Snicket's A Series of Unfortunate Events","overview":"Jest to ekranizacja cieszącej się popularnością serii książek autorstwa Daniela Handlera. Na skutek tragicznego pożaru trójka nadzwyczajnie zdolnych i uroczych dzieci Baudelaire - Wioletka (Emily Browning), Klaus (Liam Aiken) i Słoneczko (Shelby oraz Kara Hoffman) - traci dom oraz oboje rodziców. Sieroty trafiają do odrażającego Hrabiego Olafa (Jim Carrey). Ten tylko czyha na fortunę Baudelairów, która ma przejść w ręce najstarszej córki po jej dojściu do pełnoletności. Dzieci rozpoczynają niebezpieczne i pełne niefortunnych zdarzeń życie, tak inne od tego, które wiodły przed pożarem w domu z rodzicami.","popularity":8.9081,"poster_path":"/yMGLyvMrUORpUZoEJ8HDzX06bYX.jpg","release_date":"2004-12-16","softcore":false,"video":false,"vote_average":6.823,"vote_count":5345,"credit_id":"58851389c3a36806390229b4","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":"/oVp4NyyOqVPKrv5PBA7Sjwoh09S.jpg","genre_ids":[28,27,14],"id":9946,"title":"I stanie się koniec","original_language":"en","original_title":"End of Days","overview":"W 1979 r. w Nowym Jorku przychodzi na świat Christine York, która została wybrana przez szatana, by dać życie jego synowi. Dwadzieścia lat później, w ostatnich dniach grudnia 1999 r., w Nowym Jorku pojawia się książę ciemności. Jego przybycia wyczekiwali członkowie sekty od 20 lat sprawujący nadzór nad Christine. Tymczasem na ślad wybranki szatana przypadkowo wpada były funkcjonariusz policji - Jericho. By uratować dziewczynę i ocalić ludzkość od władzy antychrysta, musi ją odnaleźć, zanim diabeł ją posiądzie w ostatniej godzinie tysiąclecia.","popularity":9.8762,"poster_path":"/8XAKjhVVGJSGWwD1x1QYxdAq4Yk.jpg","release_date":"1999-11-24","softcore":false,"video":false,"vote_average":6.1,"vote_count":2103,"credit_id":"58b5e82cc3a36805980002fa","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":"/nJi4xuQmMKkgxgZmyHbH5ON3NaN.jpg","genre_ids":[878,28,53],"id":929,"title":"Godzilla","original_language":"en","original_title":"Godzilla","overview":"W głębi dżungli Południowego Pacyfiku eksplozja nuklearna powołuje do życia niezwykłą istotę. Przez dziesiątki lat pozostawała w ukryciu, teraz pokaże się światu w całej swej okazałości. Jest najsłynniejszym potworem w historii kina, ma stopę wielkości autobusu, ogon długości ratuszowej wieży i siłę, której nikt nie dorówna.","popularity":9.3771,"poster_path":"/yWTH92WV99RuhculoeUiT5ctVOn.jpg","release_date":"1998-05-20","softcore":false,"video":false,"vote_average":5.653,"vote_count":4295,"credit_id":"5910dd91c3a36864fc03733c","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":"/60qjADBGGjgFLcYSIG5zaPlxUQk.jpg","genre_ids":[878,27],"id":455551,"title":"Zanosi się na Burzę","original_language":"en","original_title":"The Recall","overview":"Piątka przyjaciół wyjeżdża na weekend do odosobnionego domku nad jeziorem. Przebywając z dala od cywilizacji, nie mają pojęcia, że dziwne zjawiska na niebie, które zauważają, to nie anomalie pogodowe, a zapowiedź inwazji obcych. Gdy wreszcie orientują się, co się dzieje - jest już za późno - zostali zauważeni. Czy zostaną porwani przez kosmitów tak jak i wielu innych ludzi? A może to właśnie oni i tajemniczy Łowca (Wesley Snipes) zdołają ocalić świat przed zagładą?","popularity":3.3614,"poster_path":"/A2sQAzHavtot2brA42pHXKgf3ww.jpg","release_date":"2017-06-02","softcore":false,"video":false,"vote_average":4.654,"vote_count":368,"credit_id":"59466aab9251413ff402719e","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/bumIpNTKmLY380bruTgIDTrXfpZ.jpg","genre_ids":[14,28,35],"id":9593,"title":"Bohater ostatniej akcji","original_language":"en","original_title":"Last Action Hero","overview":"Sierżant Jack Slater (Arnold Schwarzenegger) jest największym bohaterem wielkiego ekranu. Jego fikcyjnym światem rządzą żelazne reguły: stróżowi prawa nigdy nie kończy się amunicja, a dobro zawsze zwycięża zło. Pewnego dnia porządek tego świata zostaje zakłócony, kiedy za sprawą czarodziejskiego biletu jedenastoletni Danny Madigan (Austin O'Brien), wielbiciel Slatera, wyskakuje z  fotela w kinie i ląduje w filmie. U boku swego idola chłopiec przeżywa najwspanialsze przygody, ale czarodziejski bilet wpada w ręce kinowych łotrów, którzy uciekają do rzeczywistości. Slater i Danny są zmuszeni opuścić fikcyjne Los Angeles i przenieść się do prawdziwego Nowego Jorku w którym uderzenie pięścią boli, a kule mogą zabijać. Slater obdarty z magii kina, staje przed największym wyzwaniem: musi udowodnić, że jest prawdziwym bohaterem z krwi i kości.","popularity":8.3117,"poster_path":"/zg5zvE9TcgfXisKvfQ9BF6Xegfv.jpg","release_date":"1993-06-18","softcore":false,"video":false,"vote_average":6.48,"vote_count":3052,"credit_id":"59a08f459251417793019fd0","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1290439,"title":"White Shoe","original_language":"en","original_title":"White Shoe","overview":"","popularity":0.2597,"poster_path":"/kCwunrqjRGKyav3ufZtzA4JWHux.jpg","release_date":"2013-04-18","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6643a3dcb11d71a487710863","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[36,18],"id":1306363,"title":"Starlight","original_language":"en","original_title":"Starlight","overview":"","popularity":0.3754,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6672054af086d8a7ab2a3aa9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[36,18],"id":1306363,"title":"Starlight","original_language":"en","original_title":"Starlight","overview":"","popularity":0.3754,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"66720540e63b47357890b106","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/m8t7K3LcAY7bpyQ7iQ5kGsrcjnh.jpg","genre_ids":[14,53,9648,27],"id":2668,"title":"Jeździec bez głowy","original_language":"en","original_title":"Sleepy Hollow","overview":"Horror opowiada historię Ichaboda Crane'a, młodego policjanta (w opowiadaniu Irvinga Crane jest nauczycielem), który przybył do Sleepy Hollow w celu rozwiązania sprawy kilku morderstw, które, jak twierdzą mieszkający w miasteczku ludzie, są wykonywane przez Jeźdźca Bez Głowy. Crane nie wierzy w siły nadprzyrodzone i postanawia udowodnić swoje racje mieszkańcom, a co więcej – odkryć, kto jest owym mordercą. W niedługim czasie przekonuje się jednak, że w opowieściach ludności Sleepy Hollow jest sporo prawdy.","popularity":13.5252,"poster_path":"/fHPyfI5h7LIzHG22FfT1int6ll7.jpg","release_date":"1999-11-19","softcore":false,"video":false,"vote_average":7.2,"vote_count":7470,"credit_id":"5afb59cf0e0a263b9300fd6c","department":"Art","job":"Conceptual Illustrator"},{"adult":false,"backdrop_path":"/60qjADBGGjgFLcYSIG5zaPlxUQk.jpg","genre_ids":[878,27],"id":455551,"title":"Zanosi się na Burzę","original_language":"en","original_title":"The Recall","overview":"Piątka przyjaciół wyjeżdża na weekend do odosobnionego domku nad jeziorem. Przebywając z dala od cywilizacji, nie mają pojęcia, że dziwne zjawiska na niebie, które zauważają, to nie anomalie pogodowe, a zapowiedź inwazji obcych. Gdy wreszcie orientują się, co się dzieje - jest już za późno - zostali zauważeni. Czy zostaną porwani przez kosmitów tak jak i wielu innych ludzi? A może to właśnie oni i tajemniczy Łowca (Wesley Snipes) zdołają ocalić świat przed zagładą?","popularity":3.3614,"poster_path":"/A2sQAzHavtot2brA42pHXKgf3ww.jpg","release_date":"2017-06-02","softcore":false,"video":false,"vote_average":4.654,"vote_count":368,"credit_id":"5ea731d6bb070d001ca6fafe","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/mTupUmnuwwAyA0CNqpwaZn5mqjk.jpg","genre_ids":[28,27,53,10752,14],"id":697799,"title":"WarHunt. Demony wojny","original_language":"en","original_title":"WarHunt","overview":"1945. Amerykański wojskowy samolot transportowy traci kontrolę i gwałtownie rozbija się za liniami wroga w środku niemieckiego czarnego lasu. Major Johnson wysyła oddział swoich najodważniejszych żołnierzy na misję ratunkową, aby odzyskać ściśle tajne materiały przewożone przez samolot, dowodzoną przez sierżantów Brewera i Walsha. Wkrótce odkrywają powieszonych nazistowskich żołnierzy i inne martwe ciała noszące starożytne, magiczne symbole. Nagle ich kompasy zawodzą, ich percepcje skręcają się i oddalanie się od grupy prowadzi do głębokiego horroru, gdy zostają zaatakowani przez potężną, nadprzyrodzoną siłę.muszą stawić czoła sabatowi czarownic.","popularity":1.9938,"poster_path":"/6bRkt3A2Drr6AnR9lZttnP1TKlo.jpg","release_date":"2022-01-21","softcore":false,"video":false,"vote_average":4.99,"vote_count":103,"credit_id":"5ea72d10426ae800264809d8","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/60qjADBGGjgFLcYSIG5zaPlxUQk.jpg","genre_ids":[878,27],"id":455551,"title":"Zanosi się na Burzę","original_language":"en","original_title":"The Recall","overview":"Piątka przyjaciół wyjeżdża na weekend do odosobnionego domku nad jeziorem. Przebywając z dala od cywilizacji, nie mają pojęcia, że dziwne zjawiska na niebie, które zauważają, to nie anomalie pogodowe, a zapowiedź inwazji obcych. Gdy wreszcie orientują się, co się dzieje - jest już za późno - zostali zauważeni. Czy zostaną porwani przez kosmitów tak jak i wielu innych ludzi? A może to właśnie oni i tajemniczy Łowca (Wesley Snipes) zdołają ocalić świat przed zagładą?","popularity":3.3614,"poster_path":"/A2sQAzHavtot2brA42pHXKgf3ww.jpg","release_date":"2017-06-02","softcore":false,"video":false,"vote_average":4.654,"vote_count":368,"credit_id":"5ea731c5cc9683001eae030a","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/vr6n6ZFUZvedvIlhfYcbCWcaKyW.jpg","genre_ids":[12,14,28],"id":58,"title":"Piraci z Karaibów. Skrzynia umarlaka","original_language":"en","original_title":"Pirates of the Caribbean: Dead Man's Chest","overview":"Jedyny w swoim rodzaju pirat - kapitan Jack Sparrow (Johnny Depp) powraca z kolejnym krwawym długiem do spłacenia. Ofiarował bowiem swoją duszę legendarnemu Davy Jonesowi (Bill Nighy), niesamowitemu władcy podmorskich głębin, który teraz domaga się swej własności. Jack krzyżuje matrymonialne plany Willa Turnera (Orlando Bloom) i jego pięknej narzeczonej Elizabeth Swann (Keira Knightley), którzy za sprawą nieszczęśliwych zbiegów okoliczności zostają rzuceni w wir przerażającej przygody. Sparrow naraża życie swoich przyjaciół, aby odzyskać klucz i znaleźć skrzynię umarlaka w której ukryte jest coś, co ma uratować życie kapitana. Nie jest to jednak proste zadanie, gdyż cały czas ściga ich Kraken - legendarny potwór zamieszkujący oceany.","popularity":24.1915,"poster_path":"/bzxQf3bPoEbPjsBj6MTSOjM7zxz.jpg","release_date":"2006-07-06","softcore":false,"video":false,"vote_average":7.388,"vote_count":17395,"credit_id":"5f920653e741460039a08abd","department":"Art","job":"Concept Artist"},{"adult":false,"backdrop_path":"/cJYerfZVf2rNwfGMK3MQ8lTbMnY.jpg","genre_ids":[35,14],"id":62213,"title":"Mroczne cienie","original_language":"en","original_title":"Dark Shadows","overview":"W 1752 roku rodzina Collinsonów wraz z synkiem Barnabasem wsiada na pokład statku, który płynie do Ameryki. Mają nadzieję, że tam rozpoczną życie na nowo i fatum, które krąży nad nimi po prostu zniknie. Mija 20 lat. Dorosły już Barnabas ma wszystko, czego mógłby zapragnąć. Jest bogaty i potężny. Jedyną jego wadą jest słabość do kobiet. Wszystko jednak zmienia się, kiedy bohater łamie serce pięknej Angelique Brouchard, która z nienawiści zamienia go w wampira, a potem zabija. Mijają lata. Po niespełna dwóch stuleciach Barnabas znów powraca na ziemię i wtedy dopiero zaczyna na nowo poznawać świat, który wygląda zupełnie inaczej niż za czasów jego młodości.","popularity":9.5591,"poster_path":"/7y4K1eoyYXAs9jJyXwXvXHmEOwm.jpg","release_date":"2012-05-09","softcore":false,"video":false,"vote_average":6.106,"vote_count":7670,"credit_id":"5f9e73dcbc8abc003b33f19e","department":"Art","job":"Concept Artist"},{"adult":false,"backdrop_path":"/zNnjHLDtV8Ti3aworltaeaLMov4.jpg","genre_ids":[80,18,53],"id":242,"title":"Ojciec chrzestny III","original_language":"en","original_title":"The Godfather Part III","overview":"Sześćdziesięcioletni Michael Corleone myśli o wyprowadzeniu swej rodziny ze świata zbrodni, a zarazem o znalezieniu właściwego następcy. Wybór pada na porywczego Vincenta, ale decyzja ta równie dobrze może przekreślić marzenia o legitymizacji i wciągnąć rodzinę w piekło mafijnej wojny.","popularity":15.8848,"poster_path":"/tNQ5xf0p39kX7B6YYK9XMbQ3epU.jpg","release_date":"1990-12-25","softcore":false,"video":false,"vote_average":7.42,"vote_count":6952,"credit_id":"600e5e544d0e8d003f78db19","department":"Art","job":"Production Illustrator"},{"adult":false,"backdrop_path":"/mvPFffXgQzWFG2fZwdBv0i8zf6o.jpg","genre_ids":[18],"id":1380415,"title":"The Last Supper","original_language":"en","original_title":"The Last Supper","overview":"Poruszająca filmowa podróż biblijna, która przybliża nam ostateczny akt miłości i poświęcenia widziany oczami tych, którzy kroczyli u boku Jezusa.","popularity":2.4612,"poster_path":"/fulEdvN5u6mIpwig7HcBnYpkJEQ.jpg","release_date":"2025-03-14","softcore":false,"video":false,"vote_average":7.141,"vote_count":64,"credit_id":"6722f0fb1d0b571b8a5c399f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/mvPFffXgQzWFG2fZwdBv0i8zf6o.jpg","genre_ids":[18],"id":1380415,"title":"The Last Supper","original_language":"en","original_title":"The Last Supper","overview":"Poruszająca filmowa podróż biblijna, która przybliża nam ostateczny akt miłości i poświęcenia widziany oczami tych, którzy kroczyli u boku Jezusa.","popularity":2.4612,"poster_path":"/fulEdvN5u6mIpwig7HcBnYpkJEQ.jpg","release_date":"2025-03-14","softcore":false,"video":false,"vote_average":7.141,"vote_count":64,"credit_id":"6722f104180b0a5ab90c3dde","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[10749,18,14],"id":1184877,"title":"Goodbye, Casanova","original_language":"en","original_title":"Goodbye, Casanova","overview":"","popularity":0.6595,"poster_path":"/4c4Nx9NltqrtK2NWsNYEshjMSho.jpg","release_date":"2000-01-01","softcore":false,"video":false,"vote_average":8.0,"vote_count":1,"credit_id":"679d0d393de588d5a0013519","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[10749,18,14],"id":1184877,"title":"Goodbye, Casanova","original_language":"en","original_title":"Goodbye, Casanova","overview":"","popularity":0.6595,"poster_path":"/4c4Nx9NltqrtK2NWsNYEshjMSho.jpg","relea