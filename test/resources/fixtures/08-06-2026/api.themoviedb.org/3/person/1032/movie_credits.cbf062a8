ry","overview":"„Szczęki” Spielberga obchodzą 50. urodziny! Z tej okazji reżyser uchyla rąbka tajemnicy na temat kultowego filmu. Od powieści Petera Benchleya po kinowy hit, „Szczęki” do dziś inspirują popkulturę, kino i działania na rzecz ochrony rekinów. Wywiady z reżyserami i naukowcami udowadniają, że legenda „Szczęk” jest wieczna.","popularity":3.1605,"poster_path":"/kCvCb548scfD0HhkCAwBMKHey5b.jpg","release_date":"2025-06-20","softcore":false,"video":false,"vote_average":7.516,"vote_count":61,"character":"Self - Filmmaker (archive footage)","credit_id":"69df94f8c310bb6323211d1b","order":48},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1685400,"title":"Refuge","original_language":"en","original_title":"Refuge","overview":"","popularity":1.2969,"poster_path":null,"release_date":"2006-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"69f34b89fa017c411bb7212c","order":7},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1687065,"title":"Lindsay Anderson: Lucky Man?","original_language":"en","original_title":"Lindsay Anderson: Lucky Man?","overview":"","popularity":0.914,"poster_path":null,"release_date":"2004-12-31","softcore":false,"video":false,"vote_average":2.0,"vote_count":1,"character":"Self","credit_id":"69f68531d3db0833cedb3e88","order":1},{"adult":false,"backdrop_path":"/ySBe1RUKk7DFgh3Hc6DYCh9woDW.jpg","genre_ids":[99],"id":1599513,"title":"Taxi Driver: 40th Anniversary Cast Q&A","original_language":"en","original_title":"Taxi Driver: 40th Anniversary Cast Q&A","overview":"","popularity":0.6939,"poster_path":"/blC773ZMLy2Ms96HLoOOn3NOveC.jpg","release_date":"2016-11-08","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"69ff0f4215dc74aa0d79d071","order":8},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1713862,"title":"Raging Bull: Marty & Bobby","original_language":"en","original_title":"Raging Bull: Marty & Bobby","overview"