:0.8537,"poster_path":"/agwvFwYICSXshc3uRLO9PIQX5UI.jpg","release_date":"2017-05-25","softcore":false,"video":false,"vote_average":8.1,"vote_count":17,"credit_id":"586008f9c3a3681a6b0207de","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/aOEsoi4PLECCsoNH0XQajlwupf6.jpg","genre_ids":[99],"id":53198,"title":"Il mio viaggio in Italia","original_language":"it","original_title":"Il mio viaggio in Italia","overview":"","popularity":1.2259,"poster_path":"/tGJ7l54tHXMdh406ggs4BmelrrE.jpg","release_date":"1999-09-11","softcore":false,"video":false,"vote_average":7.599,"vote_count":71,"credit_id":"589290e0c3a3680b24000eab","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/d6YusIEmX2PuL2wiWZKfg4aOlm7.jpg","genre_ids":[99],"id":79172,"title":"Surviving Progress","original_language":"en","original_title":"Surviving Progress","overview":"","popularity":0.9682,"poster_path":"/zzyhiTDQIACufSYlETKpP1CMi7O.jpg","release_date":"2011-11-04","softcore":false,"video":false,"vote_average":7.383,"vote_count":47,"credit_id":"5961e29dc3a3680d590a838d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/acvE3RWjDLgvbL2RtcyzkrsAyNV.jpg","genre_ids":[80,36,18],"id":466420,"title":"Czas krwawego księżyca","original_language":"en","original_title":"Killers of the Flower Moon","overview":"Gdy w latach 20. XX wieku w Oklahomie zostają odkryte złoża ropy na terenie zamieszkałym przez Osedżiów, ktoś zaczyna mordować członków plemienia, aż do akcji wkracza FBI, by rozwiązać zagadkę.","popularity":17.6803,"poster_path":"/oA1EDzdHhAMkslPxtiVIRW4T3I4.jpg","release_date":"2023-10-18","softcore":false,"video":false,"vote_average":7.392,"vote_count":4240,"credit_id":"5968f4279251412ff3021401","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rfBUlspOpxPavxrhkhvzlBlwfD8.jpg","genre_ids":[80,53,9648,27],"id":372343,"title":"Pierwszy Śnieg","original_language":"en","original_title":"The Snowman","overview":"Harry Hole (Michael Fassbender), detektyw Wydziału Zabójstw z Oslo, podejmuje śledztwo w sprawie zniknięcia kobiety podczas pierwszego opadu śniegu. Obawia się, że to nowy atak seryjnego mordercy. Przy pomocy zaczynającej pracę błyskotliwej policjantki (Rebecca Ferguson), stary wyga musi połączyć kilka dawnych spraw z tą nową, by przechytrzyć złoczyńcę, zanim znów spadnie śnieg.","popularity":7.7775,"poster_path":"/jemHdcfnRaTeUvbzZxj2H4yzs67.jpg","release_date":"2017-08-24","softcore":false,"video":false,"vote_average":5.215,"vote_count":2403,"credit_id":"596e8abac3a3680145013e63","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/n1sqCu6nIOfb2d0Qc2401TwBdWF.jpg","genre_ids":[80,18],"id":453270,"title":"Ciambra","original_language":"it","original_title":"A Ciambra","overview":"W małej, romskiej społeczności Ciambra w Kalabrii mieszka 14-latek o imieniu Pio. Chłopak, niczym cień podąża za swoim starszym bratem Cosimo, od którego uczy się sztuki przetrwania na ulicy. Obraca się wśród dorosłych mężczyzn, z którymi stara się pić i palić na równi, chcąc być wciągniętym do męskiej starszyzny. Na jego codzienność składa się robienie szemranych interesów z lokalnym półświatkiem. W ekscytacji i zniecierpliwieniu wyczekuje momentu, w którym nastąpi symboliczny rytuał przejścia i z chłopca stanie się mężczyzną – nawet za cenę zdrady i nielojalności. Jedynym wyznacznikiem moralności są bowiem nakazy narzucone ze strony wspólnoty, której należy się całkowita lojalność oraz wierność.","popularity":1.2269,"poster_path":"/gnDV3LuZh5BBaA3OjR1NyxviiU0.jpg","release_date":"2017-08-31","softcore":false,"video":false,"vote_average":7.14,"vote_count":175,"credit_id":"59a12cbb92514177930264c7","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/rBqdcQeM1h05YjF9rFtPWnNaDO2.jpg","genre_ids":[18],"id":11051,"title":"Ostatnie kuszenie Chrystusa","original_language":"en","original_title":"The Last Temptation of Christ","overview":"Jezus (Willem Dafoe) jest cieślą w okupowanej Judei. Współpracuje z Rzymianami, tworząc krzyże, na których ci wieszają żydowskich buntowników. Tymczasem Judasz Iskariota (Harvey Keitel), pierwotnie wysłany, by ukarać Jezusa za zdradę rodaków, dostrzega w nim jednak Mesjasza i nawołuje, by poprowadził swój lud przeciwko rzymskim oprawcom. Jezus się zgadza i wraz z uczniami zaczyna głosić Słowo Boże. Wkrótce zyskuje wielu zwolenników, sam jednak nie jest do końca pewien drogi, jaką powinien obrać.","popularity":5.5294,"poster_path":"/3kmD6DLQsBiEzkJxfSAcPtmoqza.jpg","release_date":"1988-05-28","softcore":false,"video":false,"vote_average":7.214,"vote_count":1211,"credit_id":"6432f9a5310325007728deed","department":"Crew","job":"Additional Writing"},{"adult":false,"backdrop_path":"/fsb7G81U4QBCczuY4mVNIOgS5t4.jpg","genre_ids":[9648,27,53],"id":1117319,"title":"What Happens at Night","original_language":"en","original_title":"What Happens at Night","overview":"","popularity":1.1866,"poster_path":"/1frL9CznOQ0EWMPdAa16MtuKEmn.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6446619cb3f6f515559faef3","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/qdecDSIVoqctIoYoOhLH3TgSYLD.jpg","genre_ids":[18,80],"id":203,"title":"Ulice Nędzy","original_language":"en","original_title":"Mean Streets","overview":"\"Ulice nędzy\" to zapowiedź nowego oblicza sztuki filmowej w wykonaniu Martina Scorsese - a jednocześnie genialny początek wieloletniej współpracy z Robertem De Niro. To historia życia Scorsese, częściowo autobiograficzna opowieść o pierwszym pokoleniu synów i córek nowojorskiej \"Małej Italii\". Harvey Keitel wcielił się w rolę Charliego, pracującego w szeregach lokalnej mafii. Amy Robinson zagrała Teresę, dziewczynę, którą jego rodzina uważa za nieodpowiednią partię, ze względu na chorobę. Natomiast Robert De Niro stworzył niezapomnianą kreację Johnny'ego Boya - drobnego kanciarza w podstępnym świecie wielkich przekrętów i pieniędzy, którą Stowarzyszenie Nowojorskich Krytyków wyróżniło nagrodą dla \"najlepszego aktora drugoplanowego\".","popularity":6.0063,"poster_path":"/53kxzpHYjbmwcPjFGPArlTeqTmF.jpg","release_date":"1973-10-14","softcore":false,"video":false,"vote_average":7.045,"vote_count":2325,"credit_id":"5a7a2463c3a368225b028c71","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/xhYs4yaBnDNM3utncVzLmFVpAmK.jpg","genre_ids":[80,18,9648],"id":20649,"title":"Ślepy zaułek","original_language":"en","original_title":"Clockers","overview":"Film ten oparty jest na bestsellerowej powieści Richarda Price'a. Opowiada o życiu ludzi w jednej z murzyńskich dzielnic Nowego Jorku. Jeden z głównych bohaterów - 16-letni Strike - zajmuje się handlem narkotyków. Traktuje on to jako główne źródło utrzymania i sposób na usamodzielnienie się. Jednak nie wszystko układa się pomyślnie. Szef Strike'a - Rodney Little - zleca mu pierwsze morderstwo, które ma być sprawdzianem lojalności chłopaka. Jeśli ten wywiąże się z zadania prawidłowo, może liczyć na awans w \"narkotykowej hierarchii\". Ofiarą ma być Darryl Adams - inny handlarz, który naraził się bossowi. O planowanym morderstwie Strike opowiada swojemu starszemu bratu Victorowi, który jest uczciwym człowiekiem, pracuje na dwóch zmianach, aby kiedyś \"wyrwać się\" z murzyńskiej dzielnicy. Victor oznajmia bratu, że zna kogoś, kto mógłby za niego wykonać \"mokrą robotę\". Jakiś czas później policjanci, z inspektorem Rocco Kleinem na czele, odnajdują zwłoki Darryla...","popularity":3.4363,"poster_path":"/c79uqLJleho2a7OQayfrW5Ypphf.jpg","release_date":"1995-09-15","softcore":false,"video":false,"vote_average":6.695,"vote_count":361,"credit_id":"5a918e040e0a2616c900d663","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/wtlhixFsctfV4LHJiVq95Ho37B6.jpg","genre_ids":[27,18],"id":48714,"title":"The Big Shave","original_language":"en","original_title":"The Big Shave","overview":"","popularity":1.4338,"poster_path":"/1bgOIU4ezln7qqVymjQBLEYMPpb.jpg","release_date":"1967-12-29","softcore":false,"video":false,"vote_average":6.93,"vote_count":359,"credit_id":"5a95a959c3a36811a3002114","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/wtlhixFsctfV4LHJiVq95Ho37B6.jpg","genre_ids":[27,18],"id":48714,"title":"The Big Shave","original_language":"en","original_title":"The Big Shave","overview":"","popularity":1.4338,"poster_path":"/1bgOIU4ezln7qqVymjQBLEYMPpb.jpg","release_date":"1967-12-29","softcore":false,"video":false,"vote_average":6.93,"vote_count":359,"credit_id":"5a95a94dc3a36811a30020fd","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/4hTeAZTYzPqKOEWwXd27WCqkoqH.jpg","genre_ids":[18,10751],"id":479813,"title":"Słoń i motyl","original_language":"fr","original_title":"Drôle de père","overview":"Antoine wraca do swojego belgijskiego miasta rodzinnego, gdzie spotyka swoją byłą kochankę i matkę ich pięcioletniej córki Elsy, której nigdy nie poznał. Przez nieoczekiwany zwrot wydarzeń Antoine musi zająć się dociekliwym i żywiołowym dzieckiem.","popularity":1.3377,"poster_path":"/15ptRIWnTLPmRJbE1f84noUGAEh.jpg","release_date":"2017-11-22","softcore":false,"video":false,"vote_average":7.0,"vote_count":13,"credit_id":"5aace4400e0a26782700e58c","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/2jLMu0YVunwb2RgYqY6Ewbgw86y.jpg","genre_ids":[18],"id":510034,"title":"Diane","original_language":"en","original_title":"Diane","overview":"","popularity":0.9567,"poster_path":"/vQsWX0B6G5wajvCiUh4tmMHd1I8.jpg","release_date":"2019-03-28","softcore":false,"video":false,"vote_average":6.135,"vote_count":37,"credit_id":"5aaa73a4925141057300c1d5","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/41EKMZkoZY2GSGwGLVsZIRVFViM.jpg","genre_ids":[35,18,10749],"id":9686,"title":"Nowojorskie opowieści","original_language":"en","original_title":"New York Stories","overview":"Dzieło firmowane przez nazwiska trzech wybitnych twórców amerykańskiego kina : Woody'ego Allena, Francisa Forda Coppolę i Martina Scorsese. Trzy krótkie nowele, zróżnicowane zarówno pod względem treści, jak i stylu łączy jedynie wspólne miejsce akcji - Nowy Jork. Bohaterem zabawnej komedyjki Allena pt. \"Zagłada Edypa\" jest Żyd, który nie potrafi opuścić swojej matki, nawet wtedy gdy ona umiera. Scorsese opowiada w \"Życiowych lekcjach\" niezbyt optymistyczną historię miłosną. Głównymi jej protagonistami są: malarz przeżywający kryzys twórczy i zakochana w nim praktykantka. Wyreżyserowana przez Coppolę nowela \"Życie bez Zoe\" to utrzymana w baśniowym klimacie opowieść o bogatej dziewczynce, która usłuje pogodzić skłóconych ze sobą rodziców...","popularity":2.4704,"poster_path":"/mViGEH5dfsAnUgJmce1RJkFycAi.jpg","release_date":"1989-03-10","softcore":false,"video":false,"vote_average":6.22,"vote_count":414,"credit_id":"64691cc6d18572014030ff36","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/d4VKIhk1OCEGVsqyiDKBtGAeO7.jpg","genre_ids":[28,80,9648],"id":334521,"title":"Free Fire","original_language":"en","original_title":"Free Fire","overview":"Akcja tej retro strzelaniny rozgrywa się pod koniec lat 70. w pewnym opuszczonym magazynie w Bostonie. To miejsce zawarcia transakcji na zakup broni pomiędzy dwiema grupami przestępczymi. Każdy \"na wszelki wypadek\" przybywa na miejsce uzbrojony po zęby, testosteron aż buzuje, a obecność kobiety wcale nie łagodzi obyczajów. Wystarczy iskra, by doszło do konfliktu, który zatrzymać, przynajmniej w takim składzie osobowym, będzie wyjątkowo ciężko. Szybko okazuje się, że bohaterowie nie tylko świetnie obchodzą się z bronią, ale są też mistrzami ciętych ripost.","popularity":4.9702,"poster_path":"/olpgs0OPE8sdBGcuuWhKYzxAwN4.jpg","release_date":"2017-03-31","softcore":false,"video":false,"vote_average":6.254,"vote_count":1247,"credit_id":"5ab2651d92514116