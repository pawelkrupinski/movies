deo":false,"vote_average":6.833,"vote_count":6,"character":"Self","credit_id":"60090e234d0e8d003e6f1388","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":794611,"title":"Martin Scorsese's Journey Into Silence","original_language":"en","original_title":"Martin Scorsese's Journey Into Silence","overview":"","popularity":1.0338,"poster_path":"/fpJ7IMvUbRTcA12UmISUsUt6kVw.jpg","release_date":"2017-03-28","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"character":"Self","credit_id":"60205cab0e597b003ca2d461","order":0},{"adult":false,"backdrop_path":"/3rw5aaSAzE64mdkeOk6N3KPlSWJ.jpg","genre_ids":[99],"id":792166,"title":"Leonardo DiCaprio: Most Wanted!","original_language":"en","original_title":"Leonardo DiCaprio: Most Wanted!","overview":"","popularity":1.7301,"poster_path":"/oO8CotrnqhHAGbVMcCqNHrb89pP.jpg","release_date":"2021-01-29","softcore":false,"video":false,"vote_average":6.5,"vote_count":21,"character":"Self - Filmmaker (archive footage)","credit_id":"603f40278e870200282b0dfe","order":6},{"adult":false,"backdrop_path":"/7bZdGn0ACPpHjuvCI2rR7xtWK1H.jpg","genre_ids":[99],"id":831755,"title":"Andrzej Wajda: Moje inspiracje","original_language":"pl","original_title":"Andrzej Wajda: Moje inspiracje","overview":"Andrzej Wajda odsłania tajniki swego warsztatu reżyserskiego. Poznajemy powody, dla których reżyser porzucił studia malarskie na krakowskiej Akademii Sztuk Pięknych i trafił do szkoły filmowej w Łodzi. Dowiadujemy się, czym stała się dla niego sztuka filmowa, co chciał przez nią wyrazić i jak polskie malarstwo inspirowało go przy tworzeniu wybranych scen w najbardziej znanych filmach. Wskazując na konkretne obrazy wybitnych polskich artystów, takich jak Jan Matejko, Stanisław Wyspiański, Kazimierz Michałowski, Jacek Malczewski, Leopold Löffler, Józef Chełmoński czy Andrzej Wróblewski, i zestawiając je z kadrami z \"Wesela\", \"Ziemi obiecanej\", \"Brzeziny\", \"Krajobrazu po bitwie\", \"Katynia\", Andrzej Wajda - największy malarz polskiego kina, pozwala nam zrozumieć siłę oddziaływania malarstwa i jego wpływ na wybór estetyki kreowanych obrazów filmowych. W krótkim słowie wstępnym Martin Scorsese komentuje ten aspekt twórczości Andrzeja Wajdy.","popularity":1.0638,"poster_path":"/fItnAQQionSzlFwYscC77yQkiCk.jpg","release_date":"2017-03-06","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"60a6af4b4b0c630078d2d5fb","order":1},{"adult":false,"backdrop_path":"/nIMSC4s8KCMcPl68znU7VotAQX5.jpg","genre_ids":[99],"id":826263,"title":"I Am Alfred Hitchcock","original_language":"en","original_title":"I Am Alfred Hitchcock","overview":"","popularity":1.2796,"poster_path":"/7sbUIc1pfKfjfoX3xI940oMMqXy.jpg","release_date":"2021-05-02","softcore":false,"video":false,"vote_average":7.3,"vote_count":22,"character":"Self (archive footage)","credit_id":"60a6f26e142ef10078ee65d5","order":9},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":275192,"title":"You Must Remember This: The Warner Bros. Story","original_language":"en","original_title":"You Must Remember This: The Warner Bros. Story","overview":"","popularity":1.5924,"poster_path":"/8Z0JXktZLw3bb0HDpsbQdZ4YQ1d.jpg","release_date":"2008-05-15","softcore":false,"video":false,"vote_average":8.5,"vote_count":12,"character":"Self","credit_id":"60e9b80312b10e0074056a54","order":13},{"adult":false,"backdrop_path":"/hsCfWumTD7T3Jd1IDHbPuhsrJHE.jpg","genre_ids":[99],"id":127878,"title":"Casting By","original_language":"en","original_title":"Casting By","overview":"","popularity":1.1872,"poster_path":"/6e4BkMnt42OCzH5e3xOXgWVYh2v.jpg","release_date":"2012-11-01","softcore":false,"video":false,"vote_average":6.864,"vote_count":44,"character":"Self","credit_id":"60f7ed213103250072a76e57","order":31},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1352795,"title":"On the Set: Elaine’s","original_language":"en","original_title":"On the Set: Elaine’s","overview":"","popularity":0.6527,"poste