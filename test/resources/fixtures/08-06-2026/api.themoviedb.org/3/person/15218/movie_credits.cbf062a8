OzC1HoKp2AwkaPktH3HsQM2u5.jpg","genre_ids":[27,53,28],"id":341006,"title":"Eksperyment Belko","original_language":"en","original_title":"The Belko Experiment","overview":"Dla grupy osiemdziesięciu trzech amerykańskich ekspatriantów miejsce pracy w São Paulo staje się pułapką. Głos emitowany z systemu audio zmusza ich do podejmowania krańcowych decyzji.","popularity":5.6781,"poster_path":"/faJK0dP3S92kQoKtO4LZMjy41kf.jpg","release_date":"2017-03-17","softcore":false,"video":false,"vote_average":6.172,"vote_count":1695,"credit_id":"5589136bc3a3683d500016c1","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/rfnmMYuZ6EKOBvQLp2wqP21v7sI.jpg","genre_ids":[35,878,12],"id":774752,"title":"Strażnicy Galaktyki: Coraz bliżej święta","original_language":"en","original_title":"The Guardians of the Galaxy Holiday Special","overview":"Strażnicy ruszają na Ziemię z misją znalezienia niezapomnianego prezentu świątecznego dla Quilla.","popularity":13.9848,"poster_path":"/y9HAMOVUo42VwjC8qXrFPJBZdU4.jpg","release_date":"2022-11-24","softcore":false,"video":false,"vote_average":7.086,"vote_count":2418,"credit_id":"635876491108a8007e74c83e","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/9bOjEovR9cdiFUYwZY7fyfNGWyL.jpg","genre_ids":[35],"id":87818,"title":"Movie 43","original_language":"en","original_title":"Movie 43","overview":"Twórcy \"Sposobu na blondynkę\" oraz \"Głupiego i głupszego\" zapraszają na serię krótkich filmów komediowych w wykonaniu 11 różnych reżyserów. Mega obsada, mega skandal, mega komedia! Wymieszaj najzabawniejszych reżyserów kina, dodaj największe gwiazdy współczesnego kina, dopraw pierwszorzędnym poczuciem humoru, a na końcu usuń wszystkie zahamowania i bariery. A teraz… odsuń się i pękaj ze śmiechu!","popularity":9.7575,"poster_path":"/uYa06GxHsCsELx9vOQ11vsT0Aa6.jpg","release_date":"2013-01-24","softcore":false,"video":false,"vote_average":4.661,"vote_count":2535,"credit_id":"56c62a87c3a3680d54003a5c","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/1RAxtBxslR4OZCZC1vxIRUxjR7a.jpg","genre_ids":[9648,12,35],"id":9637,"title":"Scooby-Doo","original_language":"en","original_title":"Scooby-Doo","overview":"Dwa lata po rozwiązaniu Mystery Inc., wymuszonym różnicą charakteru wspólników, Scooby-Doo i jego przyjaciele zostają wezwani na Wyspę Strachów, gdzie mają zbadać serię paranormalnych wydarzeń.","popularity":12.2859,"poster_path":"/mTAiBJGg8mqEfnYHHbi37ZoRSZm.jpg","release_date":"2002-06-14","softcore":false,"video":false,"vote_average":6.113,"vote_count":4835,"credit_id":"61fe496fc58acd00438f24bf","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/c1fHKKfnuA5ccXyzwDrzcPA2XoH.jpg","genre_ids":[35],"id":1059523,"title":"Humanzee!","original_language":"en","original_title":"Humanzee!","overview":"","popularity":0.5593,"poster_path":"/wgsjqvhlFmOTyVWRzcxskSonVl2.jpg","release_date":"2008-12-01","softcore":false,"video":false,"vote_average":4.5,"vote_count":8,"credit_id":"63940ad0a0f1a200e2a964c5","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/c1fHKKfnuA5ccXyzwDrzcPA2XoH.jpg","genre_ids":[35],"id":1059523,"title":"Humanzee!","original_language":"en","original_title":"Humanzee!","overview":"","popularity":0.5593,"poster_path":"/wgsjqvhlFmOTyVWRzcxskSonVl2.jpg","release_date":"2008-12-01","softcore":false,"video":false,"vote_average":4.5,"vote_count":8,"credit_id":"63940abb6332f700895a7cae","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/c1fHKKfnuA5ccXyzwDrzcPA2XoH.jpg","genre_ids":[35],"id":1059523,"title":"Humanzee!","original_language":"en","original_title":"Humanzee!","overview":"","popularity":0.5593,"poster_path":"/wgsjqvhlFmOTyVWRzcxskSonVl2.jpg","release_date":"2008-12-01","softcore":false,"video":false,"vote_average":4.5,"vote_count":8,"credit_id":"63940b3e9f5dfb00916c9ebc","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/eGX66z