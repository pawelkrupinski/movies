VvPdpqFW1ULklhjv5rJkSMsR.jpg","release_date":"2010-09-03","softcore":false,"video":false,"vote_average":6.083,"vote_count":821,"credit_id":"564daa67c3a3686035009fc9","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/9KC9xXKkxIVgiNJbLmCO4jfXQ1N.jpg","genre_ids":[35],"id":384947,"title":"Bed, Bath and Beyond","original_language":"en","original_title":"Bed, Bath and Beyond","overview":"","popularity":1.2244,"poster_path":null,"release_date":"1996-01-06","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"credit_id":"56d27fd7c3a3681e4400f140","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/m4QQi9OBnSGfymR6rdBhSwAuxYJ.jpg","genre_ids":[35,18,10749],"id":375867,"title":"Paryż może poczekać","original_language":"en","original_title":"Paris Can Wait","overview":"Życie Anne powinno być spełnieniem marzeń. Kobieta jest bowiem żoną bogatego hollywoodzkiego producenta – Michaela i towarzyszy mu w podróżach po całym świecie. Anne żyje jednak w cieniu zapracowanego i nieobecnego męża, a żar namiętności w ich małżeństwie wypalił się już dawno. Pewnego dnia bliski współpracownik Michaela – beztroski Francuz o imieniu Jacques, proponuje jej podróż samochodem z odbywającego się w Cannes festiwalu filmowego do Paryża. Zaplanowana na siedem godzin podróż, zamienia się w dwudniową przygodę pełną najlepszego jedzenia, doskonałego wina, zapierających dech widoków, nieoczekiwanego humoru oraz… szczypty romansu.","popularity":3.1389,"poster_path":"/m8UR4I3DCNIe9IIVj3eFXR3x3u2.jpg","release_date":"2016-09-12","softcore":false,"video":false,"vote_average":5.857,"vote_count":249,"credit_id":"65a936606f97460128d90f0f","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/5jq7TjRzmvkJsa8bF3zWqxbPtmw.jpg","genre_ids":[18],"id":399019,"title":"Na pokuszenie","original_language":"en","original_title":"The Beguiled","overview":"Uwodzicielska adaptacja powieści Thomasa Cullinana w reżyserii słynnej scenarzystki i reżyserki Sofii Coppoli. Historia dzieje się w czasach Wojny Secesyjnej w jednej z południowych szkół dla dziewcząt. Młode kobiety opiekują się rannym żołnierzem wroga. Wraz ze stopniowym, powolnym powrotem mężczyzny do zdrowia dom zaczyna wypełniać napięcie seksualne i nieoczekiwana rywalizacja, która każe dziewczętom łamać wszelkie tabu i zmieniać rzeczywistość wokół nich.","popularity":5.747,"poster_path":"/a47tlxEgl2YHDVVKQwfmxr0tivI.jpg","release_date":"2017-06-23","softcore":false,"video":false,"vote_average":5.9,"vote_count":2255,"credit_id":"57444b8bc3a3685c35001e63","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sW5mPgwYEpzauk0QOBWxRUhs2t9.jpg","genre_ids":[35,10402,10770],"id":364067,"title":"A Very Murray Christmas","original_language":"en","original_title":"A Very Murray Christmas","overview":"W wigilijny wieczór Bill Murray czeka na zaproszonych gości. Panująca śnieżycę sprawia, że nikt się nie pojawia.","popularity":2.2205,"poster_path":"/2ir2DjNNXmMePsyc4inFa8oI23r.jpg","release_date":"2015-12-04","softcore":false,"video":false,"vote_average":5.2,"vote_count":464,"credit_id":"63a85a46aaec7100a112c437","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/5jq7TjRzmvkJsa8bF3zWqxbPtmw.jpg","genre_ids":[18],"id":399019,"title":"Na pokuszenie","original_language":"en","original_title":"The Beguiled","overview":"Uwodzicielska adaptacja powieści Thomasa Cullinana w reżyserii słynnej scenarzystki i reżyserki Sofii Coppoli. Historia dzieje się w czasach Wojny Secesyjnej w jednej z południowych szkół dla dziewcząt. Młode kobiety opiekują się rannym żołnierzem wroga. Wraz ze stopniowym, powolnym powrotem mężczyzny do zdrowia dom zaczyna wypełniać napięcie seksualne i nieoczekiwana rywalizacja, która każe dziewczętom łamać wszelkie tabu i zmieniać rzeczywistość wokół nich.","popularity":5.747,"poster_path":"/a47tlxEgl2YHDVVKQwfmxr0tivI.jpg","release_date":"2017-06-23","softcore":false,"video":false,"vote_average":5.9,"vote_count":2255,"credit_id":"59173e61c3a3683a930322c1","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/5jq7TjRzmvkJsa8bF3zWqxbPtmw.jpg","genre_ids":[18],"id":399019,"title":"Na pokuszenie","original_language":"en","original_title":"The Beguiled","overview":"Uwodzicielska adaptacja powieści Thomasa Cullinana w reżyserii słynnej scenarzystki i reżyserki Sofii Coppoli. Historia dzieje się w czasach Wojny Secesyjnej w jednej z południowych szkół dla dziewcząt. Młode kobiety opiekują się rannym żołnierzem wroga. Wraz ze stopniowym, powolnym powrotem mężczyzny do zdrowia dom zaczyna wypełniać napięcie seksualne i nieoczekiwana rywalizacja, która każe dziewczętom łamać wszelkie tabu i zmieniać rzeczywistość wokół nich.","popularity":5.747,"poster_path":"/a47tlxEgl2YHDVVKQwfmxr0tivI.jpg","release_date":"2017-06-23","softcore":false,"video":false,"vote_average":5.9,"vote_count":2255,"credit_id":"59173eeb9251415852034784","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/eC5ds4bW1bH9nsagdHeWYfuXw5O.jpg","genre_ids":[35,878],"id":57476,"title":"The Spirit of '76","original_language":"en","original_title":"The Spirit of '76","overview":"","popularity":1.3065,"poster_path":"/bmRrkQPeCLuiiB6LmqiCreTAZUm.jpg","release_date":"1990-10-12","softcore":false,"video":false,"vote_average":4.6,"vote_count":13,"credit_id":"592bb1619251413b4a06da38","department":"Costume & Make-Up","job":"Costume Design"},{"adult":false,"backdrop_path":"/A5VWK3aPhMUbEyKkOKdSrZr70JL.jpg","genre_ids":[35],"id":452460,"title":"Torrance Rises","original_language":"en","original_title":"Torrance Rises","overview":"","popularity":2.1994,"poster_path":"/2CShiMeuWypm9ObpfZl0R2g03je.jpg","release_date":"1999-01-01","softcore":false,"video":false,"vote_average":8.0,"vote_count":8,"credit_id":"592bb4acc3a368787006687d","department":"Crew","job":"Cinematography"},{"adult":false,"backdrop_path":null,"genre_ids":[35,28],"id":74730,"title":"Ciao L.A.","original_language":"en","original_title":"Ciao L.A.","overview":"","popularity":0.9168,"poster_path":"/maZtZ95IWjAs3XpNghKehwBqFxM.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":6.333,"vote_count":3,"credit_id":"592bb641c3a36877df07293d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/41EKMZkoZY2GSGwGLVsZIRVFViM.jpg","genre_ids":[35,18,10749],"id":9686,"title":"Nowojorskie opowieści","original_language":"en","original_title":"New York Stories","overview":"Dzieło firmowane przez nazwiska trzech wybitnych twórców amerykańskiego kina : Woody'ego Allena, Francisa Forda Coppolę i Martina Scorsese. Trzy krótkie nowele, zróżnicowane zarówno pod względem treści, jak i stylu łączy jedynie wspólne miejsce akcji - Nowy Jork. Bohaterem zabawnej komedyjki Allena pt. \"Zagłada Edypa\" jest Żyd, który nie potrafi opuścić swojej matki, nawet wtedy gdy ona umiera. Scorsese opowiada w \"Życiowych lekcjach\" niezbyt optymistyczną historię miłosną. Głównymi jej protagonistami są: malarz przeżywający kryzys twórczy i zakochana w nim praktykantka. Wyreżyserowana przez Coppolę nowela \"Życie bez Zoe\" to utrzymana w baśniowym klimacie opowieść o bogatej dziewczynce, która usłuje pogodzić skłóconych ze sobą rodziców...","popularity":2.4704,"poster_path":"/mViGEH5dfsAnUgJmce1RJkFycAi.jpg","release_date":"1989-03-10","softcore":false,"video":false,"vote_average":6.22,"vote_count":414,"credit_id":"6469438e2bcf67013894d19d","department":"Art","job":"Main Title Designer"},{"adult":false,"backdrop_path":"/41EKMZkoZY2GSGwGLVsZIRVFViM.jpg","genre_ids":[35,18,10749],"id":9686,"title":"Nowojorskie opowieści","original_language":"en","original_title":"New York Stories","overview":"Dzieło firmowane przez nazwiska trzech wybitnych twórców amerykańskiego kina : Woody'ego Allena, Francisa Forda Coppolę i Martina Scorsese. Trzy krótkie nowele, zróżnicowane zarówno pod względem treści, jak i stylu łączy jedynie wspólne miejsce akcji - Nowy Jork. Bohaterem zabawnej komedyjki Allena pt. \"Zagłada Edypa\" jest Żyd, który nie potrafi opuścić swojej matki, nawet wtedy gdy ona umiera. Scorsese opowiada w \"Życiowych lekcjach\" niezbyt optymistyczną historię miłosną. Głównymi jej protagonistami są: malarz przeżywający kryzys twórczy i zakochana w nim praktykantka. Wyreżyserowana przez Coppolę nowela \"Życie bez Zoe\" to utrzymana w baśniowym klimacie opowieść o bogatej dziewczynce, która usłuje pogodzić skłóconych ze sobą rodziców...","popularity":2.4704,"poster_path":"/mViGEH5dfsAnUgJmce1RJkFycAi.jpg","release_date":"1989-03-10","softcore":false,"video":false,"vote_average":6.22,"vote_count":414,"credit_id":"6469273e33a37600e67a8eeb","department":"Costume & Make-Up","job":"Costume Design"},{"adult":false,"backdrop_path":"/41EKMZkoZY2GSGwGLVsZIRVFViM.jpg","genre_ids":[35,18,10749],"id":9686,"title":"Nowojorskie opowieści","original_language":"en","original_title":"New York Stories","overview":"Dzieło firmowane przez nazwiska trzech wybitnych twórców amerykańskiego kina : Woody'ego Allena, Francisa Forda Coppolę i Martina Scorsese. Trzy krótkie nowele, zróżnicowane zarówno pod względem treści, jak i stylu łączy jedynie wspólne miejsce akcji - Nowy Jork. Bohaterem zabawnej komedyjki Allena pt. \"Zagłada Edypa\" jest Żyd, który nie potrafi opuścić swojej matki, nawet wtedy gdy ona umiera. Scorsese opowiada w \"Życiowych lekcjach\" niezbyt optymistyczną historię miłosną. Głównymi jej protagonistami są: malarz przeżywający kryzys twórczy i zakochana w nim praktykantka. Wyreżyserowana przez Coppolę nowela \"Życie bez Zoe\" to utrzymana w baśniowym klimacie opowieść o bogatej dziewczynce, która usłuje pogodzić skłóconych ze sobą rodziców...","popularity":2.4704,"poster_path":"/mViGEH5dfsAnUgJmce1RJkFycAi.jpg","release_date":"1989-03-10","softcore":false,"video":false,"vote_average":6.22,"vote_count":414,"credit_id":"646927d2006b0100e6b452ff","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/6ITVHoipvxAS8luzKtHTbPaHLtT.jpg","genre_ids":[18,35,10749],"id":153,"title":"Między Słowami","original_language":"en","original_title":"Lost in Translation","overview":"Młoda mężatka Charlotte pojechała z mężem, fotografikiem show-businessu na zdjęcia do Japonii, jednak nudzi się tam, a jej układy z mężem nie są najlepsze. Przypadkiem poznaje Boba – starzejącego się gwiazdora filmowego, który przyjechał do Japonii na sesję reklamującą whisky Santori. Stopniowo między nimi nawiązuje się specyficzna nić porozumienia i uczucia. Bob i Charlotte zdają sobie sprawę, jak wiele ich łączy, jednak muszą się rozstać.","popularity":10.7454,"poster_path":"/7JX0mX0NcQhVXR5RcJgZdRUanIF.jpg","release_date":"2003-09-18","softcore":false,"video":false,"vote_average":7.379,"vote_count":8204,"credit_id":"6688e08e67e1b52c3c1d06f5","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/86pqF6qSDj2UG2WGVGYF0hjIqnP.jpg","genre_ids":[18],"id":449202,"title":"The Funeral","original_language":"en","original_title":"The Funeral","overview":"","popularity":0.7533,"poster_path":"/kV2MBMb8P1vK7heofhugYT7TdW4.jpg","release_date":"2016-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"64c4a7afec0c580126652a3a","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/7FQHLt4iNh2TZ58cAAYrZK0xogg.jpg","genre_ids":[18,35,10749],"id":575417,"title":"Na lodzie","original_language":"en","original_title":"On the Rocks","overview":"Młoda mama niepewna wierności męża podąża jego tropem po Nowym Jorku wraz z ekscentrycznym ojcem-playboyem.","popularity":4.7149,"poster_path":"/941P3GKSu9015ZwGCZZEIlhNVY1.jpg","release_date":"2020-10-02","softcore":false,"video":false,"vote_average":6.095,"vote_count":809,"credit_id":"5c3e37729251416b02ae3461","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7FQHLt4iNh2TZ58cAAYrZK0xogg.jpg","genre_ids":[18,35,10749],"id":575417,"title":"Na lodzie","original_language":"en","original_title":"On the Rocks","overview":"Młoda mama niepewna wierności męża podąża jego tropem po Nowym Jorku wraz z ekscentrycznym ojcem-playboyem.","popularity":4.7149,"poster_path":"/941P3GKSu9015ZwGCZZEIlhNVY1.jpg","release_date":"2020-10-02","softcore":false,"video":false,"vote_average":6.095,"vote_count":809,"credit_id":"5c55dc6a0e0a26031bc6d26a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/7FQHLt4iNh2TZ58cAAYrZK0xogg.jpg","genre_ids":[18,35,10749],"id":575417,"title":"Na lodzie","original_language":"en","original_title":"On the Rocks","overview":"Młoda mama niepewna wierności męża podąża jego tropem po Nowym Jorku wraz z ekscentrycznym ojcem-playboyem.","popularity":4.7149,"poster_path":"/941P3GKSu9015ZwGCZZEIlhNVY1.jpg","release_date":"2020-10-02","softcore":false,"video":false,"vote_average":6.095,"vote_count":809,"credit_id":"5c55dcb49251415448620c0f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[10402],"id":425651,"title":"La Traviata","original_language":"en","original_title":"La Traviata","overview":"","popularity":1.0237,"poster_path":"/kXK472FXPlOU7vjVL7rPg8Rj1mk.jpg","release_date":"2017-03-19","softcore":false,"video":false,"vote_average":7.2,"vote_count":5,"credit_id":"5fb746d94a4bfc0040aed47a","department":"Directing","job":"Stage Director"},{"adult":false,"backdrop_path":"/ouN0GyE7mtIT6wyJeilaggyvgNj.jpg","genre_ids":[18,80],"id":96936,"title":"Bling Ring","original_language":"en","original_title":"The Bling Ring","overview":"\"Bling Ring\" to film oparty na prawdziwej historii, która wstrząsnęła Ameryką. Wyreżyserowany przez laureatkę Oscara Sofię Coppolę, opowiada o słynnej grupie nastoletnich włamywaczy, obsesyjnie pragnących zbliżyć się do świata gwiazd. W poszukiwaniu ekstremalnych wrażeń, grupa Bling Ring zakrada się do domów hollywoodzkich celebrytów, gdzie dokonuje rozbojów. Magia luksusowych marek i wszechobecny glamour wydają się młodocianym złodziejom przepustką do lepszego, niedostępnego dla nich życia. To co zakazane, niesie ze sobą jednak poważne konsekwencje.","popularity":4.4576,"poster_path":"/9INxoGHoEXVUn1t2uKKIeiq8Ss0.jpg","release_date":"2013-06-12","softcore":false,"video":false,"vote_average":5.4,"vote_count":3163,"credit_id":"603e865ad236e60079618c99","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/sfhhJmKJBidavKSnCd8ZIMFOOup.jpg","genre_ids":[18],"id":1235499,"title":"The Last Showgirl","original_language":"en","original_title":"The Last Showgirl","overview":"Shelly (Pamela Anderson) czuje się w szczytowej formie, jednak świat postrzega ją – kobietę po pięćdziesiątce – jako kogoś, kto lata swojej świetności ma dawno za sobą. Swoją pracę traktuje nie tylko jako formę rozrywki, ale przede wszystkim pasję oraz sztukę, korzeniami sięgającą do francuskiej burleski. Liczące sobie trzy dekady show ma jednak zniknąć z afisza i zostać zastąpione nową formułą z młodszymi tancerkami. Shelly staje więc przed dylematem: co zrobić dalej ze swoim życiem, skoro jej największy atut – ciało – przestało być atrakcyjne? Może to szansa, aby naprawić nadszarpnięte relacje z córką? Jak jeszcze raz pokazać światu, na co ją stać?","popularity":2.9992,"poster_path":"/d1CJaP0KJVM9pBkCh8up5MeZfGV.jpg","release_date":"2024-12-13","softcore":false,"video":false,"vote_average":6.422,"vote_count":295,"credit_id":"67b6b1209f7fb2a7436553db","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/reSa0DcGoinsguV7QUNeG2V6rp4.jpg","genre_ids":[99],"id":1517069,"title":"Marc by Sofia","original_language":"en","original_title":"Marc by Sofia","overview":"","popularity":1.9896,"poster_path":"/oFIW0VvoxPWCC15trTNzaMzpc7r.jpg","release_date":"2026-03-20","softcore":false,"video":false,"vote_average":6.0,"vote_count":3,"credit_id":"687f5eff096e0ed3fb72d1ea","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lqwwGkwJHtz9QgKtz4zeY19YgDg.jpg","genre_ids":[10749,18],"id":1136867,"title":"Materialiści","original_language":"en","original_title":"Materialists","overview":"Lucy jest przebojową swatką z Nowego Yorku. Dzięki jej pracy udało się związać wiele szczęśliwych par. Lucy ma bardzo duże oczekiwania w stosunku do mężczyzn. Pewnego dnia poznaje idealnego mężczyznę, który spełnia wszystkie jej wymagania, ale jednocześnie zaczyna kwestionować, co tak naprawdę stanowi idealne dopasowanie, gdy jej były chłopak ponownie ją zauroczy.","popularity":13.679,"poster_path":"/eDo0pNruy0Qgj6BdTyHIR4cxHY8.jpg","release_date":"2025-06-12","softcore":false,"video":false,"vote_average":6.28,"vote_count":1382,"credit_id":"6880b362fbcc2b691738e69a","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/reSa0DcGoinsguV7QUNeG2V6rp4.jpg","genre_ids":[99],"id":1517069,"title":"Marc by Sofia","original_language":"en","original_title":"Marc by Sofia","overview":"","popularity":1.9896,"poster_path":"/oFIW0VvoxPWCC15trTNzaMzpc7r.jpg","release_date":"2026-03-20","softcore":false,"video":false,"vote_average":6.0,"vote_count":3,"credit_id":"6880b60bdf411187b516ad7a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/1CbxtdiBSBnihJh5F4nG4sH868L.jpg","genre_ids":[18],"id":192132,"title":"Palo Alto","original_language":"en","original_title":"Palo Alto","overview":"Szkolny trener piłki nożnej zmaga się nie tylko ze swoimi problemami, ale również z nastoletnimi podopiecznymi, którzy przysparzają kłopotów.","popularity":2.9846,"poster_path":"/yjcwwYP3eSigxLKKVBoVVz85ZWv.jpg","release_date":"2014-05-09","softcore":false,"video":false,"vote_average":6.102,"vote_count":921,"credit_id":"6912a0b76e28e624218757d4","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/vTiI8auKiV8KnewOqySCZkXB19t.jpg","genre_ids":[18],"id":524635,"title":"Chronologia wody","original_language":"en","original_title":"The Chronology of Water","overview":"Wychowując się w środowisku pełnym przemocy i alkoholu, młoda Lidia zmaga się z odnalezieniem swojej drogi. Udało jej się uciec od rodziny i rozpocząć studia, gdzie znalazła schronienie w literaturze. Stopniowo słowa przynoszą jej niespodziewaną wolność...","popularity":5.2252,"poster_path":"/vjm7DEI8LaWtmM33CmJdoeiN9PA.jpg","release_date":"2025-10-15","softcore":false,"video":false,"vote_average":6.772,"vote_count":79,"credit_id":"6984402d7b5b29048b6eeb7f","department":"Crew","job":"Thanks"}],"id":1769}