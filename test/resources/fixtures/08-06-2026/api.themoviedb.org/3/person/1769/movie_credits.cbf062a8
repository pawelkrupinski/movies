MVqQvyQvE.jpg","release_date":"1997-09-09","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"character":"Janet","credit_id":"6a5bf92fa3356ade0652329a","order":0}],"crew":[{"adult":false,"backdrop_path":"/6ITVHoipvxAS8luzKtHTbPaHLtT.jpg","genre_ids":[18,35,10749],"id":153,"title":"Między Słowami","original_language":"en","original_title":"Lost in Translation","overview":"Młoda mężatka Charlotte pojechała z mężem, fotografikiem show-businessu na zdjęcia do Japonii, jednak nudzi się tam, a jej układy z mężem nie są najlepsze. Przypadkiem poznaje Boba – starzejącego się gwiazdora filmowego, który przyjechał do Japonii na sesję reklamującą whisky Santori. Stopniowo między nimi nawiązuje się specyficzna nić porozumienia i uczucia. Bob i Charlotte zdają sobie sprawę, jak wiele ich łączy, jednak muszą się rozstać.","popularity":10.7454,"poster_path":"/7JX0mX0NcQhVXR5RcJgZdRUanIF.jpg","release_date":"2003-09-18","softcore":false,"video":false,"vote_average":7.379,"vote_count":8204,"credit_id":"52fe421fc3a36847f8005b31","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6ITVHoipvxAS8luzKtHTbPaHLtT.jpg","genre_ids":[18,35,10749],"id":153,"title":"Między Słowami","original_language":"en","original_title":"Lost in Translation","overview":"Młoda mężatka Charlotte pojechała z mężem, fotografikiem show-businessu na zdjęcia do Japonii, jednak nudzi się tam, a jej układy z mężem nie są najlepsze. Przypadkiem poznaje Boba – starzejącego się gwiazdora filmowego, który przyjechał do Japonii na sesję reklamującą whisky Santori. Stopniowo między nimi nawiązuje się specyficzna nić porozumienia i uczucia. Bob i Charlotte zdają sobie sprawę, jak wiele ich łączy, jednak muszą się rozstać.","popularity":10.7454,"poster_path":"/7JX0mX0NcQhVXR5RcJgZdRUanIF.jpg","release_date":"2003-09-18","softcore":false,"video":false,"vote_average":7.379,"vote_count":8204,"credit_id":"52fe421fc3a36847f8005b63","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/6b6UpsOXmjO8mJKYsGTG9HW49CN.jpg","genre_ids":[18,10749],"id":1443,"title":"Przekleństwa Niewinności","original_language":"en","original_title":"The Virgin Suicides","overview":"Państwo Lisbon są rodzicami pięciu atrakcyjnych nastoletnich córek. Dziewczęta, w wieku od trzynastu do siedemnastu lat, zaczynają odkrywać przyjemności dojrzewania, a ich rodzice - gorliwi katolicy - w patologiczny sposób kontrolują ich życie. Izolują dziewczęta od każdego chłopca, który okaże najmniejszy ślad zainteresowania którąkolwiek z córek. Pozornie doskonałe życie dysfunkcyjnej rodziny zostaje zaburzone, gdy najmłodsza z dziewcząt usiłuje popełnić samobójstwo.","popularity":7.1386,"poster_path":"/1NCQtXPQnaHRjOZVmktA9BSM35F.jpg","release_date":"2000-04-21","softcore":false,"video":false,"vote_average":7.1,"vote_count":3645,"credit_id":"52fe42f8c3a36847f80308c3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6b6UpsOXmjO8mJKYsGTG9HW49CN.jpg","genre_ids":[18,10749],"id":1443,"title":"Przekleństwa Niewinności","original_language":"en","original_title":"The Virgin Suicides","overview":"Państwo Lisbon są rodzicami pięciu atrakcyjnych nastoletnich córek. Dziewczęta, w wieku od trzynastu do siedemnastu lat, zaczynają odkrywać przyjemności dojrzewania, a ich rodzice - gorliwi katolicy - w patologiczny sposób kontrolują ich życie. Izolują dziewczęta od każdego chłopca, który okaże najmniejszy ślad zainteresowania którąkolwiek z córek. Pozornie doskonałe życie dysfunkcyjnej rodziny zostaje zaburzone, gdy najmłodsza z dziewcząt usiłuje popełnić samobójstwo.","popularity":7.1386,"poster_path":"/1NCQtXPQnaHRjOZVmktA9BSM35F.jpg","release_date":"2000-04-21","softcore":false,"video":false,"vote_average":7.1,"vote_count":3645,"credit_id":"52fe42f8c3a36847f80308c9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/9hxBNoRjEDZGjyR1JpmmtxJWmVU.jpg","genre_ids":[18,36],"id":1887,"title":"Maria Antonina","original_language":"en","original_title":"Marie Antoinette","overview":"Nastoletnia austriacka księżniczka zostaje wydana za francuskiego następcę tronu. Dziewczyna szybko uczy się życia na obcym sobie dworze, lecz jako bohaterka licznych skandali zaczyna wzbudzać coraz większą niechęć poddanych.","popularity":6.2861,"poster_path":"/jJu2nwUgGgS4O8YJWYXudC6Zmyj.jpg","release_date":"2006-05-24","softcore":false,"video":false,"vote_average":6.7,"vote_count":2983,"credit_id":"52fe431ec3a36847f803b8c1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9hxBNoRjEDZGjyR1JpmmtxJWmVU.jpg","genre_ids":[18,36],"id":1887,"title":"Maria Antonina","original_language":"en","original_title":"Marie Antoinette","overview":"Nastoletnia austriacka księżniczka zostaje wydana za francuskiego następcę tronu. Dziewczyna szybko uczy się życia na obcym sobie dworze, lecz jako bohaterka licznych skandali zaczyna wzbudzać coraz większą niechęć poddanych.","popularity":6.2861,"poster_path":"/jJu2nwUgGgS4O8YJWYXudC6Zmyj.jpg","release_date":"2006-05-24","softcore":false,"video":false,"vote_average":6.7,"vote_count":2983,"credit_id":"52fe431ec3a36847f803b8c7","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/9hxBNoRjEDZGjyR1JpmmtxJWmVU.jpg","genre_ids":[18,36],"id":1887,"title":"Maria Antonina","original_language":"en","original_title":"Marie Antoinette","overview":"Nastoletnia austriacka księżniczka zostaje wydana za francuskiego następcę tronu. Dziewczyna szybko uczy się życia na obcym sobie dworze, lecz jako bohaterka licznych skandali zaczyna wzbudzać coraz większą niechęć poddanych.","popularity":6.2861,"poster_path":"/jJu2nwUgGgS4O8YJWYXudC6Zmyj.jpg","release_date":"2006-05-24","softcore":false,"video":false,"vote_average":6.7,"vote_count":2983,"credit_id":"52fe431ec3a36847f803b8cd","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/bzCuOfoZ9ZC9AGLs8ZVZ5yo1X16.jpg","genre_ids":[18],"id":39210,"title":"Somewhere. Między miejscami","original_language":"en","original_title":"Somewhere","overview":"Hollywoodzki gwiazdor Johnny Marco mieszka w dekadenckim hotelu Chateau Marmont. Jeździ czarnym ferrari, ma nieograniczony dostęp do wszelkich używek, a wokół niego kręci się pełno dziewczyn gotowych spełniać jego kaprysy. Niespodziewanie w życie tabloidowego celebryty wkracza jedenastoletnia Cleo - córka Johnny'ego z małżeństwa, które dawno się rozpadło. To spotkanie wywróci do góry nogami cały jego świat.","popularity":3.0062,"poster_path":"/4nLVvPdpqFW1ULklhjv5rJkSMsR.jpg","release_date":"2010-09-03","softcore":false,"video":false,"vote_average":6.083,"vote_count":821,"credit_id":"52fe47039251416c9106747d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bzCuOfoZ9ZC9AGLs8ZVZ5yo1X16.jpg","genre_ids":[18],"id":39210,"title":"Somewhere. Między miejscami","original_language":"en","original_title":"Somewhere","overview":"Hollywoodzki gwiazdor Johnny Marco mieszka w dekadenckim hotelu Chateau Marmont. Jeździ czarnym ferrari, ma nieograniczony dostęp do wszelkich używek, a wokół niego kręci się pełno dziewczyn gotowych spełniać jego kaprysy. Niespodziewanie w życie tabloidowego celebryty wkracza jedenastoletnia Cleo - córka Johnny'ego z małżeństwa, które dawno się rozpadło. To spotkanie wywróci do góry nogami cały jego świat.","popularity":3.0062,"poster_path":"/4nLVvPdpqFW1ULklhjv5rJkSMsR.jpg","release_date":"2010-09-03","softcore":false,"video":false,"vote_average":6.083,"vote_count":821,"credit_id":"52fe47039251416c910674bf","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/bbiUm8kVTXf5ZN6CQn3s7DhVCpy.jpg","genre_ids":[18],"id":92657,"title":"Lick the Star","original_language":"en","original_title":"Lick the Star","overview":"","popularity":1.0792,"poster_path":"/kyMHq9xj9CQwwCSBZpvcHg7voJ8.jpg","release_date":"1998-10-01","softcore":false,"video":false,"vote_average":5.89,"vote_count":86,"credit_id":"52fe49079251416c750bb3db","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bbiUm8kVTXf5ZN6CQn3s7DhVCpy.jpg","genre_ids":[18],"id":92657,"title":"Lick the Star","original_language":"en","original_title":"Lick the Star","overview":"","popularity":1.0792,"poster_path":"/kyMHq9xj9CQwwCSBZpvcHg7voJ8.jpg","release_date":"1998-10-01","softcore":false,"video":false,"vote_average":5.89,"vote_count":86,"credit_id":"52fe49079251416c750bb3e1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ouN0GyE7mtIT6wyJeilaggyvgNj.jpg","genre_ids":[18,80],"id":96936,"title":"Bling Ring","original_language":"en","original_title":"The Bling Ring","overview":"\"Bling Ring\" to film oparty na prawdziwej historii, która wstrząsnęła Ameryką. Wyreżyserowany przez laureatkę Oscara Sofię Coppolę, opowiada o słynnej grupie nastoletnich włamywaczy, obsesyjnie pragnących zbliżyć się do świata gwiazd. W poszukiwaniu ekstremalnych wrażeń, grupa Bling Ring zakrada się do domów hollywoodzkich celebrytów, gdzie dokonuje rozbojów. Magia luksusowych marek i wszechobecny glamour wydają się młodocianym złodziejom przepustką do lepszego, niedostępnego dla nich życia. To co zakazane, niesie ze sobą jednak poważne konsekwencje.","popularity":4.4576,"poster_path":"/9INxoGHoEXVUn1t2uKKIeiq8Ss0.jpg","release_date":"2013-06-12","softcore":false,"video":false,"vote_average":5.4,"vote_count":3163,"credit_id":"52fe49c79251416c750d2ef3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ouN0GyE7mtIT6wyJeilaggyvgNj.jpg","genre_ids":[18,80],"id":96936,"title":"Bling Ring","original_language":"en","original_title":"The Bling Ring","overview":"\"Bling Ring\" to film oparty na prawdziwej historii, która wstrząsnęła Ameryką. Wyreżyserowany przez laureatkę Oscara Sofię Coppolę, opowiada o słynnej grupie nastoletnich włamywaczy, obsesyjnie pragnących zbliżyć się do świata gwiazd. W poszukiwaniu ekstremalnych wrażeń, grupa Bling Ring zakrada się do domów hollywoodzkich celebrytów, gdzie dokonuje rozbojów. Magia luksuso