0,"credit_id":"61d98f606dea3a00439fc010","department":"Visual Effects","job":"Animation"},{"adult":false,"backdrop_path":null,"genre_ids":[16],"id":628759,"title":"Colaholic","original_language":"pl","original_title":"Colaholic","overview":"Dziennik osoby, która pije stanowczo za dużo słodkich napojów gazowanych, dokument i komedia romantyczna w jednym.","popularity":1.8091,"poster_path":"/bQZbTcd0T55qaHDBQlF96xaUxQM.jpg","release_date":"2018-06-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"66428302b7bf2089ebd1fe04","department":"Visual Effects","job":"Animation"},{"adult":false,"backdrop_path":null,"genre_ids":[16],"id":720613,"title":"Tango tęsknot","original_language":"pl","original_title":"Tango tęsknot","overview":"","popularity":0.8994,"poster_path":"/meupali69EecYsGkUs45O5uspqM.jpg","release_date":"2018-12-09","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5efc2428f0317400394fde78","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[16,10751,14,12],"id":1208743,"title":"Ro","original_language":"pl","original_title":"Ro","overview":"12-letni Teo przeprowadza się do obcego miasta razem ze swoim tatą, Stefanem, który pracuje jako budowniczy. Żyją tylko we dwóch, próbując radzić sobie z samotnością i uczuciem złości, które towarzyszą im po śmierci mamy Teo. Pewnego dnia chłopiec spotyka Ro – magiczne stworzenie, które przypomina pierzastego latającego dinozaura. Stopniowo Ro staje się sekretnym przyjacielem chłopca, a zarazem jedynym kompanem, towarzysząc tego w codziennych zmaganiach i trudnościach w nowej szkole i mieście.","popularity":1.0347,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6830b746fca5da67032b6714","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/pJlPRzus9xdajjVAWdydiY7sbR2.jpg","genre_ids":[16,10751,14,12],"id":1277047,"title":"Chłopiec na krańcach świata","original_language":"pl","original_title":"Chłopiec na krańcach świata","overview":"Dziesięcioletni Omul razem z rodzicami, bratem Mikro i młodszą siostrą Kimi żyje w nadmorskim miasteczku Krimo. Pewnego dnia Omul z Kimi bawią się na plaży. Nagle pogoda diametralnie się zmienia i nad wyspę nadciąga ogromna fala, która porywa dzieci w ciemną otchłań. Pod wodą Omul widzi, jak tajemnicza istota Sadumea – o której krążą liczne legendy – wysysa z małej Kimi duszę. Rodzeństwo zostaje w ostatnim momencie uratowane przez wieloryba. Omul budzi się w szpitalu i dowiaduje się, że Kimi jest w stanie śpiączki. Mikro wraz z Omulem i sympatyczną suczką Telą postanawiają wyruszyć w niebezpieczną podróż, aby uratować duszę swojej ukochanej siostry.","popularity":1.7595,"poster_path":"/kbaNDWXbHvdnWc7ac7CzwQngYvd.jpg","release_date":"2026-06-26","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"68c2e74924af1eee5498d475","department":"Directing","job":"Director"}],"id":2697894}