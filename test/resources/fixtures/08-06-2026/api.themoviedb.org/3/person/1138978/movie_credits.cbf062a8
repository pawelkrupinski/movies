 od switu do zmierzchu","original_language":"pl","original_title":"Swiat od switu do zmierzchu","overview":"","popularity":0.3558,"poster_path":null,"release_date":"2011-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"68d90e77ae0cc1d38ac76150","department":"Directing","job":"Director"}],"id":1138978}