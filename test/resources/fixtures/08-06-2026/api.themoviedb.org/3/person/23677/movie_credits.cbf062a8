ieje co chce. Dowiesz się, co naprawdę znaczy określenie \"szanse\". Ten film trafi do serca każdego, kto kiedykolwiek pomyślał: \"skoro trafiło się ślepej kurze, to czemu nie człowiekowi?\"","popularity":2.614,"poster_path":"/t5sJfj99wACezWFz2jtHQplQkUM.jpg","release_date":"1989-08-18","softcore":false,"video":false,"vote_average":6.299,"vote_count":97,"credit_id":"52fe47bb9251416c750a3a59","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/2VLAiouyOjzECNS8qxq2uNEm6vL.jpg","genre_ids":[10402],"id":45865,"title":"Michael Jackson Video Greatest Hits: HIStory","original_language":"en","original_title":"Michael Jackson Video Greatest Hits: HIStory","overview":"","popularity":1.2935,"poster_path":"/dwFypaBerRmRV8plaZ7AU1JqROg.jpg","release_date":"1995-07-16","softcore":false,"video":true,"vote_average":8.368,"vote_count":68,"credit_id":"66928e02e319a5a928424993","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ikRYBFEruestEXSYdZhtFs15dQ4.jpg","genre_ids":[99],"id":522822,"title":"The King of Ads","original_language":"en","original_title":"The King of Ads","overview":"","popularity":1.4907,"poster_path":"/t7b1XzaPVeFcMQH9obio0mK7yO4.jpg","release_date":"1991-11-01","softcore":false,"video":true,"vote_average":4.3,"vote_count":10,"credit_id":"5f726176d55e4d00367de753","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8IQb7JHS8yrFPO2SEeISGydWwNY.jpg","genre_ids":[10402],"id":267246,"title":"Michael Jackson: Dangerous - The Short Films","original_language":"en","original_title":"Michael Jackson: Dangerous - The Short Films","overview":"","popularity":1.7729,"poster_path":"/5wqvRs93dk8knxUbuKKOFBVwf4q.jpg","release_date":"1993-09-28","softcore":false,"video":true,"vote_average":8.2,"vote_count":41,"credit_id":"66fb42d6be8ad187d5a65a1e","department":"Directing","job":"Director"}],"id":23677}