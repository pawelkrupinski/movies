":0.9731,"poster_path":"/n8YCIlWEDcz9ZMXUWUykjOp4dyT.jpg","release_date":"2008-10-21","softcore":false,"video":false,"vote_average":6.9,"vote_count":7,"character":"Self","credit_id":"5ba57cbd925141274f0009c8","order":13},{"adult":false,"backdrop_path":null,"genre_ids":[99,18],"id":692277,"title":"Finding the Truth: The Making of 'Kramer vs. Kramer'","original_language":"en","original_title":"Finding the Truth: The Making of 'Kramer vs. Kramer'","overview":"","popularity":0.7071,"poster_path":"/xnUvKh9Hd0V8e0Nhs1RdPzB6doO.jpg","release_date":"2001-02-20","softcore":false,"video":false,"vote_average":5.0,"vote_count":5,"character":"Self","credit_id":"5e92850284448e00128f6bf9","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":714849,"title":"Godard Made in USA","original_language":"en","original_title":"Godard Made in USA","overview":"","popularity":0.8646,"poster_path":"/cRIdPe6VxHrtnm36Q8GLx7duvcX.jpg","release_date":"2010-12-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"5ee32a1397eab4001fe1d5ed","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":854414,"title":"You Will Believe: The Cinematic Saga of Superman","original_language":"en","original_title":"You Will Believe: The Cinematic Saga of Superman","overview":"","popularity":0.6844,"poster_path":"/ixZn97gsbIbi5Ayxmsm2ecFlDAt.jpg","release_date":"2006-11-28","softcore":false,"video":false,"vote_average":6.0,"vote_count":5,"character":"Self","credit_id":"60fec9e72fdec6005de0f0bc","order":5}],"crew":[{"adult":false,"backdrop_path":"/p2zBTOd4JdmNhkRWHmjKg7hk3s1.jpg","genre_ids":[878,28,12],"id":1924,"title":"Superman","original_language":"en","original_title":"Superman","overview":"Superman jest obdarzony nadludzkimi mocami przybyszem z planety Krypton, który na co dzień wciela się w Clarka Kenta, skromnego dziennikarza z popularnej gazety. Nadchodzi jednak czas, gdy musi zmierzyć się ze swym największym wrogiem - Lexem Luthorem, złoczyńcą, który pragnie przejąć władzę nad światem.","popularity":15.3637,"poster_path":"/d7px1FQxW4tngdACVRsCSaZq0Xl.jpg","release_date":"1978-12-14","softcore":false,"video":false,"vote_average":7.162,"vote_count":4351,"credit_id":"52fe4322c3a36847f803ce69","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/dCX2wx2z7KmizfQpJZRUrprW9j.jpg","genre_ids":[18,10749],"id":10922,"title":"Piętno","original_language":"en","original_title":"The Human Stain","overview":"Ameryka końca lat 90. Coleman Silk, owdowiały dziekan wydziału literatury klasycznej w Atena College, wdaje się w romans ze sprzątaczką, Faunią Farley. Choć Silk jest Murzynem, dzięki jasnemu kolorowi skóry i nordyckim rysom zawsze uchodził za białego. Podawał się za Żyda, zerwawszy kontakty z rodziną, która mogłaby utrudnić jego awans. Osamotniony mężczyzna odnajduje bratnią duszę w skrzywdzonej przez życie Faunii. Młoda kobieta straciła tragicznie dwoje dzieci. Zmieniając miejsca zamieszkania, ucieka przez maltretującym ją mężem.","popularity":3.111,"poster_path":"/5jck4EvhrvqRiZByFnxIKloqZBt.jpg","release_date":"2003-10-29","softcore":false,"video":false,"vote_average":5.999,"vote_count":513,"credit_id":"52fe43d19251416c7501f5c5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sY5U9A21r93qT7hbEDLFWMEM4b0.jpg","genre_ids":[18,35],"id":11593,"title":"Naiwniak","original_language":"en","original_title":"Nobody's Fool","overview":"Donald Sullivan, dla przyjaciół Sully, to prosty i nieco zagubiony mężczyzna z prowincjonalnego miasteczka w stanie Nowy Jork. Mimo, że jest już w wieku emerytalnym, zachował duszę nastolatka. Chętnie flirtuje z młodszymi o połowę kobietami - na przykład z żoną swojego szefa, Carla, dla którego czasami Sully pracuje dorywczo na budowach. Pewnego dnia w miasteczku pojawia się niespodziewanie jego porzucony syn. Zaskoczony Sully odkrywa, że ma wnuka, który nigdy o nim nie słyszał i... postanawia nadrobić stracony czas. Jednak nauczenie się jak być ojcem i dziadkiem to poważne wyzwanie.","popularity":3.1941,"poster_path":"/vggDM36HdZu2Kw2czZO53K8W14K.jpg","release_date":"1994-12-23","softcore":false,"video":false,"vote_average":6.891,"vote_count":350,"credit_id":"52fe44629251416c75032dbd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sY5U9A21r93qT7hbEDLFWMEM4b0.jpg","genre_ids":[18,35],"id":11593,"title":"Naiwniak","original_language":"en","original_title":"Nobody's Fool","overview":"Donald Sullivan, dla przyjaciół Sully, to prosty i nieco zagubiony mężczyzna z prowincjonalnego miasteczka w stanie Nowy Jork. Mimo, że jest już w wieku emerytalnym, zachował duszę nastolatka. Chętnie flirtuje z młodszymi o połowę kobietami - na przykład z żoną swojego szefa, Carla, dla którego czasami Sully pracuje dorywczo na budowach. Pewnego dnia w miasteczku pojawia się niespodziewanie jego porzucony syn. Zaskoczony Sully odkrywa, że ma wnuka, który nigdy o nim nie słyszał i... postanawia nadrobić stracony czas. Jednak nauczenie się jak być ojcem i dziadkiem to poważne wyzwanie.","popularity":3.1941,"poster_path":"/vggDM36HdZu2Kw2czZO53K8W14K.jpg","release_date":"1994-12-23","softcore":false,"video":false,"vote_average":6.891,"vote_count":350,"credit_id":"52fe44629251416c75032dcf","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/lDeH6UkNGX2UcaOKTJ5SHtmNwbD.jpg","genre_ids":[35,80,10749],"id":6949,"title":"No i co, doktorku?","original_language":"en","original_title":"What's Up, Doc?","overview":"Howard Bannister przybywa do San Francisco ze swoją narzeczoną, Eunice, aby ubiegać się o stypendium z muzykologii. Poznaje tam tajemniczą kobietę, która okazuje się \"siać spustoszenie i chaos gdziekolwiek się pojawi\". Do tego dochodzą sprawy zamienionego bagażu, grupy agentów rządowych, skradzionej biżuterii, i kilka ciekawych zwrotów fabuły.","popularity":2.2203,"poster_path":"/d5WwZxneeAH2Kj2SeDV6oUY2oW0.jpg","release_date":"1972-03-09","softcore":false,"video":false,"vote_average":7.4,"vote_count":464,"credit_id":"52fe4469c3a36847f809493f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/a2kzu1bfp9RWQLlK3TtsIRqZn5X.jpg","genre_ids":[53,18,9648],"id":32048,"title":"W nocnej ciszy","original_language":"en","original_title":"Still of the Night","overview":"Pacjent nowojorskiego psychiatry Sama Rice’a (Roy Scheider), pracownik domu aukcyjnego George Bynum (Josef Sommer), zostaje brutalnie zamordowany. U lekarza zjawiają się współpracowniczka i kochanka Bynuma – Brooke Reynolds (Meryl Streep) oraz zajmujący się sprawą detektyw Joseph Vitucci (Joe Grifasi). Rice zaczyna przeglądać notatki z prowadzonych z Bynumem sesji. Zaintrygowany, postanawia na własną rękę dowiedzieć się, kto jest odpowiedzialny za zbrodnię. Niespodziewanie też coraz bardziej zafascynowany jest enigmatyczną i piękną Brooke. Wciągający thriller psychologiczny o tajemniczym morderstwie, którego ofiarą pada pracownik domu aukcyjnego. Sprawę próbuje rozwikłać nowojorski psychiatra, u którego mężczyzna się leczył. [cinemax.pl]","popularity":2.1648,"poster_path":"/qRTOsV47tfFIWF5QUx5KJtDPQwV.jpg","release_date":"1982-11-19","softcore":false,"video":false,"vote_average":5.721,"vote_count":165,"credit_id":"52fe44b59251416c9101a0e3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/pbr9NcP5HWyEZbp67qObIEyNVQ7.jpg","genre_ids":[37,18],"id":31591,"title":"Bad Company","original_language":"en","original_title":"Bad Company","overview":"","popularity":1.8214,"poster_path":"/8UpEdkJmdjwQb6OJJyPRSMf80v6.jpg","release_date":"1972-10-08","softcore":false,"video":false,"vote_average":6.422,"vote_count":102,"credit_id":"52fe448c9251416c91014881","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9pUh1fC8TqVtYPeKpdfNyVK0qnn.jpg","genre_ids":[18],"id":12102,"title":"Sprawa Kramerów","original_language":"en","original_title":"Kramer vs. Kramer","overview":"Ted Kramer jest mężem i ojcem, całkowicie pochłoniętym karierą zawodową. Jego żonę Joannę męczy taki stan rzeczy, dlatego decyduje się go porzucić. Pod opieką męża zostawia 7-letniego synka, Billy'ego. Początkowo Ted nie może odnaleźć się w nowej roli. Trudno jest mu pogodzić pracę zawodową z wychowywaniem dziecka. Jednak pomimo trudności udaje mu się zaprzyjaźnić z synem i stworzyć prawdziwy, pełen bezpieczeństwa dom. Tymczasem Joanna zmienia zdanie i chce za wszelką cenę odzyskać chłopca. Ted nie zamierza jednak rezygnować z syna. Sprawa trafia do sądu.","popularity":5.8066,"poster_path":"/eudLup3uoKfDyqYb3Mt8aJuV107.jpg","release_date":"1979-12-07","softcore":false,"video":false,"vote_average":7.566,"vote_count":2499,"credit_id":"52fe44b49251416c7503e30d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/9pUh1fC8TqVtYPeKpdfNyVK0qnn.jpg","genre_ids":[18],"id":12102,"title":"Sprawa Kramerów","original_language":"en","original_title":"Kramer vs. Kramer","overview":"Ted Kramer jest mężem i ojcem, całkowicie pochłoniętym karierą zawodową. Jego żonę Joannę męczy taki stan rzeczy, dlatego decyduje się go porzucić. Pod opieką męża zostawia 7-letniego synka, Billy'ego. Początkowo Ted nie może odnaleźć się w nowej roli. Trudno jest mu pogodzić pracę zawodową z wychowywaniem dziecka. Jednak pomimo trudności udaje mu się zaprzyjaźnić z synem i stworzyć prawdziwy, pełen bezpieczeństwa dom. Tymczasem Joanna zmienia zdanie i chce za wszelką cenę odzyskać chłopca. Ted nie zamierza jednak rezygnować z syna. Sprawa trafia do sądu.","popularity":5.8066,"poster_path":"/eudLup3uoKfDyqYb3Mt8aJuV107.jpg","release_date":"1979-12-07","softcore":false,"video":false,"vote_average":7.566,"vote_count":2499,"credit_id":"52fe44b49251416c7503e307","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/a2kzu1bfp9RWQLlK3TtsIRqZn5X.jpg","genre_ids":[53,18,9648],"id":32048,"title":"W nocnej ciszy","original_language":"en","original_title":"Still of the Night","overview":"Pacjent nowojorskiego psychiatry Sama Rice’a (Roy Scheider), pracownik domu aukcyjnego George Bynum (Josef Sommer), zostaje brutalnie zamordowany. U lekarza zjawiają się współpracowniczka i kochanka Bynuma – Brooke Reynolds (Meryl Streep) oraz zajmujący się sprawą detektyw Joseph Vitucci (Joe Grifasi). Rice zaczyna przeglądać notatki z prowadzonych z Bynumem sesji. Zaintrygowany, postanawia na własną rękę dowiedzieć się, kto jest odpowiedzialny za zbrodnię. Niespodziewanie też coraz bardziej zafascynowany jest enigmatyczną i piękną Brooke. Wciągający thriller psychologiczny o tajemniczym morderstwie, którego ofiarą pada pracownik domu aukcyjnego. Sprawę próbuje rozwikłać nowojorski psychiatra, u którego mężczyzna się leczył. [cinemax.pl]","popularity":2.1648,"poster_path":"/qRTOsV47tfFIWF5QUx5KJtDPQwV.jpg","release_date":"1982-11-19","softcore":false,"video":false,"vote_average":5.721,"vote_count":165,"credit_id":"52fe44b59251416c9101a0ef","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/a2kzu1bfp9RWQLlK3TtsIRqZn5X.jpg","genre_ids":[53,18,9648],"id":32048,"title":"W nocnej ciszy","original_language":"en","original_title":"Still of the Night","overview":"Pacjent nowojorskiego psychiatry Sama Rice’a (Roy Scheider), pracownik domu aukcyjnego George Bynum (Josef Sommer), zostaje brutalnie zamordowany. U lekarza zjawiają się współpracowniczka i kochanka Bynuma – Brooke Reynolds (Meryl Streep) oraz zajmujący się sprawą detektyw Joseph Vitucci (Joe Grifasi). Rice zaczyna przeglądać notatki z prowadzonych z Bynumem sesji. Zaintrygowany, postanawia na własną rękę dowiedzieć się, kto jest odpowiedzialny za zbrodnię. Niespodziewanie też coraz bardziej zafascynowany jest enigmatyczną i piękną Brooke. Wciągający thriller psychologiczny o tajemniczym morderstwie, którego ofiarą pada pracownik domu aukcyjnego. Sprawę próbuje rozwikłać nowojorski psychiatra, u którego mężczyzna się leczył. [cinemax.pl]","popularity":2.1648,"poster_path":"/qRTOsV47tfFIWF5QUx5KJtDPQwV.jpg","release_date":"1982-11-19","softcore":false,"video":false,"vote_average":5.721,"vote_count":165,"credit_id":"52fe44b59251416c9101a0e9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/xDVSIYTtAEauO85vZ6GPdJZOnwD.jpg","genre_ids":[80,53],"id":26269,"title":"Półmrok","original_language":"en","original_title":"Twilight","overview":"Harry Ross (Paul Newman), emerytowany prywatny detektyw, przyjaźni się z hollywoodzkimi aktorami, małżeństwem Catherine (Susan Sarandon) i Jackiem (Gene Hackman) Amesami. Spełniając ich prośbę Harry dostarcza pod wskazany przez nich adres tajemniczą przesyłkę. Wkrótce detektyw poznaje niejasne okoliczności śmierci poprzedniego męża artystki...[filmweb.pl]","popularity":2.1302,"poster_path":"/jepRBZNXgsINrbtSiSEdtCYbRMM.jpg","release_date":"1998-03-06","softcore":false,"video":false,"vote_average":6.102,"vote_count":225,"credit_id":"52fe44f7c3a368484e04105f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xDVSIYTtAEauO85vZ6GPdJZOnwD.jpg","genre_ids":[80,53],"id":26269,"title":"Półmrok","original_language":"en","original_title":"Twilight","overview":"Harry Ross (Paul Newman), emerytowany prywatny detektyw, przyjaźni się z hollywoodzkimi aktorami, małżeństwem Catherine (Susan Sarandon) i Jackiem (Gene Hackman) Amesami. Spełniając ich prośbę Harry dostarcza pod wskazany przez nich adres tajemniczą przesyłkę. Wkrótce detektyw poznaje niejasne okoliczności śmierci poprzedniego męża artystki...[filmweb.pl]","popularity":2.1302,"poster_path":"/jepRBZNXgsINrbtSiSEdtCYbRMM.jpg","release_date":"1998-03-06","softcore":false,"video":false,"vote_average":6.102,"vote_count":225,"credit_id":"52fe44f7c3a368484e041065","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/aJd3j8MOg7EfhIAl3WeWiDS9xjd.jpg","genre_ids":[37],"id":27172,"title":"Był Sobie Łajdak","original_language":"en","original_title":"There Was a Crooked Man...","overview":"Bandyta Paris Pittman Jr. (Kirk Douglas) napada ze swoją bandą na dom bogatego farmera. Kradnie dużą sumę pieniędzy, którą następnie ukrywa w skalnej rozpadlinie, gdzie znajduje się gniazdo jadowitych węży. Wkrótce potem zostaje rozpoznany i trafia do więzienia na pustyni w Arizonie, którym kieruje Warden LeGoff (Martin Gabel). Paris szybko zjednuje sobie zaufanie towarzyszy niedoli i staje na czele buntu. Gdy udaje mu się uciec, jedzie w góry, by dotrzeć do ukrytych pieniędzy. Jego śladem podąża nowy naczelnik więzienia Woodward Lopeman (Henry Fonda).","popularity":1.8123,"poster_path":"/l4mUOh7ZCBqR6OzXUgmFOUTyNtN.jpg","release_date":"1970-09-18","softcore":false,"video":false,"vote_average":6.826,"vote_count":139,"credit_id":"52fe4531c3a368484e04d6ff","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/dDetOS2oUNIIoEZHgpXjUaMBE5Y.jpg","genre_ids":[80],"id":12647,"title":"Billy Bathgate","original_language":"en","original_title":"Billy Bathgate","overview":"Rok 1935, czasy amerykańskiego kryzysu ekonomicznego. Nastolatek Billy Bathgate (Loren Dean) jest mieszkańcem nowojorskich slumsów w dzielnicy Bronx. Splot pewnych wydarzeń sprawia, że dołącza do gangu groźnego gangstera Dutcha Schultza (Dustin Hoffman). Szybko wkupuje się w szeregi i zdobywa pełne zaufanie mafioza. Poznając dogłębnie światek mafii, przestępstw i nielegalnych interesów, szybko zdobywa uznanie i pieniądze. Sprawy przybierają niecodzienny obrót, gdy Schultz powierza chłopakowi ochronę pięknej Drew Preston (Nicole Kidman). Billy szybko ulega wdziękowi kobiety, czym może narazić się na duże kłopoty.","popularity":2.7882,"poster_path":"/zDC0bY6IvGIf1SrDipLZJxR0Z2d.jpg","release_date":"1991-11-01","softcore":false,"video":false,"vote_average":5.782,"vote_count":243,"credit_id":"52fe450e9251416c7504a31b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/r9XdfG1tqspRP5s0ir9zf5TIf0J.jpg","genre_ids":[18],"id":13681,"title":"Miejsca w sercu","original_language":"en","original_title":"Places in the Heart","overview":"Ameryka, rok 1935. Ginie szeryf teksańskiego miasteczka. Wdowa po zmarłym, Edna Spalding, zostaje z dwójką dzieci bez środków do życia. Znajomy bankier proponuje, by kobieta sprzedała farmę, ale ona nie chce pozbawić dzieci domu. Przyjmuje pomoc czarnoskórego włóczęgi, Moze, który obiecuje rozwinąć uprawę bawełny. Rodzinna farma powoli rozkwita, Edna uzyskuje niezłą sumę za zbiory. Lecz miejscowi niechętnym okiem patrzą na zażyłość białej farmerki i czarnoskórego robotnika. Zazdrośni kupcy, przebrani w stroje Ku-Klux-Klanu, napadają na farmę.","popularity":4.0945,"poster_path":"/9u0b7KGKOnSlC4HUz9gXu1cntrI.jpg","release_date":"1984-09-11","softcore":false,"video":false,"vote_average":7.168,"vote_count":197,"credit_id":"52fe458b9251416c7505a261","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/krC37EnKGPLTa1MMEVpi45wicDc.jpg","genre_ids":[10749,18],"id":14313,"title":"Smaki miłości","original_language":"en","original_title":"Feast of Love","overview":"Kronika miłości - szalonej, złej, a także i takiej, która trwa kiedy wszystko inne przemija. Bradley, właściciel kawiarni, Chloe - młoda kelnerka, sąsiad, profesor filozofii i jego żona Esther opowiadają swoje historie i komentują historie innych. Manifest niezwykłej miłości pośród zwykłych ludzi.","popularity":2.7197,"poster_path":"/6Uyl94M1Yi8U0o6GddMRqAfa466.jpg","release_date":"2007-09-28","softcore":false,"video":false,"vote_average":6.2,"vote_count":269,"credit_id":"52fe45e69251416c75066365","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/vpqh9HXaadKp7RBIxphzeaTbdfW.jpg","genre_ids":[9648,80,35,53],"id":42228,"title":"The Late Show","original_language":"en","original_title":"The Late Show","overview":"","popularity":1.1896,"poster_path":"/qii8jbAjid9MzBx7tUJf7URf8LO.jpg","release_date":"1977-02-10","softcore":false,"video":false,"vote_average":6.3,"vote_count":67,"credit_id":"52fe45f6c3a36847f80e471d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/AgiBouLTSIFvpfBPP2R5b9wH7Xh.jpg","genre_ids":[10749,35,80,28],"id":61178,"title":"Nadine","original_language":"en","original_title":"Nadine","overview":"","popularity":1.496,"poster_path":"/mim8TLLXmD3ui03f9jVmOXGACv8.jpg","release_date":"1987-08-07","softcore":false,"video":false,"vote_average":5.432,"vote_count":95,"credit_id":"52fe4648c3a368484e088379","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/iaFJhWmuTED2Vqs0WQ1w7ETQ5EB.jpg","genre_ids":[18,53],"id":75889,"title":"Dom przy Carroll Street","original_language":"en","original_title":"The House on Carroll Street","overview":"Waszyngton, rok 1951. Emily Crane (Kelly McGillis) zostaje zwolniona z pracy, kiedy pada na nią podejrzenie o popieranie komunizmu. Tym samym jej wszelkie szanse na karierę zostają przekreślone. Emily zatrudnia się jako opiekunka pewnej starszej pani. Jej uwagę przykuwają sąsiedzi staruszki rozmawiający ze sobą głównie po niemiecku. Wraz z agentem FBI wyznaczonym do obserwacji \"komunistki\" (Jeff Daniels), Emily odkrywa przerażającą prawdę: sąsiedzi są nazistowskimi zbrodniarzami, a w sprowadzenie ich do kraju zaangażowani są wysoko postawieni amerykańscy urzędnicy.","popularity":1.9612,"poster_path":"/4g7F2nJhxWTFx83DXBoD8hOtRE.jpg","release_date":"1988-03-04","softcore":false,"video":false,"vote_average":5.898,"vote_count":59,"credit_id":"61026322a84a470080e4da72","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/AgiBouLTSIFvpfBPP2R5b9wH7Xh.jpg","genre_ids":[10749,35,80,28],"id":61178,"title":"Nadine","original_language":"en","original_title":"Nadine","overview":"","popularity":1.496,"poster_path":"/mim8TLLXmD3ui03f9jVmOXGACv8.jpg","release_date":"1987-08-07","softcore":false,"video":false,"vote_average":5.432,"vote_count":95,"credit_id":"555b3fa4c3a36810890022bd","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/qDEU8UwN07cz689uErkWtMlok0m.jpg","genre_ids":[80,35,18,53],"id":9005,"title":"Zimne dranie","original_language":"en","original_title":"The Ice Harvest","overview":"Charlie Arglist, właściciel niezbyt dochodowej firmy prawniczej, i jego kompan Vic tuż przed świętami Bożego Narodzenia decydują się na wielki przekręt. Przy użyciu prostej sztuczki kradną z konta szefa mafii dwa miliony dolarów. Zgodnie z planem kilka godzin później mają zniknąć z Wichita, małego miasteczka w Kansas, ale burza śnieżna niweczy ucieczkę. W mieście zatrzymuje ich też piękna właścicielka klubu nocnego, Renata, którą Charlie chętnie wywiózłby wraz z pieniędzmi. Tymczasem mafia zauważa pustki na koncie.","popularity":2.1531,"poster_path":"/1dq1h54clRLpfAhHQaz6tuNjmNW.jpg","release_date":"2005-11-23","softcore":false,"video":false,"vote_average":5.932,"vote_count":340,"credit_id":"61bd8f6a3f8ede0095ef54fc","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1034846,"title":"A Texas Romance, 1909","original_language":"en","original_title":"A Texas Romance, 1909","overview":"","popularity":0.6232,"poster_path":"/w9BqKHsJQX8mwqo1GRVFTynHfVI.jpg","release_date":"1964-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"63475d5bd55c3d0091b65c46","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6u7obpCvewJJLlBG1Qs4jsVHZBY.jpg","genre_ids":[35,10402],"id":279710,"title":"Oh! Calcutta!","original_language":"en","original_title":"Oh! Calcutta!","overview":"","popularity":1.6947,"poster_path":"/xVlqivssI2IRK8s8qPyzpHRueCL.jpg","release_date":"1972-06-01","softcore":false,"video":false,"vote_average":3.444,"vote_count":9,"credit_id":"664bc808dd770afc84f70d7e","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/kdtnx8vsWVTdxQ5xzJjTAFcUYYV.jpg","genre_ids":[35,10770,878,28,10402],"id":142064,"title":"It's a Bird, It's a Plane, It's Superman!","original_language":"en","original_title":"It's a Bird, It's a Plane, It's Superman!","overvie