lRLpfAhHQaz6tuNjmNW.jpg","release_date":"2005-11-23","softcore":false,"video":false,"vote_average":5.932,"vote_count":340,"credit_id":"5c244adc925141457dbeeb7a","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/fyzSiE8IWezmd3ls1amHNeOkrEf.jpg","genre_ids":[80,18],"id":475,"title":"Bonnie i Clyde","original_language":"en","original_title":"Bonnie and Clyde","overview":"Bonnie Parker i Clyde Barrow to para kochanków, a przede wszystkim duet gangsterów i morderców doby wielkiego kryzysu. Bonnie poznała Clyde'a w kilka dni po tym, jak opuścił więzienie. Okoliczności poznania nie należały jednak do romantycznych. Clyde został nakryty na próbie ukradzenia samochodu matki Bonnie. Ich gangsterski duet szybko stał się sławny. Przez pewien czas bardzo zręcznie udawało im się wyprowadzać w pole ścigającą ich po całych Stanach policję. Nadszedł jednak dzień, gdy wpadli w zasadzkę, a sposób, w jaki zginęli, dopełnił ich legendę.","popularity":6.1549,"poster_path":"/oygVjDxi6oT1UGPPY3HxL7WMlyu.jpg","release_date":"1967-08-13","softcore":false,"video":false,"vote_average":7.49,"vote_count":1819,"credit_id":"5d83f068a284eb023aeb5586","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/kdtnx8vsWVTdxQ5xzJjTAFcUYYV.jpg","genre_ids":[35,10770,878,28,10402],"id":142064,"title":"It's a Bird, It's a Plane, It's Superman!","original_language":"en","original_title":"It's a Bird, It's a Plane, It's Superman!","overview":"","popularity":1.0393,"poster_path":"/3gX8k0zksgycB2HOuGCa7n30eOe.jpg","release_date":"1975-02-21","softcore":false,"video":false,"vote_average":4.4,"vote_count":15,"credit_id":"6022ec42edeb43003f351e56","department":"Writing","job":"Theatre Play"},{"adult":false,"backdrop_path":"/vpqh9HXaadKp7RBIxphzeaTbdfW.jpg","genre_ids":[9648,80,35,53],"id":42228,"title":"The Late Show","original_language":"en","original_title":"The Late Show","overview":"","popularity":1.1896,"poster_path":"/qii8jbAjid9MzBx7tUJf7URf8LO.jpg","release_date":"