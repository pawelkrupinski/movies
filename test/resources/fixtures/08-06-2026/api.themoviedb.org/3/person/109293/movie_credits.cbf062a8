{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1269358,"title":"Cinemaguerilla","original_language":"en","original_title":"Cinemaguerilla","overview":"","popularity":0.4203,"poster_path":"/xK36MHxFJ2kZ4SyKi7BmbcMxZNf.jpg","release_date":"2009-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"660e7af9d400f30164065a15","order":28},{"adult":false,"backdrop_path":"/y0G8kJPfFSBGHG2dhvuVkDuoOLB.jpg","genre_ids":[99,36],"id":257376,"title":"Al doilea joc","original_language":"ro","original_title":"Al doilea joc","overview":"","popularity":1.0938,"poster_path":"/aowLGBg84kc5CxJh8TGsMQtc863.jpg","release_date":"2014-02-11","softcore":false,"video":false,"vote_average":5.6,"vote_count":10,"character":"Himself","credit_id":"58f35db2c3a36807df00f7ef","order":1},{"adult":false,"backdrop_path":"/sghWCSzT3OqRAt7dtWLz7unXgL8.jpg","genre_ids":[99],"id":499558,"title":"Fotbal infinit","original_language":"ro","original_title":"Fotbal infinit","overview":"","popularity":1.297,"poster_path":"/4cU1w6Twn15TKgipz4iMolAoPzM.jpg","release_date":"2018-03-09","softcore":false,"video":false,"vote_average":6.313,"vote_count":16,"character":"Himself","credit_id":"5aa5adf99251412787028ee9","order":1}],"crew":[{"adult":false,"backdrop_path":"/ttTmzzIeaOvYWouvg3iWJHEldF4.jpg","genre_ids":[35,18],"id":24159,"title":"12:08 na wschód od Bukaresztu","original_language":"ro","original_title":"A fost sau n-a fost?","overview":"Od czasu kiedy wściekły tłum zmusił rumuńskiego dyktatora Ceausescu do ucieczki śmigłowcem z Bukaresztu minęło 16 lat. W rocznicę tych wydarzeń właściciel lokalnej stacji telewizyjnej zaprasza dwóch gości, by odtworzyć z nimi chwile rewolucyjnej chwały. Emeryta, dorabiającego jako Święty Mikołaj, i nauczyciela historii, który właśnie oddał całą wypłatę za długi alkoholowe. Razem będą wspominać dzień, w którym szturmowali rządowy budynek krzycząc: \"Precz z Ceauşescu!\" Ale telewidzowie podają w wątpliwość opowieści bohaterów, którzy być może popijali wtedy w barze lub przygotowywali się do świąt, zamiast wyjść na ulice. Okraszony czarnym humorem doskonały debiut pokazujący, jak fakty stają się historycznymi mitami.","popularity":1.0199,"poster_path":"/cAJLx5ejcsN2HpIfEJd6jDbCZfH.jpg","release_date":"2006-09-29","softcore":false,"video":false,"vote_average":6.903,"vote_count":124,"credit_id":"52fe4486c3a368484e027ed9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ttTmzzIeaOvYWouvg3iWJHEldF4.jpg","genre_ids":[35,18],"id":24159,"title":"12:08 na wschód od Bukaresztu","original_language":"ro","original_title":"A fost sau n-a fost?","overview":"Od czasu kiedy wściekły tłum zmusił rumuńskiego dyktatora Ceausescu do ucieczki śmigłowcem z Bukaresztu minęło 16 lat. W rocznicę tych wydarzeń właściciel lokalnej stacji telewizyjnej zaprasza dwóch gości, by odtworzyć z nimi chwile rewolucyjnej chwały. Emeryta, dorabiającego jako Święty Mikołaj, i nauczyciela historii, który właśnie oddał całą wypłatę za długi alkoholowe. Razem będą wspominać dzień, w którym szturmowali rządowy budynek krzycząc: \"Precz z Ceauşescu!\" Ale telewidzowie podają w wątpliwość opowieści bohaterów, którzy być może popijali wtedy w barze lub przygotowywali się do świąt, zamiast wyjść na ulice. Okraszony czarnym humorem doskonały debiut pokazujący, jak fakty stają się historycznymi mitami.","popularity":1.0199,"poster_path":"/cAJLx5ejcsN2HpIfEJd6jDbCZfH.jpg","release_date":"2006-09-29","softcore":false,"video":false,"vote_average":6.903,"vote_count":124,"credit_id":"52fe4486c3a368484e027eef","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/bzUJzGxmQdD3I7gFFLSalEN9ikx.jpg","genre_ids":[18,35,80],"id":32511,"title":"Polițist, adjectiv","original_language":"ro","original_title":"Polițist, adjectiv","overview":"","popularity":1.3748,"poster_path":"/hBZOI7BgQNxRjh0IUINfZuuMJad.jpg","release_date":"2010-01-14","softcore":false,"video":false,"vote_average":6.5