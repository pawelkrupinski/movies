ili, gdy jako młodzi ludzie zakochują się w sobie na zabój. Są przekonani, że miłość dana jest raz na zawsze i już do końca swoich dni będą szczęśliwi. Z biegiem czasu okazuje się jednak, że wspólne życie to nie tylko idylla, ale i mnóstwo trudnych chwil, z którymi niełatwo sobie poradzić. Tytułowi superbohaterowie walczą o utrzymanie związku, przechodząc przez różne, często skrajne, stany emocjonalne – bliskość i samotność, kłamstwa i uczuciowe rozterki, sekrety i zdrady.","popularity":1.6004,"poster_path":"/oDiqRgmWKfWYplyTXhKVdpvBRb8.jpg","release_date":"2021-12-23","softcore":false,"video":false,"vote_average":7.182,"vote_count":228,"credit_id":"61efdafddf2945001b8f01fc","department":"Writing","job":"Novel"},{"adult":false,"backdrop_path":"/isV94MOHL3BG4GrY2O2DLH2z2pO.jpg","genre_ids":[35,18,53],"id":833591,"title":"أصحاب... ولا أعزّ","original_language":"ar","original_title":"أصحاب... ولا أعزّ","overview":"","popularity":1.1479,"poster_path":"/aFoXZV1wY7LykyuZJPV0zoYRTdF.jpg","release_date":"2022-01-17","softcore":false,"video":false,"vote_average":6.018,"vote_count":84,"credit_id":"61efe17fdf294500e318a487","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":"/b3EHE8vWwZz47NGp1PObtsVvBO4.jpg","genre_ids":[18,35],"id":548352,"title":"완벽한 타인","original_language":"ko","original_title":"완벽한 타인","overview":"","popularity":1.5858,"poster_path":"/9lhxidWwP7iIyw1Zax9gUtdFZXT.jpg","release_date":"2018-10-31","softcore":false,"video":false,"vote_average":7.2,"vote_count":59,"credit_id":"61efdd4ae9da6900f42fd24d","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":"/lQlzgffotUtjyOb6GutId99N00M.jpg","genre_ids":[35,18,53],"id":699361,"title":"Tiệc Trăng Máu","original_language":"vi","original_title":"Tiệc Trăng Máu","overview":"","popularity":0.7364,"poster_path":"/1gtr8Js6yS7gWrQylbIK4sGQGih.jpg","release_date":"2020-10-23","softcore":false,"video":false,"vote_average":7.2,"vote_count":12,"credit_id":"61efde