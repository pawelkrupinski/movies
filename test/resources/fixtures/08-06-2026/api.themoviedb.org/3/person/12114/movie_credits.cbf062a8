:6.5,"vote_count":155,"character":"Miguel Cimino (segment: no translation needed)","credit_id":"6562c4387dfda6593174b860","order":64},{"adult":false,"backdrop_path":"/tOXDvsaPPYkkSzNYfgDugrXCvlG.jpg","genre_ids":[99],"id":1039896,"title":"Clint Eastwood, la dernière légende","original_language":"fr","original_title":"Clint Eastwood, la dernière légende","overview":"","popularity":1.5811,"poster_path":"/prgnnNUls4VuYPnny4JvDKxSZ8W.jpg","release_date":"2022-11-13","softcore":false,"video":false,"vote_average":7.25,"vote_count":22,"character":"Self (archive footage)","credit_id":"6372812f2b1b4400ce48415e","order":5},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":136439,"title":"Une Journée particulière","original_language":"en","original_title":"Une Journée particulière","overview":"","popularity":2.4647,"poster_path":"/4MMhKxab3sDx4VrqGnhIMX0kGV3.jpg","release_date":"2012-05-16","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"character":"Self","credit_id":"5ad6ac93c3a36847d5003412","order":4},{"adult":false,"backdrop_path":null,"genre_ids":[99,10770],"id":241168,"title":"Clint Eastwood: The Man from Malpaso","original_language":"en","original_title":"Clint Eastwood: The Man from Malpaso","overview":"","popularity":0.9255,"poster_path":"/9mUWf4oKs3JEGT6GP8hAzJaSu5C.jpg","release_date":"1994-12-11","softcore":false,"video":false,"vote_average":7.4,"vote_count":10,"character":"Self","credit_id":"603a4a8b5a07f551e452ad9b","order":6},{"adult":false,"backdrop_path":"/t78ggplDBjRwpgG1HPTyrqprbM3.jpg","genre_ids":[99],"id":833916,"title":"Michael Cimino, un mirage américain","original_language":"fr","original_title":"Michael Cimino, un mirage américain","overview":"","popularity":1.3639,"poster_path":"/gdPQam9v6SXH7YfVTNMeKWGESQE.jpg","release_date":"2022-01-19","softcore":false,"video":false,"vote_average":7.4,"vote_count":12,"character":"Self (archive footage)","credit_id":"68d6d7979dfaa2792dc75608","order":8},{"adult":false,"backdrop_path":"/zKpGdP8DBtWkKAOScKmsmD4o1gB.jpg","genre_ids":[99],"id":456599,"title":"The Fabulous Allan Carr","original_language":"en","original_title":"The Fabulous Allan Carr","overview":"","popularity":1.3264,"poster_path":"/bCRiYgxxt82r7Rpo1gNlkoJRuNB.jpg","release_date":"2017-05-19","softcore":false,"video":false,"vote_average":4.5,"vote_count":6,"character":"Self (archive)","credit_id":"6a12151cac5142880be3c03e","order":74}],"crew":[{"adult":false,"backdrop_path":"/5QTwfS9vcr22Nl7PCcUro7dEMFq.jpg","genre_ids":[12,878,18],"id":811,"title":"Niemy wyścig","original_language":"en","original_title":"Silent Running","overview":"Freeman Lowell (Bruce Dern) jest kierownikiem szklarni na jednej ze stacji orbitalnych, gdzie zajmuje się pielęgnowaniem próbek roślin oraz hodowaniem ginących gatunków. Jego praca ma pomóc w przywróceniu normalnego życia na Ziemi, które zostało zniszczone w wyniku wojny nuklearnej. Pewnego dnia Lowell otrzymuje wiadomość, że jego szklarnia ma zostać zniszczona. Zdesperowany, sprzeciwia się decyzji władz i postanawia zniweczyć każdą próbę naruszenia swego ekologicznego raju.","popularity":3.7064,"poster_path":"/ahasZ5HILZHtlrl6cbXgpfk0y8H.jpg","release_date":"1972-03-09","softcore":false,"video":false,"vote_average":6.389,"vote_count":649,"credit_id":"52fe427ac3a36847f8021a91","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/v0DsJiF7LAeJtqFObQfq3eU6rag.jpg","genre_ids":[18,37,36],"id":10935,"title":"Wrota Niebios","original_language":"en","original_title":"Heaven's Gate","overview":"Film oparty jest na prawdziwych wydarzeniach, jakie miały miejsce w stanie Wyoming w 1890 r. Opowiada o dramatycznych starciach pomiędy przybyszami z Europy Wschodniej a bezwzględnymi Amerykanami, budowniczymi Imperium, którzy chcą wyeliminować obcych.","popularity":3.8945,"poster_path":"/kW4Vk31nhtKPKGuYMaVATq3wcHC.jpg","release_date":"1980-11-19","softcore":false,"video":false,"vote_average":6.743,"vote_count":418,"credit_id":"52fe43d49251416c7501fcd3","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/v0DsJiF7LAeJtqFObQfq3eU6rag.jpg","genre_ids":[18,37,36],"id":10935,"title":"Wrota Niebios","original_language":"en","original_title":"Heaven's Gate","overview":"Film oparty jest na prawdziwych wydarzeniach, jakie miały miejsce w stanie Wyoming w 1890 r. Opowiada o dramatycznych starciach pomiędy przybyszami z Europy Wschodniej a bezwzględnymi Amerykanami, budowniczymi Imperium, którzy chcą wyeliminować obcych.","popularity":3.8945,"poster_path":"/kW4Vk31nhtKPKGuYMaVATq3wcHC.jpg","release_date":"1980-11-19","softcore":false,"video":false,"vote_average":6.743,"vote_count":418,"credit_id":"52fe43d49251416c7501fccd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7QPcmXePg5U4hmUzugFPX44ntxK.jpg","genre_ids":[18,80,28],"id":10648,"title":"Siła Magnum","original_language":"en","original_title":"Magnum Force","overview":"Przez San Francisco przetacza się fala morderstw ludzi z \"półświatka\". Przestępców, którym wielokrotnie udawało się uniknąć sprawiedliwości, dopada ona teraz bezlitośnie. Wydawać by się mogło, że detektyw Harry Callahan tylko się z tego ucieszy. Ale ci, którzy tak myślą, w tym sami zabójcy, srodze się zawiodą. W pomyślanym jako kontynuacja \"Brudnego Harry'ego\" filmie, którego scenariusz napisali przyszli reżyserzy John Milius i Michael Cimino, Clint Eastwood, ponownie wciela się w rolę kontrowersyjnego gliniarza, ale tym razem musi stawić czoła zupełnie nieoczekiwanemu przestępcy: noszącemu policyjną odznakę. Oto świetny na strzelnicy początkujący stróż prawa wybiera wymierzanie sprawiedliwości na własną rękę. I choć obaj będą walczyć nie tylko ze sobą, ale też z bezdusznymi procedurami, Harry nie zapomni, że w ostatecznym rozrachunku stoją one na straży społeczeństwa. I będzie ich bronić z Siłą Magnum.","popularity":5.4815,"poster_path":"/bHqH1dhqgihI6RquYiR5O7et37U.jpg","release_date":"1973-12-13","softcore":false,"video":false,"vote_average":7.112,"vote_count":1224,"credit_id":"52fe439b9251416c7501702d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/nE7p7AgZtRmQdEu7Z275f4729k2.jpg","genre_ids":[28,80,53],"id":11018,"title":"Rok smoka","original_language":"en","original_title":"Year of the Dragon","overview":"Nienawidzący Azjatów detektyw Stanley White przejmuje policyjny nadzór nad Chinatown. Wkrótce rozpoczyna śledztwo z powodu tajemniczych morderstw przywódców Triad.","popularity":3.1067,"poster_path":"/c8SfIgwR5mfu0c0qTBKbsvBfecJ.jpg","release_date":"1985-08-16","softcore":false,"video":false,"vote_average":6.793,"vote_count":495,"credit_id":"52fe43e49251416c750221bb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/nE7p7AgZtRmQdEu7Z275f4729k2.jpg","genre_ids":[28,80,53],"id":11018,"title":"Rok smoka","original_language":"en","original_title":"Year of the Dragon","overview":"Nienawidzący Azjatów detektyw Stanley White przejmuje policyjny nadzór nad Chinatown. Wkrótce rozpoczyna śledztwo z powodu tajemniczych morderstw przywódców Triad.","popularity":3.1067,"poster_path":"/c8SfIgwR5mfu0c0qTBKbsvBfecJ.jpg","release_date":"1985-08-16","softcore":false,"video":false,"vote_average":6.793,"vote_count":495,"credit_id":"52fe43e49251416c750221cd","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/gc1Y41h4Pfx9MyBKhTo7rtRC7xs.jpg","genre_ids":[53,80],"id":31676,"title":"Godziny rozpaczy","original_language":"en","original_title":"Desperate Hours","overview":"Kryminalista Michael Bosworth (Mickey Rourke), dzięki pomocy swego adwokata Nancy Breyers (Kelly Lynch), ucieka z pilnie strzeżonego więzienia. Chce koniecznie znaleźć się w Meksyku, lecz wcześniej trafia do domu czteroosobowej rodziny, biorąc ją za zakładników. Zdesperowany ojciec sterroryzowanej familii, Tim Cornell (Anthony Hopkins), zrobi wszystko, by uratować żonę Norę i dwoje małych dzieci.","popularity":2.4747,"poster_path":"/gtIRVVHRRr4iWN8yJ6tQs0CqWV2.jpg","release_date":"1990-10-05","softcore":false,"video":false,"vote_average":5.418,"vote_count":224,"credit_id":"52fe44969251416c91015fd1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/gZeAboSvbuqTsKyhjDUHpHAUqBl.jpg","genre_ids":[35,28,18,12],"id":8348,"title":"Piorun i Lekka Stopa","original_language":"en","original_title":"Thunderbolt and Lightfoot","overview":"Podczas nieudanego skoku początkujący kryminalista zwany Lekka Stopa (Jeff Bridges), wpada na niejakiego Pioruna (Clint Eastwood)- starego wyjadacza w branży. Uciekając przed ręką sprawiedliwości, obaj mężczyźni przemierzają amerykańskie bezkresy, gawędzą o rozmaitych, nie zawsze legalnych możliwościach zarobku, podrzucają autostopowiczów, by w końcu, chcąc nie chcąc się zaprzyjaźnić. Pioruna ujmuje za serce świeżość i prostolinijność Lekkiej Stopy, któremu z kolei stary wyga imponuje zimną krwią i znajomością życia.","popularity":3.4148,"poster_path":"/530RZ2HsxAgKVO4joNFjAgucbri.jpg","release_date":"1974-05-23","softcore":false,"video":false,"vote_average":6.796,"vote_count":656,"credit_id":"52fe44a1c3a36847f80a1179","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/gZeAboSvbuqTsKyhjDUHpHAUqBl.jpg","genre_ids":[35,28,18,12],"id":8348,"title":"Piorun i Lekka Stopa","original_language":"en","original_title":"Thunderbolt and Lightfoot","overview":"Podczas nieudanego skoku początkujący kryminalista zwany Lekka Stopa (Jeff Bridges), wpada na niejakiego Pioruna (Clint Eastwood)- starego wyjadacza w branży. Uciekając przed ręką sprawiedliwości, obaj mężczyźni przemierzają amerykańskie bezkresy, gawędzą o rozmaitych, nie zawsze legalnych możliwościach zarobku, podrzucają autostopowiczów, by w końcu, chcąc nie chcąc się zaprzyjaźnić. Pioruna ujmuje za serce świeżość i prostolinijność Lekkiej Stopy, któremu z kolei stary wyga imponuje zimną krwią i znajomością życia.","popularity":3.4148,"poster_path":"/530RZ2HsxAgKVO4joNFjAgucbri.jpg","release_date":"1974-05-23","softcore":false,"video":false,"vote_average":6.796,"vote_count":656,"credit_id":"52fe44a1c3a36847f80a117f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/qcxXFE9XEfnyUmAdbvtJqXYtAqc.jpg","genre_ids":[18,80,53],"id":31945,"title":"Sycylijczyk","original_language":"en","original_title":"The Sicilian","overview":"Salvatore Giuliano (Christopher Lambert) jest ubogim mieszkańcem Sycylii. Pewnego dnia zostaje ciężko ranny podczas strzelaniny. Mimo pesymistycznych rokowań, udaje mu się przeżyć. Salvatore dochodzi do wniosku, że dramatyczny epizod jest dla niego drogowskazem. Zaczyna pomagać ubogiej ludności, okradając bogatych. Wkrótce dochodzi do konfliktu między nim, a władzami i mafią. Giuliano ucieka w góry, gdzie organizuje armię. Posługuje się coraz bardziej brutalnymi metodami. Rządzący wydają na niego wyrok śmierci.","popularity":2.7449,"poster_path":"/wsd7fXujfmRoKUZeRjfMIqprB3t.jpg","release_date":"1987-10-07","softcore":false,"video":false,"vote_average":5.217,"vote_count":150,"credit_id":"52fe44ab9251416c91018b73","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/a5zBQfXmLk3qqRYF7AioWpiAxk2.jpg","genre_ids":[18,10752],"id":11778,"title":"Łowca jeleni","original_language":"en","original_title":"The Deer Hunter","overview":"Michael, Steven i Nick to młodzi pracownicy fabryki w Pensylwanii. Wszyscy dostają powołanie do wojska na wojnę w Wietnamie. Jeszcze przed wyjazdem Steven poślubia ciężarną Angelę, a ich przyjęcie ślubne jest zarazem przyjęciem pożegnalnym. Po pewnym czasie spędzonym w Wietnamie przyjaciele wpadają w pułapkę Vietcongu i trafiają do obozu jenieckiego, gdzie zostają zmuszeni do gry w rosyjską ruletkę między sobą.","popularity":10.6733,"poster_path":"/35ebwxRGHRcTKyC39pXufBsD4te.jpg","release_date":"1978-12-08","softcore":false,"video":false,"vote_average":7.968,"vote_count":4317,"credit_id":"52fe44849251416c75037893","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/a5zBQfXmLk3qqRYF7AioWpiAxk2.jpg","genre_ids":[18,10752],"id":11778,"title":"Łowca jeleni","original_language":"en","original_title":"The Deer Hunter","overview":"Michael, Steven i Nick to młodzi pracownicy fabryki w Pensylwanii. Wszyscy dostają powołanie do wojska na wojnę w Wietnamie. Jeszcze przed wyjazdem Steven poślubia ciężarną Angelę, a ich przyjęcie ślubne jest zarazem przyjęciem pożegnalnym. Po pewnym czasie spędzonym w Wietnamie przyjaciele wpadają w pułapkę Vietcongu i trafiają do obozu jenieckiego, gdzie zostają zmuszeni do gry w rosyjską ruletkę między sobą.","popularity":10.6733,"poster_path":"/35ebwxRGHRcTKyC39pXufBsD4te.jpg","release_date":"1978-12-08","softcore":false,"video":false,"vote_average":7.968,"vote_count":4317,"credit_id":"52fe44849251416c75037899","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/20vIC3JXCFrsLwv0TpiBbK7IKh2.jpg","genre_ids":[35,18],"id":36108,"title":"Kocham kino","original_language":"fr","original_title":"Chacun son cinema ou Ce petit coup au coeur quand la lumiere s'eteint et que le film commence","overview":",,Chacun son cinéma\" to hołd złożony magii kina. Film, powstał na 60. urodziny Festiwalu w Cannes w 2007r. Obraz składa się z 33 etiud słynnych światowych reżyserów. Motywem łączącym je wszystkie jest nieśmiertelny temat kina. Pomysłodawcą obrazu jest pan Gilles Jacob.","popularity":2.1872,"poster_path":"/oqsHDWIh26sJXz9Ua3lPQhUx3lK.jpg","release_date":"2007-10-31","softcore":false,"video":false,"vote_average":6.5,"vote_count":155,"credit_id":"52fe45cc9251416c9103ed8f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sLQUCTUjnDVut0741VQVJ1VbWhh.jpg","genre_ids":[18,80],"id":38191,"title":"Rajd ku słońcu","original_language":"en","original_title":"The Sunchaser","overview":"Dwóch mężczyzn przemierza bezkresne przestrzenie pustyni w Utah i Arizonie. Michael Reynolds jest robiącym karierę bogatym lekarzem, Brandon Monroe to umierający na raka młodociany przestępca z przedmieść Miasta Aniołów. Pozornie dzieli ich bardzo wiele. Jednak dziwna wędrówka wpłynie na zmianę przekonań obydwu bohaterów, a być może okaże się także lekiem na ich problemy.","popularity":2.0881,"poster_path":"/9Y0snZwCLvG8eoJewP4G3RT8Z4v.jpg","release_date":"1996-05-29","softcore":false,"video":false,"vote_average":6.293,"vote_count":116,"credit_id":"52fe469d9251416c9105a12b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/a5zBQfXmLk3qqRYF7AioWpiAxk2.jpg","genre_ids":[18,10752],"id":11778,"title":"Łowca jeleni","original_language":"en","original_title":"The Deer Hunter","overview":"Michael, Steven i Nick to młodzi pracownicy fabryki w Pensylwanii. Wszyscy dostają powołanie do wojska na wojnę w Wietnamie. Jeszcze przed wyjazdem Steven poślubia ciężarną Angelę, a ich przyjęcie ślubne jest zarazem przyjęciem pożegnalnym. Po pewnym czasie spędzonym w Wietnamie przyjaciele wpadają w pułapkę Vietcongu i trafiają do obozu jenieckiego, gdzie zostają zmuszeni do gry w rosyjską ruletkę między sobą.","popularity":10.6733,"poster_path":"/35ebwxRGHRcTKyC39pXufBsD4te.jpg","release_date":"1978-12-08","softcore":false,"video":false,"vote_average":7.968,"vote_count":4317,"credit_id":"65967954a6c10410ddfa66e2","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/q4A2A7h9HsKKBfTxESAdc2N4hVg.jpg","genre_ids":[18,10752,28],"id":792,"title":"Pluton","original_language":"en","original_title":"Platoon","overview":"Przybyły do Wietnamu Chris Taylor (Charlie Sheen) szybko odkrywa, że najtrudniejszą walką, którą musi stoczyć jest walka z samym sobą - z własnymi słabościami, strachem, gniewem i wycieńczeniem. Pluton to opowieść o ludziach za młodych by umierać, zbyt niedojrzałych , by ustrzec się przed spustoszeniami jakie w ich duszach dokonuje brutalna wojna. W wilgotnej, parnej dżungli szybko wyrasta się ze złudzeń.","popularity":12.2011,"poster_path":"/9Ywd6XOeqpN8w5MYWwOMtF8QJzq.jpg","release_date":"1986-12-19","softcore":false,"video":false,"vote_average":7.749,"vote_count":5195,"credit_id":"5709376bc3a3687de30002f1","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/gc1Y41h4Pfx9MyBKhTo7rtRC7xs.jpg","genre_ids":[53,80],"id":31676,"title":"Godziny rozpaczy","original_language":"en","original_title":"Desperate Hours","overview":"Kryminalista Michael Bosworth (Mickey Rourke), dzięki pomocy swego adwokata Nancy Breyers (Kelly Lynch), ucieka z pilnie strzeżonego więzienia. Chce koniecznie znaleźć się w Meksyku, lecz wcześniej trafia do domu czteroosobowej rodziny, biorąc ją za zakładników. Zdesperowany ojciec sterroryzowanej familii, Tim Cornell (Anthony Hopkins), zrobi wszystko, by uratować żonę Norę i dwoje małych dzieci.","popularity":2.4747,"poster_path":"/gtIRVVHRRr4iWN8yJ6tQs0CqWV2.jpg","release_date":"1990-10-05","softcore":false,"video":false,"vote_average":5.418,"vote_count":224,"credit_id":"575ca3f89251414a820011f1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/qcxXFE9XEfnyUmAdbvtJqXYtAqc.jpg","genre_ids":[18,80,53],"id":31945,"title":"Sycylijczyk","original_language":"en","original_title":"The Sicilian","overview":"Salvatore Giuliano (Christopher Lambert) jest ubogim mieszkańcem Sycylii. Pewnego dnia zostaje ciężko ranny podczas strzelaniny. Mimo pesymistycznych rokowań, udaje mu się przeżyć. Salvatore dochodzi do wniosku, że dramatyczny epizod jest dla niego drogowskazem. Zaczyna pomagać ubogiej ludności, okradając bogatych. Wkrótce dochodzi do konfliktu między nim, a władzami i mafią. Giuliano ucieka w góry, gdzie organizuje armię. Posługuje się coraz bardziej brutalnymi metodami. Rządzący wydają na niego wyrok śmierci.","popularity":2.7449,"poster_path":"/wsd7fXujfmRoKUZeRjfMIqprB3t.jpg","release_date":"1987-10-07","softcore":false,"video":false,"vote_average":5.217,"vote_count":150,"credit_id":"59bee2f1925141474500504e","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/sLQUCTUjnDVut0741VQVJ1VbWhh.jpg","genre_ids":[18,80],"id":38191,"title":"Rajd ku słońcu","original_language":"en","original_title":"The Sunchaser","overview":"Dwóch mężczyzn przemierza bezkresne przestrzenie pustyni w Utah i Arizonie. Michael Reynolds jest robiącym karierę bogatym lekarzem, Brandon Monroe to umierający na raka młodociany przestępca z przedmieść Miasta Aniołów. Pozornie dzieli ich bardzo wiele. Jednak dziwna wędrówka wpłynie na zmianę przekonań obydwu bohaterów, a być może okaże się także lekiem na ich problemy.","popularity":2.0881,"poster_path":"/9Y0snZwCLvG8eoJewP4G3RT8Z4v.jpg","release_date":"1996-05-29","softcore":false,"video":false,"vote_average":6.293,"vote_count":116,"credit_id":"5db78398a1d3320017e6171b","department":"Production","job":"Producer"}],"id":12114}