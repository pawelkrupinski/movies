ucji. Zainspirowany komiksami i Nową Falą, ateista, ale pasjonat historycznej postaci Jezusa, Paul Verhoeven pozwala, by jego mroczna strona i złożoność przebijały przez jego bohaterów, popychając ich do transgresji. W Hollywood jest rozpieszczany i odniósł szereg sukcesów („Robocop”, „Pamięć absolutna”, „Nagi instynkt”), nie rezygnując ze swoich obsesji. Michael Douglas i Isabelle Huppert, bohaterka jego najnowszego filmu fabularnego „Elle”, zwierzają się nam.","popularity":0.8184,"poster_path":"/lzbJgeCiX8aNrk17Q05pPVnWcUg.jpg","release_date":"2016-09-24","softcore":false,"video":false,"vote_average":6.7,"vote_count":9,"character":"Self - Filmmaker","credit_id":"5804f61892514148fc000d7a","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":506912,"title":"Death from Above: The Making of 'Starship Troopers'","original_language":"en","original_title":"Death from Above: The Making of 'Starship Troopers'","overview":"","popularity":1.4414,"poster_path":"/4BERDrQ3S7A0JExYzKQqnwqaIYO.jpg","release_date":"2002-05-28","softcore":false,"video":false,"vote_average":8.0,"vote_count":3,"character":"Himself","credit_id":"5a8f4dfec3a3682de60044de","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":527178,"title":"Gottes Utopia","original_language":"de","original_title":"Gottes Utopia","overview":"","popularity":0.7079,"poster_path":null,"release_date":"1955-10-13","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Marino","credit_id":"5b0dc6679251415a060007b6","order":2},{"adult":false,"backdrop_path":"/m1ykgqaNcTBwGqhkoftN65ZGmyM.jpg","genre_ids":[99],"id":592997,"title":"You Don't Nomi","original_language":"en","original_title":"You Don't Nomi","overview":"","popularity":1.4948,"poster_path":"/AiEKVJ1qonFMM2YY6n9Ba2z4rVp.jpg","release_date":"2021-05-13","softcore":false,"video":false,"vote_average":5.846,"vote_count":13,"character":"Himself (archive footage)","credit_id":"5ca6a3a9925141259bde87d4","order":9},{"adult