v6QWToNZKGGSX.jpg","release_date":"2019-03-21","softcore":false,"video":false,"vote_average":5.671,"vote_count":35,"credit_id":"5c1605b7c3a36866d83772a8","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/g5QV2F7dMnQ4kmgCs9exTfqfwgB.jpg","genre_ids":[18],"id":568789,"title":"Grunt pod stopami","original_language":"de","original_title":"Der Boden unter den Füßen","overview":"Niespełna trzydziestoletnia Lola (Valerie Pachner) jest konsultantką biznesową, która zrobi wszystko, aby odnieść sukces. Kobieta wyróżnia się agresywną taktyką działania i ogromnym zaangażowaniem. Jej rutyną jest praca do późna i liczne wieczorne spotkania z klientami. Lola ukrywa przed światem związek z szefową Elise (Mavie Hörbiger), a także istnienie swojej mającej problemy psychiczne starszej siostry Conny (Pia Hierzegger). Jednak pewnego dnia Conny podejmuje próbę samobójczą, co wywraca codzienności Loli do góry nogami.","popularity":1.3595,"poster_path":"/wAnKUUgm8WW76Xv6QWToNZKGGSX.jpg","release_date":"2019-03-21","softcore":false,"video":false,"vote_average":5.671,"vote_count":35,"credit_id":"5c194233925141265ba421a3","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/tOkKdmnT0NeiEJbHK0ZuL3GqUtZ.jpg","genre_ids":[18],"id":754800,"title":"Czego naprawdę chcemy","original_language":"de","original_title":"Was wir wollten","overview":"Małżeństwo borykające się z problemem niepłodności wyjeżdża na wakacje do Sardynii, aby się zrelaksować. Jednak sąsiadująca z nimi rodzina im tego nie ułatwia.","popularity":1.8017,"poster_path":"/oKb2rqSaAjp1EQoTw1Z5D3ShCxm.jpg","release_date":"2020-11-11","softcore":false,"video":false,"vote_average":5.832,"vote_count":95,"credit_id":"5f8d4486cb802800390a1b98","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/tOkKdmnT0NeiEJbHK0ZuL3GqUtZ.jpg","genre_ids":[18],"id":754800,"title":"Czego naprawdę chcemy","original_language":"de","original_title":"Was wir wollten","overview":"Małżeństwo borykając