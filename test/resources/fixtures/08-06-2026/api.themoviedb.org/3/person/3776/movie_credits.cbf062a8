rview":"","popularity":1.6775,"poster_path":"/rlazHD2gxAuCXu7v8tFXqAeMUcE.jpg","release_date":"1987-05-27","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"60678f7c3a96500057dcc63a","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/oseBXGQMYWTWzAVHJaUEwGgrjGA.jpg","genre_ids":[35,18,10749],"id":31522,"title":"Kobieta jest kobietą","original_language":"fr","original_title":"Une femme est une femme","overview":"","popularity":1.9012,"poster_path":"/o69JpT6OSgeQM6uLyj2eXcTJRDb.jpg","release_date":"1961-09-06","softcore":false,"video":false,"vote_average":7.3,"vote_count":407,"credit_id":"52fe44839251416c910136cb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/3Wm76b8SY47zqIU6pJRnYRzPPln.jpg","genre_ids":[80,18,35,10749],"id":32689,"title":"Imię Carmen","original_language":"fr","original_title":"Prénom Carmen","overview":"Carmen (M. Detmers) jest młodą kobietą należącą do grupy przestępczej szykującej napad na bank. Podczas skoku zakochuje się w niej ochroniarz banku, Joseph (J. Bonnaffe). Pomaga on dziewczynie w ucieczce, po czym udaje się wraz z nią na wybrzeże, do domu jej wuja (J. L. Godard). Tam ich romans rozkwita. Niespodziewanie, po kilku dniach pojawia się szef Carmen. Dziewczyna jest mu potrzebna: gang planuje bowiem porwanie bogatego biznesmena. Pod pretekstem kręcenia filmu dokumentalnego grupa pojawia się w hotelu, gdzie przebywa ofiara. Towarzyszy im Joseph, który początkowo niechciany przez szefa, szybko zostaje zepchnięty na drugi plan. Gdy przestępcy rozpoczynają porwanie sytuacja zaczyna się komplikować.","popularity":3.5222,"poster_path":"/k0NhFg1Kw3kOG5wiIxDdtZe5iDO.jpg","release_date":"1983-12-01","softcore":false,"video":false,"vote_average":6.013,"vote_count":114,"credit_id":"52fe44e49251416c9102071f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tkvePoq5eWC426u3XmOR4J1V4b5.jpg","genre_ids":[18],"id":32691,"title":"Nouvelle Vague","ori