2d9251412505005bb4","order":11},{"adult":false,"backdrop_path":"/yhbQ4iWTa62hFV4Zmn3sgGwbGmF.jpg","genre_ids":[14,18,27],"id":239211,"title":"ORG","original_language":"it","original_title":"ORG","overview":"","popularity":1.1346,"poster_path":"/aOlByuM9Xr2cqHnZXHuZMPyAQ5M.jpg","release_date":"1979-08-31","softcore":false,"video":false,"vote_average":5.111,"vote_count":9,"character":"Self (archive footage)","credit_id":"5a28d134c3a3680b88111ef3","order":7},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":506894,"title":"Jean Cocteau, mensonges et vérités","original_language":"fr","original_title":"Jean Cocteau, mensonges et vérités","overview":"","popularity":0.777,"poster_path":"/uLl5VGr076glCpNz3wPVW60BWTc.jpg","release_date":"1997-02-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"5a8f37ae0e0a2639b2003cc8","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":507153,"title":"Il était une fois… Le Mépris","original_language":"fr","original_title":"Il était une fois… Le Mépris","overview":"","popularity":0.7631,"poster_path":"/lHMdh9Ae4hZnjfJMRRva9wiBHze.jpg","release_date":"2009-05-21","softcore":false,"video":false,"vote_average":8.0,"vote_count":1,"character":"Self","credit_id":"5ac4485d92514160180802f7","order":3},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":527290,"title":"Ne","original_language":"fr","original_title":"Né","overview":"Poszukiwania młodego reżysera oparte na wywiadzie z Jean-Luc Godardem, którego udzielił w 1968 roku. Film nie zawiera żadnych elementów fikcyjnych. To pytanie o relację aktor-reżyser.","popularity":2.2543,"poster_path":"/sPsVTOxTfnQwIGFq4JYLhPImUA3.jpg","release_date":"1975-11-05","softcore":false,"video":false,"vote_average":10.0,"vote_count":2,"character":"Self","credit_id":"5b0ebac392514153d40056ef","order":4},{"adult":false,"backdrop_path":"/q6GsGCc0Ncymil1WiTrhsScRKdG.jpg","genre_ids":[99,18],"id":414030,"title":"Jean-Luc Godard. Imaginacje","original_language":"fr","original_title":"Le Livre d'image","overview":"Uhonorowany Specjalną Złotą Palmą esej 88-letniego reżysera: błyskotliwe, radykalne formalnie, prowokacyjne intelektualnie spojrzenie na filmowe medium. Każdy z rozdziałów (poświęconych m.in. podróżom, wojnom czy prawu) to fragment historii i dopiero gdy zbierzemy je razem, dostrzeżemy pełny obraz. Złożony z cytatów z klasycznych dzieł, newsów czy filmików ISIS z YouTube’a, erudycyjny \"The Image Book\" mówi o terrorze obrazów nie tyle wyjaśniających nam świat, ile kształtujących go zgodnie z politycznym zamówieniem. Podążając w stronę Bliskiego Wschodu, Jean-Luc Godard przygląda się kwestiom reprezentacji i jej braku, przekleństwu wizerunku narzuconego przez Zachód, podporządkowującemu spojrzeniu. Tasując na ekranie obrazy i manipulując dźwiękiem, twórca \"Do utraty tchu\" pyta o rolę, jaką odgrywa kino w historii XX i XXI wieku: kronikarza przemocy, wirusa roznoszącego groźne ideologie, strażnika istniejącego porządku, a może biernego obserwatora?","popularity":2.0799,"poster_path":"/bg550nt1GLGsE7S8Qw1o3EnIPN5.jpg","release_date":"2018-10-11","softcore":false,"video":false,"vote_average":6.3,"vote_count":83,"character":"Narrator (voice)","credit_id":"5b740bffc3a368188f1ccb9c","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99,10402],"id":546135,"title":"Petit Jour","original_language":"fr","original_title":"Petit Jour","overview":"","popularity":0.5954,"poster_path":"/gyJAehHWJrke5disDE2wPFXfCMQ.jpg","release_date":"1962-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"character":"Self","credit_id":"5b8bfac70e0a261d6b03585c","order":2},{"adult":false,"backdrop_path":"/oyatchDPpS4I9jpIIezFJGrmXcR.jpg","genre_ids":[18],"id":499,"title":"Cleo od piątej do siódmej","original_language":"fr","original_title":"Cléo de 5 à 7","overview":"Cleo (Corinne Marchand), młoda dziewczyna, piosenkarka, będąca, jakby się wydawało, u szczytu życiowego powodzenia, nagle dowiaduje się, że może być chora na raka. Wyniki badań mają być znane w ciągu dwóch godzin. Te dwie godziny są okresem, w którym Cleo dokonuje przewartościowania swojego dotychczasowego życia.","popularity":3.5425,"poster_path":"/httmzhcroe1fhrRxbkaEnxmzqT0.jpg","release_date":"1962-04-11","softcore":false,"video":false,"vote_average":7.662,"vote_count":789,"character":"The Man with Black Glasses / Actor in Silent Film","credit_id":"5be1d0dcc3a36809ec010d28","order":11},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":68147,"title":"Cineastes en acció","original_language":"ca","original_title":"Cineastes en acció","overview":"","popularity":5.4963,"poster_path":"/s3U0cs3VDAXhVeGLQH5xX2GIypq.jpg","release_date":"2006-09-15","softcore":false,"video":false,"vote_average":7.2,"vote_count":5,"character":"Self (archive footage)","credit_id":"5bef99079251415ccc027876","order":39},{"adult":false,"backdrop_path":"/odLGRruOYjEiqXJ3PrVYjsrkETE.jpg","genre_ids":[99],"id":572013,"title":"Film catastrophe","original_language":"fr","original_title":"Film catastrophe","overview":"","popularity":1.8264,"poster_path":"/pbSw0fc5qqze04Ofwme5LOPyRzw.jpg","release_date":"2018-10-30","softcore":false,"video":false,"vote_average":5.7,"vote_count":3,"character":"Self","credit_id":"5c463315c3a3684782840ded","order":0},{"adult":false,"backdrop_path":"/fOW3wpcmHMFMAYyLshygzsGwQHQ.jpg","genre_ids":[10402,99],"id":578840,"title":"Michel Legrand, sans demi-mesure","original_language":"fr","original_title":"Michel Legrand, sans demi-mesure","overview":"","popularity":1.6151,"poster_path":"/8jZVcM2hBz8XKjeF0auOK3zcmCI.jpg","release_date":"2018-12-25","softcore":false,"video":false,"vote_average":9.0,"vote_count":3,"character":"Self (archive footage)","credit_id":"5c5094eb0e0a264965da3cf8","order":5},{"adult":false,"backdrop_path":"/tQozdHuNWsDmTqfVkIExFx1t7Kr.jpg","genre_ids":[99],"id":579673,"title":"Mai en décembre: Godard en Abitibi","original_language":"fr","original_title":"Mai en déce