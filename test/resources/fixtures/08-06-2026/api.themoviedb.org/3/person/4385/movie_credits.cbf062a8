{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":264117,"title":"Once Upon a Time: Sergio Leone","original_language":"en","original_title":"Once Upon a Time: Sergio Leone","overview":"","popularity":1.2957,"poster_path":"/sFtkY5ijTCHsjmZZaJuFyZYY2Qd.jpg","release_date":"2000-01-01","softcore":false,"video":false,"vote_average":6.111,"vote_count":9,"character":"Self (archive footage)","credit_id":"63ebd8878e870200dc7c4463","order":16},{"adult":false,"backdrop_path":"/9ZbzvXqU3C6YEchKl1OTvcpEu3H.jpg","genre_ids":[99],"id":412610,"title":"The Wages of Sin","original_language":"en","original_title":"The Wages of Sin","overview":"","popularity":0.7646,"poster_path":"/jIfu3FI318rrg4jup853XIkDzln.jpg","release_date":"2003-11-18","softcore":false,"video":false,"vote_average":7.5,"vote_count":6,"character":"Self (archive footage)","credit_id":"63ebd617f9253200c3ff8c6d","order":8},{"adult":false,"backdrop_path":"/nWJCfZKJLYJJoFP9jeTvGl1hHlY.jpg","genre_ids":[99],"id":412614,"title":"Something to Do with Death","original_language":"en","original_title":"Something to Do with Death","overview":"","popularity":1.2197,"poster_path":"/nPGOc5OqIUEpFzKF5KErun8orwA.jpg","release_date":"2003-11-18","softcore":false,"video":false,"vote_average":6.333,"vote_count":3,"character":"Self (archive footage)","credit_id":"63ebd62ef92532009d928fda","order":8},{"adult":false,"backdrop_path":"/pQlK2aoR5SGRGWNYtfiUOclZNJp.jpg","genre_ids":[35,18,10749],"id":134522,"title":"Romans prawie doskonały","original_language":"en","original_title":"An Almost Perfect Affair","overview":"Satyra na przemysł filmowy, wielki świat producentów i reżyserów. Jest to historia namiętnego, lecz krótkiego romansu, rozgrywająca się na tle festiwalowej gorączki w Cannes. On jest debiutującym amerykańskim reżyserem, ona (Monica Vitti) - żoną znanego włoskiego producenta filmowego. Poznają się przypadkowo i, choć dzieli ich wiele, zakochują się w sobie. Tłumiąc wyrzuty sumienia, które mają wobec swoich bliskich, poddają się spontanicznemu uczuciu. Rozstają się bogatsi o nowe doświadczenia.","popularity":1.3126,"poster_path":"/2eSVujhWo3e4SQ1wprVvZ8WWx0O.jpg","release_date":"1979-04-27","softcore":false,"video":false,"vote_average":5.0,"vote_count":7,"character":"Self (uncredited)","credit_id":"619348b11f748b008e6bd464","order":17},{"adult":false,"backdrop_path":"/p3YoyXqu2J7dLCbZK4PPCsqcTdY.jpg","genre_ids":[99],"id":142640,"title":"An Opera of Violence","original_language":"en","original_title":"An Opera of Violence","overview":"","popularity":0.9188,"poster_path":"/g2S3rpZ87K7wvUOJFKCN8GaUiJh.jpg","release_date":"2003-11-18","softcore":false,"video":false,"vote_average":6.75,"vote_count":4,"character":"Self - Filmmaker (archive footage)","credit_id":"52fe4ae79251416c750f1da7","order":9},{"adult":false,"backdrop_path":"/wRxtG8beg2RC45wKOju6uiJVASL.jpg","genre_ids":[99],"id":198228,"title":"Eastwood Directs: The Untold Story","original_language":"en","original_title":"Eastwood Directs: The Untold Story","overview":"","popularity":1.5357,"poster_path":"/9TxY2YiQk8kAC2VP2H1u1y4wNRQ.jpg","release_date":"2013-04-27","softcore":false,"video":false,"vote_average":6.1,"vote_count":24,"character":"Self","credit_id":"52fe4d749251416c911169f3","order":9},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":999084,"title":"Il folle di Marechiaro","original_language":"it","original_title":"Il folle di Marechiaro","overview":"","popularity":0.7066,"poster_path":"/uOnU5JytVeiPhgrXFeHBKBpzAp5.jpg","release_date":"1950-12-31","softcore":false,"video":false,"vote_average":10.0,"vote_count":1,"character":"Soldato statunitense","credit_id":"62cd4508f48e0d0066b4a3ec","order":4},{"adult":false,"backdrop_path":"/ywlqEXZWdz0xWt18hoqtJ8O8338.jpg","genre_ids":[18],"id":999086,"title":"La bocca sulla strada","original_language":"it","original_title":"La bocca sulla strada","overview":"","popularity":0.485,"poster_path":"/xjiScTOXffZ9VIjer9jwxFRfztC.jpg","release_date":"1941-10-10","soft