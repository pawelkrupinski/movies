":12},{"adult":false,"backdrop_path":"/hs6OPto38fF589ScpGhl7uSU4MI.jpg","genre_ids":[37],"id":938,"title":"Za kilka dolarów więcej","original_language":"it","original_title":"Per qualche dollaro in più","overview":"Kiedy dwaj rywalizujący ze sobą łowcy nagród orientują się, że ścigają tego samego bandytę, łączą siły w nadziei doprowadzenia go przed oblicze sprawiedliwości. Jednak wraz z rozwojem akcji, sprawy coraz bardziej się komplikują. Zobacz mocną, drugą część sagi Sergia Leone, w której Eastwood wciela się w osławionego „Człowieka bez imienia”.","popularity":9.9149,"poster_path":"/kNNMR1KxkrYrqOBLGVgMDksoFYF.jpg","release_date":"1965-12-18","softcore":false,"video":false,"vote_average":8.025,"vote_count":4536,"character":"Whistling Bounty Hunter (voice) (uncredited)","credit_id":"5e1772231d01910017f257e4","order":43},{"adult":false,"backdrop_path":"/spDh83JhKW7ZGfGTHCcRk6rYUvR.jpg","genre_ids":[99],"id":338797,"title":"Spanish Western","original_language":"es","original_title":"Spanish Western","overview":"","popularity":0.8867,"poster_path":"/kAhNXNrUinvxvijxZnHtTXwWhDh.jpg","release_date":"2015-05-04","softcore":false,"video":false,"vote_average":6.2,"vote_count":16,"character":"Self (archive footage)","credit_id":"5eebebcfc5ada50034d54866","order":23},{"adult":false,"backdrop_path":"/n9ajHOvhx3Dns5ebJOsccFVFTAC.jpg","genre_ids":[35],"id":665791,"title":"Milano miliardaria","original_language":"it","original_title":"Milano miliardaria","overview":"","popularity":0.9946,"poster_path":"/ctL3XmLb6AZGlXya87lBseOVtRC.jpg","release_date":"1951-08-04","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"character":"Extra (uncredited)","credit_id":"5f16de2fa6d93100377b0625","order":29},{"adult":false,"backdrop_path":"/w7BLyOnxUht8O97Ce8OisP6CF12.jpg","genre_ids":[99],"id":806407,"title":"Poltrone Rosse - Parma e il cinema","original_language":"it","original_title":"Poltrone Rosse - Parma e il cinema","overview":"","popularity":1.036,"poster_path":"/hT6gKcpv3nHSBkIqaQWivBqGVM0.jpg","release_date":"2014-07-24","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self (archive footage)","credit_id":"604ffca06517d6003ff55f09","order":19},{"adult":false,"backdrop_path":"/zXnPfsVnZFts3sU2OTCA70LXvk0.jpg","genre_ids":[99],"id":802526,"title":"Italian Kings Of B","original_language":"it","original_title":"Italian Kings Of B","overview":"","popularity":0.9258,"poster_path":"/s5OZxRdK168JVRWEEklqG7wZovQ.jpg","release_date":"2003-01-01","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"character":"Self","credit_id":"66f2c0b2a97880148f3b79eb","order":18},{"adult":false,"backdrop_path":"/b8zeksERd4rnk3GYmRGceIjsYRu.jpg","genre_ids":[99],"id":278542,"title":"I Tarantiniani","original_language":"en","original_title":"I Tarantiniani","overview":"","popularity":0.7367,"poster_path":"/zt9EKH4PVpQybzB550LHva4F1UO.jpg","release_date":"2013-02-21","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"66f7b5422c4bdc9db05f190b","order":16},{"adult":false,"backdrop_path":"/iTtyPk7cZMivnXBBhVkTIGqqqT0.jpg","genre_ids":[99,36],"id":854521,"title":"Django i Django","original_language":"en","original_title":"Django & Django: Sergio Corbucci Unchained","overview":"Quentin Tarantino i Ruggero Deodato opowiadają o spaghetti westernach Sergio Corbucciego oraz analizują filmowe dziedzictwo tego reżysera.","popularity":1.5188,"poster_path":"/z5C8S5dEfwh3SDddtqwXanRojQF.jpg","release_date":"2021-11-15","softcore":false,"video":false,"vote_average":6.961,"vote_count":51,"character":"Self - Filmmaker (archive footage)","credit_id":"676d2b073dff0de99b6140af","order":7},{"adult":false,"backdrop_path":"/d67M27QMwFY8Kx7kC9ug3Xeiqou.jpg","genre_ids":[99],"id":1005428,"title":"Sergio Leone - L'italiano che inventò l'America","original_language":"it","original_title":"Sergio Leone - L'italiano che inventò l'America","overview":"","popularity":1.1838,"poster_path":"/sRGp6TYdZ7NmvVSgI5Itw6Jylen.jpg","release_date":"2022-10-20","softcore":false,"video":false,"vote_average":7.359,"vote_count":71,"character":"Self","credit_id":"68cda2692baabdf9e9748e71","order":22}],"crew":[{"adult":false,"backdrop_path":"/xlDUjb0Q5Dv6jPQRF5VE4IMjIy.jpg","genre_ids":[18,80],"id":311,"title":"Dawno temu w Ameryce","original_language":"en","original_title":"Once Upon a Time in America","overview":"Lata 20. i 30. XX wieku. David i Max razem dorastali w żydowskim getcie w Nowym Jorku. Byli członkami gangu młodzieżowego, żyli z drobnych oszustw. Po latach przyjaciele kierują własną grupą przestępczą, mają wspólne fundusze, nad którymi pieczę sprawuje ich kompan Moe. Robią wielkie pieniądze na nielegalnym handlu alkoholem. Wraz z nadejściem końca prohibicji w 1933 roku gang przeżywa kryzys finansowy. Zgrana niegdyś paczka powoli się rozpada.","popularity":19.848,"poster_path":"/k6I9E24k3CwrV0upnvNyzGlau53.jpg","release_date":"1984-05-23","softcore":false,"video":false,"vote_average":8.4,"vote_count":6131,"credit_id":"52fe4236c3a36847f800c845","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/tXjtTg1TcpqUePNgdFrBg56hMUC.jpg","genre_ids":[37],"id":336,"title":"Garść dynamitu","original_language":"it","original_title":"Giù la testa","overview":"W Meksyku spotykają się irlandzki rewolucjonista, Sean Mallory, specjalista od materiałów wybuchowych oraz awanturnik Juan Miranda. Mężczyźni postanawiają wspólnie rabować banki. Zupełnie przypadkowo stają się bohaterami rewolucji, narażając się tym samym brutalnemu pułkownikowi Gutierezowi.","popularity":7.1604,"poster_path":"/sXBresTgbXtkQjYIjEINlgdVdNw.jpg","release_date":"1971-10-29","softcore":false,"video":false,"vote_average":7.669,"vote_count":1200,"credit_id":"52fe4239c3a36847f800d827","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xlDUjb0Q5Dv6jPQRF5VE4IMjIy.jpg","genre_ids":[18,80],"id":311,"title":"Dawno temu w Ameryce","original_language":"en","original_title":"Once Upon a Time in America","overview":"Lata 20. i 30. XX wieku. David i Max razem dorastali w żydowskim getcie w Nowym Jorku. Byli członkami gangu młodzieżowego, żyli z drobnych oszustw. Po latach przyjaciele kierują własną grupą przestępczą, mają wspólne fundusze, nad którymi pieczę sprawuje ich kompan Moe. Robią wielkie pieniądze na nielegalnym handlu alkoholem. Wraz z nadejściem końca prohibicji w 1933 roku gang przeżywa kryzys finansowy. Zgrana niegdyś paczka powoli się rozpada.","popularity":19.848,"poster_path":"/k6I9E24k3CwrV0upnvNyzGlau53.jpg","release_date":"1984-05-23","softcore":false,"video":false,"vote_average":8.4,"vote_count":6131,"credit_id":"52fe4236c3a36847f800c745","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9gMkOYzk7P9QXwndhLRAC8cMZcJ.jpg","genre_ids":[37],"id":391,"title":"Za garść dolarów","original_language":"it","original_title":"Per un pugno di dollari","overview":"Samotny wędrowiec Joe przybywa do miasteczka leżącego przy granicy meksykańsko-amerykańskiej. Wpływy dzielą tu między siebie dwie rywalizujące bandy przemytników. Przebiegły Joe dostrzega szansę na zarobek, lokując się pomiędzy skonfliktowanymi stronami, co realizuje zatrudniając się raz w jednej, raz w drugiej grupie. Wkrótce wtrąca się również w losy lokalnej rodziny, rozdzielonej przez bandytów. W rezultacie ściąga na siebie wrogość jednego z rodów, doprowadzając do eskalacji trwającego konfliktu.","popularity":9.77,"poster_path":"/ol8KRvdKyh84QEER7EEZ6c2C5qW.jpg","release_date":"1964-09-12","softcore":false,"video":false,"vote_average":7.821,"vote_count":4782,"credit_id":"52fe423dc3a36847f800edaf","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/x4biAVdPVCghBlsVIzB6NmbghIz.jpg","genre_ids":[37],"id":429,"title":"Dobry, zły i brzydki","original_language":"it","original_title":"Il buono, il brutto, il cattivo","overview":"Obraz ten jest ostatnią częścią \"dolarowej\" trylogii Sergia Leone. Bohaterami filmu są trzej mężczyźni: Zły - bezwzględny łowca nagród, Brzydki - wielokrotny przestępca, Dobry - łowca głów z zasadami. Wszyscy trzej usiłują dotrzeć do ukrytego przez wojsko skarbu. Brzydki jest w posiadaniu informacji o nazwie cmentarza, na którym został on zakopany, Dobry zna nazwisko na poszukiwanym grobie. Czyni to z nich mimowolny zespół. Po piętach depcze im Zły.","popularity":25.7572,"poster_path":"/48UDOsbi1D47Iu0h2JnkZU2GXna.jpg","release_date":"1966-12-23","softcore":false,"video":false,"vote_average":8.464,"vote_count":9803,"credit_id":"52fe4242c3a36847f80105d3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/x4biAVdPVCghBlsVIzB6NmbghIz.jpg","genre_ids":[37],"id":429,"title":"Dobry, zły i brzydki","original_language":"it","original_title":"Il buono, il brutto, il cattivo","overview":"Obraz ten jest ostatnią częścią \"dolarowej\" trylogii Sergia Leone. Bohaterami filmu są trzej mężczyźni: Zły - bezwzględny łowca nagród, Brzydki - wielokrotny przestępca, Dobry - łowca głów z zasadami. Wszyscy trzej usiłują dotrzeć do ukrytego przez wojsko skarbu. Brzydki jest w posiadaniu informacji o nazwie cmentarza, na którym został on zakopany, Dobry zna nazwisko na poszukiwanym grobie. Czyni to z nich mimowolny zespół. Po piętach depcze im Zły.","popularity":25.7572,"poster_path":"/48UDOsbi1D47Iu0h2JnkZU2GXna.jpg","release_date":"1966-12-23","softcore":false,"video":false,"vote_average":8.464,"vote_count":9803,"credit_id":"52fe4242c3a36847f8010635","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/hs6OPto38fF589ScpGhl7uSU4MI.jpg","genre_ids":[37],"id":938,"title":"Za kilka dolarów więcej","original_language":"it","original_title":"Per qualche dollaro in più","overview":"Kiedy dwaj rywalizujący ze sobą łowcy nagród orientują się, że ścigają tego samego bandytę, łączą siły w nadziei doprowadzenia go przed oblicze sprawiedliwości. Jednak wraz z rozwojem akcji, sprawy coraz bardziej się komplikują. Zobacz mocną, drugą część sagi Sergia Leone, w której Eastwood wciela się w osławionego „Człowieka bez imienia”.","popularity":9.9149,"poster_path":"/kNNMR1KxkrYrqOBLGVgMDksoFYF.jpg","release_date":"1965-12-18","softcore":false,"video":false,"vote_average":8.025,"vote_count":4536,"credit_id":"52fe4290c3a36847f80288fd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hs6OPto38fF589ScpGhl7uSU4MI.jpg","genre_ids":[37],"id":938,"title":"Za kilka dolarów więcej","original_language":"it","original_title":"Per qualche dollaro in più","overview":"Kiedy dwaj rywalizujący ze sobą łowcy nagród orientują się, że ścigają tego samego bandytę, łączą siły w nadziei doprowadzenia go przed oblicze sprawiedliwości. Jednak wraz z rozwojem akcji, sprawy coraz bardziej się komplikują. Zobacz mocną, drugą część sagi Sergia Leone, w której Eastwood wciela się w osławionego „Człowieka bez imienia”.","popularity":9.9149,"poster_path":"/kNNMR1KxkrYrqOBLGVgMDksoFYF.jpg","release_date":"1965-12-18","softcore":false,"video":false,"vote_average":8.025,"vote_count":4536,"credit_id":"52fe4290c3a36847f8028903","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/8PDs33WTpVOFEUr7bMpWm0FXnQp.jpg","genre_ids":[35,37],"id":10915,"title":"Un genio, due compari, un pollo","original_language":"it","original_title":"Un genio, due compari, un pollo","overview":"","popularity":2.6439,"poster_path":"/1an4eiFAIRElaUFItzbUtzkZxv5.jpg","release_date":"1975-12-16","softcore":false,"video":false,"vote_average":6.3,"vote_count":193,"credit_id":"52fe43d09251416c7501f22d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/4II0fdNtTMR0elrMgQSn9wfYuuk.jpg","genre_ids":[35,37],"id":9474,"title":"Nazywam się Nobody","original_language":"it","original_title":"Il mio nome è Nessuno","overview":"Pewien młody dobrze zapowiadający się rewolwerowiec - Nobody, czczący pewnego starego wyśmienitego rewolwerowca - Jacka Beauregarda, postanawia z nim konkurować. Jednakże Jack marz