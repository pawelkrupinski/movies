8Bv.jpg","genre_ids":[35],"id":278956,"title":"How Come Nobody's on Our Side?","original_language":"en","original_title":"How Come Nobody's on Our Side?","overview":"","popularity":0.7089,"poster_path":"/620bnENHknxfNpKAdvOPaQ9U8ob.jpg","release_date":"1974-11-08","softcore":false,"video":false,"vote_average":6.6,"vote_count":5,"character":"Miguelito","credit_id":"5c68d0230e0a2656279e6c47","order":3},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":599031,"title":"Forever Hollywood","original_language":"en","original_title":"Forever Hollywood","overview":"","popularity":2.4951,"poster_path":"/pl09MM3C2gLcdMn8D9vICEhusKo.jpg","release_date":"1999-01-01","softcore":false,"video":false,"vote_average":8.3,"vote_count":3,"character":"Self","credit_id":"5cc951b19251416e1ef31af2","order":16},{"adult":false,"backdrop_path":"/7ME0fJZxjEoSGPP4E4bbYT5zoqt.jpg","genre_ids":[35,18,10749],"id":858,"title":"Bezsenność w Seattle","original_language":"en","original_title":"Sleepless in Seattle","overview":"Boże Narodzenie to czas, w którym wszystko może się zdarzyć. I to każdemu, także mocno stojącej na ziemi dziennikarce - Annie Reed. Oto jadąc samochodem na Wigilię do domu swego narzeczonego i słuchając radia, Annie trafia przypadkowo na audycję, która zmieni jej życie. Ośmioletni Jonah martwi się o swego niedawno owdowiałego ojca i telefonuje w rozpaczy do rozgłośni radiowej z prośbą o pomoc. Zmuszony do zwierzeń tata chłopca, Sam, opowiada na antenie o swojej miłości do zmarłej żony i spędzonych z nią cudownych chwilach. Annie jest tak poruszona uczuciowymi wyznaniami Sama, że postanawia go odnaleźć i poznać. Ale jest kilka przeszkód: Sam mieszka w Seattle, Annie jest w Baltimore ... poza tym Sam nawet nie wie o jej istnieniu!","popularity":7.9844,"poster_path":"/23oG9bbxCUYJIConWmFtAw8ED9q.jpg","release_date":"1993-06-24","softcore":false,"video":false,"vote_average":6.746,"vote_count":2627,"character":"Jay","credit_id":"5df6b2f326dac10012529370","order":6},{"adult":false,"backdrop_path":"/vJd0ZCeGeuG5lzolUNlhoaoPaCK.jpg","genre_ids":[14,35,10749],"id":37718,"title":"Muza","original_language":"en","original_title":"The Muse","overview":"Steven Philips (Albert Brooks) wpada w rozpacz. Wytwórnie filmowe, z którymi do tej pory współpracował, odrzucają napisane przez niego scenariusze. Gdy o pomoc zwraca się do kolegi po fachu, ten radzi mu by wynajął muzę. Staje się nią Sarah Little (Sharon Stone), która postanawia zainspirować scenarzystę. Kobieta musi jednak mieć zapewnione odpowiednie warunki pracy: wielki apartament, limuzynę, a co najważniejsze, gwarancję zaspokajania wszelkich zachcianek, nawet o 3 w nocy.","popularity":2.6,"poster_path":"/hmtvDW52V3EuFmbhTOLjaGMYCDx.jpg","release_date":"1999-08-27","softcore":false,"video":false,"vote_average":5.221,"vote_count":152,"character":"Rob Reiner","credit_id":"5e1b847ee194b00014b61fba","order":25},{"adult":false,"backdrop_path":"/uuPB4j1O4lz44SPpM9un8QygZym.jpg","genre_ids":[28,35,80],"id":66034,"title":"Mad Dog Time","original_language":"en","original_title":"Mad Dog Time","overview":"","popularity":1.5698,"poster_path":"/z5WQce58yyNCdKFLFWmxfmL6gtA.jpg","release_date":"1996-11-08","softcore":false,"video":false,"vote_average":5.2,"vote_count":50,"character":"Albert the Chauffeur","credit_id":"5e65a71f459ad60011599dcf","order":17},{"adult":false,"backdrop_path":"/llVPUs3j9RywSMstGRepSeS8vSL.jpg","genre_ids":[35],"id":6471,"title":"Szajbus","original_language":"en","original_title":"The Jerk","overview":"W rewelacyjnej komedii Szajbus zadebiutował w roli głównej Steve Martin, jeden z najpopularniejszych komików światowego kina. Martin wcielił się w postać Navina Johnsona, którego adoptuje rodzina biednych czarnoskórych chłopów pańszczyźnianych. Dzięki serii zwariowanych wynalazków Navin szybko zdobywa niezmierzone bogactwa - i równie szybko je traci. Ulega przy tym wdziękom szalonej motocyklistki, cudem unika zemsty obłąkanego zabójcy, który organizuje serię groteskowych zamachów ma jego życie i zostaje multimilionerem dzięki wynalezionej przez siebie rewolucyjnej oprawce do okularów. Szajbus to popis aktorski Steve'a Martina, który zjednał mu rzeszę wiernych fanów. Nie pozostaje Ci nic innego jak dołączyć do ich grona.","popularity":4.7199,"poster_path":"/mIjOWtUofyt9Jawge7FbvITjU3D.jpg","release_date":"1979-12-14","softcore":false,"video":false,"vote_average":6.877,"vote_count":922,"character":"Truck Driver Picking Up Navin (uncredited)","credit_id":"5ea98fbf426ae800264a2db5","order":22},{"adult":false,"backdrop_path":null,"genre_ids":[99,27],"id":694657,"title":"Time Warp Vol. 1: Midnight Madness","original_language":"en","original_title":"Time Warp Vol. 1: Midnight Madness","overview":"","popularity":2.0239,"poster_path":"/tzrKrDgBOwLrhZINNOoZoKJ08gI.jpg","release_date":"2020-04-21","softcore":false,"video":false,"vote_average":6.8,"vote_count":5,"character":"Self","credit_id":"5ec5ce6d140bad001d182cbb","order":12},{"adult":false,"backdrop_path":null,"genre_ids":[10751],"id":321360,"title":"Johnny Appleseed","original_language":"en","original_title":"Johnny Appleseed","overview":"","popularity":0.7046,"poster_path":"/2P69Nu1XRvgtWswiuYZMJQpQs14.jpg","release_date":"1986-10-31","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Jack Smith","credit_id":"5f3165657739410035ec25f3","order":1},{"adult":false,"backdrop_path":"/wlRJ6tasNFUBMsFdVepQTza47Vf.jpg","genre_ids":[14,35,10770],"id":742922,"title":"A Virtual Princess Bride Reunion","original_language":"en","original_title":"A Virtual Princess Bride Reunion","overview":"","popularity":2.5722,"poster_path":"/r3ajAzeO1kP1GG8tlyY8GFdq61X.jpg","release_date":"2020-09-13","softcore":false,"video":false,"vote_average":6.3,"vote_count":3,"character":"The Grandfather","credit_id":"5f5fead4069f0e00369c8be8","order":13},{"adult":false,"backdrop_path":"/v7eQI24nxVRfT2BGv7oy5ouUbvP.jpg","genre_ids":[35,18,10770],"id":746996,"title":"More Than Friends","original_language":"en"