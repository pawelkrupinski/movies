czyjej, pomiędzy walczącymi wojskami Francji i Niemiec. Wierzy, jednak, że Manech wciąż żyje i rozpoczyna własne śledztwo...","popularity":3.2937,"poster_path":"/2tp8svyTgCaprrG51kfvMpEZ8co.jpg","release_date":"2004-10-27","softcore":false,"video":false,"vote_average":7.322,"vote_count":1346,"credit_id":"64c6b30663e6fb011b3ab7ed","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/sHziVAGeGZktaD9IdLLXzMxGVvl.jpg","genre_ids":[878],"id":60813,"title":"Le Bunker de la dernière rafale","original_language":"fr","original_title":"Le Bunker de la dernière rafale","overview":"","popularity":1.7768,"poster_path":"/lWOYJZLPmxPYdYajeLLKIVzbwy8.jpg","release_date":"1982-02-01","softcore":false,"video":false,"vote_average":5.843,"vote_count":35,"credit_id":"5d6d1b3a65686e6d7d898447","department":"Costume & Make-Up","job":"Costume Design"},{"adult":false,"backdrop_path":"/sHziVAGeGZktaD9IdLLXzMxGVvl.jpg","genre_ids":[878],"id":60813,"title":"Le Bunker de la dernière rafale","original_language":"fr","original_title":"Le Bunker de la dernière rafale","overview":"","popularity":1.7768,"poster_path":"/lWOYJZLPmxPYdYajeLLKIVzbwy8.jpg","release_date":"1982-02-01","softcore":false,"video":false,"vote_average":5.843,"vote_count":35,"credit_id":"5d6d1b5aefcea900129b7128","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/sHziVAGeGZktaD9IdLLXzMxGVvl.jpg","genre_ids":[878],"id":60813,"title":"Le Bunker de la dernière rafale","original_language":"fr","original_title":"Le Bunker de la dernière rafale","overview":"","popularity":1.7768,"poster_path":"/lWOYJZLPmxPYdYajeLLKIVzbwy8.jpg","release_date":"1982-02-01","softcore":false,"video":false,"vote_average":5.843,"vote_count":35,"credit_id":"5d6d1b7720ecaf00102a28df","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/sHziVAGeGZktaD9IdLLXzMxGVvl.jpg","genre_ids":[878],"id":60813,"title":"Le Bunker de la dernière rafale","original_language":"fr","original_title":"