vyGX.jpg","release_date":"2024-10-25","softcore":false,"video":false,"vote_average":7.188,"vote_count":3505,"credit_id":"660f8d2e88c65901629c6b03","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":926220,"title":"Make-Up","original_language":"sv","original_title":"Make-Up","overview":"","popularity":0.4575,"poster_path":"/hI1QFmv8PRm8z0Dvmha65FRBhw0.jpg","release_date":"2022-01-28","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"641efe47253fab00f3cca2ed","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":510406,"title":"Bergmans reliquarium","original_language":"sv","original_title":"Bergmans reliquarium","overview":"","popularity":1.6468,"poster_path":"/cgtT0e9YhDBLT5RBvRe2km2oH0J.jpg","release_date":"2018-01-27","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"credit_id":"5aa26b1e0e0a262c8000ac4d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":510406,"title":"Bergmans reliquarium","original_language":"sv","original_title":"Bergmans reliquarium","overview":"","popularity":1.6468,"poster_path":"/cgtT0e9YhDBLT5RBvRe2km2oH0J.jpg","release_date":"2018-01-27","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"credit_id":"5aa26b2bc3a36829b80099a3","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[16,10751],"id":1148274,"title":"Albert Åberg","original_language":"sv","original_title":"Albert Åberg","overview":"","popularity":0.4742,"poster_path":"/b13nS8OUL7LiEwYnornUXDWx5sq.jpg","release_date":"2022-09-23","softcore":false,"video":false,"vote_average":5.8,"vote_count":4,"credit_id":"64a55031158c8500e24a9efa","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dUbQHxtlbNC5S4SydcIEsV4XOXt.jpg","genre_ids":[18],"id":545081,"title":"Bergman Revisited","original_language":"sv","original_title":