oftcore":false,"video":false,"vote_average":6.667,"vote_count":9,"character":"Self","credit_id":"69691d042412730ebdf40c74","order":1},{"adult":false,"backdrop_path":"/dxrqrywrMeRE2ncaDfuxjsbfzNS.jpg","genre_ids":[35],"id":1650335,"title":"Martirio","original_language":"ca","original_title":"Martirio","overview":"","popularity":1.4443,"poster_path":"/ww6AZRDfIE6s6O46ESwSFeSWnNx.jpg","release_date":"2026-03-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"69b278a5e899618db902bdca","order":0}],"crew":[{"adult":false,"backdrop_path":"/aHAHmatqL6fuXJo9SCBRyadoW9c.jpg","genre_ids":[18],"id":804251,"title":"Alcarràs","original_language":"ca","original_title":"Alcarràs","overview":"Opowieść wypełniona nostalgiczną aurą końca lata i szerzej – małego końca świata, który znika w obliczu galopującej cywilizacji. W nagrodzonym Złotym Niedźwiedziem \"Alcarràs\" śledzimy blaski i cienie codziennego życia wielopokoleniowej rodziny z tytułowej wioski, która staje w obliczu utraty swojego gospodarstwa. \"Alcarràs\" pełne jest intensywnych smaków i zapachów, które przywodzą na myśl choćby \"Tamte dni, tamte noce\" Luki Guadagnina i ma w sobie znaną z \"Lata 1993\" (pamiętnego debiutu Carli Simón) autobiograficzną szczerość, ciepło i dyskretne poczucie humoru. W obu filmach umieszczenie w centrum dziecięcych bohaterów pozwoliło także na nadanie waloru niezwykłości pozornie błahym i codziennym wydarzeniom. Kameralne \"Alcarràs\" wykracza jednak poza ramy intymnego portretu rodziny i kieruje nasz wzrok również na palące problemy współczesności. Spokój prowincjonalnego świata zostaje tu bezpowrotnie zaburzony przez agresywne wtargnięcie postępu technologicznego.","popularity":3.3405,"poster_path":"/r4Y7sbhLyeKAFIYoV12PcgFwvNh.jpg","release_date":"2022-04-29","softcore":false,"video":false,"vote_average":6.756,"vote_count":236,"credit_id":"604821c4cedac40059cd227f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":