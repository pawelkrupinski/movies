h":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"68fbe64408c9d266214dc84a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1582246,"title":"Fathom","original_language":"en","original_title":"Fathom","overview":"","popularity":1.3261,"poster_path":"/25z7DF362spVpdAYMTPvyutufd9.jpg","release_date":"2025-11-07","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"691a82df0df41d57d460964b","department":"Sound","job":"Music"},{"adult":false,"backdrop_path":"/3oEM0dxZh2NfKMXnBAxjdxTEP0c.jpg","genre_ids":[99,10402],"id":1510390,"title":"Nova '78","original_language":"en","original_title":"Nova '78","overview":"","popularity":1.5596,"poster_path":"/aEgykN5Lc6ZYaPp2BjK5eAM91pC.jpg","release_date":"2026-07-30","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"699101da1f5614a9c7958959","department":"Sound","job":"Sound"},{"adult":false,"backdrop_path":"/t0GxYLiPkTtFBuzoPLmLU3HSKEN.jpg","genre_ids":[35],"id":11305,"title":"Mystery Train","original_language":"en","original_title":"Mystery Train","overview":"W Memphis, w stanie Tennessee, w ciągu jednej nocy, hotel Arcade, prowadzony przez ekscentrycznego nocnego recepcjonistę i nieuważnego boy'a, odwiedza młoda japońska para podróżująca w poszukiwaniu korzeni rocka; włoska kobieta w żałobie, która natyka się na uciekającą szarlatankę; oraz komiczne trio przypadkowych złodziei szukających miejsca do ukrycia.","popularity":3.5992,"poster_path":"/v71UH2G1NHvllGUZsewnOrhcS2A.jpg","release_date":"1989-09-06","softcore":false,"video":false,"vote_average":7.317,"vote_count":519,"credit_id":"69b70b9598d6e82d01673b5c","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/a7DtgKB187dUm9n81IlvNzVXsK1.jpg","genre_ids":[18,14,37],"id":922,"title":"Truposz","original_language":"en","original_title":"Dead Man","overview":"Film Jarmuscha jest opowiedzianą w konwencji westernu przejmującą opowieścią o umieraniu. Młody nieśmiały mężczyzna - William Blake przybywa do odległego miasteczka, ponieważ otrzymał w nim pracę. Chce rozpocząć nowe życie po śmierci rodziców i odejściu narzeczonej. Jednak po przyjeździe okazuje się, iż jego posada jest już zajęta. Zrezygnowany Blake spędza noc z przypadkowo spotkaną kobietą. Wydawać by się mogło niepozorna przygoda przeradza się jednak w podwójne morderstwo, o które nasz bohater zostaje oskarżony.","popularity":6.2584,"poster_path":"/pYeMIzO2M04kOzAuxL6OQwrPpoL.jpg","release_date":"1995-12-23","softcore":false,"video":false,"vote_average":7.303,"vote_count":1757,"credit_id":"69bc2b5a16a8024c6c2c9c47","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1663499,"title":"Garden of Ashes","original_language":"en","original_title":"Garden of Ashes","overview":"","popularity":0.3881,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69d0d5223a71ba49084b5ea2","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1708998,"title":"Int. Trailer. Night","original_language":"en","original_title":"Int. Trailer. Night","overview":"","popularity":0.6614,"poster_path":"/5945i9umynM6DA94WR0WW9rrrYw.jpg","release_date":"2002-05-18","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6a2310eddb2cefde3a501c52","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[10402],"id":1722142,"title":"SQÜRL, Man Ray's Backing Band","original_language":"en","original_title":"SQÜRL, Man Ray's Backing Band","overview":"","popularity":1.3011,"poster_path":null,"release_date":"2023-02-23","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"credit_id":"6a402e78f86e35f5fd99f7e0","department":"Production","job":"Executive Producer"}],"id":4429}