pierwszego amerykańskiego filmu Hammett.","popularity":1.3336,"poster_path":"/vB64asO8cEursipyjzCCBWTxEao.jpg","release_date":"1982-03-22","softcore":false,"video":false,"vote_average":6.41,"vote_count":83,"credit_id":"67cf750586fea60ab81dd046","department":"Sound","job":"Music"},{"adult":false,"backdrop_path":"/xfwWQxNGwgi798lcWV9RJL9OW0W.jpg","genre_ids":[99],"id":1451546,"title":"A Short Film by Jim Jarmusch, Starring Beatrice Domond","original_language":"en","original_title":"A Short Film by Jim Jarmusch, Starring Beatrice Domond","overview":"","popularity":0.5276,"poster_path":null,"release_date":"2025-03-20","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"credit_id":"67dc3e170d339bb7147fc1a6","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xfwWQxNGwgi798lcWV9RJL9OW0W.jpg","genre_ids":[99],"id":1451546,"title":"A Short Film by Jim Jarmusch, Starring Beatrice Domond","original_language":"en","original_title":"A Short Film by Jim Jarmusch, Starring Beatrice Domond","overview":"","popularity":0.5276,"poster_path":null,"release_date":"2025-03-20","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"credit_id":"67dc3e215ef4639ebae7b03c","department":"Crew","job":"Cinematography"},{"adult":false,"backdrop_path":"/n36zycrAqHn2uzx65IeAdnsZcMj.jpg","genre_ids":[35,18],"id":1159206,"title":"Father Mother Sister Brother","original_language":"en","original_title":"Father Mother Sister Brother","overview":"Trzy oddzielne historie dotyczą relacji między dorosłymi dziećmi, ich nieco odległym rodzicem (lub rodzicami) i sobą nawzajem. Każda z trzech części rozgrywa się w teraźniejszości i każda w innym kraju. Akcja „Ojca” rozgrywa się w północno-wschodniej części USA, „Matki” w Dublinie w Irlandii, a „Siostry” w Paryżu we Francji. Film jest serią studiów charakteru, cichych, obserwacyjnych i bezstronnych.","popularity":4.6625,"poster_path":"/96O3Ol3f2veMxAxYqsML8rOumB9.jpg","release_date":"2025-12-01","softcore":false,"