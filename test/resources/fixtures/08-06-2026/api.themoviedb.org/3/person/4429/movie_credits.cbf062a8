06","softcore":false,"video":false,"vote_average":5.9,"vote_count":219,"credit_id":"5a5cfda50e0a267439000a25","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/54o7yGJVp4wbUaQVrCi7AwPtzHA.jpg","genre_ids":[35,18],"id":37997,"title":"Nieustające wakacje","original_language":"en","original_title":"Permanent Vacation","overview":"Dwa i pół dnia z życia Aloysiousa Parkera, młodego Amerykanina, który nie ma domu, szkoły ani zawodu. Na swej nowojorskiej drodze spotyka różnych dziwnych ludzi - szaleńców, maniaków, outsiderów. Prowadzi z nimi krótkie rozmowy, załatwia różne drobne interesy i idzie dalej. Mówi o sobie: \"W pewnym sensie jestem turystą, turystą na nieustających wakacjach\".","popularity":1.2617,"poster_path":"/sISTkyG2cDOiox1Z4QvQf6r8NGf.jpg","release_date":"1981-03-06","softcore":false,"video":false,"vote_average":5.9,"vote_count":219,"credit_id":"5a5cfdb00e0a267436000a43","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/54o7yGJVp4wbUaQVrCi7AwPtzHA.jpg","genre_ids":[35,18],"id":37997,"title":"Nieustające wakacje","original_language":"en","original_title":"Permanent Vacation","overview":"Dwa i pół dnia z życia Aloysiousa Parkera, młodego Amerykanina, który nie ma domu, szkoły ani zawodu. Na swej nowojorskiej drodze spotyka różnych dziwnych ludzi - szaleńców, maniaków, outsiderów. Prowadzi z nimi krótkie rozmowy, załatwia różne drobne interesy i idzie dalej. Mówi o sobie: \"W pewnym sensie jestem turystą, turystą na nieustających wakacjach\".","popularity":1.2617,"poster_path":"/sISTkyG2cDOiox1Z4QvQf6r8NGf.jpg","release_date":"1981-03-06","softcore":false,"video":false,"vote_average":5.9,"vote_count":219,"credit_id":"5a5d000ac3a36842b7000c17","department":"Sound","job":"Music"},{"adult":false,"backdrop_path":"/9ouEgi8uazZAGTqAxGsmfBfaXct.jpg","genre_ids":[18],"id":105593,"title":"You Are Not I","original_language":"en","original_title":"You Are Not I","overview":"","popularity":0.6026,"poster_path":"/hfhxvs7S3fJ9IxcEQeCZ2OSgKZF.jpg","release_date":"1981-03-08","softcore":false,"video":false,"vote_average":6.667,"vote_count":15,"credit_id":"5ada4d48c3a3686a20000fe6","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/9ouEgi8uazZAGTqAxGsmfBfaXct.jpg","genre_ids":[18],"id":105593,"title":"You Are Not I","original_language":"en","original_title":"You Are Not I","overview":"","popularity":0.6026,"poster_path":"/hfhxvs7S3fJ9IxcEQeCZ2OSgKZF.jpg","release_date":"1981-03-08","softcore":false,"video":false,"vote_average":6.667,"vote_count":15,"credit_id":"5ada4d5592514123cc000f38","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1135913,"title":"Pre-Prom","original_language":"en","original_title":"Pre-Prom","overview":"","popularity":0.8158,"poster_path":"/d06ql2JZnvvoQIzMwOnGuMSlzOJ.jpg","release_date":"2023-06-16","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"64862ff8e272600147ba725f","department":"Sound","job":"Music"},{"adult":false,"backdrop_path":"/cXyfAViYly0Lk2CVpEKgYbt9wKQ.jpg","genre_ids":[35,18,27],"id":535581,"title":"Truposze nie umierają","original_language":"en","original_title":"The Dead Don't Die","overview":"W sennym miasteczku Centerville coś nie gra. Wielki księżyc wisi jakby niżej niż zwykle, godziny dnia przychodzą niespodziewanie, a zwierzęta zachowują się tak, jak nie zachowywały się wcześniej. I nikt nie wie dlaczego. Doniesienia mediów są złowieszcze, naukowcy wydają się skonfundowani. Ale nikt nie przewiduje tego, co za chwilę spotka Centerville – umarli nie umarli. Wstają z grobów i brutalnie polują na żywych. Mieszkańcy miasta muszą walczyć o przetrwanie.","popularity":5.5573,"poster_path":"/xN9JhhPIopQF7QBloW8qO5wh9dW.jpg","release_date":"2019-05-15","softcore":false,"video":false,"vote_average":5.435,"vote_count":2892,"credit_id":"5b48ede0c3a368452a00c613","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/cXyfAViYly0Lk2CVpEKgYbt9wKQ.jpg","genre_ids":[35,18,27],"id":535581,"title":"Truposze nie umierają","original_language":"en","original_title":"The Dead Don't Die","overview":"W sennym miasteczku Centerville coś nie gra. Wielki księżyc wisi jakby niżej niż zwykle, godziny dnia przychodzą niespodziewanie, a zwierzęta zachowują się tak, jak nie zachowywały się wcześniej. I nikt nie wie dlaczego. Doniesienia mediów są złowieszcze, naukowcy wydają się skonfundowani. Ale nikt nie przewiduje tego, co za chwilę spotka Centerville – umarli nie umarli. Wstają z grobów i brutalnie polują na żywych. Mieszkańcy miasta muszą walczyć o przetrwanie.","popularity":5.5573,"poster_path":"/xN9JhhPIopQF7QBloW8qO5wh9dW.jpg","release_date":"2019-05-15","softcore":false,"video":false,"vote_average":5.435,"vote_count":2892,"credit_id":"5b48edea925141252d0021bd","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/n36zycrAqHn2uzx65IeAdnsZcMj.jpg","genre_ids":[35,18],"id":1159206,"title":"Father Mother Sister Brother","original_language":"en","original_title":"Father Mother Sister Brother","overview":"Trzy oddzielne historie dotyczą relacji między dorosłymi dziećmi, ich nieco odległym rodzicem (lub rodzicami) i sobą nawzajem. Każda z trzech części rozgrywa się w teraźniejszości i każda w innym kraju. Akcja „Ojca” rozgrywa się w północno-wschodniej części USA, „Matki” w Dublinie w Irlandii, a „Siostry” w Paryżu we Francji. Film jest serią studiów charakteru, cichych, obserwacyjnych i bezstronnych.","popularity":4.6625,"poster_path":"/96O3Ol3f2veMxAxYqsML8rOumB9.jpg","release_date":"2025-12-01","softcore":false,"video":false,"vote_average":6.377,"vote_count":317,"credit_id":"64c9b08edd83fa00adb47975","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/n36zycrAqHn2uzx65IeAdnsZcMj.jpg","genre_ids":[35,18],"id":1159206,"title":"Father Mother Sister Brother","original_language":"en","original_title":"Father Mother Sister Brother","overview":"Trzy oddzielne historie dotyczą relacji między dorosłymi dziećmi, ich nieco odległym rodzicem (lub rodzicami) i sobą nawzajem. Każda z trzech części rozgrywa się w teraźniejszości i każda w innym kraju. Akcja „Ojca” rozgrywa się w północno-wschodniej części USA, „Matki” w Dublinie w Irlandii, a „Siostry” w Paryżu we Francji. Film jest serią studiów charakteru, cichych, obserwacyjnych i bezstronnych.","popularity":4.6625,"poster_path":"/96O3Ol3f2veMxAxYqsML8rOumB9.jpg","release_date":"2025-12-01","softcore":false,"video":false,"vote_average":6.377,"vote_count":317,"credit_id":"64c9b094001bbd0126a74bb3","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/9oRbHgbJf1Zr2fct8jBIKadpKya.jpg","genre_ids":[80,18],"id":4816,"title":"Ghost Dog: Droga samuraja","original_language":"en","original_title":"Ghost Dog: The Way of the Samurai","overview":"Ghost Dog jest płatnym mordercą, pracującym dla najważniejszego bosa włoskiej mafii. Podczas porachunków gangów przypadkowo z opresji ratuje go inny gangster. Ghost Dog jako wyznawca zen i zwolennik kodeksu samurajskiego bushido, całkowicie oddaje się w ręce swego wybawiciela. Pracując dla niego, przeciwstawia się włoskiej mafii.","popularity":5.3907,"poster_path":"/9drRkmepNSP99Thsi6j4gQXNcls.jpg","release_date":"1999-10-06","softcore":false,"video":false,"vote_average":7.347,"vote_count":1429,"credit_id":"5e1f8100d6dbba0015e1f2c2","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[10402],"id":554297,"title":"Red Hot + Blue: A Tribute to Cole Porter","original_language":"en","original_title":"Red Hot + Blue: A Tribute to Cole Porter","overview":"","popularity":1.6403,"poster_path":"/mCTf3myRuYxXApqnViG8MJUmiUi.jpg","release_date":"1990-12-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5ecc7fe819690c001e6fe6f6","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wwIBaqdAiClTfL4ftQJ9Zs1SdbU.jpg","genre_ids":[18],"id":20161,"title":"Explicit Ills","orig