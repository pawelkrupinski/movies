u4fAPcid1koHYegAe62NfPn2.jpg","release_date":"2007-05-22","softcore":false,"video":true,"vote_average":6.0,"vote_count":2,"character":"Self","credit_id":"5e860ccc5aba320014e75611","order":3},{"adult":false,"backdrop_path":"/hKmVHmzOFBmHNpSPzHD5DsjJF0g.jpg","genre_ids":[99],"id":830554,"title":"Ti vogliamo bene Francesco Nuti","original_language":"it","original_title":"Ti vogliamo bene Francesco Nuti","overview":"","popularity":1.1381,"poster_path":"/fK8oqSeIb0uYHS9lx3diFdBSQGk.jpg","release_date":"2021-05-17","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"character":"","credit_id":"60a2289a51e6ab00778112ac","order":17}],"crew":[{"adult":false,"backdrop_path":"/5jhG1lTgV0MS6tDkBMQSSitttTT.jpg","genre_ids":[18],"id":1402,"title":"W pogoni za szczęściem","original_language":"en","original_title":"The Pursuit of Happyness","overview":"Historia borykającego się z przeciwnościami losu Chrisa Gardnera (w tej roli nominowany do Oscara Will Smith) i jego rodziny. Kiedy Linda, matka 5-letniego Christophera ugina się pod ciężarem finansowych trudności i opuszcza rodzinę, mężczyzna musi poradzić sobie ze znalezieniem dobrze płatnej posady oraz zapewnieniem dziecku dachu nad głową. Po wielu próbach Chris otrzymuje propozycję odbycia bezpłatnego stażu w prestiżowej firmie brokerskiej. Zdesperowany, bez środków do życia, Gardner decyduje się skorzystać z propozycji. Dzięki pewności siebie i miłości synka, Chris Gardner przezwycięża trudności stając się jedną z legendarnych postaci Wall Street.","popularity":20.5465,"poster_path":"/hbyfXeMMJ6b9W2PsyjvRjTts9Tq.jpg","release_date":"2006-12-14","softcore":false,"video":false,"vote_average":7.886,"vote_count":10736,"credit_id":"52fe42f3c3a36847f802f1ab","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hsAZKgLMhReTakzdBxCAJsTinea.jpg","genre_ids":[10749,18,35],"id":606566,"title":"Najlepsze lata","original_language":"it","original_title":"Gli anni più belli","overview":"Paolo, Giulio and Riccardo poznają się w Rzymie podczas ulicznych zamieszek w 1982 roku. Trójka idealistycznych i głodnych życia nastolatków staje się nierozłączna, a niedługo później zgrany tercet dopełnia piękna złotowłosa Gemma, w której Paolo szaleńczo się zakochuje. Z biegiem czasu życie weryfikuje marzenia bohaterów, przynosi osobiste rozczarowania, krach ideowy, zawodowe frustracje. Jednocześnie jednak rosnąca samoświadomość i dojrzałość pozwalają czwórce przyjaciół podjąć próby naprawy zniszczonych przez złe wybory relacji.","popularity":1.529,"poster_path":"/5PZpGJiv7YS9RMiM9TeGpSOJypd.jpg","release_date":"2020-02-13","softcore":false,"video":false,"vote_average":6.809,"vote_count":438,"credit_id":"620ae407d8cc4a00319c82da","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/hsAZKgLMhReTakzdBxCAJsTinea.jpg","genre_ids":[10749,18,35],"id":606566,"title":"Najlepsze lata","original_language":"it","original_title":"Gli anni più belli","overview":"Paolo, Giulio and Riccardo poznają się w Rzymie podczas ulicznych zamieszek w 1982 roku. Trójka idealistycznych i głodnych życia nastolatków staje się nierozłączna, a niedługo później zgrany tercet dopełnia piękna złotowłosa Gemma, w której Paolo szaleńczo się zakochuje. Z biegiem czasu życie weryfikuje marzenia bohaterów, przynosi osobiste rozczarowania, krach ideowy, zawodowe frustracje. Jednocześnie jednak rosnąca samoświadomość i dojrzałość pozwalają czwórce przyjaciół podjąć próby naprawy zniszczonych przez złe wybory relacji.","popularity":1.529,"poster_path":"/5PZpGJiv7YS9RMiM9TeGpSOJypd.jpg","release_date":"2020-02-13","softcore":false,"video":false,"vote_average":6.809,"vote_count":438,"credit_id":"620ae40ef3e0df002a721262","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/mDu3nkdjzkJ9loy3QyppGcLjaI7.jpg","genre_ids":[18],"id":11321,"title":"Siedem dusz","original_language":"en","original_title":"Seven Pounds","overview":"Film \"Siedem dusz\" to pełna tajemnic, zaskakująca historia miłosna, która zadaje prowokacyjne pytania na temat życia i śmierci, żalu i przebaczenia, przyjaźni, miłości i odkupienia. Opowiada o związkach, które w bardzo nieoczekiwany sposób łączą ze sobą ludzkie losy. To poruszająca opowieść o człowieku nękanym pewną tajemnicą, który decyduje się odkupić swoje winy drastycznie zmieniając życie siedmiu zupełnie obcych sobie osób. Kiedy już wprowadza swój plan w czyn, nic nie jest w stanie zmienić jego postanowienia. A może tak mu się tylko wydaje... Ben Thomas nigdy nie spodziewałby się tego, że zakocha się  w jednej z nieznajomych i to właśnie ona zacznie go zmieniać.","popularity":7.7477,"poster_path":"/pgdGJfSGtg7fYwq4eI2IoevZ218.jpg","release_date":"2008-12-18","softcore":false,"video":false,"vote_average":7.599,"vote_count":7319,"credit_id":"52fe44259251416c7502a647","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hLSwAHrNDSVyBY2VrlbAuTG30ep.jpg","genre_ids":[35,18,10749],"id":7511,"title":"Przyjaciele","original_language":"en","original_title":"The Last Kiss","overview":"","popularity":3.0339,"poster_path":"/aXEoGmvSuYSgdLzwuIPniK08VX3.jpg","release_date":"2006-09-10","softcore":false,"video":false,"vote_average":6.044,"vote_count":407,"credit_id":"52fe4481c3a36847f809a121","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/hLSwAHrNDSVyBY2VrlbAuTG30ep.jpg","genre_ids":[35,18,10749],"id":7511,"title":"Przyjaciele","original_language":"en","original_title":"The Last Kiss","overview":"","popularity":3.0339,"poster_path":"/aXEoGmvSuYSgdLzwuIPniK08VX3.jpg","release_date":"2006-09-10","softcore":false,"video":false,"vote_average":6.044,"vote_count":407,"credit_id":"52fe4481c3a36847f809a145","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/8sajLN5R5jNhqnYbL6KgRHDepa.jpg","genre_ids":[35,18,10749],"id":12308,"title":"L'ultimo bacio","original_language":"it","original_title":"L'ultimo bacio","overview":"","popularity":1.9768,"poster_path":"/ic