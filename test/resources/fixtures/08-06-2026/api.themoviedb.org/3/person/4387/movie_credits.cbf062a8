deo":false,"vote_average":6.504,"vote_count":116,"credit_id":"52fe453b9251416c9102bbfd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":754425,"title":"A Curtain Raiser & Other Shorts","original_language":"fr","original_title":"A Curtain Raiser & Other Shorts","overview":"","popularity":0.7151,"poster_path":"/b9lN0TmTIG99YRfmxqXwxhDF3zG.jpg","release_date":"2007-09-04","softcore":false,"video":true,"vote_average":2.667,"vote_count":3,"credit_id":"607900427464570029d93ef3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jxt4rOQm7B2tmPUY7rrCouNSob4.jpg","genre_ids":[35],"id":44484,"title":"Action vérité","original_language":"fr","original_title":"Action vérité","overview":"","popularity":1.5111,"poster_path":"/bmGIFHlaR72z4UYSNerLQZ25TfD.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":6.25,"vote_count":30,"credit_id":"52fe468bc3a36847f8104b79","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dolTehtRFO6B6yVu21yU7TBShot.jpg","genre_ids":[18,53],"id":46748,"title":"Spójrz na morze","original_language":"fr","original_title":"Regarde la mer","overview":"","popularity":0.8239,"poster_path":"/rESAN6IaAkoblJPW4pOgjOqFNhA.jpg","release_date":"1997-12-03","softcore":false,"video":false,"vote_average":6.486,"vote_count":36,"credit_id":"52fe470ac3a36847f81206b9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dolTehtRFO6B6yVu21yU7TBShot.jpg","genre_ids":[18,53],"id":46748,"title":"Spójrz na morze","original_language":"fr","original_title":"Regarde la mer","overview":"","popularity":0.8239,"poster_path":"/rESAN6IaAkoblJPW4pOgjOqFNhA.jpg","release_date":"1997-12-03","softcore":false,"video":false,"vote_average":6.486,"vote_count":36,"credit_id":"52fe470ac3a36847f81206bf","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/20eu7LBcBnQg6hmQLfp6jXd22go.jpg","genre_ids":[35,18,53,10749],"id":46761,"title":"Sitcom","original_language":"fr","original_title":"Sitcom","overview":"Francuska rodzina żyje w zgodzie i harmonii - aż do chwili, gdy ojciec przynosi do domu szczura.\r Pod wpływem jego obecności członkowie rodziny stopniowo ujawniają swe ukryte skłonności. Nieśmiały syn zaczyna urządzać orgie, matka ulega kazirodczym obsesjom. Wreszcie ojciec postanawia interweniować... Film jest jedną wielką kpiną z nieskazitelnej burżuazji, której wartości sprowadzono tu do poziomu sitcomu.\r Noszący ślady inspiracji dziełami Jona'a Watersa, Luis'a Bunuela i Joe Ortona \"Sitcom\" odważnie łączy elementy farsy, horroru i melodramatu jednocześnie bezlitośnie niszcząc konwencje sitcomu. Znakomicie zagrany, pełen humoru przedstawianego ze śmiertelną powagą. Muzyka ze ścieżki dźwiękowej filmu zawiera zarówno utwory Mahlera i Beethowena jak i \"Rhythm of the Night\", co świadczy, że ograniczenia budżetu nie muszą ograniczać inwencji twórczej. [opis dystrybutora]","popularity":1.6546,"poster_path":"/hwXSsTIhutvY15cwI11y5uaCGVI.jpg","release_date":"1998-05-27","softcore":false,"video":false,"vote_average":6.464,"vote_count":138,"credit_id":"52fe470bc3a36847f8120925","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/20eu7LBcBnQg6hmQLfp6jXd22go.jpg","genre_ids":[35,18,53,10749],"id":46761,"title":"Sitcom","original_language":"fr","original_title":"Sitcom","overview":"Francuska rodzina żyje w zgodzie i harmonii - aż do chwili, gdy ojciec przynosi do domu szczura.\r Pod wpływem jego obecności członkowie rodziny stopniowo ujawniają swe ukryte skłonności. Nieśmiały syn zaczyna urządzać orgie, matka ulega kazirodczym obsesjom. Wreszcie ojciec postanawia interweniować... Film jest jedną wielką kpiną z nieskazitelnej burżuazji, której wartości sprowadzono tu do poziomu sitcomu.\r Noszący ślady inspiracji dziełami Jona'a Watersa, Luis'a Bunuela i Joe Ortona \"Sitcom\" odważnie łączy elementy farsy, horroru i melodramatu jednocześnie bezlitośnie niszcząc konwencje sitcomu. Znakomicie zagrany, pełen humoru przedstawianego ze śmiertelną powagą. Muzyka ze ścieżki dźwiękowej filmu zawiera zarówno utwory Mahlera i Beethowena jak i \"Rhythm of the Night\", co świadczy, że ograniczenia budżetu nie muszą ograniczać inwencji twórczej. [opis dystrybutora]","popularity":1.6546,"poster_path":"/hwXSsTIhutvY15cwI11y5uaCGVI.jpg","release_date":"1998-05-27","softcore":false,"video":false,"vote_average":6.464,"vote_count":138,"credit_id":"52fe470bc3a36847f812092b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/qur3fyWlQbxAJuWggw3FCcMUr6m.jpg","genre_ids":[35,18],"id":47233,"title":"X2000","original_language":"fr","original_title":"X2000","overview":"","popularity":1.1271,"poster_path":"/kPzDYSsnn5wziXk7mKaSDC14yRD.jpg","release_date":"1998-11-21","softcore":false,"video":false,"vote_average":5.609,"vote_count":23,"credit_id":"52fe4726c3a36847f8125edd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/p2QyxIZm8hxqNtVL6LHCB8xZWEY.jpg","genre_ids":[18,10749],"id":48782,"title":"Letnia sukienka","original_language":"fr","original_title":"Une robe d'été","overview":"Jest lato. Sebastien kocha Sheilę. Lucia kocha chłopców. Za to Frédéric chce się tylko opalać.","popularity":1.2432,"poster_path":"/g0rgAszUGSnlmZX1ICyuSBFPg8B.jpg","release_date":"1996-05-01","softcore":false,"video":false,"vote_average":6.946,"vote_count":46,"credit_id":"52fe4775c3a36847f8136a7f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/p2QyxIZm8hxqNtVL6LHCB8xZWEY.jpg","genre_ids":[18,10749],"id":48782,"title":"Letnia sukienka","original_language":"fr","original_title":"Une robe d'été","overview":"Jest lato. Sebastien kocha Sheilę. Lucia kocha chłopców. Za to Frédéric chce się tylko opalać.","popularity":1.2432,"poster_path":"/g0rgAszUGSnlmZX1ICyuSBFPg8B.jpg","release_date":"1996-05-01","softcore":false,"video":false,"vote_average":6.946,"vote_count":46,"credit_id":"52fe4775c3a36847f8136a85","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/d4rvNlEwC74QMmngsT0RaBjC1GT.jpg","genre_ids":[18],"id":48788,"title":"Victor","original_language":"fr","original_title":"Victor","overview":"","popularity":0.531,"poster_path":"/fYqkv2BFpzWMvlzhuXBnMpGvBPQ.jpg","release_date":"1993-01-01","softcore":false,"video":false,"vote_average":5.643,"vote_count":7,"credit_id":"52fe4775c3a36847f8136b17","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/AeGWtcpSQs8DldZV1XB5lHeEkhy.jpg","genre_ids":[18],"id":49150,"title":"Mała śmierć","original_language":"fr","original_title":"La petite mort","overview":"","popularity":0.7728,"poster_path":"/b9yHngLDYfwBdfeGSxiDqju0o9p.jpg","release_date":"1995-01-01","softcore":false,"video":false,"vote_average":6.024,"vote_count":21,"credit_id":"52fe4788c3a36847f813ae6f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rXlRtvC4JJvIUtJrgKHNZ3iccfK.jpg","genre_ids":[18,10749],"id":49276,"title":"Scènes de lit","original_language":"fr","original_title":"Scènes de lit","overview":"","popularity":1.4069,"poster_path":"/q9fXInbie5KREKRDYLZUC7duK4G.jpg","release_date":"1998-06-21","softcore":false,"video":false,"vote_average":5.882,"vote_count":17,"credit_id":"52fe478dc3a36847f813bd41","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kheLekTrNqfXvYnBE9P4u7FM6rX.jpg","genre_ids":[18],"id":51971,"title":"Schronienie","original_language":"fr","original_title":"Le Refuge","overview":"Mousse (Isabelle Carré) i Louis (Melvil Poupaud) są młodzi, piękni, bogaci i zakochani. Sielankę zakłócają jednak narkotyki, które w krótkim czasie zawładnęły ich życiem. Pewnego dnia para przedawkowała i Louis zmarł. Mousse żyje dalej, odkrywając wkrótce, że jest w ciąży. Na tę wieść ucieka jak najdalej od Paryża. Parę miesięcy później jej \"schronienie\" odkrywa brat zmarłego.","popularity":1.1667,"poster_path":"/pzllac8Y0QoCzqRLpffRm5KJs3g.jpg","release_date":"2009-12-11","softcore":false,"video":false,"vote_average":6.116,"vote_count":86,"credit_id":"52fe480fc3a36847f8156589","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9LuYZthVehg2WWpNhGBXi7wqdRN.jpg","genre_ids":[35],"id":51447,"title":"Żona doskonała","original_language":"fr","original_title":"Potiche","overview":"Suzanne (Catherine Deneuve) jest żoną bogatego przemysłowca, który żelazną ręką kieruje fabryką parasolek. Swoją żonę sprowadził do roli uległej pani domu, która skrzętnie wypełnia codzienne obowiązki i służy mu jako luksusowa ozdoba. Pewnego dnia pracownicy fabryki buntują się przeciwko szefowi i biorą go za zakładnika. Nagle rodzinne i biznesowe sprawy spadają na barki Suzanne, która ku zaskoczeniu wszystkich ujawnia nieznane dotąd oblicze swojej kobiecości - energiczne, przebojowe i zniewalające. Przy okazji na światło dzienne wychodzi wiele skrzętnie skrywanych rodzinnych tajemnic...","popularity":2.5855,"poster_path":"/o0GymlAocv4nB44f1ywh9Z34RT7.jpg","release_date":"2010-11-10","softcore":false,"video":false,"vote_average":6.137,"vote_count":394,"credit_id":"52fe47f4c3a36847f815124b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rSlu3MWZzOVBy6e6UEw9mPLMzUO.jpg","genre_ids":[35,18,9648,53],"id":121875,"title":"U niej w domu","original_language":"fr","original_title":"Dans la maison","overview":"Życie znudzonego nauczyciela zmieni się, gdy pozna uzdolnionego pisarsko 16-letniego Claude'a. Chłopak opisuje szczegóły dnia codziennego w domu swojego kolegi.","popularity":6.3141,"poster_path":"/1cWpFhRViNIrL3bSC3FEa3n4B70.jpg","release_date":"2012-09-26","softcore":false,"video":false,"vote_average":7.243,"vote_count":919,"credit_id":"52fe4a70c3a368484e153315","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/mBtZhh2MCOoY5Jwniuny6bKNL79.jpg","genre_ids":[10749,18],"id":898673,"title":"Przejścia","original_language":"fr","original_title":"Passages","overview":"„Przejścia\", czyli o współczesnych związkach w wersji tylko dla dorosłych. Multikulturowy Paryż, a w nim troje kochanków uwikłanych w ryzykowną grę w pożądanie. Gwiazda europejskiego kina Franz Rogowski, rozsławiony filmem „Pachnidło\"\" Ben Whishaw oraz znana z „Życia Adeli\"\" i „Pięciu diabłów\"\" Adèle Exarchopoulos tworzą w głośnym dramacie Iry Sachsa erotyczny trójkąt, w którym seks i uczucia dają wybuchową mieszankę. „Przejścia\"\" to odważne, seksowne, ale jednocześnie zabawne i zmysłowe spojrzenie na współczesne relacje – dla widzów, którzy nie boją się spojrzeć w filmowe lustro.","popularity":3.1117,"poster_path":"/6Ziijhl8l0GPKZGgHSKHHO17A5t.jpg","release_date":"2023-06-28","softcore":false,"video":false,"vote_average":6.305,"vote_count":238,"credit_id":"64e175442495ab013a089d9f","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/d4rvNlEwC74QMmngsT0RaBjC1GT.jpg","genre_ids":[18],"id":48788,"title":"Victor","original_language":"fr","original_title":"Victor","overview":"","popularity":0.531,"poster_path":"/fYqkv2BFpzWMvlzhuXBnMpGvBPQ.jpg","release_date":"1993-01-01","softcore":false,"video":false,"vote_average":5.643,"vote_count":7,"credit_id":"60ebb653f9a3fb005c212d30","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":754425,"title":"A Curtain Raiser & Other Shorts","original_language":"fr","original_title":"A Curtain Raiser & Other Shorts","overview":"","popularity":0.7151,"poster_path":"/b9lN0TmTIG99YRfmxqXwxhDF3zG.jpg","release_date":"2007-09-04","softcore":false,"video":true,"vote_average":2.667,"vote_count":3,"credit_id":"60ebb81253f833005d2183c2","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/z3zeYgp8P8SqTypwatOHINDCnHM.jpg","genre_ids":[18,53,35],"id":1171634,"title":"Kiedy nadchodzi jesień","original_language":"fr","original_title":"Quand vient l'automne","overview":"Michelle, pod każdym względem dobra babcia, wiedzie spokojną emeryturę w małej wiosce w Burgundii, niedaleko swojej najlepszej przyjaciółki Marie-Claude. W Dzień Wszystkich Świętych odwiedza ją jej córka Valérie i przywozi syna Lucasa na tygodniowe wakacje. Ale nic nie idzie zgodnie z planem.","popularity":2.011,"poster_path":"/zEhKOyBjwIVAulYMBge09p7zIFy.jpg","release_date":"2024-10-02","softcore":false,"video":false,"vote_average":6.646,"vote_count":239,"credit_id":"64ef0d4377d23b012e895771","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/z3zeYgp8P8SqTypwatOHINDCnHM.jpg","genre_ids":[18,53,35],"id":1171634,"title":"Kiedy nadchodzi jesień","original_language":"fr","original_title":"Quand vient l'automne","overview":"Michelle, pod każdym względem dobra babcia, wiedzie spokojną emeryturę w małej wiosce w Burgundii, niedaleko swojej najlepszej przyjaciółki Marie-Claude. W Dzień Wszystkich Świętych odwiedza ją jej córka Valérie i przywozi syna Lucasa na tygodniowe wakacje. Ale nic nie idzie zgodnie z planem.","popularity":2.011,"poster_path":"/zEhKOyBjwIVAulYMBge09p7zIFy.jpg","release_date":"2024-10-02","softcore":false,"video":false,"vote_average":6.646,"vote_count":239,"credit_id":"64ef0d4897a4e6011baec682","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/6NQqojkmxGe3sxs9bNx6Mi9BuOd.jpg","genre_ids":[18],"id":184314,"title":"Młoda i piękna","original_language":"fr","original_title":"Jeune & Jolie","overview":"17-letnia Isabelle pochodzi z bogatej paryskiej rodziny. Podczas wakacyjnego wyjazdu z najbliższymi spotyka przystojnego Niemca, z którym przeżywa swój \"pierwszy raz\". Po powrocie do domu nic już nie jest takie jak przedtem. W krótkim czasie Isabelle z nieśmiałej dziewicy przeobraża się w gotową na wszystko luksusową prostytutkę. Starannie dobiera partnerów i każe im słono płacić za swoje usługi. Prowadzi podwójne życie. Jest przykładną studentką i panną z dobrego domu, a równocześnie zarabia duże pieniądze jako ekskluzywna call-girl. Jednak, w wyniku splotu okoliczności, pewnego dnia matka Isabelle odkryje szokujący sekret córki","popularity":1.2027,"poster_path":"/c5dbt5y4xyTUQ6ZfejK9P2mhxto.jpg","release_date":"2013-08-21","softcore":false,"video":false,"vote_average":6.512,"vote_count":1336,"credit_id":"52fe4cbd9251416c751240f3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6NQqojkmxGe3sxs9bNx6Mi9BuOd.jpg","genre_ids":[18],"id":184314,"title":"Młoda i piękna","original_language":"fr","original_title":"Jeune & Jolie","overview":"17-letnia Isabelle pochodzi z bogatej paryskiej rodziny. Podczas wakacyjnego wyjazdu z najbliższymi spotyka przystojnego Niemca, z którym przeżywa swój \"pierwszy raz\". Po powrocie do domu nic już nie jest takie jak przedtem. W krótkim czasie Isabelle z nieśmiałej dziewicy przeobraża się w gotową na wszystko luksusową prostytutkę. Starannie dobiera partnerów i każe im słono płacić za swoje usługi. Prowadzi podwójne życie. Jest przykładną studentką i panną z dobrego domu, a równocześnie zarabia duże pieniądze jako ekskluzywna call-girl. Jednak, w wyniku splotu okoliczności, pewnego dnia matka Isabelle odkryje szokujący sekret córki","popularity":1.2027,"poster_path":"/c5dbt5y4xyTUQ6ZfejK9P2mhxto.jpg","release_date":"2013-08-21","softcore":false,"video":false,"vote_average":6.512,"vote_count":1336,"credit_id":"52fe4cbd9251416c751240f9","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/czVIuIXqDPgCBHI3vLYQcRtzAo7.jpg","genre_ids":[80,35,9648,18],"id":977506,"title":"Moja zbrodnia","original_language":"fr","original_title":"Mon crime","overview":"Paryż, rok 1935. Madeleine Verdier, aspirująca aktorka odganiająca się od wierzycieli, zostaje oskarżona o zamordowanie znanego producenta, który próbował ją wykorzystać. Na szczęście jej współlokatorka jest prawniczką. Czy uda się uniewinnić Madeleine? I rzeczywiście jest ona niewinna? Komedia kryminalna w reżyserii Françoisa Ozona, twórcy „Basenu” i „8 kobiet”.","popularity":3.4765,"poster_path":"/ruNxZl1F7QB52fekXwRqSWi9ZKV.jpg","release_date":"2023-02-24","softcore":false,"video":false,"vote_average":6.481,"vote_count":468,"credit_id":"62860c87ec455251271ec95e","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18,27],"id":1178905,"title":"Le trou noir","original_language":"en","original_title":"Le trou noir","overview":"","popularity":0.65,"poster_path":"/8Bq1ilz4BlVhgbqsx50t86zMtyq.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"650428b3d7dcd2011c6245de","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rXlRtvC4JJvIUtJrgKHNZ3iccfK.jpg","genre_ids":[18,10749],"id":49276,"title":"Scènes de lit","original_language":"fr","original_title":"Scènes de lit","overview":"","popularity":1.4069,"poster_path":"/q9fXInbie5KREKRDYLZUC7duK4G.jpg","release_date":"1998-06-21","softcore":false,"video":false,"vote_average":5.882,"vote_count":17,"credit_id":"5368cbe20e0a2647d1007bff","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/z3zeYgp8P8SqTypwatOHINDCnHM.jpg","genre_ids":[18,53,35],"id":1171634,"title":"Kiedy nadchodzi jesień","original_language":"fr","original_title":"Quand vient l'automne","overview":"Michelle, pod każdym względem dobra babcia, wiedzie spokojną emeryturę w małej wiosce w Burgundii, niedaleko swojej najlepszej przyjaciółki Marie-Claude. W Dzień Wszystkich Świętych odwiedza ją jej córka Valérie i przywozi syna Lucasa na tygodniowe wakacje. Ale nic nie idzie zgodnie z planem.","popularity":2.011,"poster_path":"/zEhKOyBjwIVAulYMBge09p7zIFy.jpg","release_date":"2024-10-02","softcore":false,"video":false,"vote_average":6.646,"vote_count":239,"credit_id":"651bd7d0967cc73427f2616a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/gi88gFtqxVRZPT5AIWwwKzAuzHF.jpg","genre_ids":[18],"id":283726,"title":"Nowa dziewczyna","original_language":"fr","original_title":"Une nouvelle amie","overview":"Claire i Laura to najlepsze przyjaciółki od dzieciństwa. Są nierozłączne i dzielą ze sobą wszystkie najważniejsze momenty życia. Pewnego dnia Laura zapada na ciężką chorobę i wkrótce potem umiera. Claire popada w depresję. Chcąc sobie poradzić ze stratą, zaczyna pomagać Davidowi – mężowi przyjaciółki, który samotnie wychowuje niemowlę. Kobieta nie wie jednak, że mężczyzna ukrywa przed światem mroczny sekret. Podczas niezapowiedzianej wizyty w domu Laury i Davida, Claire natyka się na tajemniczą Virginię. Nowa dziewczyna ma na sobie ubrania Laury, a w jej twarzy jest coś niepokojąco znajomego.[filmweb.pl]","popularity":1.7033,"poster_path":"/yXfeQnlRUYasDje66jeqqKJppTA.jpg","release_date":"2014-10-11","softcore":false,"video":false,"vote_average":6.064,"vote_count":318,"credit_id":"53d2a78fc3a368776a00c144","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/gi88gFtqxVRZPT5AIWwwKzAuzHF.jpg","genre_ids":[18],"id":283726,"title":"Nowa dziewczyna","original_language":"fr","original_title":"Une nouvelle amie","overview":"Claire i Laura to najlepsze przyjaciółki od dzieciństwa. Są nierozłączne i dzielą ze sobą wszystkie najważniejsze momenty życia. Pewnego dnia Laura zapada na ciężką chorobę i wkrótce potem umiera. Claire popada w depresję. Chcąc sobie poradzić ze stratą, zaczyna pomagać Davidowi – mężowi przyjaciółki, który samotnie wychowuje niemowlę. Kobieta nie wie jednak, że mężczyzna ukrywa przed światem mroczny sekret. Podczas niezapowiedzianej wizyty w domu Laury i Davida, Claire natyka się na tajemniczą Virginię. Nowa dziewczyna ma na sobie ubrania Laury, a w jej twarzy jest coś niepokojąco znajomego.[filmweb.pl]","popularity":1.7033,"poster_path":"/yXfeQnlRUYasDje66jeqqKJppTA.jpg","release_date":"2014-10-11","softcore":false,"video":false,"vote_average":6.064,"vote_count":318,"credit_id":"5413ce32c3a3687dae000d3e","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/kheLekTrNqfXvYnBE9P4u7FM6rX.jpg","genre_ids":[18],"id":51971,"title":"Schronienie","original_language":"fr","original_title":"Le Refuge","overview":"Mousse (Isabelle Carré) i Louis (Melvil Poupaud) są młodzi, piękni, bogaci i zakochani. Sielankę zakłócają jednak narkotyki, które w krótkim czasie zawładnęły ich życiem. Pewnego dnia para przedawkowała i Louis zmarł. Mousse żyje dalej, odkrywając wkrótce, że jest w ciąży. Na tę wieść ucieka jak najdalej od Paryża. Parę miesięcy później jej \"schronienie\" odkrywa brat zmarłego.","popularity":1.1667,"poster_path":"/pzllac8Y0QoCzqRLpffRm5KJs3g.jpg","release_date":"2009-12-11","softcore":false,"video":false,"vote_average":6.116,"vote_count":86,"credit_id":"544a8b73c3a3680faa004564","department":"Writing","job":"Novel"},{"adult":false,"backdrop_path":"/qQn5m8HU52kLv1BfsICJPFbDbaU.jpg","genre_ids":[18],"id":48786,"title":"Une rose entre nous","original_language":"fr","original_title":"Une rose entre nous","overview":"","popularity":0.5951,"poster_path":"/2vDzl0MlszBfxWF55OsR0jM6mNR.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":4.889,"vote_count":9,"credit_id":"547184f29251414c9e001d50","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/se9b3c47yN4BJ05HNbNyAXbwjtj.jpg","genre_ids":[35,9648,80],"id":890541,"title":"7 kobiet i tajemnica","original_language":"it","original_title":"7 donne e un mistero","overview":"Ginie głowa rodziny. Siedem kobiet, kierując się różnymi motywami, próbuje rozwiązać zagadkę tego morderstwa.","popularity":2.0221,"poster_path":"/iz2tpJJgSDBS646VYhmNkUmot4l.jpg","release_date":"2021-12-25","softcore":false,"video":false,"vote_average":5.528,"vote_count":398,"credit_id":"61793f54c14fee0028c0d85c","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1204698,"title":"Courts mais Gay : Tome 3","original_language":"fr","original_title":"Courts mais Gay : Tome 3","overview":"","popularity":0.4646,"poster_path":"/1ok1walAFDooKwEI1hTqwBvF5n4.jpg","release_date":"2002-05-20","softcore":false,"video":true,