em psychologicznym opisującym relacje pan - służący w kategoriach dominacji i podporządkowania z wyjątkową wprost wnikliwością.","popularity":2.9019,"poster_path":"/pRa4og93BeOoMCt6oWuPCwu5Coo.jpg","release_date":"1963-11-14","softcore":false,"video":false,"vote_average":7.6,"vote_count":378,"credit_id":"52fe4625c3a36847f80ef2d3","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/a5NNxs0HA6CEEtCNCUDvOZiQqIK.jpg","genre_ids":[18],"id":42987,"title":"Służący","original_language":"en","original_title":"The Servant","overview":"Wybitny film tercetu, który tworzą: dramaturg Harold Pinter, autor scenariusza, realizujący swoje filmy w Anglii; amerykański reżyser Joseph Losey, twórca płodny, lecz pracujący ze zmiennym powodzeniem oraz aktor Dirk Bogarde, obdarzony talentem i osobowością przyczyniającą się do sukcesów filmów z jego udziałem. \"Służący\" jest subtelnym i wyrafinowanym dramatem psychologicznym opisującym relacje pan - służący w kategoriach dominacji i podporządkowania z wyjątkową wprost wnikliwością.","popularity":2.9019,"poster_path":"/pRa4og93BeOoMCt6oWuPCwu5Coo.jpg","release_date":"1963-11-14","softcore":false,"video":false,"vote_average":7.6,"vote_count":378,"credit_id":"52fe4625c3a36847f80ef2df","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/iduLybl59XhwnvyA4Fu1WXMkUy0.jpg","genre_ids":[18,10402],"id":61638,"title":"Don Giovanni","original_language":"it","original_title":"Don Giovanni","overview":"","popularity":1.1656,"poster_path":"/t4avKNH3REZtyZiCHBwq8TvRKNu.jpg","release_date":"1979-11-06","softcore":false,"video":false,"vote_average":6.902,"vote_count":41,"credit_id":"52fe465bc3a368484e08c425","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/axLBB4Q6mgCuy1W0cTfkY4IdUSd.jpg","genre_ids":[18,35,10751],"id":43759,"title":"The Boy with Green Hair","original_language":"en","original_title":"The Boy with Green Hair","overview":"","popularity":1.6101,"poster_path":"/a2secYe7o