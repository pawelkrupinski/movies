irector"},{"adult":false,"backdrop_path":"/aFjR7ELSqn50QAqteNehpw5Z6jG.jpg","genre_ids":[80,18,53,9648],"id":36373,"title":"M","original_language":"en","original_title":"M","overview":"","popularity":1.4513,"poster_path":"/jJWNGF5FxbKyk8EyH4Ad8FA0WK.jpg","release_date":"1951-03-01","softcore":false,"video":false,"vote_average":6.5,"vote_count":67,"credit_id":"52fe45e29251416c91041bf9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ncjxkqmOhep4AMQejTxbBRE2Okn.jpg","genre_ids":[18,35],"id":42266,"title":"Romantyczna Angielka","original_language":"en","original_title":"The Romantic Englishwoman","overview":"Elizabeth Fielding (Glenda Jackson), żona bogatego angielskiego pisarza, podczas pobytu w uzdrowisku w Baden-Baden poznaje Thomasa (Helmut Berger), alfonsa podającego się za poetę. Młody mężczyzna podąża za nią do Anglii i udaje mu się zdobyć zaproszenie od Lewisa (Michael Caine), męża Elżbiety. Ten drugi podejrzewa, że ​​jest ona kochanką Thomasa.","popularity":1.7087,"poster_path":"/wMqiH1N4rCEyGy0pLQvnt5iuyul.jpg","release_date":"1975-06-11","softcore":false,"video":false,"vote_average":5.449,"vote_count":39,"credit_id":"52fe45f8c3a36847f80e4fa5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/oZANPqYAF1R5fbJcDWlAyDYywpN.jpg","genre_ids":[35,80,28,53],"id":36645,"title":"Modesty Blaise","original_language":"en","original_title":"Modesty Blaise","overview":"","popularity":1.5732,"poster_path":"/rpQRLEcQeWe2T8TbSJ0zJ0Avqij.jpg","release_date":"1966-05-01","softcore":false,"video":false,"vote_average":5.3,"vote_count":73,"credit_id":"52fe45fc9251416c91045371","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wvq0jyrg1QB9fWq3158yjoVAYQY.jpg","genre_ids":[18,53],"id":37084,"title":"The Big Night","original_language":"en","original_title":"The Big Night","overview":"","popularity":0.853,"poster_path":"/oOn0C6aJdpMUiJTgNmk7s0beH95.jpg","release_date":"1951-12-07","softcore":false,"video":