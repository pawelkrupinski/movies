n Ginsberg, Pete Seeger, Joan Baez. W tej wyjątkowej fabularnej biografii Dylan otwarcie i wyczerpująco opowiada o ciężkich czasach swojej kariery, wyróżniając podróż z rodzinnego Hibbing w Minnesocie do Greenwitch Village w Nowym Jorku. Tam przyczynił się do rewolucji muzyczno-kulturalnej, której skutki odczuwalne są po dziś dzień.","popularity":1.6703,"poster_path":"/lqOo4nyRS56Goi8InZqLFKGEJR5.jpg","release_date":"2005-07-21","softcore":false,"video":false,"vote_average":7.772,"vote_count":147,"character":"Self","credit_id":"5ca0a5fcc3a3687355837dd6","order":7},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":387796,"title":"Up Your Legs Forever","original_language":"en","original_title":"Up Your Legs Forever","overview":"","popularity":1.1704,"poster_path":"/yOeGVEyfgMYncDbe9SICFcamu0y.jpg","release_date":"1971-08-12","softcore":false,"video":false,"vote_average":8.0,"vote_count":2,"character":"","credit_id":"5cb03947c3a3683c26abb66f","order":2},{"adult":false,"backdrop_path":"/drLmpH1urcdD6Ifv9B2kideiSI0.jpg","genre_ids":[10402,99],"id":611313,"title":"World Tour 1966: The Home Movies","original_language":"en","original_title":"World Tour 1966: The Home Movies","overview":"","popularity":0.5819,"poster_path":"/5dqSnHykXfwBtYNemEJMayxUHUj.jpg","release_date":"2003-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self (archive footage)","credit_id":"5d12d6540e0a26597dcde96b","order":7},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":714849,"title":"Godard Made in USA","original_language":"en","original_title":"Godard Made in USA","overview":"","popularity":0.8646,"poster_path":"/cRIdPe6VxHrtnm36Q8GLx7duvcX.jpg","release_date":"2010-12-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"5ee32a9fd20c870020300991","order":7},{"adult":false,"backdrop_path":"/rQ1EBYpDFGInlLFpkuk26bEQ8QV.jpg","genre_ids":[16,99,10402],"id":722918,"title":"Tiny Tim: King for a Day","ori