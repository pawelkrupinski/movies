23-11-22","softcore":false,"video":false,"vote_average":6.247,"vote_count":857,"credit_id":"5af4be060e0a265e5f0020b1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/et0G74BxoBgNQEZBkUcVhsgeRFF.jpg","genre_ids":[18,10749,10402],"id":523607,"title":"Maestro","original_language":"en","original_title":"Maestro","overview":"Ta opowieść miłosna stanowi kronikę trwającej całe życie skomplikowanej relacji legendy muzyki Leonarda Bernsteina i Felicii Montealegre Cohn Bernstein.","popularity":4.2378,"poster_path":"/qC2AOV4HMzxNeoq4UJHdE1ySAAj.jpg","release_date":"2023-11-22","softcore":false,"video":false,"vote_average":6.247,"vote_count":857,"credit_id":"5af4be22c3a3684703003636","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/argJlxQHbXAzyH8fKnjLfoEyDcd.jpg","genre_ids":[35,18,10749],"id":1140498,"title":"Czy mnie słychać?","original_language":"en","original_title":"Is This Thing On?","overview":"Podczas gdy ich małżeństwo powoli się rozpada, Alex staje w obliczu wieku średniego i zbliżającego się rozwodu, szukając nowego celu w nowojorskiej scenie komediowej, podczas gdy Tess mierzy się z poświęceniami, jakich dokonała dla rodziny, co zmusza ich do zastanowienia się nad współrodzicielstwem, tożsamością i tym, czy miłość może przybrać nową formę.","popularity":3.7995,"poster_path":"/YD6QzcokTMe3EViM0hLbNCxf4y.jpg","release_date":"2025-12-19","softcore":false,"video":false,"vote_average":6.572,"vote_count":187,"credit_id":"648a486f7eb5f2010af51002","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/argJlxQHbXAzyH8fKnjLfoEyDcd.jpg","genre_ids":[35,18,10749],"id":1140498,"title":"Czy mnie słychać?","original_language":"en","original_title":"Is This Thing On?","overview":"Podczas gdy ich małżeństwo powoli się rozpada, Alex staje w obliczu wieku średniego i zbliżającego się rozwodu, szukając nowego celu w nowojorskiej scenie komediowej, podczas gdy Tess mierzy się z poświęceniami, jakich dokonała dla rodziny, co zmusza ich do zastanowienia się nad współrodzicielstwem, tożsamością i tym, czy miłość może przybrać nową formę.","popularity":3.7995,"poster_path":"/YD6QzcokTMe3EViM0hLbNCxf4y.jpg","release_date":"2025-12-19","softcore":false,"video":false,"vote_average":6.572,"vote_count":187,"credit_id":"648a47b67eb5f2014cd025a8","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rl95VDEP3nsUQmGzE0S1S7y6T0N.jpg","genre_ids":[10752,28],"id":190859,"title":"Snajper","original_language":"en","original_title":"American Sniper","overview":"Jako wysłany do Iraku członek elitarnej jednostki Navy SEALs Chris Kyle ma tylko jedną misję - chronić swoich towarzyszy broni. Swoją precyzją ratuje niezliczoną ilość żołnierzy na polu bitwy. W miarę jak opowieści o jego czynach rozpowszechniają się, zyskuje sobie miano \"legendy\". Reputacja Kyle'a rośnie także za liniami wroga. Powstańcy uznają snajpera za ważny cel i wyznaczają nagrodę za jego głowę. Największym wyzwaniem w życiu Chrisa jest jednak pozostanie mężem i ojcem dla rodziny, od której dzieli go pół świata. Pomimo niebezpieczeństw i rozłąki z bliskimi, Chris odbywa cztery zmiany w Iraku. Jednak po powrocie do żony Tayi i dzieci zdaje sobie sprawę, że nie pozostawił wojny za sobą.  [opis dystrybutora Blu-ray]","popularity":14.0393,"poster_path":"/8PC0mcflrlIaIO8aYlDUkbmFC9G.jpg","release_date":"2014-12-25","softcore":false,"video":false,"vote_average":7.411,"vote_count":13771,"credit_id":"5affefd20e0a26302f004662","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/rlay2M5QYvi6igbGcFjq8jxeusY.jpg","genre_ids":[80,53,18],"id":475557,"title":"Joker","original_language":"en","original_title":"Joker","overview":"Historia jednego z cieszących się najgorszą sławą super-przestępców uniwersum DC — Jokera po raz pierwszy na wielkim ekranie. Przedstawiony przez Phillipsa obraz kultowego czarnego charakteru, Arthura Flecka, człowieka zepchniętego na margines, to nie tylko kontrowersyjne studium postaci, ale także opowieść ku przestrodze w szerszym kontekście.","popularity":32.392,"poster_path":"/opwCl56Zi8mextLETtM3d0ryVFU.jpg","release_date":"2019-10-01","softcore":false,"video":false,"vote_average":8.1,"vote_count":28012,"credit_id":"5c6dd82bc3a368745eeea2b9","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/dDYpjrwh1wNVQk0rEpc9P81wQt4.jpg","genre_ids":[10402,18,10749],"id":332562,"title":"Narodziny gwiazdy","original_language":"en","original_title":"A Star Is Born","overview":"Jackson Maine, gwiazdor muzyki country, którego kariera chyli się ku upadkowi, odkrywa utalentowaną, nieznaną nikomu piosenkarkę Ally. Kiedy między tą dwójką wybucha płomienny romans, Jack nakłania Ally do wyjścia z cienia i pomaga jej osiągnąć sławę. Jednak gdy kariera Ally w szybkim tempie przyćmiewa dokonania Jacka, jest mu coraz trudniej poradzić sobie z własną gasnącą gwiazdą.","popularity":9.5248,"poster_path":"/2jSfSh7hWDYMWi1WrmLyixAs8MM.jpg","release_date":"2018-10-03","softcore":false,"video":false,"vote_average":7.491,"vote_count":12299,"credit_id":"5eece48059e8a90036c72e4a","department":"Crew","job":"Additional Music"},{"adult":false,"backdrop_path":"/qCsaZ2GoaCn5vmOUD9kCsyabr9o.jpg","genre_ids":[18,80],"id":97367,"title":"Drugie Oblicze","original_language":"en","original_title":"The Place Beyond the Pines","overview":"Tajemniczy motocyklista Luke (Ryan Gosling) zostawia za sobą przeszłość igrającego ze śmiercią cyrkowego showmana i wraca do Schenectady w stanie Nowy Jork, gdzie dowiaduje się, że jego była dziewczyna, Romina (Eva Mendes), urodziła mu syna. Chcąc zapewnić swojej nowej rodzinie utrzymanie, Luke porzuca dawne życie i korzystając ze swoich niezwykłych umiejętności jazdy na motocyklu, zaczyna okradać banki. Stawka wzrasta, kiedy chłopak napotyka na swojej drodze ambitnego funkcjonariusza policji, Avery Cross'a (Bradley Cooper). Ich brutalna konfrontacja zamienia się w pełną napięcia, wielopokoleniową relację. Dla obu będzie to zarówno koniec, jak i początek.","popularity":7.9765,"poster_path":"/9uhBEYV6HUrAcShRxGKFxBvl8yK.jpg","release_date":"2013-03-20","softcore":false,"video":false,"vote_average":6.977,"vote_count":5261,"credit_id":"5fe3de30b2e074003e74884c","department":"Crew","job":"Stunts"},{"adult":false,"backdrop_path":"/argJlxQHbXAzyH8fKnjLfoEyDcd.jpg","genre_ids":[35,18,10749],"id":1140498,"title":"Czy mnie słychać?","original_language":"en","original_title":"Is This Thing On?","overview":"Podczas gdy ich małżeństwo powoli się rozpada, Alex staje w obliczu wieku średniego i zbliżającego się rozwodu, szukając nowego celu w nowojorskiej scenie komediowej, podczas gdy Tess mierzy się z poświęceniami, jakich dokonała dla rodziny, co zmusza ich do zastanowienia się nad współrodzicielstwem, tożsamością i tym, czy miłość może przybrać nową formę.","popularity":3.7995,"poster_path":"/YD6QzcokTMe3EViM0hLbNCxf4y.jpg","release_date":"2025-12-19","softcore":false,"video":false,"vote_average":6.572,"vote_count":187,"credit_id":"680039e361b1c4bb3299c906","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/argJlxQHbXAzyH8fKnjLfoEyDcd.jpg","genre_ids":[35,18,10749],"id":1140498,"title":"Czy mnie słychać?","original_language":"en","original_title":"Is This Thing On?","overview":"Podczas gdy ich małżeństwo powoli się rozpada, Alex staje w obliczu wieku średniego i zbliżającego się rozwodu, szukając nowego celu w nowojorskiej scenie komediowej, podczas gdy Tess mierzy się z poświęceniami, jakich dokonała dla rodziny, co zmusza ich do zastanowienia się nad współrodzicielstwem, tożsamością i tym, czy miłość może przybrać nową formę.","popularity":3.7995,"poster_path":"/YD6QzcokTMe3EViM0hLbNCxf4y.jpg","release_date":"2025-12-19","softcore":false,"video":false,"vote_average":6.572,"vote_count":187,"credit_id":"68003aba83c6e567c7d962f7","department":"Camera","job":"\"B\" Camera Operator"},{"adult":false,"backdrop_path":"/2ADBfmsexpF9sikz7BRhGYmcp2c.jpg","genre_ids":[