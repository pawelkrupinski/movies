","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"66cd6c246dc6c5bff84ff180","order":19},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":484552,"title":"The State That I Am Fish","original_language":"en","original_title":"The State That I Am Fish","overview":"","popularity":1.1964,"poster_path":"/4ABC9MnkOHN9uVd5aNYfBqH8zEU.jpg","release_date":"2011-09-17","softcore":false,"video":false,"vote_average":3.0,"vote_count":1,"character":"Béla Tarr","credit_id":"59f969179251414c2900cf24","order":7},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":530861,"title":"Béla Tarr: Mysterious Harmonies","original_language":"en","original_title":"Béla Tarr: Mysterious Harmonies","overview":"","popularity":0.9913,"poster_path":"/naPDE06BaSixAinOAAIz7MFbIz9.jpg","release_date":"2008-12-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Himself","credit_id":"5c84bd140e0a2642fe644c3e","order":1},{"adult":false,"backdrop_path":"/6SLlgsDI70PcRxcdNXK1TLtnFQT.jpg","genre_ids":[18],"id":204113,"title":"Szörnyek évadja","original_language":"hu","original_title":"Szörnyek évadja","overview":"","popularity":0.8043,"poster_path":"/9g7BMA1EFxSCl0aIrgAQEm8VD6q.jpg","release_date":"1987-09-15","softcore":false,"video":false,"vote_average":5.545,"vote_count":11,"character":"Jesus as Mental Patient","credit_id":"5cc4c9269251415cd2f7a9ea","order":11},{"adult":false,"backdrop_path":"/59MZIe56irokLWqmZJdnu0I06xE.jpg","genre_ids":[99],"id":1364103,"title":"FUKUSHIMA with BÉLA TARR","original_language":"ja","original_title":"FUKUSHIMA with BÉLA TARR","overview":"","popularity":1.1189,"poster_path":"/xDkFPdi6PToHLr14zebT5XYbM2A.jpg","release_date":"2025-02-15","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"66fac2f31c5df25f10d01259","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1554921,"title":"Il vento del cinema","original_language":"it","original_title":"Il vento del cinema","overview":"","popularity":1.209,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"68dc0be542f426a59abb1682","order":2},{"adult":false,"backdrop_path":null,"genre_ids":[18,10770],"id":1402289,"title":"Iván Iljics halála","original_language":"hu","original_title":"Iván Iljics halála","overview":"","popularity":0.3562,"poster_path":null,"release_date":"1965-02-28","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"character":"Vászja (as Tar Béla)","credit_id":"68decfa84301af7aa3fd260d","order":9}],"crew":[{"adult":false,"backdrop_path":"/m6sHDQ7Hsc2q3Tn5hMbWkTMIXup.jpg","genre_ids":[18,80],"id":20122,"title":"Potępienie","original_language":"hu","original_title":"Kárhozat","overview":"Karrer, samotny mężczyzna w średnim wieku, wygląda przez okno na kopalniane wagoniki, znikające jeden za drugim we mgle. Industrialny, ponury pejzaż rozpościerający się wokół kopalni jest prawie nierzeczywisty, wydaje się być wytworem wyobraźni. Jedynym przyjacielem Karrera jest Willarski, drobny oszust, prowadzący bar \"Titanic\". Jego jedyną pasją jest zaś beznadziejna miłość do zamężnej piosenkarki z baru. Chcąc pozbyć się jej męża i zostać z nią sam na sam - choćby na chwilę - Karrer namawia małżonka, aby ten podjął się dla Willarskiego transportu nielegalnych towarów.","popularity":1.727,"poster_path":"/qRkhptDOpeoAdVw0OlTJNqXd9xL.jpg","release_date":"1988-10-20","softcore":false,"video":false,"vote_average":7.622,"vote_count":147,"credit_id":"52fe43d7c3a368484e001637","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/m6sHDQ7Hsc2q3Tn5hMbWkTMIXup.jpg","genre_ids":[18,80],"id":20122,"title":"Potępienie","original_language":"hu","original_title":"Kárhozat","overview":"Karrer, samotny mężczyzna w średnim wieku, wygląda przez okno na kopalniane wagoniki, znikające jeden za drugim we mgle. Industrialny, ponury pejzaż rozpościerający się wokół kopalni jest prawie nierzeczywisty, wydaje się być wytworem wyobraźni. Jedynym przyjacielem Karrera jest Willarski, drobny oszust, prowadzący bar \"Titanic\". Jego jedyną pasją jest zaś beznadziejna miłość do zamężnej piosenkarki z baru. Chcąc pozbyć się jej męża i zostać z nią sam na sam - choćby na chwilę - Karrer namawia małżonka, aby ten podjął się dla Willarskiego transportu nielegalnych towarów.","popularity":1.727,"poster_path":"/qRkhptDOpeoAdVw0OlTJNqXd9xL.jpg","release_date":"1988-10-20","softcore":false,"video":false,"vote_average":7.622,"vote_count":147,"credit_id":"52fe43d7c3a368484e001657","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/pyCUjcPHZrMY125lWpWAxEexe7C.jpg","genre_ids":[18],"id":23160,"title":"Harmonie Werckmeistera","original_language":"hu","original_title":"Werckmeister harmóniák","overview":"Akcja filmu umiejscowiona jest w małym miasteczku na Równinie Węgierskiej. Do tego spustoszonego miejsca przyjeżdża z zewnątrz ktoś, kto dotyka z niesłychanym wyczuciem frustracji tutejszych ludzi. Ten listonosz i wizjoner szerzy utopijne wizje. Pewnego dnia wieś odwiedza zagraniczny wędrowny cyrk, którego główną atrakcją jest \"Książę\". Mieszkańcy masowo idą zobaczyć tę tajemniczą postać, ale po zapłaceniu za bilety muszą zadowolić się oglądaniem wypchanego wieloryba. Kiedy staje się jasne, że \"Książę\" się nie pojawi, emocje wybuchają z destrukcyjną siłą. Kino Béli Tarra jest mistyczne, alegoryczne, metaforyczne, wywołuje skojarzenia. Posiada skumulowaną siłę, która pochodzi z zamierzonego rytmu, długich ujęć kamery, pięknej ścieżki dźwiękowej, perfekcyjnie dobranej muzyki i fascynującej narracji. Tarr wycofuje się do węgierskiej wioski, by znaleźć ślady kultury, którą zna - tam odnajduje mistyczną chęć oporu.","popularity":2.2547,"poster_path":"/sx3cKSacOGAj7GiU0V3PCy4Eh2j.jpg","release_date":"2001-02-01","softcore":false,"video":false,"vote_average":7.832,"vote_count":385,"credit_id":"52fe4461c3a368484e01f9bf","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/pyCUjcPHZrMY125lWpWAxEexe7C.jpg","genre_ids":[18],"id":23160,"title":"Harmonie Werckmeistera","original_language":"hu","original_title":"Werckmeister harmóniák","overview":"Akcja filmu umiejscowiona jest w małym miasteczku na Równinie Węgierskiej. Do tego spustoszonego miejsca przyjeżdża z zewnątrz ktoś, kto dotyka z niesłychanym wyczuciem frustracji tutejszych ludzi. Ten listonosz i wizjoner szerzy utopijne wizje. Pewnego dnia wieś odwiedza zagraniczny wędrowny cyrk, którego główną atrakcją jest \"Książę\". Mieszkańcy masowo idą zobaczyć tę tajemniczą postać, ale po zapłaceniu za bilety muszą zadowolić się oglądaniem wypchanego wieloryba. Kiedy staje się jasne, że \"Książę\" się nie pojawi, emocje wybuchają z destrukcyjną siłą. Kino Béli Tarra jest mistyczne, alegoryczne, metaforyczne, wywołuje skojarzenia. Posiada skumulowaną siłę, która pochodzi z zamierzonego rytmu, długich ujęć kamery, pięknej ścieżki dźwiękowej, perfekcyjnie dobranej muzyki i fascynującej narracji. Tarr wycofuje się do węgierskiej wioski, by znaleźć ślady kultury, którą zna - tam odnajduje mistyczną chęć oporu.","popularity":2.2547,"poster_path":"/sx3cKSacOGAj7GiU0V3PCy4Eh2j.jpg","release_date":"2001-02-01","softcore":false,"video":false,"vote_average":7.832,"vote_count":385,"credit_id":"52fe4461c3a368484e01f9d1","department":"Writing","job":"Co-Writer"},{"adult":false,"backdrop_path":"/xgJt1f0OkcSsbWNQaoKddPIOgCh.jpg","genre_ids":[9648,80,18],"id":31262,"title":"Człowiek z Londynu","original_language":"hu","original_title":"A Londoni férfi","overview":"Maloin jest człowiekiem, którego nie czeka w życiu już nic. Nie ma perspektyw, jest wypalony, otacza go szara, beznadziejna rzeczywistość. Jest niewidzialny dla otaczającego go świata, mimo tego, że ma żonę i córkę stale czuje się całkowicie samotny. Gdy pewnego razu staje się świadkiem morderstwa jego życie zmienia się diametralnie...","popularity":1.2542,"poster_path":"/1Prf1Vdm88msqt4uvZ2iH5VysEy.jpg","release_date":"2008-09-24","softcore":false,"video":false,"vote_average":7.019,"vote_count":106,"credit_id":"52fe446d9251416c910105bf","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/xgJt1f0OkcSsbWNQaoKddPIOgCh.jpg","genre_ids":[9648,80,18],"id":31262,"title":"Człowiek z Londynu","original_language":"hu","original_title":"A Londoni férfi","overview":"Maloin jest człowiekiem, którego nie czeka w życiu już nic. Nie ma perspektyw, jest wypalony, otacza go szara, beznadziejna rzeczywistość. Jest niewidzialny dla otaczającego go świata, mimo tego, że ma żonę i córkę stale czuje się całkowicie samotny. Gdy pewnego razu staje się świadkiem morderstwa jego życie zmienia się diametralnie...","popularity":1.2542,"poster_path":"/1Prf1Vdm88msqt4uvZ2iH5VysEy.jpg","release_date":"2008-09-24","softcore":false,"video":false,"vote_average":7.019,"vote_count":106,"credit_id":"52fe446d9251416c910105b3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/5a4Gmk2HNeefI4Rmwdmbyoy79oy.jpg","genre_ids":[18],"id":31414,"title":"Szatańskie tango","original_language":"hu","original_title":"Sátántangó","overview":"Nizina Węgierska. Odcięta od świata postkomunistyczna wioska. Jej mieszkańcy prowadzą życie monotonne, pozbawione złudzeń, pełne samotności, która bez końca przypomina im o życiowej pustce. By oddalić świadomość wspólnego i indywidualnego nieszczęścia, oddają się marzeniom. Jedni pragną uciec z pozbawionego perspektyw miejsca, inni układają misterne plany, które miałyby, często kosztem otoczenia, odmienić ich życie. Wszyscy oczekują Zbawiciela. Ma odkupić grzechy. Sprawić, by życie stało się łatwiejsze, lepsze... Pewnego dnia marzenie spełnia się. Zbawiciel nadchodzi...","popularity":4.6114,"poster_path":"/hySy5g6xncM3U1iRsdPgYyahXM0.jpg","release_date":"1994-02-08","softcore":false,"video":false,"vote_average":8.034,"vote_count":310,"credit_id":"52fe447c9251416c91012567","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/nV9ehd25kF2vbkO6VTA2Owd6wXn.jpg","genre_ids":[99,35,18],"id":8985,"title":"Wizje Europy","original_language":"en","original_title":"Visions of Europe","overview":"\"Wizje Europy\" to gigantyczny projekt stworzony przez Zentropę - firmę produkcyjną założoną m.in. przez duńskiego reżysera Larsa von Triera. Pomysł był prosty: 25 uznanych reżyserów z 25 różnych krajów - członków nowej Unii Europejskiej przedstawia swoją wizję Nowej Europy. Obowiązywała całkowita dowolność artystyczna, filmy mogły dotyczyć zarówno teraźniejszości, jak i przyszłości. Jedynym ograniczeniem był czas etiud - każdy twórca miał do wykorzystania maksymalnie 5 minut. Polskę reprezentuje Małgorzata Szumowska i jej \"Skrzyżowanie\" ze zdjęciami Michała Englerta.","popularity":0.9992,"poster_path":"/2v0gZZRiFVHNOraIbU21fDEzH4A.jpg","release_date":"2004-05-01","softcore":false,"video":false,"vote_average":5.227,"vote_count":22,"credit_id":"52fe44cec3a36847f80ab22d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ciL1NT4CsnZ0MSebbrxkUwVfmSh.jpg","genre_ids":[18],"id":60261,"title":"Ludzie z prefabrykantów","original_language":"hu","original_title":"Panelkapcsolat","overview":"","popularity":2.0579,"poster_path":"/vD1iD2lbLCHIJNfCZOGRtSIjg1b.jpg","release_date":"1982-12-09","softcore":false,"video":false,"vote_average":6.529,"vote_count":34,"credit_id":"52fe461dc3a368484e07fa13","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ciL1NT4CsnZ0MSebbrxkUwVfmSh.jpg","genre_ids":[18],"id":60261,"title":"Ludzie z prefabrykantów","original_language":"hu","original_title":"Panelkapcsolat","overview":"","popularity":2.0579,"poster_path":"/vD1iD2lbLCHIJNfCZOGRtSIjg1b.jpg","release_date":"1982-12-09","softcore":false,"video":false,"vote_average":6.529,"vote_count":34,"credit_id":"52fe461dc3a368484e07fa19","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/nLSWM9Eszh3aFxVzdr61LDCwHSB.jpg","genre_ids":[18],"id":47053,"title":"Utazás az Alföldön","original_language":"hu","original_title":"Utazás az Alföldön","overview":"","popularity":0.9994,"poster_path":"/3QS40ytyfsUfi3flYB3s5e0elCz.jpg","release_date":"1995-01-01","softcore":false,"video":false,"vote_average":6.1,"vote_count":10,"credit_id":"52fe471cc3a36847f8123e07","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hjIEvUldc2lbxKZi6og3G39gLpK.jpg","genre_ids":[18],"id":48318,"title":"Ognisko zapalne","original_language":"hu","original_title":"Családi tűzfészek","overview":"Akcja filmu dzieje się w komunistycznych Węgrzech. W tłocznej przestrzeni jednopokojowego pomieszczenia wspólnie mieszkają: matka, ojciec, ich dwaj dwudziestokilkuletni synowie, żona jednego z nich i jej córka. Atmosfera jest napięta i niepewna. Każdy ruch wzmaga poczucie poróżnienia, każde błahe nieporozumienie prowadzi do dramatycznej konfrontacji. Laci, mąż Ireny, daleko od domu pełni służbę wojskową, podczas gdy ona ciężko pracuje w zakładach mięsnych i zmaga się z codziennymi przeciwnościami losu oraz niechęcią swoich teściów. Upokorzona i zrezygnowana Irena daremnie walczy o przesunięcie jej nazwiska w górę na miejskiej liście oczekujących na mieszkania. Kiedy Laci wraca do domu, napięcie pomiędzy młodymi małżonkami i ich niemałe problemy finansowe, sprawiają, że atmosfera w domu staje się nie do zniesienia...","popularity":2.4759,"poster_path":"/ouY0aef7rjEtMRvtLO6ZGFRT8ST.jpg","release_date":"1979-01-25","softcore":false,"video":false,"vote_average":6.6,"vote_count":45,"credit_id":"52fe475fc3a36847f813227d","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/hjIEvUldc2lbxKZi6og3G39gLpK.jpg","genre_ids":[18],"id":48318,"title":"Ognisko zapalne","original_language":"hu","original_title":"Családi tűzfészek","overview":"Akcja filmu dzieje się w komunistycznych Węgrzech. W tłocznej przestrzeni jednopokojowego pomieszczenia wspólnie mieszkają: matka, ojciec, ich dwaj dwudziestokilkuletni synowie, żona jednego z nich i jej córka. Atmosfera jest napięta i niepewna. Każdy ruch wzmaga poczucie poróżnienia, każde błahe nieporozumienie prowadzi do dramatycznej konfrontacji. Laci, mąż Ireny, daleko od domu pełni służbę wojskową, podczas gdy ona ciężko pracuje w zakładach mięsnych i zmaga się z codziennymi przeciwnościami losu oraz niechęcią swoich teściów. Upokorzona i zrezygnowana Irena daremnie walczy o przesunięcie jej nazwiska w górę na miejskiej liście oczekujących na mieszkania. Kiedy Laci wraca do domu, napięcie pomiędzy młodymi małżonkami i ich niemałe problemy finansowe, sprawiają, że atmosfera w domu staje się nie do zniesienia...","popularity":2.4759,"poster_path":"/ouY0aef7rjEtMRvtLO6ZGFRT8ST.jpg","release_date":"1979-01-25","softcore":false,"video":false,"vote_average":6.6,"vote_count":45,"credit_id":"52fe475fc3a36847f8132277","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eMgNa5dbU34qyF0KA9DMA4TrEzn.jpg","genre_ids":[18],"id":81401,"title":"Koń turyński","original_language":"hu","original_title":"A torinói ló","overview":"3 stycznia 1889 roku niemiecki filozof Fryderyk Nietzsche, wychodząc z turyńskiego hotelu, dostrzegł okładanego przez woźnicę kolejnymi batami konia. Fryderyk starał się ochronić zwierzę, lecz bezskutecznie i w dodatku uległ wypadkowi. Wkrótce u słynnego filozofa została zdiagnozowana przewlekła choroba psychiczna, która doprowadziła do poważnego uszczerbku na jego zdrowiu. Autor aż do swojej śmierci nie napisał już żadnego dzieła. A co stało się z koniem? Najnowszy film węgierskiego twórcy Béla Tarra (\"Harmonie Werckmeistera\") opowiada historię woźnicy, jego córki i konia. Reżyser zapowiedział, że będzie to jego najradykalniejszy, ale także zarazem ostatni film...","popularity":2.4146,"poster_path":"/k5Nj2GcU8RwU53GhMZjyxQyemGF.jpg","release_date":"2011-03-31","softcore":false,"video":false,"vote_average":7.566,"vote_count":423,"credit_id":"52fe480f9251416c9107ee45","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/eMgNa5dbU34qyF0KA9DMA4TrEzn.jpg","genre_ids":[18],"id":81401,"title":"Koń turyński","original_language":"hu","original_title":"A torinói ló","overview":"3 stycznia 1889 roku niemiecki filozof Fryderyk Nietzsche, wychodząc z turyńskiego hotelu, dostrzegł okładanego przez woźnicę kolejnymi batami konia. Fryderyk starał się ochronić zwierzę, lecz bezskutecznie i w dodatku uległ wypadkowi. Wkrótce u słynnego filozofa została zdiagnozowana przewlekła choroba psychiczna, która doprowadziła do poważnego uszczerbku na jego zdrowiu. Autor aż do swojej śmierci nie napisał już żadnego dzieła. A co stało się z koniem? Najnowszy film węgierskiego twórcy Béla Tarra (\"Harmonie Werckmeistera\") opowiada historię woźnicy, jego córki i konia. Reżyser zapowiedział, że będzie to jego najradykalniejszy, ale także zarazem ostatni film...","popularity":2.4146,"poster_path":"/k5Nj2GcU8RwU53GhMZjyxQyemGF.jpg","release_date":"2011-03-31","softcore":false,"video":false,"vote_average":7.566,"vote_count":423,"credit_id":"52fe480f9251416c9107ee33","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hcTzD2HVFDV4n2zZCi1ChUj69L0.jpg","genre_ids":[18],"id":73129,"title":"Johanna","original_language":"hu","original_title":"Johanna","overview":"","popularity":0.642,"poster_path":"/jVFb2uQnbg8dsBgCl4sRPCuFP5c.jpg","release_date":"2005-11-10","softcore":false,"video":false,"vote_average":4.7,"vote_count":15,"credit_id":"52fe488dc3a368484e0fec49","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/micBq6IA8zfB7A3o7uT8ogcQr9W.jpg","genre_ids":[18],"id":74903,"title":"Jesienny almanach","original_language":"hu","original_title":"Őszi almanach","overview":"Mieszkańcy klaustrofobicznego mieszkania ujawniają między sobą mroczne tajemnice, lęki, obsesje i wrogości.","popularity":0.644,"poster_path":"/gK26PHdRKwWazRucea3GeERCJpu.jpg","release_date":"1984-08-15","softcore":false,"video":false,"vote_average":6.99,"vote_count":49,"credit_id":"52fe48e4c3a368484e110741","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/micBq6IA8zfB7A3o7uT8ogcQr9W.jpg","genre_ids":[18],"id":74903,"title":"Jesienny almanach","original_language":"hu","original_title":"Őszi almanach","overview":"Mieszkańcy klaustrofobicznego mieszkania ujawniają między sobą mroczne tajemnice, lęki, obsesje i wrogości.","popularity":0.644,"poster_path":"/gK26PHdRKwWazRucea3GeERCJpu.jpg","release_date":"1984-08-15","softcore":false,"video":false,"vote_average":6.99,"vote_count":49,"credit_id":"52fe48e4c3a368484e11073b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/96uOMED23ZLBtb0HQQ5Urr3qMRp.jpg","genre_ids":[18,14,27],"id":788929,"title":"Lamb","original_language":"is","original_title":"Dýrið","overview":"Nastrojowy, niepokojący dramat obyczajowy w zaskakujący sposób wplatający w codzienność elementy baśni i horroru. Intymny, minimalistyczny film – wyróżniony zaproszeniem do canneńskiej sekcji Un Certain Regard – imponuje obsadą, bo w głównej roli zagrała tu gwiazda, Noomi Rapace (Mężczyźni, którzy nienawidzą kobiet, Prometeusz, Tożsamość zdrajcy). Debiut islandzkiego reżysera rozgrywa się na odizolowanej farmie, gdzie młode małżeństwo opiekuje się stadem owiec. Ich surowe, wypełnione pracą życie zmienia się gwałtownie, gdy pewnej nocy w zagrodzie przychodzi na świat niezwykła istota.","popularity":3.6808,"poster_path":"/bKGEA1Egj6kD3SFRA1cGcg97r7W.jpg","release_date":"2021-08-12","softcore":false,"video":false,"vote_average":6.43,"vote_count":1066,"credit_id":"60c115e4c51acd0059c9b57c","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/8mB9aIL41cDXJImvTd5TlkJ6ayT.jpg","genre_ids":[99],"id":128044,"title":"Hotel Magnezit","original_language":"hu","original_title":"Hotel Magnezit","overview":"","popularity":0.9199,"poster_path":"/8Ov6sVP250KPGlazEqRdJIDopl8.jpg","release_date":"1978-01-01","softcore":false,"video":false,"vote_average":5.6,"vote_count":19,"credit_id":"52fe4b10c3a368484e175c8f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8mB9aIL41cDXJImvTd5TlkJ6ayT.jpg","genre_ids":[99],"id":128044,"title":"Hotel Magnezit","original_language":"hu","original_title":"Hotel Magnezit","overview":"","popularity":0.9199,"poster_path":"/8Ov6sVP250KPGlazEqRdJIDopl8.jpg","release_date":"1978-01-01","softcore":false,"video":false,"vote_average":5.6,"vote_count":19,"credit_id":"52fe4b10c3a368484e175c95","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":128028,"title":"Zycie miejskie","original_language":"en","original_title":"Zycie miejskie","overview":"","popularity":0.7439,"poster_path":"/mVqZjzHrcPjJEAzEwD9aXdDiEK4.jpg","release_date":"1990-01-26","softcore":false,"video":false,"vote_average":8.5,"vote_count":2,"credit_id":"52fe4b10c3a368484e175aa3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8gYmBywTjen4W4lKGAlFe3YaZjL.jpg","genre_ids":[18],"id":128043,"title":"Outsider","original_language":"hu","original_title":"Szabadgyalog","overview":"Małe, przemysłowe miasto w centrum Węgier. Młody 'Beethoven', utalentowany skrzypek-amator, pracuje jako pielęgniarz w szpitalu psychiatrycznym. Pacjenci, którymi się opiekuje uwielbiają go za życzliwość i zrozumienie, które im okazuje. Niestety, z powodu swojej słabości do alkoholu, młodzieniec traci pracę i zostaje wydalony ze szkoły. Wrażliwy, a jednocześnie bezkompromisowy, niezdolny do życia w społeczeństwie, przyłącza się do grupy składającej się z jemu podobnych \"sierot\". Jego przyjaciele to: malarz-alkoholik, uzależniony od narkotyków nastolatek, były nauczyciel (który był robotnikiem i piosenkarzem rockowym), jego starszy brat, który wrócił z pracy w Niemczech, młoda kobieta w ciąży (która wkrótce porzuci jeszcze nienarodzone dziecko) i kolejna kobieta, w której bohater się zakocha, ożeni i wkrótce zacznie oszukiwać...","popularity":0.6551,"poster_path":"/4yPL3DostbA2GLrUvOyqPEL9jv4.jpg","release_date":"1981-02-24","softcore":false,"video":false,"vote_average":6.12,"vote_count":25,"credit_id":"52fe4b10c3a368484e175c65","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8gYmBywTjen4W4lKGAlFe3YaZjL.jpg","genre_ids":[18],"id":128043,"title":"Outsider","original_language":"hu","original_title":"Szabadgyalog","overview":"Małe, przemysłowe miasto w centrum Węgier. Młody 'Beethoven', utalentowany skrzypek-amator, pracuje jako pielęgniarz w szpitalu psychiatrycznym. Pacjenci, którymi się opiekuje uwielbiają go za życzliwość i zrozumienie, które im okazuje. Niestety, z powodu swojej słabości do alkoholu, młodzieniec traci pracę i zostaje wydalony ze szkoły. Wrażliwy, a jednocześnie bezkompromisowy, niezdolny do życia w społeczeństwie, przyłącza się do grupy składającej się z jemu podobnych \"sierot\". Jego przyjaciele to: malarz-alkoholik, uzależniony od narkotyków nastolatek, były nauczyciel (który był robotnikiem i piosenkarzem rockowym), jego starszy brat, który wrócił z pracy w Niemczech, młoda kobieta w ciąży (która wkrótce porzuci jeszcze nienarodzone dziecko) i kolejna kobieta, w której bohater się zakocha, ożeni i wkrótce zacznie oszukiwać...","popularity":0.6551,"poster_path":"/4yPL3DostbA2GLrUvOyqPEL9jv4.jpg","release_date":"1981-02-24","softcore":false,"video":false,"vote_average":6.12,"vote_count":25,"credit_id":"52fe4b10c3a368484e175c83","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":128031,"title":"Utolsó hajó","original_language":"hu","original_title":"Utolsó hajó","overview":"","popularity":0.6587,"poster_path":"/zX6nBnHZoaIDO1kaFVtQXZl1w5m.jpg","release_date":"1990-01-25","softcore":false,"video":false,"vote_average":4.5,"vote_count":3,"credit_id":"52fe4b10c3a368484e175b25","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":128031,"title":"Utolsó hajó","original_language":"hu","