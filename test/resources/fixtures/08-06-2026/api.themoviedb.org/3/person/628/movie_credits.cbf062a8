p_path":"/lEzQFqYY0tXE2OnDzcZCRFea0Fl.jpg","genre_ids":[99],"id":1320480,"title":"Miyazaki. Duch natury","original_language":"fr","original_title":"Miyazaki, l'esprit de la nature","overview":"","popularity":1.4996,"poster_path":"/j9DdfzWUXGWynIpv3VQKmRnmDTY.jpg","release_date":"2025-05-09","softcore":false,"video":false,"vote_average":7.75,"vote_count":2,"character":"Self (archive footage)","credit_id":"681b7db15f13f1d94fc69b98","order":9},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1520993,"title":"火垂るの墓と高畑勲と7冊のノート","original_language":"ja","original_title":"火垂るの墓と高畑勲と7冊のノート","overview":"","popularity":0.4282,"poster_path":null,"release_date":"2025-08-02","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self (archive footage)","credit_id":"6887e9370213a4f735390685","order":0}],"crew":[{"adult":false,"backdrop_path":"/ulVUa2MvnJAjAeRt7h23FFJVRKH.jpg","genre_ids":[12,16,14],"id":81,"title":"Nausicaä z Doliny Wiatru","original_language":"ja","original_title":"風の谷のナウシカ","overview":"Tysiąc lat po „Siedmiu Dniach Ognia”, czyli wojnie zakończonej wielkim ekologicznym kataklizmem, Ziemia porośnięta jest toksyczną dżunglą, pełną ogromnych owadów-mutantów. Oddychanie bez maski tlenowej grozi śmiercią w ciągu kilku minut. Jedną z ostatnich zamieszkałych przez ludzi oaz jest królestwo zwane Doliną Wiatru. Wieje tam „wiatr bogów”, odpędzający trujące opary. Następczyni tronu, księżniczka Nausicaä, razem z mistrzem Yupą próbują zrozumieć mechanizmy rządzące przyrodą i znaleźć sposób, który zapewni ludziom bezpieczeństwo. Delikatna równowaga zostaje zachwiana, gdy nieopodal rozbija się samolot przewożący potężną broń. Sąsiedzi Doliny Wiatru planują użyć jej, by zniszczyć owady i dżunglę, nieświadomi, że ściągną w ten sposób zgubę na resztę ludności.","popularity":10.7435,"poster_path":"/jisAAzfCMDyd9iqhlJf5sESQ5f8.jpg","release_date":"1984-03-11","softcore":false,"video":false,"vote_average":7.9,"vote_count":4135,"credit_id":"52fe4215c3a36847f800285f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/j2ZvLJyz163MlmBFsoaDYOwxgws.jpg","genre_ids":[12,14,16,28,10751],"id":10515,"title":"Laputa – podniebny zamek","original_language":"ja","original_title":"天空の城ラピュタ","overview":"Życie Pazu, osieroconego chłopca z górniczej osady, zmienia się w jednej chwili, kiedy prosto w jego ramiona z nieba spada dziewczynka z zawieszonym na szyi jasnozielonym kamieniem. Okazuje się, że Sheeta i jej tajemniczy naszyjnik są kluczami do odnalezienia mitycznego, unoszącego się gdzieś pośród chmur, pełnego tajemnic i skarbów zamku Laputa, wedle legendy niegdyś zamieszkiwanego przez wysoko rozwiniętą cywilizację. Sheeta musi uciekać przed wojskiem oraz powietrznymi piratami, którzy za wszelką cenę chcą odnaleźć legendarny zamek…","popularity":9.5153,"poster_path":"/jS50vAIVGgTAjvi92RTJ7cZoHxU.jpg","release_date":"1986-08-02","softcore":false,"video":false,"vote_average":8.0,"vote_count":4735,"credit_id":"52fe437e9251416c7501288d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/4qwGWjjqEGPiWKXYWL15BrXldmM.jpg","genre_ids":[16,10751,35],"id":21036,"title":"パンダコパンダ","original_language":"ja","original_title":"パンダコパンダ","overview":"","popularity":2.0757,"poster_path":"/6hLytFOeqLX5dvwYNG0Zr3yGb16.jpg","release_date":"1972-12-17","softcore":false,"video":false,"vote_average":6.284,"vote_count":95,"credit_id":"52fe4409c3a368484e00bc75","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/aHaqZpOL7UyVu0nKqp3SMz0o2E1.jpg","genre_ids":[16,18,10752],"id":12477,"title":"Grobowiec świetlików","original_language":"ja","original_title":"火垂るの墓","overview":"Rozgrywająca się pod koniec II wojny światowej w Japonii historia 14-letniego chłopca i jego młodszej siostry, których rodzice zginęli podczas nalotu. Rodzeństwo jest zdane tylko na siebie, próbując przetrwać w świecie ogarniętym koszmarem wojny…","popularity":0.017,"poster_path":"/pc5mkSMjNrTXfR3zt2DHFE6PUXb.jpg","release_date":"1988-04-16","softcore":false,"video":false,"vote_average":8.4,"vote_count":6646,"credit_id":"52fe44e89251416c750452cf","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/aHaqZpOL7UyVu0nKqp3SMz0o2E1.jpg","genre_ids":[16,18,10752],"id":12477,"title":"Grobowiec świetlików","original_language":"ja","original_title":"火垂るの墓","overview":"Rozgrywająca się pod koniec II wojny światowej w Japonii historia 14-letniego chłopca i jego młodszej siostry, których rodzice zginęli podczas nalotu. Rodzeństwo jest zdane tylko na siebie, próbując przetrwać w świecie ogarniętym koszmarem wojny…","popularity":0.017,"poster_path":"/pc5mkSMjNrTXfR3zt2DHFE6PUXb.jpg","release_date":"1988-04-16","softcore":false,"video":false,"vote_average":8.4,"vote_count":6646,"credit_id":"52fe44e89251416c750452c3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/akSm1tjJrUfOg8oGq9CzodRpH83.jpg","genre_ids":[16,10402,14],"id":41017,"title":"セロ弾きのゴーシュ","original_language":"ja","original_title":"セロ弾きのゴーシュ","overview":"","popularity":1.9646,"poster_path":"/xp5QVSRBbviN2waDvWdxScYYTqb.jpg","release_date":"1982-01-23","softcore":false,"video":false,"vote_average":7.2,"vote_count":84,"credit_id":"52fe45b0c3a36847f80d5089","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jsIxoKIuH6lLt4Y3NW7Tf1BwcIO.jpg","genre_ids":[16,18,10749],"id":15080,"title":"Powrót do marzeń","original_language":"ja","original_title":"おもひでぽろぽろ","overview":"Takeo ma 27 lat. Pracuje jako urzędniczka w jednej z dużych tokijskich firm. Jest samodzielna, ma poukładane życie, jednak nie czerpie z niego żadnej satysfakcji. Próbując powstrzymać narastającą frustrację i nudę, bierze urlop i wyjeżdża na wieś w odwiedziny do swojego kuzyna. Tam, pracując w polu i wypoczywając, powraca myślami do zapomnianego świata swojego dzieciństwa. Pierwsze dziecięce porywy serca, dojrzewanie, nieporozumienia w domu, kłopoty z matematyką i chłopcami... Te liryczne wspomnienia stają się dla Takeo kluczem do odnalezienia właściwej drogi życiowej.","popularity":5.1404,"poster_path":"/fxmLQxXKQTV6lbOU6kbzlvmLBFH.jpg","release_date":"1991-07-20","softcore":false,"video":false,"vote_average":7.4,"vote_count":1274,"credit_id":"52fe46379251416c75071141","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/pRsaXi05n7G2BQNS8urHPyMxJmk.jpg","genre_ids":[12,16,14],"id":15283,"title":"Szopy w natarciu","original_language":"ja","original_title":"平成狸合戦ぽんぽこ","overview":"Tanuki, czyli Jenoty według japońskich legend potrafią zmieniać kształt swojego ciała, również na ludzki. Właśnie pod postacią ludzi często płatają przeróżne figle. Tanuki (z tej anime) mieszkają obok rządowego projektu, który może zniszczyć ich naturalne siedlisko. Poszukując pomocy od innych plemion, postanawiają wykorzystać swoje niezwykłe zdolności zmiany wyglądu i zrobić sabotaż tej konstrukcji...","popularity":4.8666,"poster_path":"/mcPlqsw958dsu48vFmnyhdORDeL.jpg","release_date":"1994-07-16","softcore":false,"video":false,"vote_average":7.174,"vote_count":1222,"credit_id":"52fe464a9251416c75073a55","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9pIRnrvWOCG62HmDWELopE1Ip3k.jpg","genre_ids":[16,35,10751],"id":16198,"title":"Rodzinka Yamadów","original_language":"ja","original_title":"ホーホケキョ となりの山田くん","overview":"Pięcioletnia Nonoko i reszta zwariowanej rodzinki Yamada przeżywają fantazyjne przygody i pokonują wyzwania dnia codziennego we współczesnej Japonii.","popularity":3.6765,"poster_path":"/kqhYhOOivgb9lcBL1WRk2mBZZq8.jpg","release_date":"1999-07-17","softcore":false,"video":false,"vote_average":7.017,"vote_count":622,"credit_id":"52fe46b59251416c75080d53","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/iVogcMvpuhCR2cuiLBzMYEhqeUM.jpg","genre_ids":[10751,16,35,18],"id":70927,"title":"じゃりン子チエ 劇場版","original_language":"ja","original_title":"じゃりン子チエ 劇場版","overview":"","popularity":1.4566,"poster_path":"/emnUOYwQTVZf8opGsCH5Ugk3dXT.jpg","release_date":"1981-04-11","softcore":false,"video":false,"vote_average":6.784,"vote_count":44,"credit_id":"52fe481ac3a368484e0e95d7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/iVogcMvpuhCR2cuiLBzMYEhqeUM.jpg","genre_ids":[10751,16,35,18],"id":70927,"title":"じゃりン子チエ 劇場版","original_language":"ja","original_title":"じゃりン子チエ 劇場版","overview":"","popularity":1.4566,"poster_path":"/emnUOYwQTVZf8opGsCH5Ugk3dXT.jpg","release_date":"1981-04-11","softcore":false,"video":false,"vote_average":6.784,"vote_count":44,"credit_id":"52fe481ac3a368484e0e95ff","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/7S1q3DZ0vqYIOJ2LTLAtYb1IrPq.jpg","genre_ids":[16],"id":69484,"title":"冬の日","original_language":"ja","original_title":"冬の日","overview":"","popularity":0.8788,"poster_path":"/omjYHYRYMv1FhDwogNcvhrFgZkb.jpg","release_date":"2003-11-27","softcore":false,"video":false,"vote_average":6.05,"vote_count":20,"credit_id":"52fe47c9c3a368484e0d96bd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9yDEQpI0wMjVZwnFeOFRQD03RmF.jpg","genre_ids":[12,18,16,14],"id":52686,"title":"Taiyo no oji: Horusu no daiboken","original_language":"ja","original_title":"太陽の王子ホルスの大冒険","overview":"Hols mieszka wraz ze starym, schorowanym ojcem z dala od ludzkich osad, pośród gór, lasów i jezior. Pewnego dnia, uciekając przed srebrnymi wilkami, spotyka kamiennego olbrzyma, w którego ciele tkwi od lat zardzewiały miecz. Kiedy chłopcu udaje się go wyciągnąć, okazuje się być on potężną bronią, Mieczem Słońca. By odzyskać moc, miecz musi zostać przekuty. Po śmierci ojca Hols, chcąc spełnić jego ostatnią wolę, udaje się na poszukiwanie innych ludzi i dociera do małej rybackiej osady. Wkrótce po jego przybyciu pojawia się także obdarzona pięknym głosem dziewczyna, Hilda. Nadejście Holsa burzy jednak spokój wioski, gdyż chłopiec jest celem ataków potężnego czarnoksiężnika, Grunwalda. By chronić mieszkańców osady, Hols musi zmierzyć się nie tylko z Grunwaldem, ale też z potężnym i groźnym przeciwnikiem, którego obecności nikt do tej pory nie zauważył...","popularity":2.2301,"poster_path":"/7OgTVJR8daaoLUE3U4rrwaxV8IL.jpg","release_date":"1968-07-24","softcore":false,"video":false,"vote_average":6.372,"vote_count":109,"credit_id":"52fe483dc3a36847f815dbcd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/o8CNEAWtee8q2Z19hYuM97VHt8U.jpg","genre_ids":[16,35,10751],"id":123867,"title":"パンダコパンダ 雨ふりサーカスの巻","original_language":"ja","original_title":"パンダコパンダ 雨ふりサーカスの巻","overview":"","popularity":1.6081,"poster_path":"/wh3NlPr1iIOueJXazyNkhT4V01I.jpg","release_date":"1973-03-17","softcore":false,"video":false,"vote_average":6.4,"vote_count":47,"credit_id":"52fe4a9fc3a368484e15e14b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/a5AzVcys2PKKXRUK40xglWk0DSy.jpg","genre_ids":[99,16],"id":141897,"title":"柳川の運河の物語","original_language":"ja","original_title":"柳川の運河の物語","overview":"","popularity":1.4807,"poster_path":"/yv5hCxssANCM3h7dOqQo9qkTUcz.jpg","release_date":"1987-08-15","softcore":false,"video":false,"vote_average":8.2,"vote_count":9,"credit_id":"52fe4ac59251416c750ed7d9","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/a5AzVcys2PKKXRUK40xglWk0DSy.jpg","genre_ids":[99,16],"id":141897,"title":"柳川の運河の物語","original_language":"ja","original_title":"柳川の運河の物語","overview":"","popularity":1.4807,"poster_path":"/yv5hCxssANCM3h7dOqQo9qkTUcz.jpg","release_date":"1987-08-15","softcore":false,"video":false,"vote_average":8.2,"vote_count":9,"credit_id":"52fe4ac59251416c750ed7d3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lMaWlYThCSnsmW3usxWTpSuyZp1.jpg","genre_ids":[16,18,14],"id":149871,"title":"Księżniczka Kaguya","original_language":"ja","original_title":"かぐや姫の物語","overview":"Starzejący się zbieracz bambusu w jednej z łodyg rośliny znajduje malutką dziewczynkę. Bierze ją za księżniczkę zesłaną mu przez niebiosa jako błogosławieństwo. Wraz z żoną wychowują ją jak własną córkę. Z czasem dziewczynka wyrasta na piękną kobietę. Otoczona mnóstwem adoratorów konsekwentnie odrzuca wszystkie propozycje zaręczyn. A najbardziej zdeterminowanym kandydatom wyznacza niemożliwe do spełnienia zadania. Pewnego dnia w księżniczce Kaguyi zakochuje się sam cesarz…","popularity":7.7945,"poster_path":"/rJk2eNh7X9dl2Nxi0VBEBjcZVrx.jpg","release_date":"2013-11-23","softcore":false,"video":false,"vote_average":8.092,"vote_count":2019,"credit_id":"52fe4bf69251416c7511355b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/lMaWlYThCSnsmW3usxWTpSuyZp1.jpg","genre_ids":[16,18,14],"id":149871,"title":"Księżniczka Kaguya","original_language":"ja","original_title":"かぐや姫の物語","overview":"Starzejący się zbieracz bambusu w jednej z łodyg rośliny znajduje malutką dziewczynkę. Bierze ją za księżniczkę zesłaną mu przez niebiosa jako błogosławieństwo. Wraz z żoną wychowują ją jak własną córkę. Z czasem dziewczynka wyrasta na piękną kobietę. Otoczona mnóstwem adoratorów konsekwentnie odrzuca wszystkie propozycje zaręczyn. A najbardziej zdeterminowanym kandydatom wyznacza niemożliwe do spełnienia zadania. Pewnego dnia w księżniczce Kaguyi zakochuje się sam cesarz…","popularity":7.7945,"poster_path":"/rJk2eNh7X9dl2Nxi0VBEBjcZVrx.jpg","release_date":"2013-11-23","softcore":false,"video":false,"vote_average":8.092,"vote_count":2019,"credit_id":"52fe4bf69251416c75113549","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uAfhsySkr1UzQg1zdg3dZQRz9Fd.jpg","genre_ids":[16,10751,35],"id":10193,"title":"Toy Story 3","original_language":"en","original_title":"Toy Story 3","overview":"Andy stał się już dużym chłopcem i wybiera się na studia. Pragnie zabrać wraz ze sobą swą ulubioną zabawkę z dzieciństwa Kowboja Chudego, a resztę jego podopiecznych mama chłopca postanawia oddać do miejskiego przedszkola. W obawie o los swoich przyjaciół Chudy postanawia ich nie opuszczać. W przedszkolu zabawki nawiązują nowe znajomości, oraz napotykają na niebezpieczeństwo ze strony niesfornych przedszkolaków. Od tej pory Chudy wraz z przyjaciółmi robią wszystko by się stamtąd wydostać i wrócić do domu.","popularity":34.6526,"poster_path":"/WW8MbtmHDZg1g9uW3OsS4jUoJw.jpg","release_date":"2010-06-16","softcore":false,"video":false,"vote_average":7.813,"vote_count":16005,"credit_id":"561704aac3a3680fa00009df","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/9pIRnrvWOCG62HmDWELopE1Ip3k.jpg","genre_ids":[16,35,10751],"id":16198,"title":"Rodzinka Yamadów","original_language":"ja","original_title":"ホーホケキョ となりの山田くん","overview":"Pięcioletnia Nonoko i reszta zwariowanej rodzinki Yamada przeżywają fantazyjne przygody i pokonują wyzwania dnia codziennego we współczesnej Japonii.","popularity":3.6765,"poster_path":"/kqhYhOOivgb9lcBL1WRk2mBZZq8.jpg","release_date":"1999-07-17","softcore":false,"video":false,"vote_average":7.017,"vote_count":622,"credit_id":"657db092fd140b074c8251f2","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/pRsaXi05n7G2BQNS8urHPyMxJmk.jpg","genre_ids":[12,16,14],"id":15283,"title":"Szopy w natarciu","original_language":"ja","original_title":"平成狸合戦ぽんぽこ","overview":"Tanuki, czyli Jenoty według japońskich legend potrafią zmieniać kształt swojego ciała, również na ludzki. Właśnie pod postacią ludzi często płatają przeróżne figle. Tanuki (z tej anime) mieszkają obok rządowego projektu, który może zniszczyć ich naturalne siedlisko. Poszukując pomocy od innych plemion, postanawiają wykorzystać swoje niezwykłe zdolności zmiany wyglądu i zrobić sabotaż tej konstrukcji...","popularity":4.8666,"poster_path":"/mcPlqsw958dsu48vFmnyhdORDeL.jpg","release_date":"1994-07-16","softcore":false,"video":false,"vote_average":7.174,"vote_count":1222,"credit_id":"657db0151da7a607ac2a0fac","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/jsIxoKIuH6lLt4Y