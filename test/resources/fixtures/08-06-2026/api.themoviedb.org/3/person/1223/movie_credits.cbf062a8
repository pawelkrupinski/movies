mtgDbk2R1jxsOIuZeJUCPttli.jpg","release_date":"2015-11-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"66a6bfdc0a3ac27a4577776c","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":448843,"title":"Stephen King's World of Horror","original_language":"en","original_title":"Stephen King's World of Horror","overview":"","popularity":1.6095,"poster_path":"/gPx8yWBuAF8CGXY7mYbcUk0yezn.jpg","release_date":"1989-01-01","softcore":false,"video":false,"vote_average":8.0,"vote_count":3,"character":"Self","credit_id":"58d630909251411fc503bfba","order":10},{"adult":false,"backdrop_path":"/AmYRSICb6OjblGlyAEFiJ4cMfKF.jpg","genre_ids":[28,878,53],"id":9556,"title":"Człowiek Ciemności","original_language":"en","original_title":"Darkman","overview":"Dr Peyton Westlake (Liam Neeson) jest naukowcem pracującym nad syntetyczną skórą. Po wielu latach badań zaczyna osiągać pierwsze sukcesy, jednak wtedy jego laboratorium zostaje zniszczone przez brutalny gang. Pozostawionemu na niechybną śmierć Peytonowi udaje się uciec, ale za swe ocalenie zmuszony jest zapłacić ogromną cenę. W ciężkim stanie trafia do szpitala. Lekarze ratują mu życie, ale nie są w stanie przywrócić dawnego wyglądu. Westlake ucieka ze szpitala i postanawia odbudować laboratorium.","popularity":5.2769,"poster_path":"/9fxGRzlINIvfPFhizMgbQaDDrK.jpg","release_date":"1990-08-24","softcore":false,"video":false,"vote_average":6.422,"vote_count":1547,"character":"Oldsmobile Driver (uncredited)","credit_id":"59de5761c3a368620d07fdb5","order":41},{"adult":false,"backdrop_path":"/9RJGN6CaCFOzs9H1yie2aPxLUoX.jpg","genre_ids":[35,12],"id":9080,"title":"Szpiedzy tacy jak my","original_language":"en","original_title":"Spies Like Us","overview":"Emmett to obibok i kobieciarz. Austin jest urzędnikiem marzącym o służbie w wywiadzie. Obaj startują w konkursie do pracy w wywiadzie. Okazują się największymi nieudacznikami, ale to właśnie ich wybierają na nowych agentów. Przechodzą szkolenie i zostają wysłani na akcję. Zanim dotrą do celu przeprowadzą operację wyrostka, uciekną agentom rosyjskim i spowodują wiele zabawnych sytuacji.","popularity":4.05,"poster_path":"/s0Sx8nd9Irq0aCPbsN78s0DYVlG.jpg","release_date":"1985-12-06","softcore":false,"video":false,"vote_average":6.189,"vote_count":721,"character":"Drive-In Security","credit_id":"59d3ec06c3a368451b00433e","order":12},{"adult":false,"backdrop_path":null,"genre_ids":[99,10770],"id":203929,"title":"The Coen Brothers","original_language":"en","original_title":"The Coen Brothers","overview":"","popularity":1.5799,"poster_path":"/9HlxMw5fNZOU1MF7ltYhqHgqgQs.jpg","release_date":"2000-11-01","softcore":false,"video":false,"vote_average":7.75,"vote_count":4,"character":"Self","credit_id":"5a9cef620e0a2605e4045a72","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":136439,"title":"Une Journée particulière","original_language":"en","original_title":"Une Journée particulière","overview":"","popularity":2.4647,"poster_path":"/4MMhKxab3sDx4VrqGnhIMX0kGV3.jpg","release_date":"2012-05-16","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"character":"Self","credit_id":"5ad6aca90e0a2674be0038f7","order":6},{"adult":false,"backdrop_path":"/hhVpxAZBSgasppErcewO61RdYfc.jpg","genre_ids":[99],"id":572410,"title":"No Country for Old Men: Josh Brolin's Unauthorized Behind the Scenes","original_language":"en","original_title":"No Country for Old Men: Josh Brolin's Unauthorized Behind the Scenes","overview":"","popularity":0.8222,"poster_path":"/ayZgd7r1bLU2Bsujy88DMRvij4L.jpg","release_date":"2008-03-11","softcore":false,"video":false,"vote_average":6.9,"vote_count":8,"character":"Self","credit_id":"5c2d92d2c3a3680835a01389","order":3},{"adult":false,"backdrop_path":"/xLryKAwhsEKX2YQcYZyhTWeBNGR.jpg","genre_ids":[35,80,27],"id":21627,"title":"Fala zbrodni","original_language":"en","original_title":"Crimewave","overview":"Dwaj przestępcy zabijają właściciela firmy pr