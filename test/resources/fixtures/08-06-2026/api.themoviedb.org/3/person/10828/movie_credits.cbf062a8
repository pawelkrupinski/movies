.jpg","release_date":"1986-03-01","softcore":false,"video":false,"vote_average":5.464,"vote_count":14,"credit_id":"5960f706c3a368293b0c4f66","department":"Editing","job":"Assistant Editor"},{"adult":false,"backdrop_path":"/gJaNmOM7YPQHeKlOgnz2W2zgRUx.jpg","genre_ids":[35,27],"id":160004,"title":"Geometría","original_language":"es","original_title":"Geometría","overview":"","popularity":0.6418,"poster_path":"/2Ch38McqOKI22C3r0q9U3ZJuy1X.jpg","release_date":"1987-02-01","softcore":false,"video":false,"vote_average":6.153,"vote_count":59,"credit_id":"5960f8f29251415a4008e029","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[10749,18],"id":322943,"title":"Un embrujo","original_language":"es","original_title":"Un embrujo","overview":"","popularity":0.7754,"poster_path":"/cb4VAtZm5cVFZf7bjhkVQ8iyyuB.jpg","release_date":"1999-02-19","softcore":false,"video":false,"vote_average":6.864,"vote_count":22,"credit_id":"5960fbb59251410c560b6b24","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/93S2ivPgeVotuc3K6jYcg8R9Svl.jpg","genre_ids":[35,80,18],"id":44149,"title":"Asesino en serio","original_language":"es","original_title":"Asesino en serio","overview":"","popularity":0.9102,"poster_path":"/tDFtXrxnFCxo2A0QOtaCvb2KJmZ.jpg","release_date":"2002-10-11","softcore":false,"video":false,"vote_average":5.629,"vote_count":31,"credit_id":"5960fcf0c3a36825e80b0b81","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/d8twGjhgFmsapoUpY4K6WoieobH.jpg","genre_ids":[18,53],"id":15749,"title":"Zaraz wracam","original_language":"en","original_title":"While She Was Out","overview":"Della Mayers (Kim Basinger) mieszka z mężem i dwójką bliźniaków w eleganckim domu na przedmieściach. Kobieta całą uwagę poświęca dzieciom, zaniedbując dom i siebie, czym doprowadza do furii skłonnego do agresji męża Kennetha. Późnym wieczorem w wigilię Bożego Narodzenia Della wybiera się do centrum handlowego po ostatnie zakupy. Zirytowana bezmyślnym sposobem parkowania jednego z samochodów zostawia pod wycieraczką obraźliwą uwagę. Po wyjściu ze sklepu staje twarzą w twarz z kilkoma młodymi mężczyznami, którzy grożą jej bronią. Próbujący interweniować ochroniarz dostaje kulę prosto w głowę. Przerażona Della próbuje uciec, ale w ciemnościach rozbija samochód na skraju lasu. Dalej ucieka na piechotę, mając do obrony przeciwko czterem bandytom tylko własną determinację oraz skrzynkę z narzędziami...","popularity":3.0709,"poster_path":"/bv3De122YYhqAXfvJUDaMNVrjwP.jpg","release_date":"2008-10-27","softcore":false,"video":false,"vote_average":5.51,"vote_count":200,"credit_id":"5960fe01c3a3680dec0954ae","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/vJR2D2h88MXlenyviN2JDmfDT7A.jpg","genre_ids":[18,53,10749],"id":61539,"title":"Rabia","original_language":"es","original_title":"Rabia","overview":"","popularity":0.8353,"poster_path":"/jYBnT05o0kWRY8yH6Rrw08eHuLq.jpg","release_date":"2009-08-12","softcore":false,"video":false,"vote_average":5.6,"vote_count":22,"credit_id":"5960fff4925141790402567c","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/c5MCkebYhFuhmi32x760HfcvLIO.jpg","genre_ids":[28,12,16,35,10751],"id":417859,"title":"Kot w butach","original_language":"en","original_title":"Puss in Boots","overview":"Przygody uwielbianego przez wszystkich kota… przyjaciela Shreka… Kot w Butach, który jako mistrz fechtunku organizuje napad, którego celem jest kradzież mitycznej gęsi znoszącej złote jaja. Główną rywalką Kota będzie Kitty Kociłapka. Zanim jednak Kot w Butach poznał zielonego ogra, był już znanym w okolicy zawadiaką. Znakomita rozrywka dla widzów w każdym wieku!","popularity":14.3135,"poster_path":"/bAhcjn8JukfJ56OYdvds2d5EgEU.jpg","release_date":"2011-10-27","softcore":false,"video":false,"vote_average":6.612,"vote_count":4675,"credit_id":"59610222c3a368253c0aa4c3","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/fQwgPxUH10FpM0o0wSQ6k5GeuyN.jpg","genre_ids":[18],"id":268854,"title":"La delgada línea amarilla","original_language":"es","original_title":"La delgada línea amarilla","overview":"","popularity":2.7383,"poster_path":"/uRkBY6BJzw0n36ddTpX8uXFD8RS.jpg","release_date":"2015-03-06","softcore":false,"video":false,"vote_average":8.437,"vote_count":260,"credit_id":"596102c39251410bfa0c308d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/s3FiHTdpQVpqIqdBxLLiy40wGut.jpg","genre_ids":[16,28,12,35,10751],"id":140300,"title":"Kung Fu Panda 3","original_language":"en","original_title":"Kung Fu Panda 3","overview":"Po wyrusza z ojcem do ukrytej przed światem wioski pand. Gdy jednak Chinom zaczyna zagrażać zły duch, Po musi naprędce stworzyć armię zdolną stawić mu czoła.","popularity":16.305,"poster_path":"/oajNi4Su39WAByHI6EONu8G8HYn.jpg","release_date":"2016-01-23","softcore":false,"video":false,"vote_average":6.933,"vote_count":6688,"credit_id":"596107c49251415a4008f021","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[27,53],"id":465203,"title":"The Bloody Benders","original_language":"en","original_title":"The Bloody Benders","overview":"","popularity":0.7964,"poster_path":"/mH0Z9M9W9UqqS5uvJ1XSDhRownQ.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"59610861c3a36828fc0ad47d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/abirSHwWgKajV3hXhaIR5lcCIXe.jpg","genre_ids":[18,14,10749],"id":399055,"title":"Kształt wody","original_language":"en","original_title":"The Shape of Water","overview":"Elisa nie miała łatwego życia. Jest sierotą, która nigdy nie poznała swoich rodziców. Jest niema, co oznacza, że automatycznie skazywana na bycie gorszą. W świecie, w którym żeby coś osiągnąć, trzeba przepychać się łokciami, jest skazana na życie z miesiąca na miesiąc i usługiwanie bardziej przebojowym ludziom. Elisa ma jednak coś, czego inni nie mają: ogromną empatię i jeszcze większą wyobraźnię. Cechy te przydadzą jej się w laboratorium rządowym, w którym pracuje jako sprzątaczka, a w którym spotyka pewnego dnia uwięzionego przez wojsko stwora rodem z hollywoodzkich horrorów. Gdy jednak zaczyna mu się przyglądać i go poznawać, uświadamia sobie, że to nie żadna bestia, lecz wrażliwa i krucha istota, która została już w dniu urodzenia skazana na życie w cierpieniu w świecie ludzi.","popularity":10.4908,"poster_path":"/sEEiHN6t4FPY73U4czYrVTIxIlU.jpg","release_date":"2017-12-01","softcore":false,"video":false,"vote_average":7.236,"vote_count":12965,"credit_id":"59baa4469251413b04014670","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/abirSHwWgKajV3hXhaIR5lcCIXe.jpg","genre_ids":[18,14,10749],"id":399055,"title":"Kształt wody","original_language":"en","original_title":"The Shape of Water","overview":"Elisa nie miała łatwego życia. Jest sierotą, która nigdy nie poznała swoich rodziców. Jest niema, co oznacza, że automatycznie skazywana na bycie gorszą. W świecie, w którym żeby coś osiągnąć, trzeba przepychać się łokciami, jest skazana na życie z miesiąca na miesiąc i usługiwanie bardziej przebojowym ludziom. Elisa ma jednak coś, czego inni nie mają: ogromną empatię i jeszcze większą wyobraźnię. Cechy te przydadzą jej się w laboratorium rządowym, w którym pracuje jako sprzątaczka, a w którym spotyka pewnego dnia uwięzionego przez wojsko stwora rodem z hollywoodzkich horrorów. Gdy jednak zaczyna mu się przyglądać i go poznawać, uświadamia sobie, że to nie żadna bestia, lecz wrażliwa i krucha istota, która została już w dniu urodzenia skazana na życie w cierpieniu w świecie ludzi.","popularity":10.4908,"poster_path":"/sEEiHN6t4FPY73U4czYrVTIxIlU.jpg","release_date":"2017-12-01","softcore":false,"video":false,"vote_average":7.236,"vote_count":12965,"credit_id":"59baa46bc3a3680cf20148f2","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/abirSHwWgKajV3hXhaIR5lcCIXe.jpg","genre_ids":[18,14,10749],"id":399055,"title":"Kształt wody","original_language":"en","original_title":"The Shape of Water","overview":"Elisa nie miała łatwego życia. Jest sierotą, która nigdy nie poznała swoich rodziców. Jest niema, co oznacza, że automatycznie skazywana na bycie gorszą. W świecie, w którym żeby coś osiągnąć, trzeba przepychać się łokciami, jest skazana na życie z miesiąca na miesiąc i usługiwanie bardziej przebojowym ludziom. Elisa ma jednak coś, czego inni nie mają: ogromną empatię i jeszcze większą wyobraźnię. Cechy te przydadzą jej się w laboratorium rządowym, w którym pracuje jako sprzątaczka, a w którym spotyka pewnego dnia uwięzionego przez wojsko stwora rodem z hollywoodzkich horrorów. Gdy jednak zaczyna mu się przyglądać i go poznawać, uświadamia sobie, że to nie żadna bestia, lecz wrażliwa i krucha istota, która została już w dniu urodzenia skazana na życie w cierpieniu w świecie ludzi.","popularity":10.4908,"poster_path":"/sEEiHN6t4FPY73U4czYrVTIxIlU.jpg","release_date":"2017-12-01","softcore":false,"video":false,"vote_average":7.236,"vote_count":12965,"credit_id":"59baa4ab9251413b1d0144c6","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/reHkSQwiYKK4SabnGDY1FWKie82.jpg","genre_ids":[16,10751,35,28],"id":49444,"title":"Kung Fu Panda 2","original_language":"en","original_title":"Kung Fu Panda 2","overview":"Kontynuacja przygód Po i jego przyjaciół. Tym razem grupa sympatycznych adeptów kung-fu będzie musiała stawić czoła nikczemnemu lordowi Shenowi, który za cel postawił sobie podbicie Chin. Po i jego towarzysze wkrótce odkrywają, że ich wróg dysponuje potężną bronią.","popularity":16.6097,"poster_path":"/mtqqD00vB4PGRt20gWtGqFhrkd0.jpg","release_date":"2011-05-25","softcore":false,"video":false,"vote_average":7.077,"vote_count":8023,"credit_id":"6646184dad1dd2e346c689fc","department":"Crew","job":"Creative Consultant"},{"adult":false,"backdrop_path":"/sDPk862OKB0Ckkvebo4M2k5AKly.jpg","genre_ids":[28,12,16,10751,14],"id":81188,"title":"Strażnicy marzeń","original_language":"en","original_title":"Rise of the Guardians","overview":"Jack Mróz - urwisowaty chłopak władający chłodem, zostaje zwerbowany przez swojego stwórcę do drużyny Strażników, która troszczy się o dobro dzieci na całym świecie. Kiedy siły zła zagrożą pięknu snów najmłodszych i ich bezpieczeństwu wraz z Zębową Wróżką, Piaskowym Dziadkiem, Zającem Wielkanocnym i drużyną Świętego Mikołaja ruszy do walki o wiarę w symbole świąt i uszczęśliwiających wierzeń. Będzie to dla chłopca lekcja dojrzałości odpowiadająca na najważniejsze pytania.","popularity":12.0601,"poster_path":"/bPUEOy12lw4yVkp8zpvxJsAinue.jpg","release_date":"2012-11-21","softcore":false,"video":false,"vote_average":7.38,"vote_count":7227,"credit_id":"5aabd1260e0a261e3f01273f","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/fqoc3DOSg6kwIkTe1hAjW0xW7JV.jpg","genre_ids":[28,18,36],"id":41785,"title":"Cabeza de Vaca","original_language":"es","original_title":"Cabeza de Vaca","overview":"","popularity":1.6621,"poster_path":"/hv81kBDRlkYTelczz3RtJZOhsTh.jpg","release_date":"1991-10-11","softcore":false,"video":false,"vote_average":6.811,"vote_count":37,"credit_id":"5abe6ec10e0a264a5a012890","department":"Costume & Make-Up","job":"Makeup Effects Designer"},{"adult":false,"backdrop_path":"/10sdvlxjeTZNBxPg0PLl4CKU7v0.jpg","genre_ids":[18,27,9648],"id":516329,"title":"Poroże","original_language":"en","original_title":"Antlers","overview":"Nauczycielka z małego amerykańskiego miasteczka (Keri Russell) i jej brat (Jesse Plemons), lokalny szeryf, odkrywają, że jeden z uczniów (Jeremy T. Thomas) skrywa niebezpieczny sekret, który może mieć przerażające konsekwencje.","popularity":4.3342,"poster_path":"/qKL3QSIfQPRxRGkozcg0cCCSf5J.jpg","release_date":"2021-10-28","softcore":false,"video":false,"vote_average":6.212,"vote_count":1251,"credit_id":"5ac656360e0a264974011aa3","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/irpJXGiVr539uuspcQcNdkhS2lq.jpg","genre_ids":[16,28,35,10751,878],"id":38055,"title":"Megamocny","original_language":"en","original_title":"Megamind","overview":"Twórcy \"Shreka\", \"Madagaskaru\" i \"Kung Fu Panda\" przedstawiają nowego bohatera – diabolicznego Ooberminda, który od ponad 20 lat usiłuje podbić Ziemię, za każdym razem jednak, jego plany krzyżuje zamaskowany super-bohater Metro Man. Wszystko zmienia się w dniu, kiedy Oobermind podczas jednej ze swoich akcji przypadkowo zabija Metro Mana. Nie mając już do pokonania żadnego wroga, zniechęcony geniusz zła postanawia stworzyć sobie nowego super-przeciwnika - większego, lepszego i silniejszego niż ten jakim kiedykolwiek był Metro Man. Kiedy jednak rywal Ooberminda zaczyna prowadzić własną wojnę, której celem jest zniszczenie świata, ten musi zdecydować: Czy potrafi pokonać własny (teraz) diaboliczny twór? Czy najinteligentniejszy człowiek świata jest w stanie podjąć błyskotliwą decyzję? A może Geniusz Zła przejdzie na drugą stronę i stanie się Bohaterem własnej historii?","popularity":15.6372,"poster_path":"/2bkvQSfwSVsQem9IewyHqNXxvrz.jpg","release_date":"2010-10-28","softcore":false,"video":false,"vote_average":7.034,"vote_count":7578,"credit_id":"5ac12afcc3a3682d6600caa2","department":"Crew","job":"Creative Consultant"},{"adult":false,"backdrop_path":"/3UbaCMmqOd7mca4Y5DOzY2ZVTyX.jpg","genre_ids":[28,12,14],"id":122917,"title":"Hobbit: Bitwa Pięciu Armii","original_language":"en","original_title":"The Hobbit: The Battle of the Five Armies","overview":"Filmowa adaptacja książki J.R.R. Tolkiena, będącej wstępem do słynnego \"Władcy Pierścieni\", to opowieść pełna niesamowitych wydarzeń i magicznych postaci. Przedstawia odwieczną walkę dobra ze złem. Po wielkim sukcesie pierwszych dwóch części trylogii – \"Hobbit: Niezwykła podróż\" oraz \"Hobbit: Pustkowie Smauga\", nadszedł czas na film zamykający niezwykłe dzieło Petera Jacksona: \"Hobbit: Bitwa Pięciu Armii\". Drużyna dowodzona przez Thorina Dębową Tarczę dotarła do Samotnej Góry, której skarbu strzeże potężny Smaug. Czy Bilbo i jego towarzysze pokonają smoka i odzyskają legendarny Erebor?","popularity":34.9529,"poster_path":"/m3Lfi8084o3oGrbJ3oGJvToM2no.jpg","release_date":"2014-12-10","softcore":false,"video":false,"vote_average":7.339,"vote_count":15560,"credit_id":"5af411c0c3a368214400a42c","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/d1i6oB5xdo2a7sOmjprCcElqlrD.jpg","genre_ids":[16,14,10751,28,12],"id":730840,"title":"Łowcy trolli: Przebudzenie tytanów","original_language":"en","original_title":"Trollhunters: Rise of the Titans","overview":"Arcadia może wyglądać jak zwykłe miasto, ale leży w centrum magicznych i mistycznych linii, które czynią ją węzłem wielu bitew pomiędzy istotami z innego świata, w tym trollami, kosmitami i czarodziejami. Teraz różni bohaterowie połączą siły w epickiej przygodzie, w której będą musieli walczyć z Zakonem Arcane o kontrolę nad magią, która łączy ich wszystkich razem.","popularity":4.8086,"poster_path":"/A1vN5OfsvMkemeToSIabmmvfnxh.jpg","release_date":"2021-07-21","softcore":false,"video":false,"vote_average":7.547,"vote_count":365,"credit_id":"64aa0d3c3e2ec800af7d3ee7","department":"Writing","job":"Book"},{"adult":false,"backdrop_path":"/d1i6oB5xdo2a7sOmjprCcElqlrD.jpg","genre_ids":[16,14,10751,28,12],"id":730840,"title":"Łowcy trolli: Przebudzenie tytanów","original_language":"en","original_title":"Trollhunters: Rise of the Titans","overview":"Arcadia może wyglądać jak zwykłe miasto, ale leży w centrum magicznych i mistycznych linii, które czynią ją węzłem wielu bitew pomiędzy istotami z innego świata, w tym trollami, kosmitami i czarodziejami. Teraz różni bohaterowie połączą siły w epickiej przygodzie, w której będą musieli walczyć z Zakonem Arcane o kontrolę nad magią, która łączy ich wszystkich razem.","popularity":4.8086,"poster_path":"/A1vN5OfsvMkemeToSIabmmvfnxh.jpg","release_date":"2021-07-21","softcore":false,"video":false,"vote_average":7.547,"vote_count":365,"credit_id":"64aa0d533e2ec800cbcd8c99","department":"Crew","job":"Creator"},{"adult":false,"backdrop_path":"/a2n6bKD7qhCPCAEALgsAhWOAQcc.jpg","genre_ids":[878,53,18],"id":49047,"title":"Grawitacja","original_language":"en","original_title":"Gravity","overview":"Dr Ryan Stone jest wybitną specjalistką od inżynierii medycznej. Zatrudniona przez NASA trafia do zespołu pracującego przy naprawie teleskopu Hubble'a. Dowódcą misji jest Matt Kowalsky, który po powrocie na Ziemię ma zakończyć karierę astronauty. Kiedy w prom kosmiczny, którym astronauci przylecieli na orbitę, uderzają szczątki starego rosyjskiego satelity, ginie większość członków misji. Przy życiu pozostają tylko dr Stone i Kowalsky. Od tej chwili są zdani tylko na siebie. Muszą dotrzeć do innego promu, ale zapas powietrza w uszkodzonych zbiornikach nieubłaganie się wyczerpuje...","popularity":11.968,"poster_path":"/uEKzNJYy3HgYbEoXYjmweD7pH9F.jpg","release_date":"2013-10-03","softcore":false,"video":false,"vote_average":7.171,"vote_count":16501,"credit_id":"5bbe40f3925141237b000978","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/e782pDRAlu4BG0ahd777n8zfPzZ.jpg","genre_ids":[16,14,12,18],"id":555604,"title":"Guillermo del Toro: Pinokio","original_language":"en","original_title":"Guillermo del Toro's Pinocchio","overview":"Nagrodzony Oscarem filmowiec Guillermo del Toro przedstawia własną wersję klasycznej powieści Carlo Collodiego o drewnianej kukiełce, która magicznie ożywa, aby wlać otuchę w serce pogrążonego w żałobie stolarza imieniem Geppetto. Ten fantazyjny musical w technice animacji poklatkowej, wyreżyserowany przez Guillermo del Toro i Marka Gustafsona, opowiada o przygodach psotnego i krnąbrnego Pinokia, który szuka swojego miejsca w świecie.","popularity":8.5556,"poster_path":"/1uGPzZ55lsb0Ui6K6vmsuUpZ7CG.jpg","release_date":"2022-11-09","softcore":false,"video":false,"vote_average":8.003,"vote_count":3409,"credit_id":"5bcde463925141613e020c2e","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/e782pDRAlu4BG0ahd777n8zfPzZ.jpg","genre_ids":[16,14,12,18],"id":555604,"title":"Guillermo del Toro: Pinokio","original_language":"en","original_title":"Guillermo del Toro's Pinocchio","overview":"Nagrodzony Oscarem filmowiec Guillermo del Toro przedstawia własną wersję klasycznej powieści Carlo Collodiego o drewnianej kukiełce, która magicznie ożywa, aby wlać otuchę w serce pogrążonego w żałobie stolarza imieniem Geppetto. Ten fantazyjny musical w technice animacji poklatkowej, wyreżyserowany przez Guillermo del Toro i Marka Gustafsona, opowiada o przygodach psotnego i krnąbrnego Pinokia, który szuka swojego miejsca w świecie.","popularity":8.5556,"poster_path":"/1uGPzZ55lsb0Ui6K6vmsuUpZ7CG.jpg","release_date":"2022-11-09","softcore":false,"video":false,"vote_average":8.003,"vote_count":3409,"credit_id":"5bcde46d9251416131023f7d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/e782pDRAlu4BG0ahd777n8zfPzZ.jpg","genre_ids":[16,14,12,18],"id":555604,"title":"Guillermo del Toro: Pinokio","original_language":"en","original_title":"Guillermo del Toro's Pinocchio","overview":"Nagrodzony Oscarem filmowiec Guillermo del Toro przedstawia własną wersję klasycznej powieści Carlo Collodiego o drewnianej kukiełce, która magicznie ożywa, aby wlać otuchę w serce pogrążonego w żałobie stolarza imieniem Geppetto. Ten fantazyjny musical w technice animacji poklatkowej, wyreżyserowany przez Guillermo del Toro i Marka Gustafsona, opowiada o przygodach psotnego i krnąbrnego Pinokia, który szuka swojego miejsca w świecie.","popularity":8.5556,"poster_path":"/1uGPzZ55lsb0Ui6K6vmsuUpZ7CG.jpg","release_date":"2022-11-09","softcore":false,"video":false,"vote_average":8.003,"vote_count":3409,"credit_id":"5bcde47b0e0a26016402481b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/4lWr2j3ZSEe8qlt3W3ma8TiiMQB.jpg","genre_ids":[35,14,10751,27],"id":531219,"title":"Wiedźmy","original_language":"en","original_title":"Roald Dahl's The Witches","overview":"Pod koniec 1967 roku młody osierocony chłopiec zamieszkał ze swoją kochającą babcią w wiejskim mieście Demopolis w stanie Alabama. Gdy chłopiec i jego babcia spotykają zwodniczo efektowne, ale na wskroś diabelskie czarownice, dziewczyna mądrze zabiera go do nadmorskiego kurortu. Niestety, przybywają dokładnie w tym samym czasie, w którym zebrała się wielka wielka czarownica świata.","popularity":7.9736,"poster_path":"/iXy1TepXTtsCsoc6tGFhvcoXoJX.jpg","release_date":"2020-10-26","softcore":false,"video":false,"vote_average":6.332,"vote_count":3009,"credit_id":"5be33cec0e0a2614bf01a5ad","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":387914,"title":"Ayotzinapa, el Paso de la Tortuga","original_language":"es","original_title":"Ayotzinapa, el Paso de la Tortuga","overview":"","popularity":0.9117,"poster_path":"/oWBeaYnG0Skoz3foJC4tKq3vLtC.jpg","release_date":"2018-03-13","softcore":false,"video":false,"vote_average":6.1,"vote_count":7,"credit_id":"66bf559206ff46acf649e07a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/o1Rjlf8EW8NPnYNyaKoEW7czYKz.jpg","genre_ids":[16,35,27,878],"id":384419,"title":"Servicio a Domicilio","original_language":"es","original_title":"Servicio a Domicilio","overview":"","popularity":0.9732,"poster_path":"/u7d4ybcfG1tQgdSf3WdnuGfhq3p.jpg","release_date":"2005-06-14","softcore":false,"video":false,"vote_average":7.5,"vote_count":2,"credit_id":"66d2ade799001d751eb080b7","department":"Crew","job":"Presenter"},{"adult":false,"backdrop_path":"/d8VGgwr2WApwFewrL5yZQgo78E0.jpg","genre_ids":[878,16,14,28,27,12,53,10770],"id":16774,"title":"Hellboy - Miecz Burz","original_language":"en","original_title":"Hellboy Animated: Sword of Storms","overview":"","popularity":2.818,"poster_path":"/vUCrcikFCDsvA6IiS59kdfQkseU.jpg","release_date":"2006-10-28","softcore":false,"video":false,"vote_average":6.296,"vote_count":159,"credit_id":"5c62d97bc3a3681b7cd7d4e3","department":"Writing","job":"Creative Producer"},{"adult":false,"backdrop_path":"/coGcEVPsB7BPutqK0qjfAK22PUC.jpg","genre_ids":[27,878],"id":4961,"title":"Mutant","original_language":"en","original_title":"Mimic","overview":"Nie igra się z naturą. Doktor Susan Tyler (Mira Sorvino) wraz z mężem Peterem Mannem (Jeremy Northam), zastępcą dyrektora Centrum Kontroli Epidemii, muszą zwalczyć epidemię zagrażającą życiu setek tysięcy dzieci. W tym celu łączą DNA różnych gatunków, chcąc stworzyć biologiczne przeciwciała, mające pokonać czynniki wywołujące chorobę. Nowa stworzona przy tym rasa nosi nazwę Judas i zostaje wprowadzona do biosystemu Nowego Jorku. Trzy lata później uzdrawiający czynnik zaczyna żyć własnym życiem i prześladować ludzi. Na uwagę zasługują efekty specjalne i niesamowity wygląd unikalnych mutantów, które grasują po podziemnym świecie Manhattanu.","popularity":5.1576,"poster_path":"/ieRRo78f8JzEKxfiCKqJyFg6l8o.jpg","release_date":"1997-08-22","softcore":false,"video":false,"vote_average":6.093,"vote_count":1283,"credit_id":"5c6305d80e0a2650ad9821de","department":"Writing","job":"Screenstory"},{"adult":false,"backdrop_path":"/g0YNGpmlXsgHfhGnJz3c5uyzZ1B.jpg","genre_ids":[80,18,53],"id":597208,"title":"Zaułek koszmarów","original_language":"en","original_title":"Nightmare Alley","overview":"Gdy charyzmatyczny Stanton Carlisle  spotyka na swej drodze niezwykłe małżeństwo: widzącą przyszłość Zeenę  i jej męża, byłego telepatę, Pete’a , postanawia odmienić swoje dotychczas pechowe życie. Wraz z lojalną i szlachetną Molly  zaczyna wykorzystywać naiwność nowojorskich elit by się wzbogacić, a nowo nabyta wiedza szybko okazuje się przepustką do sukcesu. Wkrótce jednak Stanton posunie się o krok za daleko, gdy pod wpływem tajemniczej psychiatry  zdecyduje się oszukać groźnego finansowego potentata .","popularity":6.9547,"poster_path":"/axXoaUV1liRYTbQa5sRsJJ5lL2w.jpg","release_date":"2021-12-02","softcore":false,"video":false,"vote_average":6.944,"vote_count":3427,"credit_id":"5cbf888a0e0a2615fdf34445","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/g0YNGpmlXsgHfhGnJz3c5uyzZ1B.jpg","genre_ids":[80,18,53],"id":597208,"title":"Zaułek koszmarów","original_language":"en","original_title":"Nightmare Alley","overview":"Gdy charyzmatyczny Stanton Carlisle  spotyka na swej drodze niezwykłe małżeństwo: widzącą przyszłość Zeenę  i jej męża, byłego telepatę, Pete’a , postanawia odmienić swoje dotychczas pechowe życie. Wraz z lojalną i szlachetną Molly  zaczyna wykorzystywać naiwność nowojorskich elit by się wzbogacić, a nowo nabyta wiedza szybko okazuje się przepustką do sukcesu. Wkrótce jednak Stanton posunie się o krok za daleko, gdy pod wpływem tajemniczej psychiatry  zdecyduje się oszukać groźnego finansowego potentata .","popularity":6.9547,"poster_path":"/axXoaUV1liRYTbQa5sRsJJ5lL2w.jpg","release_date":"2021-12-02","softcore":false,"video":false,"vote_average":6.944,"vote_count":3427,"credit_id":"5cbf891cc3a36809ab8183c0","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/g0YNGpmlXsgHfhGnJz3c5uyzZ1B.jpg","genre_ids":[80,18,53],"id":597208,"title":"Zaułek koszmarów","original_language":"en","original_title":"Nightmare Alley","overview":"Gdy charyzmatyczny Stanton Carlisle  spotyka na swej drodze niezwykłe małżeństwo: widzącą przyszłość Zeenę  i jej męża, byłego telepatę, Pete’a , postanawia odmienić swoje dotychczas pechowe życie. Wraz z lojalną i szlachetną Molly  zaczyna wykorzystywać naiwność nowojorskich elit by się wzbogacić, a nowo nabyta wiedza szybko okazuje się przepustką do sukcesu. Wkrótce jednak Stanton posunie się o krok za daleko, gdy pod wpływem tajemniczej psychiatry  zdecyduje się oszukać groźnego finansowego potentata .","popularity":6.9547,"poster_path":"/axXoaUV1liRYTbQa5sRsJJ5lL2w.jpg","release_date":"2021-12-02","softcore":false,"video":false,"vote_average":6.944,"vote_count":3427,"credit_id":"5cbf89590e0a2654e9f16bae","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7aW9IZjpsoTXYEARlnOvTtl6EBr.jpg","genre_ids":[18,10749],"id":1391,"title":"I twoją matkę też","original_language":"es","original_title":"Y tu mamá también","overview":"Tenoch i Julio spotykają Luise na weselu. Chcąc zaimponować starszej dziewczynie mówią jej, że wybierają się w daleką podróż. Luise chce koniecznie jechać z nimi. W czasie podróży Luisa wprowadzi chłopców w tajniki seksu, a długa droga każe im stanąć oko w oko z rzeczywistością, z której istnienia, nie zdawali sobie sprawy.","popularity":8.6564,"poster_path":"/8QluJvAIHxYHaWJ0EQlqNRuvY41.jpg","release_date":"2001-06-08","softcore":false,"video":false,"vote_average":7.437,"vote_count":1785,"credit_id":"5eeb1839dd926a0036a0adde","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/avwEj8wiywFH6FZ6h2wzvyJpiH7.jpg","genre_ids":[14,28],"id":1487,"title":"Hellboy","original_language":"en","original_title":"Hellboy","overview":"Pod koniec II wojny światowej, kiedy dni Rzeszy były już policzone, zdesperowani naziści próbowali ratować swe siły wszelkimi sposobami, uciekając się nawet do wykorzystania magii. Czarna msza - satanistyczna ceremonia, która miała odmienić losy wojny i doprowadzić do stworzenia walczącego u boku Niemców demona - została przerwana przez aliantów. Ale Hellboy, syn szatana, został już przywołany z otchłani. Przygarnięty przez zwycięzców i odpowiednio wyszkolony stanął po stronie dobra, by walczyć z wiecznie czujnymi siłami zła...","popularity":9.5035,"poster_path":"/lbaTEneOofwvAyg77R8HbFML2zT.jpg","release_date":"2004-04-02","softcore":false,"video":false,"vote_average":6.678,"vote_count":7528,"credit_id":"5f499c8a37b3a90038dfa3f4","department":"Crew","job":"Fight Choreographer"},{"adult":false,"backdrop_path":"/bTyViQNF2dCAeJgoPAXUVYWjw8v.jpg","genre_ids":[18],"id":384421,"title":"Mentiras piadosas","original_language":"es","original_title":"Mentiras piadosas","overview":"","popularity":0.6345,"poster_path":"/7qCAuaux2kW3iMlE7HMQPop4PWd.jpg","release_date":"1989-07-01","softcore":false,"video":false,"vote_average":5.0,"vote_count":11,"credit_id":"5f62a6a1156cc70038ec24b0","department":"Costume & Make-Up","job":"Special Effects Makeup Artist"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":363384,"title":"Goitia, un dios para sí mismo","original_language":"es","original_title":"Goitia, un dios para sí mismo","overview":"","popularity":0.9805,"poster_path":"/lLAaWcgcdtQosYCwFG3DVA3sFRs.jpg","release_date":"1989-01-01","softcore":false,"video":false,"vote_average":4.071,"vote_count":14,"credit_id":"5f62a77a069f0e0036a83742","department":"Costume & Make-Up","job":"Special Effects Makeup Artist"},{"adult":false,"backdrop_path":"/6R9nT6m8wmzayV5XOQq3TRA6yZw.jpg","genre_ids":[28,35,10749],"id":22538,"title":"Scott Pilgrim kontra świat","original_language":"en","original_title":"Scott Pilgrim vs. the World","overview":"Scott Pilgrim, 22-letni bezrobotny basista zespołu rockowego Sex Bob-omb, spotyka dziewczynę swoich marzeń. Zakochany po uszy chłopak nie przeczuwa, że miłość do pięknej nieznajomej już wkrótce wywróci jego życie do góry nogami. Aby zdobyć serce Ramony Flowers, będzie musiał pokonać jej siedmiu byłych chłopaków.  Iskrząca dowcipem, komiksowa historia autorstwa niedoścignionego mistrza gatunku Edgara Wrighta.  Gdy bycie SINGLEM przestaje być cool,  DOŁADUJ SIĘ miłością, nim skończy się twa GRA.","popularity":14.0951,"poster_path":"/4trqkuvj5dHOXoki1Rgl9lWIQD1.jpg","release_date":"2010-08-12","softcore":false,"video":false,"vote_average":7.484,"vote_count":8734,"credit_id":"5f7cd081c8113d0036a71668","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/4lWr2j3ZSEe8qlt3W3ma8TiiMQB.jpg","genre_ids":[35,14,10751,27],"id":531219,"title":"Wiedźmy","original_language":"en","original_title":"Roald Dahl's The Witches","overview":"Pod koniec 1967 roku młody osierocony chłopiec zamieszkał ze swoją kochającą babcią w wiejskim mieście Demopolis w stanie Alabama. Gdy chłopiec i jego babcia spotykają zwodniczo efektowne, ale na wskroś diabelskie czarownice, dziewczyna mądrze zabiera go do nadmorskiego kurortu. Niestety, przybywają dokładnie w tym samym czasie, w którym zebrała się wielka wielka czarownica świata.","popularity":7.9736,"poster_path":"/iXy1TepXTtsCsoc6tGFhvcoXoJX.jpg","release_date":"2020-10-26","softcore":false,"video":false,"vote_average":6.332,"vote_count":3009,"credit_id":"5f77286c21621b00353a199e","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/gqQKxYVIaYv53Qoy72nQqQxdXYF.jpg","genre_ids":[14,28],"id":11253,"title":"Hellboy: Złota Armia","original_language":"en","original_title":"Hellboy II: The Golden Army","overview":"Kolejna część przygód bohatera komiksów autorstwa Mike'a Mignoli. Hellboy walczy ze złem, kiedy nadchodzi wezwanie od pracodawcy: ściśle tajnego Biura ds. Badań Paranormalnych i Obrony (biuro stworzone przez Roosevelta w 1943 roku, które wykorzystuje tajne technologie, tajemnicze moce i sieć współpracowników posiadających nadprzyrodzone zdolności, których zadaniem jest bronić świat przed brutalnymi napastnikami – znane także jako B.B.P.O.). On oczywiście wolałby spędzić czas z cygarem, sześciopakiem, swoją obdarzoną pirokinetyczną energią dziewczyną, Liz Sherman (Selma Blair – \"Legalna blondynka\", \"W doborowym towarzystwie\") i kotami. Ale przeznaczenie ma dla niego inne zadania.","popularity":8.3777,"poster_path":"/dQXCc1AGRY9OaOQ6BIqAVWH0NpQ.jpg","release_date":"2008-07-11","softcore":false,"video":false,"vote_average":6.77,"vote_count":5677,"credit_id":"66dbe1d7812bf818133424be","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/kv9xVrxfLpudBLyYf1QvLCpUQuy.jpg","genre_ids":[36,18,35],"id":1182047,"title":"Wybraniec","original_language":"en","original_title":"The Apprentice","overview":"Młody Donald Trump, pragnący zdobyć sławę jako głodny potomek bogatej rodziny w Nowym Jorku lat 70-tych, ulega urokowi Roya Cohna, bezwzględnego prawnika, który pomoże stworzyć Donalda Trumpa, jakiego znamy dzisiaj. Cohn widzi w Trumpie idealnego protegowanego - kogoś z surową ambicją, głodem sukcesu i chęcią zrobienia wszystkiego, aby wygrać.","popularity":10.7058,"poster_path":"/khp7PZ6g1PJHw5XWdML2zhqdPGO.jpg","release_date":"2024-10-09","softcore":false,"video":false,"vote_average":6.854,"vote_count":996,"credit_id":"672be71969b81e483731f4f0","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/s1r2aBDzkvlFkNnAgxWFTCQjKPe.jpg","genre_ids":[18],"id":45958,"title":"Biutiful","original_language":"es","original_title":"Biutiful","overview":"Umierający na raka mężczyzna stara się zabezpieczyć przyszłość swoim dzieciom.","popularity":3.9047,"poster_path":"/a0TjYEOsGe1XWEfPvRrqo5bRyNr.jpg","release_date":"2010-10-20","softcore":false,"video":false,"vote_average":7.246,"vote_count":1224,"credit_id":"673c94673b480481cdddd38d","department":"Production","job":"Associate Producer"},{"adult":false,"backdrop_path":"/cjZ7No0DX2L3ielLSoUOMYPw7C.jpg","genre_ids":[27,35],"id":1124620,"title":"Małpa","original_language":"en","original_title":"The Monkey","overview":"Bliźniacy Hal i Bill odkrywają na strychu zabawkową małpkę swojego ojca. Wkrótce po tym, w ich najbliższym otoczeniu zaczyna dochodzić do serii zagadkowych i makabrycznych zgonów. Próbując odciąć się od ewidentnie nawiedzonego przedmiotu, bracia postanawiają wyrzucić małpę i kontynuować swoje życie, jakby nic się nie stało. Jednak po latach kolejne niewytłumaczalne śmierci wychodzą na światło dzienne. Czas nie jest sprzymierzeńcem, a zło czyha na każdym kroku.","popularity":13.1575,"poster_path":"/eVfOctGpHsl7yXr9MNe6Yqjs07n.jpg","release_date":"2025-02-10","softcore":false,"video":false,"vote_average":5.972,"vote_count":1406,"credit_id":"67d154d36ecec5f39a81563c","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/1DHbZ1XRvdeXbD2P7W1OJbxqN9b.jpg","genre_ids":[878,18,14],"id":592831,"title":"Megalopolis","original_language":"en","original_title":"Megalopolis","overview":"Megalopolis to rzymski epos, którego akcja rozgrywa się w wyimaginowanej współczesnej Ameryce w pełnej dekadencji. Miasto Nowy Rzym absolutnie musi się zmienić, co powoduje poważny konflikt między Césarem Catyliną, genialnym artystą posiadającym moc zatrzymywania czasu, a arcykonserwatywnym burmistrzem Franklynem Cicero. Pierwszy marzą o idealnej utopijnej przyszłości, podczas gdy drugi pozostaje bardzo przywiązany do regresywnego status quo chroniącego chciwość, przywileje i prywatę milicji. Córka burmistrza Julia Cicero, zakochana w Césarze Catylinie, jest rozdarta między dwoma mężczyznami i będzie musiała odkryć, co wydaje się najlepsze dla przyszłości ludzkości.","popularity":5.8686,"poster_path":"/8Sok3HNA3r1GHnK2lCytHyBz1A.jpg","release_date":"2024-09-25","softcore":false,"video":false,"vote_average":5.2,"vote_count":1026,"credit_id":"67ff0b5def5ae687cbd98b85","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":null,"genre_ids":[16,12,14],"id":1495052,"title":"Sira y el secreto del parque","original_language":"es","original_title":"Sira y el secreto del parque","overview":"","popularity":0.6306,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"68465b12166c738044de6e6e","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":1526726,"title":"The Boy in the Iron Box","original_language":"en","original_title":"The Boy in the Iron Box","overview":"","popularity":1.0379,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6894dba8678ee19c0692241c","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":1526726,"title":"The Boy in the Iron Box","orig