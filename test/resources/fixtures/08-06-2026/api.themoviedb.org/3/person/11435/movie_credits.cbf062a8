ning, która pragnie wrócić do ojczyzny, postanawia przyjąć propozycję Gerarda i za zarobione pieniądze kupuje dziewczynie bilet do USA.","popularity":2.6763,"poster_path":"/kPA3gJ18bt3OoXYX0WmMntD5eh1.jpg","release_date":"1945-01-20","softcore":false,"video":false,"vote_average":7.449,"vote_count":583,"credit_id":"5612b426c3a36868170159b1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/dlmaZ0VjE1J0Qp1fMA03xQ3w0VD.jpg","genre_ids":[18],"id":420011,"title":"The Road to Glory","original_language":"en","original_title":"The Road to Glory","overview":"","popularity":0.7235,"poster_path":"/jILRsb6Z7vovNGGnG2Rp66UdLPc.jpg","release_date":"1926-02-07","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"credit_id":"61da2d254544af00197beb18","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/bIv1kaxb7tsiZYPO27PHfVb5eSF.jpg","genre_ids":[80,28,18,53],"id":877,"title":"Człowiek z blizną","original_language":"en","original_title":"Scarface","overview":"Młody przestępca zabiega o to, by zająć pozycję szefa gangu. Gdy osiąga swój cel, rozprawia się z przeciwnikami w wyjątkowo brutalny sposób.","popularity":3.872,"poster_path":"/y4E5oRiHMTFkEB12IIcpbKbKzDW.jpg","release_date":"1932-04-09","softcore":false,"video":false,"vote_average":7.4,"vote_count":705,"credit_id":"56ec45f3c3a368224e00310c","department":"Crew","job":"Additional Writing"},{"adult":false,"backdrop_path":"/8gRzaUleK5ik6ddRvZbOpxolHLh.jpg","genre_ids":[12,35],"id":110887,"title":"A Girl in Every Port","original_language":"en","original_title":"A Girl in Every Port","overview":"","popularity":1.0202,"poster_path":"/kaIyUSHMimpUGXfTtMlif22Giwa.jpg","release_date":"1928-02-26","softcore":false,"video":false,"vote_average":6.0,"vote_count":25,"credit_id":"56e918d1c3a3682d72002a6b","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/oGe7xOU0cohvsSYmeDHSvkq9i71.jpg","genre_ids":[18,10749],"id":109262,"title":"Tiger Shark","original_language"