{"cast":[{"adult":false,"backdrop_path":"/eCynaAOgYYiw5yN5lBwz3IxqvaW.jpg","genre_ids":[16,10751,12],"id":12,"title":"Gdzie jest Nemo","original_language":"en","original_title":"Finding Nemo","overview":"Wielką Rafę Koralową zamieszkują kolorowe rybki zwane błazenkami. Jedną z nich o imieniu Marlin spotyka tragedia. Drapieżna ryba pożera mu żonę - Coral i prawie wszystkie jajeczka ikry, z których miały młode błazenki. Ocalał jedynie jeden mały błazenek o imieniu Nemo, który staje się oczkiem w głowie Marlina. Gdy jednak nadopiekuńczy ojciec postanawia wysyłać go do szkoły, zdarza się kolejne nieszczęście: mały błazenek zostaje wyłowiony z oceanu przez nurka i trafia do akwarium w gabinecie dentystycznym w Sydney. Merlin, który boi się głębi oceanu, postanawia wyruszyć na ratunek synkowi. W jego wyprawie towarzyszy mu inna rybka - Dora, która jest straszliwą zapominalską.","popularity":35.5124,"poster_path":"/81ULtY262mzmTR8PagVdNApcoHp.jpg","release_date":"2003-05-30","softcore":false,"video":false,"vote_average":7.821,"vote_count":20757,"character":"Crush (voice)","credit_id":"52fe420ec3a36847f8000689","order":11},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":570252,"title":"Making 'Nemo'","original_language":"en","original_title":"Making 'Nemo'","overview":"Krótkometrażowy","popularity":0.8201,"poster_path":"/lfPI060j1Pq0RDM11EbcpBaINBu.jpg","release_date":"2003-11-04","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self - Writer / Director","credit_id":"61a8c91b0582240042b831b7","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1113564,"title":"A Visit to the Pixar Living Archive","original_language":"en","original_title":"A Visit to the Pixar Living Archive","overview":"","popularity":0.5304,"poster_path":"/crYVdAOtO8GGePHKr8kiYftt74O.jpg","release_date":"2022-11-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"643ae0ec719aeb04cbeb9279","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1114498,"title":"Ralph-E: The Art of the Color Script","original_language":"en","original_title":"Ralph-E: The Art of the Color Script","overview":"","popularity":0.4472,"poster_path":"/i1GPmopVTVf3sqSrKltBRkReEWs.jpg","release_date":"2022-11-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"643d95eced96bc0432596c51","order":1},{"adult":false,"backdrop_path":"/guF5f7oMZwfUPxcNWyRiOmMB9eu.jpg","genre_ids":[99],"id":1115190,"title":"Animation Sound Design: Building Worlds from the Sound Up","original_language":"en","original_title":"Animation Sound Design: Building Worlds from the Sound Up","overview":"","popularity":0.4294,"poster_path":"/rc2v1OD4e8N88bLwYZ2PI2hS9j5.jpg","release_date":"2008-11-18","softcore":false,"video":true,"vote_average":8.0,"vote_count":1,"character":"","credit_id":"643f6119eb093202fb1e070e","order":1},{"adult":false,"backdrop_path":"/1gXxCGYUDuFlVu31tAtYXXza9It.jpg","genre_ids":[99],"id":940075,"title":"Embrace the Panda: Making Turning Red","original_language":"en","original_title":"Embrace the Panda: Making Turning Red","overview":"","popularity":1.3024,"poster_path":"/ociUlULY2vZkenQqwTnwK4aq2Y1.jpg","release_date":"2022-03-11","softcore":false,"video":false,"vote_average":6.8,"vote_count":41,"character":"Self (archive footage)","credit_id":"622dcc8eb04605001ce4780e","order":5},{"adult":false,"backdrop_path":"/mBJ995JUssgh2hhm4JxNj8hyVVM.jpg","genre_ids":[99],"id":979163,"title":"Za końcem świata: Podróż Buzza Astrala","original_language":"en","original_title":"Beyond Infinity: Buzz and the Journey to Lightyear","overview":"Zobacz, jak Buzz Astral zmienia się z zabawki w prawdziwego astronautę. Dowiedz się, jak powstawał projekt ożywionej wersji ulubionego przez wszystkich Strażnika Kosmosu oraz przed jakimi wyzwaniami stanęła ekipa studia podczas produkcji najnowszego hitu","popularity":1.9315,"poster_path":"/mnp0INIjyWt4AziWmTHgPk9IFoE.jpg","release_date":"2022-06-10","softcore":false,"video":false,"vote_average":7.031,"vote_count":241,"character":"Self","credit_id":"62a35846d2147c12f655f61f","order":12},{"adult":false,"backdrop_path":"/1x8qZSDzqFFth4ijstLEwzHLUOQ.jpg","genre_ids":[99],"id":47813,"title":"Zbudzić śpiącą królewnę","original_language":"en","original_title":"Waking Sleeping Beauty","overview":"Daleki od bajek film „Zbudzić śpiącą królewnę” to pouczające spojrzenie na dziedzictwo animacji Disneya, przekazane przez ludzi, którzy tam wtedy byli. Ten film prezentuje ludzi i okoliczności, które na zawsze zmieniły oblicze animacji.","popularity":2.3944,"poster_path":"/hywGLq5tMOuKwXfOhYUzoqNNAnU.jpg","release_date":"2009-09-05","softcore":false,"video":false,"vote_average":7.171,"vote_count":114,"character":"Self (archive footage)","credit_id":"62bd25657304b52384a213b4","order":74},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1233887,"title":"Anatomy of a Scene: The Plant","original_language":"en","original_title":"Anatomy of a Scene: The Plant","overview":"","popularity":0.4982,"poster_path":"/yJaJdDAAbNLbHT8ZJQWHz0CQAS4.jpg","release_date":"2022-11-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"65ac3a05848eb9010a98a143","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1233872,"title":"Where It Began: The Origins of WALL·E","original_language":"en","original_title":"Where It Began: The Origins of WALL·E","overview":"","popularity":0.4806,"poster_path":null,"release_date":"2022-11-22","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"65ac2fc7158c8500ac1b52df","order":0},{"adult":false,"backdrop_path":"/sOLgkBKf1gjMRc4yXxM5aciXdfr.jpg","genre_ids":[16,12,35,10751],"id":920,"title":"Auta","original_language":"en","original_title":"Cars","overview":"Zygzak McQueen jest młodym i ambitnym samochodem wyścigowym, który marzy o olśniewających sukcesach i przygotowuje się do startu w wielkim wyścigu o Mistrzostwo Złotego Tłoka w Kalifornii. Zamiast na trasę wyścigu, trafia jednak do pustynnego miasteczka Chłodnica Górska przy autostradzie 66 i szybko poznaje jego ekscentrycznych mieszkańców. Są wśród nich: Sally - Porsche 2002, Wójt Hudson - stary samochód o tajemniczej przeszłości oraz Złomek, zardzewiała ciężarówka holownicza. W grupie nowych przyjaciół McQueen przekonuje się, że są w życiu ważniejsze rzeczy, niż dążenie do sukcesu za wszelką cenę oraz zdobywanie kolejnych pucharów.","popularity":22.9946,"poster_path":"/n605WEExZJzJgeYhC1Lv9LvcNvw.jpg","release_date":"2006-06-08","softcore":false,"video":false,"vote_average":7.043,"vote_count":15317,"character":"Fred (voice)","credit_id":"550ba2b4c3a3687c11000889","order":25},{"adult":false,"backdrop_path":"/nH3PszZ0ZavXrlx5hjwrzK7vE4B.jpg","genre_ids":[16],"id":209681,"title":"Somewhere in the Arctic...","original_language":"en","original_title":"Somewhere in the Arctic...","overview":"","popularity":0.9394,"poster_path":"/6PUOVv8kj417IB9cBGnfWld6gXI.jpg","release_date":"1986-06-25","softcore":false,"video":false,"vote_average":5.565,"vote_count":23,"character":"Bahr (voice)","credit_id":"639f8ea1223e20007d3d268a","order":1},{"adult":false,"backdrop_path":"/7iUDfakacY1HpajP1DtHrCuDB95.jpg","genre_ids":[16,35,10751],"id":863,"title":"Toy Story 2","original_language":"en","original_title":"Toy Story 2","overview":"Kontynuacja opowieści sprzed kilku lat, zrealizowanej techniką komputerową. Akcja toczy się w domu chłopca, jego zabawki żyją własnym życiem. Jedna z figurek, kowboj, zostaje uszkodzona. Przez przypadek kowboj trafia na wyprzedaż rzeczy używanych.","popularity":36.0552,"poster_path":"/156IFZshUqhYZLznowAd229QYkG.jpg","release_date":"1999-10-30","softcore":false,"video":false,"vote_average":7.618,"vote_count":15163,"character":"Emperor Zurg (voice)","credit_id":"55f99979c3a368678b0030dc","order":17},{"adult":false,"backdrop_path":"/nYs4ZwnJBK4AgljhvzwNz7fpr3E.jpg","genre_ids":[16,10751,878],"id":10681,"title":"WALL-E","original_language":"en","original_title":"WALL·E","overview":"Co się stanie, jeżeli ludzie opuszczą kiedyś Ziemię i pozostanie na niej jedynie mały robot? WALL.E (Wysypiskowy Automat Likwidująco Lewarujący. E-klasa) przez siedemset lat w samotności oczyszcza Ziemię z odpadów pozostawionych przez ludzi. Pewnego dnia na planetę przybywa EVE – nowoczesna, przepiękna, myśląca maszyna. Tego dnia życie WALL.E’ego zupełnie się zmienia i nabiera nowego sensu. Jego podróż przez galaktykę, przyjaźń z EVE, zabawne przygody oraz nowi, niekiedy niezwykli przyjaciele stali się tematem najnowszej komedii Studia Pixar.","popularity":36.3037,"poster_path":"/hbhFnRzzg6ZDmm8YAmxBnQpQIPh.jpg","release_date":"2008-06-26","softcore":false,"video":false,"vote_average":8.118,"vote_count":20581,"character":"Additional Voices (voice)","credit_id":"561be40b9251415a6b00179b","order":22},{"adult":false,"backdrop_path":"/lxwzY9vNwjDgxWKt3zZ6zcU6rEJ.jpg","genre_ids":[28,12,16,10751],"id":9806,"title":"Iniemamocni","original_language":"en","original_title":"The Incredibles","overview":"Pan Parr, kiedyś znany powszechnie jako \"Iniemamocny\", oraz jego żona Helen, prowadzą życie emerytowanej pary superbohaterów. Zostali zmuszeni do zaniechania swej działalności piętnaście lat wcześniej i dziś spokojnie mieszkają na przedmieściu. Ich dzieci nie wiedzą wszystkiego o dawnych zajęciach rodziców. Niespodziewanie jednak przed Iniemamocnym pojawia się szansa, by wrócić do branży i przeprowadzić bardzo niebezpieczną, tajną akcję na dalekiej wyspie. Parr skorzysta z niej z ochotą, ale długa przerwa w aktywności sprawi, że nie będzie to łatwe. Przy okazji wciągnie w wir zdarzeń całą rodzinę.","popularity":24.5647,"poster_path":"/40JNHA9ACAimzP8fFoD8Lf80Eee.jpg","release_date":"2004-10-27","softcore":false,"video":false,"vote_average":7.728,"vote_count":19092,"character":"Additional Voices (voice)","credit_id":"661862076f31af01639a3ad0","order":46},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":435949,"title":"Breaking the Mold: The Re-Making of Mighty Mouse","original_language":"en","original_title":"Breaking the Mold: The Re-Making of Mighty Mouse","overview":"","popularity":0.6542,"poster_path":"/khhl2wtvGv95qmVb6EEjapZs3L6.jpg","release_date":"2010-01-05","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"character":"Self","credit_id":"66286653e295b401879d7a6f","order":7},{"adult":false,"backdrop_path":"/wijltj1toRcicHlCn8Cpsp4yPXe.jpg","genre_ids":[12,16,10751],"id":127380,"title":"Gdzie jest Dory","original_language":"en","original_title":"Finding Dory","overview":"Dory jest uroczą rybką, którą cierpi na pewną przypadłość - brak pamięci krótkotrwałej. Gdy była mała, kochający rodzice z całych sił starali się ustrzec ją przed niebezpieczeństwem. Pewnego dnia jednak Dory wpadła w prąd oceaniczny, który porwał ją w nieznane. Teraz próbuje przypomnieć sobie swoją przeszłość i odnaleźć rodziców. Wyrusza do Kalifornii, a pomagają jej w tym przyjaciele: błazenek Marlin i jego synek Nemo, zgryźliwa ośmiornica Hank, narwalowaty Bailey, przekonany o tym, że cierpi na zaburzenia echolokacji, i Nadzieja, rekin wielorybi z wadą wzroku.","popularity":13.2121,"poster_path":"/4dUrWFhJKnMOCxlo9Hgy2Z4mmGr.jpg","release_date":"2016-06-16","softcore":false,"video":false,"vote_average":7.042,"vote_count":12759,"character":"Crush (voice)","credit_id":"5711829b9251410a68000ae0","order":12},{"adult":false,"backdrop_path":"/jbdvzJvNu0swWURJp71Fxwd54Fm.jpg","genre_ids":[99],"id":15302,"title":"Historia Studia Pixar","original_language":"en","original_title":"The Pixar Story","overview":"Historia Pixara przenosi widzów za kulisy powstawania rewolucyjnego studia animacji, które przetarło szlaki nowemu pokoleniu animatorów i na zawsze odmieniło oblicze kinematografii.","popularity":2.8965,"poster_path":"/v8afZfDwJ8Oi31F1YJ9zJCLosKc.jpg","release_date":"2007-08-28","softcore":false,"video":false,"vote_average":7.539,"vote_count":246,"character":"Self - Seagulls","credit_id":"573de914c3a3685e4c001705","order":8},{"adult":false,"backdrop_path":"/2r6tLi4p21dqVmOP5Lwge4hcDAU.jpg","genre_ids":[28,12,16,35,10751,878,10770],"id":16187,"title":"Buzz Astral Strażnik Kosmosu: Początek Przygody","original_language":"en","original_title":"Buzz Lightyear of Star Command: The Adventure Begins","overview":"","popularity":3.5407,"poster_path":"/sbZ2ETj55ZpumplROESuWCLV3q7.jpg","release_date":"2000-08-08","softcore":false,"video":false,"vote_average":6.407,"vote_count":338,"character":"Hamm (voice)","credit_id":"597fee22c3a368109e004a59","order":16},{"adult":false,"backdrop_path":"/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genre_ids":[16,12],"id":148950,"title":"A Story","original_language":"en","original_title":"A Story","overview":"","popularity":0.6873,"poster_path":"/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","release_date":"1987-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":24,"character":"Randy / The Goon Squad (voice) (as Andy)","credit_id":"5a7bc5a0c3a3680fa5006299","order":3},{"adult":false,"backdrop_path":"/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","genre_ids":[10751,35,16,12],"id":862,"title":"Toy Story","original_language":"en","original_title":"Toy Story","overview":"W świecie zabawek Andy'ego, których niekwestionowanym liderem był dotychczas kowboj Chudy, pojawia się nowa zabawka - astronauta Buzz.","popularity":49.4793,"poster_path":"/23D1RbVL0ayMw1RzS3jnVzqivTd.jpg","release_date":"1995-11-22","softcore":false,"video":false,"vote_average":7.984,"vote_count":20263,"character":"Commercial Chorus (voice)","credit_id":"5aa59d0bc3a3687bff02cc99","order":35},{"adult":false,"backdrop_path":"/hwwFyowfcbLRVmRBOkvnABBNIOs.jpg","genre_ids":[12,16,35,10751],"id":9487,"title":"Dawno temu w trawie","original_language":"en","original_title":"A Bug's Life","overview":"\"Dawno temu w trawie\" to nowy film wytwórni Walta Disneya. Bohaterami tej opowieści są mrówki, koniki polne i wiele różnych owadów żyjących w gęstwinie traw. Mróweczki, które mieszkają na Mrówczej Wyspie, mają wiele problemów z gangiem koników polnych kierowanych przez bezwzględnego Hoppera. Co roku pracowite owady muszą oddawać część swoich zbiorów rabusiom. Mrówka Flik próbuje za wszelką cenę znaleźć wyjście z tej trudnej sytuacji i raz na zawsze pozbyć się złoczyńców. Flik zjednuje sobie przyjaciół w wędrownej grupie artystów, którzy są gotowi pomóc w walce ze złem.","popularity":21.2531,"poster_path":"/okpV31KV57FfXJglyiHMmOGmOOW.jpg","release_date":"1998-11-25","softcore":false,"video":false,"vote_average":6.982,"vote_count":9828,"character":"Additional Voices (voice)","credit_id":"5ab3bd2a9251417afb009300","order":52},{"adult":false,"backdrop_path":"/fk1Nlw2zPbVD7YqGx3XtKqHSL99.jpg","genre_ids":[99],"id":635072,"title":"Animation Outlaws","original_language":"en","original_title":"Animation Outlaws","overview":"","popularity":0.9595,"poster_path":"/bK1HZfueyD0F5EKi25o5S2i3y0f.jpg","release_date":"2019-09-27","softcore":false,"video":false,"vote_average":6.3,"vote_count":3,"character":"Self","credit_id":"5d902531172d7f000d576714","order":1},{"adult":false,"backdrop_path":"/rDyXQbdm5ql8N1Gm2yf4Cirru1M.jpg","genre_ids":[99,36],"id":595841,"title":"Making Waves: The Art of Cinematic Sound","original_language":"en","original_title":"Making Waves: The Art of Cinematic Sound","overview":"","popularity":2.6376,"poster_path":"/jafF7jcl116rzohZydL1VfK1y2e.jpg","release_date":"2019-10-25","softcore":false,"video":false,"vote_average":6.904,"vote_count":83,"character":"Self","credit_id":"5e65425a55c92600175f6a8f","order":13},{"adult":false,"backdrop_path":"/k7vO3lOOkxZ88Bieu5UQLEBKZOl.jpg","genre_ids":[99],"id":711704,"title":"The Making of Toy Story","original_language":"en","original_title":"The Making of Toy Story","overview":"","popularity":2.9778,"poster_path":"/s2vPOYtuOY3DMYTduRx0cOzDcWm.jpg","release_date":"1995-12-02","softcore":false,"video":false,"vote_average":6.3,"vote_count":11,"character":"Self","credit_id":"607a54f41b1f3c0040d4d01d","order":3},{"adult":false,"backdrop_path":"/sQaesFBOHjDgL1ah43xRZpLsW2W.jpg","genre_ids":[99],"id":406122,"title":"Toy Story at 20: To Infinity and Beyond","original_language":"en","original_title":"Toy Story at 20: To Infinity and Beyond","overview":"","popularity":1.5359,"poster_path":"/e1A7HontTztPtBCGwAHqIF0CIj4.jpg","release_date":"2015-12-10","softcore":false,"video":false,"vote_average":7.1,"vote_count":15,"character":"Self","credit_id":"61109feca3d027005dbe423a","order":5},{"adult":false,"backdrop_path":"/vnEHDuqOp90DF9tDpjJJ7qwI4f3.jpg","genre_ids":[99],"id":1447091,"title":"Poznajcie Ogórasy: Za kulisami serialu \"Niepokonani\"","original_language":"en","original_title":"Meet the Pickles: The Making of \"Win or Lose\"","overview":"Poznajcie Ogórasy: Za kulisami serialu \"Niepokonani\" pozwala z bliska przyjrzeć się procesowi produkcji pierwszego oryginalnego serialu Pixara. Dokument pokazuje, jak niewielki zespół filmowców, czerpiąc z własnych doświadczeń, tworzy ambitny i unikalny stylistycznie serial o szkolnej drużynie softballowej „Ogórasy\", której do mistrzostw został już tylko tydzień.","popularity":1.3277,"poster_path":"/5TQJgd3l91GSJjJif7gjviQpkAn.jpg","release_date":"2025-03-11","softcore":false,"video":false,"vote_average":6.667,"vote_count":6,"character":"Self - Executive Producer","credit_id":"67d17b7c6ecec5f39a81629b","order":10},{"adult":false,"backdrop_path":null,"genre_ids":[16],"id":1695877,"title":"Ouchless","original_language":"en","original_title":"Ouchless","overview":"","popularity":0.8675,"poster_path":null,"release_date":"1985-03-02","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"6a078072097e38d2de8b75d8","order":2},{"adult":false,"backdrop_path":"/AoDS0YXdlZ1hrkwRj538SO5Wa7J.jpg","genre_ids":[99],"id":1713524,"title":"Toy Story: 30 Years and Beyond - A Special Edition of 20/20","original_language":"en","original_title":"Toy Story: 30 Years and Beyond - A Special Edition of 20/20","overview":"","popularity":1.2365,"poster_path":"/wMy1LOPWDSQzgWsxATDxLxDAKte.jpg","release_date":"2026-06-12","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6a2cb321803b6912df62ae32","order":7},{"adult":false,"backdrop_path":"/8sSKdEmlmqF4kJUd28SqthXC4yZ.jpg","genre_ids":[16,10751,35,12],"id":1084244,"title":"Toy Story 5","original_language":"en","original_title":"Toy Story 5","overview":"Praca Buzza, Chudego, Jessie i reszty ekipy staje się wykładniczo trudniejsza, gdy mierzą się z zupełnie nowym zagrożeniem dla zabawy: technologią.","popularity":316.2019,"poster_path":"/1Yu8ILEVcUIVOPWJxGuPqgUdwD9.jpg","release_date":"2026-06-17","softcore":false,"video":false,"vote_average":7.413,"vote_count":756,"character":"Emperor Zurg (voice)","credit_id":"6a3303420c9d610193540b49","order":31}],"crew":[{"adult":false,"backdrop_path":"/eCynaAOgYYiw5yN5lBwz3IxqvaW.jpg","genre_ids":[16,10751,12],"id":12,"title":"Gdzie jest Nemo","original_language":"en","original_title":"Finding Nemo","overview":"Wielką Rafę Koralową zamieszkują kolorowe rybki zwane błazenkami. Jedną z nich o imieniu Marlin spotyka tragedia. Drapieżna ryba pożera mu żonę - Coral i prawie wszystkie jajeczka ikry, z których miały młode błazenki. Ocalał jedynie jeden mały błazenek o imieniu Nemo, który staje się oczkiem w głowie Marlina. Gdy jednak nadopiekuńczy ojciec postanawia wysyłać go do szkoły, zdarza się kolejne nieszczęście: mały błazenek zostaje wyłowiony z oceanu przez nurka i trafia do akwarium w gabinecie dentystycznym w Sydney. Merlin, który boi się głębi oceanu, postanawia wyruszyć na ratunek synkowi. W jego wyprawie towarzyszy mu inna rybka - Dora, która jest straszliwą zapominalską.","popularity":35.5124,"poster_path":"/81ULtY262mzmTR8PagVdNApcoHp.jpg","release_date":"2003-05-30","softcore":false,"video":false,"vote_average":7.821,"vote_count":20757,"credit_id":"52fe420ec3a36847f80006b1","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/eCynaAOgYYiw5yN5lBwz3IxqvaW.jpg","genre_ids":[16,10751,12],"id":12,"title":"Gdzie jest Nemo","original_language":"en","original_title":"Finding Nemo","overview":"Wielką Rafę Koralową zamieszkują kolorowe rybki zwane błazenkami. Jedną z nich o imieniu Marlin spotyka tragedia. Drapieżna ryba pożera mu żonę - Coral i prawie wszystkie jajeczka ikry, z których miały młode błazenki. Ocalał jedynie jeden mały błazenek o imieniu Nemo, który staje się oczkiem w głowie Marlina. Gdy jednak nadopiekuńczy ojciec postanawia wysyłać go do szkoły, zdarza się kolejne nieszczęście: mały błazenek zostaje wyłowiony z oceanu przez nurka i trafia do akwarium w gabinecie dentystycznym w Sydney. Merlin, który boi się głębi oceanu, postanawia wyruszyć na ratunek synkowi. W jego wyprawie towarzyszy mu inna rybka - Dora, która jest straszliwą zapominalską.","popularity":35.5124,"poster_path":"/81ULtY262mzmTR8PagVdNApcoHp.jpg","release_date":"2003-05-30","softcore":false,"video":false,"vote_average":7.821,"vote_count":20757,"credit_id":"52fe420ec3a36847f8000653","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sDTnMOJ3H5wI38OxObmCtK7wfd5.jpg","genre_ids":[16,35,10751,14],"id":585,"title":"Potwory i spółka","original_language":"en","original_title":"Monsters, Inc.","overview":"Monstropolis to miasto zamieszkane przez potwory. W jego centrum znajduje się fabryka strachu Potwory i Spółka, gdzie w pocie czoła pracują: prawdziwy mistrz straszenia, James P. Sullivan, zwany Sulley, oraz jego najlepszy przyjaciel i pomocnik Mike Wazowski. Sulley i Mike co noc otwierają szafy w dziecięcych pokojach, by straszyć maluchy i przetwarzać ich krzyki na źródło energii. Wykonując swoją pracę, potwory głęboko wierzą, iż dzieci są toksyczne i niebezpieczne, a bezpośredni kontakt z nimi może mieć – nomen omen – potworne skutki. Kiedy więc mała dziewczynka o imieniu Boo trafia przypadkiem do ich świata, wybucha prawdziwa panika. Mike i Sulley robią wszystko, by odesłać Boo z powrotem do domu. Niestety okazuje się, że jest to bardziej skomplikowane, niż przypuszczali…","popularity":35.1859,"poster_path":"/6Wm9FC1TuhD32hzogKik9rTbFZR.jpg","release_date":"2001-11-01","softcore":false,"video":false,"vote_average":7.856,"vote_count":20028,"credit_id":"52fe4256c3a36847f8016875","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/sDTnMOJ3H5wI38OxObmCtK7wfd5.jpg","genre_ids":[16,35,10751,14],"id":585,"title":"Potwory i spółka","original_language":"en","original_title":"Monsters, Inc.","overview":"Monstropolis to miasto zamieszkane przez potwory. W jego centrum znajduje się fabryka strachu Potwory i Spółka, gdzie w pocie czoła pracują: prawdziwy mistrz straszenia, James P. Sullivan, zwany Sulley, oraz jego najlepszy przyjaciel i pomocnik Mike Wazowski. Sulley i Mike co noc otwierają szafy w dziecięcych pokojach, by straszyć maluchy i przetwarzać ich krzyki na źródło energii. Wykonując swoją pracę, potwory głęboko wierzą, iż dzieci są toksyczne i niebezpieczne, a bezpośredni kontakt z nimi może mieć – nomen omen – potworne skutki. Kiedy więc mała dziewczynka o imieniu Boo trafia przypadkiem do ich świata, wybucha prawdziwa panika. Mike i Sulley robią wszystko, by odesłać Boo z powrotem do domu. Niestety okazuje się, że jest to bardziej skomplikowane, niż przypuszczali…","popularity":35.1859,"poster_path":"/6Wm9FC1TuhD32hzogKik9rTbFZR.jpg","release_date":"2001-11-01","softcore":false,"video":false,"vote_average":7.856,"vote_count":20028,"credit_id":"52fe4256c3a36847f8016893","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","genre_ids":[10751,35,16,12],"id":862,"title":"Toy Story","original_language":"en","original_title":"Toy Story","overview":"W świecie zabawek Andy'ego, których niekwestionowanym liderem był dotychczas kowboj Chudy, pojawia się nowa zabawka - astronauta Buzz.","popularity":49.4793,"poster_path":"/23D1RbVL0ayMw1RzS3jnVzqivTd.jpg","release_date":"1995-11-22","softcore":false,"video":false,"vote_average":7.984,"vote_count":20263,"credit_id":"52fe4284c3a36847f8024f55","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/7iUDfakacY1HpajP1DtHrCuDB95.jpg","genre_ids":[16,35,10751],"id":863,"title":"Toy Story 2","original_language":"en","original_title":"Toy Story 2","overview":"Kontynuacja opowieści sprzed kilku lat, zrealizowanej techniką komputerową. Akcja toczy się w domu chłopca, jego zabawki żyją własnym życiem. Jedna z figurek, kowboj, zostaje uszkodzona. Przez przypadek kowboj trafia na wyprzedaż rzeczy używanych.","popularity":36.0552,"poster_path":"/156IFZshUqhYZLznowAd229QYkG.jpg","release_date":"1999-10-30","softcore":false,"video":false,"vote_average":7.618,"vote_count":15163,"credit_id":"52fe4284c3a36847f8025073","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/jQ6Vuxe1CEPMXTF7d0fZgdIBY8U.jpg","genre_ids":[16,35,10751,14],"id":2062,"title":"Ratatuj","original_language":"en","original_title":"Ratatouille","overview":"Remy marzy o karierze wielkiego kucharza. Dwie rzeczy stoją mu na przeszkodzie - niechętna rodzina i fakt, iż jest szczurem. Nasz bohater jednak się tym nie zraża i dzielnie dąży do realizacji celu. Zbieg okoliczności sprawia, że trafia on do kanałów mieszczących się dokładnie pod ekskluzywną paryską restauracją. Początkowo Remy nie jest w lokalu mile widziany, ale pasja gotowania bierze górę nad różnicami gatunkowymi. Wkrótce cały kulinarny światek zostaje wywrócony do góry nogami...","popularity":32.4428,"poster_path":"/v3otSJVt5jFZKhnlBGMoOfu2mo6.jpg","release_date":"2007-06-28","softcore":false,"video":false,"vote_average":7.845,"vote_count":18718,"credit_id":"52fe4331c3a36847f8041641","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/nYs4ZwnJBK4AgljhvzwNz7fpr3E.jpg","genre_ids":[16,10751,878],"id":10681,"title":"WALL-E","original_language":"en","original_title":"WALL·E","overview":"Co się stanie, jeżeli ludzie opuszczą kiedyś Ziemię i pozostanie na niej jedynie mały robot? WALL.E (Wysypiskowy Automat Likwidująco Lewarujący. E-klasa) przez siedemset lat w samotności oczyszcza Ziemię z odpadów pozostawionych przez ludzi. Pewnego dnia na planetę przybywa EVE – nowoczesna, przepiękna, myśląca maszyna. Tego dnia życie WALL.E’ego zupełnie się zmienia i nabiera nowego sensu. Jego podróż przez galaktykę, przyjaźń z EVE, zabawne przygody oraz nowi, niekiedy niezwykli przyjaciele stali się tematem najnowszej komedii Studia Pixar.","popularity":36.3037,"poster_path":"/hbhFnRzzg6ZDmm8YAmxBnQpQIPh.jpg","release_date":"2008-06-26","softcore":false,"video":false,"vote_average":8.118,"vote_count":20581,"credit_id":"52fe43a29251416c750180d1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/nYs4ZwnJBK4AgljhvzwNz7fpr3E.jpg","genre_ids":[16,10751,878],"id":10681,"title":"WALL-E","original_language":"en","original_title":"WALL·E","overview":"Co się stanie, jeżeli ludzie opuszczą kiedyś Ziemię i pozostanie na niej jedynie mały robot? WALL.E (Wysypiskowy Automat Likwidująco Lewarujący. E-klasa) przez siedemset lat w samotności oczyszcza Ziemię z odpadów pozostawionych przez ludzi. Pewnego dnia na planetę przybywa EVE – nowoczesna, przepiękna, myśląca maszyna. Tego dnia życie WALL.E’ego zupełnie się zmienia i nabiera nowego sensu. Jego podróż przez galaktykę, przyjaźń z EVE, zabawne przygody oraz nowi, niekiedy niezwykli przyjaciele stali się tematem najnowszej komedii Studia Pixar.","popularity":36.3037,"poster_path":"/hbhFnRzzg6ZDmm8YAmxBnQpQIPh.jpg","release_date":"2008-06-26","softcore":false,"video":false,"vote_average":8.118,"vote_count":20581,"credit_id":"52fe43a29251416c75018101","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/hwwFyowfcbLRVmRBOkvnABBNIOs.jpg","genre_ids":[12,16,35,10751],"id":9487,"title":"Dawno temu w trawie","original_language":"en","original_title":"A Bug's Life","overview":"\"Dawno temu w trawie\" to nowy film wytwórni Walta Disneya. Bohaterami tej opowieści są mrówki, koniki polne i wiele różnych owadów żyjących w gęstwinie traw. Mróweczki, które mieszkają na Mrówczej Wyspie, mają wiele problemów z gangiem koników polnych kierowanych przez bezwzględnego Hoppera. Co roku pracowite owady muszą oddawać część swoich zbiorów rabusiom. Mrówka Flik próbuje za wszelką cenę znaleźć wyjście z tej trudnej sytuacji i raz na zawsze pozbyć się złoczyńców. Flik zjednuje sobie przyjaciół w wędrownej grupie artystów, którzy są gotowi pomóc w walce ze złem.","popularity":21.2531,"poster_path":"/okpV31KV57FfXJglyiHMmOGmOOW.jpg","release_date":"1998-11-25","softcore":false,"video":false,"vote_average":6.982,"vote_count":9828,"credit_id":"52fe44fec3a36847f80b64e5","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/gaLg3gpoJScDNfkDw4itX79Gi8x.jpg","genre_ids":[16,10751,35,878],"id":13413,"title":"BURN·E","original_language":"en","original_title":"BURN·E","overview":"Pamiętacie małego robocika spawalniczego z Wall-E? Tego, który pracował na zewnątrz statku Axiom? Oto jego króciutkie przygody przy spawaniu uszkodzonej boi świetlnej. Jeśli myślicie, że robot nie może być uparty co do swojej pracy, zdanie zmienicie kiedy zobaczycie Burn-E.","popularity":3.5456,"poster_path":"/1wOReJq1vArLBSejND2Jbw0KeKh.jpg","release_date":"2008-11-17","softcore":false,"video":false,"vote_average":7.504,"vote_count":816,"credit_id":"52fe45669251416c750550f1","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/mIpCxBWNz6SHCQBe2K2PFr5MB7f.jpg","genre_ids":[16,10751,35,14],"id":62211,"title":"Uniwersytet Potworny","original_language":"en","original_title":"Monsters University","overview":"Ulubieńcy kinowej publiczności, James P. Sullivan i Mike Wazowski, powracają na duży ekran w filmie \"Uniwersytet Potworny\" - prequelu oscarowego hitu wytwórni Disney/Pixar \"Potwory i spółka\". Film przenosi widzów w czasy, kiedy Sulley i Mike - studenci Uniwersytetu Potwornego - dopiero zgłębiali tajniki potwornego fachu. Zabawne perypetie bohaterów z okresu studiów, wypełnionego szalonymi imprezami w akademiku, pokazują jak pomimo wielu dzielących ich różnic zostali najlepszymi przyjaciółmi. \"Uniwersytet Potworny\" to pełen humoru film o narodzinach prawdziwej przyjaźni.","popularity":14.5363,"poster_path":"/xdUuO71kbexJUucnOLV4n25dDTC.jpg","release_date":"2013-06-19","softcore":false,"video":false,"vote_average":7.055,"vote_count":11447,"credit_id":"52fe4675c3a368484e091e53","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/689yJyzzy6yGj359HrsT9KWyeWA.jpg","genre_ids":[28,12,878],"id":49529,"title":"John Carter","original_language":"en","original_title":"John Carter","overview":"John Carter (Taylor Kitsch) to młody weteran wojny secesyjnej, ciężko doświadczony walką na froncie. W niejasnych okolicznościach trafia na obcą planetę. Tam zostaje uwikłany w wielki konflikt między tubylcami, Tarsem Tarkasem (Willem Dafoe) i księżniczką Dejah Thoris (Lynn Collins), która desperacko potrzebuje jego pomocy. W świecie na skraju zagłady, Carter odzyskuje wiarę w siebie, i rozpoczyna walkę, od której zależy los Barsoom i jej mieszkańców.","popularity":14.7215,"poster_path":"/lCxz1Yus07QCQQCb6I0Dr3Lmqpx.jpg","release_date":"2012-03-07","softcore":false,"video":false,"vote_average":6.379,"vote_count":6196,"credit_id":"52fe479ac3a36847f813eaa3","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/689yJyzzy6yGj359HrsT9KWyeWA.jpg","genre_ids":[28,12,878],"id":49529,"title":"John Carter","original_language":"en","original_title":"John Carter","overview":"John Carter (Taylor Kitsch) to młody weteran wojny secesyjnej, ciężko doświadczony walką na froncie. W niejasnych okolicznościach trafia na obcą planetę. Tam zostaje uwikłany w wielki konflikt między tubylcami, Tarsem Tarkasem (Willem Dafoe) i księżniczką Dejah Thoris (Lynn Collins), która desperacko potrzebuje jego pomocy. W świecie na skraju zagłady, Carter odzyskuje wiarę w siebie, i rozpoczyna walkę, od której zależy los Barsoom i jej mieszkańców.","popularity":14.7215,"poster_path":"/lCxz1Yus07QCQQCb6I0Dr3Lmqpx.jpg","release_date":"2012-03-07","softcore":false,"video":false,"vote_average":6.379,"vote_count":6196,"credit_id":"52fe479ac3a36847f813ea65","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hwUxHPkuUleJeoick4uZsrKDXxF.jpg","genre_ids":[16,878,10751,12],"id":718789,"title":"Buzz Astral","original_language":"en","original_title":"Lightyear","overview":"Animowany film przygodowy science-fiction przedstawiający początki Buzza Astrala, bohatera, który zainspirował powstanie sławnej figurki. \"Buzz Astral\" śledzi losy legendarnego strażnika kosmosu, który wraz z komandor i załogą trafia na wrogą planetę odległą 4,2 mln lat świetlnych od Ziemi. Buzz próbuje odnaleźć drogę powrotną w przestrzeni i czasie, a towarzyszy mu grupa ambitnych rekrutów oraz uroczy robot-kot Kotex. Sytuację komplikuje przybycie Zurga, który zagraża powodzeniu misji. Nie są znane jego zamiary, lecz towarzyszy mu armia bezlitosnych robotów.","popularity":10.7618,"poster_path":"/vWo7Z3zNOANQujHTrAGATmi60LQ.jpg","release_date":"2022-06-15","softcore":false,"video":false,"vote_average":6.865,"vote_count":3878,"credit_id":"6261c03a992fe600a06923cc","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/wijltj1toRcicHlCn8Cpsp4yPXe.jpg","genre_ids":[12,16,10751],"id":127380,"title":"Gdzie jest Dory","original_language":"en","original_title":"Finding Dory","overview":"Dory jest uroczą rybką, którą cierpi na pewną przypadłość - brak pamięci krótkotrwałej. Gdy była mała, kochający rodzice z całych sił starali się ustrzec ją przed niebezpieczeństwem. Pewnego dnia jednak Dory wpadła w prąd oceaniczny, który porwał ją w nieznane. Teraz próbuje przypomnieć sobie swoją przeszłość i odnaleźć rodziców. Wyrusza do Kalifornii, a pomagają jej w tym przyjaciele: błazenek Marlin i jego synek Nemo, zgryźliwa ośmiornica Hank, narwalowaty Bailey, przekonany o tym, że cierpi na zaburzenia echolokacji, i Nadzieja, rekin wielorybi z wadą wzroku.","popularity":13.2121,"poster_path":"/4dUrWFhJKnMOCxlo9Hgy2Z4mmGr.jpg","release_date":"2016-06-16","softcore":false,"video":false,"vote_average":7.042,"vote_count":12759,"credit_id":"52fe4af8c3a368484e1707a7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genre_ids":[16,12],"id":148950,"title":"A Story","original_language":"en","original_title":"A Story","overview":"","popularity":0.6873,"poster_path":"/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","release_date":"1987-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":24,"credit_id":"52fe4bdb9251416c75110221","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/nH3PszZ0ZavXrlx5hjwrzK7vE4B.jpg","genre_ids":[16],"id":209681,"title":"Somewhere in the Arctic...","original_language":"en","original_title":"Somewhere in the Arctic...","overview":"","popularity":0.9394,"poster_path":"/6PUOVv8kj417IB9cBGnfWld6gXI.jpg","release_date":"1986-06-25","softcore":false,"video":false,"vote_average":5.565,"vote_count":23,"credit_id":"52fe4d6ac3a368484e1e8133","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hrjLiSuPPj4rPPn13Aj9sgAzw.jpg","genre_ids":[12,16,35,10751],"id":213121,"title":"Toy Story: Horror!","original_language":"en","original_title":"Toy Story of Terror!","overview":"Zabawki wyruszają w podróż z nową właścicielką. Niespodziewany incydent zmusza wszystkich do nocowania w przydrożnym motelu. Gdy jedna z zabawek znika, inne zaczynają jej szukać, co powoduje serię tajemniczych i przerażających wydarzeń. Ich przyczyna musi być jak najszybciej wyjaśniona, gdyż grupa zmniejsza się z każdą chwilą.","popularity":0.2973,"poster_path":"/oPBEnNP4Fg4gv9c0KBhchmtoG4H.jpg","release_date":"2013-10-16","softcore":false,"video":false,"vote_average":7.234,"vote_count":1041,"credit_id":"53e0126a0e0a265a860055c5","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","genre_ids":[10751,35,16,12],"id":862,"title":"Toy Story","original_language":"en","original_title":"Toy Story","overview":"W świecie zabawek Andy'ego, których niekwestionowanym liderem był dotychczas kowboj Chudy, pojawia się nowa zabawka - astronauta Buzz.","popularity":49.4793,"poster_path":"/23D1RbVL0ayMw1RzS3jnVzqivTd.jpg","release_date":"1995-11-22","softcore":false,"video":false,"vote_average":7.984,"vote_count":20263,"credit_id":"617c69725aba3200439f4f90","department":"Art","job":"Storyboard Artist"},{"adult":false,"backdrop_path":null,"genre_ids":[10749,35],"id":759081,"title":"Revolver","original_language":"en","original_title":"Revolver","overview":"","popularity":1.0043,"poster_path":"/jYiQ1nzBOhOyTy6Ybb6YybuToza.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"63181872f6fd180098851d70","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uM5i623wwNfoGD97iwwQWQ7GlZL.jpg","genre_ids":[878,18],"id":1032892,"title":"W okamgnieniu","original_language":"en","original_title":"In the Blink of an Eye","overview":"Trzy historie, obejmujące tysiące lat, przeplatają się i tworzą opowieść o nadziei, więzi i cyklu życia.","popularity":6.8115,"poster_path":"/fT5smsfEg6rTExIrb0B1Xasr1Lx.jpg","release_date":"2026-01-26","softcore":false,"video":false,"vote_average":5.743,"vote_count":144,"credit_id":"634093c4d34eb3007e7990a4","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/o3i6AfTcWAuNvzAUV3q5lOmi6Gx.jpg","genre_ids":[16,10751,12,18,35],"id":150540,"title":"W głowie się nie mieści","original_language":"en","original_title":"Inside Out","overview":"Najnowsza produkcja studia Disney/Pixar zabierze was w szaloną podróż w głąb umysłu. W Centrum dowodzenia, znajdującym się w głowie 11-letniej Riley, praca wre w najlepsze. Dziewczynką kieruje 5 pracujących w pocie czoła emocji pod dowództwem optymistycznej Radości, która robi wszystko, by Riley pozostała szczęśliwa. Nie jest to jednak łatwe, kiedy współpracownikami w tym emocjonalnym fachu są Strach, Złość, Odraza i Smutek.","popularity":29.8516,"poster_path":"/hf0z2LV69XedGf2RAGfOtgLaIo.jpg","release_date":"2015-06-17","softcore":false,"video":false,"vote_average":7.907,"vote_count":23689,"credit_id":"56098866c3a368681000003a","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/tL7piqWkq8vdmZ83kREf3KRnB3Y.jpg","genre_ids":[16,10751,35],"id":13042,"title":"Presto","original_language":"en","original_title":"Presto","overview":"Słodki i głodny królik, należący do magika, zrobi wszystko, by zdobyć wymarzoną marchewkę.","popularity":2.3508,"poster_path":"/aKDwLqR0JWoLX7dgwje42vCwhBd.jpg","release_date":"2008-06-27","softcore":false,"video":false,"vote_average":7.797,"vote_count":1090,"credit_id":"56155646c3a368681401e131","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/wijltj1toRcicHlCn8Cpsp4yPXe.jpg","genre_ids":[12,16,10751],"id":127380,"title":"Gdzie jest Dory","original_language":"en","original_title":"Finding Dory","overview":"Dory jest uroczą rybką, którą cierpi na pewną przypadłość - brak pamięci krótkotrwałej. Gdy była mała, kochający rodzice z całych sił starali się ustrzec ją przed niebezpieczeństwem. Pewnego dnia jednak Dory wpadła w prąd oceaniczny, który porwał ją w nieznane. Teraz próbuje przypomnieć sobie swoją przeszłość i odnaleźć rodziców. Wyrusza do Kalifornii, a pomagają jej w tym przyjaciele: błazenek Marlin i jego synek Nemo, zgryźliwa ośmiornica Hank, narwalowaty Bailey, przekonany o tym, że cierpi na zaburzenia echolokacji, i Nadzieja, rekin wielorybi z wadą wzroku.","popularity":13.2121,"poster_path":"/4dUrWFhJKnMOCxlo9Hgy2Z4mmGr.jpg","release_date":"2016-06-16","softcore":false,"video":false,"vote_average":7.042,"vote_count":12759,"credit_id":"55eb2fbb92514106d60041ab","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/q62bpQ67qaXY0u6b2wFEnQYIbPd.jpg","genre_ids":[10751,35,16,12],"id":301528,"title":"Toy Story 4","original_language":"en","original_title":"Toy Story 4","overview":"Chudy zawsze znał swoje miejsce na świecie. Jego życie, jak na prawdziwego szeryfa przystało, kręciło się wokół opieki nad Andym, a później Bonni. Gdy pewnego dnia w pokoju Bonni pojawia się nowa zabawka, Sztuciek, nikt nawet nie przypuszcza, że to początek zaskakującej podróży. Nieoczekiwana wyprawa pozwoli Chudemu przekonać się, jak wielki może być świat dla zwykłej zabawki…","popularity":31.8972,"poster_path":"/fT9rBJqGFTgKVCPFS113pBqqMrT.jpg","release_date":"2019-06-19","softcore":false,"video":false,"vote_average":7.464,"vote_count":10812,"credit_id":"634db4d2af58cb00986e147c","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/hGGC9gKo7CFE3fW07RA587e5kol.jpg","genre_ids":[16,35,10751,12],"id":14160,"title":"Odlot","original_language":"en","original_title":"Up","overview":"Pewnego dnia Carl Fredricksen postanawia zrealizować marzenie swego życia i wyrusza w podróż do tajemniczej krainy w Ameryce Południowej. Nie byłoby w tym nic dziwnego, gdyby nie fakt, że Carl podróżuje we własnym domu unoszonym przez setki balonów, a w wyprawie przypadkowo towarzyszy mu pewien ośmiolatek. Jednak prawdziwe przygody zaczynają się dopiero po dotarciu na miejsce, gdzie dwóch podróżników spotyka dziwacznego ptaka i mówiącego ludzkim głosem psa.","popularity":25.8963,"poster_path":"/j7SZNJiHi8tKPfuit1NLEBJUfeB.jpg","release_date":"2009-05-28","softcore":false,"video":false,"vote_average":7.961,"vote_count":21894,"credit_id":"5683b5f8c3a3684be90168e1","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/gaLg3gpoJScDNfkDw4itX79Gi8x.jpg","genre_ids":[16,10751,35,878],"id":13413,"title":"BURN·E","original_language":"en","original_title":"BURN·E","overview":"Pamiętacie małego robocika spawalniczego z Wall-E? Tego, który pracował na zewnątrz statku Axiom? Oto jego króciutkie przygody przy spawaniu uszkodzonej boi świetlnej. Jeśli myślicie, że robot nie może być uparty co do swojej pracy, zdanie zmienicie kiedy zobaczycie Burn-E.","popularity":3.5456,"poster_path":"/1wOReJq1vArLBSejND2Jbw0KeKh.jpg","release_date":"2008-11-17","softcore":false,"video":false,"vote_average":7.504,"vote_count":816,"credit_id":"61e88611b513a80044039fc4","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/sidvlo7V8VMyskNKGwua0Tarbol.jpg","genre_ids":[16,10751,14,12,878,28],"id":961323,"title":"Nimona","original_language":"en","original_title":"Nimona","overview":"Rycerz wplątany w tragiczną zbrodnię łączy siły z waleczną zmiennokształtną nastolatką, aby oczyścić swoje imię. Ale co jeśli to ona jest potworem, którego ma zgładzić?","popularity":5.4792,"poster_path":"/2NQljeavtfl22207D1kxLpa4LS3.jpg","release_date":"2023-06-23","softcore":false,"video":false,"vote_average":7.855,"vote_count":1450,"credit_id":"65a21454297338012112c326","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/dkQL7x7rCSVhEovq5zxq8WWC8T3.jpg","genre_ids":[16],"id":877268,"title":"WALL·E's Treasures & Trinkets","original_language":"en","original_title":"WALL·E's Treasures & Trinkets","overview":"","popularity":1.0469,"poster_path":"/pJfm3EggGLZToce08Obf7HQHXrP.jpg","release_date":"2008-11-18","softcore":false,"video":true,"vote_average":6.4,"vote_count":5,"credit_id":"638a27495690b50095f5478c","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8FQ0QCoyGHpPXRTsv2jaSqV5NRs.jpg","genre_ids":[16,10751,35,14],"id":24480,"title":"Zaburzenie częściowe","original_language":"en","original_title":"Partly Cloudy","overview":"Skąd się biorą dzieci? To logiczne, że przynoszą je bociany, ale właściwie to skąd je biorą. Według krótkometrażowego filmu Pixar maluchy tworzą chmury. Każda z nich ma własnego bociana, za którego pośrednictwem posyła niemowlaka do rodziców. Jeden z nich, Peck, ma bardzo niefortunnego kompana. Jego chmura robi same niebezpieczne i trudne do dostarczenia niemowlaki. Ale czego się nie robi dla przyjaciół...","popularity":3.5529,"poster_path":"/oqYX2AJV53ibLVPrUZ1Z5XlGv5U.jpg","release_date":"2009-05-28","softcore":false,"video":false,"vote_average":7.743,"vote_count":1119,"credit_id":"5723fb5ac3a368222d0007be","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/3nqjJeI5XVxWayIgoYzrDUCdBZA.jpg","genre_ids":[16,35,10751],"id":13929,"title":"Gra Geriego","original_language":"en","original_title":"Geri's Game","overview":"„Gra Geriego” to krótka animowana opowieść z wytwórni Pixar. Geri to staruszek, który wolny czas spędza w parku grając w szachy przeciwko samemu sobie. Rozgrywka polega na ciągłym zmienianiu miejsc po obu stronach szachownicy oraz zdejmowaniu i wkładaniu okularów, dzięki czemu wydaje się, że przeciwko sobie gra dwóch staruszków. Gra z czasem nabiera tempa, akcja staje się coraz bardziej dynamiczna i intensywna, gdyż toczy się o „cenne” trofeum…","popularity":3.6265,"poster_path":"/ofE3ejaNoQiUoDtTsJ4eW4RjQs3.jpg","release_date":"1997-11-24","softcore":false,"video":false,"vote_average":7.635,"vote_count":1235,"credit_id":"572cca3b9251416601000468","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/wijltj1toRcicHlCn8Cpsp4yPXe.jpg","genre_ids":[12,16,10751],"id":127380,"title":"Gdzie jest Dory","original_language":"en","original_title":"Finding Dory","overview":"Dory jest uroczą rybką, którą cierpi na pewną przypadłość - brak pamięci krótkotrwałej. Gdy była mała, kochający rodzice z całych sił starali się ustrzec ją przed niebezpieczeństwem. Pewnego dnia jednak Dory wpadła w prąd oceaniczny, który porwał ją w nieznane. Teraz próbuje przypomnieć sobie swoją przeszłość i odnaleźć rodziców. Wyrusza do Kalifornii, a pomagają jej w tym przyjaciele: błazenek Marlin i jego synek Nemo, zgryźliwa ośmiornica Hank, narwalowaty Bailey, przekonany o tym, że cierpi na zaburzenia echolokacji, i Nadzieja, rekin wielorybi z wadą wzroku.","popularity":13.2121,"poster_path":"/4dUrWFhJKnMOCxlo9Hgy2Z4mmGr.jpg","release_date":"2016-06-16","softcore":false,"video":false,"vote_average":7.042,"vote_count":12759,"credit_id":"576195bdc3a36856db000060","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/4GWYk5VP9qu1rNSeNAwNaBy9mwS.jpg","genre_ids":[10751,16],"id":399106,"title":"Pisklak","original_language":"en","original_title":"Piper","overview":"Głodne pisklę brodźca po raz pierwszy opuszcza gniazdo, by samodzielnie poszukać jedzenia na brzegu morza. Problem stanowi dla niego fakt, że pokarm zakopany jest w piasku, który co chwilę przykrywają groźne fale.","popularity":3.276,"poster_path":"/1DNndXCsZic0fUr5daoZiMpKWp7.jpg","release_date":"2016-06-16","softcore":false,"video":false,"vote_average":8.142,"vote_count":1753,"credit_id":"576b5ae6c3a36846c1001436","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","genre_ids":[10751,35,16,12],"id":862,"title":"Toy Story","original_language":"en","original_title":"Toy Story","overview":"W świecie zabawek Andy'ego, których niekwestionowanym liderem był dotychczas kowboj Chudy, pojawia się nowa zabawka - astronauta Buzz.","popularity":49.4793,"poster_path":"/23D1RbVL0ayMw1RzS3jnVzqivTd.jpg","release_date":"1995-11-22","softcore":false,"video":false,"vote_average":7.984,"vote_count":20263,"credit_id":"5892132b9251412dc80097b1","department":"Visual Effects","job":"Character Designer"},{"adult":false,"backdrop_path":"/39xYicJzAHHCICb23f9MaZuNwa7.jpg","genre_ids":[16,10751,35],"id":427004,"title":"Wywiad-ocean","original_language":"en","original_title":"Marine Life Interviews","overview":"Zwierzęta zamieszkujące Instytut Życia Morskiego opowiadają o Dory.","popularity":1.7446,"poster_path":"/nKTFsng12wXI75c84WFKnDHQ2Qa.jpg","release_date":"2016-11-15","softcore":false,"video":false,"vote_average":6.2,"vote_count":80,"credit_id":"58d231ad9251411a9f01b76a","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/39xYicJzAHHCICb23f9MaZuNwa7.jpg","genre_ids":[16,10751,35],"id":427004,"title":"Wywiad-ocean","original_language":"en","original_title":"Marine Life Interviews","overview":"Zwierzęta zamieszkujące Instytut Życia Morskiego opowiadają o Dory.","popularity":1.7446,"poster_path":"/nKTFsng12wXI75c84WFKnDHQ2Qa.jpg","release_date":"2016-11-15","softcore":false,"video":false,"vote_average":6.2,"vote_count":80,"credit_id":"58d231cd9251411ae801b55a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/49ILd5rNFwPBo2jv9UpWSwesNRa.jpg","genre_ids":[16,99,35],"id":296850,"title":"Exploring the Reef","original_language":"en","original_title":"Exploring the Reef","overview":"","popularity":1.048,"poster_path":"/lwH5KqAynqqnpIQK9g6B80ksAtU.jpg","release_date":"2003-11-04","softcore":false,"video":false,"vote_average":6.316,"vote_count":19,"credit_id":"644807cac51acd02fca94e86","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/uAfhsySkr1UzQg1zdg3dZQRz9Fd.jpg","genre_ids":[16,10751,35],"id":10193,"title":"Toy Story 3","original_language":"en","original_title":"Toy Story 3","overview":"Andy stał się już dużym chłopcem i wybiera się na studia. Pragnie zabrać wraz ze sobą swą ulubioną zabawkę z dzieciństwa Kowboja Chudego, a resztę jego podopiecznych mama chłopca postanawia oddać do miejskiego przedszkola. W obawie o los swoich przyjaciół Chudy postanawia ich nie opuszczać. W przedszkolu zabawki nawiązują nowe znajomości, oraz napotykają na niebezpieczeństwo ze strony niesfornych przedszkolaków. Od tej pory Chudy wraz z przyjaciółmi robią wszystko by się stamtąd wydostać i wrócić do domu.","popularity":34.6526,"poster_path":"/WW8MbtmHDZg1g9uW3OsS4jUoJw.jpg","release_date":"2010-06-16","softcore":false,"video":false,"vote_average":7.813,"vote_count":16005,"credit_id":"644dcaccd4d50904faf94980","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/qx9ts2hBYJrkIQxhryitxnLlm2u.jpg","genre_ids":[12,16,10751,14],"id":62177,"title":"Merida Waleczna","original_language":"en","original_title":"Brave","overview":"Doskonała łuczniczka Merida jest porywczą córką króla Fergusa i królowej Elinor. Niezależna i zdecydowana iść własną drogą, postępuje wbrew prastarym zwyczajom, narażając się na krytykę rodziców i dworu. Czyny księżniczki przypadkowo sprowadzają na królestwo chaos i zniszczenie. Merida musi się spieszyć, aby odwrócić skutki spowodowanych przez siebie zdarzeń. U kresu tej podróży ma odkryć znaczenie waleczności i swoje prawdziwe powołanie.","popularity":20.4305,"poster_path":"/s79T8R2LJo6XVlgOoIgoXfXaxSL.jpg","release_date":"2012-06-21","softcore":false,"video":false,"vote_average":7.033,"vote_count":14321,"credit_id":"5ab04a1f92514111c700062d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/8sSKdEmlmqF4kJUd28SqthXC4yZ.jpg","genre_ids":[16,10751,35,12],"id":1084244,"title":"Toy Story 5","original_language":"en","original_title":"Toy Story 5","overview":"Praca Buzza, Chudego, Jessie i reszty ekipy staje się wykładniczo trudniejsza, gdy mierzą się z zupełnie nowym zagrożeniem dla zabawy: technologią.","popularity":316.2019,"poster_path":"/1Yu8ILEVcUIVOPWJxGuPqgUdwD9.jpg","release_date":"2026-06-17","softcore":false,"video":false,"vote_average":7.413,"vote_count":756,"credit_id":"66648d31a10ad0e0fdd03968","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hwwFyowfcbLRVmRBOkvnABBNIOs.jpg","genre_ids":[12,16,35,10751],"id":9487,"title":"Dawno temu w trawie","original_language":"en","original_title":"A Bug's Life","overview":"\"Dawno temu w trawie\" to nowy film wytwórni Walta Disneya. Bohaterami tej opowieści są mrówki, koniki polne i wiele różnych owadów żyjących w gęstwinie traw. Mróweczki, które mieszkają na Mrówczej Wyspie, mają wiele problemów z gangiem koników polnych kierowanych przez bezwzględnego Hoppera. Co roku pracowite owady muszą oddawać część swoich zbiorów rabusiom. Mrówka Flik próbuje za wszelką cenę znaleźć wyjście z tej trudnej sytuacji i raz na zawsze pozbyć się złoczyńców. Flik zjednuje sobie przyjaciół w wędrownej grupie artystów, którzy są gotowi pomóc w walce ze złem.","popularity":21.2531,"poster_path":"/okpV31KV57FfXJglyiHMmOGmOOW.jpg","release_date":"1998-11-25","softcore":false,"video":false,"vote_average":6.982,"vote_count":9828,"credit_id":"6675d82c6288ee392bbf4720","department":"Directing","job":"Co-Director"},{"adult":false,"backdrop_path":"/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genre_ids":[16,12],"id":148950,"title":"A Story","original_language":"en","original_title":"A Story","overview":"","popularity":0.6873,"poster_path":"/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","release_date":"1987-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":24,"credit_id":"64bbc894e9da69012e0d9a84","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genre_ids":[16,12],"id":148950,"title":"A Story","original_language":"en","original_title":"A Story","overview":"","popularity":0.6873,"poster_path":"/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","release_date":"1987-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":24,"credit_id":"64bbc8adeb79c2011c24d765","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/5mNa6TxBzxB2lN7p4NyUYFjmMFm.jpg","genre_ids":[16,12],"id":148950,"title":"A Story","original_language":"en","original_title":"A Story","overview":"","popularity":0.6873,"poster_path":"/48L35oaTTXQrwVPdRs0St6bZ5Ql.jpg","release_date":"1987-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":24,"credit_id":"64bbc8cc85c0a200ad5fd6e7","department":"Visual Effects","job":"Animation"},{"adult":false,"backdrop_path":"/zjO1MfRvNyZUWYW11IUPxlWfqK.jpg","genre_ids":[16,10751],"id":287095,"title":"Light and Heavy","original_language":"en","original_title":"Light and Heavy","overview":"","popularity":1.0949,"poster_path":"/kC9tqPE3dqwBBp2sEL7xBgPP4yQ.jpg","release_date":"1991-05-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":30,"credit_id":"5c519ec4c3a368478c985d08","department":"Directing","job":"Co-Director"},{"adult":false,"backdrop_path":"/eLmjSkrPBMWe8E77CYj0q2XPGdU.jpg","genre_ids":[16,10751],"id":287096,"title":"Surprise","original_language":"en","original_title":"Surprise","overview":"","popularity":1.3709,"poster_path":"/oAlpMXHPC282pZ383cPrafOAO7z.jpg","release_date":"1991-09-01","softcore":false,"video":false,"vote_average":4.571,"vote_count":7,"credit_id":"5c519c5d9251415e34607abb","department":"Directing","job":"Co-Director"},{"adult":false,"backdrop_path":null,"genre_ids":[16,18],"id":590723,"title":"A Birthday","original_language":"en","original_title":"A Birthday","overview":"","popularity":0.6653,"poster_path":"/IZoCbPJH1V22NmQG5vTsoE4z6w.jpg","release_date":"1987-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5c9925aa9251416e8ff4cc52","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/q62bpQ67qaXY0u6b2wFEnQYIbPd.jpg","genre_ids":[10751,35,16,12],"id":301528,"title":"Toy Story 4","original_language":"en","original_title":"Toy Story 4","overview":"Chudy zawsze znał swoje miejsce na świecie. Jego życie, jak na prawdziwego szeryfa przystało, kręciło się wokół opieki nad Andym, a później Bonni. Gdy pewnego dnia w pokoju Bonni pojawia się nowa zabawka, Sztuciek, nikt nawet nie przypuszcza, że to początek zaskakującej podróży. Nieoczekiwana wyprawa pozwoli Chudemu przekonać się, jak wielki może być świat dla zwykłej zabawki…","popularity":31.8972,"poster_path":"/fT9rBJqGFTgKVCPFS113pBqqMrT.jpg","release_date":"2019-06-19","softcore":false,"video":false,"vote_average":7.464,"vote_count":10812,"credit_id":"5c916a200e0a2612f15c211e","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/q62bpQ67qaXY0u6b2wFEnQYIbPd.jpg","genre_ids":[10751,35,16,12],"id":301528,"title":"Toy Story 4","original_language":"en","original_title":"Toy Story 4","overview":"Chudy zawsze znał swoje miejsce na świecie. Jego życie, jak na prawdziwego szeryfa przystało, kręciło się wokół opieki nad Andym, a później Bonni. Gdy pewnego dnia w pokoju Bonni pojawia się nowa zabawka, Sztuciek, nikt nawet nie przypuszcza, że to początek zaskakującej podróży. Nieoczekiwana wyprawa pozwoli Chudemu przekonać się, jak wielki może być świat dla zwykłej zabawki…","popularity":31.8972,"poster_path":"/fT9rBJqGFTgKVCPFS113pBqqMrT.jpg","release_date":"2019-06-19","softcore":false,"video":false,"vote_average":7.464,"vote_count":10812,"credit_id":"5c9169970e0a2612ed5bac29","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":706352,"title":"Chairman Spaceman","original_language":"en","original_title":"Chairman Spaceman","overview":"","popularity":0.8099,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5ec495696c8492002028d7e0","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7cdsVkbs7tAuZJwJRYb65dN5kMv.jpg","genre_ids":[16,10751],"id":286192,"title":"Lawa","original_language":"en","original_title":"Lava","overview":"Historia samotnego wulkanu o imieniu Uku, który przez tysiące lat śpiewa piosenkę, marząc o miłości. Jego pragnienie zostaje spełnione, gdy z głębin oceanu wyłania się inny wulkan – Lele.","popularity":4.701,"poster_path":"/qmWdnFlFvAL8wyWVVwfGwPAfUe7.jpg","release_date":"2015-06-18","softcore":false,"video":false,"vote_average":7.249,"vote_count":1143,"credit_id":"5f2a1c882d8ef30035dc826c","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/cF3H9pyUF6dsvqlYUcH0TyBAMTG.jpg","genre_ids":[12,16,10751],"id":105864,"title":"Dobry dinozaur","original_language":"en","original_title":"The Good Dinosaur","overview":"Co by było, gdyby asteroida, której potężne uderzenie miliony lat temu doprowadziło do zagłady dinozaurów, jednak nie uderzyła w Ziemię? W alternatywnej historii, w której dinozaury nie wymarły, młody apatozaur Arlo wpada do rzeki i zostaje porwany przez jej nurt. Starając się znaleźć drogę powrotną do domu, zaprzyjaźnia się z małym jaskiniowcem o imieniu Bąbel.","popularity":14.7437,"poster_path":"/dErLxN7F3km3Ju8znUMtkGsgUW9.jpg","release_date":"2015-11-14","softcore":false,"video":false,"vote_average":6.748,"vote_count":6090,"credit_id":"5f224890df857c0038d7e481","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/qhXEPLkZuhMocgsK6782HWSMDsd.jpg","genre_ids":[16,10751,878,10749,12],"id":1365107,"title":"Pixar Remix: WALL·E in 16-Bit","original_language":"en","original_title":"Pixar Remix: WALL·E in 16-Bit","overview":"","popularity":0.9571,"poster_path":"/gRvuglH7eilP1WIoHMtyrRA4WrH.jpg","release_date":"2020-04-22","softcore":false,"video":true,"vote_average":10.0,"vote_count":1,"credit_id":"66fe5f78e84eeb35a0f7c712","department":"Writing","job":"Original Concept"},{"adult":false,"backdrop_path":"/qhXEPLkZuhMocgsK6782HWSMDsd.jpg","genre_ids":[16,10751,878,10749,12],"id":1365107,"title":"Pixar Remix: WALL·E in 16-Bit","original_language":"en","original_title":"Pixar Remix: WALL·E in 16-Bit","overview":"","popularity":0.9571,"poster_path":"/gRvuglH7eilP1WIoHMtyrRA4WrH.jpg","release_date":"2020-04-22","softcore":false,"video":true,"vote_average":10.0,"vote_count":1,"credit_id":"66fe6128e48014914684d873","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/3Rfvhy1Nl6sSGJwyjb0QiZzZYlB.jpg","genre_ids":[10751,35,16,12],"id":862,"title":"Toy Story","original_language":"en","original_title":"Toy Story","overview":"W świecie zabawek Andy'ego, których niekwestionowanym liderem był dotychczas kowboj Chudy, pojawia się nowa zabawka - astronauta Buzz.","popularity":49.4793,"poster_path":"/23D1RbVL0ayMw1RzS3jnVzqivTd.jpg","release_date":"1995-11-22","softcore":false,"video":false,"vote_average":7.984,"vote_count":20263,"credit_id":"67f9255ed81748ccff99a508","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/7iUDfakacY1HpajP1DtHrCuDB95.jpg","genre_ids":[16,35,10751],"id":863,"title":"Toy Story 2","original_language":"en","original_title":"Toy Story 2","overview":"Kontynuacja opowieści sprzed kilku lat, zrealizowanej techniką komputerową. Akcja toczy się w domu chłopca, jego zabawki żyją własnym życiem. Jedna z figurek, kowboj, zostaje uszkodzona. Przez przypadek kowboj trafia na wyprzedaż rzeczy używanych.","popularity":36.0552,"poster_path":"/156IFZshUqhYZLznowAd229QYkG.jpg","release_date":"1999-10-30","softcore":false,"video":false,"vote_average":7.618,"vote_count":15163,"credit_id":"67f925d01bc639566ada23fa","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/hwUxHPkuUleJeoick4uZsrKDXxF.jpg","genre_ids":[16,878,10751,12],"id":718789,"title":"Buzz Astral","original_language":"en","original_title":"Lightyear","overview":"Animowany film przygodowy science-fiction przedstawiający początki Buzza Astrala, bohatera, który zainspirował powstanie sławnej figurki. \"Buzz Astral\" śledzi losy legendarnego strażnika kosmosu, który wraz z komandor i załogą trafia na wrogą planetę odległą 4,2 mln lat świetlnych od Ziemi. Buzz próbuje odnaleźć drogę powrotną w przestrzeni i czasie, a towarzyszy mu grupa ambitnych rekrutów oraz uroczy robot-kot Kotex. Sytuację komplikuje przybycie Zurga, który zagraża powodzeniu misji. Nie są znane jego zamiary, lecz towarzyszy mu armia bezlitosnych robotów.","popularity":10.7618,"poster_path":"/vWo7Z3zNOANQujHTrAGATmi60LQ.jpg","release_date":"2022-06-15","softcore":false,"video":false,"vote_average":6.865,"vote_count":3878,"credit_id":"68b3a2476210a69fb1397709","department":"Crew","job":"Additional Writing"},{"adult":false,"backdrop_path":"/nYs4ZwnJBK4AgljhvzwNz7fpr3E.jpg","genre_ids":[16,10751,878],"id":10681,"title":"WALL-E","original_language":"en","original_title":"WALL·E","overview":"Co się stanie, jeżeli ludzie opuszczą kiedyś Ziemię i pozostanie na niej jedynie mały robot? WALL.E (Wysypiskowy Automat Likwidująco Lewarujący. E-klasa) przez siedemset lat w samotności oczyszcza Ziemię z odpadów pozostawionych przez ludzi. Pewnego dnia na planetę przybywa EVE – nowoczesna, przepiękna, myśląca maszyna. Tego dnia życie WALL.E’ego zupełnie się zmienia i nabiera nowego sensu. Jego podróż przez galaktykę, przyjaźń z EVE, zabawne przygody oraz nowi, niekiedy niezwykli przyjaciele stali się tematem najnowszej komedii Studia Pixar.","popularity":36.3037,"poster_path":"/hbhFnRzzg6ZDmm8YAmxBnQpQIPh.jpg","release_date":"2008-06-26","softcore":false,"video":false,"vote_average":8.118,"vote_count":20581,"credit_id":"691074221bfc2ab5fdce866e","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/eCynaAOgYYiw5yN5lBwz3IxqvaW.jpg","genre_ids":[16,10751,12],"id":12,"title":"Gdzie jest Nemo","original_language":"en","original_title":"Finding Nemo","overview":"Wielką Rafę Koralową zamieszkują kolorowe rybki zwane błazenkami. Jedną z nich o imieniu Marlin spotyka tragedia. Drapieżna ryba pożera mu żonę - Coral i prawie wszystkie jajeczka ikry, z których miały młode błazenki. Ocalał jedynie jeden mały błazenek o imieniu Nemo, który staje się oczkiem w głowie Marlina. Gdy jednak nadopiekuńczy ojciec postanawia wysyłać go do szkoły, zdarza się kolejne nieszczęście: mały błazenek zostaje wyłowiony z oceanu przez nurka i trafia do akwarium w gabinecie dentystycznym w Sydney. Merlin, który boi się głębi oceanu, postanawia wyruszyć na ratunek synkowi. W jego wyprawie towarzyszy mu inna rybka - Dora, która jest straszliwą zapominalską.","popularity":35.5124,"poster_path":"/81ULtY262mzmTR8PagVdNApcoHp.jpg","release_date":"2003-05-30","softcore":false,"video":false,"vote_average":7.821,"vote_count":20757,"credit_id":"697ffc37c592ca56cc1ebe1a","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/hwwFyowfcbLRVmRBOkvnABBNIOs.jpg","genre_ids":[12,16,35,10751],"id":9487,"title":"Dawno temu w trawie","original_language":"en","original_title":"A Bug's Life","overview":"\"Dawno temu w trawie\" to nowy film wytwórni Walta Disneya. Bohaterami tej opowieści są mrówki, koniki polne i wiele różnych owadów żyjących w gęstwinie traw. Mróweczki, które mieszkają na Mrówczej Wyspie, mają wiele problemów z gangiem koników polnych kierowanych przez bezwzględnego Hoppera. Co roku pracowite owady muszą oddawać część swoich zbiorów rabusiom. Mrówka Flik próbuje za wszelką cenę znaleźć wyjście z tej trudnej sytuacji i raz na zawsze pozbyć się złoczyńców. Flik zjednuje sobie przyjaciół w wędrownej grupie artystów, którzy są gotowi pomóc w walce ze złem.","popularity":21.2531,"poster_path":"/okpV31KV57FfXJglyiHMmOGmOOW.jpg","release_date":"1998-11-25","softcore":false,"video":false,"vote_average":6.982,"vote_count":9828,"credit_id":"699377c3949478aa346f713f","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/8sSKdEmlmqF4kJUd28SqthXC4yZ.jpg","genre_ids":[16,10751,35,12],"id":1084244,"title":"Toy Story 5","original_language":"en","original_title":"Toy Story 5","overview":"Praca Buzza, Chudego, Jessie i reszty ekipy staje się wykładniczo trudniejsza, gdy mierzą się z zupełnie nowym zagrożeniem dla zabawy: technologią.","popularity":316.2019,"poster_path":"/1Yu8ILEVcUIVOPWJxGuPqgUdwD9.jpg","release_date":"2026-06-17","softcore":false,"video":false,"vote_average":7.413,"vote_count":756,"credit_id":"6997517a6e9eff2880a72621","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/8sSKdEmlmqF4kJUd28SqthXC4yZ.jpg","genre_ids":[16,10751,35,12],"id":1084244,"title":"Toy Story 5","original_language":"en","original_title":"Toy Story 5","overview":"Praca Buzza, Chudego, Jessie i reszty ekipy staje się wykładniczo trudniejsza, gdy mierzą się z zupełnie nowym zagrożeniem dla zabawy: technologią.","popularity":316.2019,"poster_path":"/1Yu8ILEVcUIVOPWJxGuPqgUdwD9.jpg","release_date":"2026-06-17","softcore":false,"video":false,"vote_average":7.413,"vote_count":756,"credit_id":"6a304fef9e447e4dc4f6fdd7","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":null,"genre_ids":[16,10751],"id":1680650,"title":"Loving Dory","original_language":"en","original_title":"Loving Dory","overview":"","popularity":1.5997,"poster_path":"/ew56ndWFPG2VdVmbd2Dsi2mZhuv.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6a541dfd41a6559e81b64e39","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[16,14,35,10751],"id":1647601,"title":"Monsters, Inc. 3","original_language":"en","original_title":"Monsters, Inc. 3","overview":"","popularity":0.6346,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6a67ed0ba55768ef4f0ffb7a","department":"Production","job":"Executive Producer"}],"id":7}