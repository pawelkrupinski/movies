a (Hala Finley).","popularity":2.9129,"poster_path":"/kNefKe2STdVUd2w644qg72WfE47.jpg","release_date":"2022-07-29","softcore":false,"video":false,"vote_average":5.876,"vote_count":210,"credit_id":"6678b235185d244030235a8c","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":491434,"title":"Brukerstøtte","original_language":"no","original_title":"Brukerstøtte","overview":"","popularity":3.1301,"poster_path":"/1R2pzP8fZn31IgKHqMSTIFtER3f.jpg","release_date":"2009-02-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6678b4fb5cafacbc073b2db2","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[28],"id":1308273,"title":"3AM Eternal","original_language":"en","original_title":"3AM Eternal","overview":"","popularity":1.2328,"poster_path":"/9lj1mYLQJNZU3HJ4WD9ya9AoksM.jpg","release_date":"2001-04-10","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"6678b89db51c8835953b2751","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18,28,14],"id":491433,"title":"Future Murder","original_language":"en","original_title":"Future Murder","overview":"","popularity":1.3709,"poster_path":"/ujmayV6ZTSVNf2uAd8jI7vHV9nn.jpg","release_date":"2000-08-15","softcore":false,"video":false,"vote_average":7.333,"vote_count":3,"credit_id":"5c62d032c3a3684fa4d8530b","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18,28,14],"id":491433,"title":"Future Murder","original_language":"en","original_title":"Future Murder","overview":"","popularity":1.3709,"poster_path":"/ujmayV6ZTSVNf2uAd8jI7vHV9nn.jpg","release_date":"2000-08-15","softcore":false,"video":false,"vote_average":7.333,"vote_count":3,"credit_id":"5c62d0759251412fbffc9241","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/dKC5qWi6S8SKkSzrP6LxTk0cb98.jpg","genre_ids":[27,14],"id":635910,"title":"Demeter: Przebudzenie zła","original_language":"en","original_title":"The Last Voyage of the Demeter","overview":"Film, który został oparty na jednym, mrożącym krew w żyłach rozdziale z klasycznej powieści Brama Stokera pt.: Drakula. Opowiada przerażającą historię statku handlowego Demeter, który przewozi z Karpat do Londynu prywatny ładunek – pięćdziesiąt nieoznakowanych drewnianych skrzyń. Podczas podróży dochodzi do dziwnych wydarzeń.","popularity":6.6914,"poster_path":"/afkkYkxWVlotAR0jCccTrsfGvaq.jpg","release_date":"2023-08-09","softcore":false,"video":false,"vote_average":6.735,"vote_count":1993,"credit_id":"5d93ca4d87ae7b0014a3130e","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[878],"id":782521,"title":"Bright Skies","original_language":"no","original_title":"Bright Skies","overview":"","popularity":0.6699,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5ff1b1abd2f5b500402d24c4","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[878],"id":782521,"title":"Bright Skies","original_language":"no","original_title":"Bright Skies","overview":"","popularity":0.6699,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5ff1b1b1156cc7003def8e14","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/3pDfu71mrzSuFYyIfnKEjt8z4BC.jpg","genre_ids":[27,53],"id":1368314,"title":"Pasażer","original_language":"en","original_title":"Passenger","overview":"Gdy młoda para jest świadkiem makabrycznego wypadku na autostradzie, szybko uświadamia sobie, że nie opuściła miejsca zdarzenia sama – demoniczny byt zwany Pasażerem, który nie spocznie, dopóki nie dopadnie ich obojga, zamienia ich podróż vanem w koszmar.","popularity":44.8123,"poster_path":"/w0VzFUvdSyvKpGnGRgEGul2y0IO.jpg","release_date":"2026-05-20","softcore":false,"video":false,"vote_average":7.31