{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1153534,"title":"Mur i wieża","original_language":"pl","original_title":"Mur i wieża","overview":"Praca jest rozwinięciem jej wcześniejszego filmu Mary Koszmary z 2007 roku.","popularity":0.7557,"poster_path":null,"release_date":"2009-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"64b6cb5dac416100c533468e","order":4},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":784946,"title":"Stroje w PRL","original_language":"en","original_title":"Political Dress","overview":"","popularity":1.866,"poster_path":"/gDnyPPUoyVquavYos2fuPY1HyBf.jpg","release_date":"2011-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6858eea4f47ff80fd44bd476","order":14},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1210070,"title":"Ile za sztukę?","original_language":"pl","original_title":"Ile za sztukę?","overview":"Sztuka, aukcje, ogromne wyceny poszczególnych dzieł, enigmatyczny rynek. Niedostępność świata sztuki i jej niezrozumiałe dla wielu mechanizmy biznesowe od zawsze działają na wyobraźnię. Jednak niesamowity wzrost zainteresowania kupnem dzieł w sztuki w Polsce w ostatnich kilku latach spowodował, że kurtyna mistycyzmu musi powoli opadać. Film jest spojrzeniem na polski rynek sztuki, który wraz z transformacją ustrojową przemienił się z marginalnego i przaśnego kuriozum w nowoczesną, profesjonalną maszynę, otwierającą niektórym artystom najmłodszego pokolenia wrota sukcesu niedostępne dla ich poprzedników.","popularity":0.5483,"poster_path":"/cNpWNCsxukqwpcje1hk5VKeIkc0.jpg","release_date":"2023-05-17","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"69a9adb4aa82cb6345ec61a7","order":0}],"crew":[{"adult":false,"backdrop_path":"/oC4EFoE7nlzjUHDBbZj6ZfXFX5g.jpg","genre_ids":[18],"id":121207,"title":"Z daleka widok jest piękny","original_language":"pl","original_title":"Z daleka widok jest piękny","overview":"Paweł mieszka ze schorowaną matką. Mężczyzna zdobywa środki na utrzymanie, zbierając złom. W końcu Paweł postanawia zawieźć matkę do domu starców. Snuje plany wymarzonego życia z narzeczoną. Pewnego dnia Paweł nie wraca do domu. Jego tajemnicze zniknięcie nikogo nie obchodzi, a sąsiedzi wykorzystują sytuację i rozkradają dobytek Pawła.","popularity":1.6065,"poster_path":"/ebJ8WMZSRgc86wKvQ6PJIivRLh2.jpg","release_date":"2012-02-10","softcore":false,"video":false,"vote_average":4.8,"vote_count":10,"credit_id":"52fe4a5dc3a368484e14f1fd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/51VTd88GSIyozHniytn8oDem3Ai.jpg","genre_ids":[18],"id":295057,"title":"Huba","original_language":"pl","original_title":"Huba","overview":"Do maleńkiego domku emerytowanego robotnika wprowadza się jego córka z dzieckiem, co diametralnie zmienia relacje między nimi.","popularity":1.0456,"poster_path":"/4u0Ye1NGoojPNj2Y9FV5fvBtfTz.jpg","release_date":"2014-02-12","softcore":false,"video":false,"vote_average":3.6,"vote_count":5,"credit_id":"5424b0d30e0a263b770046ef","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1012721,"title":"Mojave","original_language":"en","original_title":"Mojave","overview":"","popularity":0.2413,"poster_path":"/rXfDTa0BIGl4q1qp29xnjEv6ooa.jpg","release_date":"2006-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"62f94d4e1cac8c00860dd1b6","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1012728,"title":"Concorde","original_language":"en","original_title":"Concorde","overview":"","popularity":0.266,"poster_path":"/aWGhvbhQsk4ElnDM970hps8jwi5.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"62f9509de323f30080d105b3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genr