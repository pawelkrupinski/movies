ate":"2021-12-16","softcore":false,"video":false,"vote_average":9.5,"vote_count":1,"character":"Self (archive footage)","credit_id":"63a7bede0f21c600a299b442","order":8},{"adult":false,"backdrop_path":"/4T5d7KGrpx3BTDq9IKm6KpMeeNp.jpg","genre_ids":[18],"id":179144,"title":"Wielkie piękno","original_language":"it","original_title":"La grande bellezza","overview":"Jep Gamberdella – przystojny, czarujący mężczyzna – pomimo pierwszych oznak starzenia się w pełni korzysta z miejskiego życia. Chodzi na szykowne kolacje i przyjęcia, gdzie jego bystry dowcip i przyjemne towarzystwo są zawsze mile widziane. Na tarasie jego rzymskiego apartamentu z widokiem na Koloseum, wydaje przyjęcia, na których \"ludzka aparatura\" rozbierana jest do naga i gdzie rozgrywana jest komedia nicości.","popularity":4.7001,"poster_path":"/lH1muJBfCP4vRZoWdsuswFoGzpH.jpg","release_date":"2013-05-21","softcore":false,"video":false,"vote_average":7.503,"vote_count":3338,"character":"Comparsa","credit_id":"664b623de2ea0743a41dd19b","order":64},{"adult":false,"backdrop_path":"/bh4Do65RWaQlGtSZb9U8Gbqd0kS.jpg","genre_ids":[18],"id":302802,"title":"Tre tocchi","original_language":"it","original_title":"Tre tocchi","overview":"","popularity":0.737,"poster_path":"/89keDg3jpco3QUlTDHwqjSDv6jI.jpg","release_date":"2014-11-13","softcore":false,"video":false,"vote_average":4.292,"vote_count":12,"character":"se stesso","credit_id":"599da29ec3a368282c01e2d3","order":16},{"adult":false,"backdrop_path":"/7QRtDFcWyTVKdok5w8Tw628YdNf.jpg","genre_ids":[35,18],"id":56400,"title":"Questione di cuore","original_language":"it","original_title":"Questione di cuore","overview":"","popularity":0.9035,"poster_path":"/sfXCK7vnx1a1g34Q9ChoAfIXuk5.jpg","release_date":"2009-04-17","softcore":false,"video":false,"vote_average":5.994,"vote_count":90,"character":"se stesso","credit_id":"59c19d2d9251417691000104","order":15},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":518923,"title":"I nostri trent'anni - Generazioni