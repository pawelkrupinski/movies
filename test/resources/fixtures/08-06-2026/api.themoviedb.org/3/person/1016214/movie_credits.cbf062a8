no-wschodnie wybrzeże Brazylii. Tamara cieszy się ostatnimi tygodniami w wiosce rybackiej, w której mieszka przed wyjazdem na studia do Brasilii. Pewnego dnia słyszy o nastolatce, której nadano przydomek Heartless (Bez serca) po bliźnie na klatce piersiowej. Z biegiem lata Tamara czuje coraz większą sympatię dla tej tajemniczej dziewczyny.","popularity":1.177,"poster_path":"/amLvxUbFd0Kp7CsXuYMpqITMlBM.jpg","release_date":"2024-04-18","softcore":false,"video":false,"vote_average":7.0,"vote_count":25,"credit_id":"64f5da7312197e00c4492782","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/fz4wnEWbY3V137tlk9T1NbX1xkD.jpg","genre_ids":[99],"id":1112548,"title":"Retratos Fantasmas","original_language":"pt","original_title":"Retratos Fantasmas","overview":"","popularity":0.9636,"poster_path":"/bmscUBnrI9KrwdxdmvpOYAo8dBp.jpg","release_date":"2023-08-24","softcore":false,"video":false,"vote_average":8.1,"vote_count":66,"credit_id":"650636df5aadc400e4011fc8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":254532,"title":"A Menina do Algodão","original_language":"pt","original_title":"A Menina do Algodão","overview":"","popularity":1.2402,"poster_path":"/wixIaUeYIHUPlowOgJIHVWplxrR.jpg","release_date":"2002-01-01","softcore":false,"video":false,"vote_average":4.0,"vote_count":4,"credit_id":"52fe4ec19251416c9113ca7d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/5P6bxHZDRzDMKQPW8qjifHC8c9A.jpg","genre_ids":[35,18],"id":236881,"title":"Eletrodoméstica","original_language":"pt","original_title":"Eletrodoméstica","overview":"","popularity":0.7153,"poster_path":"/mwzouXmKx5JGzotYwS7Mbat01xT.jpg","release_date":"2005-08-25","softcore":false,"video":false,"vote_average":6.425,"vote_count":20,"credit_id":"52fe4e62c3a36847f828d503","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ir3UTXwegDuorLW0qslcNhRMLR6.jpg","genre_ids":[18,10749],"id":236886,"title