rector"},{"adult":false,"backdrop_path":null,"genre_ids":[28],"id":1446530,"title":"Bułgarski pocisk","original_language":"pl","original_title":"Bułgarski pościkk","overview":"Jak powstrzymać młode pokolenie przed popadnięciem w uzależnienia, jak ochronić ich młodość i zdrowie? Do akcji wkracza Bulgarska Milicja, brawurowo rozprawiając się z nielegalnym procederem. Pamiętaj! Zażywasz - przegrywasz. Ale jeśli nie zażywasz, to możesz spać spokojnie. Dzięki nim. Tym jeziorom.","popularity":0.9025,"poster_path":null,"release_date":"1999-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"67d023eb86fea60ab81dea10","department":"Sound","job":"Music"},{"adult":false,"backdrop_path":"/bMQz3mTfUBhyPqUDKcV4XVQKQcN.jpg","genre_ids":[16,35,14],"id":1407798,"title":"Bogdan Boner: Wigilijny karp","original_language":"pl","original_title":"Bogdan Boner: Wigilijny karp","overview":"Nadszedł ten wesoły dzień, w którym Bogdan Boner i jego przyjaciele gromadzą się wspólnie, aby wysłuchać świątecznej opowieści o morderczym karpiu i jego drodze na stół.","popularity":0.774,"poster_path":"/cjRIGGDcbmCbE6rdy14gfhdyMyp.jpg","release_date":"2024-12-24","softcore":false,"video":false,"vote_average":4.5,"vote_count":2,"credit_id":"67d197ce434c98c8ec8173f1","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/2fSuI9gmciZeQ2RkVvPac84TWIj.jpg","genre_ids":[16,35,14],"id":1331351,"title":"Bogdan Boner: Pierwszy dzień szkoły","original_language":"pl","original_title":"Bogdan Boner: Pierwszy dzień szkoły","overview":"Spokojny nauczyciel znajduje w kieszeni demoniczny talizman i daje się opętać, po czym wywołuje chaos w całej szkole.","popularity":0.8114,"poster_path":"/cy4ETNOf8X4rkFGjUDf2yMbq31d.jpg","release_date":"2024-08-30","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"credit_id":"67f3c8b9a1576bf269d943be","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/2fSuI9gmciZeQ2RkVvPac84TWIj.jpg","genre_ids":[