h":"/fYN7UVruGPJxA3c7yGHQ4R9OHF0.jpg","genre_ids":[10402,99],"id":1425725,"title":"Hans Zimmer & Friends: Diamond in the Desert","original_language":"en","original_title":"Hans Zimmer & Friends: Diamond in the Desert","overview":"","popularity":1.7941,"poster_path":"/aAbU0BuIQa6CUPOqsvUoPK39apD.jpg","release_date":"2025-02-19","softcore":false,"video":false,"vote_average":8.25,"vote_count":34,"character":"Self","credit_id":"679a3815f2ff0dde55c0dd69","order":2},{"adult":false,"backdrop_path":"/46YmXTxmtJABk32bHArPLPDTbW6.jpg","genre_ids":[10402,99],"id":1434717,"title":"Utan ord – i filmmusikens värld","original_language":"sv","original_title":"Utan ord – i filmmusikens värld","overview":"","popularity":0.9644,"poster_path":"/t4TQUREoew7nmf3mdN3SExQ0fD8.jpg","release_date":"2024-02-10","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Selft","credit_id":"692c128c7898fdbbc1e73ebe","order":2},{"adult":false,"backdrop_path":"/6qGAM3cC2AE8ZDnBOIKbTmsZIzK.jpg","genre_ids":[99,36],"id":938875,"title":"Sir Michael Caine – Vom Arbeiterkind zum Hollywoodstar","original_language":"de","original_title":"Sir Michael Caine – Vom Arbeiterkind zum Hollywoodstar","overview":"","popularity":0.7187,"poster_path":"/po66itdmDF1SVwVMKXvu7DS2grY.jpg","release_date":"2023-03-14","softcore":false,"video":false,"vote_average":7.2,"vote_count":6,"character":"Self - Filmmaker (archive footage)","credit_id":"69a11a4848883c59a02d53b2","order":26},{"adult":false,"backdrop_path":"/fXUxAL8w724dI9yT5UbwJuk29K9.jpg","genre_ids":[99],"id":1731494,"title":"The Odyssey: The Making of an Epic","original_language":"en","original_title":"The Odyssey: The Making of an Epic","overview":"","popularity":3.879,"poster_path":"/nEWsCyE488tG85P8Cg3HbVbMvqQ.jpg","release_date":"2026-07-14","softcore":false,"video":false,"vote_average":6.5,"vote_count":11,"character":"Self - Director / Writer / Producer","credit_id":"6a56926ead882edf76b42614","order":0}],"crew":[{"adult":false,"backdrop_path":"/dqK9Hag1054tghRQSqLSfrkvQnA.jpg","genre_ids":[28,80,53],"id":155,"title":"Mroczny Rycerz","original_language":"en","original_title":"The Dark Knight","overview":"Kontynuacja filmu \"Batman: Początek\", \"Mroczny Rycerz\", to kolejne wspólne dzieło reżysera Christophera Nolana i gwiazdora Christiana Bale'a, który ponownie wciela się w postać Batmana / Bruce'a Wayne'a toczącego zażartą wojnę ze światem przestępczym. Batmanowi udaje się na dobre rozbić kryminalne podziemie Gotham z pomocą porucznika Jima Gordona (Gary Oldman) i Prokuratora Okręgowego Harveya Denta (Aaron Eckhart). Ich współpraca okazuje się niezwykle skuteczna, ale szybko trzej mężczyźni stają się celem nowego geniusza zbrodni, Jokera (Heath Ledger), którego celem jest wprowadzenie w Gotham anarchii i zmuszenie Batmana, by ten przeszedł na stronę zła, przestał być bohaterem, a stał się złoczyńcą.","popularity":60.8267,"poster_path":"/gKMDmGde8aAD8M6dvm6j7wciSbJ.jpg","release_date":"2008-07-16","softcore":false,"video":false,"vote_average":8.534,"vote_count":36273,"credit_id":"52fe4220c3a36847f8005d03","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/7Wev9JMo6R5XAfz2KDvXb7oPMmy.jpg","genre_ids":[9648,53],"id":77,"title":"Memento","original_language":"en","original_title":"Memento","overview":"Mieszkający w San Francisco detektyw ubezpieczeniowy, Leonard Shelby, w wyniku wypadku traci tzw. pamięć krótkotrwałą. Wie, kim jest i pamięta wszystko sprzed wypadku, ale błyskawicznie zapomina o tym, co wydarzyło się przed chwilą. Nie wie gdzie był, co robił i planował. Przy dłuższej rozmowie zapomina od czego się zaczęła. Powracające wspomnienia śmierci żony powodują, że nie daje za wygraną. Notatki, zdjęcia i tatuaże zastępują mu pamięć. Jedyną motywacją do życia jest obsesyjne pragnienie zemsty na mordercy ukochanej kobiety.","popularity":24.5041,"poster_path":"/nzlv62aC0octS5AklAiWpXLX9Z0.jpg","release_date":"2000-10-11","softcore":false,"video":false,"vote_average":8.174,"vote_count":16502,"credit_id":"52fe4214c3a36847f80024d1","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/dqK9Hag1054tghRQSqLSfrkvQnA.jpg","genre_ids":[28,80,53],"id":155,"title":"Mroczny Rycerz","original_language":"en","original_title":"The Dark Knight","overview":"Kontynuacja filmu \"Batman: Początek\", \"Mroczny Rycerz\", to kolejne wspólne dzieło reżysera Christophera Nolana i gwiazdora Christiana Bale'a, który ponownie wciela się w postać Batmana / Bruce'a Wayne'a toczącego zażartą wojnę ze światem przestępczym. Batmanowi udaje się na dobre rozbić kryminalne podziemie Gotham z pomocą porucznika Jima Gordona (Gary Oldman) i Prokuratora Okręgowego Harveya Denta (Aaron Eckhart). Ich współpraca okazuje się niezwykle skuteczna, ale szybko trzej mężczyźni stają się celem nowego geniusza zbrodni, Jokera (Heath Ledger), którego celem jest wprowadzenie w Gotham anarchii i zmuszenie Batmana, by ten przeszedł na stronę zła, przestał być bohaterem, a stał się złoczyńcą.","popularity":60.8267,"poster_path":"/gKMDmGde8aAD8M6dvm6j7wciSbJ.jpg","release_date":"2008-07-16","softcore":false,"video":false,"vote_average":8.534,"vote_count":36273,"credit_id":"52fe421fc3a36847f8005ce1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/z3br1ub7spqGMkxgjgJSdM4DC21.jpg","genre_ids":[18,9648,878],"id":1124,"title":"Prestiż","original_language":"en","original_title":"The Prestige","overview":"Tajemnicza opowieść o dwóch iluzjonistach między którymi rodzi się zażarta rywalizacja, która przeradza się w wojnę na sztuczki i nieposkromione pragnienie odkrycia tajemnic zawodowych rywala. Gdy nadchodzi chwila konfrontacji obu bohaterów - odwagi z pragnieniem, estradowego talentu z nauką i ambicji z przyjaźnią - skutki stają się śmiertelnie niebezpieczne.","popularity":31.7177,"poster_path":"/osBXpsFTRtpXpnxo81XRceymWNj.jpg","release_date":"2006-10-19","softcore":false,"video":false,"vote_average":8.211,"vote_count":17859,"credit_id":"52fe42e8c3a36847f802bef9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":804706,"title":"Tarantella","original_language":"en","original_title":"Tarantella","overview":"","popularity":1.5634,"poster_path":"/eqFhruWEIRwjkvqgJN48VPuR50Q.jpg","release_date":"1990-09-12","softcore":false,"video":false,"vote_average":5.154,"vote_count":52,"credit_id":"604a191aec455200457de3b1","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":804706,"title":"Tarantella","original_language":"en","original_title":"Tarantella","overview":"","popularity":1.5634,"poster_path":"/eqFhruWEIRwjkvqgJN48VPuR50Q.jpg","release_date":"1990-09-12","softcore":false,"video":false,"vote_average":5.154,"vote_count":52,"credit_id":"604a1920c8a5ac006f002fd7","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":804706,"title":"Tarantella","original_language":"en","original_title":"Tarantella","overview":"","popularity":1.5634,"poster_path":"/eqFhruWEIRwjkvqgJN48VPuR50Q.jpg","release_date":"1990-09-12","softcore":false,"video":false,"vote_average":5.154,"vote_count":52,"credit_id":"604a19075f622b006daa1ef4","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":804706,"title":"Tarantella","original_language":"en","original_title":"Tarantella","overview":"","popularity":1.5634,"poster_path":"/eqFhruWEIRwjkvqgJN48VPuR50Q.jpg","release_date":"1990-09-12","softcore":false,"video":false,"vote_average":5.154,"vote_count":52,"credit_id":"604a18d9ea37e0002ad295de","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[27],"id":804706,"title":"Tarantella","original_language":"en","original_title":"Tarantella","overview":"","popularity":1.5634,"poster_path":"/eqFhruWEIRwjkvqgJN48VPuR50Q.jpg","release_date":"1990-09-12","softcore":false,"video":false,"vote_average":5.154,"vote_count":52,"credit_id":"604a191254508d007759e03a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/yf5I5VHllK4h5VdbxHfQ40RBTe8.jpg","genre_ids":[18,53],"id":11660,"title":"Śledząc","original_language":"en","original_title":"Following","overview":"Starszy mężczyzna słucha historii Billa o życiu scenarzysty, który lubi podążać za obcymi w Londynie i ich obserwować. Pewnego dnia między pewnym siebie człowiekiem, którego Bill obserwował, i Billem, dochodzi do konfrontacji. Mężczyzna jest włamywaczem; postanawia wziąć Billa pod swoje skrzydła i pokazać mu, jak należy się włamywać do domów. Włamują się do domu pewnej kobiety. Bill jest nią zaintrygowany (wszędzie w jej mieszkaniu są zdjęcia). Odnajduje kobietę, i rozmawia z nią w barze, którego właścicielem jest jej były chłopak. Wkrótce Bill zostaje wmieszany w sprawy tej kobiety.","popularity":7.246,"poster_path":"/pZnfUffNIkeHB1gi2Lr31VNEIl.jpg","release_date":"1999-04-02","softcore":false,"video":false,"vote_average":7.128,"vote_count":1910,"credit_id":"52fe44739251416c75035309","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/yf5I5VHllK4h5VdbxHfQ40RBTe8.jpg","genre_ids":[18,53],"id":11660,"title":"Śledząc","original_language":"en","original_title":"Following","overview":"Starszy mężczyzna słucha historii Billa o życiu scenarzysty, który lubi podążać za obcymi w Londynie i ich obserwować. Pewnego dnia między pewnym siebie człowiekiem, którego Bill obserwował, i Billem, dochodzi do konfrontacji. Mężczyzna jest włamywaczem; postanawia wziąć Billa pod swoje skrzydła i pokazać mu, jak należy się włamywać do domów. Włamują się do domu pewnej kobiety. Bill jest nią zaintrygowany (wszędzie w jej mieszkaniu są zdjęcia). Odnajduje kobietę, i rozmawia z nią w barze, którego właścicielem jest jej były chłopak. Wkrótce Bill zostaje wmieszany w sprawy tej kobiety.","popularity":7.246,"poster_path":"/pZnfUffNIkeHB1gi2Lr31VNEIl.jpg","release_date":"1999-04-02","softcore":false,"video":false,"vote_average":7.128,"vote_count":1910,"credit_id":"52fe44739251416c7503532d","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/yf5I5VHllK4h5VdbxHfQ40RBTe8.jpg","genre_ids":[18,53],"id":11660,"title":"Śledząc","original_language":"en","original_title":"Following","overview":"Starszy mężczyzna słucha historii Billa o życiu scenarzysty, który lubi podążać za obcymi w Londynie i ich obserwować. Pewnego dnia między pewnym siebie człowiekiem, którego Bill obserwował, i Billem, dochodzi do konfrontacji. Mężczyzna jest włamywaczem; postanawia wziąć Billa pod swoje skrzydła i pokazać mu, jak należy się włamywać do domów. Włamują się do domu pewnej kobiety. Bill jest nią zaintrygowany (wszędzie w jej mieszkaniu są zdjęcia). Odnajduje kobietę, i rozmawia z nią w barze, którego właścicielem jest jej były chłopak. Wkrótce Bill zostaje wmieszany w sprawy tej kobiety.","popularity":7.246,"poster_path":"/pZnfUffNIkeHB1gi2Lr31VNEIl.jpg","release_date":"1999-04-02","softcore":false,"video":false,"vote_average":7.128,"vote_count":1910,"credit_id":"52fe44739251416c75035321","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg","genre_ids":[28,878,12],"id":27205,"title":"Incepcja","original_language":"en","original_title":"Inception","overview":"Dom Cobb jest niezwykle sprawnym złodziejem, mistrzem w wydobywaniu wartościowych sekretów ukrytych głęboko w świadomości podczas fazy snu, kiedy umysł jest najbardziej wrażliwy. Wyjątkowe umiejętności Cobba uczyniły z niego ważnego gracza w świecie szpiegostwa przemysłowego, ale i najbardziej poszukiwanego zbiega, a za swoją pozycję zapłacił utratą wszystkiego, co kocha. Teraz Cobb otrzymuje szansę na odkupienie. Za sprawą jednego, ostatniego zadania może odzyskać stracone życie. Musi tylko wraz ze swym zespołem dokonać rzeczy niemożliwej: zamiast skraść myśl, zaszczepić ją w śpiącym umyśle. Jeśli im się to uda, dokonają zbrodni doskonałej. Jednak nawet najbardziej precyzyjne planowanie nie jest w stanie przygotować ich na spotkanie z niezwykłym przeciwnikiem, który potrafi przewidzieć każdy ich ruch. Wróg, którego tylko Cobb mógł się spodziewać.","popularity":59.7278,"poster_path":"/efvcvRgOAZgFC2hrPUa6YqrE1KG.jpg","release_date":"2010-07-15","softcore":false,"video":false,"vote_average":8.372,"vote_count":39747,"credit_id":"52fe4534c3a368484e04de2d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/t1NlvLU5xJamUTPVwnWi2o9nR76.jpg","genre_ids":[27],"id":43629,"title":"Doodlebug","original_language":"en","original_title":"Doodlebug","overview":"","popularity":2.1523,"poster_path":"/cXDFFv6yZNW3vUHOKKUPJNnL0So.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":6.525,"vote_count":497,"credit_id":"52fe4655c3a36847f80f96c9","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/t1NlvLU5xJamUTPVwnWi2o9nR76.jpg","genre_ids":[27],"id":43629,"title":"Doodlebug","original_language":"en","original_title":"Doodlebug","overview":"","popularity":2.1523,"poster_path":"/cXDFFv6yZNW3vUHOKKUPJNnL0So.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":6.525,"vote_count":497,"credit_id":"52fe4655c3a36847f80f96cf","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/y2DB71C4nyIdMrANijz8mzvQtk6.jpg","genre_ids":[28,80,18,53],"id":49026,"title":"Mroczny Rycerz powstaje","original_language":"en","original_title":"The Dark Knight Rises","overview":"Po upływie ośmiu lat od wydarzeń z \"Mrocznego Rycerza\" w Gotham panuje pokój. Dzięki Ustawie Denta udało się rozbić przestępczość zorganizowaną, a najgorszych złoczyńców osadzono w Blackgate. Mając świadomość, że stabilizacja oparta jest na kłamstwie, Bruce Wayne całkowicie wycofał się z życia publicznego. Teraz całe dnie spędza w swojej rezydencji, a Wayne Enterprises zaczyna podupadać. Uwagę Bruce'a wzbudza jednak Selina Kyle, sprytna i bezczelna włamywaczka, działająca według własnego kodeksu. Ciąg wydarzeń z jej udziałem sprawia, że komisarz Jim Gordon wpada na trop tajemniczego spisku i grupy najemników dowodzonych przez Bane'a, brutalnego terrorystę mającego powiązania z Ligą Cieni. Chcąc chronić miasto, Bruce decyduje się ponownie założyć kostium Batmana. Zagrożenie okazuje się jednak większe, niż ktokolwiek mógłby przypuszczać, a Mroczny Rycerz staje przed najtrudniejszym wyzwaniem w swoim życiu.","popularity":32.1221,"poster_path":"/oWIhEWtHbSlvttp5qbBEutPOV7G.jpg","release_date":"2012-07-17","softcore":false,"video":false,"vote_average":7.796,"vote_count":24647,"credit_id":"52fe4781c3a36847f8139915","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/y2DB71C4nyIdMrANijz8mzvQtk6.jpg","genre_ids":[28,80,18,53],"id":49026,"title":"Mroczny Rycerz powstaje","original_language":"en","original_title":"The Dark Knight Rises","overview":"Po upływie ośmiu lat od wydarzeń z \"Mrocznego Rycerza\" w Gotham panuje pokój. Dzięki Ustawie Denta udało się rozbić przestępczość zorganizowaną, a najgorszych złoczyńców osadzono w Blackgate. Mając świadomość, że stabilizacja oparta jest na kłamstwie, Bruce Wayne całkowicie wycofał się z życia publicznego. Teraz całe dnie spędza w swojej rezydencji, a Wayne Enterprises zaczyna podupadać. Uwagę Bruce'a wzbudza jednak Selina Kyle, sprytna i bezczelna włamywaczka, działająca według własnego kodeksu. Ciąg wydarzeń z jej udziałem sprawia, że komisarz Jim Gordon wpada na trop tajemniczego spisku i grupy najemników dowodzonych przez Bane'a, brutalnego terrorystę mającego powiązania z Ligą Cieni. Chcąc chronić miasto, Bruce decyduje się ponownie założyć kostium Batmana. Zagrożenie okazuje się jednak większe, niż ktokolwiek mógłby przypuszczać, a Mroczny Rycerz staje przed najtrudniejszym wyzwaniem w swoim życiu.","popularity":32.1221,"poster_path":"/oWIhEWtHbSlvttp5qbBEutPOV7G.jpg","release_date":"2012-07-17","softcore":false,"video":false,"vote_average":7.796,"vote_count":24647,"credit_id":"52fe4781c3a36847f8139893","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/y2DB71C4nyIdMrANijz8mzvQtk6.jpg","genre_ids":[28,80,18,53],"id":49026,"title":"Mroczny Rycerz powstaje","original_language":"en","original_title":"The Dark Knight Rises","overview":"Po upływie ośmiu lat od wydarzeń z \"Mrocznego Rycerza\" w Gotham panuje pokój. Dzięki Ustawie Denta udało się rozbić przestępczość zorganizowaną, a najgorszych złoczyńców osadzono w Blackgate. Mając świadomość, że stabilizacja oparta jest na kłamstwie, Bruce Wayne całkowicie wycofał się z życia publicznego. Teraz całe dnie spędza w swojej rezydencji, a Wayne Enterprises zaczyna podupadać. Uwagę Bruce'a wzbudza jednak Selina Kyle, sprytna i bezczelna włamywaczka, działająca według własnego kodeksu. Ciąg wydarzeń z jej udziałem sprawia, że komisarz Jim Gordon wpada na trop tajemniczego spisku i grupy najemników dowodzonych przez Bane'a, brutalnego terrorystę mającego powiązania z Ligą Cieni. Chcąc chronić miasto, Bruce decyduje się ponownie założyć kostium Batmana. Zagrożenie okazuje się jednak większe, niż ktokolwiek mógłby przypuszczać, a Mroczny Rycerz staje przed najtrudniejszym wyzwaniem w swoim życiu.","popularity":32.1221,"poster_path":"/oWIhEWtHbSlvttp5qbBEutPOV7G.jpg","release_date":"2012-07-17","softcore":false,"video":false,"vote_average":7.796,"vote_count":24647,"credit_id":"52fe4781c3a36847f813991b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/j2MlEEpA3wgwQiJB6p1UHC50oiw.jpg","genre_ids":[28,12,878],"id":49521,"title":"Człowiek ze stali","original_language":"en","original_title":"Man of Steel","overview":"W wyniku poszukiwań zastępczych źródeł energii jądro planet Krypton ulega destabilizacji. Świat zostaje skazany na zagładę. Świadomy tego naukowiec Jor-El (Russell Crowe) chce za wszelką cenę zapewnić przetrwanie swojemu ludowi. Wbrew woli prowadzącego właśnie wojnę domową generała Zoda (Michael Shannon) umieszcza swojego nowo narodzonego synka Kal-Ela w statku ratunkowym i wysyła go na odległą Ziemię. Chłopiec trafia na farmę w Kansas, gdzie przygarniają go Jonathan (Kevin Costner) i Martha (Diane Lane) Kentowie. Po wielu latach dorosły już Clark (Henry Cavill) opuszcza dom przybranych rodziców i rusza na poszukiwania swojej tożsamości. Kiedy ścigający go Zod przybywa na Ziemię, Clark musi dokonać wyboru - pozostać w ukryciu, czy też ujawnić swoje nadzwyczajne moce i stać się symbolem nadziei dla całej ludzkości.","popularity":25.018,"poster_path":"/qj40hZtRF8T98NANC9zsrDQHf3v.jpg","release_date":"2013-06-12","softcore":false,"video":false,"vote_average":6.656,"vote_count":16412,"credit_id":"52fe4799c3a36847f813e613","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/j2MlEEpA3wgwQiJB6p1UHC50oiw.jpg","genre_ids":[28,12,878],"id":49521,"title":"Człowiek ze stali","original_language":"en","original_title":"Man of Steel","overview":"W wyniku poszukiwań zastępczych źródeł energii jądro planet Krypton ulega destabilizacji. Świat zostaje skazany na zagładę. Świadomy tego naukowiec Jor-El (Russell Crowe) chce za wszelką cenę zapewnić przetrwanie swojemu ludowi. Wbrew woli prowadzącego właśnie wojnę domową generała Zoda (Michael Shannon) umieszcza swojego nowo narodzonego synka Kal-Ela w statku ratunkowym i wysyła go na odległą Ziemię. Chłopiec trafia na farmę w Kansas, gdzie przygarniają go Jonathan (Kevin Costner) i Martha (Diane Lane) Kentowie. Po wielu latach dorosły już Clark (Henry Cavill) opuszcza dom przybranych rodziców i rusza na poszukiwania swojej tożsamości. Kiedy ścigający go Zod przybywa na Ziemię, Clark musi dokonać wyboru - pozostać w ukryciu, czy też ujawnić swoje nadzwyczajne moce i stać się symbolem nadziei dla całej ludzkości.","popularity":25.018,"poster_path":"/qj40hZtRF8T98NANC9zsrDQHf3v.jpg","release_date":"2013-06-12","softcore":false,"video":false,"vote_average":6.656,"vote_count":16412,"credit_id":"52fe4799c3a36847f813e655","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/p8K8Z4yjaslJx5mTsIC5L6LJxQB.jpg","genre_ids":[16,28,53,878],"id":64956,"title":"Inception: The Cobol Job","original_language":"en","original_title":"Inception: The Cobol Job","overview":"","popularity":1.448,"poster_path":"/sNxqwtyHMNQwKWoFYDqcYTui5Ok.jpg","release_date":"2010-12-07","softcore":false,"video":false,"vote_average":7.256,"vote_count":315,"credit_id":"60d40dad3c887d0076ef6313","department":"Writing","job":"Characters"},{"adult":false,"backdrop_path":"/5XNQBqnBwPA9yT0jZ0p3s8bbLh0.jpg","genre_ids":[12,18,878],"id":157336,"title":"Interstellar","original_language":"en","original_title":"Interstellar","overview":"Ziemia w niedalekiej przyszłości. Planeta jest sukcesywnie niszczona przez klęski suszy, a ludziom grozi wyginięcie. Nieoczekiwanie naukowcy odkrywają możliwość podróżowania poza granice Układu Słonecznego. Grupa astronautów wyrusza w najważniejszą w dziejach ludzkości podróż – muszą znaleźć miejsce, gdzie nasz gatunek będzie mógł przetrwać. Na czele załogi staje Cooper, były pilot NASA, który obecnie zajmuje się uprawą roli.","popularity":75.6661,"poster_path":"/q4emCJmjNomEE2pVGgqr3nDEIzI.jpg","release_date":"2014-11-05","softcore":false,"video":false,"vote_average":8.5,"vote_count":40597,"credit_id":"52fe4bbf9251416c910e47ed","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ypuD6ZsupyVV1ElNSIPz2BooIlX.jpg","genre_ids":[53,878,18,9648],"id":157353,"title":"Transcendencja","original_language":"en","original_title":"Transcendence","overview":"Grupa naukowców pracuje nad stworzeniem pierwszego na świecie komputera obdarzonego ludzką inteligencją i empatią. Gdy jeden z nich - Will - ginie z rąk terrorystycznej organizacji, jego żona  Evelyn podejmuje decyzję o przeniesieniu umysłu mężczyzny do pamięci powstającej maszyny. Will ożywa, ale skutki operacji okazują się dalekie od pożądanych.","popularity":7.6794,"poster_path":"/1MrivUuGSy5dJVBMIk0cFCr78Dl.jpg","release_date":"2014-04-16","softcore":false,"video":false,"vote_average":6.076,"vote_count":5873,"credit_id":"52fe4bc19251416c910e4aef","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg","genre_ids":[18,36],"id":872585,"title":"Oppenheimer","original_language":"en","original_title":"Oppenheimer","overview":"Oppenheimer w czasie II Wojny Światowej był dyrektorem programu rozwoju broni jądrowej \"Manhattan\".  Poza działalnością związaną z bronią atomową Oppenheimer miał ogromne osiągnięcia w innych dziedzinach fizyki, między innymi w badaniach czarnych dziur oraz promieniowania kosmicznego. Resztę życia po opracowaniu bomby atomowej poświęcił na działalność na rzecz ograniczania rozprzestrzeniania się broni jądrowej. Był oskarżany przez amerykański rząd i służby o powiązania z ruchem komunistycznym oraz działalność szpiegowską. W latach 50. został pozbawiony dostępu do tajnych dokumentów. Dopiero prezydent Kennedy dokonał jego politycznej rehabilitacji. Oppenheimer jest dziś uznawany za jeden z symboli pacyfizmu i sprzeciwu wobec rozprzestrzeniania broni atomowej.","popularity":53.9747,"poster_path":"/gBrW3l0GsN7fvrn6A7ofaw90qj4.jpg","release_date":"2023-07-19","softcore":false,"video":false,"vote_average":8.024,"vote_count":12152,"credit_id":"613a93cbd38b58005f6a1964","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg","genre_ids":[18,36],"id":872585,"title":"Oppenheimer","original_language":"en","original_title":"Oppenheimer","overview":"Oppenheimer w czasie II Wojny Światowej był dyrektorem programu rozwoju broni jądrowej \"Manhattan\".  Poza działalnością związaną z bronią atomową Oppenheimer miał ogromne osiągnięcia w innych dziedzinach fizyki, między innymi w badaniach czarnych dziur oraz promieniowania kosmicznego. Resztę życia po opracowaniu bomby atomowej poświęcił na działalność na rzecz ograniczania rozprzestrzeniania się broni jądrowej. Był oskarżany przez amerykański rząd i służby o powiązania z ruchem komunistycznym oraz działalność szpiegowską. W latach 50. został pozbawiony dostępu do tajnych dokumentów. Dopiero prezydent Kennedy dokonał jego politycznej rehabilitacji. Oppenheimer jest dziś uznawany za jeden z symboli pacyfizmu i sprzeciwu wobec rozprzestrzeniania broni atomowej.","popularity":53.9747,"poster_path":"/gBrW3l0GsN7fvrn6A7ofaw90qj4.jpg","release_date":"2023-07-19","softcore":false,"video":false,"vote_average":8.024,"vote_count":12152,"credit_id":"6140dd58aaf89700421a6dd1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/neeNHeXjMF5fXoCJRsOmkNGC7q.jpg","genre_ids":[18,36],"id":872585,"title":"Oppenheimer","original_language":"en","original_title":"Oppenheimer","overview":"Oppenheimer w czasie II Wojny Światowej był dyrektorem programu rozwoju broni jądrowej \"Manhattan\".  Poza działalnością związaną z bronią atomową Oppenheimer miał ogromne osiągnięcia w innych dziedzinach fizyki, między innymi w badaniach czarnych dziur oraz promieniowania kosmicznego. Resztę życia po opracowaniu bomby atomowej poświęcił na działalność na rzecz ograniczania rozprzestrzeniania się broni jądrowej. Był oskarżany przez amerykański rząd i służby o powiązania z ruchem komunistycznym oraz działalność szpiegowską. W latach 50. został pozbawiony dostępu do tajnych dokumentów. Dopiero prezydent Kennedy dokonał jego politycznej rehabilitacji. Oppenheimer jest dziś uznawany za jeden z symboli pacyfizmu i sprzeciwu wobec rozprzestrzeniania broni atomowej.","popularity":53.9747,"poster_path":"/gBrW3l0GsN7fvrn6A7ofaw90qj4.jpg","release_date":"2023-07-19","softcore":false,"video":false,"vote_average":8.024,"vote_count":12152,"credit_id":"62e2e919fe077a005f06af53","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg","genre_ids":[28,878,12],"id":27205,"title":"Incepcja","original_language":"en","original_title":"Inception","overview":"Dom Cobb jest niezwykle sprawnym złodziejem, mistrzem w wydobywaniu wartościowych sekretów ukrytych głęboko w świadomości podczas fazy snu, kiedy umysł jest najbardziej wrażliwy. Wyjątkowe umiejętności Cobba uczyniły z niego ważnego gracza w świecie szpiegostwa przemysłowego, ale i najbardziej poszukiwanego zbiega, a za swoją pozycję zapłacił utratą wszystkiego, co kocha. Teraz Cobb otrzymuje szansę na odkupienie. Za sprawą jednego, ostatniego zadania może odzyskać stracone życie. Musi tylko wraz ze swym zespołem dokonać rzeczy niemożliwej: zamiast skraść myśl, zaszczepić ją w śpiącym umyśle. Jeśli im się to uda, dokonają zbrodni doskonałej. Jednak nawet najbardziej precyzyjne planowanie nie jest w stanie przygotować ich na spotkanie z niezwykłym przeciwnikiem, który potrafi przewidzieć każdy ich ruch. Wróg, którego tylko Cobb mógł się spodziewać.","popularity":59.7278,"poster_path":"/efvcvRgOAZgFC2hrPUa6YqrE1KG.jpg","release_date":"2010-07-15","softcore":false,"video":false,"vote_average":8.372,"vote_count":39747,"credit_id":"6168e57da802360043ef85d0","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5XNQBqnBwPA9yT0jZ0p3s8bbLh0.jpg","genre_ids":[12,18,878],"id":157336,"title":"Interstellar","original_language":"en","original_title":"Interstellar","overview":"Ziemia w niedalekiej przyszłości. Planeta jest sukcesywnie niszczona przez klęski suszy, a ludziom grozi wyginięcie. Nieoczekiwanie naukowcy odkrywają możliwość podróżowania poza granice Układu Słonecznego. Grupa astronautów wyrusza w najważniejszą w dziejach ludzkości podróż – muszą znaleźć miejsce, gdzie nasz gatunek będzie mógł przetrwać. Na czele załogi staje Cooper, były pilot NASA, który obecnie zajmuje się uprawą roli.","popularity":75.6661,"poster_path":"/q4emCJmjNomEE2pVGgqr3nDEIzI.jpg","release_date":"2014-11-05","softcore":false,"video":false,"vote_average":8.5,"vote_count":40597,"credit_id":"5505e4dac3a36862e900346c","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5fX1oSGuYdKgwWmUTAN5MNSQGzr.jpg","genre_ids":[28,12,14],"id":209112,"title":"Batman v Superman: Świt sprawiedliwości","original_language":"en","original_title":"Batman v Superman: Dawn of Justice","overview":"W obawie przed poczynaniami nieposkromionego superbohatera o boskich rysach i zdolnościach, najznamienitszy obywatel Gotham City, a zarazem zaciekły strażnik porządku, staje do walki z otaczanym czcią współczesnym wybawcą Metropolis, podczas gdy świat usiłuje ustalić, jakiego bohatera naprawdę potrzebuje. Wobec konfliktu, który rozgorzał między Batmanem i Supermanem, na horyzoncie szybko pojawia się nowy wróg, stawiając ludzkość w obliczu śmiertelnego niebezpieczeństwa, z jakim jeszcze nigdy nie musiała się mierzyć.","popularity":20.3333,"poster_path":"/3HYzaaxrCxJwKt5HnF52SlQyVjW.jpg","release_date":"2016-03-23","softcore":false,"video":false,"vote_average":6.008,"vote_count":19189,"credit_id":"553bf2ba925141125600a15d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/9IIBboV7MCT0bTxzXHmWK1Hq558.jpg","genre_ids":[18,80,28],"id":272,"title":"Batman - Początek","original_language":"en","original_title":"Batman Begins","overview":"\"Batman Początek\", dzieło cenionego reżysera Christophera Nolana, odkrywa tajemnicę narodzin legendarnego Mrocznego Rycerza. Po tragicznej śmierci rodziców, rozczarowany życiem spadkobierca fortuny Wayne'ów, Bruce (Christian Bale), podróżuje po świecie szukając środków do walki z niesprawiedliwością po to, aby obrócić strach przeciw tym, którzy go sieją. Z pomocą zaufanego lokaja Alfreda (Michael Caine), detektywa Jima Gordona (Gary Oldman), oraz swego sprzymierzeńca Luciusa Foxa (Morgan Freeman), Wayne powraca do Gotham, aby powołać do życia swoje alter-ego: Batmana, zamaskowanego wojownika, który posługuje się siłą, intelektem i zaawansowaną bronią, aby zwalczać złowrogie siły, które zagrażają miastu.","popularity":29.1017,"poster_path":"/cub46jQ4bLQYYbpbSL9Q24wofS2.jpg","release_date":"2005-06-10","softcore":false,"video":false,"vote_average":7.729,"vote_count":22894,"credit_id":"557c5dddc3a368632b001e9f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/mTOrGSfDC7CmZBtN8FVGDrSfaNB.jpg","genre_ids":[],"id":126444,"title":"Cinema16: British Short Films","original_language":"en","original_title":"Cinema16: British Short Films","overview":"","popularity":1.8709,"poster_path":"/iY1FDQM6taKwO7bG6YH09nE8NSs.jpg","release_date":"2003-05-05","softcore":false,"video":true,"vote_average":5.167,"vote_count":6,"credit_id":"634e9d3189f7490082e26b33","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ddIkmH3TpR6XSc47jj0BrGK5Rbz.jpg","genre_ids":[10752,28,18],"id":374720,"title":"Dunkierka","original_language":"en","original_title":"Dunkirk","overview":"Lato 1940 roku. Na plażach Dunkierki na północy Francji, Niemcy blokują brytyjskie i francuskie wojska. Otoczeni przez przeciwnika żołnierze czekają na cud. Ewakuacją z portu dowodzą komandor Bolton oraz pułkownik Winnant. W odpowiedzi na wezwania brytyjskiego rządu na ratunek uwięzionym żołnierzom spieszą nawet właściciele prywatnych statków. W tym samym czasie mała eskadra lotnicza, w skład której wchodzi Farrier osłania wycofujących się z kontynentu żołnierzy. Piloci RAF-u nie mają łatwego zadania. Muszą stawić czoła przeważającym siłom lotniczym nieprzyjaciela.","popularity":17.3504,"poster_path":"/zPRomhANBqtY8XSb9y4f2o5nHzp.jpg","release_date":"2017-07-19","softcore":false,"video":false,"vote_average":7.5,"vote_count":17758,"credit_id":"56819cc8c3a368607501004f","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/z3br1ub7spqGMkxgjgJSdM4DC21.jpg","genre_ids":[18,9648,878],"id":1124,"title":"Prestiż","original_language":"en","original_title":"The Prestige","overview":"Tajemnicza opowieść o dwóch iluzjonistach między którymi rodzi się zażarta rywalizacja, która przeradza się w wojnę na sztuczki i nieposkromione pragnienie odkrycia tajemnic zawodowych rywala. Gdy nadchodzi chwila konfrontacji obu bohaterów - odwagi z pragnieniem, estradowego talentu z nauką i ambicji z przyjaźnią - skutki stają się śmiertelnie niebezpieczne.","popularity":31.7177,"poster_path":"/osBXpsFTRtpXpnxo81XRceymWNj.jpg","release_date":"2006-10-19","softcore":false,"video":false,"vote_average":8.211,"vote_count":17859,"credit_id":"5674abdac3a368167a000dd2","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ddIkmH3TpR6XSc47jj0BrGK5Rbz.jpg","genre_ids":[10752,28,18],"id":374720,"title":"Dunkierka","original_language":"en","original_title":"Dunkirk","overview":"Lato 1940 roku. Na plażach Dunkierki na północy Francji, Niemcy blokują brytyjskie i francuskie wojska. Otoczeni przez przeciwnika żołnierze czekają na cud. Ewakuacją z portu dowodzą komandor Bolton oraz pułkownik Winnant. W odpowiedzi na wezwania brytyjskiego rządu na ratunek uwięzionym żołnierzom spieszą nawet właściciele prywatnych statków. W tym samym czasie mała eskadra lotnicza, w skład której wchodzi Farrier osłania wycofujących się z kontynentu żołnierzy. Piloci RAF-u nie mają łatwego zadania. Muszą stawić czoła przeważającym siłom lotniczym nieprzyjaciela.","popularity":17.3504,"poster_path":"/zPRomhANBqtY8XSb9y4f2o5nHzp.jpg","release_date":"2017-07-19","softcore":false,"video":false,"vote_average":7.5,"vote_count":17758,"credit_id":"56cd9e759251415cda002182","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/8dfB31n4bKSEvzA58PvKo0jims2.jpg","genre_ids":[80,18],"id":456684,"title":"Larceny","original_language":"en","original_title":"Larceny","overview":"","popularity":2.2797,"poster_path":"/jBWtTViwpr9xN6PWuzp8WlxTSXB.jpg","release_date":"1996-07-14","softcore":false,"video":false,"vote_average":5.7,"vote_count":7,"credit_id":"65c82c61ce6c4c0163b823b1","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/8dfB31n4bKSEvzA58PvKo0jims2.jpg","genre_ids":[80,18],"id":456684,"title":"Larceny","original_language":"en","original_title":"Larceny","overview":"","popularity":2.2797,"poster_path":"/jBWtTViwpr9xN6PWuzp8WlxTSXB.jpg","release_date":"1996-07-14","softcore":false,"video":false,"vote_average":5.7,"vote_count":7,"credit_id":"65c82c884350110149e74df1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/8dfB31n4bKSEvzA58PvKo0jims2.jpg","genre_ids":[80,18],"id":456684,"title":"Larceny","original_language":"en","original_title":"Larceny","overview":"","popularity":2.2797,"poster_path":"/jBWtTViwpr9xN6PWuzp8WlxTSXB.jpg","release_date":"1996-07-14","softcore":false,"video":false,"vote_average":5.7,"vote_count":7,"credit_id":"65c82c738d77c4014845b0f2","department":"Camera","job":"Camera Operator"},{"adult":false,"backdrop_path":"/8dfB31n4bKSEvzA58PvKo0jims2.jpg","genre_ids":[80,18],"id":456684,"title":"Larceny","original_language":"en","original_title":"Larceny","overview":"","popularity":2.2797,"poster_path":"/jBWtTViwpr9xN6PWuzp8WlxTSXB.jpg","release_date":"1996-07-14","softcore":false,"video":false,"vote_average":5.7,"vote_count":7,"credit_id":"65c82c499451e701847bb143","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/8dfB31n4bKSEvzA58PvKo0jims2.jpg","genre_ids":[80,18],"id":456684,"title":"Larceny","original_language":"en","original_title":"Larceny","overview":"","popularity":2.2797,"poster_path":"/jBWtTViwpr9xN6PWuzp8WlxTSXB.jpg","release_date":"1996-07-14","softcore":false,"video":false,"vote_average":5.7,"vote_count":7,"credit_id":"65c82c7ee4b576017d157f91","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"595e478a925141225106bdac","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/t1NlvLU5xJamUTPVwnWi2o9nR76.jpg","genre_ids":[27],"id":43629,"title":"Doodlebug","original_language":"en","original_title":"Doodlebug","overview":"","popularity":2.1523,"poster_path":"/cXDFFv6yZNW3vUHOKKUPJNnL0So.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":6.525,"vote_count":497,"credit_id":"595e4934c3a368265d085a8f","department":"Art","job":"Set Designer"},{"adult":false,"backdrop_path":"/2nyaeISu2xIxIgZYNpX4UayY8PN.jpg","genre_ids":[28,12,878],"id":141052,"title":"Liga Sprawiedliwości","original_language":"en","original_title":"Justice League","overview":"Zainspirowany ofiarnym czynem Supermana (Henry Cavill) Bruce Wayne, który odzyskał wiarę w ludzkość, prosi swojego nowego sprzymierzeńca, Dianę Prince, o pomoc w pokonaniu jeszcze potężniejszego wroga. Nie tracąc czasu, Batman (Ben Affleck) i Wonder Woman (Gal Gadot) starają się znaleźć grupę metaludzi i przekonać ich do współpracy. Mają oni stanąć do walki z nowym zagrożeniem. Jednak mimo utworzenia jedynej w swoim rodzaju ligi superbohaterów, złożonej z Batmana, Wonder Woman, Aquamana (Jason Momoa), Cyborga (Ray Fisher) i Flasha (Ezra Miller), może być już za późno na uratowanie planety przed atakiem o katastroficznych rozmiarach.  [opis dystrybutora Blu-ray]","popularity":18.5726,"poster_path":"/wGi2euNd5MTRz57d9zeFe5q95JK.jpg","release_date":"2017-11-15","softcore":false,"video":false,"vote_average":6.1,"vote_count":13798,"credit_id":"5a0e066c92514138f0000db6","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"5ad78d7dc3a368719c000d42","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"5ad78d90c3a3687196000dad","department":"Sound","job":"Original Music Composer"},{"adult":false,"backdrop_path":"/wBuMF4MmmF3XDaTpvx3gNWbq0tR.jpg","genre_ids":[99,36],"id":1149947,"title":"To End All War: Oppenheimer & the Atomic Bomb","original_language":"en","original_title":"To End All War: Oppenheimer & the Atomic Bomb","overview":"Dowiedz się, jak nieustępliwa determinacja jednego człowieka i wynalezienie bomby atomowej na zawsze zmieniły charakter wojny, doprowadziły do ​​śmierci setek tysięcy ludzi i wywołały masową histerię.","popularity":1.8685,"poster_path":"/xwkYWcs8aypUtk3xDRUh0ndo4GA.jpg","release_date":"2023-07-09","softcore":false,"video":false,"vote_average":7.718,"vote_count":234,"credit_id":"64b2e5a40e4fc8011e0631c4","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/mQOUyqDybTqxl73hO5LujCZsM1o.jpg","genre_ids":[28,53,878],"id":577922,"title":"Tenet","original_language":"en","original_title":"Tenet","overview":"Agent CIA (John David Washington) zwany Protagonistą, pewnego dnia zostaje zwerbowany do tajemniczej organizacji Tenet. Jego głównym zadaniem staje się wytropienie niebezpiecznych ludzi powiązanych z technologią służącą do manipulacji czasem. Nietypowa podróż bohatera przez mroczny świat międzynarodowego szpiegostwa ma pozwolić uratować ludzkość przed zbliżającą się kolejną wojną. Czy Protagonista opanuje sztukę inwersji czasu na czas i zapobiegnie najgorszemu scenariuszowi?","popularity":21.4136,"poster_path":"/IveefzhRc6Zdd5gzQw3VFjitZP.jpg","release_date":"2020-08-22","softcore":false,"video":false,"vote_average":7.174,"vote_count":11314,"credit_id":"5da313b51967570011aa6486","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/mQOUyqDybTqxl73hO5LujCZsM1o.jpg","genre_ids":[28,53,878],"id":577922,"title":"Tenet","original_language":"en","original_title":"Tenet","overview":"Agent CIA (John David Washington) zwany Protagonistą, pewnego dnia zostaje zwerbowany do tajemniczej organizacji Tenet. Jego głównym zadaniem staje się wytropienie niebezpiecznych ludzi powiązanych z technologią służącą do manipulacji czasem. Nietypowa podróż bohatera przez mroczny świat międzynarodowego szpiegostwa ma pozwolić uratować ludzkość przed zbliżającą się kolejną wojną. Czy Protagonista opanuje sztukę inwersji czasu na czas i zapobiegnie najgorszemu scenariuszowi?","popularity":21.4136,"poster_path":"/IveefzhRc6Zdd5gzQw3VFjitZP.jpg","release_date":"2020-08-22","softcore":false,"video":false,"vote_average":7.174,"vote_count":11314,"credit_id":"5da457b01967570011acf8d5","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ddIkmH3TpR6XSc47jj0BrGK5Rbz.jpg","genre_ids":[10752,28,18],"id":374720,"title":"Dunkierka","original_language":"en","original_title":"Dunkirk","overview":"Lato 1940 roku. Na plażach Dunkierki na północy Francji, Niemcy blokują brytyjskie i francuskie wojska. Otoczeni przez przeciwnika żołnierze czekają na cud. Ewakuacją z portu dowodzą komandor Bolton oraz pułkownik Winnant. W odpowiedzi na wezwania brytyjskiego rządu na ratunek uwięzionym żołnierzom spieszą nawet właściciele prywatnych statków. W tym samym czasie mała eskadra lotnicza, w skład której wchodzi Farrier osłania wycofujących się z kontynentu żołnierzy. Piloci RAF-u nie mają łatwego zadania. Muszą stawić czoła przeważającym siłom lotniczym nieprzyjaciela.","popularity":17.3504,"poster_path":"/zPRomhANBqtY8XSb9y4f2o5nHzp.jpg","release_date":"2017-07-19","softcore":false,"video":false,"vote_average":7.5,"vote_count":17758,"credit_id":"5e83ab8fe33f830018359941","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"5e83ac7688bbe60015a69864","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/mQOUyqDybTqxl73hO5LujCZsM1o.jpg","genre_ids":[28,53,878],"id":577922,"title":"Tenet","original_language":"en","original_title":"Tenet","overview":"Agent CIA (John David Washington) zwany Protagonistą, pewnego dnia zostaje zwerbowany do tajemniczej organizacji Tenet. Jego głównym zadaniem staje się wytropienie niebezpiecznych ludzi powiązanych z technologią służącą do manipulacji czasem. Nietypowa podróż bohatera przez mroczny świat międzynarodowego szpiegostwa ma pozwolić uratować ludzkość przed zbliżającą się kolejną wojną. Czy Protagonista opanuje sztukę inwersji czasu na czas i zapobiegnie najgorszemu scenariuszowi?","popularity":21.4136,"poster_path":"/IveefzhRc6Zdd5gzQw3VFjitZP.jpg","release_date":"2020-08-22","softcore":false,"video":false,"vote_average":7.174,"vote_count":11314,"credit_id":"5e83abdcd236e60015fd9f9f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/5XNQBqnBwPA9yT0jZ0p3s8bbLh0.jpg","genre_ids":[12,18,878],"id":157336,"title":"Interstellar","original_language":"en","original_title":"Interstellar","overview":"Ziemia w niedalekiej przyszłości. Planeta jest sukcesywnie niszczona przez klęski suszy, a ludziom grozi wyginięcie. Nieoczekiwanie naukowcy odkrywają możliwość podróżowania poza granice Układu Słonecznego. Grupa astronautów wyrusza w najważniejszą w dziejach ludzkości podróż – muszą znaleźć miejsce, gdzie nasz gatunek będzie mógł przetrwać. Na czele załogi staje Cooper, były pilot NASA, który obecnie zajmuje się uprawą roli.","popularity":75.6661,"poster_path":"/q4emCJmjNomEE2pVGgqr3nDEIzI.jpg","release_date":"2014-11-05","softcore":false,"video":false,"vote_average":8.5,"vote_count":40597,"credit_id":"5e83abfad236e60017fd99ed","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/yf5I5VHllK4h5VdbxHfQ40RBTe8.jpg","genre_ids":[18,53],"id":11660,"title":"Śledząc","original_language":"en","original_title":"Following","overview":"Starszy mężczyzna słucha historii Billa o życiu scenarzysty, który lubi podążać za obcymi w Londynie i ich obserwować. Pewnego dnia między pewnym siebie człowiekiem, którego Bill obserwował, i Billem, dochodzi do konfrontacji. Mężczyzna jest włamywaczem; postanawia wziąć Billa pod swoje skrzydła i pokazać mu, jak należy się włamywać do domów. Włamują się do domu pewnej kobiety. Bill jest nią zaintrygowany (wszędzie w jej mieszkaniu są zdjęcia). Odnajduje kobietę, i rozmawia z nią w barze, którego właścicielem jest jej były chłopak. Wkrótce Bill zostaje wmieszany w sprawy tej kobiety.","popularity":7.246,"poster_path":"/pZnfUffNIkeHB1gi2Lr31VNEIl.jpg","release_date":"1999-04-02","softcore":false,"video":false,"vote_average":7.128,"vote_count":1910,"credit_id":"5e83adef6e3b68001464b8fc","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":505819,"title":"Cinema 16: European Short Films (U.S. Edition)","original_language":"en","original_title":"Cinema 16: European Short Films (U.S. Edition)","overview":"","popularity":1.0309,"poster_path":"/rQ884232vYo3pbm0Ov1bCrMy6Zp.jpg","release_date":"2007-09-25","softcore":false,"video":true,"vote_average":6.0,"vote_count":1,"credit_id":"5e83acc86e3b68001864b90b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/t1NlvLU5xJamUTPVwnWi2o9nR76.jpg","genre_ids":[27],"id":43629,"title":"Doodlebug","original_language":"en","original_title":"Doodlebug","overview":"","popularity":2.1523,"poster_path":"/cXDFFv6yZNW3vUHOKKUPJNnL0So.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":6.525,"vote_count":497,"credit_id":"5e83ae11c86b3a0011a73d94","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/8ZTVqvKDQ8emSGUEMjsS4yHAwrp.jpg","genre_ids":[28,878,12],"id":27205,"title":"Incepcja","original_language":"en","original_title":"Inception","overview":"Dom Cobb jest niezwykle sprawnym złodziejem, mistrzem w wydobywaniu wartościowych sekretów ukrytych głęboko w świadomości podczas fazy snu, kiedy umysł jest najbardziej wrażliwy. Wyjątkowe umiejętności Cobba uczyniły z niego ważnego gracza w świecie szpiegostwa przemysłowego, ale i najbardziej poszukiwanego zbiega, a za swoją pozycję zapłacił utratą wszystkiego, co kocha. Teraz Cobb otrzymuje szansę na odkupienie. Za sprawą jednego, ostatniego zadania może odzyskać stracone życie. Musi tylko wraz ze swym zespołem dokonać rzeczy niemożliwej: zamiast skraść myśl, zaszczepić ją w śpiącym umyśle. Jeśli im się to uda, dokonają zbrodni doskonałej. Jednak nawet najbardziej precyzyjne planowanie nie jest w stanie przygotować ich na spotkanie z niezwykłym przeciwnikiem, który potrafi przewidzieć każdy ich ruch. Wróg, którego tylko Cobb mógł się spodziewać.","popularity":59.7278,"poster_path":"/efvcvRgOAZgFC2hrPUa6YqrE1KG.jpg","release_date":"2010-07-15","softcore":false,"video":false,"vote_average":8.372,"vote_count":39747,"credit_id":"5e83ac2ee33f830018359a00","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9IIBboV7MCT0bTxzXHmWK1Hq558.jpg","genre_ids":[18,80,28],"id":272,"title":"Batman - Początek","original_language":"en","original_title":"Batman Begins","overview":"\"Batman Początek\", dzieło cenionego reżysera Christophera Nolana, odkrywa tajemnicę narodzin legendarnego Mrocznego Rycerza. Po tragicznej śmierci rodziców, rozczarowany życiem spadkobierca fortuny Wayne'ów, Bruce (Christian Bale), podróżuje po świecie szukając środków do walki z niesprawiedliwością po to, aby obrócić strach przeciw tym, którzy go sieją. Z pomocą zaufanego lokaja Alfreda (Michael Caine), detektywa Jima Gordona (Gary Oldman), oraz swego sprzymierzeńca Luciusa Foxa (Morgan Freeman), Wayne powraca do Gotham, aby powołać do życia swoje alter-ego: Batmana, zamaskowanego wojownika, który posługuje się siłą, intelektem i zaawansowaną bronią, aby zwalczać złowrogie siły, które zagrażają miastu.","popularity":29.1017,"poster_path":"/cub46jQ4bLQYYbpbSL9Q24wofS2.jpg","release_date":"2005-06-10","softcore":false,"video":false,"vote_average":7.729,"vote_count":22894,"credit_id":"5e83acf488bbe60018a69a1e","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jU8MC5uSgBkZXyZYGtZgMsMsfeN.jpg","genre_ids":[53,80,18],"id":320,"title":"Bezsenność","original_language":"en","original_title":"Insomnia","overview":"Doświadczony detektyw Will Dormer (Al Pacino) podczas wieloletniej pracy w policji widział wszystko, co wiąże się z ciemną stroną ludzkiej natury - przemoc, morderstwa, korupcję. Jednak dalej z zaangażowaniem poświęca się każdej kolejnej sprawie. Razem ze swoim partnerem Hape'm (Martin Donovan) jadą na Alaskę, aby tam szukać zabójcy nastoletniej dziewczyny. Głównym podejrzanym jest żyjący na odludziu autor powieści kryminalnych Walter Finch (Robin Williams). Podczas nieudanej zasadzki dochodzi do tragedii - Will przypadkowo zabija Hape'a. Dręczony wyrzutami sumienia oraz nasilająca się bezsennością, Walter staje się ofiarą intryg demonicznego pisarza i z każdym dniem coraz bardziej traci poczucie rzeczywistości.","popularity":10.4503,"poster_path":"/dVppgIoMNu3NvK3GThHdXjqOHYD.jpg","release_date":"2002-05-24","softcore":false,"video":false,"vote_average":6.955,"vote_count":5411,"credit_id":"5e83ad2e24f2ce0018710514","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7Wev9JMo6R5XAfz2KDvXb7oPMmy.jpg","genre_ids":[9648,53],"id":77,"title":"Memento","original_language":"en","original_title":"Memento","overview":"Mieszkający w San Francisco detektyw ubezpieczeniowy, Leonard Shelby, w wyniku wypadku traci tzw. pamięć krótkotrwałą. Wie, kim jest i pamięta wszystko sprzed wypadku, ale błyskawicznie zapomina o tym, co wydarzyło się przed chwilą. Nie wie gdzie był, co robił i planował. Przy dłuższej rozmowie zapomina od czego się zaczęła. Powracające wspomnienia śmierci żony powodują, że nie daje za wygraną. Notatki, zdjęcia i tatuaże zastępują mu pamięć. Jedyną motywacją do życia jest obsesyjne pragnienie zemsty na mordercy ukochanej kobiety.","popularity":24.5041,"poster_path":"/nzlv62aC0octS5AklAiWpXLX9Z0.jpg","release_date":"2000-10-11","softcore":false,"video":false,"vote_average":8.174,"vote_count":16502,"credit_id":"5e83ad65e33f83001435a709","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/t1NlvLU5xJamUTPVwnWi2o9nR76.jpg","genre_ids":[27],"id":43629,"title":"Doodlebug","original_language":"en","original_title":"Doodlebug","overview":"","popularity":2.1523,"poster_path":"/cXDFFv6yZNW3vUHOKKUPJNnL0So.jpg","release_date":"1997-01-01","softcore":false,"video":false,"vote_average":6.525,"vote_count":497,"credit_id":"5e83ae1b24f2ce00137104f0","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/z3br1ub7spqGMkxgjgJSdM4DC21.jpg","genre_ids":[18,9648,878],"id":1124,"title":"Prestiż","original_language":"en","original_title":"The Prestige","overview":"Tajemnicza opowieść o dwóch iluzjonistach między którymi rodzi się zażarta rywalizacja, która przeradza się w wojnę na sztuczki i nieposkromione pragnienie odkrycia tajemnic zawodowych rywala. Gdy nadchodzi chwila konfrontacji obu bohaterów - odwagi z pragnieniem, estradowego talentu z nauką i ambicji z przyjaźnią - skutki stają się śmiertelnie niebezpieczne.","popularity":31.7177,"poster_path":"/osBXpsFTRtpXpnxo81XRceymWNj.jpg","release_date":"2006-10-19","softcore":false,"video":false,"vote_average":8.211,"vote_count":17859,"credit_id":"5e83ad1888bbe60013a69c6b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dqK9Hag1054tghRQSqLSfrkvQnA.jpg","genre_ids":[28,80,53],"id":155,"title":"Mroczny Rycerz","original_language":"en","original_title":"The Dark Knight","overview":"Kontynuacja filmu \"Batman: Początek\", \"Mroczny Rycerz\", to kolejne wspólne dzieło reżysera Christophera Nolana i gwiazdora Christiana Bale'a, który ponownie wciela się w postać Batmana / Bruce'a Wayne'a toczącego zażartą wojnę ze światem przestępczym. Batmanowi udaje się na dobre rozbić kryminalne podziemie Gotham z pomocą porucznika Jima Gordona (Gary Oldman) i Prokuratora Okręgowego Harveya Denta (Aaron Eckhart). Ich współpraca okazuje się niezwykle skuteczna, ale szybko trzej mężczyźni stają się celem nowego geniusza zbrodni, Jokera (Heath Ledger), którego celem jest wprowadzenie w Gotham anarchii i zmuszenie Batmana, by ten przeszedł na stronę zła, przestał być bohaterem, a stał się złoczyńcą.","popularity":60.8267,"poster_path":"/gKMDmGde8aAD8M6dvm6j7wciSbJ.jpg","release_date":"2008-07-16","softcore":false,"video":false,"vote_average":8.534,"vote_count":36273,"credit_id":"5e83ac8b6e3b68001464b691","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dqK9Hag1054tghRQSqLSfrkvQnA.jpg","genre_ids":[28,80,53],"id":155,"title":"Mroczny Rycerz","original_language":"en","original_title":"The Dark Knight","overview":"Kontynuacja filmu \"Batman: Początek\", \"Mroczny Rycerz\", to kolejne wspólne dzieło reżysera Christophera Nolana i gwiazdora Christiana Bale'a, który ponownie wciela się w postać Batmana / Bruce'a Wayne'a toczącego zażartą wojnę ze światem przestępczym. Batmanowi udaje się na dobre rozbić kryminalne podziemie Gotham z pomocą porucznika Jima Gordona (Gary Oldman) i Prokuratora Okręgowego Harveya Denta (Aaron Eckhart). Ich współpraca okazuje się niezwykle skuteczna, ale szybko trzej mężczyźni stają się celem nowego geniusza zbrodni, Jokera (Heath Ledger), którego celem jest wprowadzenie w Gotham anarchii i zmuszenie Batmana, by ten przeszedł na stronę zła, przestał być bohaterem, a stał się złoczyńcą.","popularity":60.8267,"poster_path":"/gKMDmGde8aAD8M6dvm6j7wciSbJ.jpg","release_date":"2008-07-16","softcore":false,"video":false,"vote_average":8.534,"vote_count":36273,"credit_id":"5f27d6a1d9403500375f670a","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/wgVBPD10YEENLqVKcT1cYb4plJH.jpg","genre_ids":[16,18,14],"id":622678,"title":"The Doll's Breath","original_language":"en","original_title":"The Doll's Breath","overview":"","popularity":0.698,"poster_path":"/c0kaZzzx8wpKrx2mC20z4W1Tz3n.jpg","release_date":"2019-09-11","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"credit_id":"5f673f2edbcade00362954d7","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"5f66865ae04d8a003a2c84d5","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":"/13Nz8EchKRdCgJcKdEoJAnpiVn2.jpg","genre_ids":[28,12,14],"id":791373,"title":"Liga Sprawiedliwości Zacka Snydera","original_language":"en","original_title":"Zack Snyder's Justice League","overview":"W filmie \"Liga Sprawiedliwości Zacka Snydera\" Bruce Wayne, chcąc mieć pewność, że poświęcenie Supermana nie poszło na marne, łączy siły z Dianą Prince, by zwerbować zespół superbohaterów, którzy ochronią świat przed zbliżającym się niebezpieczeństwem o katastrofalnych rozmiarach. Zadanie okazuje się jednak trudniejsze, niż to sobie wyobrażał, ponieważ każdy z członków tej ekipy musi stawić czoła demonom własnej przeszłości. Tylko pokonanie tych przeszkód, pozwoli im stworzyć bezprecedensową grupę bohaterów. Może być jednak za późno, by w końcu zjednoczeni - Batman, Wonder Woman, Aquaman, Cyborg i Flash, byli w stanie uratować planetę przed Steppenwolfem, DeSaadem, Darkseidem i ich zbrodniczymi zamiarami.","popularity":19.7621,"poster_path":"/zvugkRK6vpbPBv63jETof2ZIf9f.jpg","release_date":"2021-03-18","softcore":false,"video":false,"vote_average":8.083,"vote_count":10987,"credit_id":"601461580816c70042848352","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/y2DB71C4nyIdMrANijz8mzvQtk6.jpg","genre_ids":[28,80,18,53],"id":49026,"title":"Mroczny Rycerz powstaje","original_language":"en","original_title":"The Dark Knight Rises","overview":"Po upływie ośmiu lat od wydarzeń z \"Mrocznego Rycerza\" w Gotham panuje pokój. Dzięki Ustawie Denta udało się rozbić przestępczość zorganizowaną, a najgorszych złoczyńców osadzono w Blackgate. Mając świadomość, że stabilizacja oparta jest na kłamstwie, Bruce Wayne całkowicie wycofał się z życia publicznego. Teraz całe dnie spędza w swojej rezydencji, a Wayne Enterprises zaczyna podupadać. Uwagę Bruce'a wzbudza jednak Selina Kyle, sprytna i bezczelna włamywaczka, działająca według własnego kodeksu. Ciąg wydarzeń z jej udziałem sprawia, że komisarz Jim Gordon wpada na trop tajemniczego spisku i grupy najemników dowodzonych przez Bane'a, brutalnego terrorystę mającego powiązania z Ligą Cieni. Chcąc chronić miasto, Bruce decyduje się ponownie założyć kostium Batmana. Zagrożenie okazuje się jednak większe, niż ktokolwiek mógłby przypuszczać, a Mroczny Rycerz staje przed najtrudniejszym wyzwaniem w swoim życiu.","popularity":32.1221,"poster_path":"/oWIhEWtHbSlvttp5qbBEutPOV7G.jpg","release_date":"2012-07-17","softcore":false,"video":false,"vote_average":7.796,"vote_count":24647,"credit_id":"6044f4f8c4ad590058f9c3fd","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sSIzzVhhLfgLKVBcAUv0X6cLYz9.jpg","genre_ids":[12,28,14],"id":1368337,"title":"Odyseja","original_language":"en","original_title":"The Odyssey","overview":"Odyseusz, legendarny grecki król Itaki, po wojnie trojańskiej wyrusza w długą i niebezpieczną podróż do domu, opisując swoje spotkania z mitycznymi istotami, takimi jak cyklop Polifem, syreny i czarownica-bogini Circe.","popularity":1053.6131,"poster_path":"/1g2v4Gg8kVe6P1p5Tz5IA69BPBN.jpg","release_date":"2026-07-15","softcore":false,"video":false,"vote_average":7.953,"vote_count":2169,"credit_id":"671d0fe427bd57d91f62cdda","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sSIzzVhhLfgLKVBcAUv0X6cLYz9.jpg","genre_ids":[12,28,14],"id":1368337,"title":"Odyseja","original_language":"en","original_title":"The Odyssey","overview":"Odyseusz, legendarny grecki król Itaki, po wojnie trojańskiej wyrusza w długą i niebezpieczną podróż do domu, opisując swoje spotkania z mitycznymi istotami, takimi jak cyklop Polifem, syreny i czarownica-bogini Circe.","popularity":1053.6131,"poster_path":"/1g2v4Gg8kVe6P1p5Tz5IA69BPBN.jpg","release_date":"2026-07-15","softcore":false,"video":false,"vote_average":7.953,"vote_count":2169,"credit_id":"671e82155d0de89042d97484","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/sSIzzVhhLfgLKVBcAUv0X6cLYz9.jpg","genre_ids":[12,28,14],"id":1368337,"title":"Odyseja","original_language":"en","original_title":"The Odyssey","overview":"Odyseusz, legendarny grecki król Itaki, po wojnie trojańskiej wyrusza w długą i niebezpieczną podróż do domu, opisując swoje spotkania z mitycznymi istotami, takimi jak cyklop Polifem, syreny i czarownica-bogini Circe.","popularity":1053.6131,"poster_path":"/1g2v4Gg8kVe6P1p5Tz5IA69BPBN.jpg","release_date":"2026-07-15","softcore":false,"video":false,"vote_average":7.953,"vote_count":2169,"credit_id":"671f2df59ff681d9e0a49013","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1399362,"title":"Fearville","original_language":"en","original_title":"Fearville","overview":"","popularity":0.9312,"poster_path":null,"release_date":"1997-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6755ea7fe3b9b3f914553f74","department":"Camera","job":"Camera Operator"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1552032,"title":"Domchilik","original_language":"uz","original_title":"Domchilik","overview":"","popularity":2.5209,"poster_path":"/byktFVR0CvhG3Rh37Y9p899Wxhs.jpg","release_date":"2024-07-07","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"68d51bc65c1f8a679edb589b","department":"Writing","job":"Idea"},{"adult":false,"backdrop_path":"/nAxGnGHOsfzufThz20zgmRwKur3.jpg","genre_ids":[27,28,53],"id":1233413,"title":"Grzesznicy","original_language":"en","original_title":"Sinners","overview":"Chcąc zostawić za sobą burzliwą przeszłość, bracia bliźniacy wracają do rodzinnego miasta, żeby zacząć życie od nowa. Na miejscu przekonują się, że czeka na nich jeszcze gorsze zło.","popularity":36.4,"poster_path":"/xX737WktKAaCfPMTPVZMqyQna2Y.jpg","release_date":"2025-04-16","softcore":false,"video":false,"vote_average":7.5,"vote_count":4915,"credit_id":"6930de0c0cd01b8e2b336f96","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/ArBSyfVp4oEaDPJjkDPebEZu0KD.jpg","genre_ids":[99],"id":352114,"title":"Quay","original_language":"en","original_title":"Quay","overview":"","popularity":1.8793,"poster_path":"/uluMeKfYFVvfZlmHgFBXqbnHXE2.jpg","release_date":"2015-08-19","softcore":false,"video":false,"vote_average":6.056,"vote_count":71,"credit_id":"69444ad95b112b208336aaa7","department":"Art","job":"Decorator"},{"adult":false,"backdrop_path":"/s6k2vuYatYbrwnoPH26eQc7ErqY.jpg","genre_ids":[878,27],"id":1066313,"title":"Setan Alas!","original_language":"id","original_title":"Setan Alas!","overview":"","popularity":2.3878,"poster_path":"/iqr2HSY0NC3U0x5t9M5RRAnmr3i.jpg","release_date":"2023-11-27","softcore":false,"video":false,"vote_average":5.3,"vote_count":11,"credit_id":"69ad19e33b8575d0b04eab3f","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/9XAC1KlUFlEfwtPA3VVhTQqJs3o.jpg","genre_ids":[16,14,18,27],"id":423881,"title":"Sanatorium pod Klepsydrą według braci Quay","original_language":"pl","original_title":"Sanatorium pod Klepsydrą","overview":"Mężczyzna podróżuje koleją do bezimiennego sanatorium, w którym niedawno zmarł jego ojciec. Po dotarciu na miejsce czas traci swoją liniowość, a on sam znajduje się w świecie, który wydaje się zarówno dziwny, jak i dziwnie znajomy.","popularity":1.3609,"poster_path":"/cC0wNYhtDLFUnLKEUji2Rip7NmG.jpg","release_date":"2025-04-11","softcore":false,"video":false,"vote_average":5.8,"vote_count":11,"credit_id":"69fb011f3c674f4c79cd0dc2","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/sSIzzVhhLfgLKVBcAUv0X6cLYz9.jpg","genre_ids":[12,28,14],"id":1368337,"title":"Odyseja","original_language":"en","original_title":"The Odyssey","overview":"Odyseusz, legendarny grecki król Itaki, po wojnie trojańskiej wyrusza w długą i niebezpieczną podróż do domu, opisując swoje spotkania z mitycznymi istotami, takimi jak cyklop Polifem, syreny i czarownica-bogini Circe.","popularity":1053.6131,"poster_path":"/1g2v4Gg8kVe6P1p5Tz5IA69BPBN.jpg","release_date":"2026-07-15","softcore":false,"video":false,"vote_average":7.953,"vote_count":2169,"credit_id":"6a6067e765b65297ead3b79f","department":"Sound","job":"Songs"},{"adult":false,"backdrop_path":"/eK7hCwoqkCM1dWzuWiY4jURSdK4.jpg","genre_ids":[27],"id":1736356,"title":"The Spot","original_language":"en","original_title":"The Spot","overview":"","popularity":1.1598,"poster_path":"/yy9Pw69PrdQbNPVEkFKEevCTNXY.jpg","release_date":"2023-10-13","softcore":false,"video":false,"vote_average":10.0,"vote_count":1,"credit_id":"6a621f54b0a2b84a2eff2419","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/yf5I5VHllK4h5VdbxHfQ40RBTe8.jpg","genre_ids":[18,53],"id":11660,"title":"Śledząc","original_language":"en","original_title":"Following","overview":"Starszy mężczyzna słucha historii Billa o życiu scenarzysty, który lubi podążać za obcymi w Londynie i ich obserwować. Pewnego dnia między pewnym siebie człowiekiem, którego Bill obserwował, i Billem, dochodzi do konfrontacji. Mężczyzna jest włamywaczem; postanawia wziąć Billa pod swoje skrzydła i pokazać mu, jak należy się włamywać do domów. Włamują się do domu pewnej kobiety. Bill jest nią zaintrygowany (wszędzie w jej mieszkaniu są zdjęcia). Odnajduje kobietę, i rozmawia z nią w barze, którego właścicielem jest jej były chłopak. Wkrótce Bill zostaje wmieszany w sprawy tej kobiety.","popularity":7.246,"poster_path":"/pZnfUffNIkeHB1gi2Lr31VNEIl.jpg","release_date":"1999-04-02","softcore":false,"video":false,"vote_average":7.128,"vote_count":1910,"credit_id":"6a6fa5544ecd3fbc6afc71d0","department":"Writing","job":"Writer"}],"id":525}