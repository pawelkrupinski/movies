ty":0.9785,"poster_path":null,"release_date":"2026-06-28","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Himself","credit_id":"6a55051474daddf54efbf83d","order":4},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1731617,"title":"Masques, Monsters and Madmen Part 1: The Drive-in Era","original_language":"en","original_title":"Masques, Monsters and Madmen Part 1: The Drive-in Era","overview":"","popularity":0.8224,"poster_path":"/heZ4khJYKwz1Xx3eNK5FTAnVXJU.jpg","release_date":"2026-02-06","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6a565328934252192dc0ef7f","order":5},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1731626,"title":"Deep Cuts: The Censorship System in the U.S.","original_language":"en","original_title":"Deep Cuts: The Censorship System in the U.S.","overview":"","popularity":0.7793,"poster_path":"/heZ4khJYKwz1Xx3eNK5FTAnVXJU.jpg","release_date":"2026-02-06","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6a56661d71325fca2a014fae","order":3}],"crew":[{"adult":false,"backdrop_path":"/jhk6D8pim3yaByu1801kMoxXFaX.jpg","genre_ids":[28,18,12],"id":98,"title":"Gladiator","original_language":"en","original_title":"Gladiator","overview":"Generał Maximus zakończył kolejną udaną wyprawę wojenną. Zmuszony do ucieczki przez zazdrosnego o jego wpływy u Cesarza dziedzica tronu Commodusa, Maximus trafia do niewoli i zostaje gladiatorem. Powraca do Rzymu z zamiarem pomszczenia śmierci syna i żony. Wie, że jedyną siłą potężniejszą od samego Cesarza jest wola ludu, może dokonać swej zemsty, zostając największym bohaterem całego Imperium. \"Gladiator\" to epicka opowieść o odwadze i zemście osadzona w realiach Cesarstwa Rzymskiego roku 180 n.e.","popularity":41.7382,"poster_path":"/1f0U34P6OFPXvfQta556VfXZqiC.jpg","release_date":"2000-05-04","softcore":false,"video":false,"vote_average":8.23,"vote_count":21198,"credit_id":"52fe4217c3a36847f800342b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/6z9w8eidKWDDXwZNSVNaRolAYEP.jpg","genre_ids":[878,28,12,53],"id":201,"title":"Star Trek: Nemesis","original_language":"en","original_title":"Star Trek: Nemesis","overview":"Obrawszy kurs na galaktykę niespotykanej akcji i przygody kapitan Jean-Luc Picard (Patrick Stewart) i załoga jego krążownika toczy walkę z przerażającym nowym wrogiem... połączonym szokującą więzią z Picardem!  W przeddzień radosnego ślubu Rikera (Jonathan Frakes) i Troi (Marina Sirtis), Picard ma jeszcze jeden powód do świętowania: Romulanie pragną pokoju a kapitan zostaje mianowany emisariuszem Federacji. Ale kiedy Enterprise udaje się w kierunku Imperium Romulanów, czeka nań przebiegły wróg kryjący diaboliczny plan destrukcji i niewyobrażalny sekret, który postawi Picarda w obliczu straszliwego wyzwania.  W filmie wystąpili również: Brent Spiner, LeVar Burton, Michael Dorn, Gates McFadden oraz debiutujący Tom Hardy jako śmiertelny wróg Picarda. „Star Trek: Nemesis\" to dzieło „Ekscytujące! Skrzące pomysłami i nieoczekiwanymi zwrotami akcji od początku do końca filmu!\"","popularity":10.1997,"poster_path":"/cldAwhvBmOv9jrd3bXWuqRHoXyq.jpg","release_date":"2002-12-13","softcore":false,"video":false,"vote_average":6.298,"vote_count":1615,"credit_id":"52fe4226c3a36847f8007ced","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/z354BaTVzKj7E60WLzDoSmUuO4u.jpg","genre_ids":[18,28,10752],"id":616,"title":"Ostatni samuraj","original_language":"en","original_title":"The Last Samurai","overview":"Tom Cruise wciela się w rolę kpt. Nathana Algrena, bohatera Wojny Secesyjnej, który wyrusza do Japonii, by walczyć przeciwko Samurajom. Po pewnym czasie staje się jednak ich sprzymierzeńcem. Ken Watanabe (wyróżniony nominacją do Oscara®) gra Katsumoto, przywódcę Samurajów, których wspaniała kultura powoli odchodzi w zapomnienie. Jego losy nierozerwalnie splatają się z losami amerykańskiego kapitana.","popularity":14.4528,"poster_path":"/9VZ4SeTxgu0iBR8Q3BtHYhj0Lnw.jpg","release_date":"2003-12-05","softcore":false,"video":false,"vote_average":7.613,"vote_count":7665,"credit_id":"52fe425ec3a36847f8018e0d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/z7oaOABTOvKK01XqA1BlE9VybYc.jpg","genre_ids":[27,53,878],"id":10496,"title":"Nietoperze","original_language":"en","original_title":"Bats","overview":"W wyniku błędu w tajnym eksperymencie rządowym powstaje nowa odmiana nietoperzy. Zwierzęta te okazują się wyjątkowo inteligentne i agresywne. Pewnego dnia wydostają się z laboratorium i atakują mieszkańców małego miasteczka w Teksasie. Bezradny szeryf prosi o pomoc naukowców. Doktor Sheila Casper i jej asystent próbują zapobiec tragedii...","popularity":2.1646,"poster_path":"/pZRcf2BwcxWg594X6XT2jkR2qdb.jpg","release_date":"1999-10-22","softcore":false,"video":false,"vote_average":4.6,"vote_count":218,"credit_id":"52fe437b9251416c750120f5","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/i0eOILDW8HipIkOUSKhB1dvZzNJ.jpg","genre_ids":[878,12,28],"id":2135,"title":"Wehikuł Czasu","original_language":"en","original_title":"The Time Machine","overview":"Co się stało, to się nie odstanie. Ale czy na pewno? Alexander Hartdegen (Guy Pearce) przeżył osobistą tragedię. Chcąc zapobiec temu, co się stało, buduje niezwykłą maszynę, która pozwala mu podróżować w czasie.  \"Wehikuł Czasu\" to ekranizacja klasycznej powieści fantastycznej H.G. Wellsa (sfilmowanej wcześniej w 1960 r.), którą wyreżyserował prawnuk pisarza, Simon Wells. Guy Pearce wciela się w rolę profesora  Hartdegena, nowojorskiego wynalazcy z początku XX wieku, który wyrusza w przeszłość, a potem w przyszłość, by na własne oczy przekonać się, jak wyglądać będzie nasz świat za 800000 lat.  [opis dystrybutora dvd]","popularity":8.7504,"poster_path":"/fjv8RvvnCorTnT8A67OPGdLFewW.jpg","release_date":"2002-03-04","softcore":false,"video":false,"vote_average":6.334,"vote_count":2602,"credit_id":"52fe4339c3a36847f8043c03","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/5spmzlcl3GmtMwQfptTVgMwdM3.jpg","genre_ids":[27,9648],"id":816977,"title":"They/Them","original_language":"en","original_title":"They/Them","overview":"Grupa osób LGBTQ+ przyjeżdża na obóz terapii konwersyjnej, który obiecuje zmienę orientacji w tydzień. Nagle zaczyna dochodzić do morderstw.","popularity":3.8304,"poster_path":"/85TJ4udfUOwFIlvQL6EMFvvbvN5.jpg","release_date":"2022-07-24","softcore":false,"video":false,"vote_average":4.731,"vote_count":258,"credit_id":"6071dd9c1da7a600589830df","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lqASDYSyYMgC1gYY7VHqK9Tnv0I.jpg","genre_ids":[18],"id":9563,"title":"Męska gra","original_language":"en","original_title":"Any Given Sunday","overview":"Akcja filmu rozgrywa się w środowisku amerykańskiego futbolu. Miejsce legendarnego zawodnika w drużynie Miami zajmuje młody i utalentowany gracz. Jego gra nadaje sens pracy podstarzałego trenera, znajdującego się pod presją żądnej zwycięstw zespołu nowej współwłaścicielki drużyny.","popularity":6.1067,"poster_path":"/qdbckqY1JRNVR1Cd3deBj30yFCZ.jpg","release_date":"1999-12-22","softcore":false,"video":false,"vote_average":6.825,"vote_count":1850,"credit_id":"52fe450ac3a36847f80b8d45","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/obYVvi6eD4rjFeC7g4uoZQPIh7F.jpg","genre_ids":[18,27],"id":13885,"title":"Sweeney Todd: Demoniczny golibroda z Fleet Street","original_language":"en","original_title":"Sweeney Todd: The Demon Barber of Fleet Street","overview":"Benjamin Barker został niesłusznie oskarżony o przestępstwo i skazany na wygnanie. Wyrok wydał sędzia Turpin, który wykorzystał stanowisko i wpływy, by pozbyć się Barkera, a następnie zgwałcił jego żonę i porwał córkę. Pod przybranym nazwiskiem, jako Sweeney Todd, Barker wraca do stolicy. Pełen nienawiści planuje zemstę. Wspólnie z panią Lovett otwiera salon, w którym strzyże i goli mężczyzn, ale żaden z klientów nigdy nie opuszcza zakładu. Tymczasem doskonałe wypieki pani Lovett, z zagadkowym nadzieniem, zdobywają ogromne uznanie londyńczyków.","popularity":7.8948,"poster_path":"/gAW4J1bkRjZKmFsJsIiOBASeoAp.jpg","release_date":"2007-12-21","softcore":false,"video":false,"vote_average":7.182,"vote_count":6414,"credit_id":"52fe45af9251416c7505efe7","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/j8isWEPL3PmmVh8ap3jm75qVF4p.jpg","genre_ids":[28,12,16,10751,14],"id":14411,"title":"Sindbad: Legenda siedmiu mórz","original_language":"en","original_title":"Sinbad: Legend of the Seven Seas","overview":"Sindbad musi odszukać Księgę Pokoju, o której kradzież go posądzono. Odzyskanie jej nie jest łatwe. Na drodze żeglarza staje wiele morskich potworów. Podróż dodatkowo utrudnia mu bogini Eris, która za wszelką cenę pragnie przeszkodzić Sindbadowi i jego załodze. W podróży towarzyszy mu piękna Marina, która pokazuje, że kobieta na pokładzie statku nie jest ciężarem lecz członkiem załogi.","popularity":8.4223,"poster_path":"/2rxlHlLRhZdDn1A39VbLA1g9JL9.jpg","release_date":"2003-07-02","softcore":false,"video":false,"vote_average":7.053,"vote_count":2258,"credit_id":"52fe45f09251416c75067aed","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/Aj81Gu3u1a64qXFOLDuF5gdxyy0.jpg","genre_ids":[12,18,10751],"id":44826,"title":"Hugo i jego wynalazek","original_language":"en","original_title":"Hugo","overview":"Film zrealizowany na podstawie książki Briana Selznicka. Bohaterem jest Hugo - sierota mieszkający w korytarzach ukrytych w murach paryskiego dworca, gdzie jego życie zależy od zachowania anonimowości. Kiedy jednak jego losy zazębiają się z życiem pewnej dziewczynki (Izabelle) kochającej książki oraz starca prowadzącego na dworcu sklepik z zabawkami, jego podziemne życie zostanie zagrożone. Tajemniczy rysunek, notes, skradziony klucz, mechaniczny człowiek i ukryta wiadomość od nieżyjącego ojca Hugona to elementy tworzące szkielet tej pięknej historii.","popularity":8.031,"poster_path":"/1dxRq3o3l3bVWNRvvSb7rRf68qp.jpg","release_date":"2011-11-22","softcore":false,"video":false,"vote_average":7.175,"vote_count":7743,"credit_id":"52fe469ec3a36847f8108b7b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/mOtKQlXdL5J4lwqcSFlkZmgmFeZ.jpg","genre_ids":[16,35,10751,37,12],"id":44896,"title":"Rango","original_language":"en","original_title":"Rango","overview":"Kameleon Rango przechodzi swój trudny okres. Jego głównym zajęciem jest tułaczka po pustyni Mojave. Dochodzi on do pewnego miasteczka opanowanego przez bandytów i kryminalistów. Wkrótce postanawia zostać stróżem prawa w owej mieścinie, aby zwalczać złych, a pomagać dobrym.","popularity":15.2998,"poster_path":"/A5MP1guV8pbruieG0tnpPIbaJtt.jpg","release_date":"2011-03-02","softcore":false,"video":false,"vote_average":6.911,"vote_count":7221,"credit_id":"52fe46a2c3a36847f8109acb","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/mOtKQlXdL5J4lwqcSFlkZmgmFeZ.jpg","genre_ids":[16,35,10751,37,12],"id":44896,"title":"Rango","original_language":"en","original_title":"Rango","overview":"Kameleon Rango przechodzi swój trudny okres. Jego głównym zajęciem jest tułaczka po pustyni Mojave. Dochodzi on do pewnego miasteczka opanowanego przez bandytów i kryminalistów. Wkrótce postanawia zostać stróżem prawa w owej mieścinie, aby zwalczać złych, a pomagać dobrym.","popularity":15.2998,"poster_path":"/A5MP1guV8pbruieG0tnpPIbaJtt.jpg","release_date":"2011-03-02","softcore":false,"video":false,"vote_average":6.911,"vote_count":7221,"credit_id":"52fe46a2c3a36847f8109ae5","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/jl4AOwQ6nxt8yXfVJvjHsKSaV7a.jpg","genre_ids":[18,53],"id":101173,"title":"Koriolan","original_language":"en","original_title":"Coriolanus","overview":"Debiut reżyserski jednego z najznakomitszych aktorów brytyjskich - nominowanego do Oscara za role w \"Liście Schindlera\" i \"Angielskim pacjencie\" Ralpha Fiennesa. \"Koriolan\" to najnowocześniejsza od czasu \"Romea i Julii\" Baza Luhrmana, ociekająca testosteronem ekranizacja dzieła Szekspira, ukazującego krwawą zemstę generała Gnejusza Marcjusza na niewdzięcznych mieszkańcach Wiecznego Miasta, którzy pozbawiają go szans na objęcie najwyższej władzy w Rzymie. Wygnany i upokorzony przyłącza się do armii Wolsków pod wodzą Aufidiusza, by wspólnie przypuścić spektakularny atak na miasto, które haniebnie zdradziło swojego obrońcę.","popularity":3.2856,"poster_path":"/8lf6cZ1SfGvqUgWhx68cmsFdYKZ.jpg","release_date":"2011-02-14","softcore":false,"video":false,"vote_average":5.835,"vote_count":508,"credit_id":"52fe49e9c3a36847f81ad01d","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/jl4AOwQ6nxt8yXfVJvjHsKSaV7a.jpg","genre_ids":[18,53],"id":101173,"title":"Koriolan","original_language":"en","original_title":"Coriolanus","overview":"Debiut reżyserski jednego z najznakomitszych aktorów brytyjskich - nominowanego do Oscara za role w \"Liście Schindlera\" i \"Angielskim pacjencie\" Ralpha Fiennesa. \"Koriolan\" to najnowocześniejsza od czasu \"Romea i Julii\" Baza Luhrmana, ociekająca testosteronem ekranizacja dzieła Szekspira, ukazującego krwawą zemstę generała Gnejusza Marcjusza na niewdzięcznych mieszkańcach Wiecznego Miasta, którzy pozbawiają go szans na objęcie najwyższej władzy w Rzymie. Wygnany i upokorzony przyłącza się do armii Wolsków pod wodzą Aufidiusza, by wspólnie przypuścić spektakularny atak na miasto, które haniebnie zdradziło swojego obrońcę.","popularity":3.2856,"poster_path":"/8lf6cZ1SfGvqUgWhx68cmsFdYKZ.jpg","release_date":"2011-02-14","softcore":false,"video":false,"vote_average":5.835,"vote_count":508,"credit_id":"52fe49e9c3a36847f81ad001","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/5spmzlcl3GmtMwQfptTVgMwdM3.jpg","genre_ids":[27,9648],"id":816977,"title":"They/Them","original_language":"en","original_title":"They/Them","overview":"Grupa osób LGBTQ+ przyjeżdża na obóz terapii konwersyjnej, który obiecuje zmienę orientacji w tydzień. Nagle zaczyna dochodzić do morderstw.","popularity":3.8304,"poster_path":"/85TJ4udfUOwFIlvQL6EMFvvbvN5.jpg","release_date":"2022-07-24","softcore":false,"video":false,"vote_average":4.731,"vote_count":258,"credit_id":"627e398dcaa50813cfa537f9","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/8lBViysvNJBPkl6zG1LVAaW3qhj.jpg","genre_ids":[28,12,53],"id":206647,"title":"Spectre","original_language":"en","original_title":"Spectre","overview":"Za sprawą zaszyfrowanej wiadomości z przeszłości James Bond wyrusza z samotną misją do Mexico City, a następnie do Rzymu, gdzie poznaje Lucię Sciarrę, piękną wdowę po słynnym przestępcy. Bond przenika na tajne spotkanie i odkrywa istnienie potężnej i złowrogiej organizacji Spectre. Tymczasem w Londynie, Max Denbigh, nowy szef Centrum Bezpieczeństwa Narodowego, kwestionuje działania Bonda i zasadność istnienia kierowanego przez M MI6. Bond potajemnie werbuje Moneypenny i Q, by pomogli mu w odszukaniu niejakiej Madeleine Swann, córki swego starego wroga, znanego, jako Mr. White, która może posiadać wskazówki, jak zniszczyć Spectre. Gdy Bond zbliża się do samego serca organizacji, odkrywa szokujący, przerażający związek między sobą, a ściganym wrogiem, w którego brawurowo wcielił się Christoph Waltz.","popularity":12.3398,"poster_path":"/rhVQtNDiibrnGTuH80v8OEKD1w5.jpg","release_date":"2015-10-26","softcore":false,"video":false,"vote_average":6.571,"vote_count":11364,"credit_id":"52fe4d22c3a368484e1d8d8d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/pArPMLvKOKfF2waNpkhOPncxPo1.jpg","genre_ids":[28,10770],"id":36983,"title":"Tornado!","original_language":"en","original_title":"Tornado!","overview":"","popularity":1.4279,"poster_path":"/kzQNHyfqdbUdpJqHyqtZSQYxq5F.jpg","release_date":"1996-05-06","softcore":false,"video":false,"vote_average":5.681,"vote_count":47,"credit_id":"5462a2f20e0a2678000007e9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/CSm8M4uj9ba5jVVhbeBbg9hCyJ.jpg","genre_ids":[36,18],"id":267192,"title":"Geniusz","original_language":"en","original_title":"Genius","overview":"Historia skomplikowanej relacji słynnego amerykańskiego pisarza Thomasa Wolfe’a i jego wydawcy, Maksa Perkinsa, który odkrył dla świata takich literackich gigantów, jak F. Scott Fitzgerald i Ernest Hemingway. Zderzenie dwóch niezwykłych osobowości, bardzo różnych, a jednocześnie silnie na siebie oddziałujących. Kiedy pierwsza powieść Thomasa Wolfe’a trafiła do rąk Maksa Perkinsa, ten był już jednym z najbardziej uznanych wydawców swoich czasów. Opanowany i raczej introwertyczny Perkins był szczególnie dumny ze swojego literackiego odkrycia, choć Wolfe, ze swoim nieokiełznanym talentem i trudną do opanowania osobowością, nie ułatwiał mu życia. Niekonwencjonalna przyjaźń, jaka ich połączyła, odmieniła życie każdego z nich na zawsze.","popularity":3.9575,"poster_path":"/f3KG63zvQGvakfwOTUb8ODgHEnP.jpg","release_date":"2016-06-10","softcore":false,"video":false,"vote_average":6.484,"vote_count":728,"credit_id":"5553683bc3a3686341002094","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":923195,"title":"Untitled Gene Kelly Project","original_language":"en","original_title":"Untitled Gene Kelly Project","overview":"","popularity":0.9964,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"61d4b8f47b7b4d0094046893","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5spmzlcl3GmtMwQfptTVgMwdM3.jpg","genre_ids":[27,9648],"id":816977,"title":"They/Them","original_language":"en","original_title":"They/Them","overview":"Grupa osób LGBTQ+ przyjeżdża na obóz terapii konwersyjnej, który obiecuje zmienę orientacji w tydzień. Nagle zaczyna dochodzić do morderstw.","popularity":3.8304,"poster_path":"/85TJ4udfUOwFIlvQL6EMFvvbvN5.jpg","release_date":"2022-07-24","softcore":false,"video":false,"vote_average":4.731,"vote_count":258,"credit_id":"61d543679defda008d0046fe","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/obYVvi6eD4rjFeC7g4uoZQPIh7F.jpg","genre_ids":[18,27],"id":13885,"title":"Sweeney Todd: Demoniczny golibroda z Fleet Street","original_language":"en","original_title":"Sweeney Todd: The Demon Barber of Fleet Street","overview":"Benjamin Barker został niesłusznie oskarżony o przestępstwo i skazany na wygnanie. Wyrok wydał sędzia Turpin, który wykorzystał stanowisko i wpływy, by pozbyć się Barkera, a następnie zgwałcił jego żonę i porwał córkę. Pod przybranym nazwiskiem, jako Sweeney Todd, Barker wraca do stolicy. Pełen nienawiści planuje zemstę. Wspólnie z panią Lovett otwiera salon, w którym strzyże i goli mężczyzn, ale żaden z klientów nigdy nie opuszcza zakładu. Tymczasem doskonałe wypieki pani Lovett, z zagadkowym nadzieniem, zdobywają ogromne uznanie londyńczyków.","popularity":7.8948,"poster_path":"/gAW4J1bkRjZKmFsJsIiOBASeoAp.jpg","release_date":"2007-12-21","softcore":false,"video":false,"vote_average":7.182,"vote_count":6414,"credit_id":"566b50ab92514150010005fc","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ufSwlnECLoUbBjPrFqEQcWBzHwc.jpg","genre_ids":[10402,18],"id":936075,"title":"Michael","original_language":"en","original_title":"Michael","overview":"Film pokazuje historię Michaela Jacksona nie tylko przez pryzmat jego muzyki - od momentu, gdy został odkryty jako wokalista Jackson Five, aż po czasy, gdy stał się wizjonerem i dążył do tego, by zostać największym artystą rozrywkowym na świecie. Oprócz życia prywatnego, film przywołuje też jego najsłynniejsze występy z początków solowej kariery, dając widzom wyjątkową okazję, by zobaczyć Michaela Jacksona jak nigdy dotąd. To tutaj zaczyna się jego historia.","popularity":108.7248,"poster_path":"/zm0KAbOjlt9eR5y7vDiL2dEOwMl.jpg","release_date":"2026-04-22","softcore":false,"video":false,"vote_average":8.697,"vote_count":3847,"credit_id":"62018ab99d592c01187f48c9","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/CSm8M4uj9ba5jVVhbeBbg9hCyJ.jpg","genre_ids":[36,18],"id":267192,"title":"Geniusz","original_language":"en","original_title":"Genius","overview":"Historia skomplikowanej relacji słynnego amerykańskiego pisarza Thomasa Wolfe’a i jego wydawcy, Maksa Perkinsa, który odkrył dla świata takich literackich gigantów, jak F. Scott Fitzgerald i Ernest Hemingway. Zderzenie dwóch niezwykłych osobowości, bardzo różnych, a jednocześnie silnie na siebie oddziałujących. Kiedy pierwsza powieść Thomasa Wolfe’a trafiła do rąk Maksa Perkinsa, ten był już jednym z najbardziej uznanych wydawców swoich czasów. Opanowany i raczej introwertyczny Perkins był szczególnie dumny ze swojego literackiego odkrycia, choć Wolfe, ze swoim nieokiełznanym talentem i trudną do opanowania osobowością, nie ułatwiał mu życia. Niekonwencjonalna przyjaźń, jaka ich połączyła, odmieniła życie każdego z nich na zawsze.","popularity":3.9575,"poster_path":"/f3KG63zvQGvakfwOTUb8ODgHEnP.jpg","release_date":"2016-06-10","softcore":false,"video":false,"vote_average":6.484,"vote_count":728,"credit_id":"571b434d925141715d003e4d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/iXXPaQPfQowpQ5UvhsHLj9BgFhe.jpg","genre_ids":[27,878],"id":126889,"title":"Obcy: Przymierze","original_language":"en","original_title":"Alien: Covenant","overview":"\"Obcy: Przymierze\" to drugi rozdział nowej trylogii, którą zapoczątkował film \"Prometeusz\". Statek osadniczy \"Przymierze\" dociera na nieznaną planetę, która wydaje się być prawdziwym rajem. Członkowie ekspedycji szybko się jednak przekonują, że trafili do mrocznego, pełnego tajemnic i niebezpieczeństw świata, którego jedynym mieszkańcem jest android David (Michael Fassbender), ocalały z katastrofy \"Prometeusza\".","popularity":14.381,"poster_path":"/uTEvJeGNUFmCMIhFXxOoGLEzUfp.jpg","release_date":"2017-05-09","softcore":false,"video":false,"vote_average":6.183,"vote_count":9547,"credit_id":"592daa4a9251413912000525","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/oTEnEJaqSLC70oZVWHEHdEr8bBC.jpg","genre_ids":[18,53],"id":244562,"title":"Jamie Marks Is Dead","original_language":"en","original_title":"Jamie Marks Is Dead","overview":"","popularity":1.6411,"poster_path":"/q2hTW172Q7CSC0A5Lp6HAJ41XQr.jpg","release_date":"2014-07-28","softcore":false,"video":false,"vote_average":5.545,"vote_count":111,"credit_id":"595be9bec3a36828fc0547fc","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18,36,53,37],"id":1119304,"title":"Blood Meridian","original_language":"en","original_title":"Blood Meridian","overview":"","popularity":0.6396,"poster_path":"/tn4XzBCgzjXEsUiHBtLi5xiY1BD.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"66296aed62f335017dddfae7","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/Ar6BZbKy0D1nFp6sAPcTisFDYa4.jpg","genre_ids":[18],"id":644937,"title":"National Theatre Live: Red","original_language":"en","original_title":"National Theatre Live: Red","overview":"","popularity":1.2732,"poster_path":"/dz50YDrsvlPh5bHLdkBZXcotXdp.jpg","release_date":"2018-11-07","softcore":false,"video":true,"vote_average":4.524,"vote_count":41,"credit_id":"6668270d5803078c961c4565","department":"Writing","job":"Theatre Play"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":923195,"title":"Untitled Gene Kelly Project","original_language":"en","original_title":"Untitled Gene Kelly Project","overview":"","popularity":0.9964,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"66776dd0c1389454eabdfb41","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/6z9w8eidKWDDXwZNSVNaRolAYEP.jpg","genre_ids":[878,28,12,53],"id":201,"title":"Star Trek: Nemesis","original_language":"en","original_title":"Star Trek: Nemesis","overview":"Obrawszy kurs na galaktykę niespotykanej akcji i przygody kapitan Jean-Luc Picard (Patrick Stewart) i załoga jego krążownika toczy walkę z przerażającym nowym wrogiem... połączonym szokującą więzią z Picardem!  W przeddzień radosnego ślubu Rikera (Jonathan Frakes) i Troi (Marina Sirtis), Picard ma jeszcze jeden powód do świętowania: Romulanie pragną pokoju a kapitan zostaje mianowany emisariuszem Federacji. Ale kiedy Enterprise udaje się w kierunku Imperium Romulanów, czeka nań przebiegły wróg kryjący diaboliczny plan destrukcji i niewyobrażalny sekret, który postawi Picarda w obliczu straszliwego wyzwania.  W filmie wystąpili również: Brent Spiner, LeVar Burton, Michael Dorn, Gates McFadden oraz debiutujący Tom Hardy jako śmiertelny wróg Picarda. „Star Trek: Nemesis\" to dzieło „Ekscytujące! Skrzące pomysłami i nieoczekiwanymi zwrotami akcji od początku do końca filmu!\"","popularity":10.1997,"poster_path":"/cldAwhvBmOv9jrd3bXWuqRHoXyq.jpg","release_date":"2002-12-13","softcore":false,"video":false,"vote_average":6.298,"vote_count":1615,"credit_id":"5b32a3dcc3a368530e0125fa","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/pArPMLvKOKfF2waNpkhOPncxPo1.jpg","genre_ids":[28,10770],"id":36983,"title":"Tornado!","original_language":"en","original_title":"Tornado!","overview":"","popularity":1.4279,"poster_path":"/kzQNHyfqdbUdpJqHyqtZSQYxq5F.jpg","release_date":"1996-05-06","softcore":false,"video":false,"vote_average":5.681,"vote_count":47,"credit_id":"66a42eb14db36632ae521a69","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/z354BaTVzKj7E60WLzDoSmUuO4u.jpg","genre_ids":[18,28,10752],"id":616,"title":"Ostatni samuraj","original_language":"en","original_title":"The Last Samurai","overview":"Tom Cruise wciela się w rolę kpt. Nathana Algrena, bohatera Wojny Secesyjnej, który wyrusza do Japonii, by walczyć przeciwko Samurajom. Po pewnym czasie staje się jednak ich sprzymierzeńcem. Ken Watanabe (wyróżniony nominacją do Oscara®) gra Katsumoto, przywódcę Samurajów, których wspaniała kultura powoli odchodzi w zapomnienie. Jego losy nierozerwalnie splatają się z losami amerykańskiego kapitana.","popularity":14.4528,"poster_path":"/9VZ4SeTxgu0iBR8Q3BtHYhj0Lnw.jpg","release_date":"2003-12-05","softcore":false,"video":false,"vote_average":7.613,"vote_count":7665,"credit_id":"5c3b01850e0a26444202977f","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/wkA622CCN2X0uwpgqYEOnUYEDf5.jpg","genre_ids":[28,12,53],"id":37724,"title":"Skyfall","original_language":"en","original_title":"Skyfall","overview":"\"Skyfall\" to jeden z najwspanialszych filmów o przygodach najsłynniejszego agenta wszech czasów. Bond, James Bond - to nazwisko zna każdy. Tym razem na próbę zostaje wystawiona lojalność Bonda wobec M, gdy cyber-terroryści powiązani z jej przeszłością atakują siedzibę MI6. Agent 007 podąża śladem tajemniczego i bezwzględnego Silvy - geniusza zbrodni - którego nic nie powstrzyma przed wprowadzeniem w życie zbrodniczego planu zemsty.","popularity":14.8022,"poster_path":"/a2IMXdCVNmWjQEL85UCTNGqtNIm.jpg","release_date":"2012-10-24","softcore":false,"video":false,"vote_average":7.264,"vote_count":16256,"credit_id":"5e56e74b9b86160018391393","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/rzOCr1VCQa0BUU9x34JbwzM5mRo.jpg","genre_ids":[18,36,10770],"id":50008,"title":"Obywatel Welles","original_language":"en","original_title":"RKO 281","overview":"Orson Welles po zrobieniu kariery w Nowym Jorku przybywa do Hollywood, by kręcić filmy. Ma opinię geniusza, a więc jego pierwszy film też musi być genialny - trzeba tylko znaleźć właściwy temat. Po przyjęciu na zamku milionera Williama Hearsta Welles zdecydował, że nakręci film właśnie o nim. Przekonał do współpracy scenarzystę Hermana Mankiewicza, a studio RKO zgodziło się sfinansować projekt. Kiedy jednak Hearst dowiaduje się, o kim ma być ten film, rozpoczyna walkę, której celem jest unicestwienie „Obywatela Kane'a“, zanim ktokolwiek go obejrzy.","popularity":2.0346,"poster_path":"/v8Z4ENMOAT5OpiMeS1PBNPui3X0.jpg","release_date":"1999-11-20","softcore":false,"video":false,"vote_average":6.5,"vote_count":101,"credit_id":"5fd5c548d48cee003d7403a7","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/lqASDYSyYMgC1gYY7VHqK9Tnv0I.jpg","genre_ids":[18],"id":9563,"title":"Męska gra","original_language":"en","original_title":"Any Given Sunday","overview":"Akcja filmu rozgrywa się w środowisku amerykańskiego futbolu. Miejsce legendarnego zawodnika w drużynie Miami zajmuje młody i utalentowany gracz. Jego gra nadaje sens pracy podstarzałego trenera, znajdującego się pod presją żądnej zwycięstw zespołu nowej współwłaścicielki drużyny.","popularity":6.1067,"poster_path":"/qdbckqY1JRNVR1Cd3deBj30yFCZ.jpg","release_date":"1999-12-22","softcore":false,"video":false,"vote_average":6.825,"vote_count":1850,"credit_id":"60205c880c27100040f153b7","department":"Writing","job":"Screenstory"},{"adult":false,"backdrop_path":"/q33mNMedBcHK5yIZJ3AW3m9vwCn.jpg","genre_ids":[878,27],"id":1471626,"title":"Alien: Covenant - Prologue: Phobos","original_language":"en","original_title":"Alien: Covenant - Prologue: Phobos","overview":"","popularity":1.2788,"poster_path":"/67Q7oOF4W6tDmQcCZx3ysBsa6R4.jpg","release_date":"2017-07-19","softcore":false,"video":false,"vote_average":6.964,"vote_count":14,"credit_id":"680e2313f97f5cb6b8eaeb2a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18,10402,36],"id":1495231,"title":"You Should Be Dancing","original_language":"en","original_title":"You Should Be Dancing","overview":"","popularity":0.7266,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"6981645a2be47737544c93a8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/6KLKdhk9wZvJ6OcTzDCoxup0Kmh.jpg","genre_ids":[18],"id":2567,"title":"Aviator","original_language":"en","original_title":"The Aviator","overview":"Bohaterem projektu jest Howard Hughes, amerykański miliarder, pilot i konstruktor lotniczy, który w 1935 r. ustanowił światowy rekord prędkości - 567 km/h, a w 1938 r. wykonał etapowy lot dookoła świata. Fabuła filmu opowiada o latach młodości Howarda Hughesa. Zaczyna się, gdy bohater reżyseruje jeden z ulubionych obrazów Martina Scorsese \"Aniołowie piekieł\", a kończy w 1946 roku, gdy Howard romansuje z najznamienitszymi aktorkami Hollywood.","popularity":11.8333,"poster_path":"/xi2H8QHLMtOcSuG5FaUL4ypVZ6q.jpg","release_date":"2004-12-17","softcore":false,"video":false,"vote_average":7.216,"vote_count":5928,"credit_id":"69864c41b2054a999699d9c2","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18,36,10752],"id":1650663,"title":"Untitled Hannibal Film","original_language":"en","original_title":"Untitled Hannibal Film","overview":"","popularity":1.1094,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69b31add4604fac3c74effc3","department":"Writing","job":"Screenplay"}],"id":932}