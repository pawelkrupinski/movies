{"cast":[{"adult":false,"backdrop_path":"/wHmi3MLnH0w1h1MVckDxMDXsJgi.jpg","genre_ids":[99,36],"id":801159,"title":"Walkabout to Hollywood","original_language":"en","original_title":"Walkabout to Hollywood","overview":"","popularity":1.0322,"poster_path":"/q8HGV6WLZ6F5IYWqE2d00O5ywSD.jpg","release_date":"1980-02-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"61609b4f1d3563002bc02fc7","order":3},{"adult":false,"backdrop_path":"/cAuPF8Iko61aSfV8VETyh3EfQnY.jpg","genre_ids":[35,27],"id":277367,"title":"Homesdale","original_language":"en","original_title":"Homesdale","overview":"","popularity":0.6795,"poster_path":"/ws3ufA9WIpgYGHtdf76WnqfUCy6.jpg","release_date":"1971-06-01","softcore":false,"video":false,"vote_average":5.375,"vote_count":8,"character":"Robert 2","credit_id":"53a12af7c3a3687bbc001813","order":8},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1012677,"title":"The Hundred Days","original_language":"en","original_title":"The Hundred Days","overview":"","popularity":0.5741,"poster_path":"/mJFTw7JxFMHCLgjBBqqqzrLEy1I.jpg","release_date":"2004-04-20","softcore":false,"video":false,"vote_average":7.2,"vote_count":5,"character":"Self","credit_id":"62f93e236f53e10083f4da0d","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1034126,"title":"Carnet de Dubaï Hiver VI: Lumière et Reflets","original_language":"en","original_title":"Carnet de Dubaï Hiver VI: Lumière et Reflets","overview":"","popularity":0.5495,"poster_path":"/h1E5mpTlTPye95ELzVu7rRHjpvf.jpg","release_date":"2012-05-25","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6344b2046a300b007a24ac08","order":51},{"adult":false,"backdrop_path":"/p81vVRxWKGbCkTyywUb4ySwqLJh.jpg","genre_ids":[99],"id":1199447,"title":"Bohaterowie wszech czasów: Indiana Jones i Harrison Ford","original_language":"en","original_title":"Timeless Heroes: Indiana Jones and Harrison Ford","overview":"Od niepozornych początków aktora telewizyjnego, przez przełomową karierę gwiazdy hitów kina akcji, aż po bardziej złożone role filmowe, które nastąpiły później, ten nowy dokument śledzi bogatą karierę Harrisona Forda. Razem z ekipą filmową i obsadą udaj się w podróż śladami Harrisona wcielającego się w rolę Indiany Jonesa i przekonaj się, jak tworzyła się historia kina. Dokument rzuca rzadkie, osobiste spojrzenie na prawdziwą legendę.","popularity":2.7215,"poster_path":"/olpn3OH4NmVAXeSHCHPDffMeYGD.jpg","release_date":"2023-12-01","softcore":false,"video":false,"vote_average":7.731,"vote_count":26,"character":"Self","credit_id":"65e40638fe077a01620ed856","order":21},{"adult":false,"backdrop_path":"/2Hn7xhpFPCMQ0B4X6pu3vTu1moL.jpg","genre_ids":[99],"id":463902,"title":"A Recollection... Hanging Rock 1900","original_language":"en","original_title":"A Recollection... Hanging Rock 1900","overview":"","popularity":1.0866,"poster_path":"/tmd5gicjUVvSfTukQVlA2XERxQP.jpg","release_date":"1975-01-01","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"character":"Self","credit_id":"59551b909251412ac4050d0b","order":2},{"adult":false,"backdrop_path":"/rDyXQbdm5ql8N1Gm2yf4Cirru1M.jpg","genre_ids":[99,36],"id":595841,"title":"Making Waves: The Art of Cinematic Sound","original_language":"en","original_title":"Making Waves: The Art of Cinematic Sound","overview":"","popularity":2.6376,"poster_path":"/jafF7jcl116rzohZydL1VfK1y2e.jpg","release_date":"2019-10-25","softcore":false,"video":false,"vote_average":6.904,"vote_count":83,"character":"Self","credit_id":"5e64c44b459ad60011588fec","order":12},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":117841,"title":"A Dream Within a Dream: The Making of 'Picnic at Hanging Rock'","original_language":"en","original_title":"A Dream Within a Dream: The Making of 'Picnic at Hanging Rock'","overview":"","popularity":0.6515,"poster_path":"/13rZXN93zjZEX0Gzv1QpKahBGJG.jpg","release_date":"2004-08-01","softcore":false,"vide