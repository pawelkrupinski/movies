enerem i zaczyna powoli nabierać wody. Pomimo nabytego doświadczenia a także skutecznego załatania dziury w kadłubie, ledwo udaje mu się przetrwać sztorm. Rozpoczyna się desperacka walka o życie.","popularity":4.6854,"poster_path":"/9cVA4oX2xHgiglv6hemxwAaofsq.jpg","release_date":"2013-08-23","softcore":false,"video":false,"vote_average":6.641,"vote_count":1779,"credit_id":"698324c206cf39a7d9e7499a","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":1664946,"title":"Man on a Green Bike","original_language":"en","original_title":"Man on a Green Bike","overview":"","popularity":0.6663,"poster_path":null,"release_date":"1969-12-28","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69d402ff7c309cf5fc3137a8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1664954,"title":"Stirring the Pool","original_language":"en","original_title":"Stirring the Pool","overview":"","popularity":0.2823,"poster_path":null,"release_date":"1969-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69d4051a641c8efca33e38f1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1664979,"title":"Adults Learning: The Field Day","original_language":"en","original_title":"Adults Learning: The Field Day","overview":"","popularity":0.3552,"poster_path":"/lqlzteRCAI3gSkJ8kwRiGipzIic.jpg","release_date":"1972-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"69d412ad4402acf663edf058","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1664987,"title":"Adults Learning: The Computer Centre","original_language":"en","original_title":"Adults Learning: The Computer Centre","overview":"","popularity":0.3925,"poster_path":"/xvh8KiHGDQqN3cT4NSBYu1l6s4G.jpg","release_date":"1972-01-01","softcore":false,"video":false,"vote_average":0.0,