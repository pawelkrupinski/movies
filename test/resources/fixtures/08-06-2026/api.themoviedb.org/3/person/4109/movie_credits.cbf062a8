49],"id":769367,"title":"Tavasz a télben","original_language":"hu","original_title":"Tavasz a télben","overview":"","popularity":0.5268,"poster_path":"/49vh5TDrmY6q2Nn6uisYnxREIxT.jpg","release_date":"1918-02-25","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5fc1d86bcf9ba30041c0a02b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9XmKgUuytbrBPkiUOrBhCphVvpL.jpg","genre_ids":[80,18],"id":42683,"title":"Czarny legion","original_language":"en","original_title":"Black Legion","overview":"W fabryce wyrobów metalurgicznych roznosi się fama, że w najbliższym czasie stanowisko brygadzisty będzie wolne. Wiele osób przewiduje awans Franka Taylora, między innymi jego przyjaciel Ed Jackson, który także uwierzył w nowe przeznaczenie Franka. Utwierdzając się w tym przekonaniu, Frank informuje o niedokonanym fakcie swoją rodzinę. Jednak jak się okazuje, na stanowisko majstra zatrudniono ambitnego, polskiego imigranta Joe Dombrowskiego. Zawiedziony Frank musi odwołać zaplanowany remont domu; musi też zrezygnować z zakupu samochodu i wymiany sprzętu gospodarstwa domowego, na które tak bardzo liczyła jego żona.","popularity":1.2155,"poster_path":"/9g8F2u5sn2DvFovY1Dxqyd1Ryvi.jpg","release_date":"1937-01-30","softcore":false,"video":false,"vote_average":6.559,"vote_count":59,"credit_id":"5fc55d052f8d0900400d8476","department":"Directing","job":"Co-Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":784229,"title":"A föld embere","original_language":"hu","original_title":"A föld embere","overview":"","popularity":0.7483,"poster_path":"/7X5RZvTNIN3VJOsS96j9LX1cUDs.jpg","release_date":"1917-11-16","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5ff8deb10cd32a003e4a5058","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/90RUkFDU9xa5asnlU6FGBVuKGt7.jpg","genre_ids":[18,10749],"id":27563,"title":"Flamingo Road","original_language":"en","original_title":"Flami