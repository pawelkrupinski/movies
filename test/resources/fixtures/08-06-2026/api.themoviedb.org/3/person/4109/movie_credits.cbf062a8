gDtlt.jpg","release_date":"1940-03-23","softcore":false,"video":false,"vote_average":6.303,"vote_count":38,"credit_id":"52fe474c9251416c750946d9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wYWYya66V84JT8l8jqIuYTF5JZV.jpg","genre_ids":[37],"id":17660,"title":"Dodge City","original_language":"en","original_title":"Dodge City","overview":"","popularity":2.4891,"poster_path":"/iySSQEAlvr87OYLA5aLzBU8q9lJ.jpg","release_date":"1939-04-08","softcore":false,"video":false,"vote_average":6.938,"vote_count":112,"credit_id":"52fe473c9251416c75092521","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/osa3Lvhl0RMpSeVVWj785VKw7g6.jpg","genre_ids":[37],"id":48409,"title":"Człowiek, którego zwano katem","original_language":"en","original_title":"The Hangman","overview":"Szeryf federalny Mackenzie Bovard (Robert Taylor) zwany jest \"Katem\" z uwagi na to, jaką skutecznością wykazuje się w znajdowaniu i chwytaniu poszukiwanych przestępców. Podążając tropem zbiega podejrzanego o rabunek, trafia do małego miasteczka. Mieszkańcy utrudniają mu jednak zadanie, gdyż człowiek, którego szuka, jest przez nich znany i lubiany.","popularity":1.5762,"poster_path":"/76nIzgoW0xJVaXIrTr948XYdO2o.jpg","release_date":"1959-06-17","softcore":false,"video":false,"vote_average":6.487,"vote_count":39,"credit_id":"52fe4765c3a36847f81334e1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/70wIyJMx9MZE33tzrrkH3NRZkjM.jpg","genre_ids":[12,18,10752],"id":18229,"title":"Droga do Marsylii","original_language":"en","original_title":"Passage to Marseille","overview":"Opowieść o uciekinierach (niewinnie skazanych) z Gujany Francuskiej, którzy po dotarciu do Anglii zostają lotnikami i zamierzają zrealizować przyrzeczenie złożone starszemu więźniowi, który pomógł im w ucieczce.","popularity":1.6385,"poster_path":"/14s5iMOLt8EboZmnltXjB7g2sap.jpg","release_date":"1944-02-16","softcore":false,"video":false,"vote_average":6.6,"vote_count":68,"credit_id":"52fe476c9251416c75098b57","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/pnWD5Sni0B8LI24Pxwt2qEzlQ03.jpg","genre_ids":[18,10402,10749],"id":67880,"title":"Four Daughters","original_language":"en","original_title":"Four Daughters","overview":"","popularity":1.1497,"poster_path":"/b537l9ogYQY3y66G4zLXvP970Lj.jpg","release_date":"1938-08-09","softcore":false,"video":false,"vote_average":6.6,"vote_count":35,"credit_id":"52fe477bc3a368484e0c96b9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/d76fxEGPeBZN4CsjJkfeDnfJUu7.jpg","genre_ids":[18,10402,80],"id":18644,"title":"Król Kreol","original_language":"en","original_title":"King Creole","overview":"Danny Fisher porzuca szkołę średnią, by zaopiekować się niedołężnym ojcem. Pewnego dnia chłopak wpada w tarapaty, które mogą skończyć się wyrokiem. Na pomoc przychodzi mu jednak Charlie Le Grand, właściciel klubu w Nowym Orleanie, proponując Danny'emu pracę. Odtąd chłopak zarabia jako wokalista. Tymczasem gangster Maxie Fields i kierownik znanego lokalu \"King Creole\" również składa mu ofertę zatrudnienia. Chłopak odmawia, ponieważ nie chce mieć z nim nic do czynienia. Nie wie jednak, że propozycji Fieldsa się nie odrzuca.","popularity":2.4744,"poster_path":"/k5WBAgKrI8OytCSxMd4oau5KXzn.jpg","release_date":"1958-07-02","softcore":false,"video":false,"vote_average":6.4,"vote_count":113,"credit_id":"52fe478d9251416c7509d881","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/u6wtiUvaAHBxr8x7RItprFlN593.jpg","genre_ids":[18,35,10749,80],"id":81396,"title":"Jimmy the Gent","original_language":"en","original_title":"Jimmy the Gent","overview":"","popularity":1.3677,"poster_path":"/fZuLSS7X5j5SddIwQzp9cJbpK5Y.jpg","release_date":"1934-03-09","softcore":false,"video":false,"vote_average":6.387,"vote_count":31,"credit_id":"52fe480f9251416c9107ed1b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9ymuUXMaes6Jv1c3Fkboqp6WTch.jpg","genre_ids":[35,18,10749],"id":52003,"title":"A Breath of Scandal","original_language":"en","original_title":"A Breath of Scandal","overview":"","popularity":1.3797,"poster_path":"/7SGZGMxFhaHU0gu6RDWtFlFgkif.jpg","release_date":"1960-03-16","softcore":false,"video":false,"vote_average":5.55,"vote_count":20,"credit_id":"52fe4811c3a36847f8156ce7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jBD9VRoJ9COVKr4zVD6cbdcJy9v.jpg","genre_ids":[80,18,10749],"id":52229,"title":"KID GALAHAD","original_language":"en","original_title":"Kid Galahad","overview":"Ward Guisenberry (Wayne Morris) to naiwny młody mężczyzna, dorabiający jako goniec hotelowy. Podczas swojej pierwszej nocnej zmiany wdaje się w bójkę, stając w obronie Louise \"Fluff\" Phillips (Bette Davis). Świadkiem całego zdarzenia jest Nick Donati (Edward G. Robinson), który dostrzega w mężczyźnie potencjał i postanawia wypromować go na gwiazdę boksu. Ward pod pseudonimem \"Kid Galahad\" staje się częścią niebezpiecznego bokserskiego świata. Tymczasem Donati planuje wykorzystać nowego podopiecznego do odwetu przeciwko Turkey'owi Morganowi (Humphrey Bogart) - gangsterowi, zajmującego się ustawianiem walk.","popularity":1.6857,"poster_path":"/eAYC15fSuqUNtBXcFKltIUTL8lO.jpg","release_date":"1937-05-29","softcore":false,"video":false,"vote_average":7.059,"vote_count":59,"credit_id":"52fe481fc3a36847f8158e67","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/shNjxcucq36DMzzDLgVUdLD7vax.jpg","genre_ids":[18],"id":80891,"title":"Das Spielzeug von Paris","original_language":"de","original_title":"Das Spielzeug von Paris","overview":"Brytyjski playboy w Paryżu poślubia tancerkę i przekonuje ją, by zrezygnowała z kariery i przeprowadziła się do małego domku na wsi. Pewnej nocy na przyjęciu wydanym przez jej byłego menedżera zostaje namówiona do wykonania jednego z tańców, z których była znana. Prowadzi to do kłótni z jej mężem, który wybiega z przyjęcia w środku szalejącej burzy. Jej późniejsze poszukiwania go kończą się narażeniem jej życia","popularity":1.0433,"poster_path":"/b5oA61yWcJgthpH2Y1keB0m2cNV.jpg","release_date":"1925-10-16","softcore":false,"video":false,"vote_average":6.7,"vote_count":10,"credit_id":"52fe47e59251416c91079463","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/pFIdP1omUgiCkkRAngjmkQ1CyTE.jpg","genre_ids":[10749,35],"id":83868,"title":"Female","original_language":"en","original_title":"Female","overview":"","popularity":1.0521,"poster_path":"/fEIoVkw89Oqc4E93n6WR9d6U7V0.jpg","release_date":"1933-11-11","softcore":false,"video":false,"vote_average":6.266,"vote_count":32,"credit_id":"52fe48c69251416c91097d61","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sG42761jfIeqkTyYinfp1kFMaly.jpg","genre_ids":[18],"id":53865,"title":"The Key","original_language":"en","original_title":"The Key","overview":"","popularity":0.7297,"poster_path":"/z76ZF6VTFGnHah5u2CNJF8vpB6J.jpg","release_date":"1934-06-09","softcore":false,"video":false,"vote_average":4.9,"vote_count":11,"credit_id":"52fe487fc3a36847f816a581","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xxkhu3L7CvK1CwQOHiCKLlBYIdJ.jpg","genre_ids":[80,18,53],"id":74422,"title":"The Scarlet Hour","original_language":"en","original_title":"The Scarlet Hour","overview":"","popularity":1.284,"poster_path":"/AtObLezqgP23nhePWHuwTDigVc.jpg","release_date":"1956-04-01","softcore":false,"video":false,"vote_average":5.313,"vote_count":24,"credit_id":"52fe48c9c3a368484e10b155","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xxkhu3L7CvK1CwQOHiCKLlBYIdJ.jpg","genre_ids":[80,18,53],"id":74422,"title":"The Scarlet Hour","original_language":"en","original_title":"The Scarlet Hour","overview":"","popularity":1.284,"poster_path":"/AtObLezqgP23nhePWHuwTDigVc.jpg","release_date":"1956-04-01","softcore":false,"video":false,"vote_average":5.313,"vote_coun