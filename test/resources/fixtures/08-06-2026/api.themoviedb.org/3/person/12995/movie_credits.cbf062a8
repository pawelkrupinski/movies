{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[99,16],"id":255931,"title":"LX Forty","original_language":"en","original_title":"LX Forty","overview":"","popularity":0.902,"poster_path":null,"release_date":"2009-06-08","softcore":false,"video":false,"vote_average":5.0,"vote_count":1,"character":"Self","credit_id":"530155f2c3a3680a281564f2","order":0},{"adult":false,"backdrop_path":"/mjwt3MkRBz2dkISyeUBp8n4KFQ.jpg","genre_ids":[99,10402],"id":1028506,"title":"The Sound of 007","original_language":"en","original_title":"The Sound of 007","overview":"Nowy film dokumentalny Mata Whitecrossa „The Sound of 007” przedstawia historię muzyki z filmów o Jamesie Bondzie od ikonicznego motywu z „Doktor No” z 1962 roku po nagrodzoną Oscarem piosenkę Billie Eilish do filmu „Nie czas umierać” z 2021.","popularity":1.7584,"poster_path":"/wHsfL0ub95Xr6GK6tJUpmVnrT1J.jpg","release_date":"2022-10-04","softcore":false,"video":false,"vote_average":7.286,"vote_count":56,"character":"Self","credit_id":"6330884f2b8a43009659923a","order":8},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":514420,"title":"Students of 'The Graduate'","original_language":"en","original_title":"Students of 'The Graduate'","overview":"","popularity":0.8016,"poster_path":"/enUzJpsNfy95CLv4qXDgjPR5J6Y.jpg","release_date":"2007-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"5ab9c5320e0a26365e00d1ed","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":795292,"title":"A Movie Is Made For Pooh","original_language":"en","original_title":"A Movie Is Made For Pooh","overview":"","popularity":1.1331,"poster_path":"/avIfU3L4jwcz0TnU5CB8C2D53Kk.jpg","release_date":"2018-11-02","softcore":false,"video":false,"vote_average":8.0,"vote_count":2,"character":"Self","credit_id":"60235f1895c0af003f529b72","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":832820,"title":"On Location","original_language":"en","original_title":"On Location","overview":"","popularity":1.3083,"poster_path":null,"release_date":"2009-03-24","softcore":false,"video":false,"vote_average":4.0,"vote_count":1,"character":"","credit_id":"60aaf1425258ae00791e7e23","order":3},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":832386,"title":"Bond on Location","original_language":"en","original_title":"Bond on Location","overview":"","popularity":1.0791,"poster_path":"/nE1JETGWiR9gNvkx8XpOct20Zv8.jpg","release_date":"2012-10-01","softcore":false,"video":false,"vote_average":6.0,"vote_count":1,"character":"Self - Director","credit_id":"60aae33c498ef9002af69671","order":8},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":832819,"title":"Director Marc Forster","original_language":"en","original_title":"Director Marc Forster","overview":"","popularity":1.4701,"poster_path":null,"release_date":"2009-03-26","softcore":false,"video":false,"vote_average":4.5,"vote_count":2,"character":"","credit_id":"60aaf01e33ec2600583163ff","order":3},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":832807,"title":"Olga Kurylenko and the Boat Chase","original_language":"en","original_title":"Olga Kurylenko and the Boat Chase","overview":"","popularity":1.0443,"poster_path":null,"release_date":"2009-03-24","softcore":false,"video":false,"vote_average":4.5,"vote_count":2,"character":"","credit_id":"60aaedfb5437f5006f9330b4","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":832802,"title":"Start of Shooting","original_language":"en","original_title":"Start of Shooting","overview":"","popularity":0.5576,"poster_path":"/kA7S1ElVDGwHcoNbdCGtd5r3xpo.jpg","release_date":"2009-03-24","softcore":false,"video":false,"vote_average":4.5,"vote_count":2,"character":"","credit_id":"60aae2b0ede1b00058e9d5af","order":1},{"adult":false,"backdrop_path":"/bjSzKFtNt55yZqvQNSfHFyQfx7n.jpg","genre_ids":[],"id":1688506,"title":"Students of 'The Graduate'","original_language":"en","original_title":"Students of 'The Graduate'","overview":"","popularity":0.8243,"poster_path":"/zsImvmkZYEOrgFNr5NGeULjx37P.jpg","release_date":"2007-09-11","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Himself","credit_id":"69f9e0e448c1d9e1659a292b","order":1}],"crew":[{"adult":false,"backdrop_path":"/d9eONXYtCmQnPWw61w9pNMGlSzK.jpg","genre_ids":[18,35,10749,14],"id":1262,"title":"Przypadek Harolda Cricka","original_language":"en","original_title":"Stranger Than Fiction","overview":"Harold Crick, pracownik Urzędu Skarbowego, poborca podatków, prowadzi monotonne, niezmienne od lat życie. Harold je sam, sam chodzi po ulicy, sam kładzie się spać. Nie ma dziewczyny. Nie ma przyjaciół, oprócz towarzyszących mu wszędzie liczb. Nie ma żadnego zamiłowania, hobby, talentu (jest dobry tylko w matematyce). Pewnego dnia wszystko zaczyna się zmieniać. Harold myjąc zęby słyszy nagle kobiecy głos, który snuje narracje w trzeciej osobie. Ponadto jest to narracja opowiadająca o Haroldzie. Narrator opisuje dokładnie wszystkie jego czynności, ukryte myśli i wyobrażenia. Harold nie wie, co się dzieje, lecz prawdziwy niepokój wzbudza w nim zapowiedź jego nieuchronnej śmierci.","popularity":6.402,"poster_path":"/5NFCFx18ZP7nFgHEfdPT7IbkHv0.jpg","release_date":"2006-11-10","softcore":false,"video":false,"vote_average":7.295,"vote_count":2584,"credit_id":"52fe42ebc3a36847f802ccf1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/2lZYvShWuVThLM6Oo8zfakdBMqw.jpg","genre_ids":[18,10749],"id":1365,"title":"Czekając na wyrok","original_language":"en","original_title":"Monster's Ball","overview":"Hank Grotowski i jego syn Sonny pracują w stanowym więzieniu. Obaj przygotowują egzekucję więźniów. Za kilka dni stracony ma zostać Lawrence Musgrove. Jego żona Letitia wraz z synem przybywa na ostatnie widzenie z mężem. Kilka dni po egzekucji przypadkiem poznaje Hanka. Między nimi zaczyna rodzic się uczucie. Lelitia nie wie jednak, że Hank przeprowadził egzekucję na jej mężu.","popularity":4.0026,"poster_path":"/aJCtUQaUPFbXrBOFjK00AleIwZ.jpg","release_date":"2001-12-26","softcore":false,"video":false,"vote_average":6.79,"vote_count":1104,"credit_id":"52fe42efc3a36847f802df73","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ursbJ6xP9YnmtlTFKf77KPxmw7U.jpg","genre_ids":[18,14],"id":866,"title":"Marzyciel","original_language":"en","original_title":"Finding Neverland","overview":"Przepiękna, bajkowa opowieść o dorosłych chcących pozostać dziećmi i dziećmi zmuszonymi do dorosłości. Kolorowo, epicko ale też łapiąc za serce opowiedziana historia powstania bajki z pióra J. M. Barrie'go \"The Adventures of Peter Pan\". Film pokazuje wesołe, frywolne, lekkie życie trójki dzieci przeplatające się z okropieństwami życia, śmiercią i twardą rzeczywistością. Doborowa obsada: Johnny Depp jako James Barrie, Kate Winslet jako Sylvia Llewelyn Davies oraz Dustin Hoffman jako Charles Frohman tworzą obraz godny zastanowienia się, w którym momencie my sami przestaliśmy być dziećmi i czy na pewno udało się nam tego dokonać.","popularity":5.4318,"poster_path":"/fQENrECkg7qP32UaEv72NUsebXx.jpg","release_date":"2004-10-29","softcore":false,"video":false,"vote_average":7.319,"vote_count":3779,"credit_id":"52fe4284c3a36847f80252db","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uGs5Z7dMguf7kxWubGFcp9EhKcy.jpg","genre_ids":[12,28,53],"id":10764,"title":"Quantum of Solace","original_language":"en","original_title":"Quantum of Solace","overview":"James Bond pchany głęboko skrywaną żądzą zemsty postanawia rozwiązać własne problemy podczas kolejnej służbowej misji. Mając w pamięci zdradę ukochanej Vesper pragnie zniszczyć organizację, która terroryzowała młodą kobietę. Wbrew temu czego go uczono, agent specjalny podąża śladem Dominica Greene bogatego przywódcy niebezpiecznej korporacji, z zimną krwią zabijając po drodze współpracujących z biznesmenem ludzi. Bezwzględny w swoim działaniu nie zwraca uwagi na ostrzeżenia M, czego skutkiem są bogate w akcję sceny i zapierające dech pościgi CIA i MI6 za Bondem, który nie ma zamiaru dać się złapać zanim nie wyrówna własnych porachunków. U boku Jamesa Bonda kolejna piękna kobieta, czyli Camille, która także chce wtrącić do całej sprawy swoje trzy grosze.","popularity":10.4159,"poster_path":"/bVcuJKZWXvXziKiO81iFjmsWxne.jpg","release_date":"2008-10-29","softcore":false,"video":false,"vote_average":6.341,"vote_count":8656,"credit_id":"52fe43b39251416c7501aadb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eUNQJ0XKHoGDDQzj1Y4WhE5zAFJ.jpg","genre_ids":[9648,53,18],"id":8066,"title":"Zostań","original_language":"en","original_title":"Stay","overview":"Sam Foster jest psychiatrą, który na co dzień ma kontakt z wieloma przypadkami niezwykłych chorób psychicznych. Pewnego dnia w gabinecie Fostera zjawia się młody student. Oświadcza lekarzowi, iż w swoje 21 urodziny, które przypadają za trzy dni, popełni samobójstwo. Sam rozpoczyna wędrówkę do umysłu chłopaka, aby tam znaleźć przyczynę tak radykalnej decyzji. W badaniach psychiki młodzieńca pomaga mu doświadczenie, jakie nabył wiele lat temu podczas samobójczej próby swojej dziewczyny.","popularity":5.1419,"poster_path":"/vlxGzUnpUY7aG4hsZKGFzNl27bj.jpg","release_date":"2005-09-24","softcore":false,"video":false,"vote_average":6.633,"vote_count":1549,"credit_id":"52fe4490c3a36847f809d3bb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/CAC2F6C6R8hZ3AoByDX6Jj2VOw.jpg","genre_ids":[18],"id":7979,"title":"Chłopiec z latawcem","original_language":"en","original_title":"The Kite Runner","overview":"Będący adaptacją jednej z najlepiej ostatnio przyjętych powieści, film Chłopiec z latawcem jest pełną emocji opowieścią o przyjaźni, rodzinie, trudnych do wybaczenia błędach oraz powodującej odkupienie miłości. W znajdującym się na krawędzi wojny Afganistanie, dwóch przyjaciół z dzieciństwa, Amir i Hassan, wkrótce zostanie rozdzielonych na zawsze. Słoneczne popołudnie w Kabulu. W powietrzu czuć radość panującą przed turniejem puszczania latawców. Jednak po zakończonym zwycięstwem konkursie, zdrada jednego z chłopców początkuje nieprzewidywalną w skutkach katastrofę. Teraz, po 20 latach spędzonych w Ameryce, Amir wraca do rządzonego przez Talibów Afganistanu, aby stawić czoła gnębiącym go mrocznym sekretom i po raz ostatni postarać się znaleźć szansę odkupienia.","popularity":4.8377,"poster_path":"/dom2esWWW8C9jS2v7dOhW48LwHh.jpg","release_date":"2007-12-14","softcore":false,"video":false,"vote_average":7.341,"vote_count":1264,"credit_id":"52fe448ac3a36847f809bdcf","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tyO7uhV4803mnSwSAhjKhKV1bMN.jpg","genre_ids":[28,53,80],"id":45610,"title":"Kaznodzieja z Karabinem","original_language":"en","original_title":"Machine Gun Preacher","overview":"Sam Childers, narkotykowy diler i członek gangu motocyklowego, w dramatycznych okolicznościach nawraca się i rozpoczyna walkę o utworzenie sierocińca w rozdartej wojną Afryce. Na drodze stają mu miejscowi watażkowie, którzy sprawują w Sudanie krwawe rządy. Pozbawieni skrupułów, wcielają do armii dzieci i wysyłają je na wojnę. Childers nie będzie przebierał w środkach, walcząc o życie sierot i o odkupienie własnych grzechów.","popularity":4.4797,"poster_path":"/d9Rx2wZsLJnqLm1tE6uHNXXgv3x.jpg","release_date":"2011-09-23","softcore":false,"video":false,"vote_average":6.721,"vote_count":1150,"credit_id":"52fe46cbc3a36847f811286f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/tyO7uhV4803mnSwSAhjKhKV1bMN.jpg","genre_ids":[28,53,80],"id":45610,"title":"Kaznodzieja z Karabinem","original_language":"en","original_title":"Machine Gun Preacher","overview":"Sam Childers, narkotykowy diler i członek gangu motocyklowego, w dramatycznych okolicznościach nawraca się i rozpoczyna walkę o utworzenie sierocińca w rozdartej wojną Afryce. Na drodze stają mu miejscowi watażkowie, którzy sprawują w Sudanie krwawe rządy. Pozbawieni skrupułów, wcielają do armii dzieci i wysyłają je na wojnę. Childers nie będzie przebierał w środkach, walcząc o życie sierot i o odkupienie własnych grzechów.","popularity":4.4797,"poster_path":"/d9Rx2wZsLJnqLm1tE6uHNXXgv3x.jpg","release_date":"2011-09-23","softcore":false,"video":false,"vote_average":6.721,"vote_count":1150,"credit_id":"52fe46cbc3a36847f8112821","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kg2FOT2Oe5PSCgs3L4vLel6B7ck.jpg","genre_ids":[28,27,878],"id":72190,"title":"World War Z","original_language":"en","original_title":"World War Z","overview":"Podczas spokojnej jazdy samochodem, Gerry Lane i jego rodzina wpadają w olbrzymi korek. Lane, były śledczy ONZ szybko wyczuwa, że to z czym mają do czynienia nie jest zwykłą uliczną blokadą. Zabójczy wirus, który rozprzestrzenia się przez ugryzienie, przemienia zdrowych ludzi w coś dzikiego. Pochodzenie choroby jest nieznane, a liczba zainfekowanych rośnie z dnia na dzień, co wkrótce staje się światową pandemią. Lane zostaje zmuszony do powrotu do dawnego niebezpiecznego życia, aby zapewnić bezpieczeństwo rodzinie. Rozpoczyna desperackie poszukiwania źródła epidemii i środków, które powstrzymają jej rozprzestrzenianie.","popularity":27.3032,"poster_path":"/aCnVdvExw6UWSeQfr0tUH3jr4qG.jpg","release_date":"2013-06-19","softcore":false,"video":false,"vote_average":6.847,"vote_count":16825,"credit_id":"52fe485dc3a368484e0f505d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/x3J55s7zfu59fahlQxHCbk1aY9O.jpg","genre_ids":[18,10749],"id":81220,"title":"Everything Put Together","original_language":"en","original_title":"Everything Put Together","overview":"","popularity":1.6227,"poster_path":"/w9Zk7Sdwy1htXYpqrZF1JUnxB4v.jpg","release_date":"2001-11-02","softcore":false,"video":false,"vote_average":4.909,"vote_count":22,"credit_id":"52fe48019251416c9107ce43","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/e47cvCgbZogOyKXSenT9aqCDhe8.jpg","genre_ids":[18,53],"id":127517,"title":"Rozłączeni","original_language":"en","original_title":"Disconnect","overview":"\"Disconnect\" to film opowiadający kilka przeplatających się historii o zwykłych ludziach, którzy poszukują prawdziwych, trwałych więzi międzyludzkich, w świecie zdominowanym przez technikę i internet. Film próbuje zgłębić konsekwencje przedkładania życia \"w świecie wirtualnym\" nad realne życie \"tu i teraz\".","popularity":3.7916,"poster_path":"/mAStXq4ncbLBnujd3LG4KDd7Z3a.jpg","release_date":"2013-04-12","softcore":false,"video":false,"vote_average":7.069,"vote_count":1235,"credit_id":"52fe4afcc3a368484e17164d","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99,16],"id":255931,"title":"LX Forty","original_language":"en","original_title":"LX Forty","overview":"","popularity":0.902,"poster_path":null,"release_date":"2009-06-08","softcore":false,"video":false,"vote_average":5.0,"vote_count":1,"credit_id":"530155dbc3a3680a2116c646","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/x3J55s7zfu59fahlQxHCbk1aY9O.jpg","genre_ids":[18,10749],"id":81220,"title":"Everything Put Together","original_language":"en","original_title":"Everything Put Together","overview":"","popularity":1.6227,"poster_path":"/w9Zk7Sdwy1htXYpqrZF1JUnxB4v.jpg","release_date":"2001-11-02","softcore":false,"video":false,"vote_average":4.909,"vote_count":22,"credit_id":"615cd1f2bb1057006113c87a","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99,16],"id":255931,"title":"LX Forty","original_language":"en","original_title":"LX Forty","overview":"","popularity":0.902,"poster_path":null,"release_date":"2009-06-08","softcore":false,"video":false,"vote_average":5.0,"vote_count":1,"credit_id":"615cd3ead144430088cc5ba3","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[99,16],"id":255931,"title":"LX Forty","original_language":"en","original_title":"LX Forty","overview":"","popularity":0.902,"poster_path":null,"release_date":"2009-06-08","softcore":false,"video":false,"vote_average":5.0,"vote_count":1,"credit_id":"615cd3f369eb900061dad7c6","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/azFMUsxP0Dy1ZbVLCsZNZ1IcKqO.jpg","genre_ids":[9648,53,18],"id":345923,"title":"Widzę tylko ciebie","original_language":"en","original_title":"All I See Is You","overview":"Będąc dzieckiem, Gina straciła w wypadku samochodowym zarówno oboje rodziców, jak i wzrok. Teraz, gdy jest już dorosła, zamężna i całkowicie pogodzona ze swym losem, dowiaduje się, że istnieje możliwość przywrócenia widzenia w jednym oku. James, jej ukochany mąż, który opiekuje się nią od lat, jest wziętym specjalistą od ubezpieczeń i na operację żony wyda każde pieniądze. Choćby tylko po to, by ukochana mogła choć przez chwilę zobaczyć jego twarz, zamiast ją sobie tylko wyobrażać. To, co jawi się jako cud, okazuje się być początkiem rodzinnego horroru.","popularity":2.5684,"poster_path":"/wc9MgFWuBl3VS72w6VtiZXTgN79.jpg","release_date":"2017-08-10","softcore":false,"video":false,"vote_average":5.21,"vote_count":620,"credit_id":"55890e39c3a3683d500015b8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/azFMUsxP0Dy1ZbVLCsZNZ1IcKqO.jpg","genre_ids":[9648,53,18],"id":345923,"title":"Widzę tylko ciebie","original_language":"en","original_title":"All I See Is You","overview":"Będąc dzieckiem, Gina straciła w wypadku samochodowym zarówno oboje rodziców, jak i wzrok. Teraz, gdy jest już dorosła, zamężna i całkowicie pogodzona ze swym losem, dowiaduje się, że istnieje możliwość przywrócenia widzenia w jednym oku. James, jej ukochany mąż, który opiekuje się nią od lat, jest wziętym specjalistą od ubezpieczeń i na operację żony wyda każde pieniądze. Choćby tylko po to, by ukochana mogła choć przez chwilę zobaczyć jego twarz, zamiast ją sobie tylko wyobrażać. To, co jawi się jako cud, okazuje się być początkiem rodzinnego horroru.","popularity":2.5684,"poster_path":"/wc9MgFWuBl3VS72w6VtiZXTgN79.jpg","release_date":"2017-08-10","softcore":false,"video":false,"vote_average":5.21,"vote_count":620,"credit_id":"55890e2f9251414c710000ab","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/v2LilmCylr3bL9TCZSj6syjowZh.jpg","genre_ids":[35,18],"id":937278,"title":"Mężczyzna imieniem Otto","original_language":"en","original_title":"A Man Called Otto","overview":"Otto Anderson to starszy mężczyzna, który stracił cel w życiu po śmierci żony. Niedaleko jego domu wprowadzają się nowi sąsiedzi, którzy wnoszą trochę radości w jego monotonną codzienność. Dzięki nowej przyjaźni bohater zaczyna patrzeć inaczej na otaczającą go rzeczywistość i potrafi znowu cieszyć się z drobnych rzeczy.","popularity":11.1277,"poster_path":"/2ABQvDNBYg5FgaEvpKa7XLfM88F.jpg","release_date":"2022-12-28","softcore":false,"video":false,"vote_average":7.746,"vote_count":3676,"credit_id":"6205c4db38e51000cd487d33","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/v2LilmCylr3bL9TCZSj6syjowZh.jpg","genre_ids":[35,18],"id":937278,"title":"Mężczyzna imieniem Otto","original_language":"en","original_title":"A Man Called Otto","overview":"Otto Anderson to starszy mężczyzna, który stracił cel w życiu po śmierci żony. Niedaleko jego domu wprowadzają się nowi sąsiedzi, którzy wnoszą trochę radości w jego monotonną codzienność. Dzięki nowej przyjaźni bohater zaczyna patrzeć inaczej na otaczającą go rzeczywistość i potrafi znowu cieszyć się z drobnych rzeczy.","popularity":11.1277,"poster_path":"/2ABQvDNBYg5FgaEvpKa7XLfM88F.jpg","release_date":"2022-12-28","softcore":false,"video":false,"vote_average":7.746,"vote_count":3676,"credit_id":"6205c41938e51000cd487b56","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/hnh4oqnGPlVFEMUuw41nYxKRYf0.jpg","genre_ids":[12,35,10751,14],"id":420814,"title":"Krzysiu, gdzie jesteś?","original_language":"en","original_title":"Christopher Robin","overview":"Prawdziwych przyjaciół poznaje się w biedzie! Gdy mały Krzyś dorósł i znalazł się na życiowym zakręcie, jego wierni towarzysze dzieciństwa - Kubuś, Prosiaczek, Kłapouchy i Tygrysek – wyruszają ze Stuwiekowego lasu do Londynu, by przypomnieć mu magię dzieciństwa.","popularity":7.7742,"poster_path":"/debQoomAV59GTlHj81u2ygYB9Xr.jpg","release_date":"2018-08-01","softcore":false,"video":false,"vote_average":7.296,"vote_count":2948,"credit_id":"59842db492514158a300d484","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ad8fgh4JYGXkPHPW7IwCKrNXuFA.jpg","genre_ids":[35],"id":536506,"title":"Pieskie życie","original_language":"fr","original_title":"Mon chien stupide","overview":"Henri jest 50-letnim pisarzem i boryka się z kryzysem twórczym. Mąż aktorki, która dla rodziny poświęciła karierę i ojciec czworga dorastających, więc sprawiających kłopoty dzieci, wiele lat temu odniósł sukces literacki, którego nigdy więcej nie powtórzył. Pewnego dnia do jego domu przybłąkał się wielki, niezgrabny i trochę śmierdzący pies, który całkowicie odmieni jego smutne życie.","popularity":1.6372,"poster_path":"/buE3gY5fXwunJrSG8wVNVcF1ogW.jpg","release_date":"2019-10-30","softcore":false,"video":false,"vote_average":5.982,"vote_count":193,"credit_id":"6462f9918c44b9780cf58aa4","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":522899,"title":"The Cow","original_language":"en","original_title":"The Cow","overview":"","popularity":0.6241,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"5af0d20d925141197e000c35","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":522899,"title":"The Cow","original_language":"en","original_title":"The Cow","overview":"","popularity":0.6241,"poster_path":nul