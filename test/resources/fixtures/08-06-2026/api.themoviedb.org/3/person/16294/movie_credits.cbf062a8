{"cast":[{"adult":false,"backdrop_path":"/4BzmhmxdhAjsK1gcZfytYGAibr0.jpg","genre_ids":[53,35,28,80,18,10749],"id":11338,"title":"Ucieczka w noc","original_language":"en","original_title":"Into the Night","overview":"Ed Okin (Jeff Goldblum) jest zmęczony, praca go nudzi, żona zdradza, cierpi na bezsenność. W końcu pewnej nocy nie wytrzymuje, ubiera się i wychodzi z mieszkania. Chodząc bez celu po mieście spotyka piękną Diane (Michelle Pfeiffer), która wpędza go w aferę kryminalną, w efekcie której Ed musi ciągle uciekać przed mafią, agentami z różnych krajów, płatnym zabójcą.","popularity":3.9898,"poster_path":"/yvu991qkCyJPjLLpOHQjtIHy4mR.jpg","release_date":"1985-02-22","softcore":false,"video":false,"vote_average":6.54,"vote_count":334,"character":"Federal Agent","credit_id":"52fe44299251416c7502afab","order":19},{"adult":false,"backdrop_path":"/devWASeoLDUKuhWvCb5v18VFwOh.jpg","genre_ids":[27,878],"id":40231,"title":"The Incredible Melting Man","original_language":"en","original_title":"The Incredible Melting Man","overview":"","popularity":2.2922,"poster_path":"/cMsdALx0PfSWRQu6we0p6qbtLz.jpg","release_date":"1977-11-10","softcore":false,"video":false,"vote_average":4.564,"vote_count":94,"character":"Matt Winters","credit_id":"52fe4588c3a36847f80cc8ff","order":13},{"adult":false,"backdrop_path":"/eB2zJEmnwi4gFwxZnIHSG0ZhDGu.jpg","genre_ids":[16,99],"id":153153,"title":"Pablo","original_language":"en","original_title":"Pablo","overview":"","popularity":1.1284,"poster_path":"/cVpWK9xcW2UlscpMgY3eB4Mx8Mq.jpg","release_date":"2012-10-17","softcore":false,"video":false,"vote_average":6.9,"vote_count":7,"character":"Self","credit_id":"61b5eb264cd91200648c0dda","order":7},{"adult":false,"backdrop_path":"/vMvAc88StCTlnen3waWVCuKwA0q.jpg","genre_ids":[99],"id":846652,"title":"Hannibal Hopkins et Sir Anthony","original_language":"en","original_title":"Hannibal Hopkins et Sir Anthony","overview":"","popularity":2.1883,"poster_path":"/ADPaqb6QBsZpG7fRWYOULVZMto.jpg","relea