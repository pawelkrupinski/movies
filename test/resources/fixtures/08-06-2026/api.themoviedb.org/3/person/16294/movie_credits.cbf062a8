te_average":7.358,"vote_count":53,"credit_id":"579b19bc92514153f4002f6d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":344765,"title":"Another Telepathic Thing","original_language":"en","original_title":"Another Telepathic Thing","overview":"","popularity":0.7092,"poster_path":"/ntE8zyrS90NxpkXon3NbbWUk9wt.jpg","release_date":"2015-06-08","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"580cbedfc3a368260d00da9b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tkMPZ6sPmK2SH93Nkkc9qb5UwnC.jpg","genre_ids":[28,80,18,53,35],"id":14931,"title":"Miami Blues","original_language":"en","original_title":"Miami Blues","overview":"Recydywista Fred Frenger przybywa do Miami. Na lotnisku przywłaszcza sobie cudzy bagaż. Zaczepiony przez wyznawcę Hare Kriszna, łamie natrętowi palec. Nie wie, że na skutek szoku mężczyzna zmarł. Sprawę prowadzi sierżant Hoke Moseley, który bez większych kłopotów wpada na trop przestępcy. Nie traktuje sprawy poważnie do momentu, w którym, napadnięty przez Frengera, zostaje skatowany i pozbawiony broni, odznaki oraz sztucznej szczęki. Upokorzony, zabiera się za ściganie bandyty. Tymczasem Frenger objawia prawdziwe oblicze.","popularity":2.1376,"poster_path":"/eOqOf2qG0sjsfhFdYp6SbZuorSF.jpg","release_date":"1990-04-20","softcore":false,"video":false,"vote_average":6.018,"vote_count":223,"credit_id":"5830c3af92514162c00165d7","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/fGs4uCzpBcYBfqw4rINA7twHIGQ.jpg","genre_ids":[53,9648],"id":13440,"title":"Prawdziwe oblicze Charliego","original_language":"en","original_title":"The Truth About Charlie","overview":"Młoda kobieta mieszka w Paryżu, jej życie prywatne nie jest szczęśliwe. Jest w trakcie rozwodu. Pewnego dnia odkrywa, że jej mąż nie żyje, a ich wspólne oszczędności zniknęły. Wtedy pojawia się tajemniczy mężczyzna, który twierdzi, że te pieniądze tak naprawdę należą do niego i żąda ich oddania. Jest przekonany, że kobieta je ukryła. Remake filmu z 1963 roku pt.: \"Szarada\"","popularity":1.3804,"poster_path":"/sIK0PLVo27xdFsOLjvuvRJkXiyH.jpg","release_date":"2002-10-25","softcore":false,"video":false,"vote_average":4.859,"vote_count":197,"credit_id":"584ea10592514118ed00e1fc","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/XVVf9Si7c1NxlNmaH4m8KMzZQ0.jpg","genre_ids":[99],"id":443081,"title":"Beah: A Black Woman Speaks","original_language":"en","original_title":"Beah: A Black Woman Speaks","overview":"","popularity":0.8969,"poster_path":"/uMse4nsMafvraDDUjBbGp61i1pd.jpg","release_date":"2004-02-25","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"58be35bd9251413435008f80","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/fHY9TfKwC702kPxEcjkxCoLqUv6.jpg","genre_ids":[99,10402],"id":15675,"title":"Neil Young: Serce ze złota","original_language":"en","original_title":"Neil Young: Heart of Gold","overview":"Tuż po wydaniu, rewelacyjnego zdaniem wielu krytyków, albumu \"Prairie Wind\", Neil Young, żywa legenda rocka szturmem podbił Ryman Audytorium - historyczną salę Nashville's Grand Old Opry, doprowadzając licznie zgromadzoną publiczność do ekstazy mieszanką najnowszych przebojów i starych sprawdzonych szlagierów, wśród których znalazły się miedzy innymi: \"The Painter\", \"Heart Of Gold\" oraz \"Harvest Moon\". Neil Young wraz z towarzyszącą mu grupą wiernych muzycznych kompanów, wśród których prym wiodą jego żona Pegi Young oraz znakomita wokalistka Emmylou Harris po raz kolejny osiągnął ogromny sukces! Ten dokument w reżyserii zdobywcy Oscara, Jonathana Demme, stanowi niezwykły muzyczny portret duszy artysty i stanowi obowiązkową pozycję w kolekcji każdego miłośnika dobrej muzyki.","popularity":1.5705,"poster_path":"/c7DPRQN44hihnaijY69OWOVGqNZ.jpg","release_date":"2006-02-17","softcore":false,"video":false,"vote_average":7.535,"vote_count":43,"credit_id":"599a13b3c3a368396400629f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/hDqCT55tKH5qEWoI6DsNNaboy3S.jpg","genre_ids":[18,35],"id":97607,"title":"Gimme the Loot","original_language":"en","original_title":"Gimme the Loot","overview":"","popularity":0.7797,"poster_path":"/fsNWyUVWskfrhLhOjtUSYjWfJh7.jpg","release_date":"2012-10-12","softcore":false,"video":false,"vote_average":6.216,"vote_count":38,"credit_id":"644a7837f794ad04563d038a","department":"Crew","job":"Presenter"},{"adult":false,"backdrop_path":"/k4renoGJzagylgBYWbpjQLYGAfB.jpg","genre_ids":[27,9648,18],"id":361292,"title":"Suspiria","original_language":"en","original_title":"Suspiria","overview":"Amerykańska baletnica rozpoczyna naukę na prestiżowej niemieckiej akademii tańca. Niebawem odkrywa mroczne sekrety szkoły.","popularity":6.6166,"poster_path":"/cGW8XU6BvORXm9bYT9LJe9TUglm.jpg","release_date":"2018-10-26","softcore":false,"video":false,"vote_average":6.898,"vote_count":2794,"credit_id":"665f5547d956c67aa7004a5f","department":"Crew","job":"In Memory Of"},{"adult":false,"backdrop_path":"/sJZd1H4cl2Nxhj0nutVCK5pMczL.jpg","genre_ids":[18,10749],"id":400617,"title":"Nić widmo","original_language":"en","original_title":"Phantom Thread","overview":"Londyn, lata pięćdziesiąte. Słynny krawiec Reynolds Woodcock wraz z siostrą Cyril stanowią centrum brytyjskiej mody, ubierając gwiazdy filmowe, rodzinę królewską, socjetę, damy i debiutantki. Wszystko to w wytwornym stylu The House of Woodcock.  Przez życie Woodcocka przewija się mnóstwo kobiet, inspirują go, towarzyszą, on wciąż pozostaje kawalerem. Aż do momentu, w którym w jego życiu pojawia się Alma, która wkrótce staje się jego muzą i kochanką. Jego uporządkowane życie burzy miłość.","popularity":7.9968,"poster_path":"/nDATvPr5y54G8sEDkd17W1V0ba8.jpg","release_date":"2017-12-25","softcore":false,"video":false,"vote_average":7.315,"vote_count":3816,"credit_id":"665f555c43ba5474df0902b7","department":"Crew","job":"In Memory Of"},{"adult":false,"backdrop_path":"/qXzqEcHs9YcEgkjoNdWvxM2kIqZ.jpg","genre_ids":[18,10402],"id":429202,"title":"Vox Lux","original_language":"en","original_title":"Vox Lux","overview":"Celeste była nastolatką, kiedy wielka tragedia wywindowała ją na szczyty sławy i zrobiła z niej gwiazdę muzyki pop. Od tej pory media śledziły każdy jej ruch, a jej kariera rozwijała się w cieniu zjawisk, które naznaczyły XXI wiek: ataków terrorystycznych, szkolnych strzelanin, medialnej rewolucji. Dzisiaj Celeste nie jest już tą samą osobą. Po skandalicznym incydencie, który o mały włos nie zrujnował jej kariery, chce wrócić na scenę. Musi ponownie zmierzyć się ze wspomnieniami sprzed lat, a w dodatku – przygotować się do wielkiej trasy koncertowej.","popularity":3.9331,"poster_path":"/xmFOjB5bGvFqNzsX5TbIWzdvpGd.jpg","release_date":"2018-09-07","softcore":false,"video":false,"vote_average":5.771,"vote_count":535,"credit_id":"665f55340d48b3f88ff2238b","department":"Crew","job":"In Memory Of"},{"adult":false,"backdrop_path":"/9C41BHwReEBBndjcKp7KhsYoWvs.jpg","genre_ids":[18],"id":119907,"title":"Household Saints","original_language":"en","original_title":"Household Saints","overview":"","popularity":2.0338,"poster_path":"/1C24iDt0aP88KnYxf7sdrwiRUOK.jpg","release_date":"1993-09-15","softcore":false,"video":false,"vote_average":6.733,"vote_count":15,"credit_id":"5acbfd500e0a26320a01dc47","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":525389,"title":"The Power of Rock","original_language":"en","original_title":"The Power of Rock","overview":"","popularity":0.8063,"poster_path":"/ktkdZFvkls3uIUfVgsrVieyB3t2.jpg","release_date":"2017-07-01","softcore":false,"video":false,"vote_average":2.0,"vote_count":1,"credit_id":"5b01d48292514109b400b919","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":525390,"title":"Protection Not Protest: The People of Standing Rock","ori