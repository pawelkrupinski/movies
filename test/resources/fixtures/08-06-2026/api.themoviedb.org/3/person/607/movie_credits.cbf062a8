jIm6pOQB2CUj4.jpg","release_date":"2018-09-30","softcore":false,"video":false,"vote_average":6.676,"vote_count":460,"credit_id":"594f7af3925141315504ab5b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/PsyMMWKOyMVjTZBiyhNebyHDsQ.jpg","genre_ids":[18,35],"id":1147596,"title":"第二十条","original_language":"zh","original_title":"第二十条","overview":"","popularity":1.3763,"poster_path":"/nTKeuNKbnUgiZZ4vEZWpUds3DYP.jpg","release_date":"2024-02-10","softcore":false,"video":false,"vote_average":6.929,"vote_count":55,"credit_id":"662bc6ef9ac535011c8f5b76","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/lY6RkqchljFAS7MrylH4l1nGXIU.jpg","genre_ids":[9648,35,53,36],"id":1066298,"title":"Rzeka szkarłatu","original_language":"zh","original_title":"满江红","overview":"Generał wojskowy z czasów południowej dynastii Song (1127-1279), znany ze swojego patriotyzmu i lojalności wobec kraju, został wrobiony i stracony przez premiera Qin Hui, jednego z najbardziej zdradzieckich urzędników w historii Chin.","popularity":2.2425,"poster_path":"/eqcH2KZZMJUvpYM1SWhch2XpSyp.jpg","release_date":"2023-01-22","softcore":false,"video":false,"vote_average":6.05,"vote_count":180,"credit_id":"644d178c5e14e504b8b89440","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/qODx2OuPQNDxXUoqHBmTNww2iC3.jpg","genre_ids":[12,18,28],"id":9550,"title":"Dom Latających Sztyletów","original_language":"zh","original_title":"十面埋伏","overview":"Zrealizowany z niespotykanym rozmachem film twórcy \"Hero\".\r Chiny, rok 859. Dynastia Tang chyli się ku upadkowi. Rząd jest skorumpowany, cesarz niezdolny do sprawowania władzy. W kraju panuje niepokój. Grupa buntowników o nazwie Dom Latających Sztyletów, zaczyna szybko rosnąć w siłę. Dwaj wierni cesarzowi kapitanowie z prowincji: Leo (Andy Lau) i Jin (Takeshi Kaneshiro) dostają do spełnienia tajną misję. W ciągu dziesięciu dni mają schwytać tajemniczego przywódcę Domu Latających Sztyletów.","popularity":