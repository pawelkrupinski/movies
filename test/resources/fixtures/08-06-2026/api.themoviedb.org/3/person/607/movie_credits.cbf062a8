redit_id":"532eda359251413a85003454","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/9a8rTHiVxVphC02qqz7lTpjvT4s.jpg","genre_ids":[18,10402,36],"id":92990,"title":"黄土地","original_language":"zh","original_title":"黄土地","overview":"","popularity":2.689,"poster_path":"/gawkwGE9rtx2vc1HT8rsgdOgkvg.jpg","release_date":"1984-08-19","softcore":false,"video":false,"vote_average":7.2,"vote_count":61,"credit_id":"532eda229251413a75003405","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/s7xVB5OPWw6GO40VBeEJcX9EwNt.jpg","genre_ids":[18,10749,10752],"id":31439,"title":"Żyć!","original_language":"zh","original_title":"活着","overview":"Chiny poczatek XX wieku; epicka saga ukazującą losy członków pewnej rodziny. Po wojnie domowej i przejęciu władzy przez komunistów, bankructwo Fugui i Jiazheny okazuje się być szczęściem w nieszczęściu. Rodzina musi stawić czoło wojennej zawierusze, rewolucji kulturalnej i terrorowi Mao Tse Tunga.Dzięki woli przeżycia, zachowaniu więzów rodzinnych, udaje się jej pokonać największe nieszczęścia i przeciwności losu.","popularity":8.3054,"poster_path":"/lYxJxcRQAoEHtz94ZMJyODiwh8S.jpg","release_date":"1994-05-18","softcore":false,"video":false,"vote_average":8.1,"vote_count":384,"credit_id":"653be81be894a600ad56247a","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[10402],"id":181067,"title":"Puccini: Turandot at the Forbidden City of Beijing","original_language":"en","original_title":"Puccini: Turandot at the Forbidden City of Beijing","overview":"","popularity":0.857,"poster_path":"/fLw9I2KB2xMGLvjHwdbkIDCIFDp.jpg","release_date":"1999-04-13","softcore":false,"video":false,"vote_average":8.0,"vote_count":3,"credit_id":"54ce82379251414757006048","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uonotYnbDrHXcMFA1AbembrrQ8N.jpg","genre_ids":[18,99],"id":48336,"title":"Lumière et Compagnie","original_language":"fr","original_title":"Lumière et Compagnie","overview":"","popularity":1.8494,"poster_path":"/iCDYGeKvRCyS0d2NUn8O5o9doZZ.jpg","release_date":"1995-12-20","softcore":false,"video":false,"vote_average":6.34,"vote_count":72,"credit_id":"54d526c29251413fc1014a02","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/th26RNksfM9nn7DPH06OqiV6BA2.jpg","genre_ids":[28,12,14],"id":311324,"title":"Wielki Mur","original_language":"en","original_title":"The Great Wall","overview":"Między odwagą a strachem, między ludźmi i potworami powstał mur, któremu nie wolno runąć. Uwięziony w labiryntach Wielkiego Muru Chińskiego najemnik odkrywa tajemnicę stojącą za powstaniem legendarnej budowli, jednego z cudów świata. Kiedy kolejne fale niepowstrzymanych, krwiożerczych bestii próbują przejąć kontrolę nad światem, chcąc obalić legendarny Wielki Mur Chiński, najemnik i opryszek William Garin staje na czele walki, która z szukającego przygód mężczyzny zmieni go w bohatera.","popularity":11.0801,"poster_path":"/gvE5r2UeJlFCNtf1ZGt6nHtxK0c.jpg","release_date":"2016-12-16","softcore":false,"video":false,"vote_average":6.033,"vote_count":5615,"credit_id":"54d9fdbbc3a368210800138a","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/fgXGiNzclVhjAJvUkrwiKEaULjo.jpg","genre_ids":[],"id":934984,"title":"2022年第24届北京冬季奥运会开幕式","original_language":"zh","original_title":"2022年第24届北京冬季奥运会开幕式","overview":"","popularity":0.9405,"poster_path":"/mHSniN17uUxBbspv0wERC6V83S3.jpg","release_date":"2022-02-04","softcore":false,"video":true,"vote_average":7.7,"vote_count":7,"credit_id":"61fdc865e48860001bb2274a","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kl7N2uKee2aIORJ4tlW5SMdyXTz.jpg","genre_ids":[99],"id":935344,"title":"2022年第24届北京冬季奥运会闭幕式","original_language":"zh","original_title":"2022年第24届北京冬季奥运会闭幕式","overview":"","popularity":1.7512,"poster_path":"/uQxi6m5UEUqiIIwzO2jDG7wSlNy.jpg","release_date":"2022-02-20","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"credit_id":"62046a2e46f3540069f769d6","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lY6RkqchljFAS7MrylH4l1nGXIU.jpg","genre_ids":[9648,35,53,36],"id":1066298,"title":"Rzeka szkarłatu","original_language":"zh","original_title":"满江红","overview":"Generał wojskowy z czasów południowej dynastii Song (1127-1279), znany ze swojego patriotyzmu i lojalności wobec kraju, został wrobiony i stracony przez premiera Qin Hui, jednego z najbardziej zdradzieckich urzędników w historii Chin.","popularity":2.2425,"poster_path":"/eqcH2KZZMJUvpYM1SWhch2XpSyp.jpg","release_date":"2023-01-22","softcore":false,"video":false,"vote_average":6.05,"vote_count":180,"credit_id":"63aa5d52a6a4c1007df03bc3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/20vIC3JXCFrsLwv0TpiBbK7IKh2.jpg","genre_ids":[35,18],"id":36108,"title":"Kocham kino","original_language":"fr","original_title":"Chacun son cinema ou Ce petit coup au coeur quand la lumiere s'eteint et que le film commence","overview":",,Chacun son cinéma\" to hołd złożony magii kina. Film, powstał na 60. urodziny Festiwalu w Cannes w 2007r. Obraz składa się z 33 etiud słynnych światowych reżyserów. Motywem łączącym je wszystkie jest nieśmiertelny temat kina. Pomysłodawcą obrazu jest pan Gilles Jacob.","popularity":2.1872,"poster_path":"/oqsHDWIh26sJXz9Ua3lPQhUx3lK.jpg","release_date":"2007-10-31","softcore":false,"video":false,"vote_average":6.5,"vote_count":155,"credit_id":"57fe7f19c3a3681de6009b99","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/suyfMtKOwIq0o7CvmjlgIMue4bP.jpg","genre_ids":[35,10749,14,18],"id":422390,"title":"28岁未成年","original_language":"zh","original_title":"28岁未成年","overview":"","popularity":1.4981,"poster_path":"/oGQYUexYjIbfl4T3YIarH07I7Gi.jpg","release_date":"2016-12-09","softcore":false,"video":false,"vote_average":7.25,"vote_count":36,"credit_id":"580c5c05c3a368228600acc7","department":