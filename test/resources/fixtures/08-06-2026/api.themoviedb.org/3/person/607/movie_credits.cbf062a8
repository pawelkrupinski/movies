{"cast":[{"adult":false,"backdrop_path":"/cjGr4luNLyMi7ADqlE3xzWzlZJv.jpg","genre_ids":[35],"id":37909,"title":"有话好好说","original_language":"zh","original_title":"有话好好说","overview":"","popularity":1.5006,"poster_path":"/ryK7r4cVCHNLUBAbvtpuOwhAecO.jpg","release_date":"1997-09-02","softcore":false,"video":false,"vote_average":7.492,"vote_count":62,"character":"Junk Peddler","credit_id":"52fe467d9251416c91056125","order":4},{"adult":false,"backdrop_path":"/4bjVA2NrkrdNPPpKUt7eR2P3xlf.jpg","genre_ids":[18,10749,36],"id":42006,"title":"Czerwone sorgo","original_language":"zh","original_title":"红高粱","overview":"Nine poślubia starego i trędowatego właściciela destylarni brandy. Po śmierci męża zostaje właścicielką winnicy. Nareszcie może kontynuować romans z pracownikiem męża, który niegdyś uratował ją przed gwałtem. Zbliżająca się japońska inwazja zburzy ich spokój.","popularity":5.0265,"poster_path":"/lbYeGboAkIdNQHN4uS14k78ACHo.jpg","release_date":"1988-10-10","softcore":false,"video":false,"vote_average":7.2,"vote_count":247,"character":"","credit_id":"64577294156cc700ffa65b1b","order":15},{"adult":false,"backdrop_path":"/4C7pLa1mwZRwdql1KU8YWfOhHxp.jpg","genre_ids":[12,35,14,10749],"id":96466,"title":"秦俑","original_language":"zh","original_title":"秦俑","overview":"","popularity":1.8263,"poster_path":"/9Alvzyby49MeYzESgKZj1Z099BB.jpg","release_date":"1989-12-18","softcore":false,"video":false,"vote_average":6.6,"vote_count":31,"character":"General Meng Tianfang","credit_id":"52fe49b49251416c750d0b11","order":0},{"adult":false,"backdrop_path":"/MngFxwhXr11YEqJgdhPCjLQ0cV.jpg","genre_ids":[99],"id":726775,"title":"Making of House of Flying Daggers","original_language":"zh","original_title":"Making of House of Flying Daggers","overview":"","popularity":0.6459,"poster_path":"/pz9vICNdbZA1hopxK0lwSC7bVrn.jpg","release_date":"2004-12-31","softcore":false,"video":false,"vote_average":6.833,"vote_count":6,"character":"Self","credit_id":"625eeaaddfaae90173639696","order":0},{"ad