.","popularity":3.7103,"poster_path":"/vAGuXvPHfiLvIcQqqmPx3QZ3CKT.jpg","release_date":"2024-11-21","softcore":false,"video":false,"vote_average":7.3,"vote_count":74,"credit_id":"6a31c34ecd22857bd2468465","department":"Writing","job":"Writer"}],"id":53090}