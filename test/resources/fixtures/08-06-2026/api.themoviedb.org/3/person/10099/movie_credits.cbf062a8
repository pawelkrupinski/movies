 korporacyjnych strażników, postanawia odzyskać godność za wszelką cenę – decyzja ta pcha go na ścieżkę przemocy, z której nie ma już odwrotu.","popularity":17.4807,"poster_path":"/i0wW7s5hR0lMI8bRC9D1CZyNYF.jpg","release_date":"2025-09-24","softcore":false,"video":false,"vote_average":7.513,"vote_count":1188,"credit_id":"6669feaecf0e4d9ecdaa2062","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/qcHOh5PoygMtPbhpeBC0VUNNtAp.jpg","genre_ids":[28,18,36],"id":1075676,"title":"Wojna i rewolta","original_language":"ko","original_title":"전,란","overview":"Czasy dynastii Joseon. Dwóch przyjaciół, którzy dorastali razem — choć w odmiennych grupach społecznych — spotyka się po wojnie, tyle że po przeciwnych stronach barykady.","popularity":3.3036,"poster_path":"/gnfNGXdW7J9HGNeHyaDpkAFJkHK.jpg","release_date":"2024-10-02","softcore":false,"video":false,"vote_average":7.0,"vote_count":212,"credit_id":"647fca40d2b209012dfab589","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/vngRPSVDXeV8G8tkOga7LnRuFBe.jpg","genre_ids":[28,53],"id":20971,"title":"Zinda","original_language":"hi","original_title":"Zinda","overview":"","popularity":1.201,"poster_path":"/8dnHugvmE4CV2BLGHBcajmzBWpB.jpg","release_date":"2006-01-12","softcore":false,"video":false,"vote_average":4.017,"vote_count":29,"credit_id":"64906af92f8d0900ad36047e","department":"Writing","job":"Original Film Writer"},{"adult":false,"backdrop_path":"/2HqfW9aAx6qg1B5w1RrGkUy2NiP.jpg","genre_ids":[10752,53,28],"id":547302,"title":"격세지감","original_language":"ko","original_title":"격세지감","overview":"","popularity":0.8419,"poster_path":"/mY1PZai4Ieob9LPTvJEhqbGMnQ1.jpg","release_date":"2017-05-30","softcore":false,"video":true,"vote_average":0.0,"vote_count":0,"credit_id":"5b94f0f70e0a26197e01c4ef","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/2HqfW9aAx6qg1B5w1RrGkUy2NiP.jpg","genre_ids":[10752,53,28],"id":547302,"title":"격세지감","original_language":"ko","o