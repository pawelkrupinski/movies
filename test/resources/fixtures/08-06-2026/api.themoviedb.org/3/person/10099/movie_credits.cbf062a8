0.5121,"poster_path":"/fkyAcK87KX7i68pDeEqpnIbe0tE.jpg","release_date":"2026-05-23","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6a131bdef9a419221efd24c1","order":1}],"crew":[{"adult":false,"backdrop_path":"/sdwjQEM869JFwMytTmvr6ggvaUl.jpg","genre_ids":[53,9648],"id":670,"title":"Oldboy","original_language":"ko","original_title":"올드보이","overview":"Oh Dae-su zdaje się prowadzić całkiem normalne i ustabilizowane życie. Ma żonę i małą córkę, jednak zostaje uprowadzony w dniu jej urodzin. Budzi się w mieszkaniu, które jest całkowicie odcięte od świata. Jedynym oknem na świat jest telewizor. Oh Dae-su uczy się wielu nowych rzeczy, spisuje pamiętniki i planuje zemstę. W tym więzieniu spędza 15 lat, gdy zostaje wypuszczony, dowiaduje się, że ma zaledwie kilka dni na poznanie prawdy. Staje przed wyborem: zemsta, czy wiedza o tym, dlaczego?","popularity":21.1421,"poster_path":"/ltJM6KsIndncBeBZnHchgXSOzJn.jpg","release_date":"2003-11-21","softcore":false,"video":false,"vote_average":8.234,"vote_count":10026,"credit_id":"52fe4267c3a36847f801bd53","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/z7w6ACQJTeGYASr1plSwfRe6Ytk.jpg","genre_ids":[18,53,9648],"id":2440,"title":"Wspólna strefa bezpieczeństwa","original_language":"ko","original_title":"공동경비구역 JSA","overview":"Dwóch północnokoreańskich żołnierzy ginie na pograniczu Korei Północnej i Południowej, co prowadzi do wszczęcia śledztwa przez organ neutralny. Strzelcem jest sierżant, ale główna śledcza, kobieta pochodzenia szwajcarsko-koreańskiego, otrzymuje rozbieżne relacje z obu stron.","popularity":4.6298,"poster_path":"/6pZw6KFwrADsS4HYfJe8AHMwpQh.jpg","release_date":"2000-09-09","softcore":false,"video":false,"vote_average":7.8,"vote_count":853,"credit_id":"52fe4357c3a36847f804d06f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/z7w6ACQJTeGYASr1plSwfRe6Ytk.jpg","genre_ids":[18,53,9648],"id":2440,"title":"Wspólna strefa bezpieczeństwa","original_language":"ko","original_title":"공동경비구역 JSA","overview":"Dwóch północnokoreańskich żołnierzy ginie na pograniczu Korei Północnej i Południowej, co prowadzi do wszczęcia śledztwa przez organ neutralny. Strzelcem jest sierżant, ale główna śledcza, kobieta pochodzenia szwajcarsko-koreańskiego, otrzymuje rozbieżne relacje z obu stron.","popularity":4.6298,"poster_path":"/6pZw6KFwrADsS4HYfJe8AHMwpQh.jpg","release_date":"2000-09-09","softcore":false,"video":false,"vote_average":7.8,"vote_count":853,"credit_id":"52fe4357c3a36847f804d057","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wP1nu98mgiSOyuPmMWdZ8109S9j.jpg","genre_ids":[18,53],"id":4550,"title":"Pani Zemsta","original_language":"ko","original_title":"친절한 금자씨","overview":"Lee Geum-Ja, 19-letnia uczennica trafia do więzienia, skazana za morderstwo i porwanie dziecka. Tak naprawdę kryje swojego wspólnika Baeka, lecz dowiaduje się, że została oszukana. Będąc już w więzieniu, starannie przygotowuje plan zemsty, jednocześnie zdobywając poparcie i szacunek współwięźniów, którzy nadają jej pseudonim 'życzliwa Geum-Ja'. Po 13 latach, gdy opuszcza mury więzienia, wraz z byłymi znajomymi z celi, rozpoczyna poszukiwania Baeka.","popularity":5.994,"poster_path":"/lFSGVzT9kifbFrwGXRMNjEi0nAu.jpg","release_date":"2005-07-29","softcore":false,"video":false,"vote_average":7.519,"vote_count":1984,"credit_id":"52fe43cbc3a36847f8070265","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wP1nu98mgiSOyuPmMWdZ8109S9j.jpg","genre_ids":[18,53],"id":4550,"title":"Pani Zemsta","original_language":"ko","original_title":"친절한 금자씨","overview":"Lee Geum-Ja, 19-letnia uczennica trafia do więzienia, skazana za morderstwo i porwanie dziecka. Tak naprawdę kryje swojego wspólnika Baeka, lecz dowiaduje się, że została oszukana. Będąc już w więzieniu, starannie przygotowuje plan zemsty, jednocześnie zdobywając poparcie i szacunek współwięźniów, którzy nadają jej pseudonim 'życzliwa Geum-Ja'. Po 13 latach, gdy opuszcza mury więzienia, wraz z byłymi znajomymi z celi, rozpoczyna poszukiwania Baeka.","popularity":5.994,"poster_path":"/lFSGVzT9kifbFrwGXRMNjEi0nAu.jpg","release_date":"2005-07-29","softcore":false,"video":false,"vote_average":7.519,"vote_count":1984,"credit_id":"52fe43cbc3a36847f8070271","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/eLgZPEG4994T2gjB1YtgQJrp8b3.jpg","genre_ids":[18,35,10749],"id":5488,"title":"Jestem cyborgiem i to jest OK","original_language":"ko","original_title":"싸이보그지만 괜찮아","overview":"","popularity":2.8046,"poster_path":"/vcNdtkQjZ91EtZyuacA27zxD29J.jpg","release_date":"2006-12-07","softcore":false,"video":false,"vote_average":7.035,"vote_count":609,"credit_id":"52fe4408c3a36847f807e5fb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eLgZPEG4994T2gjB1YtgQJrp8b3.jpg","genre_ids":[18,35,10749],"id":5488,"title":"Jestem cyborgiem i to jest OK","original_language":"ko","original_title":"싸이보그지만 괜찮아","overview":"","popularity":2.8046,"poster_path":"/vcNdtkQjZ91EtZyuacA27zxD29J.jpg","release_date":"2006-12-07","softcore":false,"video":false,"vote_average":7.035,"vote_count":609,"credit_id":"52fe4408c3a36847f807e607","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/b6elu2cz2Be9PqgX0MzggMCH4fk.jpg","genre_ids":[28,18,53],"id":4689,"title":"Pan Zemsta","original_language":"ko","original_title":"복수는 나의 것","overview":"Mroczny thriller będący pierwszym elementem \"trylogii zemsty\", w skład której wchodzą również \"Oldboy\" oraz \"Pani Zemsta\". Dong-jin, bogaty właściciel fabryki, w której pracuje Ryu, dowiaduje się, że jego córeczka została uprowadzona. Kiedy porywacze domagają się okupu, Dong-jin bez chwili wahania spełnia ich żądanie. Wkrótce dowiaduje się, że mimo to jego dziecko zostało zabite. Wtedy planuje krwawą zemstę.","popularity":5.3431,"poster_path":"/m28MM4SCMENXaw0H5lHv2hjlUbQ.jpg","release_date":"2002-03-29","so