enre_ids":[878,28,27],"id":41373,"title":"アサルトガールズ","original_language":"ja","original_title":"アサルトガールズ","overview":"","popularity":1.3423,"poster_path":"/4IYWffevPViObNjqBPDKWWJ818v.jpg","release_date":"2009-12-19","softcore":false,"video":false,"vote_average":4.682,"vote_count":44,"credit_id":"52fe45c5c3a36847f80d975b","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/h1iPLE2jTWFPKdM8YIDiTgEgbAf.jpg","genre_ids":[28,16,878,9648],"id":14571,"title":"機動警察パトレイバー 劇場版","original_language":"ja","original_title":"機動警察パトレイバー 劇場版","overview":"","popularity":2.1179,"poster_path":"/r7y7XdO9KCLEfsS8AZGOSKKJEbk.jpg","release_date":"1989-07-15","softcore":false,"video":false,"vote_average":6.944,"vote_count":187,"credit_id":"52fe46029251416c75069f63","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/AkyvSlL1XASeZolYjJRvzWjaTOF.jpg","genre_ids":[16,878,28,53],"id":14572,"title":"機動警察パトレイバー 2 the Movie","original_language":"ja","original_title":"機動警察パトレイバー 2 the Movie","overview":"","popularity":2.8217,"poster_path":"/5LNUJJaKAaM1Jk3FyphZyTbZyDO.jpg","release_date":"1993-08-07","softcore":false,"video":false,"vote_average":7.4,"vote_count":150,"credit_id":"52fe46029251416c75069f75","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/obDHA3z3M6IbacldHvdsrcQjn4o.jpg","genre_ids":[16,28,10752,878,18],"id":15877,"title":"スカイ・クロラ","original_language":"ja","original_title":"スカイ・クロラ","overview":"Akcja filmu rozgrywa się w alternatywnej teraźniejszości. Ludzie już nie toczą między sobą wojen, jednak przemoc wciąż ich fascynuje. Dla rozrywki tworzą sztuczne konflikty zbrojne, gdzie  \"mięsem armatnim\" są piloci zwani Kildrenami, stworzona genetycznie rasa istot, które nie mogą się zestarzeć. Jednym z Kildrenów jest Yuichi, który przybywa do nowej jednostki lotniczej.","popularity":2.7532,"poster_path":"/AfBuspF6MuzYKe2ESsELcowqUes.jpg","release_date":"2008-08-02","softcore":false,"video":false,"vote_average":6.693,"vote_count":179,"credit_id":"52fe46889251416c7507b431","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/nZn384qWYugXu6U1N8Ya0Iv0NXE.jpg","genre_ids":[16,14,9648,878],"id":15916,"title":"Angel's Egg","original_language":"ja","original_title":"天使のたまご","overview":"Dziwny, jakby martwy świat, w którym ludzie zamienili się w posągi goniące za cieniami dawnego życia, w którym już nigdy nie zagości słońce i wiecznie będzie padał deszcz. A w tym świecie dwie istoty wyróżniające się z ciemności: chłopak dzierżący broń o kształcie krzyża i dziewczynka o śnieżnobiałej cerze, niosąca ze sobą jajko. Ich drogi właśnie się skrzyżowały. Teraz będą wędrować razem, dwoje wędrowców, którzy nie pamiętają, skąd pochodzą i nie wiedzą, dokąd idą. Ich podróży będą towarzyszyły surrealistyczne obrazy i niejednoznaczne rozważania o życiu człowieka nawiązujące do Biblii.","popularity":4.8211,"poster_path":"/axYxKgxsKrcOa8dPyUaWbrAbCVi.jpg","release_date":"1985-12-22","softcore":false,"video":false,"vote_average":7.7,"vote_count":600,"credit_id":"52fe468a9251416c7507b881","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/cBL5ImXZKPzYoohKUGdrJEqKys1.jpg","genre_ids":[16,35,10749,878],"id":43967,"title":"うる星やつら2 ビューティフル・ドリーマー","original_language":"ja","original_title":"うる星やつら2 ビューティフル・ドリーマー","overview":"","popularity":1.5137,"poster_path":"/m7CFGcwc5HLbHkSlK3JBkayFBGV.jpg","release_date":"1984-02-11","softcore":false,"video":false,"vote_average":7.3,"vote_count":101,"credit_id":"52fe466ec3a36847f80feb3b","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/cBL5ImXZKPzYoohKUGdrJEqKys1.jpg","genre_ids":[16,35,10749,878],"id":43967,"title":"うる星やつら2 ビューティフル・ドリーマー","original_language":"ja","original_title":"うる星やつら2 ビューティフル・ドリーマー","overview":"","popularity":1.5137,"poster_path":"/m7CFGcwc5HLbHkSlK3JBkayFBGV.jpg","release_date":"1984-02-11","softcore":false,"video":false,"vote_average":7.3,"vote_count":101,"credit_id":"52fe466ec