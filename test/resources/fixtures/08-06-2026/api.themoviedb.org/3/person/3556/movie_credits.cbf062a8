ednak ucieka skuty kajdanami ze złodziejem. Tymczasem \"człowieka śniegu\" zaczyna się uważać za sprawcę coraz liczniejszych przestępstw. W końcu wszystko się wyjaśnia. W telegramie zawiadamiającym o przesyłce przekręcono słowo i stąd całe nieporozumienie.","popularity":0.599,"poster_path":"/lu4q7PpMr4c3LNt3CBjprg1B68s.jpg","release_date":"1961-01-20","softcore":false,"video":false,"vote_average":3.833,"vote_count":6,"character":"Driver","credit_id":"595fac6d9251410bfa0a6c17","order":13},{"adult":false,"backdrop_path":"/A5lLdAr0aXu6XqXq35Sb432732J.jpg","genre_ids":[12],"id":204196,"title":"Samson","original_language":"pl","original_title":"Samson","overview":"","popularity":0.6413,"poster_path":"/xF4QU8J4UNFrUyeRi19t9KbkCVX.jpg","release_date":"1961-09-11","softcore":false,"video":false,"vote_average":4.8,"vote_count":12,"character":"Partner of Malina's Blackmailer (uncredited)","credit_id":"595facef9251410b860a49c4","order":23},{"adult":false,"backdrop_path":null,"genre_ids":[35,18],"id":465062,"title":"Chassé-croisé","original_language":"fr","original_title":"Chassé-croisé","overview":"","popularity":0.6208,"poster_path":"/vRrMimhhrQypMR6rCnhtRTiPP8e.jpg","release_date":"1982-03-24","softcore":false,"video":false,"vote_average":3.0,"vote_count":5,"character":"","credit_id":"595fb1089251410b860a4e9d","order":7},{"adult":false,"backdrop_path":"/59nOapuyfhNFSkj7lx4b1RDf7hX.jpg","genre_ids":[99],"id":469931,"title":"Ciné regards: Tess: Roman Polanski","original_language":"fr","original_title":"Ciné regards: Tess: Roman Polanski","overview":"","popularity":3.9319,"poster_path":"/3nDGmrW569kB5yPu0yh77U58U5j.jpg","release_date":"1979-09-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"59890ab3c3a36874f20077a2","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":471389,"title":"Remembering 'Rosemary's Baby'","original_language":"en","original_title":"Remembering 'Rosemary's Baby'","overview":"","populari