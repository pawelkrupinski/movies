edę, pewien chłopiec ucieka przed nieustępliwym brygadzistą. Aby ukryć się przed prześladowcami, musi pokonać jałową i pełną niebezpieczeństw równinę. Na swojej drodze spotyka pasterza kóz, który od dawna żyje poza społeczeństwem. Początkowo mężczyzna i chłopiec są względem siebie niechętni. Z czasem jednak rodzi się między nimi przyjaźń.","popularity":1.7545,"poster_path":"/nHM2gJJpFbiBpRNBel7u6noAc6L.jpg","release_date":"2019-11-22","softcore":false,"video":false,"vote_average":6.649,"vote_count":101,"character":"Guardesa","credit_id":"5d76a5df12970c1e0f9c0e29","order":6},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":643498,"title":"El Miramiento","original_language":"es","original_title":"El Miramiento","overview":"","popularity":1.6704,"poster_path":"/6tSrIFCR3hGPKtqNA7VLLx4BZ5f.jpg","release_date":"2018-11-09","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"5db83693a1d3320011e7049e","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[10752],"id":669398,"title":"Días rojos","original_language":"es","original_title":"Días rojos","overview":"","popularity":5.743,"poster_path":"/9fJIrorbfOgmYezBrzYfFPHgcTQ.jpg","release_date":"2004-10-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":3,"character":"Madre","credit_id":"5e37e0a80c2710001572fb29","order":4},{"adult":false,"backdrop_path":"/ngNRRaZzrZYekjfBGavgF5ciK2u.jpg","genre_ids":[18,35],"id":427109,"title":"Los del túnel","original_language":"es","original_title":"Los del túnel","overview":"","popularity":0.9922,"poster_path":"/kz6O0JgdXdTKddmY4SThac56VZP.jpg","release_date":"2017-01-20","softcore":false,"video":false,"vote_average":4.352,"vote_count":64,"character":"Abuela","credit_id":"5e76192b357c0000164ef582","order":17},{"adult":false,"backdrop_path":"/25EHw7H8IOHahaBZHDRywJ4grBl.jpg","genre_ids":[10749,18],"id":689510,"title":"Èxode, de la batalla a la frontera","original_language":"es","original_title":"Èxode, de la batalla a l