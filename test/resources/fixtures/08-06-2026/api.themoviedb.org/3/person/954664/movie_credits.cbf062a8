akażeni zdołają opuścić bazę, infekcja rozleje się na cały świat.","popularity":4.1348,"poster_path":"/pmEOzrXNAOUn4I9weT78jX3jkfn.jpg","release_date":"2014-10-31","softcore":false,"video":false,"vote_average":5.613,"vote_count":1287,"character":"Anciana","credit_id":"53c66cb20e0a267ff100206c","order":6},{"adult":false,"backdrop_path":"/shepxzdoctg4zR6sSIAuobFsy5Q.jpg","genre_ids":[9648,27],"id":299340,"title":"La herencia Valdemar II: La sombra prohibida","original_language":"es","original_title":"La herencia Valdemar II: La sombra prohibida","overview":"","popularity":1.0535,"poster_path":"/5yWhk9N6RPhHIZ5s17VZq5b5vwR.jpg","release_date":"2010-10-07","softcore":false,"video":false,"vote_average":5.296,"vote_count":81,"character":"Gitana","credit_id":"544e90c9c3a3686376000438","order":11},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":302600,"title":"Luisa no está en casa","original_language":"es","original_title":"Luisa no está en casa","overview":"","popularity":1.8867,"poster_path":null,"release_date":"2012-10-24","softcore":false,"video":false,"vote_average":6.0,"vote_count":2,"character":"Concha","credit_id":"5463f3bf0e0a262946000207","order":2},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":115551,"title":"Nacidas para sufrir","original_language":"es","original_title":"Nacidas para sufrir","overview":"","popularity":0.6228,"poster_path":"/3D9oXRILSG5dlyp60w7dLWYyvJy.jpg","release_date":"2010-02-12","softcore":false,"video":false,"vote_average":5.5,"vote_count":7,"character":"","credit_id":"6377e27134e152007f37762a","order":8},{"adult":false,"backdrop_path":"/hzV7oyPLy4JlESd7IWvD9AkgxlF.jpg","genre_ids":[18],"id":80713,"title":"Solas","original_language":"es","original_title":"Solas","overview":"","popularity":0.8402,"poster_path":"/1ovtyHHDjyCXtf46w2Yv3yPeUDY.jpg","release_date":"1999-03-05","softcore":false,"video":false,"vote_average":7.019,"vote_count":54,"character":"Vieja del carro","credit_id":"5606d52b9251413058002132","order":11}