eles, 79-letnia Hiszpanka, mieszka samotnie w Tangerze w Maroku i cieszy się codziennym życiem. Jednak jej życie wywraca się do góry nogami, gdy jej córka przyjeżdża z Madrytu, aby sprzedać mieszkanie, w którym zawsze mieszkała. Zdeterminowana, by zostać, robi wszystko, co w jej mocy, by odzyskać dom i dobytek, i niespodziewanie na nowo odkrywa miłość i zmysłowość.","popularity":2.2994,"poster_path":"/azbn8uDQ7kAyDX57EKjsrUFSCSr.jpg","release_date":"2025-10-31","softcore":false,"video":false,"vote_average":7.391,"vote_count":55,"character":"Josefa","credit_id":"687e8a5e90c737dad716a492","order":4},{"adult":false,"backdrop_path":"/7eeBN9k5meykV79FnosSvy7th5y.jpg","genre_ids":[53,18,10749],"id":1579471,"title":"Calcinación","original_language":"es","original_title":"Calcinación","overview":"","popularity":2.6901,"poster_path":"/xYZHsSPPBZzURHWce6T83vupNb8.jpg","release_date":"2026-04-17","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Vecina","credit_id":"6914882f104a5c0a2ddd2e59","order":6},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":1705480,"title":"Ser.vicio Público","original_language":"es","original_title":"Ser.vicio Público","overview":"","popularity":0.1511,"poster_path":"/AvJQM3FVwqxZ2TnakYBG6dSwQ9C.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"","credit_id":"6a1c04aae9a625b084ad47a6","order":0}],"crew":[],"id":954664}