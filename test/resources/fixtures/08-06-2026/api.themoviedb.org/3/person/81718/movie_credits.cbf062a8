{"cast":[{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":590765,"title":"Hand-Drawn: Documentary","original_language":"en","original_title":"Hand-Drawn: Documentary","overview":"","popularity":0.4203,"poster_path":"/rnvONtNWmTX1sbt9KD5yil7zz5A.jpg","release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"61fdf64efcec2e004294a5f4","order":3},{"adult":false,"backdrop_path":"/69E5rFCA4KwZ7fdO3ybS0LU3laF.jpg","genre_ids":[99],"id":809488,"title":"Satoshi Kon, l'illusionniste","original_language":"fr","original_title":"Satoshi Kon, l'illusionniste","overview":"","popularity":2.0985,"poster_path":"/xFz2GgzZFqMauuF5GIGxQwaYjNg.jpg","release_date":"2021-07-08","softcore":false,"video":false,"vote_average":6.679,"vote_count":14,"character":"Self","credit_id":"60a6d293fac5020059b961f7","order":0}],"crew":[{"adult":false,"backdrop_path":"/1G8c61oSyvaxCD7COja8k3BX2bF.jpg","genre_ids":[14,16,878,10751],"id":20455,"title":"Digimon","original_language":"en","original_title":"Digimon: The Movie","overview":"Digimony żyją we własnym świecie, który istnieje obok realnego. Jednym z portali łaczących oba światy jest internet. Wiele dzieci na swoich laptopach komunikuje się z digimonami, przeżywając rozmaite przygody. Niestety jeden digi-wirus postanawia podbić realny świat ...","popularity":2.8049,"poster_path":"/zB3pTpa5JmdbGklonQdKxR61Wmr.jpg","release_date":"2000-10-06","softcore":false,"video":false,"vote_average":6.5,"vote_count":300,"credit_id":"52fe43e7c3a368484e005015","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/wSFAoevZuVBo4L9f8NgYSD1o9cQ.jpg","genre_ids":[16,878],"id":28874,"title":"Summer Wars","original_language":"ja","original_title":"サマーウォーズ","overview":"Kenji to nieśmiały moderator platformy OZ, wirtualnego świata przeplatającego się z codziennym życiem, który dostaje propozycję od pięknej i popularnej Natsuki, aby udawał jej chłopaka. Udając przed jej rodziną bogatego adoratora, Kenji odkrywa, że zbuntowane AI ukradło jego internetową tożsamość, a sam Kenji zostaje oskarżony o włamanie się do OZ i spowodowanie katastrof w świecie rzeczywistym. Zniszczenia w OZ pogrążają rodzinę Natsuki w chaosie, a Kenji musi wykorzystać swoje nowo odkryte więzi, aby stawić czoła zbliżającej się cyberapokalipsie.","popularity":5.9298,"poster_path":"/2skshBduXPlYuWVm0T1e4dcBQEI.jpg","release_date":"2009-08-01","softcore":false,"video":false,"vote_average":7.453,"vote_count":1053,"credit_id":"52fe45b8c3a368484e06b283","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6m2qbAqSMJTX4HUwRvVEQI6ioiO.jpg","genre_ids":[14,16,18,878],"id":14069,"title":"O dziewczynie skaczącej przez czas","original_language":"ja","original_title":"時をかける少女","overview":"Makoto jest zwyczajną nastolatką, spędzającą większość czasu z przyjaciółmi. Kiedy pewnego dnia, spiesząc się z wizytą do ciotki, cudem unika potrącenia przez pociąg – przeskakuje w czasie do momentu sprzed wypadku. Korzystając z nowo poznanych zdolności, naprawia swoje codzienne błędy – od słabych ocen na sprawdzianach po nieudane wyznania miłości. Kiedy jednak dosięgają ją konsekwencje manipulowania czasem, Makoto musi zrobić wszystko, żeby uniknąć straszliwej przyszłości, której nie da się cofnąć.","popularity":6.313,"poster_path":"/7AN1hPKpysFplXBsDqKjYvqIaBM.jpg","release_date":"2006-07-15","softcore":false,"video":false,"vote_average":7.773,"vote_count":2280,"credit_id":"52fe45c89251416c750625b9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xGJBLsiY0quc2pOcCH1MdnF5P8.jpg","genre_ids":[28,16,35,12,14],"id":44729,"title":"ワンピース the movie オマツリ男爵と秘密の島","original_language":"ja","original_title":"ワンピース the movie オマツリ男爵と秘密の島","overview":"","popularity":5.5663,"poster_path":"/6yB29qd0zjQJE42u6iUKufxMVUk.jpg","release_date":"2005-03-05","softcore":false,"video":false,"vote_average":7.199,"vote_count":249,"credit_id":"52fe4699c3a36847f8107a33","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9WS1AUI57GNpqYLqobaWjlio86S.jpg","genre_ids":[12,16,28,878,10751],"id":75571,"title":"デジモンアドベンチャー ぼくらのウォーゲーム!","original_language":"ja","original_title":"デジモンアドベンチャー ぼくらのウォーゲーム!","overview":"","popularity":1.9209,"poster_path":"/dNCPzcUc5XTJeeX0TBuLgO9ZlNh.jpg","release_date":"2000-03-04","softcore":false,"video":false,"vote_average":8.0,"vote_count":71,"credit_id":"52fe4906c3a368484e116d75","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xNlNH4Rv0Grba4HR2XIZwgWUFlE.jpg","genre_ids":[16,12,28,14,10751],"id":97787,"title":"映画 デジモンアドベンチャー","original_language":"ja","original_title":"映画 デジモンアドベンチャー","overview":"","popularity":2.4142,"poster_path":"/axtzfOR7Z2swI6XtjERDsYQapzV.jpg","release_date":"1999-03-06","softcore":false,"video":false,"vote_average":7.5,"vote_count":94,"credit_id":"52fe49ee9251416c750d81fb","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/oMqgJMCaNIqeJtilc71D4nRqdmt.jpg","genre_ids":[16,10751,18,14],"id":110420,"title":"Wilcze dzieci","original_language":"ja","original_title":"おおかみこどもの雨と雪","overview":"Studentka Hana zakochuje się w „wilkołaku”, a z ich związku rodzi się dwójka dzieci, pół-ludzi, pół-wilków, Ame i Yuki. Skromne, ale szczęśliwe życie młodej rodziny zostaje brutalnie przerwane, gdy ojciec ginie tragicznie podczas polowania. Nie mogąc poradzić sobie z wychowaniem dzieci w tętniącym życiem mieście, Hana postanawia przeprowadzić się do starego domu na wsi, mając nadzieję, że jej dzieci pewnego dnia same wybiorą drogę do szczęścia – czy to „ludzkiego”, czy „wilczego”.","popularity":6.2569,"poster_path":"/bpPbVSz4nDVIbqBhFvkam4u6qle.jpg","release_date":"2012-07-21","softcore":false,"video":false,"vote_average":8.22,"vote_count":2509,"credit_id":"52fe4ad6c3a36847f81e4585","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sDG5pFg4IQjxMSKIXNtIJ4Y1imD.jpg","genre_ids":[16],"id":247029,"title":"Superflat Monogram","original_language":"ja","original_title":"Superflat Monogram","overview":"","popularity":0.8732,"poster_path":"/4u3KomeLDVr0xYJhGIqjFzaMuC2.jpg","release_date":"2003-01-01","softcore":false,"video":false,"vote_average":5.4,"vote_count":10,"credit_id":"52fe4f1ec3a36847f82bee73","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sDG5pFg4IQjxMSKIXNtIJ4Y1imD.jpg","genre_ids":[16],"id":247029,"title":"Superflat Monogram","original_language":"ja","original_title":"Superflat Monogram","overview":"","popularity":0.8732,"poster_path":"/4u3KomeLDVr0xYJhGIqjFzaMuC2.jpg","release_date":"2003-01-01","softcore":false,"video":false,"vote_average":5.4,"vote_count":10,"credit_id":"52fe4f1ec3a36847f82bee79","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/5qNBH6tY6Jihzo9SqzvrJFHMPgz.jpg","genre_ids":[28,12,16,18,10751,14],"id":315465,"title":"Bakemono no Ko","original_language":"ja","original_title":"バケモノの子","overview":"Historia przedstawiona w filmie rozgrywa się w świecie ludzi (tokijska dzielnica Shibuya) oraz świecie potworów (Shibutenmachi). W tych dwóch oddzielnych światach, które nie powinny na siebie oddziaływać, żyją samotny chłopiec i samotny potwór. Pewnego dnia chłopiec zabłądził do świata potworów, w którym trafił pod opiekę bestii o imieniu Kumatetsu.","popularity":4.5678,"poster_path":"/2xdR78HxMLIsnHwQIo70DT670gQ.jpg","release_date":"2015-07-11","softcore":false,"video":false,"vote_average":7.908,"vote_count":1627,"credit_id":"54a808489251414d67001bc4","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xrg1pYVPK1yN0UREAzd1ywoVM6m.jpg","genre_ids":[16,878,28],"id":34433,"title":"ドラゴンボールＺ 燃え尽きろ!!熱戦・烈戦・超激戦","original_language":"ja","original_title":"ドラゴンボールＺ 燃え尽きろ!!熱戦・烈戦・超激戦","overview":"","popularity":5.8721,"poster_path":"/kZial0I482KwKDIOePPsix77lHJ.jpg","release_date":"1993-03-06","softcore":false,"video":false,"vote_average":7.267,"vote_count":1019,"credit_id":"636ebcd9d7fbda008875c5f7