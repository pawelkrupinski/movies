a perypetiach trzech hałaśliwych fanów drużyny Celtics wracających z meczu Ligi Mistrzów.","popularity":1.3609,"poster_path":"/kJENjmJmISO5AV2Ogu9wGy62Ldq.jpg","release_date":"2005-03-25","softcore":false,"video":false,"vote_average":6.5,"vote_count":46,"credit_id":"58f807fac3a3687569000efb","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/ibRN42m6anWm8N9HQbkHWRUffAB.jpg","genre_ids":[18],"id":154413,"title":"به ترتیب یا بدون ترتیب؟","original_language":"fa","original_title":"به ترتیب یا بدون ترتیب؟","overview":"","popularity":0.9092,"poster_path":"/z0KI3Dbd2MHui1lBhbYJFMbP7mO.jpg","release_date":"1981-01-01","softcore":false,"video":false,"vote_average":5.7,"vote_count":21,"credit_id":"59d8ecc2c3a36861a302789c","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/ezIu1zjYjdxwcw3nDHGxrUvhUBv.jpg","genre_ids":[99],"id":167126,"title":"اولی‌ها...","original_language":"fa","original_title":"اولی‌ها...","overview":"","popularity":1.0423,"poster_path":"/zZMhHhNGC9ekpQnawnnFykxypEP.jpg","release_date":"1984-02-01","softcore":false,"video":false,"vote_average":7.2,"vote_count":8,"credit_id":"59bb812b925141327d009aec","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/b9UPNXGV7mEUmLejR8caJIJijow.jpg","genre_ids":[18],"id":43423,"title":"Uniesie nas wiatr","original_language":"fa","original_title":"باد ما را خواهد برد","overview":"","popularity":2.6589,"poster_path":"/fBFquwGxQIXtfj8KyC8IXUAVKDd.jpg","release_date":"1999-09-12","softcore":false,"video":false,"vote_average":7.101,"vote_count":199,"credit_id":"5a0b3f43c3a368210901f157","department":"Editing","job":"Editor"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1303500,"title":"Cabeza de gallo","original_language":"en","original_title":"Cabeza de gallo","overview":"","popularity":0.7631,"poster_path":"/2XRbNi6Yrw91RRNvOLKt2B3Z2v0.jpg","release_date":"2016-05-09","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"66