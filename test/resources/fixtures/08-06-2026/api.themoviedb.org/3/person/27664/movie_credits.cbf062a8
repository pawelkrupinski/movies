F6H1y6q.jpg","release_date":"2000-07-12","softcore":false,"video":false,"vote_average":6.136,"vote_count":11,"credit_id":"670476d05f95892488bff647","department":"Production","job":"Casting"},{"adult":false,"backdrop_path":"/nEswysSpTVR1FnrorCXKKYLjkuk.jpg","genre_ids":[35],"id":48916,"title":"Iznogoud","original_language":"fr","original_title":"Iznogoud","overview":"Wielki Wezyr Iznogud pragnie zdetronizować kalifa Arachida i przejąć władzę.","popularity":1.322,"poster_path":"/6hjp24ZuxIo2EImYgFj2jkXYRLq.jpg","release_date":"2005-01-19","softcore":false,"video":false,"vote_average":3.983,"vote_count":268,"credit_id":"679079737eca7b4a0d77478c","department":"Production","job":"Casting"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":567495,"title":"علي، ربيعة والآخرون","original_language":"ar","original_title":"علي، ربيعة والآخرون","overview":"","popularity":2.8884,"poster_path":"/ok5ue5e91hdYqYwOsq4RgnzCPYb.jpg","release_date":"2000-09-13","softcore":false,"video":false,"vote_average":10.0,"vote_count":1,"credit_id":"68080f6cb2b722aedf89c9c0","department":"Writing","job":"Writer"}],"id":27664}