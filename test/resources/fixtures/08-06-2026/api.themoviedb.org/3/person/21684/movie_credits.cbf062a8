,"vote_average":8.489,"vote_count":21002,"credit_id":"5e86239298f1f10016ab4889","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/stw5FftDyX6xgEwFU2OsB0vMMSE.jpg","genre_ids":[18],"id":649971,"title":"2001 Imagine","original_language":"ko","original_title":"2001 Imagine","overview":"","popularity":0.5872,"poster_path":"/4FG2VcPvRYSQIzeleuflpFYHJPC.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":3.7,"vote_count":3,"credit_id":"5ef475a1ec370c0034257e74","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/9PRKAdrDvAdCfg3EcApLTfzGsEt.jpg","genre_ids":[878,35,12],"id":696506,"title":"Mickey 17","original_language":"en","original_title":"Mickey 17","overview":"Tytułowy bohater jest członkiem misji kolonizacyjnej na lodowej planecie Niflheim. Znacząco różni się jednak od swoich kolegów i koleżanek po fachu: Mickey jest bowiem pracownikiem „jednorazowym”. Kiedy przed załogą staje trudne zadanie, które często bywa misją samobójczą, członkowie misji zwracają się do głównego bohatera. Gdy Mickey ginie, odradza się jego nowa wersja z zachowaną większością wspomnień. Po swojej szóstej śmierci Mickey zaczyna rozumieć warunki swojego kontraktu, a także dostrzega, dlaczego właśnie na tym stanowisku brakowało członka załogi.","popularity":24.9393,"poster_path":"/v6iybquMIiEytGfdib2K8wOSLoR.jpg","release_date":"2025-02-28","softcore":false,"video":false,"vote_average":6.8,"vote_count":3750,"credit_id":"66ea231882ff873f7d1f09c6","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[27,28],"id":1436834,"title":"서울 배경의 공포 액션","original_language":"ko","original_title":"서울 배경의 공포 액션","overview":"","popularity":0.9205,"poster_path":null,"release_date":"","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"67b5eafe3751180bfcdfe632","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[27,28],"id":143683