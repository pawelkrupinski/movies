o0NlwRLaV8DBUi6Tdn0ymIHe7K.jpg","genre_ids":[80,18],"id":26744,"title":"Siła zła","original_language":"en","original_title":"Force of Evil","overview":"Prawnik Joe Morse chce skonsolidować wszystkie drobne nielegalne domy hazardowe w jedną potężną organizację. Jego starszy brat Leo prowadzi jedno z owych drobnych przedsięwzięć. Jest niechętny zmianom, gdyż woli nie zadawać się z gangsterami, którzy dominują w większym biznesie.","popularity":2.255,"poster_path":"/x33LVKf4yWdjMeczJkzE5sIw4VG.jpg","release_date":"1950-08-24","softcore":false,"video":false,"vote_average":6.6,"vote_count":141,"credit_id":"61339d2d64f71600629e3408","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/wHatuSY3bQb7ixDhYOt1iAQ0hfj.jpg","genre_ids":[35,18],"id":54575,"title":"The Killing of Sister George","original_language":"en","original_title":"The Killing of Sister George","overview":"","popularity":1.5526,"poster_path":"/u9Cyc6mde7pthv7M2xvk3wmfAHP.jpg","release_date":"1968-09-01","softcore":false,"video":false,"vote_average":6.262,"vote_count":63,"credit_id":"53b3d706c3a3682edb008d88","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/9jlQsnNJAYs9nQyIduqRd2rUb9D.jpg","genre_ids":[18,80,9648],"id":86816,"title":"The Legend of Lylah Clare","original_language":"en","original_title":"The Legend of Lylah Clare","overview":"","popularity":1.995,"poster_path":"/nX0pmvrcPFFIkNtp36MYlo4bhM9.jpg","release_date":"1968-08-21","softcore":false,"video":false,"vote_average":6.048,"vote_count":31,"credit_id":"53b50f170e0a2676d3001ce7","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/s7bwHnUuc2ThRCSIebDR3rZgYgO.jpg","genre_ids":[18,10752,28],"id":32070,"title":"Ten Seconds to Hell","original_language":"en","original_title":"Ten Seconds to Hell","overview":"","popularity":1.1086,"poster_path":"/q46iDVM4WZl4ZLGEf7tSjLHiUL9.jpg","release_date":"1959-04-23","softcore":false,"video":false,"vote_average":6.203,"vote_count":32,"credit_id":"6156fa15eb14fa0043d701e4","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/hVI7g74SyEH7sj4EtLv9d1LCTQJ.jpg","genre_ids":[37],"id":130380,"title":"New Mexico","original_language":"en","original_title":"New Mexico","overview":"","popularity":1.0708,"poster_path":"/kMp2GdkxUZKFNlnlKyjsJK38UWo.jpg","release_date":"1951-05-18","softcore":false,"video":false,"vote_average":3.625,"vote_count":8,"credit_id":"63071cb1aaf897007f251c54","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/yoOHgvmkgERGT2CwJm3A8JIJrQl.jpg","genre_ids":[37],"id":150456,"title":"The Ride Back","original_language":"en","original_title":"The Ride Back","overview":"","popularity":1.0738,"poster_path":"/b3iJcQR77sSTuAo9o1qv8sZJ2m.jpg","release_date":"1957-04-28","softcore":false,"video":false,"vote_average":6.417,"vote_count":24,"credit_id":"551a6715c3a36835bf001693","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/bqKPCNHjmkFn8vLLA5LjwJCPbki.jpg","genre_ids":[18,28,10752],"id":31935,"title":"Spóźniony Bohater","original_language":"en","original_title":"Too Late the Hero","overview":"II wojna światowa, 1942 r. Japończycy i Brytyjczycy okupują wyspę archipelagu Nowe Hebrydy na Oceanie Spokojnym. Brytyjski patrol otrzymuje zadanie przejęcia japońskiej stacji nadawczej i nadania stamtąd fałszywych komunikatów. Na czele oddziału staje pułkownik Thompson (Harry Andrews). Żołnierzem, od którego zależy powodzenie misji, jest porucznik Sam Lawson (Cliff Robertson) - Amerykanin, który biegle mówi po japońsku. Podczas wykonywania zadania towarzyszą mu szeregowiec Tosh Hearne (Michael Caine), który jest z nim w konflikcie, oraz nierozgarnięty kapitan Hornsby (Denholm Elliott). Podczas misji Hearne i Lawson odkryją, że więcej ich łączy niż dzieli.","popularity":1.9445,"poster_path":"/kWZEYPe9JFj9gzCq6xIYChijCA2.jpg","release_date":"1970-05-20","softcore":false,"video":false,"vote_average":6.4,"vote_count":77,"credit_id":"55cb1e54925141220a001a16","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/u1klcjM5DYyckx2UQT5ZUCT1qOd.jpg","genre_ids":[80,18,53],"id":79645,"title":"The Grissom Gang","original_language":"en","original_title":"The Grissom Gang","overview":"","popularity":1.7129,"poster_path":"/4gZQqXBEbrUhzNoPP8cUqysdn9c.jpg","release_date":"1971-05-28","softcore":false,"video":false,"vote_average":6.7,"vote_count":40,"credit_id":"55d04fbfc3a3681bff0070d8","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/wbky6s7YnNgUBE9ENAe4pJfFaUr.jpg","genre_ids":[18],"id":17487,"title":"Ostatnia runda","original_language":"en","original_title":"Body and Soul","overview":"W przeddzień kolejnego pojedynku bokser Charlie Davis (John Garfield) spędza bezsenną noc w domu swojej matki. Jest zrozpaczony, ponieważ jego promotor Roberts (Llody Gough) nakazał mu przegrać jutrzejszą walkę. Pięściarz zaczyna wspominać początek swojej kariery, kiedy odnosił sukcesy w boksie amatorskim, wspierany przez trenera Quinna (William Conrad) i swoją przyjaciółkę Peg Born (Lili Palmer). Jednak upojony powodzeniem porzuca starych przyjaciół, by związać się z nową dziewczyną (Hazel Brooks) i wpływowym menedżerem, dla którego pieniądze są dużo ważniejsze niż sam boks.","popularity":1.8793,"poster_path":"/lnKYS1A1k78X5v5IpLA96e6EYoe.jpg","release_date":"1947-11-11","softcore":false,"video":false,"vote_average":6.686,"vote_count":121,"credit_id":"563846f39251414ab701ca79","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/znL0K0hPJndT7IAddNWBfAEYSRC.jpg","genre_ids":[9648,53,80],"id":18030,"title":"Śmiertelny pocałunek","original_language":"en","original_title":"Kiss Me Deadly","overview":"Prywatny detektyw Mike Hammer zabiera pewnej nocy do swojego samochodu śmiertelnie przestraszoną dziewczynę - uciekinierkę ze szpitala psychiatrycznego. Po pewnym czasie zatrzymuje ich grupa mężczyzn, którzy najpierw torturują dziewczynę aż do jej śmierci, a potem pozorują wypadek samochodowy, po którym główny bohater jest ciężko ranny. Po wyjściu ze szpitala detektyw postanawia rozwikłać zagadkę nieszczęsnej pasażerki. Od tego momentu wplątuje się w tajemniczą aferę; zaprzyjaźniony agent FBI odradza mu prowadzenie śledztwa, pod jego samochód zostaje podłożona bomba zegarowa, jakiś gang dybie na jego życie...","popularity":2.4766,"poster_path":"/z7me91nrpWLHY1mZOB2v20cK0zY.jpg","release_date":"1955-04-28","softcore":false,"video":false,"vote_average":7.215,"vote_count":414,"credit_id":"5668a577925141740e003f82","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/xke3zjXLy626vDves61oMgXvbM5.jpg","genre_ids":[18],"id":98490,"title":"Gangway for Tomorrow","original_language":"en","original_title":"Gangway for Tomorrow","overview":"","popularity":0.8757,"poster_path":"/hPhxmoXgGMJqaYikvmf3JmQh5cK.jpg","release_date":"1943-11-03","softcore":false,"video":false,"vote_average":6.083,"vote_count":6,"credit_id":"62056105014325008d1e8947","department":"Directing","job":"Second Assistant Director"},{"adult":false,"backdrop_path":"/uTSgp6I0f4Byb3wWodxEboWlLBO.jpg","genre_ids":[18,10749,53],"id":43397,"title":"Caught","original_language":"en","original_title":"Caught","overview":"","popularity":2.2246,"poster_path":"/htMtSPue5zDW79iL67quA6dM4Gz.jpg","release_date":"1949-02-17","softcore":false,"video":false,"vote_average":6.576,"vote_count":99,"credit_id":"638f7aa3ba131b0097291dc1","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/jLRx4JPuzCIelygVrR9PYY7Wsno.jpg","genre_ids":[35,37],"id":17691,"title":"Czworo z Teksasu","original_language":"en","original_title":"4 for Texas","overview":"Dwóch kowbojów-awanturników, Zack Thomas (Frank Sinatra) i Joe Jarrett (Dean Martin) okrada bank. Jarrett ucieka sam z łupem wynoszącym 100 tysięcy dolarów i zostawia przyjaciela na pastwę losu. Thomas próbuje odnaleźć wspólnika, lecz zadanie utrudni mu pościg, wysłany za nim i Jarrettem przez bankiera Burdena (Victor Buono).","popularity":2.1394,"poster_path":"/kElgIdPt8cCjrbR6qOSjgJ4LE8Q.jpg","release_date":"1963-12-21","softcore":false,"video":false,"vote_average":5.1,"vote_count":62,"credit_id":"582d22cd925141095400205b","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/7UIcclzL6BQhSKuAGrMWhEudJjq.jpg","genre_ids":[18],"id":118536,"title":"The Private Affairs of Bel Ami","original_language":"en","original_title":"The Private Affairs of Bel Ami","overview":"","popularity":1.6636,"poster_path":"/bPzwlanXJwFqcRuXL1PyRtusp5J.jpg","release_date":"1947-04-25","softcore":false,"video":false,"vote_average":6.2,"vote_count":25,"credit_id":"63c960bfc5c1ef00a049fc7d","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/oMOwrvVHzsDSrgZsJXsdVhV1LPp.jpg","genre_ids":[35],"id":212926,"title":"Pardon My Past","original_language":"en","original_title":"Pardon My Past","overview":"","popularity":1.4956,"poster_path":"/qTDav4P6cAO3K55fJlv84IX1VJv.jpg","release_date":"1945-12-24","softcore":false,"video":false,"vote_average":6.667,"vote_count":6,"credit_id":"5a3d1b3192514103362420ef","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/q5vgDhmDS4EoYWrk9f9nqYZGDOw.jpg","genre_ids":[10749,18,10402,35],"id":28971,"title":"Światła rampy","original_language":"en","original_title":"Limelight","overview":"","popularity":3.3152,"poster_path":"/wNWQS4cPTVtyOPzMZ9HSjmOLZ97.jpg","release_date":"1952-10-16","softcore":false,"video":false,"vote_average":7.9,"vote_count":603,"credit_id":"5ab1025bc3a368619e00ae74","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/69nlGTX4uWketl0W7ABrDSSw8ZY.jpg","genre_ids":[35],"id":257688,"title":"No Minor Vices","original_language":"en","original_title":"No Minor Vices","overview":"","popularity":0.8,"poster_path":"/37dznjSztI4IEUesB8MLvc5mA4c.jpg","release_date":"1948-11-12","softcore":false,"