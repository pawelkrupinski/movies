zymająca równowagę. Po wystawie oprowadzi nas jej kurator i zarazem dyrektor Rijksmuseum – Taco Dibbits.","popularity":1.2993,"poster_path":"/c5yFZLWeimRjzPDepmEGhGgsgQG.jpg","release_date":"2023-04-18","softcore":false,"video":false,"vote_average":7.8,"vote_count":6,"credit_id":"641ed49bc613ce01031fce9b","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/kOmT30IM1Q4LwoKFHQOBQ91tlrn.jpg","genre_ids":[99,10402],"id":41617,"title":"In Search of Mozart","original_language":"en","original_title":"In Search of Mozart","overview":"","popularity":0.6623,"poster_path":"/qBCBX2ygXhuffLq1SHnWgXCG3re.jpg","release_date":"2006-01-04","softcore":false,"video":false,"vote_average":6.9,"vote_count":7,"credit_id":"6432eeb1310325009a21d0c3","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/kOmT30IM1Q4LwoKFHQOBQ91tlrn.jpg","genre_ids":[99,10402],"id":41617,"title":"In Search of Mozart","original_language":"en","original_title":"In Search of Mozart","overview":"","popularity":0.6623,"poster_path":"/qBCBX2ygXhuffLq1SHnWgXCG3re.jpg","release_date":"2006-01-04","softcore":false,"video":false,"vote_average":6.9,"vote_count":7,"credit_id":"6432eeb79a643506ab78f15d","department":"Crew","job":"Cinematography"},{"adult":false,"backdrop_path":"/1p5oUkvWnAEv6KtmjAH9jSsouqL.jpg","genre_ids":[99],"id":961303,"title":"Pissarro: Father of Impressionism","original_language":"en","original_title":"Pissarro: Father of Impressionism","overview":"","popularity":0.4482,"poster_path":"/sN4hWMP1QLSjKZjVM7GMnHRGfBV.jpg","release_date":"2022-05-24","softcore":false,"video":false,"vote_average":7.0,"vote_count":2,"credit_id":"6654c4ed667153b3eea66cf2","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xuOh9Spzr3ehPAdM1SIiLogRHiC.jpg","genre_ids":[99],"id":470675,"title":"David Hockney at the Royal Academy of Arts","original_language":"en","original_title":"David Hockney at the Royal Academy of Arts","overview":"","popularity":0