854da142b09cecf89c04f","order":2},{"adult":false,"backdrop_path":null,"genre_ids":[99,878,14],"id":116729,"title":"The UFO Conspiracy","original_language":"en","original_title":"The UFO Conspiracy","overview":"","popularity":0.6157,"poster_path":null,"release_date":"2004-04-18","softcore":false,"video":false,"vote_average":4.3,"vote_count":3,"character":"Self (archive sound)","credit_id":"680d2d805b2ebd5b9537b53a","order":5},{"adult":false,"backdrop_path":"/b9QEPn1UfZ7fzCzoQlROL9zPoVJ.jpg","genre_ids":[18,36],"id":36362,"title":"Król królów","original_language":"en","original_title":"King of Kings","overview":"W filmie splatają się trzy wątki. Pierwszy to losy Chrystusa począwszy od narodzin, poprzez ucieczkę do Egiptu, chrzest, aż po nauczanie i cuda. Drugi przedstawia dwór Heroda oraz niespokojne czasy panowania Poncjusza Piłata. Trzeci, najbardziej kontrowersyjny, przedstawia Barabasza jako żydowskiego buntownika, zwalczającego Rzymian. Judasza ukazano jako polityka, który szuka sposobu, by jednocześnie służyć Rzymowi i wspomagać chrześcijan. Opętany pragnieniem władzy, jedynie przez błędną politykę dopuścił się zdrady.","popularity":3.2387,"poster_path":"/fp1Nx4FASTGldFuQyGXN0HF6Jgk.jpg","release_date":"1961-10-11","softcore":false,"video":false,"vote_average":7.151,"vote_count":241,"character":"Narrator (voice) (uncredited)","credit_id":"6827bac3437fadcc6f6481b4","order":43},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1487003,"title":"Moby Dick—Rehearsed","original_language":"en","original_title":"Moby Dick—Rehearsed","overview":"","popularity":0.7502,"poster_path":"/k30CdxKrGMkLrtyFdtMTMGbxldn.jpg","release_date":"1955-06-16","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"character":"An Actor Manager /Father Mapple /Ahab","credit_id":"6832675ecd1c8829aa72f73c","order":6},{"adult":false,"backdrop_path":null,"genre_ids":[99,12],"id":1487503,"title":"Voyage of the Brigantine Yankee","original_language":"en","original_title":"Voyag