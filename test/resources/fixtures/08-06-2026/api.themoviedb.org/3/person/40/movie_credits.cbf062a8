rzechodzili wiele wzlotów i upadków, by w 553 roku ponieść ostateczną klęskę. Film opowiada o okresie ekspansji Ostrogotów w V wieku na południe i o rozpadzie imperium rzymskiego.\r Jak pisała krytyka: Czterotomowa powieść Felixa Dahna wydaje się jakby stworzona do sfilmowania. Zawiera wszystko, czego potrzeba pełnej napięcia filmowej opowieści historycznej. Romantyka, miłość, bitwy, bohaterowie, piękne kobiety […] Twórcom udało się wszystkie te atrybuty uchwycić i bardzo dobrze wykorzystać.","popularity":1.5707,"poster_path":"/2jmXqoLq32inOqwkEopIvHnd0I2.jpg","release_date":"1968-12-17","softcore":false,"video":false,"vote_average":5.889,"vote_count":9,"character":"Justinian","credit_id":"52fe4e35c3a368484e21449b","order":1},{"adult":false,"backdrop_path":"/zHAB3HUeePZlqB1fMfi7o3iDrpr.jpg","genre_ids":[10751,10770],"id":1176670,"title":"Magic with the Stars","original_language":"en","original_title":"Magic with the Stars","overview":"","popularity":1.101,"poster_path":"/i1hooQePFUisHnlwZ3C5omKW97h.jpg","release_date":"1982-01-17","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"character":"Self - Host","credit_id":"64ff064adb4ed6103855510b","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[16],"id":1179250,"title":"The Cave: a parable told by Orson Welles","original_language":"en","original_title":"The Cave: a parable told by Orson Welles","overview":"","popularity":0.3993,"poster_path":"/kXP3I6qWUaAXdc7Ah1cVTmDcxhJ.jpg","release_date":"1973-01-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Narrator","credit_id":"6504f6d63cd12c00ca54961f","order":0},{"adult":false,"backdrop_path":null,"genre_ids":[10770,36,18],"id":225117,"title":"King Lear","original_language":"en","original_title":"King Lear","overview":"","popularity":0.7372,"poster_path":"/gSyCFr1mC6xdA78k8TSTVDtNhtv.jpg","release_date":"1953-10-18","softcore":false,"video":false,"vote_average":8.0,"vote_count":3,"character":"King Lear","credit_id":"