.jpg","release_date":"1966-09-28","softcore":false,"video":false,"vote_average":7.319,"vote_count":293,"credit_id":"66024b1c7f6c8d0163705510","department":"Writing","job":"Scenario Writer"},{"adult":false,"backdrop_path":"/sAk9UwRR9eeFkAT2vKK7k6vAOPQ.jpg","genre_ids":[18,10749],"id":22744,"title":"Jane Eyre","original_language":"en","original_title":"Jane Eyre","overview":"","popularity":10.3009,"poster_path":"/stD4BQiN4TLNf6P5ju95AVRPdto.jpg","release_date":"1943-12-24","softcore":false,"video":false,"vote_average":6.929,"vote_count":154,"credit_id":"59e0fbf59251412cd100131c","department":"Production","job":"Associate Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":489709,"title":"An Evening with Orson Welles: The Golden Honeymoon","original_language":"en","original_title":"An Evening with Orson Welles: The Golden Honeymoon","overview":"","popularity":0.7557,"poster_path":"/AfoCQ4S4i9oCYdWxMVu9E8gBTu1.jpg","release_date":"1970-12-31","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"5a1daec90e0a264cd006bb5e","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":489709,"title":"An Evening with Orson Welles: The Golden Honeymoon","original_language":"en","original_title":"An Evening with Orson Welles: The Golden Honeymoon","overview":"","popularity":0.7557,"poster_path":"/AfoCQ4S4i9oCYdWxMVu9E8gBTu1.jpg","release_date":"1970-12-31","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"5a1daec30e0a264cbc06daab","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/f5EUue0mNt4gzjsrCP5QZENv3Ub.jpg","genre_ids":[35,80,18],"id":30588,"title":"Pan Verdoux","original_language":"en","original_title":"Monsieur Verdoux","overview":"W tym komicznym dramacie Verdoux, były kasjer bankowy, utrzymuje swoją rodzinę z mordowania bogatych kobiet. Jest okrutny i wyrafinowany. Uważa morderstwo za uzasadniony sposób osiągania celów w życiu. Jak wyjaśnił Chaplin: \"Dla generała niemieckiego von Clausevitza wojna była ciągiem dalszym zabiegów dyplomatycznych z zastosowaniem innych środków. Dla Verdoux zbrodnia była ciągiem dalszym robienia biznesu z zastosowaniem innych metod\". Postać Verdoux posłużyła Chaplinowi do wykazania, że społeczeństwo, którego sens określa robienie interesów, jest społeczeństwem opartym na zbrodni i wojnie. W filmie po raz pierwszy widzowie nie zobaczyli \"Charliego\". Ale czy poczciwy Charlie mógłby potępić społeczeństwo tak bezpardonowo, jak to zrobił Verdoux w swym przemówieniu w sądzie?","popularity":2.5016,"poster_path":"/mUPXIinTQsBdLlDaWiSl7GwQXVs.jpg","release_date":"1947-08-27","softcore":false,"video":false,"vote_average":7.686,"vote_count":480,"credit_id":"64433d63cee2f60475364f0b","department":"Writing","job":"Story"},{"adult":false,"backdrop_path":"/bFawasB1f0RFvuXgJzAkoeaWnfm.jpg","genre_ids":[18,27,878],"id":1289969,"title":"The Battle of Grovers Mill","original_language":"en","original_title":"The Battle of Grovers Mill","overview":"","popularity":1.1239,"poster_path":"/1Kx8dwV40JGZQXPnbGiOxD8T7kR.jpg","release_date":"2024-06-08","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"665802d198ff3f3ee46c1d27","department":"Writing","job":"Original Story"},{"adult":false,"backdrop_path":"/jyTQJ1ioXoWs7zBrAJy9w4AHZyZ.jpg","genre_ids":[18],"id":27883,"title":"Makbet","original_language":"en","original_title":"Macbeth","overview":"Film jest adaptacją sztuki Szekspira pod tym samym tytułem. Macbeth jest kierowany przez złowrogie proroctwo i okrutną żonę do aktu zdrady, który ma uczynić go królem.","popularity":2.5081,"poster_path":"/4DbzuePqGcUY7olAKzGly7kCEmU.jpg","release_date":"1948-10-01","softcore":false,"video":false,"vote_average":7.3,"vote_count":185,"credit_id":"5a8ef2100e0a263e7a017a5c","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/jyTQJ1ioXoWs7zBrAJy9w4AHZyZ.jpg","genre_ids":[18],"id":27883,"title":"Makbet","original_language":"en","original_title":"Macbeth","overview":"Film jest adaptacją sztuki Szekspira pod tym samym tytułem. Macbeth jest kierowany przez złowrogie proroctwo i okrutną żonę do aktu zdrady, który ma uczynić go królem.","popularity":2.5081,"poster_path":"/4DbzuePqGcUY7olAKzGly7kCEmU.jpg","release_date":"1948-10-01","softcore":false,"video":false,"vote_average":7.3,"vote_count":185,"credit_id":"5a8ef21c9251416c7e016696","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/jyTQJ1ioXoWs7zBrAJy9w4AHZyZ.jpg","genre_ids":[18],"id":27883,"title":"Makbet","original_language":"en","original_title":"Macbeth","overview":"Film jest adaptacją sztuki Szekspira pod tym samym tytułem. Macbeth jest kierowany przez złowrogie proroctwo i okrutną żonę do aktu zdrady, który ma uczynić go królem.","popularity":2.5081,"poster_path":"/4DbzuePqGcUY7olAKzGly7kCEmU.jpg","release_date":"1948-10-01","softcore":false,"video":false,"vote_average":7.3,"vote_count":185,"credit_id":"5a8ef27a0e0a26013a000014","department":"Costume & Make-Up","job":"Costume Design"},{"adult":false,"backdrop_path":"/ewnZC0LxNGSqQMXwXvmSCnw1UlX.jpg","genre_ids":[53,10752],"id":21366,"title":"Podroż do krainy strachów","original_language":"en","original_title":"Journey into Fear","overview":"Bohaterem filmu jest amerykański inżynier marynarki, Howard Graham (Joseph Cotten), który, będąc wraz z żoną na zagranicznej konferencji, dowiaduje się, że Gestapo wydało na niego wyrok śmierci. W sekrecie przed swoją małżonką ucieka z hotelu, w którym wspólnie przebywają, i przedostaje się na pokład parowca odbywającego rejs z Turcji do Batumi. Jego towarzyszami podróży zostają: tancerka Josette Martel (Dolores del Rio), jej partner Gogo (Jack Durant), gadatliwa Francuzka pani Mathews (Agnes Moorehead) wraz z mężem (Frank Readick), niemiecki archeolog dr Haller (Eustace Wyatt) oraz tajemniczy, otyły mężczyzna Peter Banat (Jack Moss). Od początku wiadomo, że Banat jest nazistowskim zabójcą, nie wiadomo tylko, kto z nim współpracuje i kiedy dojdzie do ostatecznej rozgrywki. [filmweb.pl]","popularity":1.4478,"poster_path":"/2VVW1rCSHYW5n1IV7dhDoWa4OCT.jpg","release_date":"1943-01-07","softcore":false,"video":false,"vote_average":6.072,"vote_count":104,"credit_id":"5a9704bbc3a368613a0026d9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/ewnZC0LxNGSqQMXwXvmSCnw1UlX.jpg","genre_ids":[53,10752],"id":21366,"title":"Podroż do krainy strachów","original_language":"en","original_title":"Journey into Fear","overview":"Bohaterem filmu jest amerykański inżynier marynarki, Howard Graham (Joseph Cotten), który, będąc wraz z żoną na zagranicznej konferencji, dowiaduje się, że Gestapo wydało na niego wyrok śmierci. W sekrecie przed swoją małżonką ucieka z hotelu, w którym wspólnie przebywają, i przedostaje się na pokład parowca odbywającego rejs z Turcji do Batumi. Jego towarzyszami podróży zostają: tancerka Josette Martel (Dolores del Rio), jej partner Gogo (Jack Durant), gadatliwa Francuzka pani Mathews (Agnes Moorehead) wraz z mężem (Frank Readick), niemiecki archeolog dr Haller (Eustace Wyatt) oraz tajemniczy, otyły mężczyzna Peter Banat (Jack Moss). Od początku wiadomo, że Banat jest nazistowskim zabójcą, nie wiadomo tylko, kto z nim współpracuje i kiedy dojdzie do ostatecznej rozgrywki. [filmweb.pl]","popularity":1.4478,"poster_path":"/2VVW1rCSHYW5n1IV7dhDoWa4OCT.jpg","release_date":"1943-01-07","softcore":false,"video":false,"vote_average":6.072,"vote_count":104,"credit_id":"5a9704e0c3a3686141002c92","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/mUNILrOE5FhBZj3PqEHzau3lo9G.jpg","genre_ids":[10770,99],"id":523078,"title":"The Orson Welles Show","original_language":"en","original_title":"The Orson Welles Show","overview":"","popularity":1.2713,"poster_path":"/aVOP4IiLc2YAEfireVrzQ9scKBc.jpg","release_date":"1979-02-01","softcore":false,"video":false,"vote_average":8.0,"vote_count":2,"credit_id":"5af1e4469251410648000a