74f012c97","order":5},{"adult":false,"backdrop_path":"/omp7PnSmemephTb8X6ZLiqvNGrY.jpg","genre_ids":[99,36],"id":1546545,"title":"Muide Éire","original_language":"en","original_title":"Muide Éire","overview":"","popularity":0.5962,"poster_path":"/5zt0VAT2NO2bX8sDHeUdjROcZqj.jpg","release_date":"2011-11-06","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"68e9bfcdef9d04922b4b137f","order":4},{"adult":false,"backdrop_path":"/3XSi1w3baQV3YTvR8UWuyRB6Qu6.jpg","genre_ids":[99],"id":1676472,"title":"Guggi","original_language":"en","original_title":"Guggi","overview":"","popularity":0.9755,"poster_path":"/9rzmWBISWM6Pcdeug6eMUDJjxvt.jpg","release_date":"2026-06-13","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"69e485da89c777752dd294f4","order":3}],"crew":[{"adult":false,"backdrop_path":"/bxJmFRjwWnpoLFkp5OSzA7xfzn6.jpg","genre_ids":[18,80,10402],"id":10060,"title":"Get Rich or Die Tryin': Historia 50 Centa","original_language":"en","original_title":"Get Rich or Die Tryin'","overview":"Opowieść o tym, co można osiągnąć w życiu jeśli sumiennie dąży się do wyznaczonego celu, pokazuje nam, co jest w stanie osiągnąć każdy człowiek, niezależnie od statusu majątkowego. Film o wzlotach i upadkach czarnoskórego Marcusa, który po ciężkiej przeprawie przez życie w gettcie stara się wypełnić swoje marzenie związane z muzyką.","popularity":5.4855,"poster_path":"/fMS4t3YFOcUUaIRlEy2fpQSid5g.jpg","release_date":"2005-11-09","softcore":false,"video":false,"vote_average":6.83,"vote_count":1056,"credit_id":"52fe43169251416c75002ff5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bxJmFRjwWnpoLFkp5OSzA7xfzn6.jpg","genre_ids":[18,80,10402],"id":10060,"title":"Get Rich or Die Tryin': Historia 50 Centa","original_language":"en","original_title":"Get Rich or Die Tryin'","overview":"Opowieść o tym, co można osiągnąć w życiu jeśli sumiennie dąży się do wyznaczonego celu, pokazuje nam, co jest w stanie osiągnąć każdy człowiek, niezależnie od statusu majątkowego. Film o wzlotach i upadkach czarnoskórego Marcusa, który po ciężkiej przeprawie przez życie w gettcie stara się wypełnić swoje marzenie związane z muzyką.","popularity":5.4855,"poster_path":"/fMS4t3YFOcUUaIRlEy2fpQSid5g.jpg","release_date":"2005-11-09","softcore":false,"video":false,"vote_average":6.83,"vote_count":1056,"credit_id":"52fe43179251416c75003043","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/uJHm54Z8Y6WSTSDvhqGSeKjP88v.jpg","genre_ids":[18],"id":10511,"title":"Nasza Ameryka","original_language":"en","original_title":"In America","overview":"Przytłoczony rodzinną tragedią (śmierć syna) irlandzki emigrant Johnny (Paddy Considine) i jego żona Sarah (Samantha Morton) wraz z dwiema pomysłowymi córkami wyjeżdżają do Stanów Zjednoczonych, aby tam zacząć wszystko od nowa. Pełni nadziei wprowadzają się do zaniedbanej kamiennicy w najbardziej niespokojnej części Manhattanu. Marzenia o dobrobycie zostają szybko zweryfikowane przez twardą rzeczywistość. Ich mieszkanie przypomina norę, dobrą pracę jest bardzo cieżko znaleźć, a wszędzie dookoła czai się niebezpieczeństwo. Dziewczynki jednak traktują Nowy Jork jako ucieczkę od przeszłości i myślą, że Manhattan jest magicznym miejscem. Czy nadal będą tak uważać, po tym jak zapukają do drzwi tajemniczego sąsiada (Djimon Hounsou) w Halloween?","popularity":2.6131,"poster_path":"/cUhMjWQyyApA0pFinogCsE2wy8g.jpg","release_date":"2003-09-22","softcore":false,"video":false,"vote_average":7.156,"vote_count":392,"credit_id":"52fe437d9251416c750126e1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uJHm54Z8Y6WSTSDvhqGSeKjP88v.jpg","genre_ids":[18],"id":10511,"title":"Nasza Ameryka","original_language":"en","original_title":"In America","overview":"Przytłoczony rodzinną tragedią (śmierć syna) irlandzki emigrant Johnny (Paddy Considine) i jego żona Sarah (Samantha Morton) wraz z dwiema pomysłowymi córkami wyjeżdżają do Stanów Zjednoczonych, aby tam zacząć wszystko od nowa. Pełni nadziei wprowadzają się do zaniedbanej kamiennicy w najbardziej niespokojnej części Manhattanu. Marzenia o dobrobycie zostają szybko zweryfikowane przez twardą rzeczywistość. Ich mieszkanie przypomina norę, dobrą pracę jest bardzo cieżko znaleźć, a wszędzie dookoła czai się niebezpieczeństwo. Dziewczynki jednak traktują Nowy Jork jako ucieczkę od przeszłości i myślą, że Manhattan jest magicznym miejscem. Czy nadal będą tak uważać, po tym jak zapukają do drzwi tajemniczego sąsiada (Djimon Hounsou) w Halloween?","popularity":2.6131,"poster_path":"/cUhMjWQyyApA0pFinogCsE2wy8g.jpg","release_date":"2003-09-22","softcore":false,"video":false,"vote_average":7.156,"vote_count":392,"credit_id":"52fe437d9251416c750126ff","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/zjKg04EquTcnVZUfjHboXnXzjcF.jpg","genre_ids":[18],"id":10161,"title":"Moja lewa stopa","original_language":"en","original_title":"My Left Foot: The Story of Christy Brown","overview":"Ekranizacja autobiografii malarza Christy'ego Browna, który urodził się w 1932 roku w Dublinie w rodzinie bardzo licznej i niezamożnej. Od urodzenia całkowicie sparaliżowany, mógł poruszać jedynie lewą stopą. Rodzice nie chcieli pogodzić się z ułomnością syna. Dokładali wszelkich starań, aby mógł uczestniczyć w życiu rodzinnym. Jako nastolatek Christy zaczyna malować, okazuje się, że ma talent.","popularity":3.6913,"poster_path":"/8QiSltNbczU6Mf87LWQZsdVItrG.jpg","release_date":"1989-04-07","softcore":false,"video":false,"vote_average":7.531,"vote_count":1038,"credit_id":"52fe43399251416c75008253","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/zjKg04EquTcnVZUfjHboXnXzjcF.jpg","genre_ids":[18],"id":10161,"title":"Moja lewa stopa","original_language":"en","original_title":"My Left Foot: The Story of Christy Brown","overview":"Ekranizacja autobiografii malarza Christy'ego Browna, który urodził się w 1932 roku w Dublinie w rodzinie bardzo licznej i niezamożnej. Od urodzenia całkowicie sparaliżowany, mógł poruszać jedynie lewą stopą. Rodzice nie chcieli pogodzić się z ułomnością syna. Dokładali wszelkich starań, aby mógł uczestniczyć w życiu rodzinnym. Jako nastolatek Christy zaczyna malować, okazuje się, że ma talent.","popularity":3.6913,"poster_path":"/8QiSltNbczU6Mf87LWQZsdVItrG.jpg","release_date":"1989-04-07","softcore":false,"video":false,"vote_average":7.531,"vote_count":1038,"credit_id":"52fe43399251416c75008265","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/j8ajhpIpX2mR3SEfc6kSsdZefGR.jpg","genre_ids":[18],"id":31651,"title":"Pole","original_language":"en","original_title":"The Field","overview":"","popularity":7.0452,"poster_path":"/ppF5pUheNoL0EPuGRIEnHz1ewp7.jpg","release_date":"1990-09-21","softcore":false,"video":false,"vote_average":6.954,"vote_count":108,"credit_id":"52fe44939251416c910158f3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/xERofiEyzGekTNi3oIppQvdLDZB.jpg","genre_ids":[18,53,10752],"id":7445,"title":"Bracia","original_language":"en","original_title":"Brothers","overview":"Pewnego dnia Grace  dowiaduje się, że jej mąż Sam , żołnierz armii amerykańskiej, ginie w czasie tajnej misji. Wiadomość o śmierci Sama to cios dla całej rodziny. Jego brat Tommy  zaczyna pomagać zrozpaczonej dziewczynie. Z czasem Grace i Tommy zbliżają się do siebie. Wtedy okazuje się, że Sam jednak żyje…","popularity":8.9788,"poster_path":"/zE8O18q5YOiwgwhX113oHDydFWo.jpg","release_date":"2009-12-02","softcore":false,"video":false,"vote_average":7.312,"vote_count":3978,"credit_id":"52fe447dc3a36847f80991db","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/gUIVD0rFWVB8Okk8wU8dQxjOYnZ.jpg","genre_ids":[18],"id":7984,"title":"W imię ojca","original_language":"en","original_title":"In the Name of the Father","overview":"\"W imię ojca\" opowiada o przeżyciach Gerry'ego Conlona, który dorastał we wstrząsanym zamachami terrorystycznymi Belfaście początku lat 70-tych. Conlon (Daniel Day-Lewis) był drobnym złodziejaszkiem, który ku niezadowoleniu swego ojca Giuseppe (Pete Postlethwaite) większość czasu spędzał w okolicznych barach. Gdy Gerry popadł w konflikt z IRA, ojciec wysłał go do Anglii, gdzie chłopak został niesłusznie oskarżony o udział w zamachu bombowym, w którym zginęło wielu niewinnych ludzi. Sąd skazał go na dożywocie, a wraz z nim aresztowano i uwięziono także jego ojca. W więzieniu Gerry zdał sobie sprawę, że Giuseppe pod maską słabości ukrywał wewnętrzną siłę i głęboką mądrość życiową. Minęło wiele lat, zanim dzięki wysiłkom energicznej pani mecenas (Emma Thompson) Gerry, zdołał udowodnić swą niewinność, oczyścić imię ojca i ujawnić światu prawdę o jednej z największych pomyłek w historii brytyjskiego wymiaru sprawiedliwości.","popularity":5.6735,"poster_path":"/9kGiW7FewHdpMlduQWea8YCBj2o.jpg","release_date":"1993-12-27","softcore":false,"video":false,"vote_average":7.9,"vote_count":2010,"credit_id":"52fe448bc3a36847f809c0a5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/gUIVD0rFWVB8Okk8wU8dQxjOYnZ.jpg","genre_ids":[18],"id":7984,"title":"W imię ojca","original_language":"en","original_title":"In the Name of the Father","overview":"\"W imię ojca\" opowiada o przeżyciach Gerry'ego Conlona, który dorastał we wstrząsanym zamachami terrorystycznymi Belfaście początku lat 70-tych. Conlon (Daniel Day-Lewis) był drobnym złodziejaszkiem, który ku niezadowoleniu swego ojca Giuseppe (Pete Postlethwaite) większość czasu spędzał w okolicznych barach. Gdy Gerry popadł w konflikt z IRA, ojciec wysłał go do Anglii, gdzie chłopak został niesłusznie oskarżony o udział w zamachu bombowym, w którym zginęło wielu niewinnych ludzi. Sąd skazał go na dożywocie, a wraz z nim aresztowano i uwięziono także jego ojca. W więzieniu Gerry zdał sobie sprawę, że Giuseppe pod maską słabości ukrywał wewnętrzną siłę i głęboką mądrość życiową. Minęło wiele lat, zanim dzięki wysiłkom energicznej pani mecenas (Emma Thompson) Gerry, zdołał udowodnić swą niewinność, oczyścić imię ojca i ujawnić światu prawdę o jednej z największych pomyłek w historii brytyjskiego wymiaru sprawiedliwości.","popularity":5.6735,"poster_path":"/9kGiW7FewHdpMlduQWea8YCBj2o.jpg","release_date":"1993-12-27","softcore":false,"video":false,"vote_average":7.9,"vote_count":2010,"credit_id":"52fe448bc3a36847f809c0ab","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/gUIVD0rFWVB8Okk8wU8dQxjOYnZ.jpg","genre_ids":[18],"id":7984,"title":"W imię ojca","original_language":"en","original_title":"In the Name of the Father","overview":"\"W imię ojca\" opowiada o przeżyciach Gerry'ego Conlona, który dorastał we wstrząsanym zamachami terrorystycznymi Belfaście początku lat 70-tych. Conlon (Daniel Day-Lewis) był drobnym złodziejaszkiem, który ku niezadowoleniu swego ojca Giuseppe (Pete Postlethwaite) większość czasu spędzał w okolicznych barach. Gdy Gerry popadł w konflikt z IRA, ojciec wysłał go do Anglii, gdzie chłopak został niesłusznie oskarżony o udział w zamachu bombowym, w którym zginęło wielu niewinnych ludzi. Sąd skazał go na dożywocie, a wraz z nim aresztowano i uwięziono także jego ojca. W więzieniu Gerry zdał sobie sprawę, że Giuseppe pod maską słabości ukrywał wewnętrzną siłę i głęboką mądrość życiową. Minęło wiele lat, zanim dzięki wysiłkom energicznej pani mecenas (Emma Thompson) Gerry, zdołał udowodnić swą niewinność, oczyścić imię ojca i ujawnić światu prawdę o jednej z największych pomyłek w historii brytyjskiego wymiaru sprawiedliwości.","popularity":5.6735,"poster_path":"/9kGiW7FewHdpMlduQWea8YCBj2o.jpg","release_date":"1993-12-27","softcore":false,"video":false,"vote_average":7.9,"vote_count":2010,"credit_id":"52fe448bc3a36847f809c0b1","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/ylWm0EQNIrcIbjpeUhHKTfD1Ugw.jpg","genre_ids":[18],"id":15506,"title":"Agnes Browne","original_language":"en","original_title":"Agnes Browne","overview":"","popularity":1.2,"poster_path":"/bgZ0lDvN0W8OLjPki1Me1JhtBrH.jpg","release_date":"1999-11-08","softcore":false,"video":false,"vote_average":6.215,"vote_count":34,"credit_id":"52fe46629251416c7507694f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/37iU8su1kQgylRqpbhzGb2KtrWF.jpg","genre_ids":[18,10749],"id":16992,"title":"Bokser","original_language":"en","original_title":"The Boxer","overview":"","popularity":3.2362,"poster_path":"/wsbNQWMQV4HwwqXtvQUoBfiBzK8.jpg","release_date":"1997-12-31","softcore":false,"video":false,"vote_average":6.716,"vote_count":313,"credit_id":"52fe46fc9251416c7508a1e9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ZjnHdS0gqPDcy0KI2azWR6HfEJ.jpg","genre_ids":[18,10749],"id":283591,"title":"Tajny dziennik","original_language":"en","original_title":"The Secret Scripture","overview":"Roseanne McNulty (Vanessa Redgrave) jest stuletnią pacjentką szpitala psychiatrycznego. Mieszka tam już ponad pięćdziesiąt lat. Pewnego dnia doktor William Grene (Eric Bana) postanawia dowiedzieć się, dlaczego Roseanne przebywa w zakładzie tak długo. Nie wie, że ukrywa tajny pamiętnik. Lekarz zaczyna zagłębiać się w jej przeszłość. Poznaje młodą kobietę (Rooney Mara) z uwodzicielską charyzmą. Przeprowadziła się ona do Sligo, by podjąć pracę w kawiarni cioci. Zakochała się w przystojnym pilocie myśliwca. Uczuciem obdarzył ją miejscowy ksiądz (Theo James).","popularity":2.6666,"poster_path":"/iVoZqwvGAwxvGVbYV5y04wpiBob.jpg","release_date":"2017-03-23","softcore":false,"video":false,"vote_average":7.242,"vote_count":327,"credit_id":"609638805ed8e9003ed651a0","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/ZjnHdS0gqPDcy0KI2azWR6HfEJ.jpg","genre_ids":[18,10749],"id":283591,"title":"Tajny dziennik","original_language":"en","original_title":"The Secret Scripture","overview":"Roseanne McNulty (Vanessa Redgrave) jest stuletnią pacjentką szpitala psychiatrycznego. Mieszka tam już ponad pięćdziesiąt lat. Pewnego dnia doktor William Grene (Eric Bana) postanawia dowiedzieć się, dlaczego Roseanne przebywa w zakładzie tak długo. Nie wie, że ukrywa tajny pamiętnik. Lekarz zaczyna zagłębiać się w jej przeszłość. Poznaje młodą kobietę (Rooney Mara) z uwodzicielską charyzmą. Przeprowadziła się ona do Sligo, by podjąć pracę w kawiarni cioci. Zakochała się w przystojnym pilocie myśliwca. Uczuciem obdarzył ją miejscowy ksiądz (Theo James).","popularity":2.6666,"poster_path":"/iVoZqwvGAwxvGVbYV5y04wpiBob.jpg","release_date":"2017-03-23","softcore":false,"video":false,"vote_average":7.242,"vote_count":327,"credit_id":"609639a9b34409003cb71500","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/6eFU4wRgnL4YEvDagEianumeGpc.jpg","genre_ids":[9648,18,53],"id":69668,"title":"Dom snów","original_language":"en","original_title":"Dream House","overview":"Mający na koncie szereg sukcesów wydawniczych Will Attenton (Daniel Craig) wyprowadza się ze swoją rodziną z Nowego Jorku i zamieszkuje w malowniczym domu w Nowej Anglii. Gdy wraz z żoną Libby (nagrodzona Oscarem za rolę w \"Wiernym ogrodniku\" Rachel Weisz) oraz dwiema córkami zaczyna się już przyzwyczajać do nowego lokum, dowiadują się, że zamordowano w nim poprzednią mieszkankę oraz jej dzieci. Podejrzewany o zbrodnię mąż i ojciec zabitych nadal żyje, a Willa oraz zaprzyjaźnioną z ofiarami sąsiadkę (Naomi Watts – \"Mulholland Drive\", \"The Ring 1-2\", nominacja do Oscara za \"21 gramów\") prześladuje przeczucie, że nie wszystkie poszlaki zostały odpowiednio zbadane. Próbując dopasować do siebie poszczególne elementy krwawej układanki, Will odkryje, że historia poprzedniego lokatora jego domu jest równie przerażająca, jak to, co może spotkać kolejną rodzinę...","popularity":4.1584,"poster_path":"/114ZbKnqlVoLH6x6ZBkssKua7yn.jpg","release_date":"2011-09-29","softcore":false,"video":false,"vote_average":6.20