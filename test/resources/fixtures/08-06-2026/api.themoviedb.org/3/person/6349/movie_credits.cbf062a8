,"overview":"","popularity":0.7928,"poster_path":"/zSmEriTdCl7IyZh8LWXokEB0m71.jpg","release_date":"1985-03-03","softcore":false,"video":false,"vote_average":5.8,"vote_count":13,"character":"Self","credit_id":"5d639e597f6c8d0019efb622","order":12},{"adult":false,"backdrop_path":"/pmXHbedH6BdX9G4G1NHN64nUBMg.jpg","genre_ids":[99,10770],"id":733984,"title":"Meryl Streep : mystères et métamorphoses","original_language":"fr","original_title":"Meryl Streep : mystères et métamorphoses","overview":"","popularity":0.8192,"poster_path":"/xXgupffqx5O6pbSZJktub61pAfG.jpg","release_date":"2020-08-16","softcore":false,"video":false,"vote_average":6.7,"vote_count":8,"character":"Self - Filmmaker (archive footage)","credit_id":"5f5332c1b3316b0035ed39e6","order":7},{"adult":false,"backdrop_path":"/8E27g3TPgs3q9ojNB7WbiFzhWSk.jpg","genre_ids":[99],"id":738116,"title":"Citizen Jane, l'Amérique selon Fonda","original_language":"fr","original_title":"Citizen Jane, l'Amérique selon Fonda","overview":"","popularity":1.4452,"poster_path":"/ahmxA9TM8KrRbSMMGgr2TFVJfN1.jpg","release_date":"2020-08-30","softcore":false,"video":false,"vote_average":7.15,"vote_count":10,"character":"","credit_id":"69653478903ab52233d8c9b6","order":8}],"crew":[{"adult":false,"backdrop_path":"/bxh7ybql4p24u9WsX1GI9v9PDLg.jpg","genre_ids":[53,80,18],"id":466,"title":"Klute","original_language":"en","original_title":"Klute","overview":"Thriller psychologiczny Alana J. Pakuli. Prywatny detektyw John Klute (Donald Sutherland) próbuje wyjaśnić zagadkę zniknięcia swego przyjaciela, biznesmena z Pensylwanii. Jedyny ślad prowadzi do prostytutki w Nowym Jorku, Bree Daniels (Jane Fonda), z której usług biznesmen korzystał przed zniknięciem. Kobieta cierpi na paranoję i czuje, że ktoś ją obserwuje. Daje się więc namówić na współpracę, licząc, że detektyw jej również pomoże.","popularity":3.332,"poster_path":"/vHdqcL6szj2lAOB4HTJIpUyBJW5.jpg","release_date":"1971-06-23","softcore":false,"video":false,"vote_average":6.8,"vote_count":524,"credit_id":"52fe4247c3a36847f8011b65","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bxh7ybql4p24u9WsX1GI9v9PDLg.jpg","genre_ids":[53,80,18],"id":466,"title":"Klute","original_language":"en","original_title":"Klute","overview":"Thriller psychologiczny Alana J. Pakuli. Prywatny detektyw John Klute (Donald Sutherland) próbuje wyjaśnić zagadkę zniknięcia swego przyjaciela, biznesmena z Pensylwanii. Jedyny ślad prowadzi do prostytutki w Nowym Jorku, Bree Daniels (Jane Fonda), z której usług biznesmen korzystał przed zniknięciem. Kobieta cierpi na paranoję i czuje, że ktoś ją obserwuje. Daje się więc namówić na współpracę, licząc, że detektyw jej również pomoże.","popularity":3.332,"poster_path":"/vHdqcL6szj2lAOB4HTJIpUyBJW5.jpg","release_date":"1971-06-23","softcore":false,"video":false,"vote_average":6.8,"vote_count":524,"credit_id":"52fe4247c3a36847f8011b87","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/wYRpVySPCC7wA28p54yAaoMT478.jpg","genre_ids":[18],"id":595,"title":"Zabić Drozda","original_language":"en","original_title":"To Kill a Mockingbird","overview":"Akcja filmu rozgrywa się w latach 30. XX wieku w stanie Alabama. Historia pewnego procesu na tle rasistowskim widzianego oczyma siedmioletniej dziewczynki. Młoda biała kobieta oskarża swojego czarnoskórego sąsiada o gwałt. Do obrony niewinnie oskarżonego staje szanowany adwokat Atticus Finch. Sprawa, z pozoru łatwa do wygrania z powodu braku dowodów, stanie się najgłośniejszym wydarzenim w cichym miasteczku.","popularity":8.9373,"poster_path":"/nlBvtoemPmIdYHUPhV9olk3kpQQ.jpg","release_date":"1962-12-20","softcore":false,"video":false,"vote_average":7.988,"vote_count":2906,"credit_id":"52fe4259c3a36847f8017719","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/aAMn59bq6DZQtWoYqsIOUkVWSgc.jpg","genre_ids":[18,9648,53],"id":891,"title":"Wszyscy ludzie prezydenta","original_language":"en","original_title":"All the President's Men","overview":"W 1972 r. pięciu ludzi zostaje aresztowanych za włamanie do głównej siedziby demokratów w Waszyngtonie, znajdującej się w budynku Watergate. Okazuje się, że osoby te były powiązane z krajowym komitetem działającym na rzecz ponownego wyboru Nixona na prezydenta. Bob Woodward, reporter Washington Post, zbiera materiały dotyczące włamania, nie wiedząc, że znajdzie w tej sprawie coś interesującego. Wkrótce dziennikarz Carl Bernstein nawiązuje współpracę z Bobem. Mężczyzna o pseudonimie Deep Throat podpowiada Bobowi, czym warto się zainteresować.","popularity":7.2865,"poster_path":"/AvFeMgHphisca4tnwZip7hhzNN2.jpg","release_date":"1976-04-09","softcore":false,"video":false,"vote_average":7.655,"vote_count":2112,"credit_id":"52fe4288c3a36847f8026571","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/Bfsoyo6mai2KKhdL5tk85RIB8F.jpg","genre_ids":[80,53,18],"id":4477,"title":"Zdrada","original_language":"en","original_title":"The Devil's Own","overview":"Irlandia Północna. Młody chłopak jest świadkiem śmierci ojca. Mordercą jest zamaskowany terrorysta. Kilkanaście lat później, jako dorosły człowiek, bohater walczy w szeregach IRA. Ścigany przez Anglików emigruje do Ameryki, gdzie znajduje schronienie w domu nowojorskiego policjanta.","popularity":5.8562,"poster_path":"/22ffQiurVHgR5NY8f4XGwBQ8n6M.jpg","release_date":"1997-03-13","softcore":false,"video":false,"vote_average":6.193,"vote_count":1386,"credit_id":"52fe43c4c3a36847f806e2b5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dxoYbFNaIBhtOUb1Q3tEOuSdwMc.jpg","genre_ids":[9648,80,53],"id":11092,"title":"Uznany za niewinnego","original_language":"en","original_title":"Presumed Innocent","overview":"Rusty Sabich, ojciec rodziny i szanowany prokurator, wdaje się w krótki romans z Caroline Polhemus, koleżanką z pracy. Nieoczekiwanie kobieta pada ofiarą morderstwa. Przełożony Rusty'ego, Raymond Horgan, powierza mu dochodzenie w tej sprawie. Zdumiony mężczyzna odkrywa, że wszystkie zgromadzone w śledztwie dowody obciążają jego samego. Z dnia na dzień mężczyzna traci wszystko. Kończy się jego błyskotliwa kariera i zostaje postawiony w stan oskarżenia.","popularity":5.3046,"poster_path":"/AmQL5DPc9NGi2OWlmKRZ1w6Jdtb.jpg","release_date":"1990-07-27","softcore":false,"video":false,"vote_average":6.816,"vote_count":834,"credit_id":"52fe43f59251416c7502439b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bGE9Cj1362hvKZsnk72lvviiVES.jpg","genre_ids":[18,80],"id":31645,"title":"Orphans","original_language":"en","original_title":"Orphans","overview":"","popularity":1.4631,"poster_path":"/g32UjgL8JsaaNjhAFc4B3NKLNku.jpg","release_date":"1987-09-18","softcore":false,"video":false,"vote_average":5.7,"vote_count":15,"credit_id":"52fe44929251416c91015615","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bGE9Cj1362hvKZsnk72lvviiVES.jpg","genre_ids":[18,80],"id":31645,"title":"Orphans","original_language":"en","original_title":"Orphans","overview":"","popularity":1.4631,"poster_path":"/g32UjgL8JsaaNjhAFc4B3NKLNku.jpg","release_date":"1987-09-18","softcore":false,"video":false,"vote_average":5.7,"vote_count":15,"credit_id":"52fe44929251416c91015635","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/dMFVSGbgtVTedpewA4PHykQuEEK.jpg","genre_ids":[53,80,18],"id":9944,"title":"Raport Pelikana","original_language":"en","original_title":"The Pelican Brief","overview":"Dwóch najważniejszych sędziów w USA zostaje zamordowanych. Młoda i inteligentna studentka prawa, Darby Shaw, ma pewne domysły na temat sprawcy mordu. Pisze raport, który nazywa \"Raportem Pelikana\". Niestety każda osoba, która zetknie się z raportem, zostaje zabita. Darby wraz ze zdeterminowanym reporterem pragną odkryć prawdę.","popularity":6.2117,"poster_path":"/sk4z311myfcppqBXnVWp5NXPi5M.jpg","release_date":"1993-09-17","softcore":false,"video":false,"vote_average":6.591,"vote_count":1795,"credit_id":"52fe454cc3a36847f80c6863","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dMFVSGbgtVTedpewA4PHykQuEEK.jpg","genre_ids":[53,80,18],"id":9944,"title":"Raport Pelikana","original_language":"en","original_title":"The Pelican Brief","overview":"Dwóch najważniejszych sędziów w USA zostaje zamordowanych. Młoda i inteligentna studentka prawa, Darby Shaw, ma pewne domysły na temat sprawcy mordu. Pisze raport, który nazywa \"Raportem Pelikana\". Niestety każda osoba, która zetknie się z raportem, zostaje zabita. Darby wraz ze zdeterminowanym reporterem pragną odkryć prawdę.","popularity":6.2117,"poster_path":"/sk4z311myfcppqBXnVWp5NXPi5M.jpg","release_date":"1993-09-17","softcore":false,"video":false,"vote_average":6.591,"vote_count":1795,"credit_id":"52fe454cc3a36847f80c6869","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/dMFVSGbgtVTedpewA4PHykQuEEK.jpg","genre_ids":[53,80,18],"id":9944,"title":"Raport Pelikana","original_language":"en","original_title":"The Pelican Brief","overview":"Dwóch najważniejszych sędziów w USA zostaje zamordowanych. Młoda i inteligentna studentka prawa, Darby Shaw, ma pewne domysły na temat sprawcy mordu. Pisze raport, który nazywa \"Raportem Pelikana\". Niestety każda osoba, która zetknie się z raportem, zostaje zabita. Darby wraz ze zdeterminowanym reporterem pragną odkryć prawdę.","popularity":6.2117,"poster_path":"/sk4z311myfcppqBXnVWp5NXPi5M.jpg","release_date":"1993-09-17","softcore":false,"video":false,"vote_average":6.591,"vote_count":1795,"credit_id":"52fe454cc3a36847f80c686f","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/uuEF8CfsfhOgy21t1nAEGObJPBN.jpg","genre_ids":[37,18,10749],"id":42201,"title":"Przybywa jeździec","original_language":"en","original_title":"Comes a Horseman","overview":"Ostatnie tygodnie II wojny światowej. Ranny Frank Athearn zostaje zwolniony do cywila. Przybywa do Montany i kupuje ziemię od farmerki Elli Connors. Pierwszego wieczoru zostaje zamordowany jego towarzysz. Nieprzytomnego Franka znajduje kowboj, który odkrywa, że zabójcą był człowiek Ewinga, największego hodowcy bydła w okolicy, dążącego do wyrugowania Elli z jej ziem. Gdy Frank wraca do zdrowia, proponuje dziewczynie pomoc w pracy na ranczu. Niebawem ich współpraca przeradza się w miłość. Teraz Ewing musi się pozbyć i Elli, i jej ukochanego.","popularity":1.9716,"poster_path":"/iSX6HqUJM0Caxm4hK5N2EAPbLaV.jpg","release_date":"1978-10-25","softcore":false,"video":false,"vote_average":6.136,"vote_count":78,"credit_id":"52fe45f4c3a36847f80e402b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sCBEywMPvO8sS3dvubMNYt7onCD.jpg","genre_ids":[53,18],"id":37753,"title":"Tolerancyjni Partnerzy","original_language":"en","original_title":"Consenting Adults","overview":"Sąsiedzi, Richard i Eddy, pozostają ze sobą w przyjacielskich relacjach. Niespodziewanie drugi z mężczyzn proponuje koledze, aby na jedną noc zamienili się żonami.","popularity":2.5358,"poster_path":"/16H9mMevZFFZfnCgsE2fVe2HH51.jpg","release_date":"1992-10-16","softcore":false,"video":false,"vote_average":5.424,"vote_count":171,"credit_id":"52fe466c9251416c9105401b","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sCBEywMPvO8sS3dvubMNYt7onCD.jpg","genre_ids":[53,18],"id":37753,"title":"Tolerancyjni Partnerzy","original_language":"en","original_title":"Consenting Adults","overview":"Sąsiedzi, Richard i Eddy, pozostają ze sobą w przyjacielskich relacjach. Niespodziewanie drugi z mężczyzn proponuje koledze, aby na jedną noc zamienili się żonami.","popularity":2.5358,"poster_path":"/16H9mMevZFFZfnCgsE2fVe2HH51.jpg","release_date":"1992-10-16","softcore":false,"video":false,"vote_average":5.424,"vote_count":171,"credit_id":"52fe466c9251416c91054041","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/uiUpvnv8zgA2pm1J7tT8DPLxh84.jpg","genre_ids":[18,10749,10752],"id":15764,"title":"Wybór Zofii","original_language":"en","original_title":"Sophie's Choice","overview":"Stany Zjednoczone, rok 1947. Stingo (Peter MacNicol), początkujący pisarz z Wirginii, wynajmuje pokój w Brooklynie. Spokój, którego potrzebuje do napisania swej pierwszej powieści, zakłócają sąsiedzi. Tuż obok mieszka bowiem młoda para, której głośna miłość i jeszcze głośniejsze awantury absorbują uwagę południowca. Okazuje się, że Nathan Landau (Kevin Kline) - niezrównoważony żydowski intelektualista - z chorobliwą wręcz obsesją zbiera dowody zbrodni popełnianych na tym narodzie. Jego przyjaciółką jest Zofia Zawistowska (Meryl Streep), Polka z Krakowa, była więźniarka obozu oświęcimskiego, której najbliższych: ojca, męża i dwoje dzieci zgładzili naziści. Stingo staje się przyjacielem i powiernikiem tych dwojga, poznaje ich tajemnice oraz pełną cierpienia, dramatyczną przeszłość...","popularity":4.043,"poster_path":"/rZDPbPTFwuKgr5b9jixGFNYkGYt.jpg","release_date":"1982-12-08","softcore":false,"video":false,"vote_average":7.31,"vote_count":955,"credit_id":"52fe467a9251416c75079a03","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uiUpvnv8zgA2pm1J7tT8DPLxh84.jpg","genre_ids":[18,10749,10752],"id":15764,"title":"Wybór Zofii","original_language":"en","original_title":"Sophie's Choice","overview":"Stany Zjednoczone, rok 1947. Stingo (Peter MacNicol), początkujący pisarz z Wirginii, wynajmuje pokój w Brooklynie. Spokój, którego potrzebuje do napisania swej pierwszej powieści, zakłócają sąsiedzi. Tuż obok mieszka bowiem młoda para, której głośna miłość i jeszcze głośniejsze awantury absorbują uwagę południowca. Okazuje się, że Nathan Landau (Kevin Kline) - niezrównoważony żydowski intelektualista - z chorobliwą wręcz obsesją zbiera dowody zbrodni popełnianych na tym narodzie. Jego przyjaciółką jest Zofia Zawistowska (Meryl Streep), Polka z Krakowa, była więźniarka obozu oświęcimskiego, której najbliższych: ojca, męża i dwoje dzieci zgładzili naziści. Stingo staje się przyjacielem i powiernikiem tych dwojga, poznaje ich tajemnice oraz pełną cierpienia, dramatyczną przeszłość...","popularity":4.043,"poster_path":"/rZDPbPTFwuKgr5b9jixGFNYkGYt.jpg","release_date":"1982-12-08","softcore":false,"video":false,"vote_average":7.31,"vote_count":955,"credit_id":"52fe467a9251416c75079a09","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/wW5alMLoaKvo4y7LK13GK0J8OqL.jpg","genre_ids":[18,10749,35],"id":46941,"title":"Love and Pain and the Whole Damn Thing","original_language":"en","original_title":"Love and Pain and the Whole Damn Thing","overview":"","popularity":1.1651,"poster_path":"/mWGvH04w4DF3aQXIob61oTGon4A.jpg","release_date":"1973-04-19","softcore":false,"video":false,"vote_average":6.1,"vote_count":10,"credit_id":"52fe4717c3a36847f8122e29","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/cKitWRm9XliRUrVEAlTGUGer441.jpg","genre_ids":[35,18,10749],"id":39495,"title":"Love with the Proper Stranger","original_language":"en","original_title":"Love with the Proper Stranger","overview":"","popularity":1.8934,"poster_path":"/1Dzre2aAiLZhAW03FlJ1n6YwQSN.jpg","release_date":"1963-12-25","softcore":false,"video":false,"vote_average":6.8,"vote_count":70,"credit_id":"52fe471f9251416c9106ab91","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/xpLfNYeICRtVPHPU2RN0a20c5zy.jpg","genre_ids":[80,18,53],"id":17365,"title":"Syndykat zbrodni","original_language":"en","original_title":"The Parallax View","overview":"Senator, kandydat na prezydenta USA, zostaje zastrzelony podczas spotkania z wyborcami. Wkrótce kolejni świadkowie tego wydarzenia zaczynają ginąć w tajemniczych okolicznościach.","popularity":2.6614,"poster_path":"/5ClPRox438lwK2Eze7X5xySDaYC.jpg","release_date":"1974-06-14","softcore":false,"video":false,"vote_average":6.8,"vote_count":375,"credit_id":"52fe47219251416c7508ea95","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/rcJFPsBPPGa0KfK03sX9VlQZ00o.jpg","genre_ids":[18,9648,10749,53],"id":47888,"title":"Rollover","original_language":"en","original_title":"Rollover","overview":"","popularity":1.3643,"poster_path":"/nKHS1gqfZL0imDyN4CLqloYXDWr.jpg","release_date":"1981-10-11","softcore":false,"video":false,"vote_average":5.221,"vote_count":28,"credit_id":"52fe474cc3a36847f812dca5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/51CGGUbTzs5lRxmPRNLOHeC3GPB.jpg","genre_ids":[35,18],"id":54494,"title":"Bezpłodna kukułka","original_language":"en","original_title":"The Sterile Cuckoo","overview":"Pookie Adams to ekscentryczna gaduła, która ze wszystkich sił stara się innym narzucać swoje zdanie. W rzeczywistości dziewczyna jest bardzo niepewna siebie i panicznie boi się samotności. Pewnego dnia spotyka nieśmiałego studenta Jerry'ego, któremu pomaga przetrwać pierwsze miesiące na uczelni. Między nimi rodzi się uczucie. Szybko jednak okazuje się, że chłopak czuje się zdominowany przez Pookie i pragnie odzyskać niezależność.","popularity":1.4425,"poster_path":"/8IP6hkHhmyVvgKPL8V37yjDMiAp.jpg","release_date":"1969-10-22","softcore":false,"video":false,"vote_average":5.516,"vote_count":32,"credit_id":"52fe489fc3a36847f8171243","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/y50gto8KjSGnabp6SCO1nNTqrkk.jpg","genre_ids":[35,10749],"id":54663,"title":"Starting Over","original_language":"en","original_title":"Starting Over","overview":"","popularity":5.1465,"poster_path":"/kvhfunLx3iL3VM0rjmFLV2dcEyd.jpg","release_date":"1979-10-05","softcore":false,"video":false,"vote_average":6.393,"vote_count":70,"credit_id":"52fe48a9c3a36847f8173083","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/dELQgGkRUSXgqbHy4JfTjqQanN5.jpg","genre_ids":[27,80,18,53],"id":103600,"title":"Dream Lover","original_language":"en","original_title":"Dream Lover","overview":"","popularity":1.2158,"poster_path":"/71LKYA4IBYmGcMzQMxkhmJNI5nd.jpg","rel