er_path":"/y4CMKllPHgMno7Uvigqic56pvmM.jpg","release_date":"1995-06-06","softcore":false,"video":false,"vote_average":6.8,"vote_count":16,"credit_id":"52fe49eb9251416c750d7b93","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tQDeXcuogjNbqdqPeJxBPD7QUzS.jpg","genre_ids":[12,18],"id":88893,"title":"Krzyk kamienia","original_language":"en","original_title":"Cerro Torre: Schrei aus Stein","overview":"Nieposkromione pragnienie człowieka, by zmierzyć się z potęgą natury. Dwóch mężczyzn podejmuje przed kamerami telewizji zakład o to, który pierwszy zdobędzie Cerro Torre, dziewiczy szczyt wyrastający ze śniegów i lodu w górach Patagonii. Obaj poświęcają tym zmaganiom wszystko... Jedno wam powiem, nikt stąd nie wraca żywy. I ja wiem dlaczego. Bo Cerro Torre... to nie jest góra. To krzyk kamienia.","popularity":1.2992,"poster_path":"/egROOqQo00anjXFYd6YDZoM4VA3.jpg","release_date":"1991-10-03","softcore":false,"video":false,"vote_average":6.3,"vote_count":37,"credit_id":"52fe4a079251416c910c0cd5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jLhPalsB7IqpLbiFMI3eRIg63Rx.jpg","genre_ids":[99],"id":102691,"title":"Glocken aus der Tiefe","original_language":"de","original_title":"Glocken aus der Tiefe","overview":"","popularity":1.076,"poster_path":"/yQiPcF0usfStfHSCnWOpXSQ5luZ.jpg","release_date":"1993-09-07","softcore":false,"video":false,"vote_average":7.065,"vote_count":31,"credit_id":"52fe4a0ec3a36847f81b657f","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jLhPalsB7IqpLbiFMI3eRIg63Rx.jpg","genre_ids":[99],"id":102691,"title":"Glocken aus der Tiefe","original_language":"de","original_title":"Glocken aus der Tiefe","overview":"","popularity":1.076,"poster_path":"/yQiPcF0usfStfHSCnWOpXSQ5luZ.jpg","release_date":"1993-09-07","softcore":false,"video":false,"vote_average":7.065,"vote_count":31,"credit_id":"52fe4a0ec3a36847f81b6585","department":"Writing","job":"Writer"},{"adult":false,"backdrop_