o":false,"vote_average":0.0,"vote_count":0,"credit_id":"66bdee01362232b6c2828b16","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":562893,"title":"Les Gaulois","original_language":"fr","original_title":"Les Gaulois","overview":"","popularity":1.7534,"poster_path":"/ZUdIZCqR3QwIIcFhM2x70KeoZP.jpg","release_date":"1988-10-26","softcore":false,"video":false,"vote_average":8.0,"vote_count":3,"credit_id":"5bf25baa9251412f3500cdf1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/fnuftuStugg1sbEOeefQKQu7EE6.jpg","genre_ids":[18,10402],"id":881366,"title":"Koniec","original_language":"en","original_title":"The End","overview":"Postapokaliptyczna opowieść o bogatej rodzinie mieszkającej w kopalni soli przekształconej w luksusowy dom. Ziemia wokół nich została najwyraźniej zniszczona, ale ich syn nigdy nie widział świata zewnętrznego. Gdy młoda dziewczyna pojawia się u wejścia do bunkra, równowaga rodziny zostaje zagrożona.","popularity":3.3164,"poster_path":"/3mWmkKFUhvoEaFadN7ptZOZMYEy.jpg","release_date":"2024-12-06","softcore":false,"video":false,"vote_average":5.22,"vote_count":82,"credit_id":"66d648334c59aca41db66011","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/eYpu1C6Xe3FzHaw5MtMVxLjBtJf.jpg","genre_ids":[18,12,36],"id":157843,"title":"Królowa pustyni","original_language":"en","original_title":"Queen of the Desert","overview":"Pisarka, podróżniczka, archeolog, agentka brytyjskiego wywiadu. Niezwykła kobieta, która w czasach emancypacji stała się jedną z najważniejszych osób kształtujących politykę Imperium Brytyjskiego na Bliskim Wschodzie. Gertrude Bell robiła zawsze to, na co miała ochotę. Uwielbiała ryzyko i adrenalinę. Niektórzy mówili o niej \"zarozumiała pannica z Oxfordu\". Konsekwentnie udowadniała, że jest lepsza od mężczyzn. Osiągnęła pozycję w świecie arabskim, która wówczas wydawała się dla kobiety niemożliwa, nawet w Wielkiej Brytanii. Jej życie to przygoda, w której spełniały się wszystkie marzenia – poza jednym: miłością.","popularity":3.6782,"poster_path":"/wi1fP8N42Nrtfh8RiBPCcvP5hGI.jpg","release_date":"2015-09-03","softcore":false,"video":false,"vote_average":5.831,"vote_count":311,"credit_id":"5d408aaf172d7f000e21a645","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/8XA4QIjWEliY6U0MfEMkK4F5XtH.jpg","genre_ids":[99],"id":45763,"title":"Herakles","original_language":"de","original_title":"Herakles","overview":"","popularity":0.6943,"poster_path":"/eocDtOQMPG4aVOFMxrrkVBCEMCi.jpg","release_date":"1962-01-01","softcore":false,"video":false,"vote_average":6.036,"vote_count":28,"credit_id":"5d712e1977c01f45795a5e73","department":"Sound","job":"Sound"},{"adult":false,"backdrop_path":"/3pShRqzVAoLUTwi24wryL1ayTwb.jpg","genre_ids":[35],"id":146473,"title":"Maßnahmen gegen Fanatiker","original_language":"de","original_title":"Maßnahmen gegen Fanatiker","overview":"","popularity":1.0812,"poster_path":"/uLfdLSAJsna3sajR0SVvC4oCaon.jpg","release_date":"1969-03-28","softcore":false,"video":false,"vote_average":5.883,"vote_count":30,"credit_id":"5d713edb9c97bd000fe53693","department":"Sound","job":"Sound"},{"adult":false,"backdrop_path":"/8XA4QIjWEliY6U0MfEMkK4F5XtH.jpg","genre_ids":[99],"id":45763,"title":"Herakles","original_language":"de","original_title":"Herakles","overview":"","popularity":0.6943,"poster_path":"/eocDtOQMPG4aVOFMxrrkVBCEMCi.jpg","release_date":"1962-01-01","softcore":false,"video":false,"vote_average":6.036,"vote_count":28,"credit_id":"5d712dcc9c97bd0012e52353","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/8XA4QIjWEliY6U0MfEMkK4F5XtH.jpg","genre_ids":[99],"id":45763,"title":"Herakles","original_language":"de","original_title":"Herakles","overview":"","popularity":0.6943,"poster_path":"/eocDtOQMPG4aVOFMxrrkVBCEMCi.jpg","release_date":"1962-01-01","softcore":false,"video":false,"vote_average":6.036,"vote_count":28,"credi