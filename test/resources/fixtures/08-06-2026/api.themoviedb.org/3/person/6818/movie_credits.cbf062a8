ftcore":false,"video":false,"vote_average":7.3,"vote_count":21,"credit_id":"666579b286b7b8d3c1158c4c","department":"Production","job":"Co-Producer"},{"adult":false,"backdrop_path":"/fO489b4PPR5Ndm3xJZ1AboCoSb.jpg","genre_ids":[99],"id":55624,"title":"Fata Morgana","original_language":"de","original_title":"Fata Morgana","overview":"Eksperymentalny film, którego tematem są krajobrazy afrykańskie, księga Popol Vuh i muzyka. Fata Morgana to dokumentalny, impresyjny i bardzo osobisty poemat, jedno z najznakomitszych i zarazem najdziwniejszych dzieł Herzoga i nowego kina niemieckiego w ogóle. Film składa się z trzech części. Stworzenie, Raj i Złoty wiek, a każda z tych sekwencji \"symfonii obrazowej\" opatrzona jest komentarzem z Popol Vuh - świętej księgi Indian.","popularity":2.0657,"poster_path":"/btZgBpoizCKlvEN7qjvvas3TlZC.jpg","release_date":"1972-02-01","softcore":false,"video":false,"vote_average":6.529,"vote_count":87,"credit_id":"66657b5f8bc65344c09cfa9d","department":"Sound","job":"Sound"},{"adult":false,"backdrop_path":"/8zK62AqZABy7eQfhf4nH2d2hUph.jpg","genre_ids":[99],"id":46595,"title":"Die große Ekstase des Bildschnitzers Steiner","original_language":"de","original_title":"Die große Ekstase des Bildschnitzers Steiner","overview":"","popularity":0.8162,"poster_path":"/he7rn9rVFkaNFgsawS0KEMHX5DU.jpg","release_date":"1974-01-01","softcore":false,"video":false,"vote_average":7.214,"vote_count":70,"credit_id":"66657ba9030635cdae15882a","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99,10770,10402],"id":317305,"title":"Die Verwandlung der Welt in Musik: Bayreuth vor der Premiere","original_language":"de","original_title":"Die Verwandlung der Welt in Musik: Bayreuth vor der Premiere","overview":"","popularity":0.5241,"poster_path":"/hMl1rCbzGh5ua1RbQls5q5JrKMa.jpg","release_date":"1996-07-21","softcore":false,"video":false,"vote_average":8.333,"vote_count":3,"credit_id":"66657953b51da081b95318e0","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":"/eM3Kbzk9v03wJc0yoSC0QGEOU9C.jpg","genre_ids":[18],"id":11698,"title":"Stroszek","original_language":"de","original_title":"Stroszek","overview":"Zagubiony i nieradzący sobie z rzeczywistością Bruno Stroszek (Bruno S.) wychodzi z berlińskiego więzienia. Za murami czekają na niego prostytutka Eva (Eva Mattes) oraz ekscentryczny starszy sąsiad Scheitz (Clemens Scheitz). Cała trójka decyduje się na wspólny wyjazd do Ameryki. Wierzą, że w Wisconsin uda im się na nowo ułożyć swoje życie i spełnić marzenia. Niestety, szybko okazuje się, że Stany nie są ziemią obiecaną. Historia berlińskiego kloszarda, który nie radzi sobie z rzeczywistością. Bohater, w którego rolę wciela się odkryty przez reżysera charyzmatyczny naturszczyk Bruno S. (Zagadka Kaspara Hausera), stwarza sobie swój własny świat, co pozwala mu pozornie odseparować się od bolączek codzienności. [cinemax.pl]","popularity":1.6333,"poster_path":"/1uSvTR2pKKGtzn8TOGRMz76FSpz.jpg","release_date":"1977-05-20","softcore":false,"video":false,"vote_average":7.305,"vote_count":303,"credit_id":"66657a7877a85a02fb78e105","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/fO489b4PPR5Ndm3xJZ1AboCoSb.jpg","genre_ids":[99],"id":55624,"title":"Fata Morgana","original_language":"de","original_title":"Fata Morgana","overview":"Eksperymentalny film, którego tematem są krajobrazy afrykańskie, księga Popol Vuh i muzyka. Fata Morgana to dokumentalny, impresyjny i bardzo osobisty poemat, jedno z najznakomitszych i zarazem najdziwniejszych dzieł Herzoga i nowego kina niemieckiego w ogóle. Film składa się z trzech części. Stworzenie, Raj i Złoty wiek, a każda z tych sekwencji \"symfonii obrazowej\" opatrzona jest komentarzem z Popol Vuh - świętej księgi Indian.","popularity":2.0657,"poster_path":"/btZgBpoizCKlvEN7qjvvas3TlZC.jpg","release_date":"1972-02-01","softcore":false,"video":false,"vote_average":6.529,"vote_count":87,"credit_id":"66657ae