szystkie marzenia – poza jednym: miłością.","popularity":3.6782,"poster_path":"/wi1fP8N42Nrtfh8RiBPCcvP5hGI.jpg","release_date":"2015-09-03","softcore":false,"video":false,"vote_average":5.831,"vote_count":311,"credit_id":"52fe4bd49251416c910e7045","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/t4DOvBKUTcUFjkDtVfxjrRPEPwJ.jpg","genre_ids":[99],"id":162451,"title":"Werner Herzog: Filmemacher","original_language":"de","original_title":"Werner Herzog: Filmemacher","overview":"","popularity":1.1234,"poster_path":"/7FlBcT50GARAxBDZrNO8XfLMC4W.jpg","release_date":"1986-03-27","softcore":false,"video":false,"vote_average":7.1,"vote_count":12,"credit_id":"52fe4c59c3a36847f8229b31","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/jigM91a1Q4fj7wjDoI7Bd1hvvCY.jpg","genre_ids":[99,10770],"id":139945,"title":"Gasherbrum - Der leuchtende Berg","original_language":"de","original_title":"Gasherbrum - Der leuchtende Berg","overview":"","popularity":1.3425,"poster_path":"/a59m7tezyQEG5qqkIdgFlyhSI6N.jpg","release_date":"1985-03-09","softcore":false,"video":false,"vote_average":7.645,"vote_count":31,"credit_id":"52fe4c71c3a368484e1b8923","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bEyNzlPo3O2VplI2WymdHfzmJ4k.jpg","genre_ids":[99],"id":172011,"title":"Letzte Worte","original_language":"de","original_title":"Letzte Worte","overview":"","popularity":0.6225,"poster_path":"/h5MbbMQBNIuUK4NDHECZXzGWyFL.jpg","release_date":"1968-04-03","softcore":false,"video":false,"vote_average":5.543,"vote_count":35,"credit_id":"52fe4d18c3a36847f824e675","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/bEyNzlPo3O2VplI2WymdHfzmJ4k.jpg","genre_ids":[99],"id":172011,"title":"Letzte Worte","original_language":"de","original_title":"Letzte Worte","overview":"","popularity":0.6225,"poster_path":"/h5MbbMQBNIuUK4NDHECZXzGWyFL.jpg","release_date":"1968-04-03","softcore":false,"video":false,"vote_avera