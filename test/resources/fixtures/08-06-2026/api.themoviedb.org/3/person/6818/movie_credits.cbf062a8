6492,"poster_path":"/zuZWpcuye25rpsiZ4XzsAvmLDHG.jpg","release_date":"2005-08-12","softcore":false,"video":false,"vote_average":7.535,"vote_count":968,"credit_id":"52fe424ac3a36847f8012d77","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/7J9mhvkKH6kvjshBNNcEJungJvG.jpg","genre_ids":[18],"id":10319,"title":"Woyzeck","original_language":"de","original_title":"Woyzeck","overview":"Miasteczko garnizonowe, rok 1850. Johann Franz Woyzeck jest szeregowcem w pruskiej armii i golibrodą kapitana. Bohater jest poniżany przez przełożonego i poddawany podejrzanym eksperymentom medycznym przez wojskowego lekarza. Kocha platonicznie miejscową ladacznicę, Marię. Utrzymuje ją i jej dziecko, oddając cały skromny żołd. Maria nie docenia tego uczucia, zdradza go z przystojnym doboszem. Woyzeck zaczyna cierpieć na pewnego rodzaju zaburzenia i halucynacje. Wiedziony szaleństwem i zazdrością popełnia morderstwo.","popularity":1.4405,"poster_path":"/8O2PuxOdBVJSeU6kjP7ukZgA26n.jpg","release_date":"1979-05-25","softcore":false,"video":false,"vote_average":6.6,"vote_count":203,"credit_id":"52fe43589251416c7500cd39","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/7J9mhvkKH6kvjshBNNcEJungJvG.jpg","genre_ids":[18],"id":10319,"title":"Woyzeck","original_language":"de","original_title":"Woyzeck","overview":"Miasteczko garnizonowe, rok 1850. Johann Franz Woyzeck jest szeregowcem w pruskiej armii i golibrodą kapitana. Bohater jest poniżany przez przełożonego i poddawany podejrzanym eksperymentom medycznym przez wojskowego lekarza. Kocha platonicznie miejscową ladacznicę, Marię. Utrzymuje ją i jej dziecko, oddając cały skromny żołd. Maria nie docenia tego uczucia, zdradza go z przystojnym doboszem. Woyzeck zaczyna cierpieć na pewnego rodzaju zaburzenia i halucynacje. Wiedziony szaleństwem i zazdrością popełnia morderstwo.","popularity":1.4405,"poster_path":"/8O2PuxOdBVJSeU6kjP7ukZgA26n.jpg","release_date":"1979-05-25","softcore":false,"video":false,"vote_average":6.6,"vote_count":203,"credit_id":"52fe43589251416c7500cd33","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kfSZaOr9ApNR52gWKlpXHD0id0W.jpg","genre_ids":[36,12,18],"id":2000,"title":"Aguirre, gniew boży","original_language":"de","original_title":"Aguirre, der Zorn Gottes","overview":"Dramat historyczny, efekt współpracy reżysera Wernera Herzoga i charyzmatycznego aktora Klausa Kinskiego. Peru, rok 1560. Na rozkaz hiszpańskiego konkwistadora Gonzala Pizarro z biegiem Amazonki rusza ekspedycja pod wodzą Pedra de Ursui, Fernanda de Guzmana i Lope de Aguirre. Ich celem jest El Dorado, mityczne złote miasto wśród tropikalnej dżungli. Opętany żądzą bogactwa i władzy Aguirre usuwa wszystkich, którzy staną mu na drodze, pogrążając się w odmętach samozagłady i szaleństwa.","popularity":4.4802,"poster_path":"/4Tfk8KhbfGYjIxQBwP9KyuxMEee.jpg","release_date":"1972-12-29","softcore":false,"video":false,"vote_average":7.433,"vote_count":1269,"credit_id":"52fe432ac3a36847f803f697","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/kfSZaOr9ApNR52gWKlpXHD0id0W.jpg","genre_ids":[36,12,18],"id":2000,"title":"Aguirre, gniew boży","original_language":"de","original_title":"Aguirre, der Zorn Gottes","overview":"Dramat historyczny, efekt współpracy reżysera Wernera Herzoga i charyzmatycznego aktora Klausa Kinskiego. Peru, rok 1560. Na rozkaz hiszpańskiego konkwistadora Gonzala Pizarro z biegiem Amazonki rusza ekspedycja pod wodzą Pedra de Ursui, Fernanda de Guzmana i Lope de Aguirre. Ich celem jest El Dorado, mityczne złote miasto wśród tropikalnej dżungli. Opętany żądzą bogactwa i władzy Aguirre usuwa wszystkich, którzy staną mu na drodze, pogrążając się w odmętach samozagłady i szaleństwa.","popularity":4.4802,"poster_path":"/4Tfk8KhbfGYjIxQBwP9KyuxMEee.jpg","release_date":"1972-12-29","softcore":false,"video":false,"vote_average":7.433,"vote_count":1269,"credit_id":"52fe432ac3a36847f803f667","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uHwJaXKtIsjI4IrtaFLnJjLZMrs.jpg","genre_ids":[12,18],"id":11513,"title":"Cobra Verde","original_language":"de","original_title":"Cobra Verde","overview":"Brazylia, początek XIX wieku. Francisco Manuel da Silva zdesperowany utratą majątku popełnia morderstwo. Ucieka do Bahii i przybierając pseudonim Cobra Verde zatrudnia się jako strażnik na ogromnej plantacji trzciny cukrowej. Jej właściciel - Don Octavio Coutinha wysyła da Silvę do Dahomeyu w Zachodniej Afryce z ryzykownym zadaniem zdobycia niewolników. W rzeczywistości zamiarem najemcy jest wysłanie da Silvy na pewną śmierć z rąk króla Bossa Ahadee. Da Silva przybywa do Dahomeyu z ładunkiem broni. Wkrótce odbudowuje i umacnia zniszczoną placówkę, wznawia regularny eksport niewolników. Mianuje siebie wicekrólem Dahomeyu, a następnie organizuje zamach stanu. Mimo wiadomości o zniesieniu niewolnictwa i kolejnej utracie całego majątku z pełną determinacją walczy o przetrwanie. Cobra Verde to portret zdobywcy, człowieka pełnego pasji i determinacji, dla którego największym wyzwaniem jest zaistnienie w historii świata.","popularity":2.8948,"poster_path":"/sm2LqzGlVlUHIlDAAPFbnXWVblp.jpg","release_date":"1987-12-03","softcore":false,"video":false,"vote_average":6.898,"vote_count":166,"credit_id":"52fe444f9251416c750303e3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uHwJaXKtIsjI4IrtaFLnJjLZMrs.jpg","genre_ids":[12,18],"id":11513,"title":"Cobra Verde","original_language":"de","original_title":"Cobra Verde","overview":"Brazylia, początek XIX wieku. Francisco Manuel da Silva zdesperowany utratą majątku popełnia morderstwo. Ucieka do Bahii i przybierając pseudonim Cobra Verde zatrudnia się jako strażnik na ogromnej plantacji trzciny cukrowej. Jej właściciel - Don Octavio Coutinha wysyła da Silvę do Dahomeyu w Zachodniej Afryce z ryzykownym zadaniem zdobycia niewolników. W rzeczywistości zamiarem najemcy jest wysłanie da Silvy na pewną śmierć z rąk króla Bossa Ahadee. Da Silva przybywa do Dahomeyu z ładunkiem broni. Wkrótce odbudowuje i umacnia zniszczoną placówkę, wznawia regularny eksport niewolników. Mianuje siebie wicekrólem Dahomeyu, a następnie organizuje zamach stanu. Mimo wiadomości o zniesieniu niewolnictwa i kolejnej utracie całego majątku z pełną determinacją walczy o przetrwanie. Cobra Verde to portret zdobywcy, człowieka pełnego pasji i determinacji, dla którego największym wyzwaniem jest zaistnienie w historii świata.","popularity":2.8948,"poster_path":"/sm2LqzGlVlUHIlDAAPFbnXWVblp.jpg","release_date":"1987-12-03","softcore":false,"video":false,"vote_average":6.898,"vote_count":166,"credit_id":"52fe444f9251416c750303e9","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/uHudMff1vp2GDXqHD8QOA78QpNW.jpg","genre_ids":[18,27],"id":6404,"title":"Nosferatu wampir","original_language":"de","original_title":"Nosferatu - Phantom der Nacht","overview":"Jonatham Harker otrzymuje list od hrabiego Draculi z Transylwanii z prośbą o jak najszybszy przyjazd. Jego żona Lucy, mając złe przeczucia, początkowo nie zgadza się na wyjazd, jednak w końcu ulega... Wbrew pozorom to nie strach stanowi motyw przewodni filmu lecz samotność. Wampir jest na wskroś ludzki; pragnie miłości i zrozumienia. Film jest zarówno ekranizacją powieści Dracula Brama Stokera jak i remakiem filmu z roku 1922, Nosferatu – symfonia grozy.","popularity":4.0964,"poster_path":"/wzIVNEAEkv7bvT0nAmBnxyDIGKl.jpg","release_date":"1979-01-17","softcore":false,"video":false,"vote_average":7.28,"vote_count":1098,"credit_id":"52fe4450c3a36847f808eb83","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/uHudMff1vp2GDXqHD8QOA78QpNW.jpg","genre_ids":[18,27],"id":6404,"title":"Nosferatu wampir","original_language":"de","original_title":"Nosferatu - Phantom der Nacht","overview":"Jonatham Harker otrzymuje list od hrabiego Draculi z Transylwanii z prośbą o jak najszybszy przyjazd. Jego żona Lucy, mając złe przeczucia, początkowo nie zgadza się na wyjazd, jednak w końcu ulega... Wbrew pozorom to nie strach stanowi motyw przewodni filmu lecz samotność. Wampir jest na wskroś ludzki; pragnie miłości i zrozumienia. Film jest zarówno ekranizacją powieści Dracula Brama Stokera jak i remakiem filmu z roku 1922, Nosferatu – symfonia grozy.","popularity":4.0964,"poster_path":"/wzIVNEAEkv7bvT0nAmBnxyDIGKl.jpg","release_date":"1979-01-17","softcore":false,"video":false,"vote_average":7.28,"vote_count":1098,"credit_id":"52fe4450c3a36847f808ec33","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/3lvQSIawim7dc2FrzrIf72Uxw6v.jpg","genre_ids":[18,99],"id":23676,"title":"10 minut później: Trąbka","original_language":"en","original_title":"Ten Minutes Older: The Trumpet","overview":"Zestawienie krótkich nowel filmowych stworzonych przez znanych i docenianych na całym świecie twórców. Te krótkie opowieści traktują o najważniejszych aspektach ludzkiego życia (śmierci, miłości, seksie). Każdy reżyser przedstawia własną wizję tego, co nazywamy czasem.","popularity":1.602,"poster_path":"/yxIKQ2MeZAYiZ5lbJyYrNmXf7Dy.jpg","release_date":"2002-05-18","softcore":false,"video":false,"vote_average":6.9,"vote_count":47,"credit_id":"52fe4472c3a368484e02392d","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/3lvQSIawim7dc2FrzrIf72Uxw6v.jpg","genre_ids":[18,99],"id":23676,"title":"10 minut później: Trąbka","original_language":"en","original_title":"Ten Minutes Older: The Trumpet","overview":"Zestawienie krótkich nowel filmowych stworzonych przez znanych i docenianych na całym świecie twórców. Te krótkie opowieści traktują o najważniejszych aspektach ludzkiego życia (śmierci, miłości, seksie). Każdy reżyser przedstawia własną wizję tego, co nazywamy czasem.","popularity":1.602,"poster_path":"/yxIKQ2MeZAYiZ5lbJyYrNmXf7Dy.jpg","release_date":"2002-05-18","softcore":false,"video":false,"vote_average":6.9,"vote_count":47,"credit_id":"52fe4472c3a368484e023909","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/sZRR4sTJrXszqW6gGqg846FzuP.jpg","genre_ids":[35,18],"id":11900,"title":"Nawet karły były kiedyś małe","original_language":"de","original_title":"Auch Zwerge haben klein angefangen","overview":"Film obrazujący w formie przejmującej groteski relacje człowieka z otaczającą go rzeczywistością przedmiotów. Herzog wykorzystuje egzotyczny świat karłów - skazanych za grzech \"inności\" - dla zobrazowania sposobu, w jaki relacje międzyludzkie, oparte na głęboko osobistych kontaktach, zostają zdominowane przez obiekty materialne i chęć posiadania. Spontaniczne powstanie karłów, zbuntowanych przeciwko wszelkim instytucjom i ich produktom, to przykład anarchistycznej negacji wartości mieszczańskich, stojących na straży społecznego ładu. W finale widzimy bluźnierczą procesję karłów niosących krzyż z rozpiętą nad nim małpą. Bunt i rewolta nie wykroczyły poza wymiar obrzędu i zaklętego kręgu niemożności.","popularity":1.8057,"poster_path":"/95u351ON9S45uVLdG3DsKXgKSxH.jpg","release_date":"1971-02-02","softcore":false,"video":false,"vote_average":6.391,"vote_count":124,"credit_id":"52fe449d9251416c7503b035","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/sZRR4sTJrXszqW6gGqg846FzuP.jpg","genre_ids":[35,18],"id":11900,"title":"Nawet karły były kiedyś małe","original_language":"de","original_title":"Auch Zwerge haben klein angefangen","overview":"Film obrazujący w formie przejmującej groteski relacje człowieka z otaczającą go rzeczywistością przedmiotów. Herzog wykorzystuje egzotyczny świat karłów - skazanych za grzech \"inności\" - dla zobrazowania sposobu, w jaki relacje międzyludzkie, oparte na głęboko osobistych kontaktach, zostają zdominowane przez obiekty materialne i chęć posiadania. Spontaniczne powstanie karłów, zbuntowanych przeciwko wszelkim instytucjom i ich produktom, to przykład anarchistycznej negacji wartości mieszczańskich, stojących na straży społecznego ładu. W finale widzimy bluźnierczą procesję karłów niosących krzyż z rozpiętą nad nim małpą. Bunt i rewolta nie wykroczyły poza wymiar obrzędu i zaklętego kręgu niemożności.","popularity":1.8057,"poster_path":"/95u351ON9S45uVLdG3DsKXgKSxH.jpg","release_date":"1971-02-02","softcore":false,"video":false,"vote_average":6.391,"vote_count":124,"credit_id":"52fe449d9251416c7503b02f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/sZRR4sTJrXszqW6gGqg846FzuP.jpg","genre_ids":[35,18],"id":11900,"title":"Nawet karły były kiedyś małe","original_language":"de","original_title":"Auch Zwerge haben klein angefangen","overview":"Film obrazujący w formie przejmującej groteski relacje człowieka z otaczającą go rzeczywistością przedmiotów. Herzog wykorzystuje egzotyczny świat karłów - skazanych za grzech \"inności\" - dla zobrazowania sposobu, w jaki relacje międzyludzkie, oparte na głęboko osobistych kontaktach, zostają zdominowane przez obiekty materialne i chęć posiadania. Spontaniczne powstanie karłów, zbuntowanych przeciwko wszelkim instytucjom i ich produktom, to przykład anarchistycznej negacji wartości mieszczańskich, stojących na straży społecznego ładu. W finale widzimy bluźnierczą procesję karłów niosących krzyż z rozpiętą nad nim małpą. Bunt i rewolta nie wykroczyły poza wymiar obrzędu i zaklętego kręgu niemożności.","popularity":1.8057,"poster_path":"/95u351ON9S45uVLdG3DsKXgKSxH.jpg","release_date":"1971-02-02","softcore":false,"video":false,"vote_average":6.391,"vote_count":124,"credit_id":"52fe449d9251416c7503b029","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eM3Kbzk9v03wJc0yoSC0QGEOU9C.jpg","genre_ids":[18],"id":11698,"title":"Stroszek","original_language":"de","original_title":"Stroszek","overview":"Zagubiony i nieradzący sobie z rzeczywistością Bruno Stroszek (Bruno S.) wychodzi z berlińskiego więzienia. Za murami czekają na niego prostytutka Eva (Eva Mattes) oraz ekscentryczny starszy sąsiad Scheitz (Clemens Scheitz). Cała trójka decyduje się na wspólny wyjazd do Ameryki. Wierzą, że w Wisconsin uda im się na nowo ułożyć swoje życie i spełnić marzenia. Niestety, szybko okazuje się, że Stany nie są ziemią obiecaną. Historia berlińskiego kloszarda, który nie radzi sobie z rzeczywistością. Bohater, w którego rolę wciela się odkryty przez reżysera charyzmatyczny naturszczyk Bruno S. (Zagadka Kaspara Hausera), stwarza sobie swój własny świat, co pozwala mu pozornie odseparować się od bolączek codzienności. [cinemax.pl]","popularity":1.6333,"poster_path":"/1uSvTR2pKKGtzn8TOGRMz76FSpz.jpg","release_date":"1977-05-20","softcore":false,"video":false,"vote_average":7.305,"vote_count":303,"credit_id":"52fe447b9251416c75036587","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/eM3Kbzk9v03wJc0yoSC0QGEOU9C.jpg","genre_ids":[18],"id":11698,"title":"Stroszek","original_language":"de","original_title":"Stroszek","overview":"Zagubiony i nieradzący sobie z rzeczywistością Bruno Stroszek (Bruno S.) wychodzi z berlińskiego więzienia. Za murami czekają na niego prostytutka Eva (Eva Mattes) oraz ekscentryczny starszy sąsiad Scheitz (Clemens Scheitz). Cała trójka decyduje się na wspólny wyjazd do Ameryki. Wierzą, że w Wisconsin uda im się na nowo ułożyć swoje życie i spełnić marzenia. Niestety, szybko okazuje się, że Stany nie są ziemią obiecaną. Historia berlińskiego kloszarda, który nie radzi sobie z rzeczywistością. Bohater, w którego rolę wciela się odkryty przez reżysera charyzmatyczny naturszczyk Bruno S. (Zagadka Kaspara Hausera), stwarza sobie swój własny świat, co pozwala mu pozornie odseparować się od bolączek codzienności. [cinemax.pl]","popularity":1.6333,"poster_path":"/1uSvTR2pKKGtzn8TOGRMz76FSpz.jpg","release_date":"1977-05-20","softcore":false,"video":false,"vote_average":7.305,"vote_count":303,"credit_id":"52fe447b9251416c7503658d","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/abF5X1C7KMJEJnbB7KidfHOIszj.jpg","genre_ids":[18,80],"id":11699,"title":"Zły Porucznik","original_language":"en","original_title":"Bad Lieutenant: Port of Call New Orleans","overview":"Spustoszony przez huragan Katrinę, Nowy Orlean to miejsce pracy Terence'a McDonagha, sierżanta policji, tytułowego bohatera nowego filmu Wernera Herzoga. Postać wykreowana przez Nicholasa Cage'a nadużywa narkotyków i alkoholu, traci pieniądze na hazard, zadaje się z prostytutkami, a w swojej pracy często przekracza kompetencje zwykłego gliny. 6 miesięcy po awansie na stanowisko porucznika podejmuje dochodzenie w sprawie morderstwa dokonanego na rodzinie emigrantów z Afryki. Czy osobiste problemy pozwolą mu dokończyć śledztwo? Droga na dno wydaje się być niebezpiecznie krótka i prosta....","popularity":5.1488,"poster_path":"/zRULXsd0rb1lVfnSyQkYPi2nLcB.jpg","release_date":"2009-09-11","softcore":false,"video":false,"vote_average":6.18,"vote_count":1296,"credit_id":"52fe447b9251416c750365f5","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/3KzghZrRLcAdMHzBE9DCFSjdvxn.jpg","genre_ids":[99],"id":23965,"title":"The White Diamond","original_language":"en","original_title":"The White Diamond","overview":"","popularity":0.6097,"poster_path":"/oYSEPp5uyXZ0UXNhTGQtwvGUGKC.jpg","release_date":"2004-11-13","softcore":false,"video":false,"vote_average":6.933,"vote_count":82,"credit_id":"52fe447ac3a368484e02555d","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/6IDCYlcFAKgmEoSczfTxcYsVHep.jpg","genre_ids":[878],"id":8410,"title":"The Wild Blue Yonder","original_language":"en","original_title":"The Wild Blue Yonder","overview":"","popularity":1.2589,"poster_path":"/iEs4KhPaQ0F514PscPJDtp0YclB.jpg","release_date":"2005-09-05","softcore":false,"video":false,"vote_average":6.0,"vote_count":91,"credit_id":"52fe44a5c3a36847f80a220f","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/6IDCYlcFAKgmEoSczfTxcYsVHep.jpg","genre_ids":[878],"id":8410,"title":"The Wild Blue Yonder","original_language":"en","original_title":"The Wild Blue Yonder","overview":"","popularity":1.2589,"poster_path":"/iEs4KhPaQ0F514PscPJDtp0YclB.jpg","release_date":"2005-09-05","softcore":false,"video":false,"vote_average":6.0,"vote_count":91,"credit_id":"52fe44a5c3a36847f80a2209","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9zYXDMmhBKTbCbImJclf9hEbqZC.jpg","genre_ids":[18,36],"id":11710,"title":"Zagadka Kaspara Hausera","original_language":"de","original_title":"Jeder für sich und Gott gegen alle","overview":"W 1828 roku w Norymberdze pojawia się włóczęga, który nie potrafi nawiązać żadnego kontaktu z otoczeniem. Nie potrafi sprostać najprostszym nawet czynnościom życiowym. Otoczony opieką przez parę naukowców, staje się ogólnoświatową sensacją. Są nawet tacy, którzy podejrzewają włóczęgę o bardzo bliskie koligacje z największymi dworami Europy.","popularity":2.1017,"poster_path":"/9pEBgvmK28fuVC08ak5jTPPvByn.jpg","release_date":"1974-11-01","softcore":false,"video":false,"vote_average":7.3,"vote_count":379,"credit_id":"52fe447e9251416c75036bdd","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/9zYXDMmhBKTbCbImJclf9hEbqZC.jpg","genre_ids":[18,36],"id":11710,"title":"Zagadka Kaspara Hausera","original_language":"de","original_title":"Jeder für sich und Gott gegen alle","overview":"W 1828 roku w Norymberdze pojawia się włóczęga, który nie potrafi nawiązać żadnego kontaktu z otoczeniem. Nie potrafi sprostać najprostszym nawet czynnościom życiowym. Otoczony opieką przez parę naukowców, staje się ogólnoświatową sensacją. Są nawet tacy, którzy podejrzewają włóczęgę o bardzo bliskie koligacje z największymi dworami Europy.","popularity":2.1017,"poster_path":"/9pEBgvmK28fuVC08ak5jTPPvByn.jpg","release_date":"1974-11-01","softcore":false,"video":false,"vote_average":7.3,"vote_count":379,"credit_id":"52fe447e9251416c75036bd1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/9zYXDMmhBKTbCbImJc