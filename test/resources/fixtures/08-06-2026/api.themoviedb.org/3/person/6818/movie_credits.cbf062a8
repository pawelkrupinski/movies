ids":[99],"id":212994,"title":"From One Second to the Next","original_language":"en","original_title":"From One Second to the Next","overview":"","popularity":1.0537,"poster_path":"/1ltHZPmNbCdd2hUgJgEx8hkZ4Fz.jpg","release_date":"2013-08-07","softcore":false,"video":false,"vote_average":6.952,"vote_count":31,"credit_id":"52fe4dbbc3a368484e1fa111","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18,10402],"id":217546,"title":"Giovanna d'Arco","original_language":"it","original_title":"Giovanna d'Arco","overview":"","popularity":0.5135,"poster_path":"/mAhKqdUvMCQmYWVu10kgsW5ImIk.jpg","release_date":"1989-01-01","softcore":false,"video":false,"vote_average":7.5,"vote_count":2,"credit_id":"52fe4e37c3a368484e214aa9","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kfSZaOr9ApNR52gWKlpXHD0id0W.jpg","genre_ids":[36,12,18],"id":2000,"title":"Aguirre, gniew boży","original_language":"de","original_title":"Aguirre, der Zorn Gottes","overview":"Dramat historyczny, efekt współpracy reżysera Wernera Herzoga i charyzmatycznego aktora Klausa Kinskiego. Peru, rok 1560. Na rozkaz hiszpańskiego konkwistadora Gonzala Pizarro z biegiem Amazonki rusza ekspedycja pod wodzą Pedra de Ursui, Fernanda de Guzmana i Lope de Aguirre. Ich celem jest El Dorado, mityczne złote miasto wśród tropikalnej dżungli. Opętany żądzą bogactwa i władzy Aguirre usuwa wszystkich, którzy staną mu na drodze, pogrążając się w odmętach samozagłady i szaleństwa.","popularity":4.4802,"poster_path":"/4Tfk8KhbfGYjIxQBwP9KyuxMEee.jpg","release_date":"1972-12-29","softcore":false,"video":false,"vote_average":7.433,"vote_count":1269,"credit_id":"530ac0fb9251415e71001832","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/hPiHLCfZurfRIbAHIW1MlDSyJdx.jpg","genre_ids":[99],"id":997782,"title":"The Blimp-Maker","original_language":"en","original_title":"The Blimp-Maker","overview":"","popularity":0.4655,"poster_path":"/7tvSL2HOo5nFbxEJergWRso81rj.jpg","release_date":"2016-02-29","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"62c94689e8131d0689add720","department":"Crew","job":"Thanks"},{"adult":false,"backdrop_path":"/uHudMff1vp2GDXqHD8QOA78QpNW.jpg","genre_ids":[18,27],"id":6404,"title":"Nosferatu wampir","original_language":"de","original_title":"Nosferatu - Phantom der Nacht","overview":"Jonatham Harker otrzymuje list od hrabiego Draculi z Transylwanii z prośbą o jak najszybszy przyjazd. Jego żona Lucy, mając złe przeczucia, początkowo nie zgadza się na wyjazd, jednak w końcu ulega... Wbrew pozorom to nie strach stanowi motyw przewodni filmu lecz samotność. Wampir jest na wskroś ludzki; pragnie miłości i zrozumienia. Film jest zarówno ekranizacją powieści Dracula Brama Stokera jak i remakiem filmu z roku 1922, Nosferatu – symfonia grozy.","popularity":4.0964,"poster_path":"/wzIVNEAEkv7bvT0nAmBnxyDIGKl.jpg","release_date":"1979-01-17","softcore":false,"video":false,"vote_average":7.28,"vote_count":1098,"credit_id":"536e3290c3a368121800cbf8","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":"/1jLaJPdu7dMl0Nk3vLuafDx9PWS.jpg","genre_ids":[99,36],"id":123678,"title":"Scena zbrodni","original_language":"da","original_title":"The Act of Killing","overview":"Film opowiada o antykomunistycznej czystce w Indonezji w latach 1965-1966, w trakcie której zamordowanych zostało przeszło 500,000 ludzi. Na skutek nieudanego zamachu stanu, doszło do zmiany władzy – obalony został prezydent Indonezji Sukarno, a jego miejsce zajął generał Suharto. Winą za wszczęcie puczu obarczono Indonezyjską Partię Komunistyczną (PKI), co stało się pretekstem dla masowych morderstw jej członków i zwolenników. Obiektem prześladowań byli także przedstawiciele mniejszości chińskiej w Indonezji, intelektualiści i członkowie związków zawodowych – każdy mógł zostać oskarżony o bycie „komunistą”. Ze względu na zimną wojnę likwidacja „komunistów” spotkała się z aprobatą państw zachodnich.","popularity":3.5031,"poster_path":"/sp5B7Tz5ttsgOLnIlCP5uEhtesI.jpg","release_date":"2012-11-08","softcore":false,"video":false,"vote_average":7.663,"vote_count":765,"credit_id":"53debab6c3a3686c5600189f","department":"Production","job":"Executive Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[99,10770,10402],"id":317305,"title":"Die Verwandlung der Welt in Musik: Bayreuth vor der Premiere","original_language":"de","original_title":"Die Verwandlung der Welt in Musik: Bayreuth vor der Premiere","overview":"","popularity":0.5241,"poster_path":"/hMl1rCbzGh5ua1RbQls5q5JrKMa.jpg","release_date":"1996-07-21","softcore":false,"video":false,"vote_average":8.333,"vote_count":3,"credit_id":"54b31aaa925141144f002cc7","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/mQMBpe4Xu3IMzLjcRulrrrgzLQN.jpg","genre_ids":[35,18],"id":896349,"title":"El Poso","original_language":"en","original_title":"El Poso","overview":"","popularity":1.1964,"poster_path":"/7oLRO3v7qivAsUbaD96cg9F8006.jpg","release_date":"2022-03-05","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"618b49006e0d72008ff5b2a6","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":1018248,"title":"Flores del precipicio","original_language":"es","original_title":"Flores del precipicio","overview":"","popularity":1.0911,"poster_path":"/A2y8qqJAcRw70zOuqhd4Xy84IpH.jpg","release_date":"2022-06-29","softcore":false,"video":false,"vote_average":5.0,"vote_count":1,"credit_id":"630c9991caa508007a5d56a4","department":"Production","job":"Producer"},{"adult":false,"backdrop_path":"/8XA4QIjWEliY6U0MfEMkK4F5XtH.jpg","genre_ids":[99],"id":45763,"title":"Herakles","original_language":"de","original_title":"Herakles","overview":"","popularity":0.6943,"poster_path":"/eocDtOQMPG4aVOFMxrrkVBCEMCi.jpg","release_date":"1962-01-01","softcore":false,"video":false,"vote_average":6.036,"vote_count":28,"credit_id":"5549cb95c3a3683