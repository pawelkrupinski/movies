hodzenia i mimiki. Do perfekcji opanowuje sztukę charakteryzacji. Kiedy któraś z osób wyjeżdża, włamuje się do jej domu i odgrywa jej rolę. Pewnego dnia wpada na sławnego muzyka, Henriego de Montalte’a, który go jednocześnie fascynuje i odpycha. Sébastien postanawia przejąć jego tożsamość....","popularity":1.3882,"poster_path":"/kfxbMGoE9aYys3pzyN7ovTeJqb8.jpg","release_date":"2014-11-19","softcore":false,"video":false,"vote_average":6.361,"vote_count":133,"character":"Sébastien Nicolas / Henri de Montalte","credit_id":"545d2180c3a3685362004303","order":0},{"adult":false,"backdrop_path":"/78KOWxJNXwTw9dGX9yg0CPgmxjx.jpg","genre_ids":[99],"id":595821,"title":"Michel Serrault, un clown en liberté","original_language":"fr","original_title":"Michel Serrault, un clown en liberté","overview":"","popularity":0.6172,"poster_path":"/z8oqYF40lRrOyVJzfPdc1NSxmmZ.jpg","release_date":"2015-06-04","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"character":"Self","credit_id":"6325d4507d41aa007a2c7038","order":6},{"adult":false,"backdrop_path":"/yEvgUV5jnuitFIvNvCMR0OgMqvd.jpg","genre_ids":[35,18,80],"id":999151,"title":"Les Rois de la piste","original_language":"fr","original_title":"Les Rois de la piste","overview":"","popularity":1.1316,"poster_path":"/m4EqcqQF3ATEjredi7GOUcE7ssM.jpg","release_date":"2024-03-13","softcore":false,"video":false,"vote_average":4.891,"vote_count":32,"character":"Sam Zimmerman","credit_id":"6327022353866e0085b0938a","order":1},{"adult":false,"backdrop_path":null,"genre_ids":[35],"id":460186,"title":"Elle voulait faire quelque chose","original_language":"fr","original_title":"Elle voulait faire quelque chose","overview":"","popularity":0.633,"poster_path":"/efGt3966P9ILwe7HhmBandHjKMe.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":10.0,"vote_count":1,"character":"","credit_id":"65a6a753a6ddcb0124c0e1de","order":1},{"adult":false,"backdrop_path":"/i2BnioSw9J1ZbQKowXLdgb95izn.jpg","genre_ids":[99],"id":4