{"cast":[{"adult":false,"backdrop_path":"/lILGmH0HWOXziENZIFcOdZTJIuh.jpg","genre_ids":[18],"id":198782,"title":"Żywot Mateusza","original_language":"pl","original_title":"Żywot Mateusza","overview":"Życie Mateusza burzy wiadomość o miłości jego siostry do innego mężczyzny.","popularity":0.7215,"poster_path":"/bLCcu3AfD7BZdHZKFeU4dg1LDGV.jpg","release_date":"1968-02-16","softcore":false,"video":false,"vote_average":6.125,"vote_count":11,"character":"Man in Car (uncredited)","credit_id":"662e9db0511d090121c54ddd","order":11}],"crew":[{"adult":false,"backdrop_path":"/zvc6VmC97aaUjYWwlEQCplsI33S.jpg","genre_ids":[18],"id":388776,"title":"Pełnia","original_language":"pl","original_title":"Pełnia","overview":"Bohaterem filmu jest Pan Wojtek, robiący karierę architekt, który ma dość wielkomiejskiego pędu i gwaru. Opuszcza, więc miasto i zaszywa się na prowincji. Do powrotu nie może namówić go ani przyjaciel z dawnych lat , ani żona , która w końcu otwarcie przyznaje, że łączy ją z Wojtkiem już tylko wspólne mieszkanie. Pan Wojtek twierdzi, że \"odbiera sobie zaległe urlopy\" , ma więc dużo czasu na przemyślenia nad dotychczasowym życiem - dokonuje analizy i wyciąga wnioski. Przyjaźń z miejscowymi, których problemy szczerze go interesują, a także włączenie się w rytm życia zgodnego z naturą, sprzyjają regeneracji sił i odnalezieniu zawieruszonych gdzieś wartości.","popularity":0.6114,"poster_path":"/zcMnWzUoc2Xn0JO6F4HwjRt95zX.jpg","release_date":"1979-11-13","softcore":false,"video":false,"vote_average":7.4,"vote_count":5,"credit_id":"620a88c338e51011efd7d425","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/hDvjpAXLAXjyB2z3KMU0JJs5fXj.jpg","genre_ids":[27,878],"id":96148,"title":"Człowiek, który wymyślił życie","original_language":"da","original_title":"Manden der tænkte ting","overview":"","popularity":0.9102,"poster_path":"/ssfbhkVQcgmuTdqLC7aUv3xo4hc.jpg","release_date":"1969-05-09","softcore":false,"video":false,"vote_average":6.524,"vote_count":21,"credit_id":"622231b87719d7006dab044e","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":"/1KPjTsAREBwmCXDbq2PdH8n5vjS.jpg","genre_ids":[35,18],"id":81231,"title":"Konopielka","original_language":"pl","original_title":"Konopielka","overview":"Akcja filmu toczy się w zapadłej wsi Taplary, gdzieś na Białostocczyźnie. Młody chłop - Kaziuk wyjeżdża rankiem do lasu po chrust na opał. Po powrocie zastaje w chałupie istną rewolucję. Przedwcześnie ocielona (co wskazuje na siły nieczyste) krowa, wędrowny dziad, nauczycielka i prelegent z miasta, który w dodatku wytyka jego rodzinie brak higieny, zabobonność i zacofanie. Nawołuje też do organizowania szkoły i budowy linii elektrycznej. Kaziuk niewiele z tego rozumie, ale pozostaje pod wrażeniem. Zwłaszcza apetycznej nauczycielki.","popularity":0.6903,"poster_path":"/cOzGlHBlvmEfCbDWdyjNmlP6E9Q.jpg","release_date":"1982-09-13","softcore":false,"video":false,"vote_average":6.714,"vote_count":35,"credit_id":"52fe48029251416c9107cfb1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":958175,"title":"Rekolekcje","original_language":"pl","original_title":"Rekolekcje","overview":"Historia dwóch talentów. Reżyser filmowy i kontrabasista spotykają się po latach by dokonać swoistego bilansu własnych osiągnięć.","popularity":0.2252,"poster_path":"/kwDxFMpNuSp2uDt0F7HLlvvBIy4.jpg","release_date":"1978-04-03","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"6288affed4d50911574d3f4c","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/lILGmH0HWOXziENZIFcOdZTJIuh.jpg","genre_ids":[18],"id":198782,"title":"Żywot Mateusza","original_language":"pl","original_title":"Żywot Mateusza","overview":"Życie Mateusza burzy wiadomość o miłości jego siostry do innego mężczyzny.","popularity":0.7215,"poster_path":"/bLCcu3AfD7BZdHZKFeU4dg1LDGV.jpg","release_date":"1968-02-16","softcore":false,"video":false,"vote_average":6.125,"vote_count":11,"credit_id":"52fe4d889251416c911197f3","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/ofplZMrZNnG8st00OK6HK94tzX1.jpg","genre_ids":[18],"id":270382,"title":"Siekierezada","original_language":"pl","original_title":"Siekierezada","overview":"Po rozstaniu z narzeczoną Janek Pradera zamieszkuje w bieszczadzkiej dziczy, gdzie zatrudnia się przy wyrębie lasu.","popularity":1.1052,"poster_path":"/7PlSOsRfKEQrIb4OBWGzTeXzEpN.jpg","release_date":"1986-10-13","softcore":false,"video":false,"vote_average":6.75,"vote_count":16,"credit_id":"53784b06c3a368553a0031a8","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kmWYVoOE72RJeR3yVj2VFRzWiRG.jpg","genre_ids":[18,10749,35],"id":897113,"title":"Kolos","original_language":"no","original_title":"Koloss","overview":"Dzieje Braga i Liv, pary głównych bohaterów, to przeniesiona w krainę lodowców i uwspółcześniona wersja losów Romea i Julii, Orfeusza i Eurydyki i innych tragicznych kochanków uwiecznionych w klasycznej literaturze.","popularity":0.3677,"poster_path":null,"release_date":"1993-09-24","softcore":false,"video":false,"vote_average":5.667,"vote_count":3,"credit_id":"618e295c63d9370029148319","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/kmWYVoOE72RJeR3yVj2VFRzWiRG.jpg","genre_ids":[18,10749,35],"id":897113,"title":"Kolos","original_language":"no","original_title":"Koloss","overview":"Dzieje Braga i Liv, pary głównych bohaterów, to przeniesiona w krainę lodowców i uwspółcześniona wersja losów Romea i Julii, Orfeusza i Eurydyki i innych tragicznych kochanków uwiecznionych w klasycznej literaturze.","popularity":0.3677,"poster_path":null,"release_date":"1993-09-24","softcore":false,"video":false,"vote_average":5.667,"vote_count":3,"credit_id":"618e297c63d937006071c7b3","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":897880,"title":"Requiem","original_language":"pl","original_title":"Requiem","overview":"Film według scenariusza Edwarda Redlińskiego, autora m.in. \"Konopielki\". Bohaterem obrazu jest Bartłomiej, gospodarz, który słynie z tego, że wygłasza wspaniałe mowy pogrzebowe. Cieszy się on we wsi ogromnym autorytetem. Pewnego dnia Bartłomiej stwierdza, że jest już za stary, aby wykonywać swoje obowiązki i rozpoczyna poszukiwania następcy.","popularity":2.1287,"poster_path":"/nLcc8axTYCwqBknP7o56vzUj1XI.jpg","release_date":"2001-10-12","softcore":false,"video":false,"vote_average":6.5,"vote_count":2,"credit_id":"619084becca7de0063312ffa","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":361364,"title":"Zabawa","original_language":"pl","original_title":"Zabawa","overview":"","popularity":1.2505,"poster_path":null,"release_date":"1961-09-25","softcore":false,"video":false,"vote_average":7.0,"vote_count":2,"credit_id":"5604f167c3a3685c490014f1","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[],"id":361362,"title":"Portrait of a Man with a Medallion","original_language":"en","original_title":"Portrait of a Man with a Medallion","overview":"","popularity":0.6192,"poster_path":"/mryEpy0JLapGUaaBoRDF4AqbPAV.jpg","release_date":"1959-09-25","softcore":false,"video":false,"vote_average":6.0,"vote_count":6,"credit_id":"5604f0d5c3a3685c4d001295","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":"/tVG2qQvJUfJjyOUgOxifitGAUFj.jpg","genre_ids":[18],"id":413351,"title":"Rewizja osobista","original_language":"pl","original_title":"Rewizja osobista","overview":"Barbara, jej kilkunastoletni syn Piotrek oraz kuzynka Krysia wracają do Polski zza zachodniej granicy. Ich auto jest wypełnione deficytowymi towarami, które chcą sprzedać z zyskiem w kraju. Zostają zatrzymani do kontroli celnej. Szef zmiany Roman to zimny służbista, zarządza rewizję osobistą kobiet, jednak będzie ona możliwa dopiero gdy na kolejnej zmianie dotrze celniczka. Szmuglerki są gotowe zrobić wiele, aby przedostać się na drugą stronę granicy.","popularity":0.5409,"poster_path":"/6NfV1EX1hgBNASf7dmOAh6U1sVA.jpg","release_date":"1973-03-20","softcore":false,"video":false,"vote_average":5.2,"vote_count":10,"credit_id":"57c4a17cc3a3681f3c00726c","department":"Directing","job":"Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":945609,"title":"Mansarda","original_language":"pl","original_title":"Mansarda","overview":"","popularity":0.6856,"poster_path":null,"release_date":"1963-09-27","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"65f35c2235818f0165d0f5c0","department":"Directing","job":"Assistant Director"},{"adult":false,"backdrop_path":"/lILGmH0HWOXziENZIFcOdZTJIuh.jpg","genre_ids":[18],"id":198782,"title":"Żywot Mateusza","original_language":"pl","original_title":"Żywot Mateusza","overview":"Życie Mateusza burzy wiadomość o miłości jego siostry do innego mężczyzny.","popularity":0.7215,"poster_path":"/bLCcu3AfD7BZdHZKFeU4dg1LDGV.jpg","release_date":"1968-02-16","softcore":false,"video":false,"vote_average":6.125,"vote_count":11,"credit_id":"662e9de80792e1012c7acfbc","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":"/xF3OA2jIAKq7kO1SBJlOeo9XYJ1.jpg","genre_ids":[18],"id":593900,"title":"Stary człowiek i pies","original_language":"pl","original_title":"Stary człowiek i pies","overview":"Robert to starzejący się filmowiec. Kiedyś był ceniony w środowisku, a swoje filmy pokazywał na największych festiwalach. Dziś, pozbawiony zawodowych kontaktów, nie potrafi odnaleźć się w nowej rzeczywistości. Rozwiedziony, żyje samotnie, zmagając się ze swoimi fobiami i topi smutki w alkoholu. Najlepszego przyjaciela ma w psie, którego uratował od śmierci. Pewnego dnia do Roberta nieoczekiwanie dzwoni jego była żona, która od dawna nie może się doczekać na przeszczep nerki. Wiadomość wyrywa mężczyznę z marazmu, w którym tkwił przez lata.","popularity":1.0337,"poster_path":"/mHFsjjYamtOkA8hBt58Ls0R2Xkl.jpg","release_date":"2008-11-20","softcore":false,"video":false,"vote_average":5.7,"vote_count":3,"credit_id":"665caecab670cfcb48106e87","department":"Writing","job":"Writer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":377684,"title":"Przygoda noworoczna","original_language":"pl","original_title":"Przygoda noworoczna","overview":"","popularity":1.1034,"poster_path":"/2ljbMIUGMnS0lbQlMBPhc7jfPVu.jpg","release_date":"1963-12-30","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"649c3875fd4f8000cb316eed","department":"Camera","job":"Camera Operator"},{"adult":false,"backdrop_path":null,"genre_ids":[18,35],"id":425277,"title":"Po sezonie","original_language":"pl","original_title":"Po sezonie","overview":"Tajemniczy mężczyzna odwiedza po sezonie mazurski pensjonat, gdzie nawiązuje bliższe relacje z trzema mieszkankami.","popularity":0.5003,"poster_path":"/dyoF9011M0BjZQFCEE0fosj8VAa.jpg","release_date":"2006-03-31","softcore":false,"video":false,"vote_average":5.75,"vote_count":6,"credit_id":"64c0054501757f011ca8d967","department":"Directing","job":"First Assistant Director"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":958175,"title":"Rekolekcje","original_language":"pl","original_title":"Rekolekcje","overview":"Historia dwóch talentów. Reżyser filmowy i kontrabasista spotykają się po latach by dokonać swoistego bilansu własnych osiągnięć.","popularity":0.2252,"poster_path":"/kwDxFMpNuSp2uDt0F7HLlvvBIy4.jpg","release_date":"1978-04-03","softcore":false,"video":false,"vote_average":9.0,"vote_count":1,"credit_id":"64cd2e0c1b157d00ad5a5ae0","department":"Writing","job":"Screenplay"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":958175,"title":"Rekolekcje","original_language":"pl","original_title":"Rekolekcje","overview":"Historia dwóch talentów. Reżyser filmowy i kontrabasista spotykają się po latach by dokonać swoistego bilansu własnych osiągnięć.","p