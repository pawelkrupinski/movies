ało\", jest sublimacja miłości. Bohaterowie zadają sobie pytanie, czy to samo serce może kochać jednocześnie Boga i człowieka.","popularity":2.1597,"poster_path":"/925jvw8j23efX9wf1VbMMyJigcG.jpg","release_date":"1995-10-27","softcore":false,"video":false,"vote_average":6.161,"vote_count":140,"credit_id":"645a55f577d23b015394a478","department":"Camera","job":"Still Photographer"},{"adult":false,"backdrop_path":null,"genre_ids":[18],"id":288088,"title":"Schauplätze","original_language":"de","original_title":"Schauplätze","overview":"","popularity":0.5561,"poster_path":"/AFj9SCoFATu3P9RlEJjWsxDvxo.jpg","release_date":"1967-01-02","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"645a4eb0fe077a5cac6c6e1c","department":"Camera","job":"Director of Photography"},{"adult":false,"backdrop_path":null,"genre_ids":[80,18],"id":161763,"title":"Alabama (2000 Light Years)","original_language":"de","original_title":"Alabama (2000 Light Years)","overview":"","popularity":0.9245,"poster_path":"/rg0QoMOfhibJ5paX51CGExyRztu.jpg","release_date":"1969-01-30","softcore":false,"video":false,"vote_average":6.25,"vote_count":4,"credit_id":"645a558b156cc700ffa808cc","department":"Sound","job":"Sound"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1124551,"title":"I Played It for You","original_language":"en","original_title":"I Played It for You","overview":"","popularity":0.5957,"poster_path":null,"release_date":"1985-05-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":1,"credit_id":"645a56496aa8e000ff5bc7a1","department":"Camera","job":"Additional Photography"},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":1124558,"title":"Nicholas Ray: Especially for Pierre","original_language":"en","original_title":"Nicholas Ray: Especially for Pierre","overview":"","popularity":0.3911,"poster_path":null,"release_date":"1979-05-01","softcore":false,"video":false,"vote_average":0.0,"vote_count":0,"credit_id":"645a56e13fe16001386709c9","