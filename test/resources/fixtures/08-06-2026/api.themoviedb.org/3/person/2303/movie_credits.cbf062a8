 momencie boleśnie odczuwalna staje się nieobecność producenta, który oddala się w nieznane zabierając ze sobą wszystkie przeznaczone na realizacje filmu pieniądze.... Stan rzeczy zawiera bardzo wyraźne wątki autobiograficzne. Wenders jednoznacznie nawiązuje do problemów, z jakimi borykał się podczas kręcenia swojego pierwszego amerykańskiego filmu Hammett.","popularity":1.3336,"poster_path":"/vB64asO8cEursipyjzCCBWTxEao.jpg","release_date":"1982-03-22","softcore":false,"video":false,"vote_average":6.41,"vote_count":83,"character":"Tram Passenger (uncredited)","credit_id":"5aa15983c3a368506300926f","order":20},{"adult":false,"backdrop_path":null,"genre_ids":[10402,99],"id":515171,"title":"Nick Cave: Straight To You - A Portrait","original_language":"en","original_title":"Nick Cave: Straight To You - A Portrait","overview":"","popularity":2.275,"poster_path":"/AoWOC0mxXtR69a9f61tEq6bNDpC.jpg","release_date":"1994-01-01","softcore":false,"video":false,"vote_average":7.0,"vote_count":2,"character":"Self","credit_id":"5abe7243c3a3684444013a7f","order":3},{"adult":false,"backdrop_path":"/jSeFQ84QTCu3y6W3U9O4MQJ3EcS.jpg","genre_ids":[99],"id":440202,"title":"The Trial: The State of Russia vs Oleg Sentsov","original_language":"en","original_title":"The Trial: The State of Russia vs Oleg Sentsov","overview":"","popularity":0.8477,"poster_path":"/c4NXsbcsfbGpKEHQM9pHIBjhAZ4.jpg","release_date":"2017-04-06","softcore":false,"video":false,"vote_average":3.429,"vote_count":7,"character":"Self","credit_id":"5b0bb2889251411e290116e1","order":3},{"adult":false,"backdrop_path":null,"genre_ids":[99],"id":539178,"title":"Living the Light: Robby Müller","original_language":"en","original_title":"Living the Light: Robby Müller","overview":"","popularity":0.9179,"poster_path":"/fliNv1Q5ENPwIJvpqPSt7CMs1wO.jpg","release_date":"2018-09-20","softcore":false,"video":false,"vote_average":6.7,"vote_count":6,"character":"Self","credit_id":"5b5f2bf30e0a262e9204b6d7","order":1},{"adult":false,"b