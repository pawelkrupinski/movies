{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":16,"name":"Animacja"},{"id":10751,"name":"Familijny"}],"homepage":"https://dystrybucja.mlodehoryzonty.pl/film/pucio-kocha-zwierzaki/","id":1731848,"imdb_id":null,"origin_country":["PL"],"original_language":"pl","original_title":"Pucio kocha zwierzaki","overview":"U Pucia jak zwykle dużo się dzieje. Spędza wakacje u dziadków na wsi i sadzi swoje pierwsze drzewo, a podczas spaceru w parku rusza z Misią na misję ratunkową, by odnaleźć psa sąsiada. Kiedy ich własny, ukochany Funio gorzej się czuje, rodzeństwo robi, co w ich mocy, by poprawić mu humor. Wygląda jednak na to, że czas odwiedzić weterynarza! Emocji nie zabraknie również w przedszkolu: Pucio pomoże nowej koleżance Malinie odnaleźć się w grupie i razem z kolegami odkryje, że nie trzeba tańczyć idealnie – liczy się wyobraźnia i radość z bycia razem.","popularity":1.4487,"poster_path":"/kHYBDgJk4e0FueP0ZRTWMqbSmf0.jpg","production_companies":[{"id":129928,"logo_path":"/55xk2bQk4JRJwjYW9GNrcE9lrRZ.png","name":"EGoFILM","origin_country":"PL"},{"id":297202,"logo_path":null,"name":"Paris Hendzel Studio","origin_country":"PL"},{"id":250,"logo_path":"/evWKasiElVQywuKv2dI72P9twz8.png","name":"CANAL+ Polska","origin_country":"PL"}],"production_countries":[{"iso_3166_1":"PL","name":"Poland"}],"release_date":"2026-08-21","revenue":0,"runtime":45,"softcore":false,"spoken_languages":[{"english_name":"Polish","iso_639_1":"pl","name":"Polski"}],"status":"Post Production","tagline":"","title":"Pucio kocha zwierzaki","video":false,"vote_average":0.0,"vote_count":0,"credits":{"cast":[{"adult":false,"gender":1,"id":1275759,"known_for_department":"Acting","name":"Joanna Pach","original_name":"Joanna Pach","popularity":0.4194,"profile_path":"/yHX6KZ4dffcf69ei98nyT6QWxip.jpg","cast_id":26,"character":"Pucio (voice)","credit_id":"6a574bfe2c4e9e0782050aff","order":0},{"adult":false,"gender":0,"id":4374591,"known_for_department":"Acting","name":