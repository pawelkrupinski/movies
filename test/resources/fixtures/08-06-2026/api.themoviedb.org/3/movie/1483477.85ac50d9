{"adult":false,"backdrop_path":"/ryet6I5rQHwfxyoSuV97FBWnq0H.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":18,"name":"Drama"},{"id":53,"name":"Thriller"}],"homepage":"","id":1483477,"imdb_id":"tt28149522","origin_country":["CZ"],"original_language":"cs","original_title":"Sbormistr","overview":"It’s the early 1990s and 13-year-old Valerie, a gifted novice singer, is given the chance to become a member of a world-famous girls’ choir, taking her place alongside her older sister and her other rivals in the ensemble. Everything points to the fact that Valerie’s exceptional talent has caught the attention of the formidable and much admired choirmaster. This highly anticipated psychological drama calls to mind not only the notorious case of Bambini di Praga, but also other devastating situations involving the clash of innocence and abusive authority.","popularity":1.5753,"poster_path":"/zNYlzUhNMBaufzRcmPkEMvJFKud.jpg","production_companies":[{"id":125447,"logo_path":"/voAURC6BQhfkHflZKroeqoC89U6.png","name":"CinemArt","origin_country":"SK"},{"id":135055,"logo_path":"/tKt1JXrVO7B5O6MXe0g8yeoFPxa.png","name":"Sumerian Pictures","origin_country":"US"}],"production_countries":[{"iso_3166_1":"CZ","name":"Czech Republic"},{"iso_3166_1":"SK","name":"Slovakia"}],"release_date":"2025-07-10","revenue":0,"runtime":104,"softcore":false,"spoken_languages":[{"english_name":"Czech","iso_639_1":"cs","name":"Český"},{"english_name":"Slovak","iso_639_1":"sk","name":"Slovenčina"}],"status":"Released","tagline":"","title":"Broken Voices","video":false,"vote_average":6.545,"vote_count":22,"alternative_titles":{"titles":[{"iso_3166_1":"LT","title":"Palaužti balsai","type":""},{"iso_3166_1":"ES","title":"Las chicas de Praga","type":""}]}}