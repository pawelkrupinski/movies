{"adult":false,"backdrop_path":"/vdEBPtIH2NtD1ddVNuxm7DbG3Ab.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":36,"name":"History"},{"id":53,"name":"Thriller"},{"id":10752,"name":"War"}],"homepage":"","id":1306884,"imdb_id":"tt32869207","origin_country":["PL"],"original_language":"pl","original_title":"Pojedynek","overview":"The year is 1939. The world is falling into chaos. Thousands of Poles, held by the Russians in a former monastery, are subjected to brutal indoctrination. An ambitious enemy agent makes it a point of honour to break the resistance of one of them. He is a young, world-famous pianist, respected by his fellow prisoners. His capitulation may result in winning many others over to the enemy's side. An insidious game begins, full of sophisticated manipulation, threats and promises. Can the young artist, a loving father and husband, win a duel with an agent backed by the power and perfidy of the Russian system?","popularity":2.0832,"poster_path":"/hbkGSbaH5stix008VRYQBBUYwhQ.jpg","production_companies":[{"id":121447,"logo_path":null,"name":"Bow and Axe Entertainment","origin_country":"PL"},{"id":11571,"logo_path":"/n9qAZ1tqsVq1OW29dL0waFW4pV8.png","name":"Samson Films","origin_country":"IE"},{"id":89929,"logo_path":"/xzAUuSdYU86wm0jwUxB7JIGj1ll.png","name":"Solar Media Entertainment","origin_country":"UA"},{"id":119491,"logo_path":null,"name":"Filmoteka Narodowa – Instytut Audiowizualny","origin_country":"PL"},{"id":121048,"logo_path":null,"name":"Wojewódzki Dom Kultury w Rzeszowie","origin_country":"PL"},{"id":61460,"logo_path":"/3yPCkEWvnabeiF8l3sjUBHlRq0j.png","name":"Ukrainian State Film Agency","origin_country":"UA"}],"production_countries":[{"iso_3166_1":"PL","name":"Poland"},{"iso_3166_1":"IE","name":"Ireland"},{"iso_3166_1":"UA","name":"Ukraine"},{"iso_3166_1":"CY","name":"Cyprus"}],"release_date":"2026-02-27","revenue":0,"runtime":113,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"},{"