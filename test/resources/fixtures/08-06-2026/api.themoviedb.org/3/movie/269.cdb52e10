{"adult":false,"backdrop_path":"/4WGuyWf1f94CsEeVIIqDKGw5rmO.jpg","belongs_to_collection":null,"budget":80000,"genres":[{"id":18,"name":"Dramat"},{"id":80,"name":"Kryminał"},{"id":10749,"name":"Romans"}],"homepage":"https://pastperfect.com.pl/do-utraty-tchu/","id":269,"imdb_id":"tt0053472","origin_country":["FR"],"original_language":"fr","original_title":"À bout de souffle","overview":"Michel, zbuntowany młody mężczyzna uciekając skradzionym samochodem zabija policjanta. Zdaje sobie sprawę, że za kilka godzin będzie ścigany przez policję całego kraju. Przybywa więc do Paryża, by odebrać od dłużnika pieniądze, które pomogłyby mu w ucieczce za granicę. Do wyjazdu namawia także piękną Amerykankę, z którą łączy go niesprecyzowane uczucie. Sprawy zaczynają się komplikować, gdy okazuje się, że dłużnik zniknął. Michel pozbawiony możliwości ucieczki, czuje się coraz bardziej osaczony.","popularity":5.0915,"poster_path":"/h9TfhwNJuqyci2AXxr4O8dizsDt.jpg","production_companies":[{"id":10906,"logo_path":null,"name":"Les Films Impéria","origin_country":"FR"},{"id":10907,"logo_path":null,"name":"Les Productions Georges de Beauregard","origin_country":"FR"},{"id":16670,"logo_path":null,"name":"SNC","origin_country":"FR"}],"production_countries":[{"iso_3166_1":"FR","name":"France"}],"release_date":"1960-03-16","revenue":0,"runtime":90,"softcore":false,"spoken_languages":[{"english_name":"French","iso_639_1":"fr","name":"Français"},{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Do utraty tchu","video":false,"vote_average":7.478,"vote_count":2062,"credits":{"cast":[{"adult":false,"gender":2,"id":3829,"known_for_department":"Acting","name":"Jean-Paul Belmondo","original_name":"Jean-Paul Belmondo","popularity":1.7199,"profile_path":"/wTofz0bBIO7kKXATnZNNBF3Jxle.jpg","cast_id":6,"character":"Michel Poiccard / László Kovács","credit_id":"52fe4230c3a36847f800aa9d","order":0},{"adult":false,"gender":1,"id":3830,"known_for_department