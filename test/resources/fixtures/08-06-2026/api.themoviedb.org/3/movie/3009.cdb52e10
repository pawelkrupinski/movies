{"adult":false,"backdrop_path":"/yhfHeIsR5Ki02b5SqBuLqAsLDCk.jpg","belongs_to_collection":null,"budget":1300000,"genres":[{"id":80,"name":"Kryminał"},{"id":18,"name":"Dramat"},{"id":9648,"name":"Tajemnica"}],"homepage":"","id":3009,"imdb_id":"tt0057427","origin_country":["US"],"original_language":"en","original_title":"Le Procès","overview":"Adaptacja najsłynniejszej powieści czeskiego pisarza Franza Kafki zrealizowana przez Orsona Wellesa, twórcę słynnego filmu \"Obywatel Kane\". Józef K. To zwykły urzędnik, który zostaje uwikłany w dość nietypową sytuację. Pewnego dnia znajduje policję w swym mieszkaniu, która informuje go, że został wytoczony przeciwko niemu proces. Nikt jednak nie potrafi mu wyjaśnić dlaczego. Mimo usilnych starań, by udowodnić swą niewinność, nie udaje się Józefowi K. uciec od egzekucji.","popularity":3.4147,"poster_path":"/emyqy7vAUQCIsM0Z0u8vgmrEORv.jpg","production_companies":[{"id":1284,"logo_path":null,"name":"Hisa-Film","origin_country":""},{"id":1283,"logo_path":null,"name":"Paris-Europa Productions","origin_country":"FR"},{"id":73426,"logo_path":null,"name":"Finanziaria Cinematografica Italiana (FICIT)","origin_country":"IT"}],"production_countries":[{"iso_3166_1":"FR","name":"France"},{"iso_3166_1":"DE","name":"Germany"},{"iso_3166_1":"IT","name":"Italy"}],"release_date":"1962-08-25","revenue":94243,"runtime":119,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Proces","video":false,"vote_average":7.37,"vote_count":571,"credits":{"cast":[{"adult":false,"gender":2,"id":7301,"known_for_department":"Acting","name":"Anthony Perkins","original_name":"Anthony Perkins","popularity":2.2997,"profile_path":"/7FipKwmg2woHNvt5ATeXLBirHXs.jpg","cast_id":9,"character":"Josef K.","credit_id":"52fe437cc3a36847f805793f","order":0},{"adult":false,"gender":1,"id":6250,"known_for_department":"Acting","name":"Romy Schneider","original_name":"Romy Schneider","popular