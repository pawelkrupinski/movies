{"adult":false,"backdrop_path":"/i9VdeldLIQECp9zlcbVMaR3ewHM.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":18,"name":"Dramat"}],"homepage":"","id":217247,"imdb_id":"tt0085451","origin_country":["PL"],"original_language":"pl","original_title":"Dolina Issy","overview":"Akcja filmu toczy się na Litwie pod koniec lat dziesiątych XX wieku, w dolinie na pół mitycznej rzeki Issy. Osią fabularną utworu są losy żyjących tam ludzi - historia małego chłopca Tomaszka, tragicznego w skutkach romansu miejscowego księdza i jego gosposi, nieodwzajemnionej miłości pokojówki Barbarki do swojego pana, postępującego szaleństwa leśnika Baltazara, którego egzystencjalne niepokoje doprowadzają do obłędu i zbrodni. Świat żywych przenika się ze światem zmarłych, a dziejom poszczególnych bohaterów towarzyszą znane z litewskich legend diabły i demony.","popularity":0.637,"poster_path":"/yWoDKAmYA9edp7PZFy9I1Yh8I8k.jpg","production_companies":[{"id":2552,"logo_path":null,"name":"Zespół Filmowy \"Perspektywa\"","origin_country":"PL"}],"production_countries":[{"iso_3166_1":"PL","name":"Poland"}],"release_date":"1982-09-20","revenue":0,"runtime":102,"softcore":false,"spoken_languages":[{"english_name":"Polish","iso_639_1":"pl","name":"Polski"}],"status":"Released","tagline":"","title":"Dolina Issy","video":false,"vote_average":6.5,"vote_count":6,"credits":{"cast":[{"adult":false,"gender":1,"id":591271,"known_for_department":"Acting","name":"Anna Dymna","original_name":"Anna Dymna","popularity":0.7894,"profile_path":"/nRp409YU55XKSG5vjWgFd0QEK9w.jpg","cast_id":5,"character":"Magdalena, gospodyni księdza Peikswy","credit_id":"600249ab719aeb003e44645a","order":0},{"adult":false,"gender":1,"id":1385,"known_for_department":"Acting","name":"Maria Pakulnis","original_name":"Maria Pakulnis","popularity":0.6584,"profile_path":"/ofUBgXCzbSa9ferpAINvSYgXEF8.jpg","cast_id":6,"character":"Barbarka, służąca Romualda","credit_id":"600249b17f0540003faba492","order":1},{"adult":false,"gender":1,"id