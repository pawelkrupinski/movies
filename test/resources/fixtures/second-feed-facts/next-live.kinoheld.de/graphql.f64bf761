mAge":12},"productionCountries":[],"genres":[{"name":"Drama"},{"name":"Science Fiction"},{"name":"Fantasy"},{"name":"Thriller"},{"name":"Trickfilm"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/paprika-114973.v17935492209180.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=PIUqozzyW2k"}]}},{"name":"CinemAperitivo: Visioni Sarde 2026","beginning":"2026-11-08T16:00:00+01:00","urlSlug":"64399","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1574883","title":"CinemAperitivo: Visioni Sarde 2026","titleOriginal":null,"urlSlug":"cinemaperitivo-visioni-sarde-2026","duration":82,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"CinemAperitivo: Visioni Sarde 2026","beginning":"2026-11-08T16:00:00+01:00","urlSlug":"64534","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1574883","title":"CinemAperitivo: Visioni Sarde 2026","titleOriginal":null,"urlSlug":"cinemaperitivo-visioni-sarde-2026","duration":82,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Life Support","beginning":"2026-11-08T17:45:00+01:00","urlSlug":"64478","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577209","title":"Life Support","titleOriginal":"Life Support","urlSlug":"life-support","duration":130,"productionYear":null,"description":"Seit Oktober 2023 ist der Gazastreifen weitgehend von der Au\u00dfenwelt abgeschnitten. Internationale \u00c4rztinnen und \u00c4rzte gelangen dennoch in das Gebiet, um Verletzte zu versorgen. Der Dokumentarfilm begleitet ihre Arbeit und l\u00e4sst sie von ihren Erfahrungen berichten. In besch\u00e4digten Krankenh\u00e4usern m\u00fcssen sie mit knappen Vorr\u00e4ten auskommen, w\u00e4hrend immer neue Patientinnen und Patienten eintreffen. Ihre Berichte und Aufnahmen zeigen den Alltag der medizinischen Versorgung unter diesen Bedingungen und geben Einblick in die Lage der Menschen, die auf Hilfe angewiesen sind.","contentRating":null,"productionCountries":[],"genres":[{"name":"Dokumentarfilm"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/combichrist-support-101837.v17805506844230.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ftJGJjsB6kk"}]}},{"name":"Metropolis LIVE Babylon Orchester Berlin","beginning":"2026-11-08T18:00:00+01:00","urlSlug":"63968","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1439397","title":"Metropolis LIVE Babylon Orchester Berlin","titleOriginal":"Metropolis","urlSlug":"metropolis-live-babylon-orchester-berlin","duration":153,"productionYear":null,"description":"Wie kein anderer Film repr\u00e4sentiert METROPOLIS die Bl\u00fcte des deutschen Stummfilms made in Berlin \u2013 Babelsberg. Die Elektrizit\u00e4t brachte die Dinge in Bewegung, brachte die N\u00e4chte und den Asphalt zum Leuchten. Der Motor trieb das Automobil und das Aeroplan, mit dem Fahrstuhl wuchsen die Wolkenkratzer. Durch den Kinematographen wurde die Vision \/ Illusion einer zuk\u00fcnftigen Metropole an die wei\u00dfen W\u00e4nde der Kinopal\u00e4ste geworfen und das Volk stieg aus den Katakomben empor und forderte seinen gerechten Anteil. Eine neue \u00c4ra war geboren und wird durch das Babylon Orchester Berlin im 1929 gebauten Babylon in altem\/neuen Glanz auf der Gold umrahmten Leinwand zum Leben erweckt.<br>\r\nEine mitrei\u00dfende Zeitreise in die Vergangenheit, eine mitrei\u00dfende Zeitreise in die Zukunft.\r\n<br><br>\r\nLike no other film, METROPOLIS represents the heyday of the German silent film made in Berlin - Babelsberg. Electricity got things moving, lighting up the nights and the asphalt.<br> \r\nThe engine drove the car and the airplane, and the lift grew the skyscrapers. The cinematograph threw the vision \/ illusion of a future metropolis on the white walls of the cinema palaces and the people rose from the catacombs and demanded his fair share. A new era was born and is brought to life on the gold-framed canvas by the Babylon Orchestra Berlin in Babylon, built in 1929 in old \/ new splendor.\r\n","contentRating":{"minimumAge":6},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/metropolis-live-babylon-orchester-berlin-22851.v2.jpg"},"trailers":[]}},{"name":"The Answering Machine","beginning":"2026-11-08T18:00:00+01:00","urlSlug":"64174","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1559523","title":"The Answering Machine","titleOriginal":null,"urlSlug":"the-answering-machine","duration":90,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Clockwork Kubrick: Eyes Wide Shut","beginning":"2026-11-08T19:45:00+01:00","urlSlug":"64535","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577205","title":"Clockwork Kubrick: Eyes Wide Shut","titleOriginal":null,"urlSlug":"clockwork-kubrick-eyes-wide-shut","duration":159,"productionYear":null,"description":null,"contentRating":{"minimumAge":16},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Clockwork Kubrick: Barry Lyndon","beginning":"2026-11-08T20:15:00+01:00","urlSlug":"64536","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577193","title":"Clockwork Kubrick: Barry Lyndon","titleOriginal":null,"urlSlug":"clockwork-kubrick-barry-lyndon","duration":185,"productionYear":null,"description":null,"contentRating":{"minimumAge":12},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Akira","beginning":"2026-11-09T17:00:00+01:00","urlSlug":"64537","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579387","title":"Akira","titleOriginal":"AKIRA","urlSlug":"akira","duration":124,"productionYear":null,"description":"Zeichentrickfilm f\u00fcr \"Erwachsene\". Film-Lexikon:\"Jugendliche Motorradfans geraten im Neo-Tokyo des Jahres 2019 in Kontakt mit parapsychologischen Milit\u00e4r-Experimenten. Einer von ihnen wird zum Tr\u00e4ger \u00fcbernat\u00fcrlicher Zerst\u00f6rungskr\u00e4fte, mit denen er die Existenz der Stadt bedroht. Monumentaler Zeichentrick-Actionfilm mit pseudo-philosophischem Unterton; formal beachtlich, inhaltlich belanglos, teilweise \u00e4rgerlich.\"","contentRating":{"minimumAge":16},"productionCountries":[{"name":"Japan"}],"genres":[{"name":"Animation"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/akira-14595.v2.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=nA8KmHC2Z-g"}]}},{"name":"Mulholland Drive","beginning":"2026-11-09T17:15:00+01:00","urlSlug":"64538","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579389","title":"Mulholland Drive","titleOriginal":"Mulholland Drive","urlSlug":"mulholland-drive","duration":145,"productionYear":null,"description":"F\u00fcr manche der Klassiker des 21. Jahrhunderts, f\u00fcr uns der beste Auftakt. Es f\u00e4ngt scheinbar konventionell an: ein Autounfall in Hollywood, attraktive Schauspielerinnen, spektakul\u00e4re Sets, die Schattenseiten des Filmgesch\u00e4fts. Doch an die Stelle einer konventionellen Geschichte treten unaufhaltsame Spannung, ein \"halluzinatorischer Angriff auf die Sinne\": Licht, Dinge, Farben, Bewegung, Zeit, Sound nehmen ein unheimliches Eigenleben an und ziehen die Zuschauer sogartig in den Film. Auch nach dem Film kann man sich kaum von den Bildern befreien - wie nach einem (Alb-)Traum.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Drama"},{"name":"Thriller"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/mulholland-drive-110743.v17909040199202.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=URYHCINrUKI"}]}},{"name":"Becoming Kim","beginning":"2026-11-09T17:45:00+01:00","urlSlug":"64539","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579381","title":"Becoming Kim","titleOriginal":"\ube44\ucee4\ubc0d \ud0b4","urlSlug":"becoming-kim","duration":90,"productionYear":null,"description":"Die deutsche Filmemacherin Susanne, verheiratet mit Jeong Rae Kim, einem Koreaner, richtet die Kamera mit Humor und Z\u00e4rtlichkeit auf ihre eigene interkulturelle Ehe und Familie. W\u00e4hrend sie mit den Rollen als Ehefrau, Mutter und K\u00fcnstlerin jongliert, inszeniert sie humorvolle und poetische Performances \u2013 leise Akte der Rebellion, die ihren Gef\u00fchlen und ihrer inneren Welt Ausdruck verleihen.\r\nIn einem Mix aus Beobachtungen und inszenierten Momenten taucht der Film in das Chaos von Liebe, Identit\u00e4t und kulturellem Aufeinanderprallen ein.\r\n\u200bZugleich zutiefst pers\u00f6nlich und universell stellt Becoming Kim die Frage: Wie bleiben wir uns selbst treu \u2013 und lernen gleichzeitig, einen anderen Menschen zu lieben?","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"},{"name":"South Korea"}],"genres":[{"name":"Dokumentation"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/becoming-kim-103143.v17822958143809.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=QAch8J034kw"}]}},{"name":"Der Himmel \u00fcber Berlin","beginning":"2026-11-09T19:30:00+01:00","urlSlug":"64540","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1575039","title":"Der Himmel \u00fcber Berlin","titleOriginal":"Der Himmel \u00fcber Berlin","urlSlug":"der-himmel-uber-berlin","duration":128,"productionYear":null,"description":"Damiel ist ein Engel. Und gemeinsam mit seinem himmlischen Kollegen Cassiel wandert er durch das geteilte Berlin und wacht \u00fcber die Menschen. Doch als Engel bleibt Damiel der menschlichen Welt verborgen. Er kann sie nur beobachten und ihren Gedanken lauschen, mitf\u00fchlen und miterleben kann er ihre Empfindungen nicht. Als er sich eines Tages in die zauberhafte Trapezk\u00fcnstlerin Marion verliebt, beschlie\u00dft er, selbst ein Mensch zu werden. Doch daf\u00fcr muss er ein gro\u00dfes Opfer bringen: seine Unsterblichkeit.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"},{"name":"France"}],"genres":[{"name":"Drama"},{"name":"Fantasy"},{"name":"Lovestory"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/4\/der-himmel-ueber-berlin-9307.v17404442441011.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_Zih4o6NLCc"}]}},{"name":"IndoGerman Film: Scene","beginning":"2026-11-09T19:30:00+01:00","urlSlug":"64541","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1575969","title":"IndoGerman Film: Scene","titleOriginal":null,"urlSlug":"indogerman-film-scene","duration":160,"productionYear":null,"description":null,"contentRating":{"minimumAge":12},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Clockwork Kubrick: The Shining","beginning":"2026-11-09T20:00:00+01:00","urlSlug":"64542","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579391","title":"Clockwork Kubrick: The Shining","titleOriginal":null,"urlSlug":"clockwork-kubrick-the-shining","duration":119,"productionYear":null,"description":null,"contentRating":{"minimumAge":16},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Clockwork Kubrick: Barry Lyndon","beginning":"2026-11-09T22:00:00+01:00","urlSlug":"64543","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577193","title":"Clockwork Kubrick: Barry Lyndon","titleOriginal":null,"urlSlug":"clockwork-kubrick-barry-lyndon","duration":185,"productionYear":null,"description":null,"contentRating":{"minimumAge":12},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Clockwork Kubrick: 2001: A Space Odyssey","beginning":"2026-11-09T22:15:00+01:00","urlSlug":"64544","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577201","title":"Clockwork Kubrick: 2001: A Space Odyssey","titleOriginal":null,"urlSlug":"clockwork-kubrick-2001-a-space-odyssey","duration":147,"productionYear":null,"description":null,"contentRating":{"minimumAge":12},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Blue Velvet","beginning":"2026-11-09T22:30:00+01:00","urlSlug":"64545","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579393","title":"Blue Velvet","titleOriginal":"Blue Velvet","urlSlug":"blue-velvet","duration":120,"productionYear":null,"description":"Der junge Jeffrey l\u00e4sst sich auf eine sado-masochistische Beziehung mit einer Nachtclubs\u00e4ngerin ein, die von einem Perversen missbraucht und erpresst wird. (sir)","contentRating":{"minimumAge":18},"productionCountries":[],"genres":[{"name":"Thriller"},{"name":"Krimi"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/blue-velvet-110745.v17935492506388.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ZGrAKOjJ1kk"}]}},{"name":"Akira","beginning":"2026-11-10T17:30:00+01:00","urlSlug":"64546","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579387","title":"Akira","titleOriginal":"AKIRA","urlSlug":"akira","duration":124,"productionYear":null,"description":"Zeichentrickfilm f\u00fcr \"Erwachsene\". Film-Lexikon:\"Jugendliche Motorradfans geraten im Neo-Tokyo des Jahres 2019 in Kontakt mit parapsychologischen Milit\u00e4r-Experimenten. Einer von ihnen wird zum Tr\u00e4ger \u00fcbernat\u00fcrlicher Zerst\u00f6rungskr\u00e4fte, mit denen er die Existenz der Stadt bedroht. Monumentaler Zeichentrick-Actionfilm mit pseudo-philosophischem Unterton; formal beachtlich, inhaltlich belanglos, teilweise \u00e4rgerlich.\"","contentRating":{"minimumAge":16},"productionCountries":[{"name":"Japan"}],"genres":[{"name":"Animation"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/akira-14595.v2.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=nA8KmHC2Z-g"}]}},{"name":"Ghost in the Shell","beginning":"2026-11-10T18:15:00+01:00","urlSlug":"64547","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579365","title":"Ghost in the Shell","titleOriginal":"Ghost in the Shell","urlSlug":"ghost-in-the-shell","duration":83,"productionYear":null,"description":"Die mehrfach Golden-Globe\u00ae-nominierte \"Sexiest Woman Alive 2006\" Scarlett Johansson (\"Avengers: Age Of Ultron\", \"Lucy\") ist in der Hauptrolle als \"Major\"- zu sehen - ein einzigartiger Hybrid aus Mensch und Cyborg und Anf\u00fchrerin des Elitekommandos Sektion 9. Bei ihrem Kampf gegen die gef\u00e4hrlichsten Kriminellen und Extremisten der Zukunft trifft die Sektion 9 auf einen neuen Gegner, dessen erkl\u00e4rtes Ziel die komplette Zerst\u00f6rung der Cyber-Technologien von Hanka Robotic ist. (Quelle: Verleiher)","contentRating":{"minimumAge":16},"productionCountries":[{"name":"Germany"},{"name":"United Kingdom"},{"name":"Japan"},{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/ghost-in-the-shell-5422.v17909041296396.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=quTsp1-QWmM"}]}},{"name":"The Rocky Horror Picture Show","beginning":"2026-11-10T19:30:00+01:00","urlSlug":"64513","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1534521","title":"The Rocky Horror Picture Show","titleOriginal":"The Rocky Horror Picture Show","urlSlug":"the-rocky-horror-picture-show","duration":96,"productionYear":null,"description":"Nach einer Autopanne suchen Brad und Janet Hilfe in einem abgelegenen Schloss. Statt eines Telefons erwartet sie dort Dr. Frank-N-Furter, der gerade einen k\u00fcnstlichen Menschen namens Rocky erschaffen hat. F\u00fcr das junge Paar wird der Aufenthalt zu einer Begegnung mit einer Welt, deren Regeln sie nicht kennen. Musik, ungew\u00f6hnliche G\u00e4ste und sexuelle Verwirrungen bestimmen die Nacht. Brad und Janet m\u00fcssen sich erst einmal zurechtfinden, w\u00e4hrend um sie herum die Feierlichkeiten ihren Lauf nehmen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Science Fiction"},{"name":"Fantasy"},{"name":"Horror"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-rocky-horror-picture-show-76947.v17523630411855.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ldo_spDyLKc"}]}},{"name":"The Answering Machine","beginning":"2026-11-10T20:00:00+01:00","urlSlug":"64175","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1559523","title":"The Answering Machine","titleOriginal":null,"urlSlug":"the-answering-machine","duration":90,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Life Support","beginning":"2026-11-10T20:00:00+01:00","urlSlug":"64479","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1577209","title":"Life Support","titleOriginal":"Life Support","urlSlug":"life-support","duration":130,"productionYear":null,"description":"Seit Oktober 2023 ist der Gazastreifen weitgehend von der Au\u00dfenwelt abgeschnitten. Internationale \u00c4rztinnen und \u00c4rzte gelangen dennoch in das Gebiet, um Verletzte zu versorgen. Der Dokumentarfilm begleitet ihre Arbeit und l\u00e4sst sie von ihren Erfahrungen berichten. In besch\u00e4digten Krankenh\u00e4usern m\u00fcssen sie mit knappen Vorr\u00e4ten auskommen, w\u00e4hrend immer neue Patientinnen und Patienten eintreffen. Ihre Berichte und Aufnahmen zeigen den Alltag der medizinischen Versorgung unter diesen Bedingungen und geben Einblick in die Lage der Menschen, die auf Hilfe angewiesen sind.","contentRating":null,"productionCountries":[],"genres":[{"name":"Dokumentarfilm"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/combichrist-support-101837.v17805506844230.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ftJGJjsB6kk"}]}},{"name":"Lost Highway","beginning":"2026-11-10T21:45:00+01:00","urlSlug":"64548","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579395","title":"Lost Highway","titleOriginal":"Lost Highway","urlSlug":"lost-highway","duration":135,"productionYear":null,"description":"Jazzmusiker Fred Madison findet vor seiner Haust\u00fcr ein Video. Darauf ist eine Aufnahme des eigenen Hauses zu sehen. Als er am n\u00e4chsten Tag eine weitere Aufnahme findet, die ihn und seine Frau Ren\u00e9e schlafend zeigt, schaltet Fred die Polizei ein. Auf einer Party trifft Fred auf einen mysteri\u00f6sen Mann, der ihm sagt, er sei gerade in dem Moment, in dem er mit ihm spricht, in seinem Haus.  Fred Madison soll seine Frau brutal ermordet haben und landet daf\u00fcr in der Todeszelle. Eines Morgens sitzt dort jedoch nicht mehr Fred, sondern der unbescholtene Mechaniker Pete ...","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/lost-highway-110747.v17909042811820.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ijsEiMGdljE"}]}},{"name":"Blue Velvet","beginning":"2026-11-10T22:30:00+01:00","urlSlug":"64549","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579393","title":"Blue Velvet","titleOriginal":"Blue Velvet","urlSlug":"blue-velvet","duration":120,"productionYear":null,"description":"Der junge Jeffrey l\u00e4sst sich auf eine sado-masochistische Beziehung mit einer Nachtclubs\u00e4ngerin ein, die von einem Perversen missbraucht und erpresst wird. (sir)","contentRating":{"minimumAge":18},"productionCountries":[],"genres":[{"name":"Thriller"},{"name":"Krimi"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/blue-velvet-110745.v17935492506388.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ZGrAKOjJ1kk"}]}},{"name":"Twin Peaks: Fire Walk with Me","beginning":"2026-11-10T22:30:00+01:00","urlSlug":"64550","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579397","title":"Twin Peaks: Fire Walk with Me","titleOriginal":null,"urlSlug":"twin-peaks-fire-walk-with-me","duration":129,"productionYear":null,"description":null,"contentRating":{"minimumAge":16},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Kinderwagenkino: L\u00fcgen \u00fcber meine Mutter","beginning":"2026-11-11T11:00:00+01:00","urlSlug":"64551","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579399","title":"Kinderwagenkino: L\u00fcgen \u00fcber meine Mutter","titleOriginal":null,"urlSlug":"kinderwagenkino-lugen-uber-meine-mutter","duration":106,"productionYear":null,"description":null,"contentRating":{"minimumAge":12},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Mulholland Drive","beginning":"2026-11-11T17:15:00+01:00","urlSlug":"64552","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579389","title":"Mulholland Drive","titleOriginal":"Mulholland Drive","urlSlug":"mulholland-drive","duration":145,"productionYear":null,"description":"F\u00fcr manche der Klassiker des 21. Jahrhunderts, f\u00fcr uns der beste Auftakt. Es f\u00e4ngt scheinbar konventionell an: ein Autounfall in Hollywood, attraktive Schauspielerinnen, spektakul\u00e4re Sets, die Schattenseiten des Filmgesch\u00e4fts. Doch an die Stelle einer konventionellen Geschichte treten unaufhaltsame Spannung, ein \"halluzinatorischer Angriff auf die Sinne\": Licht, Dinge, Farben, Bewegung, Zeit, Sound nehmen ein unheimliches Eigenleben an und ziehen die Zuschauer sogartig in den Film. Auch nach dem Film kann man sich kaum von den Bildern befreien - wie nach einem (Alb-)Traum.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Drama"},{"name":"Thriller"},{"name":"Mystery"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/mulholland-drive-110743.v17909040199202.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=URYHCINrUKI"}]}},{"name":"Becoming Kim","beginning":"2026-11-11T17:30:00+01:00","urlSlug":"64553","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579381","title":"Becoming Kim","titleOriginal":"\ube44\ucee4\ubc0d \ud0b4","urlSlug":"becoming-kim","duration":90,"productionYear":null,"description":"Die deutsche Filmemacherin Susanne, verheiratet mit Jeong Rae Kim, einem Koreaner, richtet die Kamera mit Humor und Z\u00e4rtlichkeit auf ihre eigene interkulturelle Ehe und Familie. W\u00e4hrend sie mit den Rollen als Ehefrau, Mutter und K\u00fcnstlerin jongliert, inszeniert sie humorvolle und poetische Performances \u2013 leise Akte der Rebellion, die ihren Gef\u00fchlen und ihrer inneren Welt Ausdruck verleihen.\r\nIn einem Mix aus Beobachtungen und inszenierten Momenten taucht der Film in das Chaos von Liebe, Identit\u00e4t und kulturellem Aufeinanderprallen ein.\r\n\u200bZugleich zutiefst pers\u00f6nlich und universell stellt Becoming Kim die Frage: Wie bleiben wir uns selbst treu \u2013 und lernen gleichzeitig, einen anderen Menschen zu lieben?","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"},{"name":"South Korea"}],"genres":[{"name":"Dokumentation"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/becoming-kim-103143.v17822958143809.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=QAch8J034kw"}]}},{"name":"Twin Peaks: Fire Walk with Me","beginning":"2026-11-11T17:30:00+01:00","urlSlug":"64554","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1579397","title":"Twin Peaks: Fire Walk with Me","titleOriginal":null,"urlSlug":"twin-peaks-fire-walk-with-me","duration":129,"productionYear":null,"description":null,"contentRating":{"minimumAge":16},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"literatur live: Bastian Barucker: Vorget\u00e4uschte Sicherheit","beginning":"2026-11-11T19:00:00+01:00","urlSlug":"64396","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 4"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"157