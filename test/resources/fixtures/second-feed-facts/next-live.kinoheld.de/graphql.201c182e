ma"},{"name":"Mukesh Tiwari"},{"name":"Mohit Raina"},{"name":"Shishir Sharma"},{"name":"Anil Kapoor"},{"name":"Harish Uthaman"},{"name":"Ajinkya Deo"},{"name":"Sunny Deol"},{"name":"Saurabh Sachdeva"},{"name":"Sonia Balani"},{"name":"Surabhi Das"},{"name":"Riya Kapoor"},{"name":"Dishita Sehgal"},{"name":"Kiara Sadh"},{"name":"Kanchan Chetal"},{"name":"Parminder Chadha"},{"name":"Pravin Manjarekar"},{"name":"Satyen Chaturvedi"},{"name":"Chetan Hansraj"},{"name":"Kurangi Vijayshri Nagraj"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/ramayana-rise-of-a-legend-111803-upload-toab0g01.v1792397000.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=jxYY7gMelFM"}]}},{"name":"Rammstein - Live in Mexico City","beginning":"2026-11-06T20:00:00+01:00","urlSlug":"6abe811f1465940c8f493c94","deeplink":"https:\/\/kinotickets.express\/universum-city-karlsruhe\/booking\/14083","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"universum-city","city":{"urlSlug":"karlsruhe-baden"}},"movie":{"id":"109119","title":"Rammstein - Live in Mexico City","titleOriginal":"Rammstein - Live in Mexico City","urlSlug":"rammstein-live-in-mexico-city","duration":110,"productionYear":"2026","description":"Im Oktober 2022 steht Rammstein zum Abschluss einer Nordamerika-Stadiontour in Mexiko-Stadt auf der B\u00fchne. Der Konzertfilm verbindet Aufnahmen von drei ausverkauften Abenden und zeigt 23 St\u00fccke aus unterschiedlichen Phasen der Bandgeschichte. Das Publikum singt und springt mit und reagiert auf das Geschehen auf der B\u00fchne. Neben der Musik fangen die Aufnahmen auch das Zusammenspiel mit den Fans ein. Feuer, Rauch und Licht pr\u00e4gen die Bilder und lassen die Dimensionen der Stadionproduktion sichtbar werden.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"},{"name":"Mexico"}],"genres":[{"name":"Dokumentarfilm"},{"name":"Musik"},{"name":"Konzert"}],"directors":[{"name":"Paul Dugdale"}],"actor