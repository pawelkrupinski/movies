inen Namen gemacht. Dann tauchen pl\u00f6tzlich andere Sprayer auf, die durch ihre komplexen, gro\u00dfen und bunten Bilder alle begeistern. Um ihre Vormachtstellung zu behaupten, bleibt den drei \"Dosenk\u00fcnstlern\" nur eine M\u00f6glichkeit: Sie m\u00fcssen einen \"Wholetrain\" machen, einen ganzen Zug bespr\u00fchen. Aber nun kommt alles anders.","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Drama"},{"name":"Krimi"}],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ZFl7JgQ83S0"}]}},{"name":"Cinebrasil: Cartas Para...","beginning":"2026-11-23T20:00:00+01:00","urlSlug":"64411","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1574955","title":"Cinebrasil: Cartas Para...","titleOriginal":null,"urlSlug":"cinebrasil-cartas-para","duration":89,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Cinebrasil: O Samba Que Mora Aqui","beginning":"2026-11-23T21:45:00+01:00","urlSlug":"64414","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1574957","title":"Cinebrasil: O Samba Que Mora Aqui","titleOriginal":null,"urlSlug":"cinebrasil-o-samba-que-mora-aqui","duration":84,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":null,"trailers":[]}},{"name":"Cinebrasil: Amuleto","beginning":"2026-11-23T21:45:00+01:00","urlSlug":"64558","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"babylon-berlin","city":{"urlSlug":"berlin"}},"movie":{"id":"1574947","title":"Cinebrasil: Amuleto","titleOriginal":null,"urlSlug"