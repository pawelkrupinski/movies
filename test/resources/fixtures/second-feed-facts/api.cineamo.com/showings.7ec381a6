"slug":"becoming-kim","category":"movie_series","description":"German filmmaker Susanne, married to a Korean man named Kim Jeong Rae, turns the camera toward her own intercultural marriage and family with both humor and tenderness. Blending vérité and performance, the film dives into the beautiful mess of love, identity, and cultural collision. Becoming Kim asks: How do we stay true to ourselves—while learning to love another?","descriptionEn":null,"isOwnContent":null,"duration":null,"creatorCinemaId":null,"posterImageRef":null,"posterImageUrl":null,"backdropImageRef":null,"backdropImageUrl":null,"ageRating":null,"trailerUrl":null,"isRegularEvent":false,"hasMarketingAssistantBooked":false,"futureShowingsCount":5,"premiereDate":"2026-08-27T00:00:00Z","cineamoMovie":null,"movieId":1064655,"metrics":null,"_links":{"self":{"href":"https://api.cineamo.com/contents/1645077"}}},"cinema":{"id":997,"name":"Babylon","shortName":"Babylon","slug":"babylon","description":"","phone":"+49302425969","street":"Rosa-Luxemburg-Straße 30","postalCode":"10178","city":"Berlin","state":"Berlin","stateAbbr":"BE","country":"Deutschland","countryCode":"DE","currencyCode":"EUR","longitude":13.41110039,"latitude":52.52600098,"distance":null,"profileImageRef":"6b18d166-51e3-49fe-a31d-1a4cb86d13f9","profileImageUrl":"https://cdn.cineamo.com/cinema-profile-image/6b18d166-51e3-49fe-a31d-1a4cb86d13f9","logoImageRef":"622a7a68-5d4c-443a-bcea-17d4cb3022fe","logoImageUrl":"https://cdn.cineamo.com/cinema-logo-image/622a7a68-5d4c-443a-bcea-17d4cb3022fe","logoWideImageRef":null,"logoWideImageUrl":null,"brandImageUrl":"https://cdn.cineamo.com/cinema-logo-image/622a7a68-5d4c-443a-bcea-17d4cb3022fe","priceTablePdfRef":null,"priceTablePdfUrl":null,"primaryColor":null,"instagramLink":"","facebookLink":"","showtimeSourceId":"1149","showtimeSource":"showtime_collector","ticketSystemId":"1149","ticketSystem":"showtime_collector","email":"grossman@babylonberlin.de","isActive":true,"cinemaConfigurationId":1006,"sh