de Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera\r debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.", "descriptionEn": null, "isOwnContent": null, "duration": null, "creatorCinemaId": null, "posterImageRef": null, "posterImageUrl": null, "backdropImageRef": null, "backdropImageUrl": null, "ageRating": null, "trailerUrl": null, "isRegularEvent": false, "hasMarketingAssistantBooked": false, "futureShowingsCount": 165, "premiereDate": "2026-11-10T00:00:00Z", "cineamoMovie": null, "movieId": 1340042, "metrics": null, "_links": {"self": {"href": "https://api.cineamo.com/contents/1916105"}}}}}, {"id": 45916553, "contentId": 1851251, "eventRequestId": null, "cinemaRoomId": 45, "name": "George Michael - The Faith Tour", "startDatetime": "2026-11-12T18:30:00Z", "endDatetime": null, "state": "scheduled", "isThreeDimensional": null, "isRegularShowtime": true, "isDolbyAtmos": true, "language": null, "originalLanguage": "eng", "isOriginalLanguage": false, "isDubbed": null, "dubbedLanguage": null, "isSubtitled": null, "subtitledLanguage": null, "cineamoMovieId": "1649403m", "movieId": 1288648, "onlineTicketUrl": "https://tickets.cineplex.de/checkout/381/4B6C3000023MILDET1", "cinemaId": 1, "eventRequest": null, "imageUrl": null, "priceOption": null, "highlightAfterDatetime": null, "highlightText": null, "startSaleDatetime": null, "endSaleDatetime": null, "isImax": null, "isDolbyVision": null, "isDolbyCinema": null, "is4DX": null, "isScreenX": null, "isLive": null, "isHFR": null, "isDbox": null, "isInfinityVision": null, "ticketUrls": {"default": "https://tickets.cineplex.de/checkout/381/4B6C3000023MILDET1", "web": null, "ios": null, "android": null, "cinemaWebsite": null}, "bookingUrlExternal": "https://tickets.cineplex.de/checkout/381/4B6C3000023MILDET1", "showingTagIds": null, "isPremiere": true, "isPreview": true, "protectedColumns": null, "_links": {"self": {"href": "https://api.cineamo.com/showings/45916553"}}, "_embedded": {"content": {"id": 1851251, "name": "George Michael: The Faith Tour", "slug": "george-michael-the-faith-tour", "category": "movie_series", "description": "A stunning delve into George Michael's 1988 Faith Tour, as shot live at the famous Palais Omnisports de Paris-Bercy. This exclusive footage, assembled from a 14-camera shoot captured on 35mm over two nights (30–31 May 1988), features the 24-year-old pop star at the height of his powers.", "descriptionEn": null, "isOwnContent": null, "duration": null, "creatorCinemaId": null, "posterImageRef": null, "posterImageUrl": null, "backdropImageRef": null, "backdropImageUrl": null, "ageRating": null, "trailerUrl": null, "isRegularEvent": false, "hasMarketingAssistantBooked": false, "futureShowingsCount": 219, "premiereDate": "2026-11-12T00:00:00Z", "cineamoMovie": null, "movieId": 1288648, "metrics": null, "_links": {"self": {"href": "https://api.cineamo.com/contents/1851251"}}}}}]}}