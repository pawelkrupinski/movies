ntCategoryPriority":0,"details":{"id":6742,"name":"Spektakl - The strings 2 jadą do USA","shortName":"Spektakl - The strings 2 jadą do USA","lengthInMinutes":1,"description":"Miała być wielka amerykańska kariera — wyszło jak zwykle. Zespół się rozpada, życie nie rozpieszcza, a do tego zniknął ich przyjaciel Lerua… gdzieś w okolicach granicy USA z Meksykiem.\r\n\r\nThe Strings reaktywują więc zespół i ruszają w podróż pełną muzyki, absurdów i nieoczekiwanych przygód.\r\n\r\nZamiast wielkich scen — małe bary, zamiast sławy — cała galeria barwnych postaci i sytuacji, których nie da się zaplanować.\r\nCzy odnajdą przyjaciela? Czy wrócą na scenę? I czy w ogóle wrócą?\r\nPrzekonaj się w drugiej części kultowej komedii muzycznej „The Strings” autorstwa i w reżyserii Macieja Kowalewskiego.\r\n\r\nObsada\r\nWojciech Brzeziński\r\nMaciej Kowalewski\r\nMichał Koterski\r\nPiotr Borowski\r\nKrzysztof Wieszczek\r\nBartosz Żukowski\r\n\r\nTwórcy\r\nScenariusz i reżyseria – Maciej Kowalewski\r\nMuzyka – Łukasz Lach\r\nScenografia – Witek Stefaniak\r\nChoreografia – Michał Piróg\r\nKostiumy – Michał Piróg, Joanna Ciesielska\r\nProdukcja – MACIEJ KOWALEWSKI","isActive":true,"ageCategoryID":10,"ageCategoryDescription":"BO","eventDetailTypeID":56,"eventDetailType":"Teatr","distributorID":50,"fullDescription":"","performers":"","premiereDatetime":"2027-01-24T00:00:00","isMarked":false,"eventDetailUniqueNumber":0,"alterName":"","wwwLink":"","internetLimitNumber":0,"isNSR":false,"voucherTaxGroupID":0,"voucherPrice":0.0,"isBIM":false,"eventDetailLengthTypeID":1,"eventDetailSalesChannelID":0,"isInternet":true,"dubbing":"","is_3D":false,"is_2D":false,"additionalInfo":"","linkFb":"","linkYt":"","imageId":3354,"imageGalleyIds":[],"xmlEventDetailTypeTranslations":null,"eventDetailsTypesTranslations":null,"xmlTranslations":"","translations":{"currentTranslation":null,"xmlNode":""}},"saleEnabled":true,"saleDisabledTooltip":"Wyprzedano"},{"eventId":79842,"eventDetailId":6742,"eventTitle":"Spektakl