    <div class="relative w-full bg-primary bg-cover bg-center bg-no-repeat" style="background-image: url('https://images.cinemaplus.com/ticketing/heroart/885310f7f458dcce5a5b0c5a4bd4b0ab.webp')">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgb(100, 100, 100, 0.2), rgba(0, 0, 0, 0.8))"></div>

        
        <div class="relative mx-auto grid h-screen-75 max-h-96 max-w-7xl grid-cols-16 gap-4 py-16 text-white md:h-auto md:max-h-full md:pt-32 xl:gap-8">
            <div class="col-span-14 col-start-2 self-end">
                <div class="grid grid-cols-12 gap-4 xl:gap-8">
