tion_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Ko\u0142\u0142\u0105taja 1"}},"7438":{"id":7438,"title":"MARIA SK\u0141ODOWSKA-CURIE. DO\u015aWIADCZENIE ","url":"\/kup-bilet\/marie-sklodowska-curie-doswiadczenie-2026-11-12-18-00","image":"\/uploads\/event\/\/1784617147.jpg","date":"2026-11-12T18:00:00+01:00","availableTickets":328,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-12 17:00:00","startAt":"2026-07-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-12 18:00:00"},"products":[{"id":71,"name":"Bilet","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":328}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1608,"name":"MARIA SK\u0141ODOWSKA-CURIE. DO\u015aWIADCZENIE ","description":"Poruszaj\u0105cy monodram w wykonaniu Agnieszki Przepi\u00f3rskiej, kt\u00f3ry zamiast suchego zestawienia fakt\u00f3w historycznych, oferuje emocjonalny portret wybitnej noblistki.<br>Tw\u00f3rcy \u2013 re\u017cyserka Justyna \u0141agowska oraz autor tekstu Piotr Rowicki \u2013 rezygnuj\u0105 z budowania kolejnego pomnika, skupiaj\u0105c si\u0119 na ludzkim wymiarze \u017cycia Marii. Opowie\u015b\u0107 prowadzi widza przez amplitud\u0119 los\u00f3w bohaterki: od m\u0142odzie\u0144czych lat w Polsce pod zaborami i wielkich sukces\u00f3w naukowych w Pary\u017cu, po bolesn\u0105 strat\u0119 m\u0119\u017ca, \u017ca\u0142ob\u0119 i walk\u0119 z depresj\u0105.<br>Kluczowym motywem przedstawienia jest odwaga i prawo do samostanowienia w \u015bwiecie zdominowanym przez m\u0119\u017cczyzn. Spektakl ukazuje Sk\u0142odowsk\u0105-Curie jako kobiet\u0119, kt\u00f3ra pierwsza przeciera\u0142a szlaki \u2013 zar\u00f3wno na uczelniach, jak i w \u017cyciu codziennym \u2013 p\u0142ac\u0105c za to wysok\u0105 cen\u0119. To osadzony w nurcie herstorii manifest kobiecego geniuszu i determinacji, kt\u00f3ry pozostaje aktualny do dzi\u015b. Produkcja stanowi kolejn\u0105 ods\u0142on\u0119 wsp\u00f3\u0142pracy Przepi\u00f3rskiej i Rowickiego, znanych z przywracania pami\u0119ci o niezwyk\u0142ych kobietach w nowoczesny i g\u0142\u0119boko ludzki spos\u00f3b.","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Spektakl teatralny","categoryId":2,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1784617147.jpg","artists":[]},"location":{"id":10,"name":"ul. Ko\u0142\u0142\u0105taja 1","institution_name":"Jasielski Dom Kultury","location_description":"","location_type":1,"location_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Ko\u0142\u0142\u0105taja 1"}},"7587":{"id":7587,"title":"Koncert Czes\u0142awa Mozila ","url":"\/kup-bilet\/koncert-czeslawa-mozila-2026-11-20-19-00","image":"","date":"2026-11-20T19:00:00+01:00","availableTickets":357,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-20 18:00:00","startAt":"2026-09-16 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-20 19:00:00"},"products":[{"id":16,"name":"Bilet","rawPrice":8000,"price":"80,00","allowSaleUsingPass":false,"available":357}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1635,"name":"Koncert Czes\u0142awa Mozila ","description":"","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":3,"omomoCategory":"1","duration":0,"image":"","artists":[]},"location":{"id":10,"name":"ul. Ko\u0142\u0142\u0105taja 1","institution_name":"Jasielski Dom Kultury","location_description":"","location_type":1,"location_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Ko\u0142\u0142\u0105taja 1"}},"7439":{"id":7439,"title":"PAPU\u017bKA ","url":"\/kup-bilet\/papuzka-2026-11-25-18-00","image":"\/uploads\/event\/\/1784617299.jpg","date":"2026-11-25T18:00:00+01:00","availableTickets":47,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-25 17:00:00","startAt":"2026-07-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-25 18:00:00"},"products":[{"id":71,"name":"Bilet","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":47}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1609,"name":"PAPU\u017bKA ","description":"Inteligentna komedia o mi\u0142o\u015bci, zdradzie, poszukiwaniach siebie i nieoczekiwanych wyzwaniach, kt\u00f3re stawia przed nami \u017cycie. W tym pe\u0142nym napi\u0119cia przedstawieniu nic nie jest takie, jak si\u0119 pocz\u0105tkowo wydaje \u2013 ka\u017cda decyzja, ka\u017cde s\u0142owo mo\u017ce zmieni\u0107 bieg wydarze\u0144, prowadz\u0105c do zaskakuj\u0105cych odkry\u0107 na temat relacji mi\u0119dzyludzkich.<br>G\u0142\u00f3wne postacie \u2013 ma\u0142\u017conkowie, m\u0119\u017cczyzna i kobieta \u2013 staj\u0105 w obliczu kryzysu, kt\u00f3ry zderza ich z nieoczekiwanym wydarzeniem. Niespodziewana wiadomo\u015b\u0107 o kradzie\u017cy zmienia plany na zapowiedziany wiecz\u00f3r, a to, co mia\u0142o by\u0107 prostym spotkaniem, przeradza si\u0119 w intensywn\u0105 konfrontacj\u0119 z uczuciami, tajemnicami i niedopowiedzeniami, kt\u00f3re przez lata kszta\u0142towa\u0142y ich zwi\u0105zek. Zamiast sp\u0119dzi\u0107 spokojny wiecz\u00f3r, bohaterowie zostaj\u0105 zmuszeni do zmierzenia si\u0119 z trudnymi pytaniami: O czym milczymy? Co naprawd\u0119 czujemy? Czy potrafimy si\u0119 wzajemnie zrozumie\u0107?","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Spektakl teatralny","categoryId":2,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1784617299.jpg","artists":[]},"location":{"id":10,"name":"ul. Ko\u0142\u0142\u0105taja 1","institution_name":"Jasielski Dom Kultury","location_description":"","location_type":1,"location_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Ko\u0142\u0142\u0105taja 1"}}},"passes":[]}