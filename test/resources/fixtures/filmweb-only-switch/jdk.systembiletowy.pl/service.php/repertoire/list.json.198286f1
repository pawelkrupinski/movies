At":"2026-10-08 18:00:00"},"products":[{"id":76,"name":"Bilet 2D","rawPrice":2100,"price":"21,00","allowSaleUsingPass":false,"available":184}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1637,"name":"Terminator 2: Dzie\u0144 s\u0105du 4K (napisy) ","description":"Jest rok 1991, wiele lat po krwawych wydarzeniach ukazanych w filmie Terminator. Sarah Connor znalaz\u0142a si\u0119 w szpitalu psychiatrycznym, sk\u0105d nie mo\u017ce chroni\u0107 syna przed zagro\u017ceniem z przysz\u0142o\u015bci. John Connor jest nastolatkiem wychowywanym w rodzinie zast\u0119pczej, zaczyna wchodzi\u0107 w konflikty z prawem. Pewnej nocy w Los Angeles ponownie zjawia si\u0119 dw\u00f3ch m\u0119\u017cczyzn. Jeden z nich ma zabi\u0107 ch\u0142opca, drugi za wszelk\u0105 cen\u0119 uratowa\u0107 mu \u017cycie. Po\u015bcig rozpoczyna si\u0119 na nowo.&nbsp;","oryginal_title":"Terminator 2: Judgment Day","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"sci-fi; akcja","director":"James Cameron","organizer":"","country":"USA","year":"1991","category":"Seans kinowy","categoryId":1,"omomoCategory":"1","duration":137,"image":"\/uploads\/event\/\/1789976583.jpg","artists":[]},"location":{"id":14,"name":"ul. Soko\u0142a 8","institution_name":"Kino JDK \"Syrena\"","location_description":"","location_type":1,"location_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Soko\u0142a 8"}},"7614":{"id":7614,"title":"Tedi i magiczna lampa (dubbing) ","url":"\/kup-bilet\/tedi-i-magiczna-lampa-dubbing-2026-10-09-15-30","image":"\/uploads\/event\/\/1789976867.jpg","date":"2026-10-09T15:30:00+02:00","availableTickets":187,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-09 14:30:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-09 15:30:00"},"products":[{"id":76,"name":"Bilet 2D","rawPrice":2100,"price":"21,00","allowSaleUsingPass":false,"available":187}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1638,"name":"Tedi i magiczna lampa (dubbing) ","description":"<span itemprop=\"description\">Oli, nieustraszona dwuletnia c\u00f3rka Tadeo, \r\nsprawi\u0142a, \u017ce sta\u0142 si\u0119 on nadopieku\u0144czym ojcem, a urocza Mumia czuje si\u0119 \r\nodsuni\u0119ta na bok.\r\n\r\nKiedy w Pa\u0142acu Buckingham znajduj\u0105 magiczn\u0105 lamp\u0119, Mumia prosi j\u0105 o \r\nprzeniesienie  w czasie do Paititi w Peru w 1502 roku.\r\n\r\nTad, Sara i ca\u0142a ekipa b\u0119d\u0105 musieli pod\u0105\u017cy\u0107 za Mumi\u0105 w przesz\u0142o\u015b\u0107, zanim\r\n co\u015b zmieni bieg historii\u2026\r\n\r\nPodr\u00f3\u017c zabierze ich przez Ocean Atlantycki z Peru do Grecji, a stamt\u0105d w\r\n g\u0142\u0105b Bliskiego Wschodu, a\u017c do jaskini Ali Baby i czterdziestu \r\nrozb\u00f3jnik\u00f3w.\r\n\r\nNowa kinowa przygoda jest pe\u0142na zwrot\u00f3w akcji i ma zabawny scenariusz, \r\nkt\u00f3ry z pewno\u015bci\u0105 zachwyci widz\u00f3w<\/span>","oryginal_title":"Tadeo Jones y la l\u00e1mpara maravillosa","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja; familijny","director":"Enrique Gato","organizer":"Anangu Grup; Ikiru Films; Lightbox Animation Studios; Telecinco Cinema","country":"Hiszpania","year":"2026","category":"Seans kinowy","categoryId":1,"omomoCategory":"1","duration":94,"image":"\/uploads\/event\/\/1789976867.jpg","artists":[]},"location":{"id":14,"name":"ul. Soko\u0142a 8","institution_name":"Kino JDK \"Syrena\"","location_description":"","location_type":1,"location_type_name":"sala","city":"Jas\u0142o","city_id":1078,"zip":"38-200","addresse":"ul. Soko\u0142a 8"}},"7588":{"id":7588,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-02-18-00-9-1","image":"\/uploads\/event\/\/1788340823.jpg","date":"2026-10-09T17:00:00+02:00","availableTickets":187,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-09 16:00:00","startAt":"2026-09-02 00:00:00"},"reservatio