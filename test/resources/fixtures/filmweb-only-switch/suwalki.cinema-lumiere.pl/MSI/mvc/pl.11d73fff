                            <p class="modalEventAdditionalInfo mb-0">Wersja: <span id="modalEventAdditionalInfo"></span></p>
                            <p class="modalEventWwwLink mb-0">Strona www: <strong><a id="modalEventWwwLink" href="" target="_blank" rel="noopener noreferrer" aria-label="Strona www:"></a></strong></p>
                            <div class="col-xs-12 event-gallery-background" id="modalEventImageGallery">
                                <h2 class=""><span class="fa fa-camera" aria-hidden="true"></span> Galeria</h2>
                                <div id="modalEventImageGalleryItems" style="display: flex; flex-wrap: wrap;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-dismiss="modal">Zamknij</button>
            </div>
        </div>
    </div>
</div>

        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', function () {
        localStorage.removeItem('carouselIndex');
    });
</script>


            <div class="row">
            </div>
        </main>
    </div>

    
<footer class="footer"><div class="container"><div class="row"><div class="col-12 col-md-4 col-lg-4 col-xl-4"><section id="cms" class="hidden" data-document-link-suffix=" (plik dokumentu)" data-new-tab-suffix=" (otwiera sie w nowej karcie)"><div id="cmstitle" class="footer__section-title text-uppercase"></div><ul id="onas"></ul></section></div><div class="col-12 col-md-4 col-lg-4 col-xl-4 offset-xl-12"><div class="footer__section-title">Kontakt</div><ul><li><span class="fa fa-phone text-color" aria-hidden="true"></span> 87-618-20-23</li><li><span class="fa fa-envelope text-color" aria-hidden="true"></span><span class="word-wrap" style="word-wrap: break-word;"><a class="link" href="mailto:suwalki@cinema-lumiere.pl">suwalki@cinema-lumiere.pl</a></span></li><li><a class="link" href="/MSI/mvc/pl/Sitemap/Index">Mapa strony</a></li></ul></div><div class="col-12 col-md-4 col-lg-3 col-xl-4 offset-xl-13"><ul class="footer__social"></ul><address class="footer__address"><div class="footer__section-title">LUMIERE  Sp. z o. o.</div><span class="fa fa-map-marker text-color" aria-hidden="true"></span> ul. Cieszyńska 3A lok. 220, 15-371 Białystok<br><span class="fa fa-book text-color" aria-hidden="true"></span> 5422861922<br></address></div></div><div class="row justify-content-center"><div class="col-12 footer__info"><div id="footer-logos"></div></div></div></div></footer>



    

    <script id="repo-template" type="text/x-handlebars-template">
        <div class="modal  fade in dialog" id="RepoModal" style="display: block">

            <button id="trap-top-focus" type="button" title="Początek okna dialogowego" aria-label="Początek okna dialogowego" style="opacity:0;cursor:pointer;" tabindex="0">
                Początek okna dialogowego
            </button>
            <div class="dialog-backdrop active fade in" style="bottom: 0">
                <div class="modal-dialog" id="modalDialog" role="dialog" aria-modal="true">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close modal-Focus first-element-in-modal" data-dismiss="modal" aria-label="Zamknij" title="Zamknij" id="closeModalBtn">
                                <span class="sr-only">Zamknij </span>
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <h3 class="modal-title dialog-title " tabindex="0">
                                <span class="glyphicon glyphicon-tag"></span>
                                {{Name}}
                            </h3>
                        </div>
                        <div class="modal-body" style=" word-wrap:break-word;">
                            <div class="media">
                                {{#ifCond PosterId '>' 0}}
                                <div class="media-left hidden-xs" tabindex="0">
                                    <button type="button" class="modal-Focus btn btn-link p-0" aria-label="Data: {{Name}}">
                                        <img src="/MSI/ImageData.ashx?id={{PosterId}}&amp;mode=thumb" alt="{{Name}}" class="" />
                                    </button>
                                </div>
                                {{/ifCond}}
                                <div class="media-body" style=" word-wrap:break-word;" tabindex="0">
                                    Data: <strong class="dialog-strong">{{Date}}</strong>
                                    {{#if Hour}}
                                    <div>Godzina: <strong class="dialog-strong">{{Hour}}</strong></div>
                                    {{/if}}
                                    {{#if Description}}
                                    <br />
                                    <div class="hidden-xs">{{{Description}}}</div>
                                    {{/if}}
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <button type="button" class="btn btn-anuluj btn-block modal-Focus" data-dismiss="modal" aria-label="Zamknij" title="Zamknij">
                                                <span class="sr-only">Zamknij  </span>
                                                <span class="glyphicon glyphicon-remove"></span>ANULUJ
                                            </button>
                                        </div>

                                        {{#if ShowFreeEventButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>WYBIERAM
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowBuyButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block  modal-Focus">
                                                <span class="glyphicon glyphicon-credit-card"></span>KUP BILET
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowReservationButton}}
                                        <div class="col-sm-5">
                                            <a href="{{ UrlRez }}" class="btn btn-rezerwuj btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>REZERWUJ MIEJSCE
                                            </a>
                                        </div>
                                        {{/if}}

                                    </div>
                                    <div class="row" tabindex="0" id="modalLastItem">
                                        <div class="col-12" style="margin-top: 15px; text-align: justify">
                                            <div class="alert alert-warning last-element-on-modal" style="margin-bottom: 0">
                                                Uwaga! W następnym kroku nie ma już możliwości wyboru pomiędzy Kupnem bilet&#243;w a Rezerwacją miejsc.

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <button id="trap-down-focus" type="button" title="Koniec okna dialogowego" aria-label="Koniec okna dialogowego" style="opacity:0;cursor:pointer;position:absolute;left:-100px;">
                Koniec okna dialogowego
            </button>
        </div>
    </script>
    <script type="text/javascript">
        var RepertoireEvents = [{ 'Id': 94145, 'Name': '100 dni: Misja Zeus (PL)', 'Date': '01.10.2026', 'Hour': '14:15', 'PosterId': '1080', 'Description': 'Kontynuacja jednego z najgłośniejszych młodzieżowych filmów ostatnich lat. Tym razem bohaterowie wychodzą poza szkolne mury, a stawka jest większa niż kiedykolwiek wcześniej — choć oni sami nie czują się na nią gotowi. Kapsel i jego ekipa stawiają pierwsze kroki w dorosłym życiu. Jedni ruszyli już dalej, inni próbują poukładać...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94147, 'Name': 'Avengers: Koniec gry - wersja rozszerzona (dubbing)', 'Date': '01.10.2026', 'Hour': '16:30', 'PosterId': '1092', 'Description': 'Avengers: Koniec gry – wersja rozszerzona to bezprecedensowa filmowa propozycja w nowej odsłonie opowiadająca historię wielkiego starcia superbohaterów z potężnym Thanosem. Połowa populacji Wszechświata została unicestwiona, a drużyna Avengers rozbita. Najpotężniejsi ziemscy bohaterowie zrozumieją, jak krucha jest nasza rzeczywistość...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94144, 'Name': 'Dzień dziecka księdza Jana Kaczkowskiego (PL)', 'Date': '01.10.2026', 'Hour': '13:15', 'PosterId': '1087', 'Description': 'Ksiądz Jan Kaczkowski – charyzmatyczny duchowny i zwykły błądzący człowiek. Naznaczony nieuleczalną chorobą, samozwańczy „onkocelebryta”, który walczył dla innych o godność i człowieczeństwo. Dzień dziecka – diagnoza choroby, wspomnienia z dzieciństwa, symboliczne narodzenie dla wieczności. Metaforyczny termin, który w filmie...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94140, 'Name': 'Folwark zwierzęcy (dubbing)', 'Date': '01.10.2026', 'Hour': '14:45', 'PosterId': '1084', 'Description': 'Folwark zwierzęcy …. czyli walka o koryto. Wizjonerski reżyser Andy Serkis przedstawia ekranizację klasycznego dzieła George’a Orwella, odczytanego na nowo z myślą o współczesnym widzu, także tym młodszym, i wyzwaniach dzisiejszego świata. Gdy zwierzęta przejmują władzę nad farmą, wierzą, że wspólnie stworzą miejsce, w którym...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 93976, 'Name': 'Lalka (PL)', 'Date': '01.10.2026', 'Hour': '19:00', 'PosterId': '1083', 'Description': 'Dzieło Bolesława Prusa od blisko 140 lat rozpala emocje i wyobraźnię kolejnych pokoleń. Teraz ta ponadczasowa historia trafia na wielki ekran w nowej, spektakularnej, filmowej odsłonie. „Lalka” to zrealizowana z ogromnym rozmachem superprodukcja i najbardziej gwiazdorski film w historii polskiego kina, gdzie pośród wielu wybitnych...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94149, 'Name': 'Luna i rozgadana świnka (dubbing)', 'Date': '01.10.2026', 'Hour': '15:15', 'PosterId': '1091', 'Description': '12-letnia miłośniczka książek, której powierzono magiczne pióro, zdolne spełnić każde życzenie zapisane jego pomocą. Wraz ze swoją gadającą świnką morską wyrusza w niebezpieczną przygodę, by ocalić planetę przed zniszczeniem środowiska.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94141, 'Name': 'Resident Evil (napisy)', 'Date': '01.10.2026', 'Hour': '18:15', 'PosterId': '1085', 'Description': 'Zach Cregger („Zniknięcia”) prezentuje ekscytującą i przerażającą – nową wersję serii Resident Evil.  To będzie zupełnie nowa historia. Poznamy Bryana (Austin Abrams), który nieświadomie wplątuje się w pełen akcji, nieustanny wyścig o przetrwanie.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94142, 'Name': 'Resident Evil (napisy)', 'Date': '01.10.2026', 'Hour': '20:15', 'PosterId': '1085', 'Description': 'Zach Cregger („Zniknięcia”) prezentuje ekscytującą i przerażającą – nową wersję serii Resident Evil.  To będzie zupełnie nowa historia. Poznamy Bryana (Austin Abrams), który nieświadomie wplątuje się w pełen akcji, nieustanny wyścig o przetrwanie.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94143, 'Name': 'Tedi i magiczna lampa (dubbing)', 'Date': '01.10.2026', 'Hour': '16:30', 'PosterId': '1086', 'Description': 'Oli, nieustraszona dwuletnia córka Tediego, sprawiła, że stał się on nadopiekuńczym ojcem, a urocza Mumia czuje się odsunięta na bok. Kiedy w Pałacu Buckingham znajdują magiczną lampę, Mumia prosi ją o przeniesienie  w czasie do Paititi w Peru w 1502 roku. Tedi, Sara i cała ekipa będą musieli podążyć za Mumią w przeszłość,...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94148, 'Name': 'Tedi i magiczna lampa (dubbing)', 'Date': '01.10.2026', 'Hour': '13:30', 'PosterId': '1086', 'Description': 'Oli, nieustraszona dwuletnia córka Tediego, sprawiła, że stał się on nadopiekuńczym ojcem, a urocza Mumia czuje się odsunięta na bok. Kiedy w Pałacu Buckingham znajdują magiczną lampę, Mumia prosi ją o przeniesienie  w czasie do Paititi w Peru w 1502 roku. Tedi, Sara i cała ekipa będą musieli podążyć za Mumią w przeszłość,...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94146, 'Name': 'W sercu dziczy (napisy)', 'Date': '01.10.2026', 'Hour': '19:45', 'PosterId': '1090', 'Description': 'To historia byłego oficera sił specjalnych Jamesa Belmonta (Brad Pitt) i jego psa o imieniu Odin, którzy walczą o przetrwanie po katastrofie samolotu w samym sercu bezlitosnej dziczy na Alasce. „W sercu dziczy” to trzymający w napięciu thriller w reżyserii cenionego twórcy, Davida Ayera ( „Furia”, „Legion samobójców”).', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 94150, 'Name': 'W sercu dziczy (napisy)', 'Date': '01.10.2026', 'Hour': '17:00', 'PosterId': '1090', 'Description': 'To historia byłego oficera sił specjalnych Jamesa Belmonta (Brad Pitt) i jego psa o imieniu Odin, którzy walczą o przetrwanie po katastrofie samolotu w samym sercu bezlitosnej dziczy na Alasce. „W sercu dziczy” to trzymający w napięciu thriller w reżyserii cenionego twórcy, Davida Ayera ( „Furia”, „Legion samobójców”).', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false}];
    </script>
<script>
    $(document).ready(function () {
        $("#RepoModal").on('shown.bs.modal', function () {
            $(this).find('#closeModalBtn').focus();
        });
    });
</script>


