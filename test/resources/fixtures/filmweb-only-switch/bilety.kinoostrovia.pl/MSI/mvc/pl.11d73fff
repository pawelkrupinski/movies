                            <h3 id="cmstitle" class="text-uppercase"></h3>
                            <ul id="onas"></ul>
                        </section>
                    </div>
                    <div class="col-12 col-md-4 col-lg-4 col-xl-4 offset-xl-12">
                        <h3>Kontakt</h3>
                        <ul>
                                <li>
                                    <span class="fa fa-phone text-color"></span>
                                    600 717 899
                                </li>
