entButton': false},{ 'Id': 6776, 'Name': 'CLAYFACE', 'Date': '03.11.2026', 'Hour': '19:00', 'PosterId': '1306', 'Description': 'Matt Hagen jest młodym aktorem, który z ulic Gotham zdołał przebić się do Hollywood i zaczyna robić dużą karierę. Jego życie gwałtownie się zmienia, gdy w wyniku działań miejscowego bossa przestępczego zostaje straszliwie oszpecony. Traci karierę, zostaje porzucony przez swoje otoczenie i praktycznie nie ma już nic do stracenia.<br><br>W...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 6778, 'Name': 'CLAYFACE', 'Date': '04.11.2026', 'Hour': '19:00', 'PosterId': '1306', 'Description': 'Matt Hagen jest młodym aktorem, który z ulic Gotham zdołał przebić się do Hollywood i zaczyna robić dużą karierę. Jego życie gwałtownie się zmienia, gdy w wyniku działań miejscowego bossa przestępczego zostaje straszliwie oszpecony. Traci karierę, zostaje porzucony przez swoje otoczenie i praktycznie nie ma już nic do stracenia.<br><br>W...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 6644, 'Name': 'STAND-UP BARTOSZ GAJDA Z PROGRAMEM PO LECIE', 'Date': '05.11.2026', 'Hour': '19:00', 'PosterId': '1295', 'Description': '', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false}];
    </script>
<script>
    $(document).ready(function () {
        $("#RepoModal").on('shown.bs.modal', function () {
            $(this).find('#closeModalBtn').focus();
        });
    });
