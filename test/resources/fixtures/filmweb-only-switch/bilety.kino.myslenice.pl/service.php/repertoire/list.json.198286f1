kultury ludowej w artystycznym wydaniu - grudniowy koncert poka\u017ce nie \r\ntylko najpi\u0119kniejsze melodie i uk\u0142ady taneczne, ale r\u00f3wnie\u017c stanie si\u0119 \r\nestrad\u0105 dla bogato zdobionych i urzekaj\u0105cych stroj\u00f3w z r\u00f3\u017cnych zak\u0105tk\u00f3w \r\nnaszego kraju. Zapraszamy!\r\n<br><br>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/254\/1789034507.jpg","artists":[]},"organizer":{"id":1,"name":"MOKiS","officialName":"My\u015blenicki O\u015brodek Kultury i Sportu","street":"ul. Pi\u0142sudskiego 20","city":"My\u015blenice","postCode":"32-400","nip":"6811353451","www":null},"location":{"id":3,"name":"Sala Widowiskowa","institution_name":"My\u015blenicki O\u015brodek Kultury i Sportu","location_description":"","location_type":1,"location_type_name":"sala","city":"My\u015blenice","city_id":815,"zip":"","addresse":""}},"1485":{"id":1485,"title":"KONCERT GALOWY ZPiT ZIEMIA MY\u015aLENICKA  12.12.2026","url":"\/kup-bilet\/koncert-galowy-zpit-ziemia-myslenicka-2026-12-12-17-00","image":"\/uploads\/event\/254\/1789034507.jpg","date":"2026-12-12T17:00:00+01:00","availableTickets":69,"additionalInfo":"","regulationsUrl":null,"info":{"sale":{"enabled":true,"endAt":"2026-12-12 18:00:00","startAt":"2026-09-10 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-12-12 17:00:00"},"products":[{"id":14,"name":"BILET ZPiT","rawPrice":4000,"price":"40,00","saleMultiple":0,"allowSaleUsingPass":false,"available":69}]},"event":{"id":254,"name":"KONCERT GALOWY ZPiT ZIEMIA MY\u015aLENICKA ","description":"Zesp\u00f3\u0142 Pie\u015bni i Ta\u0144ca \"Ziemia My\u015blenicka\" zaprasza na doroczne Koncerty \r\nGalowe! 11 i 12 grudnia w My\u015blenickim O\u015brodku Kultury i Sportu \r\nzaprezentujemy suity pie\u015bni i ta\u0144c\u00f3w z ca\u0142ej Polski. 