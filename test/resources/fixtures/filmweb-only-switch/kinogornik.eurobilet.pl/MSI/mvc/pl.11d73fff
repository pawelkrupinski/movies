        <script id="repo-template" type="text/x-handlebars-template">
        <div class="modal  fade in dialog" id="RepoModal" style="display: block">

            <button id="trap-top-focus" href="#" title="Przycisk funkcyjny programu" style="opacity:0;cursor:pointer;" tabindex="0">
                Początek treści
            </button>
            <div class="dialog-backdrop active fade in" style="bottom: 0">
                <div class="modal-dialog" id="modalDialog" role="dialog" aria-modal="true">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close modal-Focus first-element-in-modal" data-dismiss="modal" aria-label="Close" title="Zamknij " id="closeModalBtn">
                                <span class="sr-only">Zamknij </span>
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <h3 class="modal-title dialog-title " tabindex="0">
                                <span class="glyphicon glyphicon-tag"></span>
                                {{Name}}
                            </h3>
                        </div>
                        <div class="modal-body" style=" word-wrap:break-word;">
                            <div class="media">
                                {{#ifCond PosterId '>' 0}}
                                <div class="media-left hidden-xs" tabindex="0">
                                    <a href="#" class="modal-Focus">
                                        <img src="/MSI/ImageData.ashx?id={{PosterId}}&amp;mode=thumb" alt="{{Name}}" class="" />
                                    </a>
                                </div>
                                {{/ifCond}}
                                <div class="media-body" style=" word-wrap:break-word;" tabindex="0">
                                    Data: <strong class="dialog-strong">{{Date}}</strong>
                                    {{#if Hour}}
                                    <div>Godzina: <strong class="dialog-strong">{{Hour}}</strong></div>
                                    {{/if}}
                                    {{#if Description}}
                                    <br />
                                    <div class="hidden-xs">{{{Description}}}</div>
                                    {{/if}}
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <button type="button" class="btn btn-anuluj btn-block modal-Focus" data-dismiss="modal" aria-label="Close" title="Zamknij">
                                                <span class="sr-only">Zamknij  </span>
                                                <span class="glyphicon glyphicon-remove"></span>ANULUJ
                                            </button>
                                        </div>

                                        {{#if ShowFreeEventButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>WYBIERAM
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowBuyButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block  modal-Focus">
                                                <span class="glyphicon glyphicon-credit-card"></span>KUP BILET
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowReservationButton}}
                                        <div class="col-sm-5">
                                            <a href="{{ UrlRez }}" class="btn btn-rezerwuj btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>REZERWUJ MIEJSCE
                                            </a>
                                        </div>
                                        {{/if}}

                                    </div>
                                    <div class="row" tabindex="0" id="modalLastItem">
                                        <div class="col-12" style="margin-top: 15px; text-align: justify">
                                            <div class="alert alert-warning last-element-on-modal" style="margin-bottom: 0">
                                                Uwaga! W następnym kroku nie ma już możliwości wyboru pomiędzy Kupnem bilet&#243;w a Rezerwacją miejsc.

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <button id="trap-down-focus" href="#" title="Przycisk funkcyjny programu" style="opacity:0;cursor:pointer;position:absolute;left:-100px;">
                Koniec treści
            </button>
        </div>
    </script>
    <script type="text/javascript">
        var RepertoireEvents = [{ 'Id': 79507, 'Name': '100 dni: Misja Zeus 2D PL, dys Next film', 'Date': '02.10.2026', 'Hour': '18:00', 'PosterId': '0', 'Description': 'Kapsel i jego ekipa stawiają pierwsze kroki w dorosłym życiu. Jedni ruszyli już dalej, inni próbują poukładać życie po swojemu, a Kapsel… nie potrafi się odnaleźć. Mieszka z rodzicami, w pracy pożegnał się z ambicjami i coraz częściej zadaje sobie pytanie, czy najlepszy czas ma za sobą. Kiedy jednak na horyzoncie pojawia się...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79482, 'Name': 'Avengers: Koniec gry 2D Dubbing, Dys. Disney', 'Date': '01.10.2026', 'Hour': '16:00', 'PosterId': '0', 'Description': 'Po wymazaniu połowy życia we Wszechświecie przez Thanosa Avengersi starają się zrobić wszystko, co konieczne, aby pokonać szalonego tytana.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79483, 'Name': 'Avengers: Koniec gry 2D Dubbing, Dys. Disney', 'Date': '01.10.2026', 'Hour': '19:30', 'PosterId': '0', 'Description': 'Po wymazaniu połowy życia we Wszechświecie przez Thanosa Avengersi starają się zrobić wszystko, co konieczne, aby pokonać szalonego tytana.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79493, 'Name': 'Avengers: Koniec gry 2D Dubbing, Dys. Disney', 'Date': '02.10.2026', 'Hour': '12:30', 'PosterId': '0', 'Description': 'Po wymazaniu połowy życia we Wszechświecie przez Thanosa Avengersi starają się zrobić wszystko, co konieczne, aby pokonać szalonego tytana.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79501, 'Name': 'Avengers: Koniec gry 2D Dubbing, Dys. Disney', 'Date': '02.10.2026', 'Hour': '18:30', 'PosterId': '0', 'Description': 'Po wymazaniu połowy życia we Wszechświecie przez Thanosa Avengersi starają się zrobić wszystko, co konieczne, aby pokonać szalonego tytana.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79496, 'Name': 'Dzień dziecka księdza Jana Kaczkowskiego 2D PL, dys TVP', 'Date': '02.10.2026', 'Hour': '20:00', 'PosterId': '0', 'Description': 'Poruszająca opowieść o ks. Janie Kaczkowskim - człowieku naznaczonym chorobą, który uczynił z życia misję miłości, walcząc o godność innych i przypominając, jak ważne jest kochać i być kochanym.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79475, 'Name': 'Folwark zwierzęcy 2D Dubbing, Dys. Galapagos Films', 'Date': '01.10.2026', 'Hour': '12:50', 'PosterId': '0', 'Description': 'W wyniku rewolucji zwierzęcej świnie przejmują władzę, a farma przekształca się w bezwzględną dyktaturę.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79499, 'Name': 'Folwark zwierzęcy 2D Dubbing, Dys. Galapagos Films', 'Date': '02.10.2026', 'Hour': '10:45', 'PosterId': '0', 'Description': 'W wyniku rewolucji zwierzęcej świnie przejmują władzę, a farma przekształca się w bezwzględną dyktaturę.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79473, 'Name': 'Księga pustyni 2D Dubbing, dys Kino Świat', 'Date': '01.10.2026', 'Hour': '14:20', 'PosterId': '0', 'Description': 'Czternastoletnia Sun wyrusza na Saharę, by odkryć prawdę o chłopcu wychowanym przez strusie.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79495, 'Name': 'Księga pustyni 2D Dubbing, dys Kino Świat', 'Date': '02.10.2026', 'Hour': '14:10', 'PosterId': '0', 'Description': 'Czternastoletnia Sun wyrusza na Saharę, by odkryć prawdę o chłopcu wychowanym przez strusie.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79486, 'Name': 'Lalka 2D PL, Dys. Kino Świat', 'Date': '01.10.2026', 'Hour': '19:50', 'PosterId': '0', 'Description': 'Bogaty warszawski kupiec zakochuje się w zubożałej arystokratce.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79487, 'Name': 'Lalka 2D PL, Dys. Kino Świat', 'Date': '01.10.2026', 'Hour': '16:45', 'PosterId': '0', 'Description': 'Bogaty warszawski kupiec zakochuje się w zubożałej arystokratce.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79497, 'Name': 'Lalka 2D PL, Dys. Kino Świat', 'Date': '02.10.2026', 'Hour': '16:00', 'PosterId': '0', 'Description': 'Bogaty warszawski kupiec zakochuje się w zubożałej arystokratce.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79508, 'Name': 'Lalka 2D PL, Dys. Kino Świat', 'Date': '02.10.2026', 'Hour': '20:00', 'PosterId': '0', 'Description': 'Bogaty warszawski kupiec zakochuje się w zubożałej arystokratce.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79509, 'Name': 'Lalka 2D PL, Dys. Kino Świat', 'Date': '02.10.2026', 'Hour': '17:00', 'PosterId': '0', 'Description': 'Bogaty warszawski kupiec zakochuje się w zubożałej arystokratce.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79484, 'Name': 'Luna i rozgadana świnka 2D Dubbing, Kino Świat', 'Date': '01.10.2026', 'Hour': '11:00', 'PosterId': '0', 'Description': 'Jedenastoletnia Luna, fanka serii książek o super-bohaterach walczących o środowisko, otrzymuje magiczne pióro od tajemniczego autora książek.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79485, 'Name': 'Luna i rozgadana świnka 2D Dubbing, Kino Świat', 'Date': '01.10.2026', 'Hour': '12:25', 'PosterId': '0', 'Description': 'Jedenastoletnia Luna, fanka serii książek o super-bohaterach walczących o środowisko, otrzymuje magiczne pióro od tajemniczego autora książek.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79510, 'Name': 'Luna i rozgadana świnka 2D Dubbing, Kino Świat', 'Date': '02.10.2026', 'Hour': '12:40', 'PosterId': '0', 'Description': 'Jedenastoletnia Luna, fanka serii książek o super-bohaterach walczących o środowisko, otrzymuje magiczne pióro od tajemniczego autora książek.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79511, 'Name': 'Luna i rozgadana świnka 2D Dubbing, Kino Świat', 'Date': '02.10.2026', 'Hour': '10:50', 'PosterId': '0', 'Description': 'Jedenastoletnia Luna, fanka serii książek o super-bohaterach walczących o środowisko, otrzymuje magiczne pióro od tajemniczego autora książek.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79474, 'Name': 'Mistyczka 2D PL, Dys. Rafael Film', 'Date': '01.10.2026', 'Hour': '14:45', 'PosterId': '0', 'Description': 'Opowieść o wewnętrznej przemianie, poszukiwaniu sensu egzystencji i niezwykłej drodze, która zaprowadziła Alicję Lenczewską do doświadczeń wykraczających poza materialną rzeczywistość.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79498, 'Name': 'Mistyczka 2D PL, Dys. Rafael Film', 'Date': '02.10.2026', 'Hour': '14:40', 'PosterId': '0', 'Description': 'Opowieść o wewnętrznej przemianie, poszukiwaniu sensu egzystencji i niezwykłej drodze, która zaprowadziła Alicję Lenczewską do doświadczeń wykraczających poza materialną rzeczywistość.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79470, 'Name': 'Niesamowite przygody skarpetek 3. Ale kosmos! 2D Dubbing, Dys. NHEF', 'Date': '01.10.2026', 'Hour': '13:00', 'PosterId': '0', 'Description': 'Najbardziej odlotowi bohaterowie książek dla dzieci powracają do kin z nowymi przygodami. Zagadka detektywistyczna, pojedynki na Dzikim Zachodzie i podróże w kosmos to dopiero początek!', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79492, 'Name': 'Niesamowite przygody skarpetek 3. Ale kosmos! 2D Dubbing, Dys. NHEF', 'Date': '02.10.2026', 'Hour': '13:00', 'PosterId': '0', 'Description': 'Najbardziej odlotowi bohaterowie książek dla dzieci powracają do kin z nowymi przygodami. Zagadka detektywistyczna, pojedynki na Dzikim Zachodzie i podróże w kosmos to dopiero początek!', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79471, 'Name': 'Psi Patrol i dinozaury 2D Dubbing, dys UIP', 'Date': '01.10.2026', 'Hour': '14:20', 'PosterId': '0', 'Description': 'Podczas burzy statek Psiego Patrolu rozbija się na wyspie pełnej dinozaurów. Tam spotykają Reksa, szczeniaka-eksperta od dinozaurów. Gdy Humdinger lekkomyślnie eksploatuje wyspę, budzi wulkan. Pieski muszą go powstrzymać i uratować wyspę.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79472, 'Name': 'Pucio kocha zwierzaki 2D Dubbing, dys NHEF', 'Date': '01.10.2026', 'Hour': '11:45', 'PosterId': '0', 'Description': 'U Pucia jak zwykle dużo się dzieje. Spędza wakacje u dziadków na wsi i sadzi swoje pierwsze drzewo, a podczas spaceru w parku rusza z Misią na misję ratunkową, by odnaleźć psa sąsiada. Kiedy ich własny, ukochany Funio gorzej się czuje, rodzeństwo robi, co w ich mocy, by poprawić mu humor. Wygląda jednak na to, że czas odwiedzić...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79494, 'Name': 'Pucio kocha zwierzaki 2D Dubbing, dys NHEF', 'Date': '02.10.2026', 'Hour': '12:00', 'PosterId': '0', 'Description': 'U Pucia jak zwykle dużo się dzieje. Spędza wakacje u dziadków na wsi i sadzi swoje pierwsze drzewo, a podczas spaceru w parku rusza z Misią na misję ratunkową, by odnaleźć psa sąsiada. Kiedy ich własny, ukochany Funio gorzej się czuje, rodzeństwo robi, co w ich mocy, by poprawić mu humor. Wygląda jednak na to, że czas odwiedzić...', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79476, 'Name': 'Resident Evil 2D Napisy, Dys. UIP', 'Date': '01.10.2026', 'Hour': '20:15', 'PosterId': '0', 'Description': 'Awaria laboratorium Umbrelli powoduje niekontrolowane uwolnienie wirusa. Mieszkańcy Raccoon przemieniają się w bezlitosne, krwiożercze istoty. Bryan, przypadkowy świadek katastrofy, zostaje uwięziony pośród chaosu miasta.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79477, 'Name': 'Resident Evil 2D Napisy, Dys. UIP', 'Date': '01.10.2026', 'Hour': '18:25', 'PosterId': '0', 'Description': 'Awaria laboratorium Umbrelli powoduje niekontrolowane uwolnienie wirusa. Mieszkańcy Raccoon przemieniają się w bezlitosne, krwiożercze istoty. Bryan, przypadkowy świadek katastrofy, zostaje uwięziony pośród chaosu miasta.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79481, 'Name': 'Spa weekend 2D Napisy, Dys. Kino Świat', 'Date': '01.10.2026', 'Hour': '16:20', 'PosterId': '0', 'Description': 'Trzy przyjaciółki wybierają się na weekend do spa. Gdy dołącza do nich Mel sprawy zaczynają przybierać dramatyczny obrót.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79478, 'Name': 'Tedi i magiczna lampa 2D Dubbing, Dys. UIP', 'Date': '01.10.2026', 'Hour': '16:30', 'PosterId': '0', 'Description': 'Oli, nieustraszona dwuletnia córka Tadeo, sprawiła, że stał się on nadopiekuńczym ojcem, a urocza Mumia czuje się odsunięta na bok. Kiedy w Pałacu Buckingham znajdują magiczną lampę, Mumia prosi ją o przeniesienie w czasie do Paititi w Peru w 1502 roku.', 'ShowBuyButton': true, 'ShowReservationButton': true, 'ShowFreeEventButton': false},{ 'Id': 79479, 'Name': 'Tedi i magiczna lampa 2D Dubbing, Dys. UIP', 'Date': '01.10.2026', 'Hour': '12:50', 'PosterId': '0', 'Description': 'Oli, nieustraszona dwuletnia córka Tadeo, sprawiła, że stał się on nadopiekuńczym ojcem, a urocza Mumia czuje się odsunięta na bok. Kiedy w Pałacu Buckingham znajdują magiczną lampę, 