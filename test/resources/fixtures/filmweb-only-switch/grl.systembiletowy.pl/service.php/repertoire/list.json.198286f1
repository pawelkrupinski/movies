":"2026O2D4432","movieType":"","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2012\/1790070492.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14031":{"id":14031,"title":"VERITY CORAZ WI\u0118KSZY MROK ","url":"\/kup-bilet\/verity-coraz-wiekszy-mrok-2026-10-16-20-15-2","image":"\/uploads\/event\/2015\/1790070453.jpg","date":"2026-10-18T20:15:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 19:30:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-10-18 19:15:00"},"products":[{"id":17,"name":"Normalny 2D","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2015,"name":"VERITY CORAZ WI\u0118KSZY MROK ","description":"<div><span style=\"background-color: rgb(255, 255, 255); color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Lowen Ashleigh przyjmuje zlecenie doko\u0144czenia bestsellerowej serii Verity Crawford, kt\u00f3ra po wypadku nie jest w stanie pisa\u0107. W domu Crawford\u00f3w odkrywa sekrety, kt\u00f3re zmieniaj\u0105 wszystko.<\/span><\/div>","oryginal_title":"Verity","additional_title":null,"distributor":null,"sKSIdent":"2026T2D4678","movieType":"","director":"Michael Showalter","organizer":"","country":"USA","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2015\/1790070453.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14059":