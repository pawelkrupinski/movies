px; background-color: rgb(255, 255, 255);\"><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":" Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"2026D2D4666","movieType":"","director":"Joel Crawford\/ Januel Mercado","organizer":"","country":"USA","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2013\/1790070476.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14015":{"id":14015,"title":"LALKA  ","url":"\/kup-bilet\/lalka-2026-10-02-16-10-6","image":"\/uploads\/event\/2012\/1790070492.jpg","date":"2026-10-17T16:50:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 16:05:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 15:50:00"},"products":[{"id":17,"name":"Normalny 2D","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2012,"name":"LALKA  ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-