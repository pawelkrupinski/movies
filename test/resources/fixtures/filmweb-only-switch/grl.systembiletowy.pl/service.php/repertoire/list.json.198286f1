span>","oryginal_title":"100 dni: Misja Zeus","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4352","movieType":"","director":"Mikoaj Piszczan","organizer":"","country":"Polska","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2006\/1787223383.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"13952":{"id":13952,"title":"RESIDENT EVIL ","url":"\/kup-bilet\/resident-evil-2026-09-28-18-15","image":"\/uploads\/event\/2007\/1787223376.JPG","date":"2026-09-28T18:15:00+02:00","availableTickets":303,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-28 17:30:00","startAt":"2026-08-19 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-09-28 17:15:00"},"products":[{"id":5,"name":"Tani poniedzia\u0142ek ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":303}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2007,"name":"RESIDENT EVIL ","description":"<div><br><\/div><div><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Awaria laboratorium Umbrelli powoduje niekontrolowane uwolnienie wirusa. Mieszka\u0144cy Raccoon przemieniaj\u0105 si\u0119 w bezlitosne, krwio\u017cercze istoty. Bryan, przypadkowy \u015bwiadek katastrofy, zostaje uwi\u0119ziony po\u015br\u00f3d chaosu miasta.<\/span><\/div>","oryginal_title":"Resident Evil","additional_title":null,"distributor":null,"sKSIdent":"2026T2D4390","movieType":"","director":" Zach Cregger","organizer":"","country":"Czechy\/ Francja\/ Niemcy\/ USA","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2007\/1787223376.JPG","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"13967":{"id":13967,"title":"NIEBO NAD NORMANDI\u0104 ","url":"\/kup-bilet\/niebo-nad-normandia-2026-09-28-20-30","image":"\/uploads\/event\/2009\/1787223362.jpg","date":"2026-09-28T20:30:00+02:00","availableTickets":300,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-28 19:45:00","startAt":"2026-08-19 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-09-28 19:30:00"},"products":[{"id":5,"name":"Tani poniedzia\u0142ek ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":300}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2009,"name":"NIEBO NAD NORMANDI\u0104 ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">72 godziny przed l\u0105dowaniem w Normandii, losy \u015bwiata maj\u0105 zale\u017ce\u0107 od... pogody. Wojna to nie tylko bitwy, to w szczeg\u00f3lno\u015bci strategie i decyzje, kt\u00f3rych skutki odczu\u0107 mog\u0105 miliony. Pracuj\u0105cy dla brytyjskiej armii meteorolog <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/James+Stagg-2869814\" title=\"James Stagg\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">James Stagg<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Andrew+Scott-61258\" title=\"Andrew Scott\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Andrew Scott<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) musi podj\u0105\u0107 najwa\u017cniejsz\u0105 decyzj\u0119 w swojej karierze \u2013 prognoza, kt\u00f3r\u0105 przedstawi, mo\u017ce przes\u0105dzi\u0107 o sukcesie lub kl\u0119sce najwi\u0119kszej operacji wojskowej w historii. Zamkni\u0119ty w atmosferze nieufno\u015bci i presji ze strony najwy\u017cszych dow\u00f3dc\u00f3w, Stagg toczy psychologiczn\u0105 walk\u0119 z czasem, wspierany jedynie przez kapitan <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kay+Summersby-393342\" title=\"Kay Summersby\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kay Summersby<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kerry+Condon-136125\" title=\"Kerry Condon\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kerry Condon<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). Nad wszystkim czuwa genera\u0142 <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Dwight+D.+Eisenhower-210712\" title=\"Dwight D. Eisenhower\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Dwight D. Eisenhower<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Brendan+Fraser-5137\" title=\"Brendan Fraser\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Brendan Fraser<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), kt\u00f3ry musi zdecydowa\u0107 czy ruszy\u0107 z inwazj\u0105, czy j\u0105 op\u00f3\u017ani\u0107 \u2013 ryzykuj\u0105c, \u017ce Niemcy odkryj\u0105 plany aliant\u00f3w.<\/span>","oryginal_title":"Pressure","additional_title":null,"distributor":null,"sKSIdent":"2026T2D4374","movieType":"","director":"Anthony Maras","organizer":"","country":"Francja\/ USA\/ Wielka Brytania","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2009\/1787223362.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"13963":{"id":13963,"title":"MARSUPILAMI ","url":"\/kup-bilet\/marsupilami-2026-09-29-13-30","image":"\/uploads\/event\/2008\/1787223369.jpg","date":"2026-09-29T13:30:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-29 12:45:00","startAt":"2026-08-19 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-09-29 12:30:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2008,"name":"MARSUPILAMI ","description":"<p>Film Familijny dla ca\u0142ej rodziny - Szalona, pe\u0142na humoru przygoda, w kt\u00f3rej w centrum akcji znajduje si\u0119 \r\nprawdziwy psotnik \u2013 tajemnicze stworzenie MARSUPILAMI! W\r\n polskiej wersji j\u0119zykowej us\u0142yszymy plejad\u0119 gwiazd: Cezarego Pazur\u0119, \r\nMagdalen\u0119 Boczarsk\u0105, Mateusza Banasiuka i Tomasza O\u015bwieci\u0144skiego.<\/p><p>Podczas\r\n rejsu all-inclusive David, Tess i ich synek odkrywaj\u0105 w swoim baga\u017cu \r\nuroczego, \u017c\u00f3\u0142tego stworka w czarne c\u0119tki, kt\u00f3rego niewyobra\u017calnie d\u0142ugi \r\nogon i nieposkromiony temperament w mgnieniu oka zamieniaj\u0105 rodzinne \r\nwakacje w totalny chaos \u2013 zw\u0142aszcza gdy okazuje si\u0119, \u017ce nowego \r\nprzyjaciela ch\u0142opca pr\u00f3buje odnale\u017a\u0107 zdecydowanie zbyt wiele os\u00f3b!<\/p>","oryginal_title":" Marsupilami","additional_title":null,"distributor":null,"sKSIdent":"2025D2D10780","movieType":"","director":"Philippe Lacheau","organizer":"","country":"Belgia\/ Francja","year":"2025","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2008\/1787223369.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"13958":{"id":13958,"title":"100 DNI MISJA ZEUS ","url":"\/kup-bilet\/100-dni-misja-zeus-2026-09-29-15-45","image":"\/uploads\/event\/2006\/1787223383.jpg","date":"2026-09-29T15:45:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-29 15:00:00","startAt":"2026-08-19 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-29 14:45:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2006,"name":"100 DNI MISJA ZEUS ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kontynuacja jednego z najg\u0142o\u015bniejszych m\u0142odzie\u017cowych film\u00f3w ostatnich lat. Tym razem bohaterowie wychodz\u0105 poza szkolne mury, a stawka jest wi\u0119ksza ni\u017c kiedykolwiek wcze\u015bniej - cho\u0107 oni sami nie czuj\u0105 si\u0119 na ni\u0105 gotowi. Kapsel i jego ekipa stawiaj\u0105 pierwsze kroki w doros\u0142ym \u017cyciu. Jedni ruszyli ju\u017c dalej, inni pr\u00f3buj\u0105 pouk\u0142ada\u0107 \u017cycie po swojemu, a Kapsel\u2026 nie potrafi si\u0119 odnale\u017a\u0107. Mieszka z rodzicami, w pracy po\u017cegna\u0142 si\u0119 z ambicjami i coraz cz\u0119\u015bciej zadaje sobie pytanie, czy najlepszy czas ma za sob\u0105. Kiedy jednak na horyzoncie pojawia si\u0119 misja, od kt\u00f3rej mo\u017ce zale\u017ce\u0107 przysz\u0142o\u015b\u0107 wielu ludzi, nie ma czasu na w\u0105tpliwo\u015bci.<\/span>","oryginal_title":"100 dni: Misja Zeus","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4352","movieType":"","director":"Mikoaj Piszczan","organizer":"","country":"Polska","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2006\/1787223383.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"13953":{"id":13953,"title":"RESIDENT EVIL ","url":"\/kup-bilet\/resident-evil-2026-09-29-18-15","image":"\/uploads\/event\/2007\/1787223376.JPG","date":"2026-09-29T18:15:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-29 17:30:00","startAt":"2026-08-19 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-09-29 17:15:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2007,"name":"RESIDENT EVIL ","description":"<div><br><\/div><div><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Awaria laboratorium Umbrelli powoduje niekontrolowane uwolnienie wirusa. Mieszka\u0144cy Raccoon przemieniaj\u0105 si\u0119 w bezlitosne, krwio\u017cercze istoty. Bryan, przypadkowy \u015bwiadek katastrofy, zostaje uwi\u0119ziony po\u015br\u00f3d chaosu miasta.<\/span><\/div>","oryginal_title":"Resident Evil","additional_title":null,"distributor":null,