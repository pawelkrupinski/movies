0-19-20-15","image":"\/uploads\/event\/2015\/1790070453.jpg","date":"2026-10-19T20:15:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-19 19:30:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-10-19 19:15:00"},"products":[{"id":5,"name":"Tani poniedzia\u0142ek ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2015,"name":"VERITY CORAZ WI\u0118KSZY MROK ","description":"<div><span style=\"background-color: rgb(255, 255, 255); color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Lowen Ashleigh przyjmuje zlecenie doko\u0144czenia bestsellerowej serii Verity Crawford, kt\u00f3ra po wypadku nie jest w stanie pisa\u0107. W domu Crawford\u00f3w odkrywa sekrety, kt\u00f3re zmieniaj\u0105 wszystko.<\/span><\/div>","oryginal_title":"Verity","additional_title":null,"distributor":null,"sKSIdent":"2026T2D4678","movieType":"","director":"Michael Showalter","organizer":"","country":"USA","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2015\/1790070453.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14060":{"id":14060,"title":"LALKA  ","url":"\/kup-bilet\/lalka-2026-10-06-08-00-5","image":"\/uploads\/event\/2012\/1790070492.jpg","date":"2026-10-20T09:00:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-20 08:15:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-20 08:00:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2012,"name":"LALKA  ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kamila Urz\u0119dowska<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marek+Kondrat-253\" title=\"Marek Kondrat\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marek Kondrat<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span>","oryginal_title":"Lalka","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4432","movieType":"","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2012\/1790070492.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14023":{"id":14023,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-20-14-20","image":"\/uploads\/event\/2013\/1790070476.jpg","date":"2026-10-20T14:20:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-20 13:35:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":true,"endAt":"2026-10-20 13:20:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2013,"name":"ZAPOMNIANA WYSPA ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.<\/span><br style=\"box-sizing: inherit; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.<\/span><br style=\"box-sizing: inherit; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":" Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"2026D2D4666","movieType":"","director":"Joel Crawford\/ Januel Mercado","organizer":"","country":"USA","year":"2026","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/2013\/1790070476.jpg","artists":[]},"location":{"id":26,"name":"Kino Wilga 312","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Garwolin","city_id":1656,"zip":"","addresse":""}},"14018":{"id":14018,"title":"LALKA  ","url":"\/kup-bilet\/lalka-2026-10-20-16-50","image":"\/uploads\/event\/2012\/1790070492.jpg","date":"2026-10-20T16:50:00+02:00","availableTickets":312,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-20 16:05:00","startAt":"2026-09-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-20 15:50:00"},"products":[{"id":13,"name":"Bilet ","rawPrice":1700,"price":"17,00","allowSaleUsingPass":false,"available":312}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2012,"name":"LALKA  ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kamila Urz\u0119dowska<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marek+Kondrat-253\" title=\"Marek Kondrat\" style=