<footer class="footer"><div class="container"><div class="row"><div class="col-12 col-md-4 col-lg-4 col-xl-4"><section id="cms" class="hidden" data-document-link-suffix=" (plik dokumentu)" data-new-tab-suffix=" (otwiera sie w nowej karcie)"><div id="cmstitle" class="footer__section-title text-uppercase"></div><ul id="onas"></ul></section></div><div class="col-12 col-md-4 col-lg-4 col-xl-4 offset-xl-12"><div class="footer__section-title">Kontakt</div><ul><li><span class="fa fa-phone text-color" aria-hidden="true"></span> Tel. (43) 677-72-15</li><li><span class="fa fa-phone text-color" aria-hidden="true"></span> Godziny pracy kasy znajdują się na stronie www.scksieradz.pl</li><li><span class="fa fa-envelope text-color" aria-hidden="true"></span><span class="word-wrap" style="word-wrap: break-word;"><a class="link" href="mailto:kasa@scksieradz.pl">kasa@scksieradz.pl</a></span></li><li class="get-ticket"><a class="text-uppercase link" href="/MSI/mvc/pl/GetTicket/Index"><span class="fas fa-ticket-alt" aria-hidden="true"></span>Pobierz swoje bilety</a></li><li><a class="link" href="/MSI/mvc/pl/Sitemap/Index">Mapa strony</a></li></ul></div><div class="col-12 col-md-4 col-lg-3 col-xl-4 offset-xl-13"><ul class="footer__social"><li><a target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sieradzkiecentrumkultury/" title="Facebook (otwiera sie w nowej karcie)" class="fab fa-facebook-square fa-2x text-color"><span class="sr-only"><span lang="en">Facebook</span> (otwiera sie w nowej karcie)</span></a></li></ul><address class="footer__address"><div class="footer__section-title">Sieradzkie Centrum Kultury</div><span class="fa fa-map-marker text-color" aria-hidden="true"></span> ul. Dominikańska 19, 98-200
 Sieradz<br><span class="fa fa-book text-color" aria-hidden="true"></span>  tel: (43) 827-10-06<br></address></div></div><div class="row justify-content-center"><div class="col-12 footer__info"><div id="footer-logos"></div></div></div></div></footer>



    

    <script id="repo-template" type="text/x-handlebars-template">
        <div class="modal  fade in dialog" id="RepoModal" style="display: block">

            <button id="trap-top-focus" type="button" title="Początek okna dialogowego" aria-label="Początek okna dialogowego" style="opacity:0;cursor:pointer;" tabindex="0">
                Początek okna dialogowego
            </button>
            <div class="dialog-backdrop active fade in" style="bottom: 0">
                <div class="modal-dialog" id="modalDialog" role="dialog" aria-modal="true">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close modal-Focus first-element-in-modal" data-dismiss="modal" aria-label="Zamknij" title="Zamknij" id="closeModalBtn">
                                <span class="sr-only">Zamknij </span>
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <h3 class="modal-title dialog-title " tabindex="0">
                                <span class="glyphicon glyphicon-tag"></span>
                                {{Name}}
                            </h3>
                        </div>
                        <div class="modal-body" style=" word-wrap:break-word;">
                            <div class="media">
                                {{#ifCond PosterId '>' 0}}
                                <div class="media-left hidden-xs" tabindex="0">
                                    <button type="button" class="modal-Focus btn btn-link p-0" aria-label="Data: {{Name}}">
                                        <img src="/MSI/ImageData.ashx?id={{PosterId}}&amp;mode=thumb" alt="{{Name}}" class="" />
                                    </button>
                                </div>
                                {{/ifCond}}
                                <div class="media-body" style=" word-wrap:break-word;" tabindex="0">
                                    Data: <strong class="dialog-strong">{{Date}}</strong>
                                    {{#if Hour}}
                                    <div>Godzina: <strong class="dialog-strong">{{Hour}}</strong></div>
                                    {{/if}}
                                    {{#if Description}}
                                    <br />
                                    <div class="hidden-xs">{{{Description}}}</div>
                                    {{/if}}
                                </div>
                                <div class="modal-footer">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <button type="button" class="btn btn-anuluj btn-block modal-Focus" data-dismiss="modal" aria-label="Zamknij" title="Zamknij">
                                                <span class="sr-only">Zamknij  </span>
                                                <span class="glyphicon glyphicon-remove"></span>ANULUJ
                                            </button>
                                        </div>

                                        {{#if ShowFreeEventButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>WYBIERAM
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowBuyButton}}
                                        <div class="col-sm-4">
                                            <a href="{{ UrlBuy }}" class="btn btn-kup btn-block  modal-Focus">
                                                <span class="glyphicon glyphicon-credit-card"></span>KUP BILET
                                            </a>
                                        </div>
                                        {{/if}}
                                        {{#if ShowReservationButton}}
                                        <div class="col-sm-5">
                                            <a href="{{ UrlRez }}" class="btn btn-rezerwuj btn-block modal-Focus">
                                                <span class="glyphicon glyphicon-star"></span>REZERWUJ MIEJSCE
                                            </a>
                                        </div>
                                        {{/if}}

                                    </div>
                                    <div class="row" tabindex="0" id="modalLastItem">
                                        <div class="col-12" style="margin-top: 15px; text-align: justify">
                                            <div class="alert alert-warning last-element-on-modal" style="margin-bottom: 0">
                                                Uwaga! W następnym kroku nie ma już możliwości wyboru pomiędzy Kupnem bilet&#243;w a Rezerwacją miejsc.

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <button id="trap-down-focus" type="button" title="Koniec okna dialogowego" aria-label="Koniec okna dialogowego" style="opacity:0;cursor:pointer;position:absolute;left:-100px;">
                Koniec okna dialogowego
            </button>
        </div>
