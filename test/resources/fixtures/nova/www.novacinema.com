ue="genrewestern">Western</option><option value="genreromance">Romance</option><option value="genremusic">Music</option><option value="genremystery">Mystery</option><option value="genresciencefiction">Science Fiction</option><option value="genrecomedy">Comedy</option><option value="genrefamily">Family</option><option value="genrehorror">Horror</option><option value="genreanimation">Animation</option><option value="genrethriller">Thriller</option><option value="genrecrime">Crime</option><option value="genreaction">Action</option><option value="genrefantasy">Fantasy</option><option value="genredrama">Drama</option><option value="genredocumentary">Documentary</option></select></div><!-- Certificate --><div class="form-select-wrapper mb-4"><select class="form-select" aria-label="Select Age Rating" id="filterCertificate"><option selected="" value="Age Rating">Age Rating</option><option value="cert-r18">R18</option><option value="cert-18">18</option><option value="cert-15">15</option><option value="cert-12">12</option><option value="cert-12a">12A</option><option value="cert-pg">PG</option><option value="cert-u">U</option><option value="cert-unrated">Unrated</option></select></div><a id="applyFilterBtn" class="btn btn-primary rounded-0 btn-login w-100 text-uppercase">Apply &amp; Return</a></form></div></div></div></div></div></div></div><!-- Foot --><div class="progress-wrap"><svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102"><path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" /></svg></div><script src="/assets/js/plugins.js"></script><script src="/assets/js/theme.js"></script><!-- <script>
document.addEventListener("DOMContentLoaded", function() {
  // OUTER Isotope (films)
  var isoOuter = new Isotope(".films", {
    itemSelector: ".movie.item",
    layoutMode: "vertical",
    transitionDuration: "0.4s",
    stagger: 30
  });

  // --- Add "No Results" message as a valid item ---
  var filmsContainer = document.querySelector(".films");
  var noResults = document.createElement("div");
  noResults.className = "movie item no-results text-center py-5 fs-5 text-muted w-100";
  noResults.textContent = "Sorry, there aren't any shows that match your filters.";
  noResults.style.display = "none";
  filmsContainer.appendChild(noResults);

  // IMPORTANT: register new element with Isotope
  isoOuter.appended([noResults]);
  isoOuter.layout();

  var isShowingNoResults = false;

  // Collect inner isotopes
  var dayIsos = [];
  var timeIsos = [];
  var timeIndex = new Map();

  document.querySelectorAll(".film-days").forEach(function(daysWrap) {
    var isoDay = new Isotope(daysWrap, {
      itemSelector: ".day-block",
      layoutMode: "fitRows",
      transitionDuration: "0.35s",
      stagger: 20
    });
    dayIsos.push(isoDay);

    daysWrap.querySelectorAll(".screening-grid").forEach(function(grid) {
      var isoTime = new Isotope(grid, {
        itemSelector: ".screening-card",
        layoutMode: "fitRows",
        transitionDuration: "0.3s",
        stagger: 15
      });
      timeIsos.push(isoTime);
      timeIndex.set(grid, isoTime);
    });

    // isoDay.on("arrangeComplete", function() {
    //   isoOuter.layout();
    // });
  });

  // --- Filter state ---
  var filters = { date: "*", genre: "*", certificate: "*" };

  // --- Apply combined filters ---
window.applyFilters = function() {
	var selector = "";
	if (filters.date !== "*" && filters.date) selector += ".d-" + filters.date;
	if (filters.genre !== "*" && filters.genre) selector += "." + filters.genre;
	if (filters.certificate !== "*" && filters.certificate) selector += "." + filters.certificate;
	if (selector === "") selector = "*";
  
	// 1) filter screenings
	timeIsos.forEach(function(iso) {
	  iso.arrange({ filter: selector });
	});
  
	// 2) filter days
	dayIsos.forEach(function(isoDay) {
	  isoDay.arrange({
		filter: function(dayElem) {
		  var grid = dayElem.querySelector(".screening-grid");
		  var isoTime = timeIndex.get(grid);
		  return isoTime && isoTime.getFilteredItemElements().length > 0;
		}
	  });
	});
  
	// 3) filter shows (outer layer)
	isoOuter.arrange({
	  filter: function(showElem) {
		// Ã¢ÂÂ Always include the no-results item
		if (showElem.classList.contains("no-results")) return true;
  
		var daysWrap = showElem.querySelector(".film-days");
		var isoDay = daysWrap ? Isotope.data(daysWrap) : null;
		return isoDay && isoDay.getFilteredItemElements().length > 0;
	  }
	});
  
	setTimeout(function() {
	  timeIsos.forEach(function(iso) { iso.layout(); });
	  dayIsos.forEach(function(iso) { iso.layout(); });
	  isoOuter.layout();
	}, 50);
  };
  
  // --- After outer arrange, toggle no-results visibility ---
  isoOuter.on("arrangeComplete", function(filteredItems) {
	// Count only visible items that are NOT the no-results block
	var visibleMovies = filteredItems.filter(function(el) {
	  return !el.element.classList.contains("no-results");
	});
  
	if (visibleMovies.length === 0) {
	  noResults.style.display = "block";
	} else {
	  noResults.style.display = "none";
	}
  
	requestAnimationFrame(function() {
	  isoOuter.layout();
	});
  });
  
  // --- Hook up top date nav (nav-link version) ---
  var dateFilterWrap = document.querySelector(".isotope-filter");
  if (dateFilterWrap) {
    dateFilterWrap.addEventListener("click", function(e) {
      var link = e.target.closest("a[data-filter-date]");
      if (!link) return;

      dateFilterWrap.querySelectorAll("a[data-filter-date]").forEach(function(a) {
        a.classList.remove("active");
      });
      link.classList.add("active");

      filters.date = (link.dataset.filterDate && link.dataset.filterDate !== "*")
        ? link.dataset.filterDate
        : "*";

      applyFilters();
    });
  }


	
	
	  // --- Hook up modal filters ---
	  var applyFilterBtn = document.getElementById("applyFilterBtn");
	  if (applyFilterBtn) {
		applyFilterBtn.addEventListener("click", function(e) {
		  e.preventDefault();
	
		  // Genre
		  var genreVal = document.getElementById("filterGenre").value;
		  filters.genre = (genreVal && genreVal !== "Genre") ? genreVal : "*";
	
		  // Certificate
		  var certVal = document.getElementById("filterCertificate").value;
		  filters.certificate = (certVal && certVal !== "Age Rating") ? certVal : "*";
	
		  // (donÃ¢ÂÂt overwrite filters.date here Ã¢ÂÂ itÃ¢ÂÂs set by the datepicker change event)
	
		  // Apply combined filters
		  applyFilters();
	
		  // Close modal
		  var modalEl = document.getElementById("modal-filter");
		  var modal = bootstrap.Modal.getInstance(modalEl);
		  if (modal) modal.hide();
		});
	  }
	
	  // --- Init Tempus Dominus datepicker for modal filter ---
	  if (typeof tempusDominus !== "undefined") {
		const filterDateEl = document.getElementById("filterDate");
		new tempusDominus.TempusDominus(filterDateEl, {
		  display: {
			theme: 'light',
			icons: {
			  type: 'icons',
			  time: 'fa-solid fa-clock',
			  date: 'fa-solid fa-calendar',
			  up: 'fa-solid fa-arrow-up',
			  down: 'fa-solid fa-arrow-down',
			  previous: 'fa-solid fa-chevron-left',
			  next: 'fa-solid fa-chevron-right',
			  today: 'fa-solid fa-calendar-check',
			  clear: 'fa-solid fa-trash',
			  close: 'fa-solid fa-xmark'
			},
			components: {
			  calendar: true,
			  date: true,
			  month: true,
			  year: true,
			  decades: true,
			  clock: false
			},
			buttons: {
			  today: true,
			  clear: true,
			  close: true
			}
		  },
		  localization: {
			format: 'dd/MM/yyyy'  // Ã°ÂÂÂ user sees dd/MM/yyyy
		  },
		  restrictions: {
			enabledDates: availableDates.map(d => new Date(d)) // whitelist
		  }
		});
	
		// Ã°ÂÂÂ Keep filters.date in ISO format for Isotope selectors
		filterDateEl.addEventListener("change.td", function(ev) {
		  if (ev.detail && ev.detail.date) {
			const d = ev.detail.date;
			filters.date = d.toISOString().split("T")[0]; // yyyy-MM-dd
		  } else {
			filters.date = "*";
		  }
		});
	  }
	
	  // --- Initial render: show all ---
	  applyFilters();
	});
	</script> --></body></html><!-- refresh random: C88uAoVoFRfqoko1devtHok3Gt-->