<!DOCTYPE html><html lang="en"><head><title>Nova Cinema</title><meta name="description" content="" /><meta name="author" content="Stunn" /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><link rel="shortcut icon" href="/assets/img/favicon.png" /><link rel="stylesheet" href="/assets/css/plugins.css" /><link rel="stylesheet" href="/assets/css/style.css" /><link rel="stylesheet" href="/assets/css/colors/orange.css" /><link rel="stylesheet" href="https://use.typekit.net/bzh8abe.css" /><link rel="preload" href="/assets/css/fonts/brother.css" as="style" onload="this.rel='stylesheet'" /><script type="text/javascript" src="https://vivenu.com/web/deliver/js/v1/embed.js"></script><!-- Popper (required by Tempus Dominus) --><script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js" crossorigin="anonymous"></script><!-- Tempus Dominus --><script src="https://cdn.jsdelivr.net/npm/@eonasdan/tempus-dominus@6.9.4/dist/js/tempus-dominus.min.js" crossorigin="anonymous"></script><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@eonasdan/tempus-dominus@6.9.4/dist/css/tempus-dominus.min.css" crossorigin="anonymous" /><!-- Google Tag Manager --><script>
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-MMPP2QR3');
</script><!-- End Google Tag Manager --><style>.film-days {position: relative;   /* required for vertical Isotope */}.film-days .day-block {display: block;       /* enforce block stacking */width: 100%;          /* one per row */}</style></head><body><div class="content-wrapper"><!-- Header --><!-- Header --><header><nav class="navbar center-nav navbar-light  py-3 py-sm-5 px-2 px-sm-0"><div class="container flex-lg-row flex-nowrap align-items-center px-0"><div class="navbar-brand w-100 d-flex justify-content-start justify-content-sm-center on"><a href="/"><img src="/assets/img/svg/logo.svg" alt="Nova Cinema Logo" /></a></div><div class="offcanvas offcanvas-nav offcanvas-start align-items-start"><div class="offcanvas-header d-flex justify-content-between w-100 on"><a href="/"><img src="/assets/img/logo-negative.png" alt="Nova Cinema Logo" class="w-75" /></a><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button></div><div class="offcanvas-body d-flex flex-column h-100"><ul class="navbar-nav"><li class="nav-item on"><a class="nav-link py-0" href="/">Now Showing</a></li><li class="nav-item"><a class="nav-link py-0" href="/accessible-showings.html">Accessible Showings</a></li><li class="nav-item"><a class="nav-link py-0" href="/coming-soon.html">Coming Soon</a></li><li class="nav-item dropdown"><a class="nav-link py-0 dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside">Seasons &amp; Series</a><ul class="dropdown-menu pb-2"><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/half-term-halloween-haunt.html">Half-Term Halloween Haunt</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/nova-laughs.html">Nova Laughs</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/nova-live.html">Nova Live</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/nova-kids.html">Nova Kids</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/silver-nova.html">Silver Nova</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/relaxed-screenings.html">Relaxed Screenings</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/seasons-and-series/nova-tots.html">Nova Tots</a></li></ul></li><li class="nav-item"><a class="nav-link py-0" href="/memberships.html">Memberships</a></li><li class="nav-item"><a class="nav-link py-0" href="/gift-vouchers.html">Gift Vouchers</a></li><li class="nav-item dropdown"><a class="nav-link py-0 dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside">Your Visit</a><ul class="dropdown-menu pb-2"><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/your-visit/explore-our-screens.html">Explore Our Screens</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/your-visit/food-and-drinks.html">Food &amp; Drinks</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/your-visit/getting-here-and-parking.html">Getting Here &amp; Parking</a></li></ul></li><li class="nav-item"><a class="nav-link py-0" href="/hire-us.html">Hire Us</a></li><li class="nav-item dropdown"><a class="nav-link py-0 dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside">FAQ</a><ul class="dropdown-menu pb-2"><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/faq/accessibility.html">Accessibility</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="https://help.novacinema.com/hc/en-gb" target="_blank">FAQ</a></li></ul></li><li class="nav-item dropdown"><a class="nav-link py-0 dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside">T&amp;Cs, Privacy &amp; Cookies</a><ul class="dropdown-menu pb-2"><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/privacy-policy.html">Privacy Policy</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/terms-of-use.html">Terms of Use</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/terms-and-conditions.html">Terms &amp; Conditions</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/admissions-policy.html">Admissions Policy</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/cookies-policy.html">Cookies Policy</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/membership-terms-and-conditions.html">Membership Terms &amp; Conditions</a></li><li class="nav-item"><a class="dropdown-item py-0 text-orange-200" href="/tandcs-privacy-and-cookies/gift-voucher-terms-and-conditions.html">Gift Voucher Terms &amp; Conditions</a></li></ul></li><li class="nav-item"><a class="nav-link py-0" href="https://tickets.novacinema.com/account/login">Sign In</a></li></ul><!-- /.navbar-nav --><div class="mt-auto pt-6 pb-6 order-4"><div>We'd love you to keep in touch</div><strong>Sign up to our <a href="/newsletter.html">newsletter</a></strong><!-- /.social --></div><!-- /offcanvas-nav-other --></div><!-- /.offcanvas-body --></div><!-- /.navbar-collapse --><div class="navbar-other ms-auto position-absolute end-0"><ul class="navbar-nav flex-row align-items-center me-0 me-sm-3"><li class="nav-item"><button class="hamburger offcanvas-nav-btn"><span></span></button></li></ul><!-- /.navbar-nav --></div><!-- /.navbar-other --></div><!-- /.container --></nav><!-- /.navbar --></header><section class="wrapper d-none d-md-block"><div class="container"><nav class="d-block border-bottom" aria-label="breadcrumb"><ol class="breadcrumb mb-0"><li class="breadcrumb-item active" aria-current="page">Home</li></ol></nav></div></section><section class="wrapper"><div class="container py-9 fw-medium d-flex justify-content-center"><div class="col-lg-6 text-center"><p></p></div></div></section><div class="swiper-container swiper-hero dots-over h-auto" data-margin="0" data-autoplay="false" data-autoplaytime="5000" data-nav="true" data-dots="true" data-items="1"><div class="swiper"><div class="swiper-wrapper"><div class="swiper-slide h-100 bg-overlay bg-overlay-400 bg-dark" style="background-image: url('./cmsUploads/banner/images/thumbs/Doomsday_WebBanner2.jpg');background-image: image-set(url('./cmsUploads/banner/images/thumbs/Doomsday_WebBanner2.jpg') 1x,url('./cmsUploads/banner/images/Doomsday_WebBanner2.jpg') 2x);background-position: top center;background-size: cover;background-repeat: no-repeat;"><div class="container h-100"><div class="row h-100"><div class="col-md-10 offset-md-1 col-lg-7 offset-lg-0 col-xl-6 col-xxl-5 text-center text-lg-start justify-content-center align-self-center align-items-start"><h2 class="display-1 fs-56 mb-4 text-white animate__animated animate__slideInDown animate__delay-1s">Avengers: Doomsday</h2><p class="lead fs-23 lh-sm mb-7 text-white animate__animated animate__slideInRight animate__delay-2s">All roads lead to Doom. Experience it first in Infinity Vision</p><div class="animate__animated animate__slideInUp animate__delay-3s"><a href="https://www.novacinema.com/shows/avengers-doomsday-infinity-vision.html" class="btn btn-lg btn-orange text-uppercase">On Sale Now</a></div></div><!--/column --></div><!--/.row --></div><!--/.container --></div><!--/.swiper-slide --><div class="swiper-slide h-100 bg-overlay bg-overlay-400 bg-dark" style="background-image: url('./cmsUploads/banner/images/thumbs/Verity_WebBanner.jpg');background-image: image-set(url('./cmsUploads/banner/images/thumbs/Verity_WebBanner.jpg') 1x,url('./cmsUploads/banner/images/Verity_WebBanner.jpg') 2x);background-position: top center;background-size: cover;background-repeat: no-repeat;"><div class="container h-100"><div class="row h-100"><div class="col-md-10 offset-md-1 col-lg-7 offset-lg-0 col-xl-6 col-xxl-5 text-center text-lg-start justify-content-center align-self-center align-items-start"><h2 class="display-1 fs-56 mb-4 text-white animate__animated animate__slideInDown animate__delay-1s">Verity</h2><p class="lead fs-23 lh-sm mb-7 text-white animate__animated animate__slideInRight animate__delay-2s">There's no light where we're going</p><div class="animate__animated animate__slideInUp animate__delay-3s"><a href="https://www.novacinema.com/shows/verity.html" class="btn btn-lg btn-orange text-uppercase">Book Tickets</a></div></div><!--/column --></div><!--/.row --></div><!--/.container --></div><!--/.swiper-slide --><div class="swiper-slide h-100 bg-overlay bg-overlay-400 bg-dark" style="background-image: url('./cmsUploads/banner/images/thumbs/SocialReckoning_WebBanner-1.jpg');background-image: image-set(url('./cmsUploads/banner/images/thumbs/SocialReckoning_WebBanner-1.jpg') 1x,url('./cmsUploads/banner/images/SocialReckoning_WebBanner-1.jpg') 2x);background-position: top center;background-size: cover;background-repeat: no-repeat;"><div class="container h-100"><div class="row h-100"><div class="col-md-10 offset-md-1 col-lg-7 offset-lg-0 col-xl-6 col-xxl-5 text-center text-lg-start justify-content-center align-self-center align-items-start"><h2 class="display-1 fs-56 mb-4 text-white animate__animated animate__slideInDown animate__delay-1s">The Social Reckoning</h2><p class="lead fs-23 lh-sm mb-7 text-white animate__animated animate__slideInRight animate__delay-2s">We're way past making friends</p><div class="animate__animated animate__slideInUp animate__delay-3s"><a href="https://www.novacinema.com/shows/the-social-reckoning.html" class="btn btn-lg btn-orange text-uppercase">Book Tickets</a></div></div><!--/column --></div><!--/.row --></div><!--/.container --></div><!--/.swiper-slide --><div class="swiper-slide h-100 bg-overlay bg-overlay-400 bg-dark" style="background-image: url('./cmsUploads/banner/images/thumbs/OtherMommy_WebBanner.jpg');background-image: image-set(url('./cmsUploads/banner/images/thumbs/OtherMommy_WebBanner.jpg') 1x,url('./cmsUploads/banner/images/OtherMommy_WebBanner.jpg') 2x);background-position: top center;background-size: cover;background-repeat: no-repeat;"><div class="container h-100"><div class="row h-100"><div class="col-md-10 offset-md-1 col-lg-7 offset-lg-0 col-xl-6 col-xxl-5 text-center text-lg-start justify-content-center align-self-center align-items-start"><h2 class="display-1 fs-56 mb-4 text-white animate__animated animate__slideInDown animate__delay-1s">Other Mommy</h2><p class="lead fs-23 lh-sm mb-7 text-white animate__animated animate__slideInRight animate__delay-2s">Your mommy won't save you</p><div class="animate__animated animate__slideInUp animate__delay-3s"><a href="https://www.novacinema.com/shows/other-mommy.html" class="btn btn-lg btn-orange text-uppercase">Book Tickets</a></div></div><!--/column --></div><!--/.row --></div><!--/.container --></div><!--/.swiper-slide --><div class="swiper-slide h-100 bg-overlay bg-overlay-400 bg-dark" style="background-image: url('./cmsUploads/banner/images/thumbs/Uprising_WebBanner1.jpg');background-image: image-set(url('./cmsUploads/banner/images/thumbs/Uprising_WebBanner1.jpg') 1x,url('./cmsUploads/banner/images/Uprising_WebBanner1.jpg') 2x);background-position: top center;background-size: cover;background-repeat: no-repeat;"><div class="container h-100"><div class="row h-100"><div class="col-md-10 offset-md-1 col-lg-7 offset-lg-0 col-xl-6 col-xxl-5 text-center text-lg-start justify-content-center align-self-center align-items-start"><h2 class="display-1 fs-56 mb-4 text-white animate__animated animate__slideInDown animate__delay-1s">The Uprising</h2><p class="lead fs-23 lh-sm mb-7 text-white animate__animated animate__slideInRight animate__delay-2s">Experience the story of the Peasants' Revolt</p><div class="animate__animated animate__slideInUp animate__delay-3s"><a href="https://www.novacinema.com/shows/the-uprising.html" class="btn btn-lg btn-orange text-uppercase">Book Tickets</a></div></div><!--/column --></div><!--/.row --></div><!--/.container --></div><!--/.swiper-slide --></div><!--/.swiper-wrapper --></div><!-- /.swiper --></div><!-- /.swiper-container --><section class="wrapper bg-dark d-none d-md-block"><div class="container py-6 d-flex justify-content-center text-white"><span>Keep up to date with all the latest news, receive exclusive offers and film times, and get a first look at some of our special events &#x2026; <a href="/newsletter.html">Sign Up to the newsletter</a></span></div></section><section class="wrapper bg-light"><div class=""><div class="grid-view"><div class="container mb-n8"><div class="row"><div><div class="pt-8 pb-3 d-flex justify-content-between border-lg-bottom flex-wrap flex-lg-nowrap"><div class="col-lg-3 col-12 pe-2 pb-2 pb-lg-0 mb-3 mb-lg-0 border-bottom border-lg-bottom-0"><h2 class="text-uppercase mb-0">Now Showing</h2></div><style>/* The day lists and screening grids used to be laid out by Isotope (fitRows).They are plain flex-wrap containers now; hiding is done with .d-none. */.films .film-days,.films .screening-grid {display: flex;flex-wrap: wrap;align-items: flex-start;}/* Motion: a day block or screening card that goes from hidden to shownreplays this animation, so changing the date visibly re-deals thescreenings even when the same films stay on screen. Pure CSS, no reflowcost in JS. */@keyframes novaFadeUp {from { opacity: 0; transform: translateY(10px); }to   { opacity: 1; transform: none; }}.films .day-block      { animation: novaFadeUp .45s ease-out both; }.films .screening-card { animation: novaFadeUp .4s  ease-out both; }.films .screening-card:nth-child(2)    { animation-delay: .06s; }.films .screening-card:nth-child(3)    { animation-delay: .12s; }.films .screening-card:nth-child(4)    { animation-delay: .18s; }.films .screening-card:nth-child(5)    { animation-delay: .24s; }.films .screening-card:nth-child(n+6)  { animation-delay: .3s;  }@media (prefers-reduced-motion: reduce) {.films .day-block,.films .screening-card { animation: none; }}</style><script>
/* ============================================================
   Nova Cinema Ã¢ÂÂ Now Showing filter (Isotope + Tempus Dominus)	 
   ============================================================ */
	
document.addEventListener("DOMContentLoaded", function () {
  if (typeof Isotope === "undefined") return;

  var filmsContainer = document.querySelector(".films");
  if (!filmsContainer) return;

  var toArray = function (list) { return Array.prototype.slice.call(list); };

  // ---------- 0. Prune screenings that have already started ----------
  // The back end caches the page once a day, so screenings from earlier today
  // are still in the markup. Remove them client-side, then any day block and
  // any film left with nothing to show, before Isotope indexes the DOM.
  // Uses the visitor's clock, so it is only exact for visitors on UK time.
  (function pruneStartedScreenings() {
    var GRACE_MINUTES = 0;   // e.g. 15 keeps a screening visible 15 min after it starts
    var cutoff = new Date(Date.now() - GRACE_MINUTES * 60000);

    // Start time of a card. Prefers data-time="HH:mm" if the back end ever
    // adds it; otherwise parses the "8:00 pm" heading.
    function screeningStart(card) {
      var date = card.getAttribute("data-date");
      if (!date) {
        var day = card.closest(".day-block");
        date = day && day.getAttribute("data-date");
      }
      if (!date) return null;

      var text = card.getAttribute("data-time");
      if (!text) {
        var label = card.querySelector("h5");
        text = label ? label.textContent : "";
      }
      var m = /(\d{1,2})(?::(\d{2}))?\s*(am|pm)?/i.exec(text || "");
      if (!m) return null;

      var h = +m[1], min = m[2] ? +m[2] : 0;
      if (m[3]) {
        var ap = m[3].toLowerCase();
        if (ap === "pm" && h < 12) h += 12;
        if (ap === "am" && h === 12) h = 0;
      }
      var p = date.split("-");
      return new Date(+p[0], +p[1] - 1, +p[2], h, min, 0, 0);
    }

    toArray(filmsContainer.querySelectorAll(".screening-card")).forEach(function (card) {
      var start = screeningStart(card);
      if (start && start < cutoff) card.parentNode.removeChild(card);
    });
    toArray(filmsContainer.querySelectorAll(".day-block")).forEach(function (day) {
      if (!day.querySelector(".screening-card")) day.parentNode.removeChild(day);
    });
    toArray(filmsContainer.querySelectorAll(".movie.item")).forEach(function (film) {
      if (!film.querySelector(".day-block")) film.parentNode.removeChild(film);
    });

    // A date with nothing left (today, late in the evening) loses its tab
    // and its datepicker entry too, so the page never opens on an empty day.
    var datesLeft = {};
    toArray(filmsContainer.querySelectorAll(".screening-card[data-date]")).forEach(function (card) {
      datesLeft[card.getAttribute("data-date")] = true;
    });

    var tabs = toArray(document.querySelectorAll("#dateFilterTabs [data-filter-date]"));
    var lostActive = false;
    tabs.forEach(function (tab) {
      var d = tab.getAttribute("data-filter-date");
      if (!d || d === "*" || datesLeft[d]) return;
      if (tab.classList.contains("active")) lostActive = true;
      var li = tab.closest("li") || tab;
      li.parentNode.removeChild(li);
    });
    if (lostActive) {
      var next = document.querySelector("#dateFilterTabs [data-filter-date]");
      if (next) next.classList.add("active");
    }

    if (typeof availableDates !== "undefined" && Array.isArray(availableDates)) {
      availableDates = availableDates.filter(function (d) { return datesLeft[d]; });
    }
  })();

  // ---------- OUTER Isotope (films) Ã¢ÂÂ the only Isotope instance ----------
  var isoOuter = new Isotope(filmsContainer, {
    itemSelector: ".movie.item",
    layoutMode: "vertical",
    transitionDuration: "0.4s",
    stagger: 30,
    getSortData: {
        nextScreening: function(element) {
            var date = element.getAttribute("data-nextscreening");

            if (!date) {
                return Infinity;
            }

            return new Date(date.replace(" ", "T")).getTime();
        }
    },

    sortBy: "nextScreening",
    sortAscending: true
  });

  // "No results" block, registered as a normal item so Isotope lays it out
  var noResults = document.createElement("div");
  noResults.className = "movie item no-results text-center py-5 fs-5 text-muted w-100";
  noResults.textContent = "Sorry, there aren't any shows that match your filters.";
  filmsContainer.appendChild(noResults);
  isoOuter.appended(noResults);

  // Static element lists (the DOM does not change after load)
  var filmEls   = toArray(filmsContainer.querySelectorAll(".movie.item:not(.no-results)"));
  var dayBlocks = toArray(filmsContainer.querySelectorAll(".day-block"));
  var cards     = toArray(filmsContainer.querySelectorAll(".screening-card"));

  // ---------- Filter state ----------
  var filters = { date: "", genre: "", certificate: "" };

  function buildSelector() {
    var selector = "";
    if (filters.date)        selector += ".d-" + filters.date;
    if (filters.genre)       selector += "." + filters.genre;
    if (filters.certificate) selector += ".cert-" + filters.certificate;
    return selector;                       // "" = show everything
  }

  window.applyFilters = function () {
    var selector = buildSelector();

    // 1. screening cards Ã¢ÂÂ pure class writes, no layout reads
    cards.forEach(function (card) {
      card.classList.toggle("d-none", !!selector && !card.matches(selector));
    });

    // 2. day blocks Ã¢ÂÂ hide days with no visible screenings
    dayBlocks.forEach(function (day) {
      day.classList.toggle("d-none", !day.querySelector(".screening-card:not(.d-none)"));
    });

    // 3. films Ã¢ÂÂ Isotope shows/hides whole films (with the fade)
    var visibleFilms = 0;
    filmEls.forEach(function (film) {
      var show = !!film.querySelector(".day-block:not(.d-none)");
      film.setAttribute("data-visible", show ? "1" : "0");
      if (show) visibleFilms++;
    });

    isoOuter.arrange({
      filter: function (el) {
        if (el.classList.contains("no-results")) return visibleFilms === 0;
        return el.getAttribute("data-visible") === "1";
      }
    });

    updateFilterLinkState();
  };

  // ---------- Filter link highlight ----------
  var filterLink = document.querySelector('[data-bs-target="#modal-filter"]');
  function updateFilterLinkState() {
    if (!filterLink) return;
    filterLink.classList.toggle("active", !!(filters.genre || filters.certificate));
  }

  // ---------- Day tabs ----------
  var dateTabs = toArray(document.querySelectorAll(
    "#dateFilterTabs a[data-filter-date], #dateFilterTabs button[data-filter-date]"
  ));

  function setActiveTab(date) {
    dateTabs.forEach(function (a) {
      a.classList.toggle("active", a.dataset.filterDate === date);
    });
  }

  var dateFilterWrap = document.querySelector(".isotope-filter");
  if (dateFilterWrap) {
    dateFilterWrap.addEventListener("click", function (e) {
      var link = e.target.closest("[data-filter-date]");
      if (!link) return;
      e.preventDefault();

      var d = link.dataset.filterDate;
      filters.date = (d && d !== "*") ? d : "";
      setActiveTab(filters.date);
      syncPickerToFilters();
      applyFilters();
    });
  }

  // ---------- Modal: genre / certificate ----------
  var applyFilterBtn = document.getElementById("applyFilterBtn");
  if (applyFilterBtn) {
    applyFilterBtn.addEventListener("click", function (e) {
      e.preventDefault();

      var genreVal = document.getElementById("filterGenre").value;
      filters.genre = (genreVal && genreVal !== "Genre") ? genreVal : "";

      var certVal = document.getElementById("filterCertificate").value;
      filters.certificate = (certVal && certVal !== "Age Rating") ? certVal : "";

      // filters.date is owned by the datepicker change handler / the tabs

      applyFilters();

      var modalEl = document.getElementById("modal-filter");
      var modal = modalEl && bootstrap.Modal.getInstance(modalEl);
      if (modal) modal.hide();
    });
  }

  // ---------- Modal: Tempus Dominus datepicker ----------
  var picker = null;
  var syncingPicker = false;   // guard: programmatic picker changes must not feed back

  function toLocalIso(d) {     // local calendar date, never toISOString() (UTC)
    return d.getFullYear() + "-" +
      String(d.getMonth() + 1).padStart(2, "0") + "-" +
      String(d.getDate()).padStart(2, "0");
  }

  function fromIso(iso) {      // "yyyy-MM-dd" -> local Date, no UTC shift
    var p = iso.split("-");
    return new Date(+p[0], +p[1] - 1, +p[2]);
  }

  function syncPickerToFilters() {
    if (!picker) return;
    syncingPicker = true;
    try {
      if (filters.date) {
        picker.dates.setValue(new tempusDominus.DateTime(fromIso(filters.date)));
      } else {
        picker.dates.clear();
      }
    } catch (err) { /* cosmetic only */ }
    syncingPicker = false;
  }

  var filterDateEl = document.getElementById("filterDate");
  if (filterDateEl && typeof tempusDominus !== "undefined") {
    var restrictions = {};
    if (typeof availableDates !== "undefined" && availableDates.length) {
      restrictions.enabledDates = availableDates.map(fromIso);   // whitelist
    }

    picker = new tempusDominus.TempusDominus(filterDateEl, {
      display: {
        theme: "light",
        icons: {
          type: "icons",
          time: "fa-solid fa-clock",
          date: "fa-solid fa-calendar",
          up: "fa-solid fa-arrow-up",
          down: "fa-solid fa-arrow-down",
          previous: "fa-solid fa-chevron-left",
          next: "fa-solid fa-chevron-right",
          today: "fa-solid fa-calendar-check",
          clear: "fa-solid fa-trash",
          close: "fa-solid fa-xmark"
        },
        components: {
          calendar: true, date: true, month: true, year: true, decades: true,
          clock: false
        },
        buttons: { today: true, clear: true, close: true }
      },
      localization: { format: "dd/MM/yyyy" },   // what the user sees
      restrictions: restrictions
    });

    filterDateEl.addEventListener("change.td", function (ev) {
      if (syncingPicker) return;
      if (ev.detail && ev.detail.date) {
        filters.date = toLocalIso(ev.detail.date);
      } else {
        filters.date = "";
      }
      setActiveTab(filters.date);
      // the filter itself is applied on "Apply & Return"
    });
  }

  // ---------- Initial render: ONE pass, on the tab the server marked active ----------
  var initialTab =
    document.querySelector("#dateFilterTabs .active[data-filter-date]") ||
    dateTabs[0] || null;

  if (initialTab) {
    var d0 = initialTab.dataset.filterDate;
    filters.date = (d0 && d0 !== "*") ? d0 : "";
    setActiveTab(filters.date);
    syncPickerToFilters();
  }
  applyFilters();
});
</script><div class="isotope-filter filter col-md-7 ps-lg-2 align-items-center d-flex" id="dateFilterWrapper" data-show-id="0"><div class="d-flex align-items-center w-100"><!-- Prev button --><button class="nav-link me-lg-2 pe-1 pe-lg-3 py-0 text-uppercase border-black" id="prevDates" disabled="">&laquo;</button><!-- Date tabs --><ul class="nav nav-tabs border-0 flex-row d-flex flex-nowrap" id="dateFilterTabs"><!-- Today --><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-12"><span class="d-none d-md-inline">Today</span><span class="d-inline d-md-none">Today</span></a></li><!-- Tomorrow --><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-13"><span class="d-none d-md-inline">Tomorrow</span><span class="d-inline d-md-none">Tue</span></a></li><!-- Days +2 to +4: day name --><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-14"><span class="d-none d-md-inline">Wednesday</span><span class="d-inline d-md-none">Wed</span></a></li><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-15"><span class="d-none d-md-inline">Thursday</span><span class="d-inline d-md-none">Thu</span></a></li><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-16"><span class="d-none d-md-inline">Friday</span><span class="d-inline d-md-none">Fri</span></a></li><!-- Day +5 onwards: date --><li class="nav-item mx-1 date-page d-none"><a class="filter-item nav-link px-3 py-0 text-uppercase border-black" data-filter-date="2026-10-17"><span class="d-none d-md-inline">17 October</span><span class="d-inline d-md-none">17 Oct</span></a></li><li class="nav-item mx-1 date-pag