/* --- Slider: reguły, które wycina UCSS -----------------------------------
   Bootstrap przełącza slajdy DOKŁADAJĄC KLASY W TRAKCIE ANIMACJI: .next,
   .prev, .left, .right. W gotowym HTML-u tych klas nie ma, więc UCSS uznaje
   je za nieużywane i kasuje. Sprawdzone na wygenerowanym arkuszu: z reguły

       .carousel-inner>.active,.carousel-inner>.next,.carousel-inner>.prev{display:block}

   zostaje samo `.carousel-inner>.active`. Wchodzący slajd ma więc przez cały
   przebieg animacji `display:none` i pojawia się dopiero na końcu - stąd
   "przeskok" zamiast przenikania. Razem z nim znika komplet reguł
   `.carousel-fade`, które odpowiadają za samo przenikanie.

   Poniżej jest WIERNA KOPIA tych reguł: część "Bootstrap" z css/bootstrap.min.css
   motywu rodzica, część "Specto" z jego style.css, w oryginalnej kolejności.
   Nic tu nie jest naszym pomysłem - to odtworzenie tego, co usunął optymalizator.

   WŁAŚCIWYM rozwiązaniem jest wyłączenie UCSS albo dopisanie tych selektorów
   do "UCSS Allowlist" (LiteSpeed Cache -> Page Optimization -> Tuning - CSS).
   Gdy UCSS jest wyłączony, blok poniżej jest nieszkodliwym powtórzeniem:
   wypisujemy go przed arkuszami, więc oryginały i tak biorą górę. */

/* Bootstrap 3.3.6 - przesuwanie slajdów */
.carousel-inner>.next,.carousel-inner>.prev{display:block;position:absolute;top:0;width:100%}
.carousel-inner>.next{left:100%}
.carousel-inner>.prev{left:-100%}
.carousel-inner>.next.left,.carousel-inner>.prev.right{left:0}
.carousel-inner>.active.left{left:-100%}
.carousel-inner>.active.right{left:100%}
@media all and (transform-3d),(-webkit-transform-3d){
.carousel-inner>.item{-webkit-transition:-webkit-transform .6s ease-in-out;transition:transform .6s ease-in-out;-webkit-backface-visibility:hidden;backface-visibility:hidden;-webkit-perspective:1000;perspective:1000}
.carousel-inner>.item.active.right,.carousel-inner>.item.next{left:0;-webkit-transform:translate3d(100%,0,0);transform:translate3d(100%,0,0)}
.carousel-inner>.item.active.left,.carousel-inner>.item.prev{left:0;-webkit-transform:translate3d(-100%,0,0);transform:translate3d(-100%,0,0)}
.carousel-inner>.item.active,.carousel-inner>.item.next.left,.carousel-inner>.item.prev.right{left:0;-webkit-transform:translate3d(0,0,0);transform:translate3d(0,0,0)}
}

/* Specto style.css - przenikanie (carousel-fade). Musi być PO Bootstrapie:
   zeruje przesuwanie w poziomie i zamienia je na zmianę przezroczystości. */
.carousel-fade .carousel-inner .item{transition-property:opacity;opacity:0}
.carousel-fade .carousel-inner .active{opacity:1}
.carousel-fade .carousel-inner .active.left,.carousel-fade .carousel-inner .active.right{z-index:1;left:0;opacity:0}
.carousel-fade .carousel-inner .next.left,.carousel-fade .carousel-inner .prev.right{opacity:1}
.carousel-fade .carousel-control{z-index:2}
@media all and (transform-3d),(-webkit-transform-3d){
.carousel-fade .carousel-inner>.item.next,.carousel-fade .carousel-inner>.item.active.right{-webkit-transform:translate3d(0,0,0);transform:translate3d(0,0,0);opacity:0}
.carousel-fade .carousel-inner>.item.prev,.carousel-fade .carousel-inner>.item.active.left{-webkit-transform:translate3d(0,0,0);transform:translate3d(0,0,0);opacity:0}
.carousel-fade .carousel-inner>.item.next.left,.carousel-fade .carousel-inner>.item.prev.right,.carousel-fade .carousel-inner>.item.active{-webkit-transform:translate3d(0,0,0);transform:translate3d(0,0,0);opacity:1}
}

