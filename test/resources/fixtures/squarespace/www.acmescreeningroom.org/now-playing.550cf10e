city: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong><em>We are continuing our monthly Foreign Fridays series on August 21st! </em></strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>This monthly series will be hosted by Board Member, filmmaker, and travel lover, </em><strong><em>Jason Caridi.</em></strong><em> In addition to foreign films, the theme of this series will include those in which characters are in foreign places. The ways people interact with their novel surroundings is poetically tied in with how they interact with one another.</em></p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/foreign-fridays-certified-copy","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1786495194847-ME7XN6CQCXHDQBWC9XJ8/image+%282%29.png","contentType":"image/png","structuredContent":{"_type":"CalendarEvent","startDate":1787353200572,"endDate":1787364000572},"startDate":1787353200572,"endDate":1787364000572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"640x480","recordTypeLabel":"event"}],"pagePreviewContext":{"isPreviewMode":false,"memberAccessUrl":"/now-playing?format=json&requestAccess=true"}}