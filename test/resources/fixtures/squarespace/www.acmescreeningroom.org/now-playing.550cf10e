dContent":{"_type":"CalendarEvent","startDate":1789246800572,"endDate":1789253100572},"startDate":1789246800572,"endDate":1789253100572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"3060x1790","recordTypeLabel":"event"},{"id":"6a9867bf730b9449f312f379","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1788373893814,"updatedOn":1788375372380,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1788373893814,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1788373330868-TY6RBAEXH39Y0PJJDA3E","systemDataVariants":"2060x1030","systemDataSourceType":"JPG","filename":"my 911.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"fefefe","topRightAverage":"fefefe","bottomLeftAverage":"fefefe","bottomRightAverage":"fefefe","centerAverage":"919191","suggestedBgColor":"262626"},"urlId":"my-9/11-reflecting-on-the-25th-anniversary","title":"My 9/11: Reflecting on the 25th Anniversary Plus Q&amp;A with filmmaker","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a9867bf730b9449f312f379\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"d0f93e23227f4eaf4948\" id=\"block-d0f93e23227f4eaf4948\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>My 9/11</em> is an hour-long documentary depicting what it was like to be on the streets of Manhattan during the 2001 World Trade Center attack. Lambertville resident David Vanadia was living in New York City on September 11, 2001. He ran into the street with his camcorder and recorded people's reactions as the day unfolded. The result is a video that's tragic, insightful, and surprisingly human.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span class=\"sqsrte-text-color--accent\"><strong>You can register by making a </strong></span><a href=\"https://ci.ovationtix.com/35991/store/donations/63127\"><span class=\"sqsrte-text-color--accent\"><strong>donation to support ACME</strong></span></a><span class=\"sqsrte-text-color--accent\"><strong>, or if you'd prefer to skip the donation, simply drop us an email at </strong></span><a href=\"mailto:AcmeScreeningRoom@gmail.com\"><span class=\"sqsrte-text-color--accent\"><strong><em>AcmeScreeningRoom@gmail.com</em></strong></span></a><span class=\"sqsrte-text-color--accent\"><strong><em>\u200D  \u200D</em>and we\u2019ll get you set up.</strong></span></p></div>\n\n\n  \n<style id=\"container-styles\">#block-d0f93e23227f4eaf4948 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-d0f93e23227f4eaf4948 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-d0f93e23227f4eaf4948 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-d0f93e23227f4eaf4948 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-d0f93e23227f4eaf4948 {\n    }\n\n</style>\n\n<style id=\"ov