equency} weeks}}","subscriptionFrequency-pluralized-months":"{frequency, plural, one {Every month} other {Every {frequency} months}}","subscriptionFrequency-numberOfBillingCycles":" \u2022 For {numOfBillingCycles} payments","SubscriptionFrequency":"Subscription Frequency","savePercentage":"Save {percentage}","productQuantityStepperDecreaseLabel":"Decrease quantity by 1","productQuantityStepperIncreaseLabel":"Increase quantity by 1","payInFull":"Pay in full","paymentOptions":"Payment Options","payDepositAmount":"Pay {price} deposit","payDeposit":"Pay deposit","checkout":"Checkout","paymentPlanBreakdown":"Payment plan breakdown","dueToday":"Due today","dueOnDate":"Due on {date}","paymentMethodDisclaimer":"Your payment method will be charged based on this payment schedule. Taxes are calculated at checkout. Please review our policies prior to purchase for more details.","viewPaymentPlanLink":"View payment plan","remainingBalanceDue":"Remaining balance due in {count} payments."},"userAccountsContext":{"showSignInLink":false},"template":{"mobileStylesEnabled":true},"uiextensions":{"product-badge":"sqs-uiextensions-product-badge","product-body":"sqs-uiextensions-product-body","product-badge-mobile":"sqs-uiextensions-product-badge-mobile","product-body-mobile":"sqs-uiextensions-product-body-mobile","product-collection-item":"sqs-uiextensions-product-collection-item","scripts-enabled":false},"empty":false,"emptyFolder":false,"calendarView":false,"pagination":{"nextPage":true,"nextPageOffset":1786495456904,"nextPageUrl":"/?offset=1786495456904","pageSize":30},"upcoming":[{"id":"6a7d0bece670096283fdb2c1","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1788451767900,"updatedOn":1791219389100,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1788451767900,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1788462566548-BUP7GM3AYTD2MG394263","systemDataVariants":"1800x750","systemDataSourceType":"JPG","filename":"splice.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"ffffff","topRightAverage":"ffffff","bottomLeftAverage":"ffffff","bottomRightAverage":"ffffff","centerAverage":"ffffff","suggestedBgColor":"92897b"},"urlId":"monster-bash-lhff-2026","title":"2026 LHFF Opening Party: THE MONSTER BASH - Where Legends of the Screen Come to Life","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a7d0bece670096283fdb2c1\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"e739c232c2984972af8b\" id=\"block-e739c232c2984972af8b\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>The curtain rises on an evening ripped from horror's greatest eras, both old and new. Dust off your finest, round up your fellow fiends, and prepare your most spine-tingling ensemble for a party fit for the silver screen's most legendary ghouls. </strong>Coming to the Lambertville Halloween Film Festival <span class=\"sqsrte-text-color--custom\" style=\"color: #F31D1D;\"><strong>for one night only Friday, October 16 I 6:30-10 PM.</strong></span></p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>STARRING:</strong></p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">MC Adam Toscani will guide us through every turn of the evening while DJ Luis Reyes will sweep you off your feet</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>THE VINCENT PRICE COSTUME CONTEST</strong>&nbsp;plus prizes for Best Costume Overall</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">&nbsp;A silent auction of curiosities and treasures</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>THE DRACULA DANCE</strong>, performed with the Roxey Ballet as you witness the Count himself take the floor</p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>TAROT BY VICKI</strong> at <a target=\"_blank\" href=\"https://www.thereikischool.com/\">The Reiki School</a></p></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Photo booth and other ghoulish surprises\u2026</p></li></ul><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><span class=\"sqsrte-text-color--black\"><strong><em>Price: $35 | $55 VIP </em></strong></span>(includes a LHFF T-shirt and complimentary beverages)</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>Drinks available by donation. </em></p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">NOTE TO PARTICIPATING FILMMAKERS: before purchasing make sure to email AcmeLHFF@gmail.com to request a discount promo for tickets</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>WHERE: </strong><a target=\"_blank\" href=\"https://www.facebook.com/LambertvilleMusicHall/\"><strong>Lambertville Music Hall@57 Bridge Street</strong></a></p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Swag Bags by </strong><a target=\"_blank\" href=\"https://www.collectivebeleaf.com/\"><strong>Collective Beleaf Dispensary.</strong></a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-e739c232c2984972af8b {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-e739c232c2984972af8b .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-e739c232c2984972af8b {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-e739c232c2984972af8b {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-e739c232c2984972af8b {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-e739c232c2984972af8b {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-e739c232c2984972af8b .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\