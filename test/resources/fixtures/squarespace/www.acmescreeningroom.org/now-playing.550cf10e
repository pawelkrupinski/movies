130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/spotlight-on-cinema-wildwood-nj-slh8p","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1781623353725-Z43I29X6D0KWGJ4PRFSW/wildwoodnj_keyart2.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1787511600572,"endDate":1787515200572},"startDate":1787511600572,"endDate":1787515200572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1440x1660","recordTypeLabel":"event"},{"id":"6a84676c43164335a2dd884a","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1787062306204,"updatedOn":1787062302214,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1787062306204,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1785887475896-8IZ287YZB8DMK1UWKQ5K","systemDataVariants":"1400x700","systemDataSourceType":"JPG","filename":"once.jpg","mediaFocalPoint":{"x":0.870833260672433,"y":0.16309520176478798,"source":3},"colorData":{"topLeftAverage":"6f603d","topRightAverage":"665a3a","bottomLeftAverage":"48462e","bottomRightAverage":"473e25","centerAverage":"030c0d","suggestedBgColor":"3a2f1d"},"urlId":"once-upon-a-time-in-a-cinema-blkwp","title":"Once Upon a Time in a Cinema ","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a84676c43164335a2dd884a\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"655f6494ce07a55e06b5\" id=\"block-655f6494ce07a55e06b5\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">ONCE UPON A TIME IN A CINEMA, a comedy-drama set in a small-town cinema during one eventful Friday night screening from hell. Over the course of one evening, the film follows the travails of beleaguered cinema owner Earl Clancy (Colin Morgan) as he faces a myriad of disasters, any one of which could sink him. Drawing from writer/director David Gleeson\u2019s own experience growing up in a family of cinema owners where his father\u2019s 78-year career marked the longest in the cinema business in Ireland, if not the world, ONCE UPON A TIME IN A CINEMA is a love letter to a peculiarly Irish cinema experience, which was as much about connecting with people as it was about the movie.</p><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated NR, 1h32m</p><p class=\"sqsrte-small\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=-A6qeJbwVSw\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-655f6494ce07a55e06b5 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-655f6494ce07a55e06b5 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-655f6494ce07a55e06b5 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      