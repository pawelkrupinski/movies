--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-4e2769b93ed80c33878c {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-4e2769b93ed80c33878c {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p class=\"MsoNormal\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>\uD83D\uDD2A BONUS: Your ticket includes FREE entry to the <em>Nightmare in New Hope</em> Horror Prop Gallery in New Hope on Sunday, October 18! ($10 value)</strong></p><p class=\"MsoNormal\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Make it a double feature of fear.</strong> After the film, step into the gallery to see the season\u2019s biggest draw up close: <strong>Sidney Prescott\u2019s jacket</strong>. It\u2019s on display only through the end of October, so don\u2019t miss your chance to see this piece of horror history before it disappears.</p><p class=\"MsoNormal\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>Watch the movie. Then come and see the jacket. Just don\u2019t answer the phone.</em></p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/scream-1996","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1791766022687-7VNH1BZ6NT4GNKA77I02/Scream.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1792342800572,"endDate":1792349400572},"startDate":1792342800572,"endDate":1792349400572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"205x275","recordTypeLabel":"event"},{"id":"6ac5959d0b7e5c1be3fbf067","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1791334158898,"updatedOn":1791766169944,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1791334158898,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1791333910345-73XTEN9VUYVBQXW1L949","systemDataVariants":"480x360","systemDataSourceType":"JPG","filename":"the lodger.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"000000","topRightAverage":"000000","bottomLeftAverage":"000000","bottomRightAverage":"000000","centerAverage":"1d1a1b","suggestedBgColor":"50413f"},"urlId":"alfred-hitchcocks-the-lodger-with-film-scholar-matthew-sorrento","title":"2026 LHFF Alfred Hitchcock's The Lodger with film scholar Matthew Sorrento","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac5959d0b7e5c1be3fbf067\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"09203c31f65d55bc69f3\" id=\"block-09203c31f65d55bc69f3\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">A killer called \"The Avenger\" is stalking fog-bound London, and every victim has golden hair. One night a pale, quiet stranger (Ivor Novello) knocks at the Buntings' door looking for a room. He keeps odd hours, paces the floor, and turns the pictures of blonde women to face the wall. His landlady grows uneasy. Her daughter Daisy, a fashion model, finds him fascinating. Her suitor Joe, a detective on the Avenger case, is starting to wonder whether the man upstairs is the one he's hunting.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Hitchcock later called this silent film the first true \"Hitchcock picture.\" It has his first cameo and the wrongly accused man he'd return to for fifty years. It also has some startling visual inventions, including a glass floor that lets us watch the lodger pace from below. A hundred years on, it's still a tense, stylish thriller and a perfect introduction to silent cinema.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Matthew Sorrento, PhD joins us for a post screening discussion.</strong> Matt&nbsp;is an American film scholar, critic and editor whose work centers on genre cinema, especially crime film and noir.&nbsp;He is editor-in-chief of Film International and Retreats from Oblivion: The Journal of NoirCon, and teaches film and media studies at Rutgers University. Film International is a long-running academic journal with a companion site, FilmInt, covering film, television, and moving image studies through critical, historical and theoretical essays, along with interviews and reviews.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">1927, 1h29m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"></p></div>\n\n\n  \n<style id=\"container-styles\">#block-09203c31f65d55bc69f3 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-09203c31f65d55bc69f3 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-09203c31f65d55bc69f3 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-09203c31f65d55bc69f3 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-09203c31f65d55bc69f3 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-09203c31f65d55bc69f3 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-09203c31f65d55bc69f3 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"9f5a5bda80d59cb2ff0b\" id=\"block-9f5a5bda80d59cb2ff0b\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1293553\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-9f5a5bda80d59cb2ff0b {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-9f5a5bda80d59cb2ff0b {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Matthew Sorrento, PhD joins us for a post screening discussion. </strong>Matt&nbsp;is an American film scholar, critic and editor whose work centers on genre cinema, especially crime film and noir.&nbsp;He is editor-in-chief of Film International and Retreats from Oblivion: The Journal of NoirCon, and teaches film and media studies at Rutgers University. Film International is a long-running academic journal with a companion site, FilmInt, covering film, television, and moving image studies through critical, historical and theoretical essays, along with interviews and reviews</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/alfred-hitchcocks-the-lodger-with-film-scholar-matthew-sorrento","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1791333910345-73XTEN9VUYVBQXW1L949/the+lodger.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1792350000572,"endDate":1792357200572},"startDate":1792350000572,"endDate":1792357200572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"480x360","recordTypeLabel":"event"},{"id":"6a98623f02e88720aea9d499","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1788371981798,"updatedOn":1789201727004,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1788371981798,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1788371741655-AL4516DMF9JO1KIWYCMU","systemDataVariants":"7979x5338,2500w","systemDataSourceType":"JPG","filename":"ad pic.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"af864f","topRightAverage":"917455","bottomLeftAverage":"b58e5b","bottomRightAverage":"947c5f","centerAverage":"a17944","suggestedBgColor":"7f5a41"},"urlId":"spotlight-on-cinema-frankenstein-1910-he-who-gets-slapped-1924-with-live-music-accompaniment","title":"Spotlight on Cinema Double Bill: Frankenstein (1910) + He Who Gets Slapped (1924) with Live Music","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a98623f02e88720aea9d499\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"f3f7f1bf15c00406f1b4\" id=\"block-f3f7f1bf15c00406f1b4\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>This event will be hosted by Dylan Mayer and is a part of his Spotlight on [Cinema] series, aiming to bring due attention to a versatile lineup of titles&nbsp;and artists.</strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>These films have never been seen (nay heard!) this way before. It will be a spooky time and we look forward to seeing you all there!</strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">First up is the first ever filmed version of Mary Shelley\u2019s Frankenstein, in which a young medical student\u2019s attempt to create the perfect human results in a misshapen monster.&nbsp;Live music for this will be performed by&nbsp;<a target=\"_blank\" href=\"https://kabelnoise.bandcamp.com/album/absence-live-at-no-fi-nj-4-3-26\">KABEL</a>, \u201Can evolving project centered around impractical electronics and forced personal evolution.\u201D</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Then comes the feature presentation of He Who Gets Slapped, in which Lon Chaney takes center stage as HE, a tortured clown whose signature act is receiving an endless series of slaps to the face.&nbsp;Live music for this will be performed by Karson Meckeler and Corey Kimmel. \u201CKarson and Corey started honing their noisy improvisational chops together as the rhythm section in experimental rock outfit Rita Fishbone. Currently they play in the trio&nbsp;<a target=\"_blank\" href=\"https://mshoney.bandcamp.com/\">Ms. Honey</a>&nbsp;with Kacey Meckeler.\u201D</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Frankenstein, 1910, 12min</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">He Who Gets Slapped, 1924, 70min</p></div>\n\n\n  \n<style id=\"container-styles\">#block-f3f7f1bf15c00406f1b4 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-f3f7f1bf15c00406f1b4 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-f3f7f1bf15c00406f1b4 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-f3f7f1bf15c00406f1b4 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-f3f7f1bf15c00406f1b4 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-f3f7f1bf15c00406f1b4 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-f3f7f1bf15c00406f1b4 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"e0affcdeecee1aea21ca\" id=\"block-e0affcdeecee1aea21ca\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1290796\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-e0affcdeecee1aea21ca {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-e0affcdeecee1aea21ca {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Spotlight on Cinema is Dylan Mayer's film series aiming to bring due attention to a versatile lineup of titles&nbsp;and artists.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Come enjoy some Mischief Night mayhem with two seasonally appropriate silent films, each with their own seasonally appropriate Live Music accompaniment!</strong></p><p style=\"text-align: start; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We look forward to seeing you there.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/spotlight-on-cinema-frankenstein-1910-he-who-gets-slapped-1924-with-live-music-accompaniment","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1788371741655-AL4516DMF9JO1KIWYCMU/ad+pic.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1793401200572,"endDate":1793412000572},"startDate":1793401200572,"endDate":1793412000572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"7979x5338","recordTypeLabel":"event"},{"id":"6ac1816ff06ab7146f1a0bf8","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1791071647892,"updatedOn":1791501212585,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1791071647892,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1791066525892-V4QB4L1K242JVD33OJCI","systemDataVariants":"7516x4483,2500w","systemDataSourceType":"JPG","filename":"website option.jpg","mediaFocalPoint":{"x":0.2982705532843681,"y":0.5559937031012798,"source":3},"colorData":{"topLeftAverage":"2d1f0d","topRightAverage":"280803","bottomLeftAverage":"382813","bottomRightAverage":"260807","centerAverage":"1d0c03","suggestedBgColor":"5c4548"},"urlId":"theatre-in-theatre","title":"Theatre in Theatre: \u201CClue\u201D&nbsp;with&nbsp;Mask &amp; Zany (New Hope-Solebury High School theatre club) Live Performance and Q&amp;A","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac1816ff06ab7146f1a0bf8\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"8a84dc8856b3d5dec5a2\" id=\"block-8a84dc8856b3d5dec5a2\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>This event is hosted by Dylan Mayer in collaboration with </strong><a target=\"_blank\" href=\"https://maskzany.wixsite.com/maskandzany\"><strong>Mask &amp; Zany</strong></a><strong> (the New Hope-Solebury High School theatre club), who will perform live in house a sneak peak of their upcoming stage production of </strong><a target=\"_blank\" href=\"https://www.vancoevents.com/us/events/landing/69054?qr=true&amp;qr=true\"><strong>Clue (show dates: November 19, 20, and 21)</strong></a><strong> as well as field a post-screening Q&amp;A! </strong>We look forward to seeing you there.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>About the film: Six colorful dinner guests + one dead dinner host. The killer is among them! Who did it? And where? And with what? Aided by Wadsworth the butler (played by the late, great Tim Curry), the suspects must suss out the culprit before the body count&nbsp;rises\u2026</em></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">1985, Rated PG, 1h37m</p></div>\n\n\n  \n<style id=\"container-styles\">#block-8a84dc8856b3d5dec5a2 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-8a84dc8856b3d5dec5a2 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-8a84dc8856b3d5dec5a2 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-8a84dc8856b3d5dec5a2 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-8a84dc8856b3d5dec5a2 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-8a84dc8856b3d5dec5a2 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-8a84dc8856b3d5dec5a2 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"d0018a5e81db445de13a\" id=\"block-d0018a5e81db445de13a\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1293317\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-d0018a5e81db445de13a {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-d0018a5e81db445de13a {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">This event is hosted by Dylan Mayer in collaboration with <a target=\"_blank\" href=\"https://maskzany.wixsite.com/maskandzany\">Mask &amp; Zany</a> (the New Hope-Solebury High School theatre club), who will perform live in house a sneak peak of their upcoming stage production of <a target=\"_blank\" href=\"https://www.vancoevents.com/us/events/landing/69054?qr=true&amp;qr=true\">Clue (show dates: November 19, 20, and 21)</a> as well as field a post-screening Q&amp;A!</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We look forward to seeing you there.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/theatre-in-theatre","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1791066525892-V4QB4L1K242JVD33OJCI/website+option.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1794614400572,"endDate":1794625200572},"startDate":1794614400572,"endDate":1794625200572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"7516x4483","recordTypeLabel":"event"},{"id":"6aa50d3ef8867c253322fe35","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1789201957942,"updatedOn":1789202047536,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1789201957942,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1789201876384-NDFIEY8QXNWJJACMNTJR","systemDataVariants":"1024x674","systemDataSourceType":"JPG","filename":"thepeasants_poster-copy-2-1024x674.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"11110f","topRightAverage":"0f1110","bottomLeftAverage":"927556","bottomRightAverage":"0a0909","centerAverage":"1b1514","suggestedBgColor":"423125"},"urlId":"spotlight-on-cinema-the-peasants","title":"Spotlight on&nbsp;Cinema: \u201CThe Peasants\u201D&nbsp;with&nbsp;Introduction by Dylan Mayer AND post-screening Q&amp;A with writers/directors DK Welchman and Hugh Welchman","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6aa50d3ef8867c253322fe35\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"5e86d8609bbd60015a8e\" id=\"block-5e86d8609bbd60015a8e\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>This event will be hosted by Dylan Mayer and is a part of his Spotlight on [Cinema] series, aiming to bring due attention to a versatile lineup of titles&nbsp;and artists.</strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Come for a pre-show presentation by Dylan Mayer as well as a post-screening virtual Q&amp;A with The Peasants\u2019 filmmakers: writers/directors DK Welchman and Hugh Welchman!! (DK Welchman and Hugh Welchman received Academy Award nominations in 2018 in the Best Animated Feature category for Loving Vincent. Prior to that Hugh Welchman won an Academy Award for Best Animated Short Film in 2008.) </strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>About the film: From the writers/directors of the acclaimed feature Loving Vincent comes THE PEASANTS - a hand-painted animation bravura telling the chain reaction of jealousy and deceit that ripples through a small village (a hotbed of gossip and ongoing feuds) when the richest (and oldest) landowner sets his marital sights on young Jagna\u2026 (The film's screenplay is based on W\u0142adys\u0142aw Reymont's Nobel Prize winning novel of the same name.)</em></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">2023, Rated R, 1h54m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">DK Welchman and Hugh Welchman\u2019s Loving Vincent (released in 2017) was the first of its kind: a feature film animated entirely with oil paint. In the wake of that film\u2019s success, writer/director DK Welchman said \u201CNext time I\u2019d want to be much freer in the terms of story and imagery.\u201D The Peasants <em>is that time</em>. Around 40,000 oil painted frames create the 1,405 shots in this film, crafted by 120 oil paint artists who worked in 4 different countries across the span of 5 years. The Peasants is not only an example of great animation - and not only an example of great cinema - it is an example of a great magic trick, in that its illusion becomes more impressive the more that is learned about it\u2026</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"></p></div>\n\n\n  \n<style id=\"container-styles\">#block-5e86d8609bbd60015a8e {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-5e86d8609bbd60015a8e .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-5e86d8609bbd60015a8e {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-5e86d8609bbd60015a8e {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-5e86d8609bbd60015a8e {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-5e86d8609bbd60015a8e {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-5e86d8609bbd60015a8e .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"ae69e4dbbe10e768d287\" id=\"block-ae69e4dbbe10e768d287\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1291596\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-ae69e4dbbe10e768d287 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-ae69e4dbbe10e768d287 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Spotlight on Cinema is Dylan Mayer's film series aiming to bring due attention to a versatile lineup of titles&nbsp;and artists.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Come for a pre-show presentation by Dylan Mayer as well as a post-screening virtual Q&amp;A with The Peasants\u2019 filmmakers: writers/directors DK Welchman and Hugh Welchman!! </strong>(DK Welchman and Hugh Welchman received Academy Award nominations in 2018 in the Best Animated Feature category for Loving Vincent. Prior to that Hugh Welchman won an Academy Award for Best Animated Short Film in 2008.)</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">We look forward to seeing you there.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/spotlight-on-cinema-the-peasants","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1789201876384-NDFIEY8QXNWJJACMNTJR/thepeasants_poster-copy-2-1024x674.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1796428800572,"endDate":1796439600572},"startDate":1796428800572,"endDate":1796439600572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1024x674","recordTypeLabel":"event"}],"past":[{"id":"6ac58f694219f31768792efa","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1791333032339,"updatedOn":1791333114687,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1791333032339,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1791332536318-TCEDP0FQ5L4AVZIFFU19","systemDataVariants":"1280x720","systemDataSourceType":"JPG","filename":"maxresdefault (9).jpg","mediaFocalPoint":{"x":0.11060465994737205,"y":0.41907875655961013,"source":3},"colorData":{"topLeftAverage":"5f4e46","topRightAverage":"090402","bottomLeftAverage":"5a453f","bottomRightAverage":"060302","centerAverage":"2e241f","suggestedBgColor":"594a48"},"urlId":"knife-the-attempted-murder-of-salman-rushdie","title":"Knife: The Attempted Murder of Salman Rushdie","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac58f694219f31768792efa\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"465ea63db042c68467f1\" id=\"block-465ea63db042c68467f1\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Knife: The Attempted Murder of Salman Rushdie is inspired by Rushdie's memoir \"Knife: Meditations After an Attempted Murder.\" The film explores Rushdie's recovery in the broadest sense. Through Rushdie's wife Rachel Eliza Griffiths' personal footage, which has never been seen by the public, the doc follows the writer during his physical recovery as well as the recovery of his spirit and hope for the future.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated NR, 1h47m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=4Dntq0XUcls\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-465ea63db042c68467f1 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-465ea63db042c68467f1 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-465ea63db042c68467f1 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-465ea63db042c68467f1 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-465ea63db042c68467f1 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-465ea63db042c68467f1 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-465ea63db042c68467f1 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"ea67a07c70dc37b05d75\" id=\"block-ea67a07c70dc37b05d75\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1293143\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-ea67a07c70dc37b05d75 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-ea67a07c70dc37b05d75 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">More than a story of an assassination attempt\u2014this is a profound journey through the dark, found in the healing light of words and free expression.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/knife-the-attempted-murder-of-salman-rushdie","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1791332536318-TCEDP0FQ5L4AVZIFFU19/maxresdefault+%289%29.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1791745200572,"endDate":1791751800572},"startDate":1791745200572,"endDate":1791751800572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1280x720","recordTypeLabel":"event"},{"id":"6ac58abacc638647dbb4455d","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1791332180124,"updatedOn":1791332180571,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1791332180124,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1788937028285-U9AGCDCAEA9WGDYE9WRC","systemDataVariants":"3060x1790,2500w","systemDataSourceType":"PNG","filename":"Screenshot-2026-08-28-100006.png","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"a0c5cf","topRightAverage":"a2c6ce","bottomLeftAverage":"8b5330","bottomRightAverage":"925e39","centerAverage":"abc1c4","suggestedBgColor":"a9918f"},"urlId":"coyote-vs-acme-xzkhw-fjswd-5z3br-n5lmk","title":"Coyote vs. Acme","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac58abacc638647dbb4455d\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"ec53d3af43ca39bec2b6\" id=\"block-ec53d3af43ca39bec2b6\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">After decades of being blown to bits by bombs, demolished by dynamite, mangled by magnets, battered by boulders, trampled by trains, tricked by tunnels, sprung by springs, steamrolled by steamrollers, maligned by misfires, bedeviled by bungees, rattled by rockets, backstabbed by bat suits, rocked by rocket skates, upended by unicycles, quaked by quake pills, rubberized by rogue bands, and hurled headlong off every cliff in the Southwest, Wile E. Coyote (Genius) finally fights back. Teaming up with billboard accident lawyer Kevin Avery (Will Forte), he takes on slick corporate counsel Buddy Crane (John Cena) and ACME, Inc., the profit-obsessed conglomerate behind every one of the Coyote's chaotic catastrophes.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated PG, 1h43m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=H-43VeYGiPM\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-ec53d3af43ca39bec2b6 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-ec53d3af43ca39bec2b6 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-ec53d3af43ca39bec2b6 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-ec53d3af43ca39bec2b6 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-ec53d3af43ca39bec2b6 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-ec53d3af43ca39bec2b6 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-ec53d3af43ca39bec2b6 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scrip