igin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">The film weaves together rare archival footage, personal family tapes, and present-day reflections. It highlights how Johnson's lived experiences, exploration, and lifelong friendships with figures like Kelly Slater, Rob Machado, and Ben Harper shaped his sound and stories. It features an original score co-created by Johnson and the Hermanos Guti\u00E9rrez</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/jack-johnson-surfilmusic-yta8e-jf7z7-nxsyd","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1784596337396-O9VYB2KQNBNFMXWWUQRM/Buy-Tickets-3.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1787436000572,"endDate":1787440800572},"startDate":1787436000572,"endDate":1787440800572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"660x450","recordTypeLabel":"event"},{"id":"6a7bc0b34fcebd322ec6ab96","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1786495456904,"updatedOn":1786581871799,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1786495456904,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1786495194847-ME7XN6CQCXHDQBWC9XJ8","systemDataVariants":"640x480","systemDataSourceType":"PNG","filename":"image (2).png","mediaFocalPoint":{"x":0.5071427481515067,"y":0.2226190112885975,"source":3},"colorData":{"topLeftAverage":"ee3324","topRightAverage":"737381","bottomLeftAverage":"f8efdf","bottomRightAverage":"f7e3cb","centerAverage":"634b4a","suggestedBgColor":"b09272"},"urlId":"foreign-fridays-certified-copy","title":"Foreign Fridays: \"Certified Copy\" Plus Discussion with Jason Caridi ","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a7bc0b34fcebd322ec6ab96\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"377d212a4e62a7a86122\" id=\"block-377d212a4e62a7a86122\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p class=\"\" style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong><em>Foreign Fridays monthly series</em></strong><em> will be hosted by Board Member, filmmaker, and travel lover, </em><strong><em>Jason Caridi</em></strong><em>. In addition to foreign films, the theme of this series will include those in which characters are in foreign places. The ways people interact with their novel surroundings is poetically tied in with how they interact with one another.<br><br>Our next film is </em><strong><em>Abbas Kiarostami's Certified Copy</em></strong><em>. Similar to our last film Before Sunrise, this is two people walking and talking in a city in which neither of them reside. It is a beautiful meditation on what is \"real\", how we know, and if it even matters.</em></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">About the film: While touring Tuscany, Italy, promoting his new book, English author James (William Shimell) meets French store owner Elle (Juliette Binoche), and the two hit it off, deciding to spend a free day together. They travel to a nearby town, get coffee, visit a museum and pretend to be recently married in what turns out to be a popular wedding destination. As these two strangers get to know each other, however, it becomes clear there's more to their new relationship than meets the eye. <strong><em>Come for the film, stay for the discussion afterwards.</em></strong><em><br><br>We hope to see you there!</em></p></div>\n\n\n  \n<style id=\"container-styles\">#block-377d212a4e62a7a86122 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-377d212a4e62a7a86122 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-377d212a4e62a7a86122 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-377d212a4e62a7a86122 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-377d212a4e62a7a86122 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-377d212a4e62a7a86122 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-377d212a4e62a7a86122 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n 