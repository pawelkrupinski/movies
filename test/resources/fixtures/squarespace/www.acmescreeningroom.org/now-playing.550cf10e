div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--center \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1293316\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    2026 LHFF 3-Block Pass\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-51ea2d4d88b5b49aa0b0 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-51ea2d4d88b5b49aa0b0 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"41fb2a87198cd89204ca\" id=\"block-41fb2a87198cd89204ca\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Unlock full access to all three short film blocks on Saturday, October 17!</strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">From experimental avant-garde nightmares to pitch-black comedy and edge-of-your-seat psychological thrillers, the <strong>2026 LHFF 3-Block Pass</strong> guarantees your seat for the entire afternoon short film marathon at a special bundled price.</p><h3 style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">\uD83D\uDCFD\uFE0F Included Screening Lineup:</h3><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>12:00 PM \u2014 Block 1: Twisted Visions &amp; Heart-Stopping Horror</strong></p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>Experimental, avant-garde, boundary-pushing horror combined with pure, visceral, traditional horror. Includes post-screening discussion.</em></p></li></ul></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>2:00 PM \u2014 Block 2: Dead Funny</strong></p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>Horror/Halloween comedy, dark humor, and delightfully twisted laughs.</em></p></li></ul></li><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>3:45 PM \u2014 Block 3: Mind Games</strong></p><ul data-rte-list=\"default\"><li><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>Psychological and tension-driven thrillers designed to mess with your head. Includes post-screening discussion.</em></p></li></ul></li></ul></div>\n\n\n  \n<style id=\"container-styles\">#block-41fb2a87198cd89204ca {\n    \n    --stroke-style: none;--stroke-thickness: 2px;\n    \n      --tweak-text-block-stroke-color: hsla(var(--black-hsl), 1)\n;\n      \n      \n      \n    \n\n\n\n  }\n\n  #block-41fb2a87198cd89204ca .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-41fb2a87198cd89204ca {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-41fb2a87198cd89204ca {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  #block-41fb2a87198cd89204ca {\n      --tweak-text-block-blend\n  : normal;\n    }\n  \n\n  #block-41fb2a87198cd89204ca {\n    --blur-value: blur(15px);}\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-41fb2a87198cd89204ca {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-41fb2a87198cd89204ca .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-vars\">\n    #block-41fb2a87198cd89204ca {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Unlock full access to all three short film blocks on Saturday, October 17!</strong></p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">From experimental avant-garde nightmares to pitch-black comedy and edge-of-your-seat psychological thrillers, the <strong>2026 LHFF 3-Block Pass</strong> guarantees your seat for the entire afternoon short film marathon at a special bundled price.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/three-short-film-blocks-lhff-2026","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1791071142042-YN5E7BRZTNOVTGBKBH0Q/3+block.png","contentType":"image/png","structuredContent":{"_type":"CalendarEvent","startDate":1792252500572,"endDate":1792273200572},"startDate":1792252500572,"endDate":1792273200572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"680x420","recordTypeLabel":"event"},{"id":"6aaadd93f444ca49cc385e89","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1789583112185,"updatedOn":1791069729941,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1789583112185,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1789582901178-M7C15TVSP6KZTOUX57GN","systemDataVariants":"7979x5338,2500w","systemDataSourceType":"PNG","filename":"1_twisted_visions_and_heart_stopping_horror.png","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"0a0404","topRightAverage":"0a0404","bottomLeftAverage":"0a0404","bottomRightAverage":"0a0404","centerAverage":"0a0404","suggestedBgColor":"150e0e"},"urlId":"twisted-visions-experimental-avant-garde-boundary-pushing-horror","title":"2026 LHFF Twisted Visions: Experimental, avant-garde, boundary-pus