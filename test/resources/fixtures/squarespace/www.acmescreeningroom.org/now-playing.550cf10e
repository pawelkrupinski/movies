le-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>A Fall of Freedom Event: American Doctor  </em>bears visceral witness to the crisis in Gaza, transforming the grim realities of the operating room into an urgent portrait of humanitarian resolve.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/american-doctor","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1790811903068-P1TDIAMJ5KNWFHTV8API/maxresdefault+%288%29.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1791140400572,"endDate":1791146700572},"startDate":1791140400572,"endDate":1791146700572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1280x720","recordTypeLabel":"event"},{"id":"6abd9c68a51ba86359c4d48e","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1790811385924,"updatedOn":1790811387483,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1790811385924,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1788937028285-U9AGCDCAEA9WGDYE9WRC","systemDataVariants":"3060x1790,2500w","systemDataSourceType":"PNG","filename":"Screenshot-2026-08-28-100006.png","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"a0c5cf","topRightAverage":"a2c6ce","bottomLeftAverage":"8b5330","bottomRightAverage":"925e39","centerAverage":"abc1c4","suggestedBgColor":"a9918f"},"urlId":"coyote-vs-acme-xzkhw-fjswd-5z3br","title":"Coyote vs. Acme","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6abd9c68a51ba86359c4d48e\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"efad0897cb313b40c3de\" id=\"block-efad0897cb313b40c3de\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">After decades of being blown to bits by bombs, demolished by dynamite, mangled by magnets, battered by boulders, trampled by trains, tricked by tunnels, sprung by springs, steamrolled by steamrollers, maligned by misfires, bedeviled by bungees, rattled by rockets, backstabbed by bat suits, rocked by rocket skates, upended by unicycles, quaked by quake pills, rubberized by rogue bands, and hurled headlong off every cliff in the Southwest, Wile E. Coyote (Genius) finally fights back. Teaming up with billboard accident lawyer Kevin Avery (Will Forte), he takes on slick corporate counsel Buddy Crane (John Cena) and ACME, Inc., the profit-obsessed conglomerate behind every one of the Coyote's chaotic catastrophes.</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated PG, 1h43m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=H-43VeYGiPM\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-efad0897cb313b40c3de {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-efad0897cb313b40c3de .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-efad0897cb313b40c3de {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-efad0897cb313b40c3de {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-efad0897cb313b40c3de {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-efad0897cb313b40c3de {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-efad0897cb313b40c3de .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"0e39355fa96a3f678e28\" id=\"block-0e39355fa96a3f678e28\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1291236\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-0e39355fa96a3f678e28 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-0e39355fa96a3f678e28 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"text-align: start; ; white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">A hilarious, nostalgic, and unexpectedly heartfelt crowd-pleaser, <em>Coyote vs. Acme</em> introduces <em>Looney Tunes</em> mayhem -- and its iconic anvils -- to a new generation while rewarding longtime fans.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/coyote-vs-acme-xzkhw-fjswd-5z3br","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1788937028285-U9AGCDCAEA9WGDYE9WRC/Screenshot-2026-08-28-100006.png","contentType":"image/png","structuredContent":{"_type":"CalendarEvent","startDate":1791069000572,"endDate":1791075300572},"startDate":1791069000572,"endDate":1791075300572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"3060x1790","recordTypeLabel":"event"},{"id":"6abd9c6ea3f99d3caaa3b105","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1790811340758,"updatedOn":1790811342294,"starred":false,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1790811340758,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1790115260393-1J2VFHS4TA66ZXPERFHO","systemDataVariants":"680x420","systemDataSourceType":"PNG","filename":"black zombie.png","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"131313","topRightAverage":"131313","bottomLeftAverage":"111111","bottomRightAverage":"0f0f0f","centerAverage":"151515","suggestedBgColor":"3d3b3a"},"urlId":"black-zombie-cy2sj","title":"Black Zombie","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6abd9c6ea3f99d3caaa3b105\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"5734fa69141ec6986b11\" id=\"block-5734fa69141ec6986b11\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">BLACK ZOMBIE digs beneath the blood-soaked spectacle of modern horror to uncover the zombie's buried and unsettling origins. Long before it became associated with flesh-eating ghouls, the zombie was a living metaphor for slavery: not a monster, but the ultimate victim of colonial power. A symbol of stolen agency was recast as an object of fear, while Black spiritual traditions were distorted, sensationalized, and erased. Director Maya Annik Bedward traces the evolution of the zombie from colonial Haiti to contemporary Hollywood, reconsidering iconic films like WHITE ZOMBIE, NIGHT OF THE LIVING DEAD, and THE SERPENT AND THE RAINBOW alongside archival footage, v\u00E9rit\u00E9 scenes, and interviews with cultural historians, artists, and genre legends including Yves-Gr\u00E9gory Francois, Mambo Labelle D\u00E9esse, Slash, Tom Savini, and Zandash\u00E9 Brown. Part cultural reckoning, part horror remix, BLACK ZOMBIE exposes how a figure born from enslavement, spiritual belief, and resistance was transformed into one of pop culture's most profitable monsters. </p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated NR, 1h30m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=qxb3f3XumaE\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-5734fa6914