dn.com/content/v1/5ff89563cc0dcd7be5b5a538/1787337620198-NOQDVUZR9JDNGU1FFYEM/Closed+for+Staff+Vacation+Fri+Aug+28+-+Sun+Aug+30.png","contentType":"image/png","structuredContent":{"_type":"CalendarEvent","startDate":1787950800572,"endDate":1788141600572},"startDate":1787950800572,"endDate":1788141600572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"2000x1414","recordTypeLabel":"event"},{"id":"6a846a67564c510c7a41fb6b","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1787063311754,"updatedOn":1787337278046,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1787063311754,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1787063769129-DKA45RLDW1DIOCWXJ33X","systemDataVariants":"640x480","systemDataSourceType":"JPG","filename":"sddefault.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"000000","topRightAverage":"000000","bottomLeftAverage":"000000","bottomRightAverage":"000000","centerAverage":"c9c6d2","suggestedBgColor":"70818d"},"urlId":"wild-inside","title":"Wild Inside","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a846a67564c510c7a41fb6b\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"7f17cbe1eaa18b20d197\" id=\"block-7f17cbe1eaa18b20d197\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">On February 2, 2023, Flaco -- a male Eurasian eagle-owl, the largest species of owl in the world -- was discovered missing from his cage at the Central Park Zoo in Manhattan. What follows when Flaco, who had lived his entire life in captivity, was released in New York City is a surprising story revealing the delight, concern, and fascination of millions in the city and beyond. </p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Rated NR, 1h36m</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><a target=\"_blank\" href=\"https://www.youtube.com/watch?v=iQGppfBgRMk\">Watch Trailer</a></p></div>\n\n\n  \n<style id=\"container-styles\">#block-7f17cbe1eaa18b20d197 {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-7f17cbe1eaa18b20d197 .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-7f17cbe1eaa18b20d197 {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-7f17cbe1eaa18b20d197 {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-7f17cbe1eaa18b20d197 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-7f17cbe1eaa18b20d197 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-7f17cbe1eaa18b20d197 .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.button\" data-sqsp-block=\"button\" data-website-component-id=\"1e12088eaf43da0aceb7\" id=\"block-1e12088eaf43da0aceb7\"><div class=\"sqs-block-content\">\n\n\n\n  \n    \n    \n      \n      \n\n\n\n<div\n  class=\"sqs-block-button-container sqs-button-block-container-system_desktop sqs-block-button-container--right \"\n  data-animation-role=\"button\"\n  data-button-size=\"medium\"\n  data-button-type=\"primary\"\n  \n>\n  <a\n    href=\"https://ci.ovationtix.com/35991/production/1287467\"\n    class=\"sqs-block-button-element--medium sqs-button-element--primary sqs-block-button-element\"\n    data-sqsp-button\n    target=\"_blank\"\n  >\n    BUY TICKETS\n  </a>\n  \n\n\n\n</div>\n\n    \n  \n    \n    \n      \n    \n  \n\n\n<style>\n  #block-1e12088eaf43da0aceb7 {\n    --sqs-block-content-flex: 0;\n  }\n\n  \n  \n    \n      \n      \n    \n      \n      \n        \n      \n    \n  \n</style>\n<style class=\"transform-vars\">\n    #block-1e12088eaf43da0aceb7 {\n      --opacity: 100%;\n      --translate-x: 0px;\n      --translate-y: 0px;\n      --rotation: 0deg;\n      --scale-x: 100%;\n      --scale-y: 100%;\n      --skew-x: 0deg;\n      --skew-y: 0deg;\n      --origin-x: 50%;\n      --origin-y: 50%;\n      --block-transform: none;\n\n      opacity: var(--opacity, 1);\n      transform: var(--block-transform);\n      transform-origin: var(--origin-x) var(--origin-y);\n    }\n  </style><style class=\"transform-overrides-vars\">\n  \n</style>\n\n</div></div></div></div></div>","excerpt":"<p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><strong>Wild Inside</strong> chronicles the unforgettable true story of <strong>Flaco</strong>, the majestic Eurasian eagle-owl who captivated New York City after escaping captivity. Directed by acclaimed filmmaker Penny Lane, this moving documentary uses stunning crowd-sourced footage to trace Flaco\u2019s thrilling journey from a lifetime in a cage to navigating the concrete jungle of Manhattan.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/wild-inside","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1787063769129-DKA45RLDW1DIOCWXJ33X/sddefault.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1787516100572,"endDate":1787521800572},"startDate":1787516100572,"endDate":1787521800572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"640x480","recordTypeLabel":"event"},{"id":"6a84699f9b0e623fa5472848","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1787062875839,"updatedOn":1787062871864,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1787062875839,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1781623353725-Z43I29X6D0KWGJ4PRFSW","systemDataVariants":"1440x1660","systemDataSourceType":"JPG","filename":"wildwoodnj_keyart2.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"f8f4e1","topRightAverage":"f7f3e1","bottomLeftAverage":"faf5e3","bottomRightAverage":"f8f4e2","centerAverage":"d6602b","suggestedBgColor":"9a8661"},"urlId":"spotlight-on-cinema-wildwood-nj-slh8p","title":"Wildwood, NJ ","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6a84699f9b0e623fa5472848\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.html/45a223c2-0a7f-41e1-910b-7e4ed1931d30_973/website.components.html.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.html\" data-sqsp-block=\"text\" data-website-component-id=\"b639b4f2d2257ce2974f\" id=\"block-b639b4f2d2257ce2974f\"><div class=\"sqs-block-content\"><div class=\"sqs-text-block-container\">\n  \n  <div class=\"sqs-html-content\" data-sqsp-text-block-content><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\"><em>About the film: From go-go dancers to pre-teen brats, to goths working as vampires in the boardwalk\u2019s haunted house, this classic 90s independent non-narrative vox pop documentary moves beyond big hair and press-on nails to explore the souls raised on these neon lights, rides and beaches of the last great New Jersey carnival town: Wildwood. </em>1994, 1h</p><p style=\"white-space:pre-wrap;\" data-rte-preserve-empty=\"true\">Filmed during a summer in the early 1990s, Wildwood, NJ (at its start) purports to be about the \u2018joys\u2019 of the town of Wildwood - but soon enough the documentary reveals itself as about something even more interesting: personality. While its subjects are frozen on film in their 90s look and style, their mentalities (captured and organized by co-directors Ruth Leitman and Carol Cassidy) transcend time (as all great art does) - meaning: Wildwood just becomes more remarkable with each passing decade, maintaining status as both \u2018time capsule\u2019 and \u2018timeless.\u2019 It is, I think, one of those \u2018forever\u2019 films.</p></div>\n\n\n  \n<style id=\"container-styles\">#block-b639b4f2d2257ce2974f {\n    \n    --stroke-style: none;--stroke-thickness: 6px;\n    \n      \n      \n      \n    \n\n\n\n  }\n\n  #block-b639b4f2d2257ce2974f .sqs-html-content {\n    \n    --tweak-text-block-padding: 6% 6% 6% 6%;\n  --tweak-text-block-padding: initial;\n}\n\n  #block-b639b4f2d2257ce2974f {\n      mix-blend-mode: var(--tweak-text-block-blend\n  );\n      border-radius: var(--tweak-text-block-radius);\n  }\n\n  \n  \n#block-b639b4f2d2257ce2974f {\n      --tweak-text-block-radius: 0px 0px 0px 0px;\n    }\n\n\n  \n  \n\n  #block-b639b4f2d2257ce2974f {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-b639b4f2d2257ce2974f {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-b639b4f2d2257ce2974f .sqs-html-content {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n<style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n\n\n</div>\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-button button-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.button/ea4eca2c-24a6-44e3-9a5c-84a0030cdb61_1143/website.components.button.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-compo