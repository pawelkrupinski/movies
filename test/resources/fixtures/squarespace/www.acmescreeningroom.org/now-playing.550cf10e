ne by,&nbsp;<em>Once Upon A Time In A Cinema</em>&nbsp;is a story to be dived into. Embrace the popcorn - and the moment - and sit back and enjoy.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/once-upon-a-time-in-a-cinema-blkwp-j9zna-ddf6m","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1785887475896-8IZ287YZB8DMK1UWKQ5K/once.jpg","contentType":"image/jpeg","structuredContent":{"_type":"CalendarEvent","startDate":1789332300572,"endDate":1789338000572},"startDate":1789332300572,"endDate":1789338000572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"1400x700","recordTypeLabel":"event"},{"id":"6aa1006c1860912628ad9a1d","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1788988656549,"updatedOn":1788988656813,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1788988656549,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1787063769129-DKA45RLDW1DIOCWXJ33X","systemDataVariants":"640x480","systemDataSourceType":"JPG","filename":"sddefault.jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"000000","topRightAverage":"000000","bottomLeftAverage":"000000","bottomRightAverage":"000000","centerAverage":"c9c6d2","suggestedBgColor":"70818d"},"urlId":"wild-inside-mg2ht-khlb8","title":"Wild Inside","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6aa1006c1860912628ad9a1d\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&