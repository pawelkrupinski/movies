m -- and its iconic anvils -- to a new generation while rewarding longtime fans.</p>","location":{"mapZoom":12.0,"mapLat":40.7207559,"mapLng":-74.00076130000002,"markerLat":40.7207559,"markerLng":-74.00076130000002,"addressTitle":"","addressLine1":"","addressLine2":"","addressCountry":""},"customContent":null,"likeCount":0,"commentCount":0,"publicCommentCount":0,"commentState":2,"unsaved":false,"fullUrl":"/now-playing/coyote-vs-acme-xzkhw-fjswd-5z3br-n5lmk","assetUrl":"https://images.squarespace-cdn.com/content/v1/5ff89563cc0dcd7be5b5a538/1788937028285-U9AGCDCAEA9WGDYE9WRC/Screenshot-2026-08-28-100006.png","contentType":"image/png","structuredContent":{"_type":"CalendarEvent","startDate":1791673200572,"endDate":1791679500572},"startDate":1791673200572,"endDate":1791679500572,"items":[],"pushedServices":{},"pendingPushedServices":{},"originalSize":"3060x1790","recordTypeLabel":"event"},{"id":"6ac58abdc3474900c7f6e6c8","collectionId":"61e5f224b5857c262628f32d","recordType":12,"addedOn":1791332141006,"updatedOn":1791385731565,"starred":true,"passthrough":false,"tags":[],"categories":[],"workflowState":1,"publishOn":1791332141006,"authorId":"602eb52c9c36aa5e918c03b5","systemDataId":"1790811903068-P1TDIAMJ5KNWFHTV8API","systemDataVariants":"1280x720","systemDataSourceType":"JPG","filename":"maxresdefault (8).jpg","mediaFocalPoint":{"x":0.5,"y":0.5,"source":3},"colorData":{"topLeftAverage":"20323a","topRightAverage":"162226","bottomLeftAverage":"0b1015","bottomRightAverage":"0f1c24","centerAverage":"18262a","suggestedBgColor":"34444e"},"urlId":"american-doctor-wlkgs","title":"American Doctor plus talk with Alexis Berends","sourceUrl":"","body":"<div class=\"sqs-layout sqs-grid-12 columns-12\" data-layout-label=\"Post Body\" data-type=\"item\" id=\"item-6ac58abdc3474900c7f6e6c8\"><div class=\"row sqs-row\"><div class=\"col sqs-col-12 span-12\"><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-html html-block\" data-block-css=\"[&quot;http