ervation":{"enabled":false,"endAt":"2026-10-11 16:00:00"},"products":[{"id":17,"name":"normalny 60 z\u0142","rawPrice":6000,"price":"60,00","allowSaleUsingPass":false,"available":230},{"id":399,"name":"50 z vat","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":183}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6074,"name":"Fantazjana ","description":"<p class=\"western\" style=\"margin: 0.67em 0px; color: rgb(53, 53, 53); font-family: &quot;Open Sans&quot;; font-size: 16px; line-height: 26px; background-color: rgb(255, 255, 255); text-align: center;\"><span style=\"margin-bottom: 0px; font-family: MyriadPro-Regular, sans-serif;\"><span style=\"margin-bottom: 0px; font-size: medium;\">Bastian po \u015bmierci mamy zamyka si\u0119 w sobie, ma problemy w szkole i nie potraf porozumie\u0107 si\u0119 ze swoim tat\u0105. Pewnego dnia chowa si\u0119 w ksi\u0119garni, uciekaj\u0105c przed prze\u015bladuj\u0105cymi go starszymi kolegami ze szko\u0142y. Tam znajduje tajemnicz\u0105 ksi\u0105\u017ck\u0119, dzi\u0119ki kt\u00f3rej prze\u017cyje najwspanialsz\u0105 przygod\u0119 w swoim \u017cyciu.<br style=\"margin-bottom: 0px;\">Nie jest to bowiem zwyk\u0142a ksi\u0105\u017cka, ale pe\u0142na magii brama do innego \u015bwiata. Dzi\u0119ki niej Bastian przenosi si\u0119 w krain\u0119 Fantazjany, kt\u00f3rej grozi zag\u0142ada\u2026Ma\u0142y ch\u0142opiec oka\u017ce si\u0119 wkr\u00f3tce jedyn\u0105 osob\u0105, kt\u00f3ra mo\u017ce uratowa\u0107 \u015bwiat fantazji\u2026<\/span><\/span><\/p><p class=\"western\" style=\"margin: 0.67em 0px 0px; color: rgb(53, 53, 53); font-family: &quot;Open Sans&quot;; font-size: 16px; line-height: 26px; background-color: rgb(255, 255, 255); text-align: center;\"><span style=\"margin-bottom: 0px; font-family: MyriadPro-Regular, sans-serif;\"><span style=\"margin-bottom: 0px; font-size: medium;\">\u201eWi\u0119c uwierz w siebie<br>Bawi\u0105c si\u0119, si\u0119gnij gwiazd wiedz\u0105c, \u017ce<br>To Twe przeznaczenie<br style=\"margin-bottom: 0px;\">Poczuj, \u017ce to Tw\u00f3j \u015bwiat, uwierz w nie!\u201d&nbsp;<\/span><\/span><\/p>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"12","duration":0,"image":"\/uploads\/event\/\/1783416407.jpg","artists":[]},"location":{"id":8,"name":"Sala Widowiskowa","institution_name":"","location_description":"Parter i balkon","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"41-500","addresse":"ul. Sienkiewicza 3"}},"6289":{"id":6289,"title":"ELIA - CHC\u0118 ZACZ\u0104\u0106 ZN\u00d3W ","url":"\/kup-bilet\/elia-chce-zaczac-znow-2026-10-12-18-00","image":"\/uploads\/event\/6196\/1789379006.png","date":"2026-10-12T18:00:00+02:00","availableTickets":39,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-12 17:00:00","startAt":"2026-09-14 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-12 18:00:00"},"products":[{"id":13,"name":"normalny 40 z\u0142","rawPrice":4000,"price":"40,00","allowSaleUsingPass":false,"available":39}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6196,"name":"ELIA - CHC\u0118 ZACZ\u0104\u0106 ZN\u00d3W ","description":"","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/6196\/1789379006.png","artists":[]},"location":{"id":14,"name":"Zaj\u0119cia rzymskie","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"","addresse":""}},"6296":{"id":6296,"title":"SALMA W KRAINIE DUSZ ","url":"\/kup-bilet\/salma-w-krainie-dusz-2026-10-15-17-00","image":"","date":"2026-10-15T17:00:00+02:00","availab