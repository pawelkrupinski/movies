oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"3","duration":0,"image":"","artists":[]},"location":{"id":5,"name":"Kino Grajfka","institution_name":"Chorzowskie Centrum Kultry","location_description":"","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"41-500","addresse":" ul. Henryka Sienkiewicza 3"}},"6201":{"id":6201,"title":"Marcin Daniec - One Man Show ","url":"\/kup-bilet\/marcin-daniec-one-man-show-2026-10-17-19-00","image":"\/uploads\/event\/\/1785235774.jpg","date":"2026-10-17T19:00:00+02:00","availableTickets":81,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 18:00:00","startAt":"2026-07-28 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 19:00:00"},"products":[{"id":220,"name":"bilet normalny 120 z\u0142","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":34},{"id":225,"name":"normalny 150","rawPrice":15000,"price":"150,00","allowSaleUsingPass":false,"available":47}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6106,"name":"Marcin Daniec - One Man Show ","description":"<p class=\"MsoNormal\" style=\"text-align:justify\"><b>Marcin Daniec<o:p><\/o:p><\/b><\/p>\r\n\r\n<p class=\"MsoNormal\" style=\"text-align:justify\"><b>Znany i uwielbiany krakowski\r\nartysta kabaretowy zaprasza na wyj\u0105tkowy wyst\u0119p! Przygotuj si\u0119 na wiecz\u00f3r pe\u0142en\r\n\u015bmiechu, doskona\u0142ej zabawy i niesamowitego kontaktu z publiczno\u015bci\u0105.<o:p><\/o:p><\/b><\/p>\r\n\r\n<p class=\"MsoNormal\" style=\"text-align:justify\">Od lat Marcin Daniec \u015bwi\u0119ci\r\ntriumfy na scenach w Polsce i za granic\u0105. Jego fenomen polega na znakomitym\r\nkontakcie z publiczno\u015bci\u0105 \u2013 reakcje z widowni staj\u0105 si\u0119 cz\u0119\u015bci\u0105 programu, co\r\nsprawia, \u017ce ka\u017cdy wyst\u0119p jest niepowtarzalny. Artysta porusza tematy z \u017cycia\r\ncodziennego, kt\u00f3re s\u0105 bliskie ka\u017cdemu z nas, unikaj\u0105c przy tym odniesie\u0144 do\r\npolityki. Nie boi si\u0119 r\u00f3wnie\u017c wprowadza\u0107 do swoich program\u00f3w element\u00f3w\r\nmuzycznych, co dodaje im wyj\u0105tkowego charakteru.<\/p>\r\n\r\n<p class=\"MsoNormal\">Przekonaj si\u0119, dlaczego Marcin Daniec zdoby\u0142 tak ogromn\u0105 sympati\u0119\r\npubliczno\u015bci oraz liczne nagrody, w tym tytu\u0142 <b>\u201eSatyryka Wszech Czas\u00f3w\u201d<\/b>\r\nprzyznany przez czytelnik\u00f3w \u201eTele Tygodnia\u201d. <\/p>\r\n\r\n<p class=\"MsoNormal\" style=\"text-align:justify\">Nie przegap okazji i przyjd\u017a na\r\nniezapomniany wiecz\u00f3r z jednym z najpopularniejszych satyryk\u00f3w w historii\r\npolskiego kabaretu!<\/p>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"50","duration":0,"image":"\/uploads\/event\/\/1785235774.jpg","artists":[]},"location":{"id":8,"name":"Sala Widowiskowa","institution_name":"","location_description":"Parter i balkon","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"41-500","addresse":"ul. Sienkiewicza 3"}},"6278":{"id":6278,"title":"PROJEKT MUZYKA \u015aPIEWA TUWIMA ","url":"\/kup-bilet\/projekt-muzyka-spiewa-tuwima-2026-10-18-16-00","image":"\/uploads\/event\/\/1788522074.jpg","date":"2026-10-18T16:00:00+02:00","availableTickets":427,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 15:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-18 16:00:00"},"products":[{"id":15,"name":"normalny 50 z\u0142","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":427}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6184,"name":"PROJE