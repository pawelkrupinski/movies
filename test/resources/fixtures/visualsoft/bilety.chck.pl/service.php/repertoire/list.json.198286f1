2026-09-14 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 18:00:00"},"products":[{"id":313,"name":"10 zl kino sdk","rawPrice":1000,"price":"10,00","allowSaleUsingPass":false,"available":20}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6209,"name":"Najbardziej samotny ch\u0142opak na \u015bwiecie ","description":"","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy SDK","categoryId":2,"omomoCategory":"3","duration":0,"image":"","artists":[]},"location":{"id":25,"name":"SDK Kino Frajda","institution_name":"","location_description":"Sala kinowa na 20 os\u00f3b","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"41-503","addresse":"Siemianowicka 59"}},"6322":{"id":6322,"title":"KRONDIKE ","url":"\/kup-bilet\/krondike-2026-10-23-18-00","image":"","date":"2026-10-23T18:00:00+02:00","availableTickets":40,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 17:00:00","startAt":"2026-09-22 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 18:00:00"},"products":[{"id":7,"name":"bilet normalny 10 z\u0142","rawPrice":1000,"price":"10,00","allowSaleUsingPass":false,"available":40}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6232,"name":"KRONDIKE ","description":"","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"3","duration":0,"image":"","artists":[]},"location":{"id":5,"name":"Kino Grajfka","institution_name":"Chorzowskie Centrum Kultry","location_description":"","location_type":1,"location_type_name":"sala","city":"Chorz\u00f3w","city_id":1788,"zip":"41-500","addresse":" ul. Henryka Sienkiewicza 3"}},"6286":{"id":6286,"title":"Koncert pod Schodami- OCTOTANKER i WET STICKY BANDITS - CHSA ","url":"\/kup-bilet\/koncert-pod-schodami-chsa-2026-10-23-19-00","image":"\/uploads\/event\/\/1789031227.jpg","date":"2026-10-23T19:00:00+02:00","availableTickets":70,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 18:00:00","startAt":"2026-09-10 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 19:00:00"},"products":[{"id":193,"name":"30 z\u0142","rawPrice":3000,"price":"30,00","allowSaleUsingPass":false,"available":70}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6193,"name":"Koncert pod Schodami- OCTOTANKER i WET STICKY BANDITS - CHSA ","description":"<div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Octotanker to wroc\u0142awski, pi\u0119cioosobowy sk\u0142ad dryfuj\u0105cy gdzie\u015b pomi\u0119dzy stoner rockiem, doom metalem, grungem i psychodeli\u0105. \u0141\u0105cz\u0105 ci\u0119\u017car nisko strojonych gitar z mistyk\u0105 tekst\u00f3w, doprawiaj\u0105c to wszystko spor\u0105 ilo\u015bci\u0105 kosmicznych odlot\u00f3w.<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Ich debiutancki album ukaza\u0142 si\u0119 w listopadzie 2025. P\u0142yta zatytu\u0142owana 'Voidhopper' zebra\u0142a pozytywne recenzje i spotka\u0142a si\u0119 z bardzo dobrym odbiorem - m.in. The Obelisk, Doomed Nation, Twisted Pulse Reviews UK, Stereo Life, RockMetal.pl, SztukMIX, Wrota Krypty, Portal Winylowy, Tylko Rock; artyku\u0142y i wywiady z zespo\u0142em ukaza\u0142y si\u0119 tak\u017ce w Knock-Out Zine, na Metal Nation (USA), meksyka\u0144skim Metal En Tu Idioma czy Suprema Aristocracia. Single promuj\u0105ce album doczeka\u0142y si\u0119 emisji w audycjach i podcastach zar\u00f3wno w Polsce (m.in. AntyRadio (Made in Polska), Radio 357 (W\u0142\u0105cz ten Ha\u0142as \u0141ukasza Dunaja), Radio Krak\u00f3w Kultura (Godzina Przerwy), w Radiu LUZ (Fuzz), Radiu ProRock (W zimnej Toni) czy Radiu Kampus (Melodie Mgie\u0142 Nocnych)), jak i za granic\u0105 (m.in. Miscreant Machine Nicka Gilesa w Rock Radio UK, na antenie kanadyjskiego Insane Realm Radio, argenty\u0144skiego El Gordo Metalero czy Metal Crash Radio z USA).<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">W styczniu 2027, nak\u0142adem Electric Witch Mountain Recordings, uka\u017ce si\u0119 kolejne wydawnictwo grupy - pi\u0119cioutworowe EP Servants, na kt\u00f3rym znajd\u0105 si\u0119 cztery autorskie kompozycje i, po raz pierwszy w historii zespo\u0142u, cover. Album zarejestrowano w sierpniu 2026 w Electric Witch Mountain Studio, pod okiem Kamila Zi\u00f3\u0142kowskiego, a miksem i masteringiem zaj\u0105\u0142 si\u0119 Haldor Grunberg. Podobnie jak w przypadku 'Voidhopper', EPce towarzyszy\u0142 b\u0119dzie autorski komiks.<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Zesp\u00f3\u0142 sk\u0142ada si\u0119 z do\u015bwiadczonych muzyk\u00f3w, maj\u0105cych do\u015bwiadczenie zar\u00f3wno na ma\u0142ych jak i du\u017cych scenach - przez wiele lat wyst\u0119powa\u0142 jako PR\u0104D. Pod t\u0105 nazw\u0105 wydali dwa pe\u0142ne albumy (\u2018Lot\u2019 (wyd. Music Is The Weapon) i \u2018Octotanker\u2019 (wyd. Galactic SmokeHouse)), EP-k\u0119 zatytu\u0142owan\u0105 po prostu \u2018Pr\u0105d\u2019 oraz split z AveCaesar. Wyst\u0105pili m. in. na SLOT Art Festival, Gruzilla Festiwal razem z O.D.R.A., Spaceslug i Major Kong czy imprezie psytrance\u2019owej typu \u2018secret location\u2019, w \u015brodku lasu, w podziemnym kompleksie bunkr\u00f3w, dzielili sceny klubowe z Somali Yacht Club, Cosmic Dead i wieloma innymi. Wszystkie te aktywno\u015bci napotyka\u0142y na bardzo dobry odbi\u00f3r, wyra\u017cony tak\u017ce w recenzjach, publikacjach i wywiadach (np. Metal Hammer).<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Sk\u0142ad:<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Marcin Ga\u0142kowski - wokal<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Piotr Krawczyk - perkusja<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Rafa\u0142 Bielski - gitara<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Wojciech Szelwicki - gitara<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Tomasz Krymski - bas<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Wet Sticky Bandits to trzyosobowy zesp\u00f3\u0142 z Cz\u0119stochowy, poruszaj\u0105cy si\u0119 w mocno gitarowych klimatach grunge i heavy rocka. W sk\u0142ad zespo\u0142u wchodz\u0105: Przemek Zi\u0119bacz (gitara, wokal), Dominik Ostrowski (perkusja, wokal) oraz Kacper Janicki (bas).<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">W 2025 roku zesp\u00f3\u0142 nagra\u0142 mini LP \u201eWrath\u201d, kt\u00f3ry jest dost\u0119pny na Spotify i YouTube. W dorobku Wet Sticky Bandits znajduj\u0105 si\u0119 r\u00f3wnie\u017c p\u0142yta koncertowa oraz pierwsze demo z 2006 roku \u2014 nagrane jeszcze w czasach, gdy muzycy stawiali swoje pierwsze kroki jako zesp\u00f3\u0142, mieszkaj\u0105c w Londynie.<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Po kilku latach muzycy wr\u00f3cili do Polski, a zesp\u00f3\u0142 na pewien czas zawiesi\u0142 dzia\u0142alno\u015b\u0107. W 2021 roku uda\u0142o im si\u0119 ponownie po\u0142\u0105czy\u0107 si\u0142y i wr\u00f3ci\u0107 do wsp\u00f3lnego grania. Od tego momentu Wet Sticky Bandits intensywnie koncertuj\u0105, przede wszystkim w swoim rodzinnym mie\u015bcie.<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Zesp\u00f3\u0142 mia\u0142 przyjemno\u015b\u0107 dwukrotnie otwiera\u0107 koncerty Paw\u0142a Ma\u0142aszy\u0144skiego i jego zespo\u0142u Cochise. Muzycy kilkukrotnie wyst\u0119powali r\u00f3wnie\u017c z zespo\u0142em Man in the Box, kt\u00f3ry wraz z Juanem Carlosem Cano, zwyci\u0119zc\u0105 programu The Voice of Poland, wykonuje covery grunge\u2019owych zespo\u0142\u00f3w z Seattle z pocz\u0105tku lat 90.<\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\"><br><\/span><\/font><\/div><div style=\"\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Wsp\u00f3lne koncerty z Man in the Box obejmowa\u0142y mi\u0119dzy innymi wyst\u0119p w kultowym klubie Semafor w Skar\u017cysku-Kamiennej oraz udzia\u0142 w \u015al\u0105skim Festiwalu Grunge\u2019owym w Le\u015bnicz\u00f3wce.<\/span><\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy ChCK","categoryId":1,"omomoCategory":"23","duration":0,"image":"\/uploads\/event\/\/1789031227.jpg","artists":[]},"location":{"id":9,"name":"CHCK ","institution_name":"CHCK","location_description":"miejsca nienumerowane","location_type":2,"location_type_name":"otwarte","city":"Chorz\u00f3w","city_id":1788,"zip":"","addresse":"ul.Sienkiewicza 3"}},"6305":{"id":6305,"title":"Warsztaty Pachn\u0105ce eksperymenty Rodzinna sobota w SDK ","url":"\/kup-bilet\/warsztaty-pachnace-eksperymenty-rodzinna-sobota-w-sdk-2026-10-24-10-00","image":"","date":"2026-10-24T10:00:00+02:00","availableTickets":40,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 09:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 10:00:00"},"products":[{"id":334,"name":"40 zl zw SDK","rawPrice":4000,"price":"40,00","allowSaleUsingPass":false,"available":20},{"id":405,"name":"Opiekun 5z\u0142 SDK","rawPrice":500,"price":"5,00","allowSaleUsingPass":false,"available":20}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":6215,"name":"Warsztaty Pachn\u0105ce eksperymenty Rodzinna sobota w SDK ","description":"","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Imprezy SDK","categoryId":2,"omomoCategory":"1","duration":0,"image":"","artists":[]},"location":{"id":17,"name":"Starochorzowski Dom Kultury","institution_name":"Starochorzowski Dom Kultury","location_description":"sala widowiskowa nienumerowana","location_type":2,"location_type_name":"otwarte","city":"Chorz\u00f3w","city_id":1788,"zip":"41-503","addresse":"Siemianowicka 59"}},"6300":{"id":6300,"title":"KOSZMAREK ","url":"\/kup-bilet\/koszmarek-2026-10-24-15-00","image":"","date":"2026-10-24T15:00:00+02:00","availableTickets":20,"addi