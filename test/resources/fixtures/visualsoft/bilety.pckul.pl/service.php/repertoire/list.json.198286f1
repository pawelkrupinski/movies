{"meta":{"nbResults":206},"repertoires":{"5467":{"id":5467,"title":"LUNA I ROZGADANA \u015aWINKA ","url":"\/kup-bilet\/luna-i-rozgadana-swinka-2026-09-25-14-00-1","image":"\/uploads\/event\/\/1787634246.jpg","date":"2026-09-26T10:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 09:00:00","startAt":"2026-08-25 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 10:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":981,"name":"LUNA I ROZGADANA \u015aWINKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nJedenastoletnia Luna, fanka serii ksi\u0105\u017cek o super-bohaterach walcz\u0105cych o \u015brodowisko, otrzymuje magiczne pi\u00f3ro od tajemniczego autora ksi\u0105\u017cek. \r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Ten zaczarowany przedmiot sprawia, \u017ce wszystko, co napisze, staje si\u0119 rzeczywisto\u015bci\u0105. Dziewczynka odkrywa, jak pot\u0119\u017cna jest jego moc i rusza w niebezpieczn\u0105 wypraw\u0119, by naprawi\u0107 szkody wyrz\u0105dzone \u015brodowisku i ocali\u0107 planet\u0119 przed nadci\u0105gaj\u0105c\u0105 katastrof\u0105. Towarzyszy jej Airbag, ukochana \u015bwinka morska, kt\u00f3ra dzi\u0119ki u\u017cyciu pi\u00f3ra nieoczekiwanie zaczyna m\u00f3wi\u0107. Jednak niezwykle nikczemny tw\u00f3rca czarodziejskiego przedmiotu zrobi wszystko, aby ich misja sko\u0144czy\u0142a si\u0119 niepowodzeniem. \u201eLuna i rozgadana \u015bwinka\u201d to pe\u0142na serca i humoru opowie\u015b\u0107 o dojrzewaniu, wyobra\u017ani i odpowiedzialno\u015bci.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 5+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 88\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"La fille dans les nuages","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny, przygodow","director":"Philippe Riche","organizer":"","country":"Belgia, Francja","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":88,"image":"\/uploads\/event\/\/1787634246.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5468":{"id":5468,"title":"LUNA I ROZGADANA \u015aWINKA ","url":"\/kup-bilet\/luna-i-rozgadana-swinka-2026-09-25-14-00-2","image":"\/uploads\/event\/\/1787634246.jpg","date":"2026-09-26T14:00:00+02:00","availableTickets":113,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 13:00:00","startAt":"2026-08-25 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 14:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass"