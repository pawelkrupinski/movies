24\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5631":{"id":5631,"title":"INNA MAMUSIA ","url":"\/kup-bilet\/inna-mamusia-2026-10-26-18-00-2","image":"\/uploads\/event\/\/1789741073.jpg","date":"2026-10-28T18:00:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-28 17:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-28 18:00:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":999,"name":"INNA MAMUSIA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nO\u015bmioletnia Bela zaczyna dostrzega\u0107 w swoim domu tajemnicz\u0105 obecno\u015b\u0107.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Istota, kt\u00f3ra coraz cz\u0119\u015bciej pojawia si\u0119 w jej otoczeniu, wygl\u0105da niemal identycznie jak jej ukochana mama. Dziewczynka nawi\u0105zuje z ni\u0105 niezwyk\u0142\u0105 wi\u0119\u017a, nie zdaj\u0105c sobie sprawy, \u017ce za znajom\u0105 twarz\u0105 kryje si\u0119 co\u015b niewyobra\u017calnie mrocznego.\r\n<br>\r\nGdy granica mi\u0119dzy rzeczywisto\u015bci\u0105 a koszmarem zaczyna si\u0119 zaciera\u0107, rodzina Beli staje w obliczu przera\u017caj\u0105cej prawdy.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 90\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Other Mommy","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror","director":"Rob Savage","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1789741073.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5534":{"id":5534,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-05-17-00-4-3","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-28T20:30:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-28 19:30:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-28 20:30:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5640":{"id":5640,"title":"INNA MAMUSIA  - KINO DLA SENIORA","url":"\/kup-bilet\/inna-mamusia-2026-10-29-13-00","image":"\/uploads\/event\/\/1789741073.jpg","date":"2026-10-29T13:00:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-29 12:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-29 13:00:00"},"products":[{"id":256,"name":"BILET STANDARD","rawPrice":1500,"price":"15,00","allowSaleUsingPass":false,"available":122}]},"event":{"id":999,"name":"INNA MAMUSIA ","description":"<table style=\"width: 100%;\">\r\n<tb