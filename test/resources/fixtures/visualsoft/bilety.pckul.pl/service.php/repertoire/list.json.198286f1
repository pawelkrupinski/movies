: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 90\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Other Mommy","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror","director":"Rob Savage","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1789741073.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5662":{"id":5662,"title":"WITAJCIE W HOPE ","url":"\/kup-bilet\/witajcie-w-hope-2026-11-02-20-00-3","image":"\/uploads\/event\/\/1789756175.jpg","date":"2026-11-05T20:00:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-05 19:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-05 20:00:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":1003,"name":"WITAJCIE W HOPE ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nMieszka\u0144cy spokojnego, nadmorskiego miasta Hope zostaj\u0105 odci\u0119ci od \u015bwiata przez \u015bmierciono\u015bne po\u017cary, kt\u00f3re trawi\u0105 okoliczne lasy.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Policja otrzymuje liczne meldunki o niezwyk\u0142ej aktywno\u015bci drapie\u017cnych zwierz\u0105t, kt\u00f3re zaczynaj\u0105 atakowa\u0107 ludzi. Wkr\u00f3tce okazuje si\u0119, \u017ce te dramatyczne wydarzenia s\u0105 zapowiedz\u0105 czego\u015b znacznie gorszego. Ludzie zaczynaj\u0105 gin\u0105\u0107 w coraz bardziej drastycznych okoliczno\u015bciach i wkr\u00f3tce staje si\u0119 jasne, \u017ce Hope sta\u0142o si\u0119 celem ataku tajemniczych istot, kt\u00f3re nie przypominaj\u0105 ani ludzi, ani zwierz\u0105t. Sk\u0105d pochodz\u0105, jakie s\u0105 ich zamiary i czy Hope jest tylko cz\u0119\u015bci\u0105 jakiego\u015b wi\u0119kszego planu? Odpowiedzi na te pytania pr\u00f3buje znale\u017a\u0107 dw\u00f3jka miejscowych policjant\u00f3w. \u017beby to zrobi\u0107 musz\u0105 jednak przede wszystkim przetrwa\u0107.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: KOR<br>\r\nNapisy: PL<br>\r\nCzas trwania: 160\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Hope","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror, sci-fi","director":"Na Hong-jin","organizer":"","country":"Korea Po\u0142udniowa","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":160,"image":"\/uploads\/event\/\/1789756175.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5248":{"id":5248,"title":"Klimakterium... i ju\u017c ","url":"\/kup-bilet\/klimakterium-i-juz-2026-11-06-18-30","image":"\/uploads\/event\/610\/1783590657.png","date":"2026-11-06T18:30:00+01:00","availableTickets":258,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-06 17:30:00","startAt":"2026-07-09 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-06 18:30:00"},"products":[{"id":11,"name":"BILET NORMALNY","rawPrice":8000,"price":"80,00","allowSaleUsingPass":false,"available":74},{"id":17,"name":"BILET NORMALNY","rawPrice":15000,"price":"150,00","allowSaleUsingPass":false,"available":93},{"id":37,"name":"BILET NORMALNY","rawPrice":13000,"price":"130,00","allowSaleUsingPass":false,"available":87},{"id":47,"name":"BILET NORMALNY  \u267f","rawPrice":13000,"price":"130,00","allowSaleUsingPass":false,"available":4}]},"event":{"id":610,"name":"Klimakterium... i ju\u017c ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nS\u0142ynne polskie Klimaktynki zapraszaj\u0105 Panie i Pan\u00f3w do Pszczyny.\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\n\"Klimakterium... i ju\u017c\" \u2013 to komediowy musical nie tylko dla Pa\u0144. Tak dowcipnie, otwarcie, z dystansem i autorefleksj\u0105 na w\u0142asny temat jak w tym spektaklu o sprawach kobiet nikt jeszcze w Polsce nie m\u00f3wi\u0142! W sztuce w przezabawny spos\u00f3b m\u00f3wi si\u0119 i \u015bpiewa o trudnym okresie \u017cycia, kt\u00f3ry nie ominie \u017cadnej z Pa\u0144. Wsp\u00f3lnota do\u015bwiadcze\u0144 \u0142\u0105czy bohaterki sztuki oraz kobiety na widowni. Spektakl staje si\u0119 \"babskim spotkaniem\" pe\u0142nym humoru i najlepszym lekarstwem na wszelkie dolegliwo\u015bci. Nieuchronne problemy w radosnej i ciep\u0142ej atmosferze sztuki przestaj\u0105 by\u0107 wstydliwe i okazuj\u0105 wcale nie takie straszne! Zapraszamy na wspania\u0142\u0105 muzyczn\u0105 komedi\u0119 - jedn\u0105 z najcz\u0119\u015bciej wystawianych w ostatnich latach na deskach teatr\u00f3w w ca\u0142ej Polsce :)<br>\r\nWidzimy si\u0119 tej jesieni \u2013 oj b\u0119dzie weso\u0142o :) Pszczy\u0144skie Centrum Kultury 6.11.2026 r. godz. 18:30.\r\n\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nW spektaklu wyst\u0119puj\u0105 zamiennie nast\u0119puj\u0105ce aktorki:<br>\r\nEl\u017cbieta Jod\u0142owska, Ma\u0142gorzata Duda, El\u017cbieta Okupska, Renata Zar\u0119bska, Katarzyna Kozak, Ma\u0142gorzata Gadecka, Ewa Cichocka, Ma\u0142gorzata Duda, Joanna Je\u017cewska, Gra\u017cyna Zieli\u0144ska, Ludmi\u0142a Warzecha, Dorota Piasecka. \r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nBilety wy\u0142\u0105cznie dost\u0119pne na platformach:<br>\r\n1.\tbilety.pckul.pl<br>\r\n2.\tbiletyna.pl<br>\r\n3.\tkupbilecik.pl<br>\r\n<br>\r\nW przypadku zam\u00f3wie\u0144 grupowych od 10 bilet\u00f3w kontakt email: bilety@mbart.pl<br>\r\nOrganizator spektaklu Impresariat Teatralny M-Bart Gda\u0144sk tel. 603 105 550\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 90 \/ 140 PLN (ulgowe 120 PLN)<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/spektakl-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Spektakl","categoryId":4,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/610\/1783590657.png","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5663":{"id":5663,"title":"WITAJCIE W HOPE ","url":"\/kup-bilet\/witajcie-w-hope-2026-10-30-20-00-2","image":"\/uploads\/event\/\/1789756175.jpg","date":"2026-11-06T20:30:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-11-06 19:30:0