 wszelkie zasady i przemyca trzynastoletniego syna na najwi\u0119kszy hip-hopowy festiwal \u015bwiata? Odpowied\u017a: absolutnie wszystko. To b\u0119dzie dzie\u0144, kt\u00f3rego \u017caden z nich nigdy nie zapomni.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 95\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Rolling Loud: The Movie","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, muzyczny","director":"Jeremy Garelick","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":95,"image":"\/uploads\/event\/\/1789457476.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5526":{"id":5526,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-05-17-00-9","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-20T17:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-20 16:00:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-20 17:00:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99"