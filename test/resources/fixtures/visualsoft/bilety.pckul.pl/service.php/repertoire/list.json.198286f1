arna komedia \/ dramat \/ kino","director":"Alejandro Gonz\u00e1lez I\u00f1\u00e1rritu","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":140,"image":"\/uploads\/event\/\/1789461931.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5604":{"id":5604,"title":"SUPERMOCNI ","url":"\/kup-bilet\/supermocni-2026-10-23-13-30","image":"\/uploads\/event\/\/1789472127.jpg","date":"2026-10-23T13:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 12:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 13:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":996,"name":"SUPERMOCNI ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nGdy \u015bwiat jest w niebezpiecze\u0144stwie, tylko SUPERMOCNI mog\u0105 go ocali\u0107.\r\n\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej dziwnej mutacji. Ale to nie jedyny problem. Ot\u00f3\u017c pewien \u017c\u0105dny w\u0142adzy naukowiec chce za pomoc\u0105 owej kosmicznej substancji przej\u0105\u0107 panowanie nad \u015bwiatem. Je\u015bli wpadnie ona w jego \u0142apy, na ratunek b\u0119dzie za p\u00f3\u017ano. Zo\u015bka i jej zwierzaki musz\u0105 zapanowa\u0107 nad swoimi super mocami i wykorzysta\u0107 je do ratowania planety.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 94\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Evolution","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, animacja","director":"JJulio Soto Gurpide, Zayra Munoz Dominguez","organizer":"","country":"Hiszpania","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":94,"image":"\/uploads\/event\/\/1789472127.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5594":{"id":5594,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-5","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-23T15:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 14:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 15:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5626":{"id":5626,"title":"INNA MAMUSIA ","url":"\/kup-bilet\/inna-mamusia-2026-10-23-18-00","image":"\/uploads\/event\/\/1789741073.jpg","date":"2026-10-23T18:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 17:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 18:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":999,"name":"INNA MAMUSIA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nO\u015bmioletnia Bela zaczyna dostrzega\u0107 w swoim domu tajemnicz\u0105 obecno\u015b\u0107.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Istota, kt\u00f3ra coraz cz\u0119\u015bciej pojawia si\u0119 w jej otoczeniu, wygl\u0105da niemal identycznie jak jej ukochana mama. Dziewczynka nawi\u0105zuje z ni\u0105 niezwyk\u0142\u0105 wi\u0119\u017a, nie zdaj\u0105c sobie sprawy, \u017ce za znajom\u0105 twarz\u0105 kryje si\u0119 co\u015b niewyobra\u017calnie mrocznego.\r\n<br>\r\nGdy granica mi\u0119dzy rzeczywisto\u015bci\u0105 a koszmarem zaczyna si\u0119 zaciera\u0107, rodzina Beli staje w obliczu przera\u017caj\u0105cej prawdy.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 90\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Other Mommy","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror","director":"Rob Savage","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1789741073.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"4713":{"id":4713,"title":"Spi\u0119ty powraca do Pszczyny! ","url":"\/kup-bilet\/spiety-powraca-do-pszczyny-2026-10-23-19-00","image":"\/uploads\/event\/\/1774601493.jpg","date":"2026-10-23T19:00:00+02:00","availableTickets":182,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 18:00:00","startAt":"2026-03-27 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 19:00:00"},"products":[{"id":13,"name":"BILET NORMALNY \u267f","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":4},{"id":21,"name":"BILET NORMALNY","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":98},{"id":39,"name":"BILET NORMALNY","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":80}]},"event":{"id":894,"name":"Spi\u0119ty powraca do Pszczyny! ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nSpi\u0119ty powraca do Pszczyny z koncertem opartym na repertuarze z najnowszej p\u0142yty \"Full H. D\".\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nCzwarta p\u0142yta Spi\u0119tego to \u015bwiat widziany oczami H.D., gdzie \u015bmiech, ironia, pytania, obawy i l\u0119ki to jedynie cz\u0119\u015b\u0107 jego sk\u0142adowych. Na nowym albumie znajdzie si\u0119 muzyka inspirowana ta\u0144cem \u2012 zar\u00f3wno jego tradycyjn\u0105 form\u0105 jak bolero czy tango, ale r\u00f3wnie\u017c zupe\u0142nie wsp\u00f3\u0142czesnym funkiem czy disco.<br>\r\nSingiel \u201eBlue\u201d, promuj\u0105cy \u201eHeartcore\u201d\u2012 poprzedni album artysty, utrzymywa\u0142 si\u0119 nieprzerwanie na 1. miejscu listy przeboj\u00f3w Radia 357 przez 21 tygodni, a w radiowym TOP10 znajdowa\u0142 si\u0119 przez przesz\u0142o 90 tygodni. Sam album \u201eHeartcore\u201d uzyska\u0142 nominacj\u0119 do nagrody Fryderyki 2023 w kategorii Muzyka Alternatywna.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nNajnowszy singiel \"Zapalanie Przedrostka\" zadebiutowa\u0142 na 1 miejscu listy Radia 357 oraz na 2 miejscu Radia Nowy \u015awiat.\r\nAlbum osi\u0105gn\u0105\u0142 1 miejsce na OLIS - w dniach 20.02.2026 - 26.02.2026 w trzech kategoriach: albumy, albumy fizyczne, winyle.<br>\r\nHUBERT DOBACZEWSKI \u2013 wokalista, gitarzysta, jeden z najbardziej cenionych polskich tek\u015bciarzy, a przede wszystkim charyzmatyczny lider zespo\u0142u Spi\u0119ty. Poza wspomnianym projektem Dobaczewski znany jest z takich zespo\u0142\u00f3w jak Lao Che, Jazzombie czy Koli.<br>\r\nW 2025 roku Hubert Dobaczewski zosta\u0142 uhonorowany tytu\u0142em Ambasador Polszczyzny w Pi\u015bmie przyznawan\u0105 przez Rad\u0119 J\u0119zyka Polskiego.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nZesp\u00f3\u0142 koncertuje w sk\u0142adzie:<br>\r\nSpi\u0119ty \u2212 wokal, gitara<br>\r\nBartek Kapsa \u2212 perkusja, sampler<br>\r\nEmil Wojtczak \u2013 bas<br>\r\nPatryk Kra\u015bniewski \u2212 klawisze\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 120 \/ 110 PLN\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1774601493.jpg","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5529":{"id":5529,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-02-17-00-6-1","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-23T20:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 19:30:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 20:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5595":{"id":5595,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-5-1","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-24T10:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 09:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 10:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5605":{"id":5605,"title":"SUPERMOCNI ","url":"\/kup-bilet\/supermocni-2026-10-23-13-30-1","image":"\/uploads\/event\/\/1789472127.jpg","date":"2026-10-24T13:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 12:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 13:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":996,"name":"SUPERMOCNI ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nGdy \u015bwiat jest w niebezpiecze\u0144stwie, tylko SUPERMOCNI mog\u0105 go ocali\u0107.\r\n\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej dziwnej mutacji. Ale to nie jedyny problem. Ot\u00f3\u017c pewien \u017c\u0105dny w\u0142adzy naukowiec chce za pomoc\u0105 owej kosmicznej substancji przej\u0105\u0107 panowanie nad \u015bwiatem. Je\u015bli wpadnie ona w jego \u0142apy, na ratunek b\u0119dzie za p\u00f3\u017ano. Zo\u015bka i jej zwierzaki musz\u0105 zapanowa\u0107 nad swoimi super mocami i wykorzysta\u0107 je do ratowania planety.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 94\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Evolution","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, animacja","director":"JJulio Soto Gurpide, Zayra Munoz Dominguez","organizer":"","country":"Hiszpania","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":94,"image":"\/uploads\/event\/\/1789472127.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5596":{"id":5596,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-5-2","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-24T15:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 14:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 15:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5507":{"id":5507,"title":"Gala Operetki: operetkowo i rozrywkowo ","url":"\/kup-bilet\/gala-operetki-operetkowo-i-rozrywkowo-2026-10-24-18-00","image":"\/uploads\/event\/\/1788424777.png","date":"2026-10-24T18:00:00+02:00","availableTickets":147,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 17:00:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 18:00:00"},"products":[{"id":10,"name":"BILET NORMALNY","rawPrice":12000,"price":"120,00","allowSaleUsingPass":false,"available":147}]},"event":{"id":988,"name":"Gala Operetki: operetkowo i rozrywkowo ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nJeden wiecz\u00f3r. Dwa muzyczne \u015bwiaty. Niezliczona ilo\u015b\u0107 emocji!\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nDrogie Panie, Szanowni Panowie \u2013 przed Pa\u0144stwem wiecz\u00f3r, kt\u00f3rego nie b\u0119dzie mo\u017cna zapomnie\u0107!<br>\r\n<br>\r\nZapraszamy na wyj\u0105tkow\u0105 Gal\u0119 Operetki \u2013 Operetkowo i Rozrywkowo, gdzie elegancja spotyka si\u0119 z szalon\u0105 energi\u0105, klasyka z najwi\u0119kszymi przebojami, a operetkowa magia przeplata si\u0119 z muzyczn\u0105 nostalgi\u0105.<br>\r\n<br>\r\nTo nie jest zwyk\u0142y koncert.<br>\r\nTo prawdziwa uczta dla oczu, uszu i serca!<br>\r\n<br>\r\nPrzeniesiemy Pa\u0144stwa do \u015bwiata pe\u0142nego blasku, pi\u0119knych melodii, kolorowych kostium\u00f3w, energicznego ta\u0144ca, dobrego humoru i wielkich emocji. A wszystko to w rytmie utwor\u00f3w, kt\u00f3re od pokole\u0144 zachwycaj\u0105, wzruszaj\u0105 i porywaj\u0105 publiczno\u015b\u0107.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nOPERETKOWA ELEGANCJA + ENERGIA WIELKICH PRZEBOJ\u00d3W<br>\r\n<br>\r\nNa scenie spotkaj\u0105 si\u0119 dwa niezwyk\u0142e muzyczne \u015bwiaty.<br>\r\n<br>\r\nOPERETKOWO \u2013 najpi\u0119kniejsze arie, duety i melodie operetkowe, bajeczne kostiumy, porywaj\u0105ca choreografia i wokal na najwy\u017cszym poziomie.<br>\r\n<br>\r\nROZRYWKOWO \u2013 wielkie przeboje legend muzyki rozrywkowej w \u015bwie\u017cych, energetycznych aran\u017cacjach, kt\u00f3re zabior\u0105 Pa\u0144stwa w sentymentaln\u0105 podr\u00f3\u017c przez z\u0142ote lata muzyki.<br>\r\n<br>\r\nB\u0119dzie romantycznie, wzruszaj\u0105co, zabawnie, zmys\u0142owo i\u2026 naprawd\u0119 przebojowo!<br>\r\n<br>\r\nW PROGRAMIE<br>\r\n- najpi\u0119kniejsze melodie operetkowe,<br>\r\n- niezapomniane przeboje wielkich legend,<br>\r\n- porywaj\u0105ce duety i popisowe arie,<br>\r\n- nowe, pe\u0142ne energii aran\u017cacje znanych utwor\u00f3w,<br>\r\n- widowiskowa choreografia i zachwycaj\u0105ce kostiumy.<br>\r\n<br>\r\nNA SCENIE WYJ\u0104TKOWI ARTY\u015aCI<br>\r\n<br>\r\nJoanna Wojtaszewska \u2013 sopran o krystalicznej barwie i scenicznej charyzmie.<br>\r\nAnna Jakiesz-B\u0142asiak \u2013 sopran o aksamitnym g\u0142osie i teatralnym wdzi\u0119ku.<br>\r\nKamil Roch Karolczuk \u2013 tenor o magnetycznej sile wyrazu - mistrz scenicznego uroku.<br>\r\nMiko\u0142aj \u201eMiko\u201d Kr\u00f3l \u2013 tenor o niepowtarzalnej barwie i uroku osobistym.<br>\r\nKamerali\u015bci Zespo\u0142u Operetkowego \u2013 wirtuozi d\u017awi\u0119ku i klimatu, kt\u00f3rzy nadaj\u0105 koncertowi wyj\u0105tkow\u0105 muzyczn\u0105 opraw\u0119.<br>\r\nPara taneczna \u2013 wulkan energii, kipi\u0105cy perfekcj\u0105 i scenicznym urokiem<br>\r\n<br>\r\nOPERETKOWO &amp; ROZRYWKOWO to spotkanie klasyki z rozrywk\u0105, elegancji z energi\u0105 i ponadczasowych melodii z muzyczn\u0105 nostalgi\u0105.<br>\r\n<br>\r\nTo propozycja dla wszystkich, kt\u00f3rzy ceni\u0105 pi\u0119kne g\u0142osy, wielkie przeboje, widowiskow\u0105 opraw\u0119 i emocje, kt\u00f3re pozostaj\u0105 na d\u0142ugo po ostatnich brawach.<br>\r\n<br>\r\nNiech ten wyj\u0105tkowy wiecz\u00f3r stanie si\u0119 okazj\u0105 do oderwania od codzienno\u015bci i zanurzenia w \u015bwiecie muzyki, kt\u00f3ra zachwyca, wzrusza i porywa.<br>\r\n<br>\r\nWarto zarezerwowa\u0107 swoje miejsca ju\u017c dzi\u015b!\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nCzas trwania: ok. 90 minut pe\u0142nych muzycznych wzrusze\u0144, u\u015bmiechu i dobrej energii.<br>\r\n<br>\r\nNie czekajcie na ostatni\u0105 chwil\u0119 \u2013 pi\u0119kny wiecz\u00f3r zaczyna si\u0119 od zakupu biletu.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 120 PLN<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1788424777.png","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5627":{"id":5627,"title":"INNA MAMUSIA ","url":"\/kup-bilet\/inna-mamusia-2026-10-23-18-00-1","image":"\/uploads\/event\/\/1789741073.jpg","date":"2026-10-24T18:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 17:00:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 18:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":999,"name":"INNA MAMUSIA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nO\u015bmioletnia Bela zaczyna dostrzega\u0107 w swoim domu tajemnicz\u0105 obecno\u015b\u0107.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Istota, kt\u00f3ra coraz cz\u0119\u015bciej pojawia si\u0119 w jej otoczeniu, wygl\u0105da niemal identycznie jak jej ukochana mama. Dziewczynka nawi\u0105zuje z ni\u0105 niezwyk\u0142\u0105 wi\u0119\u017a, nie zdaj\u0105c sobie sprawy, \u017ce za znajom\u0105 twarz\u0105 kryje si\u0119 co\u015b niewyobra\u017calnie mrocznego.\r\n<br>\r\nGdy granica mi\u0119dzy rzeczywisto\u015bci\u0105 a koszmarem zaczyna si\u0119 zaciera\u0107, rodzina Beli staje w obliczu przera\u017caj\u0105cej prawdy.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 90\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Other Mommy","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror","director":"Rob Savage","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1789741073.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5530":{"id":5530,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-02-17-00-6-2","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-24T20:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-24 19:30:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-24 20:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5597":{"id":5597,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-5-3","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-25T10:00:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-25 09:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-25 10:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5606":{"id":5606,"title":"SUPERMOCNI ","url":"\/kup-bilet\/supermocni-2026-10-23-13-30-2","image":"\/uploads\/event\/\/1789472127.jpg","date":"2026-10-25T13:30:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-25 12:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-25 13:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":996,"name":"SUPERMOCNI ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nGdy \u015bwiat jest w niebezpiecze\u0144stwie, tylko SUPERMOCNI mog\u0105 go ocali\u0107.\r\n\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej dziwnej mutacji. Ale to nie jedyny problem. Ot\u00f3\u017c pewien \u017c\u0105dny w\u0142adzy naukowiec chce za pomoc\u0105 owej kosmicznej substancji przej\u0105\u0107 panowanie nad \u015bwiatem. Je\u015bli wpadnie ona w jego \u0142apy, na ratunek b\u0119dzie za p\u00f3\u017ano. Zo\u015bka i jej zwierzaki musz\u0105 zapanowa\u0107 nad swoimi super mocami i wykorzysta\u0107 je do ratowania planety.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 94\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Evolution","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, animacja","director":"JJulio Soto Gurpide, Zayra Munoz Dominguez","organizer":"","country":"Hiszpania","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":94,"image":"\/uploads\/event\/\/1789472127.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"4718":{"id":4718,"title":"MI\u0141O\u015a\u0106 I POLITYKA ","url":"\/kup-bilet\/milosc-i-polityka-2026-10-25-15-00","image":"\/uploads\/event\/\/1775115543.jpg","date":"2026-10-25T15:00:00+01:00","availableTickets":38,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-25 14:00:00","startAt":"2026-04-02 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-25 15:00:00"},"products":[{"id":6,"name":"BILET NORMALNY","rawPrice":14000,"price":"140,00","allowSaleUsingPass":false,"available":28},{"id":45,"name":"BILET NORMALNY","rawPrice":9000,"price":"90,00","allowSaleUsingPass":false,"available":10}]},"event":{"id":896,"name":"MI\u0141O\u015a\u0106 I POLITYKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\n\u015awiat przedstawiony we francuskiej komedii, to du\u017ce pieni\u0105dze, wp\u0142ywowi ludzie i wielkie tajemnice.\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nKomedia przenosi widza do miejsca, gdzie mi\u0142o\u015b\u0107, w\u0142adza i pieni\u0105dze stanowi\u0105 stawk\u0119 w nieustannej walce.<br>\r\n<br>\r\nNie brakuje wi\u0119c dynamicznej akcji, zaskakuj\u0105cych wydarze\u0144 i dobrego humoru.<br>\r\n<br>\r\nPremier Bertrand Gu\u00e9raud kocha ojczyzn\u0119 i \u017con\u0119, ale jeszcze bardziej rajcuj\u0105 go pieni\u0105dze. By dorobi\u0107 si\u0119 fortuny, prowadzi podejrzane interesy i notorycznie \u0142amie prawo. Przez lata p\u0142awi si\u0119 w luksusach i prowadzi \u017cycie jak z bajki. Nie spodziewa si\u0119, \u017ce w jednej sekundzie ca\u0142y jego \u015bwiat mo\u017ce lec w gruzach.<br>\r\n<br>\r\nA wszystko za spraw\u0105 teczki z kompromituj\u0105cymi go materia\u0142ami, kt\u00f3ra trafi\u0142a w niepowo\u0142ane r\u0119ce. Jak wysok\u0105 cen\u0119 b\u0119dzie w stanie zap\u0142aci\u0107, \u017ceby unikn\u0105\u0107 skandalu? Do czego posunie si\u0119, by prawda nie wysz\u0142a na jaw? Chyba nikt nie spodziewa si\u0119, jak zako\u0144czy si\u0119 ta pe\u0142na zwrot\u00f3w akcji historia.<br>\r\n<br>\r\nZnakomita komedia z plejad\u0105 polskich gwiazd takich jak Melania Grzesiewicz\/Marysia Wieczorek, Anna Oberc, \u0141ukasz Nowicki i Krystian Wieczorek\/Jacek Kr\u00f3l, Jacek Kopczy\u0144ski\/Mariusz Dr\u0119\u017cek ods\u0142ania prawd\u0119 o ludzkich nami\u0119tno\u015bciach i pokazuje, jak \u015bwiat polityki wygl\u0105da od kuchni. A przy tym \u2013 bawi do \u0142ez.<br>\r\n<br>\r\nSkandalem by\u0142oby jej nie zobaczy\u0107!\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nkomedia teatralna Pierre\u2019a Sauvilla<br>\r\n<br>\r\nre\u017cyseria: Anna Oberc<br>\r\n<br>\r\nprzek\u0142ad: Barbara Grzegorzewska<br>\r\n<br>\r\nscenografia: Witek Stefaniak\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 90 \/ 140 PLN\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/spektakl-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Spektakl","categoryId":4,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1775115543.jpg","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5598":{"id":5598,"title":"ZAPOMNIANA WYSPA ","u