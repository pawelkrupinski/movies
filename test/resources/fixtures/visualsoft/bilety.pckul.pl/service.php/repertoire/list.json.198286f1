 sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 5+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 88\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"La fille dans les nuages","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny, przygodow","director":"Philippe Riche","organizer":"","country":"Belgia, Francja","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":88,"image":"\/uploads\/event\/\/1787634246.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5413":{"id":5413,"title":"DZIE\u0143 DZIECKA KSI\u0118DZA JANA KACZKOWSKIEGO ","url":"\/kup-bilet\/dzien-dziecka-ksiedza-jana-kaczkowskiego-2026-09-11-13-30-4","image":"\/uploads\/event\/\/1787563547.jpg","date":"2026-09-26T16:00:00+02:00","availableTickets":121,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 15:00:00","startAt":"2026-08-24 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 16:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":111},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":975,"name":"DZIE\u0143 DZIECKA KSI\u0118DZA JANA KACZKOWSKIEGO ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nKsi\u0105dz Jan Kaczkowski - charyzmatyczny duchowny i zwyk\u0142y b\u0142\u0105dz\u0105cy cz\u0142owiek.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Naznaczony nieuleczaln\u0105 chorob\u0105, samozwa\u0144czy \"onkocelebryta\", kt\u00f3ry walczy\u0142 dla innych o godno\u015b\u0107 i cz\u0142owiecze\u0144stwo. Dzie\u0144 dziecka - diagnoza choroby, wspomnienia z dzieci\u0144stwa, symboliczne narodzenie dla wieczno\u015bci. Metaforyczny termin, kt\u00f3ry w filmie koncentruje uwag\u0119 na mi\u0142o\u015b\u0107. Na mi\u0142o\u015bci do innych ludzi, chorych i pogubionych, na mi\u0142o\u015bci do rodziny, do ojca i do Boga. To tak\u017ce film o potrzebie kochania i bycia kochanym. Skonstruowany z nieznanych archiwali\u00f3w, prawdziwy portret niezwyk\u0142ego cz\u0142owieka.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 75\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dokument, biograficzny","director":"Artur Wierzbicki","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":75,"image":"\/uploads\/event\/\/1787563547.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5021":{"id":5021,"title":"\u015al\u0105sko-G\u00f3ralska Biesiada z TVS ","url":"\/kup-bilet\/slasko-goralska-biesiada-z-tvs-2026-09-26-17-00","image":"\/uploads\/event\/944\/1781875187.png","date":"2026-09-26T17:00:00+02:00","availableTickets":14,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 16:00:00","startAt":"2026-06-09 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 17:00:00"},"products":[{"id":2,"name":"BILET NORMALNY","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":0},{"id":43,"name":"BILET NORMALNY \u267f","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":1},{"id":45,"name":"BILET NORMALNY","rawPrice":9000,"price":"90,00","allowSaleUsingPass":false,"available":13}]},"event":{"id":944,"name":"\u015al\u0105sko-G\u00f3ralska Biesiada z TVS ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nJu\u017c 26 wrze\u015bnia Telewizja TVS zabierze widz\u00f3w w wyj\u0105tkow\u0105 muzyczn\u0105 podr\u00f3\u017c, \u0142\u0105cz\u0105c\u0105 dwa niezwykle barwne i pe\u0142ne tradycji \u015bwiaty \u2013 \u015al\u0105sk i kultur\u0119 g\u00f3ralsk\u0105.\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nNa scenie Pszczy\u0144skiego Centrum Kultury zacznie rz\u0105dzi\u0107 muzyka, kt\u00f3ra od pokole\u0144 buduje to\u017csamo\u015b\u0107 tych region\u00f3w, a wszystko to w nowoczesnej, energetycznej ods\u0142onie.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nTego wieczoru publiczno\u015b\u0107 porw\u0105 znani i lubiani arty\u015bci: Pawe\u0142 Go\u0142ecki, Mateusz Szymczyk, Claudia i Kasia Chwo\u0142ka, Jula, Yejku oraz Beathris. Ka\u017cdy z nich wniesie na scen\u0119 sw\u00f3j unikalny styl, prezentuj\u0105c zar\u00f3wno tradycyjne brzmienia, jak i ich wsp\u00f3\u0142czesne interpretacje.<br>\r\nW repertuarze nie zabraknie zar\u00f3wno \u015bl\u0105skich szlagier\u00f3w, jak i g\u00f3ralskich nut pe\u0142nych energii i emocji. To spotkanie kultur poka\u017ce, jak wiele \u0142\u0105czy te dwa \u015bwiaty  \u2013 od zami\u0142owania do muzyki, przez silne przywi\u0105zanie do tradycji, a\u017c po niezwyk\u0142\u0105 go\u015bcinno\u015b\u0107 i rado\u015b\u0107 wsp\u00f3lnego \u015bwi\u0119towania.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nCzy arty\u015bci udowodni\u0105, \u017ce \u015al\u0105zak i G\u00f3ral to naprawd\u0119 dwa bratanki? Wszystko wskazuje na to, \u017ce czeka nas wiecz\u00f3r pe\u0142en wzrusze\u0144, ta\u0144ca i niezapomnianych chwil. To wydarzenie, kt\u00f3rego nie mo\u017cna przegapi\u0107 \u2013 zar\u00f3wno dla mi\u0142o\u015bnik\u00f3w folkloru, jak i tych, kt\u00f3rzy dopiero chc\u0105 odkry\u0107 jego wyj\u0105tkowy urok.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 110 \/ 90 PLN (ulgowe 90 \/ 80 PLN)\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/944\/1781875187.png","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5584":{"id":5584,"title":"Relaksacyjny koncert kamertonowy  ","url":"\/kup-bilet\/relaksacyjny-koncert-kamertonowy-2026-08-30-18-00-1","image":"\/uploads\/event\/700\/1789469444.png","date":"2026-09-26T18:00:00+02:00","availableTickets":20,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 17:00:00","startAt":"2026-06-09 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 18:00:00"},"products":[{"id":355,"name":"BILET","rawPrice":7000,"price":"70,00","allowSaleUsingPass":false,"available":20}]},"event":{"id":700,"name":"Relaksacyjny koncert kamertonowy  ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nOdzyskaj r\u00f3wnowag\u0119: Relaksacyjny koncert kamertonowy\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nCzy czujesz, \u017ce Tw\u00f3j organizm dzia\u0142a na \u201epodwy\u017cszonych obrotach\u201d, a chroniczne napi\u0119cie sta\u0142o si\u0119 Twoim cichym towarzyszem? Tw\u00f3j uk\u0142ad nerwowy potrzebuje profesjonalnego wsparcia, aby wyj\u015b\u0107 ze stanu ci\u0105g\u0142ego czuwania.\r\n<br><br>\r\nZapraszam Ci\u0119 na Relaksacyjny Koncert Kamertonowy \u2013 sesj\u0119, w kt\u00f3rej d\u017awi\u0119k staje si\u0119 narz\u0119dziem g\u0142\u0119bokiej regeneracji Twojego cia\u0142a i umys\u0142u.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\n<strong>Dlaczego kamertony to wsparcie dla Twojego uk\u0142adu nerwowego?<\/strong>\r\n<br><br>\r\nW dzisiejszym \u015bwiecie Tw\u00f3j uk\u0142ad nerwowy jest nieustannie przeci\u0105\u017cony nadmiarem bod\u017ac\u00f3w. D\u017awi\u0119koterapia kamertonami dzia\u0142a na poziomie biologicznym, wykraczaj\u0105c poza zwyk\u0142y relaks:\r\n<br><br>\r\n    <strong>Wyciszenie uk\u0142adu wsp\u00f3\u0142czulnego<\/strong>: Precyzyjne cz\u0119stotliwo\u015bci kamerton\u00f3w pomagaj\u0105 prze\u0142\u0105czy\u0107 uk\u0142ad nerwowy z trybu \u201ewalki lub ucieczki\u201d (odpowiedzialnego za stres) na tryb przywsp\u00f3\u0142czulny, kt\u00f3ry jest niezb\u0119dny do regeneracji tkanek i narz\u0105d\u00f3w.\r\n<br><br>\r\n    <strong>Wprowadzenie w stany regeneracyjne<\/strong>: Wibracja d\u017awi\u0119ku wspiera m\u00f3zg w przechodzeniu z fal beta (aktywno\u015b\u0107, stres) do fal <strong>alfa i theta<\/strong>. To stany, w kt\u00f3rych cia\u0142o naturalnie rozpoczyna procesy samonaprawy i g\u0142\u0119bokiego odpoczynku.\r\n<br><br>\r\n    <strong>Redukcja chemicznych skutk\u00f3w stresu<\/strong>: Dzi\u0119ki g\u0142\u0119bokiej relaksacji poziom kortyzolu \u2013 hormonu stresu \u2013 spada, co pozwala Twojemu organizmowi odetchn\u0105\u0107 i odzyska\u0107 metaboliczn\u0105 r\u00f3wnowag\u0119.\r\n<br><br>\r\n<strong>Co zyskasz dzi\u0119ki temu spotkaniu?<\/strong>\r\n<br><br>\r\n    <strong>Ukojenie \u201erozchwianego\u201d uk\u0142adu nerwowego<\/strong>: Poczujesz realn\u0105 ulg\u0119 w napi\u0119ciach mi\u0119\u015bniowych i gonitwie my\u015bli, co przyniesie Ci stan b\u0142ogiego spokoju.\r\n<br><br>\r\n    <strong>G\u0142\u0119boka regeneracja<\/strong>: Odpoczynek podczas koncertu przek\u0142ada si\u0119 na lepsz\u0105 jako\u015b\u0107 snu i wy\u017cszy poziom energii w kolejnych dniach.\r\n<br><br>\r\n    <strong>Oczyszczenie z \u201eprzebod\u017acowania\u201d<\/strong>: D\u017awi\u0119k kamerton\u00f3w dzia\u0142a jak \u201ereset\u201d dla Twojego umys\u0142u, przywracaj\u0105c klarowno\u015b\u0107 my\u015blenia i wewn\u0119trzn\u0105 stabilno\u015b\u0107.\r\n<br><br>\r\n    <strong>Wzmocnienie odporno\u015bci<\/strong>: Wprowadzaj\u0105c cia\u0142o w stan harmonii, wspierasz swoje naturalne mechanizmy obronne.\r\n<br><br>\r\n<strong>Redukcja napi\u0119\u0107 mi\u0119\u015bniowych<\/strong>: Wibracje akustyczne pomagaj\u0105 uwolni\u0107 skumulowany w ciele stres i napi\u0119cia.\r\n<br><br>\r\n<strong>Higiena umys\u0142u<\/strong>: Monotonia i harmonia d\u017awi\u0119k\u00f3w u\u0142atwiaj\u0105 odci\u0119cie si\u0119 od codziennych bod\u017ac\u00f3w, wspieraj\u0105c koncentracj\u0119 i regeneracj\u0119 psychiczn\u0105.<br><\/span><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\n<strong>Informacje organizacyjne<\/strong>\r\n<br><br>\r\n    <strong>Kiedy<\/strong>: 26 wrze\u015bnia (sobota), godz. 18:00<br><br>\r\n    <strong>Miejsce<\/strong>: pckul, ul. Jagie\u0142\u0142y 1 (I pi\u0119tro, sala taneczna).\r\n<br><br>\r\n    <strong>Inwestycja w Tw\u00f3j spok\u00f3j<\/strong>: 70 z\u0142 \r\n<br><br>\r\n    <strong>Kontakt<\/strong>: 505 183 735\r\n<br><br>\r\n<strong>Co zabra\u0107?<\/strong> Wygodny str\u00f3j, mat\u0119, ulubiony koc oraz poduszk\u0119 \u2013 zadbaj o sw\u00f3j komfort.\r\n<br><br>\r\nLiczba miejsc jest ograniczona, aby zapewni\u0107 ka\u017cdemu uczestnikowi intymn\u0105 i koj\u0105c\u0105 przestrze\u0144. Nie odk\u0142adaj swojego dobrostanu na p\u00f3\u017aniej \u2013 podaruj sobie ten czas. Zapro\u015b blisk\u0105 osob\u0119, kt\u00f3ra r\u00f3wnie\u017c potrzebuje chwili wytchnienia od codzienno\u015bci.\r\n<br><br>\r\n<strong>Do zobaczenia w wibracji spokoju!<\/strong>\r\n<br><br>\r\nD\u017awi\u0119cznie zaprasza,<br>\r\nEwa Stroi\u0144ska\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 70 PLN\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/700\/1789469444.png","artists":[]},"location":{"id":30,"name":"Sala taneczna - I pi\u0119tro","institution_name":"","location_description":"","location_type":2,"location_type_name":"otwarte","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5460":{"id":5460,"title":"RESIDENT EVIL ","url":"\/kup-bilet\/resident-evil-2026-09-18-18-00-4","image":"\/uploads\/event\/\/1787571584.jpg","date":"2026-09-26T18:00:00+02:00","availableTickets":108,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 17:00:00","startAt":"2026-08-24 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 18:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":106},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":2}]},"event":{"id":980,"name":"RESIDENT EVIL ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nOd tw\u00f3rcy hit\u00f3w grozy BARBARZY\u0143CY i ZNIKNI\u0118CIA, Zacha Creggera, nadchodzi zupe\u0142nie nowy rozdzia\u0142 kultowej serii RESIDENT EVIL.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Pe\u0142en napi\u0119cia, adrenaliny i bezlitosnej walki o przetrwanie film przedstawia histori\u0119 Bryana (Austin Abrams), zwyk\u0142ego kuriera medycznego, kt\u00f3rego \u017cycie zmienia si\u0119 w koszmar podczas jednej, fatalnej nocy. Nie\u015bwiadomie zostaje wci\u0105gni\u0119ty do centrum \u015bmierciono\u015bnego chaosu, gdzie ka\u017cda decyzja mo\u017ce oznacza\u0107 \u017cycie albo \u015bmier\u0107.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 90\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Resident Evil","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"horror","director":"Zach Cregger","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":90,"image":"\/uploads\/event\/\/1787571584.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5484":{"id":5484,"title":"W SERCU DZICZY ","url":"\/kup-bilet\/w-sercu-dziczy-2026-09-25-20-00-1","image":"\/uploads\/event\/\/1787635688.jpg","date":"2026-09-26T20:00:00+02:00","availableTickets":109,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-26 19:00:00","startAt":"2026-08-25 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 20:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":105},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":4}]},"event":{"id":982,"name":"W SERCU DZICZY ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nFilm ukazuj\u0105cy siln\u0105 wi\u0119\u017a mi\u0119dzy cz\u0142owiekiem, a jego wiernym psim towarzyszem.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Brad Pitt i owczarek niemiecki walcz\u0105 o przetrwanie na dzikich terenach Alaski. Po katastrofie lotniczej w samym sercu dzikiej Alaski do\u015bwiadczony by\u0142y \u017co\u0142nierz si\u0142 specjalnych James Belmont (Brad Pitt) i jego pies bojowy Odin, zostaj\u0105 odci\u0119ci od \u015bwiata zdani wy\u0142\u0105cznie na w\u0142asne umiej\u0119tno\u015bci. Razem musz\u0105 stoczy\u0107 walk\u0119 o przetrwanie w obliczu brutalnych si\u0142 natury.\r\n<br><br>\r\nW SERCU DZICZY, film autorstwa uznanego re\u017cysera Davida Ayera, to intensywny thriller przygodowy, kt\u00f3ry ukazuje nierozerwaln\u0105 wi\u0119\u017a mi\u0119dzy cz\u0142owiekiem a jego najlepszym przyjacielem w obliczu ich najwi\u0119kszej jak dot\u0105d bitwy.\r\n<br><br>\r\nW filmie zobaczymy r\u00f3wnie\u017c laureata Oscara J.K. Simmonsa i Anne Lambe, ale W SERCU DZICZY to w pe\u0142ni film Brada Pitta, pierwszy od prawie dziesi\u0119ciu lat film, w kt\u00f3rym Pitt wyst\u0119puje w roli g\u0142\u00f3wnej bez licznej obsady drugoplanowej.\r\n<br><br>\r\nW SERCU DZICZY to te\u017c ponowne spotkanie re\u017cysera Davida Ayera z Pittem, kt\u00f3rzy wcze\u015bniej pracowali przy dramacie wojennym FURIA z 2014 roku. Ayer uwa\u017ca jednak, \u017ce w nowym filmie Pitt pokazuje si\u0119 z zupe\u0142nie nowej strony: To prawdziwa bestia. By\u0142 wra\u017cliwy i otworzy\u0142 si\u0119 w spos\u00f3b, jakiego jeszcze nie widzia\u0142em. Ludzie, kt\u00f3rzy obejrzeli film, nieustannie podkre\u015blaj\u0105, jak surowa, wiarygodna i g\u0142\u0119boka jest jego rola.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 15+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 96\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Heart of the Beast","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"thriller","director":"David Ayer","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":96,"image":"\/uploads\/event\/\/1787635688.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5469":{"id":5469,"title":"LUNA I ROZGADANA \u015aWINKA ","url":"\/kup-bilet\/luna-i-rozgadana-swinka-2026-09-25-14-00-3","image":"\/uploads\/event\/\/1787634246.jpg","date":"2026-09-27T10:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-27 09:00:00","startAt":"2026-08-25 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-27 10:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":981,"name":"LUNA I ROZGADANA \u015aWINKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nJedenastoletnia Luna, fanka serii ksi\u0105\u017cek o super-bohaterach walcz\u0105cych o \u015brodowisko, otrzymuje magiczne pi\u00f3ro od tajemniczego autora ksi\u0105\u017cek. \r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Ten zaczarowany przedmiot sprawia, \u017ce wszystko, co napisze, staje si\u0119 rzeczywisto\u015bci\u0105. Dziewczynka odkrywa, jak pot\u0119\u017cna jest jego moc i rusza w niebezpieczn\u0105 wypraw\u0119, by naprawi\u0107 szkody wyrz\u0105dzone \u015brodowisku i ocali\u0107 planet\u0119 przed nadci\u0105gaj\u0105c\u0105 katastrof\u0105. Towarzyszy jej Airbag, ukochana \u015bwinka morska, kt\u00f3ra dzi\u0119ki u\u017cyciu pi\u00f3ra nieoczekiwanie zaczyna m\u00f3wi\u0107. Jednak niezwykle nikczemny tw\u00f3rca czarodziejskiego przedmiotu zrobi wszystko, aby ich misja sko\u0144czy\u0142a si\u0119 niepowodzeniem. \u201eLuna i rozgadana \u015bwinka\u201d to pe\u0142na serca i humoru opowie\u015b\u0107 o dojrzewaniu, wyobra\u017ani i odpowiedzialno\u015bci.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 5+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 88\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"La fille dans les nuages","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny, przygodow","director":"Philippe Riche","organizer":"","country":"Belgia, Francja","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":88,"image":"\/uploads\/event\/\/1787634246.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5470":{"id":5470,"title":"LUNA I ROZGADANA \u015aWINKA ","url":"\/kup-bilet\/luna-i-rozgadana-swinka-2026-09-25-14-00-4","image":"\/uploads\/event\/\/1787634246.jpg","date":"2026-09-27T14:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-09-27 13:00:00","startAt":"2026-08-25 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-27 14:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":981,"name":"LUNA I ROZGADANA \u015aWINKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Cali