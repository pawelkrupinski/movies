ion_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5565":{"id":5565,"title":"ROLLING LOUD ","url":"\/kup-bilet\/rolling-loud-2026-10-09-16-00-5","image":"\/uploads\/event\/\/1789457476.jpg","date":"2026-10-18T15:15:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 14:15:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-18 15:15:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":993,"name":"ROLLING LOUD ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nNadopieku\u0144czy ojciec podejmuje fataln\u0105 decyzj\u0119, potajemnie zabieraj\u0105c trzynastoletniego syna na hip-hopowy festiwal Rolling Loud.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Co mo\u017ce p\u00f3j\u015b\u0107 nie tak, gdy ojciec \u0142amie wszelkie zasady i przemyca trzynastoletniego syna na najwi\u0119kszy hip-hopowy festiwal \u015bwiata? Odpowied\u017a: absolutnie wszystko. To b\u0119dzie dzie\u0144, kt\u00f3rego \u017caden z nich nigdy nie zapomni.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 95\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Rolling Loud: The Movie","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, muzyczny","director":"Jeremy Garelick","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":95,"image":"\/uploads\/event\/\/1789457476.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"4223":{"id":4223,"title":"Szlagierowa Uczta z Radiem Silesia ","url":"\/kup-bilet\/szlagierowa-uczta-z-radiem-silesia-2026-10-18-16-00","image":"\/uploads\/event\/813\/1769150752.jpg","date":"2026-10-18T16:00:00+02:00","availableTickets":5,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 15:00:00","startAt":"2026-01-23 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-18 16:00:00"},"products":[{"id":2,"name":"BILET NORMALNY","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":0},{"id":43,"name":"BILET NORMALNY \u267f","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":2},{"id":171,"name":"BILET NORMALNY","rawPrice":9500,"price":"95,00","allowSaleUsingPass":false,"available":3}]},"event":{"id":813,"name":"Szlagierowa Uczta z Radiem Silesia ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\n18 pa\u017adziernika 2026 r. (niedziela godz. 16:00) w Pszczy\u0144skim Centrum Kultury koncert jakiego jeszcze nie by\u0142o!\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nDwie ikony szlagierowego rynku: Mariusz Kalaga oraz Toby z Monachium na jednej scenie!\r\n<br><br>\r\nB\u0119dzie pysznie, b\u0119dzie smacznie, b\u0119dzie niepowtarzalnie. \u015apieszcie si\u0119 z rezerwacj\u0105 miejsc, bo co\u015b nam m\u00f3wi, \u017ce te znikn\u0105 niczym ciep\u0142e bu\u0142eczki. Bilety do kupienia w kasie pckulu oraz na stronie bilety.pckul.pl\r\n<br><br>\r\nRadio Silesia 96,2 fm \u2013 polecamy z ca\u0142ego serca!\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 110 \/ 95 PLN (ulgowe 95 PLN)\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/813\/1769150752.jpg","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5524":{"id":5524,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-02-17-00-8","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-18T17:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 16:00:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-18 17:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5249":{"id":5249,"title":"Kabaret OT.TO i Toby z Monachium z Radiem Silesia ","url":"\/kup-bilet\/kabaret-ot-to-i-toby-z-monachium-z-radiem-silesia-2026-10-18-19-00","image":"\/uploads\/event\/\/1783590898.jpg","date":"2026-10-18T19:00:00+02:00","availableTickets":327,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-18 18:00:00","startAt":"2026-07-09 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-18 19:00:00"},"products":[{"id":39,"name":"BILET NORMALNY","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":231},{"id":43,"name":"BILET NORMALNY \u267f","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":4},{"id":171,"name":"BILET NORMALNY","rawPrice":9500,"price":"95,00","allowSaleUsingPass":false,"available":92}]},"event":{"id":957,"name":"Kabaret OT.TO i Toby z Monachium z Radiem Silesia ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\n18 pa\u017adziernika 2026 r. (niedziela godz. 19:00) w Pszczy\u0144skim Centrum Kultury koncert jakiego jeszcze nie by\u0142o!\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nPo\u0142\u0105czenie kabaretu i muzycznego show. Ikoniczny KABARET OT.TO oraz wulkan energii tj. jedyny i niepowtarzalny TOBY Z MONACHIUM na jednej scenie! Czeka nas prawdziwa kabaretowo- muzyczna uczta z Radiem Silesia.\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nB\u0119dzie pysznie, b\u0119dzie smacznie, b\u0119dzie niepowtarzalnie. \u015apieszcie si\u0119 z rezerwacj\u0105 miejsc, bo co\u015b nam m\u00f3wi, \u017ce te znikn\u0105 niczym ciep\u0142e bu\u0142eczki. Bilety do kupienia w kasie pckulu oraz na stronie bilety.pckul.pl\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nRadio Silesia 96,2 fm \u2013 polecamy z ca\u0142ego serca!\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: 110 \/ 95 PLN (ulgowe 95 PLN)\r\n\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/koncert-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Koncert","categoryId":1,"omomoCategory":"1","duration":0,"imag