":"#f8a41e","movieType":"czarna komedia \/ dramat \/ kino","director":"Alejandro Gonz\u00e1lez I\u00f1\u00e1rritu","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":140,"image":"\/uploads\/event\/\/1789461931.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5562":{"id":5562,"title":"ROLLING LOUD ","url":"\/kup-bilet\/rolling-loud-2026-10-12-16-00-3","image":"\/uploads\/event\/\/1789457476.jpg","date":"2026-10-15T16:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-15 15:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-15 16:00:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":993,"name":"ROLLING LOUD ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nNadopieku\u0144czy ojciec podejmuje fataln\u0105 decyzj\u0119, potajemnie zabieraj\u0105c trzynastoletniego syna na hip-hopowy festiwal Rolling Loud.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Co mo\u017ce p\u00f3j\u015b\u0107 nie tak, gdy ojciec \u0142amie wszelkie zasady i przemyca trzynastoletniego syna na najwi\u0119kszy hip-hopowy festiwal \u015bwiata? Odpowied\u017a: absolutnie wszystko. To b\u0119dzie dzie\u0144, kt\u00f3rego \u017caden z nich nigdy nie zapomni.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 95\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Rolling Loud: The Movie","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, muzyczny","director":"Jeremy Garelick","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":95,"image":"\/uploads\/event\/\/1789457476.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5576":{"id":5576,"title":"DIGGER ","url":"\/kup-bilet\/digger-2026-10-12-18-00-3","image":"\/uploads\/event\/\/1789461931.jpg","date":"2026-10-15T18:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-15 17:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-15 18:00:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":994,"name":"DIGGER ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nMatka Natura? Oooooooooch, ona uwielbia zwyci\u0119zc\u00f3w! DIGGER.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Najpot\u0119\u017cniejszy cz\u0142owiek \u015bwiata wyrusza na desperack\u0105 misj\u0119, by udowodni\u0107, \u017ce jest zbawc\u0105 ludzko\u015bci, zanim katastrofa, kt\u00f3r\u0105 wywo\u0142a\u0142, zniszczy wszystko.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 140\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Digger","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"czarna komedia \/ dramat \/ kino","director":"Alejandro Gonz\u00e1lez I\u00f1\u00e1rritu","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":140,"image":"\/uploads\/event\/\/1789461931.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5369":{"id":5369,"title":"Rewia Burleski Madame de Minou ","url":"\/kup-bilet\/rewia-burleski-madame-de-minou-2026-10-15-19-00","image":"\/uploads\/event\/915\/1786348478.png","date":"2026-10-15T19:00:00+02:00","availableTickets":31,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-15 18:00:00","startAt":"2026-08-10 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-15 19:00:00"},"products":[{"id":17,"name":"BILET NORMALNY","rawPrice":15000,"price":"150,00","allowSaleUsingPass":false,"available":12},{"id":255,"name":"BILET NORMALNY","rawPrice":17000,"price":"170,00","allowSaleUsingPass":false,"available":3},{"id":257,"name":"BILET NORMALNY","rawPrice":16000,"price":"160,00","allowSaleUsingPass":false,"available":16},{"id":268,"name":"BILET NORMALNY","rawPrice":18000,"price":"180,00","allowSaleUsingPass":false,"available":0},{"id":390,"name":"BILET NORMALNY","rawPrice":19000,"price":"190,00","allowSaleUsingPass":false,"available":0}]},"event":{"id":915,"name":"Rewia Burleski Madame de Minou ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"box-sizing: border-box; margin: 0px 0px 0.5rem; padding: 0px 0px 10px; border: 0px; outline: 0px; text-size-adjust: 100%; vertical-align: baseline; background: rgb(255, 255, 255); line-height: 1.2; text-align: left;\">\r\n\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\n\r\nWYDARZENIE ORGANIZATORA ZEWN\u0118TRZNEGO\r\n\r\n<\/span>\r\n\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\n\r\nSta\u0142a widownia Madame de Minou zosta\u0142a ju\u017c skutecznie uzale\u017cniona od brokatu i cekin\u00f3w, wi\u0119c wie co robi\u0107.\r\n\r\n<\/h3>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n\r\nTo w\u0142a\u015bnie oni b\u0142yskawicznie wykupuj\u0105 pierwsze rz\u0119dy. A je\u015bli pierwszy burleskowy raz jest jeszcze przed Tob\u0105, to nie masz poj\u0119cia jak Ci zazdroszcz\u0119! Odkrywanie tego spektakularnego show po raz pierwszy jest jak kruszenie skarmelizowanego cukru na wierzchu kremu brule (tu powinno by\u0107 to E z kreseczk\u0105, ale nie wiem, jak si\u0119 robi na polskiej klawiaturze) \u2013 zrozumiesz dopiero gdy poczujesz.\r\n<br><br>\r\nSkr\u00f3cona instrukcja obs\u0142ugi burleski:<br>\r\n<br>\r\n1. zbierasz ekip\u0119 \u2013 sugerujemy \u017con\u0119, babci\u0119, czy kogo tam lubisz<br>\r\n2. wchodzisz na stron\u0119 i kupujesz odpowiedni\u0105 ilo\u015b\u0107 bilet\u00f3w jak najbli\u017cej sceny<br>\r\n3. z niecierpliwo\u015bci\u0105 wyczekujesz 15.10, a w mi\u0119dzyczasie<br>\r\n4. szykujesz najbardziej fancy kieck\u0119, kt\u00f3ra nudzi si\u0119 w szafie, bo nie ma gdzie jej zak\u0142ada\u0107. Masz r\u00f3\u017cowy garnitur? Dawaj. Brokatowe kowbojki? Uwa\u017caj, bo jak b\u0119dziesz wygl\u0105da\u0107 lepiej ni\u017c Madame de Minou to Ci\u0119 wyprosimy. Na szcz\u0119\u015bcie nie jest to \u0142atwe.<br>\r\n5. 15.10 o godzinie 18:30 zamawiasz ubera i udajesz si\u0119 do Sali Widowiskowej<br>\r\n6. i na koniec\u2026 po prostu pozwalasz si\u0119 ponie\u015b\u0107.\r\n<br><br>\r\nGODZINA:<br>\r\n18:30 \u2013 otwarcie drzwi<br>\r\n19:00 \u2013 start pokaz\u00f3w<br>\r\n<br>\r\nGDZIE: Pszczy\u0144skie Centrum Kultury<br>\r\n<br>\r\nJak si\u0119 przygotowa\u0107?<br>\r\n<br>\r\nDress to impress \u2014 elegancko, ekstrawagancko, lub po prostu\u2026 \u0142adnie. To idealna okazja, aby za\u0142o\u017cy\u0107 to, za co zgani\u0142aby Ci\u0119 babcia. Wskazane jest wszystko, co sprawi, \u017ce poczujesz si\u0119 jak pasa\u017cer z g\u00f3rnego pok\u0142adu.\r\n<br><br>\r\nIle to trwa?<br><br>\r\n\r\nPlanowane s\u0105 2 akty, jak kto\u015b na Ciebie czeka w domu, to powiedz \u017ce b\u0119dziesz po 22:00<br>\r\n<br>\r\nCo wi\u0119cej?<br>\r\n<br>\r\nPrzede wszystkim warto zajrze\u0107 na stoisko gdzie znajdziecie:<br>\r\n<br>\r\nPasties (r\u0119cznie robione, oryginalne, takie bardziej \u015bwiec\u0105ce i mniej przyci\u0105gaj\u0105ce postronne spojrzenia)<br>\r\nFotosy A5 (35z\u0142), A4 (50z\u0142) (po wyst\u0119pie z\u0142ap performera, to ci strzeli dedykacj\u0119)<br>\r\nGuilty pleasures z Atelier Minou (tutaj dopiero zaczyna si\u0119 zabawa \u2013 sprawd\u017acie sami)<br>\r\n<br>\r\nWybierasz si\u0119 na burlesk\u0119? Daj nam zna\u0107 klikaj\u0105c \u201cWezm\u0119 udzia\u0142\u201d na wydarzeniu na facebooku!<br>\r\n<br>\r\nDo zobaczenia!!\r\n\r\n<\/span>\r\n<\/p>\r\n\r\n<p><\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n__________\r\n<\/span>\r\n<\/p>\r\n\r\n<p>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: bold;\">\r\n\r\nBilety: od 150 PLN\r\n<br>\r\n<\/span>\r\n<\/p>\r\n\r\n<\/th>\r\n\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/spektakl-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"Spektakl","categoryId":4,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/915\/1786348478.png","artists":[]},"location":{"id":40,"name":"Sala Widowiskowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5521":{"id":5521,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-05-17-00-7","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-15T20:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-15 19:30:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-15 20:30:00"},"products":[{"id":27,"name":"BILET VIP","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":10},{"id":36,"name":"BILET STANDARD","rawPrice":1999,"price":"19,99","allowSaleUsingPass":false,"available":112}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5586":{"id":5586,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-16T13:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-16 12:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-16 13:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5563":{"id":5563,"title":"ROLLING LOUD ","url":"\/kup-bilet\/rolling-loud-2026-10-09-16-00-3","image":"\/uploads\/event\/\/1789457476.jpg","date":"2026-10-16T15:15:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-16 14:15:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-16 15:15:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":993,"name":"ROLLING LOUD ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nNadopieku\u0144czy ojciec podejmuje fataln\u0105 decyzj\u0119, potajemnie zabieraj\u0105c trzynastoletniego syna na hip-hopowy festiwal Rolling Loud.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Co mo\u017ce p\u00f3j\u015b\u0107 nie tak, gdy ojciec \u0142amie wszelkie zasady i przemyca trzynastoletniego syna na najwi\u0119kszy hip-hopowy festiwal \u015bwiata? Odpowied\u017a: absolutnie wszystko. To b\u0119dzie dzie\u0144, kt\u00f3rego \u017caden z nich nigdy nie zapomni.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 95\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Rolling Loud: The Movie","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, muzyczny","director":"Jeremy Garelick","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":95,"image":"\/uploads\/event\/\/1789457476.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5522":{"id":5522,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-02-17-00-6","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-16T17:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-16 16:00:00","startAt":"2026-09-