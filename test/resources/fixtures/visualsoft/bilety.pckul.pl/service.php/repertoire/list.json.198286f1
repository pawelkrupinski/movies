\/uploads\/event\/\/1789461931.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5587":{"id":5587,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-1","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-17T10:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 09:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 10:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5588":{"id":5588,"title":"ZAPOMNIANA WYSPA ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-16-13-00-2","image":"\/uploads\/event\/\/1789470259.jpg","date":"2026-10-17T13:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 12:00:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 13:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":995,"name":"ZAPOMNIANA WYSPA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nPrzyja\u017a\u0144 mi\u0119dzy pe\u0142n\u0105 werwy i \u017c\u0105dn\u0105 przyg\u00f3d Jo, a odpowiedzialn\u0105 i rozs\u0105dn\u0105 Raiss\u0105, trwa od szko\u0142y podstawowej.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">W ko\u0144cu staj\u0105 u progu doros\u0142o\u015bci, a Raissa wyje\u017cd\u017ca na studia. Po\u017cegnalny wiecz\u00f3r zamienia si\u0119 w niezwyk\u0142\u0105 podr\u00f3\u017c. Za spraw\u0105 tajemniczego portalu trafiaj\u0105 na legendarn\u0105 wysp\u0119 Nakali, tajemniczy \u015bwiat inspirowany filipi\u0144sk\u0105 mitologi\u0105, zamieszkany przez fascynuj\u0105ce stworzenia, magiczne istoty, ale i niebezpiecze\u0144stwa czaj\u0105ce si\u0119 za ka\u017cdym rogiem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 110\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Forgotten Island","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny","director":"Joel Crawford, Januel Mercado","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/\/1789470259.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5564":{"id":5564,"title":"ROLLING LOUD ","url":"\/kup-bilet\/rolling-loud-2026-10-09-16-00-4","image":"\/uploads\/event\/\/1789457476.jpg","date":"2026-10-17T15:15:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 14:15:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 15:15:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":993,"name":"ROLLING LOUD ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nNadopieku\u0144czy ojciec podejmuje fataln\u0105 decyzj\u0119, potajemnie zabieraj\u0105c trzynastoletniego syna na hip-hopowy festiwal Rolling Loud.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Co mo\u017ce p\u00f3j\u015b\u0107 nie tak, gdy ojciec \u0142amie wszelkie zasady i przemyca trzynastoletniego syna na najwi\u0119kszy hip-hopowy festiwal \u015bwiata? Odpowied\u017a: absolutnie wszystko. To b\u0119dzie dzie\u0144, kt\u00f3rego \u017caden z nich nigdy nie zapomni.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 12+<br>\r\nJ\u0119zyk: EN<br>\r\nNapisy: PL<br>\r\nCzas trwania: 95\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Rolling Loud: The Movie","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"komedia, muzyczny","director":"Jeremy Garelick","organizer":"","country":"USA","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":95,"image":"\/uploads\/event\/\/1789457476.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5523":{"id":5523,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-02-17-00-7","image":"\/uploads\/event\/\/1788436558.jpg","date":"2026-10-17T17:00:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 16:00:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 17:00:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":989,"name":"LALKA ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 20px; font-weight: bold;\">\r\nBogaty warszawski kupiec zakochuje si\u0119 w zubo\u017ca\u0142ej arystokratce.\r\n<\/h3>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 13+<br>\r\nJ\u0119zyk: PL<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 162\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"dramat obyczajowy, kostiumowy","director":"Maciej Kawalski","organizer":"","country":"Polska","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/\/1788436558.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5578":{"id":5578,"title":"DIGGER ","url":"\/kup-bilet\/digger-2026-10-09-18-00-4","image":"\/uploads\/event\/\/1789461931.jpg","date":"2026-10-17T20:30:00+02:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-17 19:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-17 20:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false,"available":112},{"id":48,"name":"BILET VIP","rawPrice":2599,"price":"25,99","allowSaleUsingPass":false,"available":10}]},"event":{"id":994,"name":"DIGGER ","description":"<table style=\"width: 100%;\">\r\n<tbody>\r\n<tr>\r\n<th style=\"text-size-adjust: 100%; vertical-align: baseline; color: black; line-height: 1.2; font-family: Calibri, sans-serif; text-align: left;\">\r\n<h3 style=\"color: rgb(10, 10, 10); fo