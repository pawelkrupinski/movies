yniowe. Shaun pr\u00f3buje naprawi\u0107 to za pomoc\u0105 eksperyment\u00f3w naukowych, ale sytuacja wymyka si\u0119 spod kontroli, gdy w lesie pojawia si\u0119 dzika bestia...\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 18px; font-weight: normal;\">\r\n    __________\r\n<\/span>\r\n<br>\r\n<span style=\"color: rgb(10, 10, 10); font-family: &quot;calibri light&quot;, Helvetica, Arial, Lucida, sans-serif; font-size: 16px; font-weight: bold;\">\r\nKATEGORIA WIEKOWA: 6+<br>\r\nJ\u0119zyk: dubbing<br>\r\nNapisy: \u2212\u2212\u2212<br>\r\nCzas trwania: 80\"\r\n<\/span>\r\n<\/th>\r\n<th style=\"vertical-align: top;\">\r\n<img src=\"https:\/\/pckul.pl\/wp-content\/uploads\/2024\/05\/kino-color.png\" width=\"50\" height=\"50\">\r\n<\/th>\r\n<\/tr>\r\n<\/tbody>\r\n<\/table>","oryginal_title":"Shaun the Sheep: The Beast of Mossy Bottom","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"animacja, familijny, przygodow","director":"Steve Cox, Matthew Walker","organizer":"","country":"UK","year":"2026","category":"Kino","categoryId":2,"omomoCategory":"1","duration":80,"image":"\/uploads\/event\/\/1789748734.jpg","artists":[]},"location":{"id":38,"name":"KINO","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Pszczyna","city_id":1587,"zip":"43-200","addresse":"ul. W. Jagie\u0142\u0142y 1"}},"5644":{"id":5644,"title":"BARANEK SHAUN I KUD\u0141ATA BESTIA ","url":"\/kup-bilet\/baranek-shaun-i-kudlata-bestia-2026-10-30-13-30-2","image":"\/uploads\/event\/\/1789748734.jpg","date":"2026-10-31T13:30:00+01:00","availableTickets":122,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-31 12:30:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-31 13:30:00"},"products":[{"id":1,"name":"BILET STANDARD","rawPrice":2299,"price":"22,99","allowSaleUsingPass":false