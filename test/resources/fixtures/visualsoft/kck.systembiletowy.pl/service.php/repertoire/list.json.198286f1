wSaleUsingPass":false,"available":305}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2356,"name":"KONCERT Z OKAZJI DNIA NIEPODLEG\u0141O\u015aCI ","description":"<span style=\"box-sizing: border-box; margin: 0px; border: medium none currentcolor; font-size: 14px; color: rgb(83, 90, 94); font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; background-color: rgb(255, 254, 238); line-height: 21px !important;\"><font style=\"box-sizing: border-box; margin: 0px; border: medium none currentcolor; font-size: 16px !important; color: rgb(0, 0, 0) !important; font-family: &quot;Titillium Web&quot;, sans-serif !important; line-height: 21px !important; background-color: unset !important;\">Na to wydarzenie nie wystawiamy Faktury VAT<\/font><\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"IMPREZY OBCE","categoryId":3,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788876136.jpeg","artists":[]},"location":{"id":22,"name":"Uk\u0142ad Koncert","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Kalisz","city_id":2143,"zip":"","addresse":""}},"11113":{"id":11113,"title":"Back to Amy Show - Pami\u0119ci Amy Winehouse ","url":"\/kup-bilet\/back-to-amy-show-pamieci-amy-winehouse-2026-12-05-19-00","image":"","date":"2026-12-05T19:00:00+01:00","availableTickets":53,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-12-05 19:05:00","startAt":"2026-06-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-12-05 19:00:00"},"products":[{"id":561,"name":"Bilet obcy.","rawPrice":11000,"price":"110,00","allowSaleUsingPass":false,"available":53}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":2307,"name":"Back to Amy Show - Pami\u0119ci Amy Winehouse ","description":"<span style=\"font-family: &quot;Titillium Web&quot;, sans-serif; font-size: 16px; background-color: rgb(246, 246, 246);\"><b>Na to wydarzenie nie wystawiamy Faktury VAT<\/b><\/span><div style=\"font-weight: normal;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif; font-size: 16px; background-color: rgb(246, 246, 246);\"><br><\/span><\/div><div style=\"font-weight: normal;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif; font-size: 16px; background-color: rgb(246, 246, 246);\"><br><\/span><\/div><div style=\"font-weight: normal;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif; font-size: 16px; background-color: rgb(246, 246, 246);\"><br><\/span><\/div><div style=\"font-weight: normal;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif; font-size: 16px; background-color: rgb(246, 246, 246);\"><br><\/span><\/div><div style=\"font-weight: normal;\"><p class=\"MsoNormal\"><b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">BACK TO AMY<\/span><\/b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\"> \u2014 wi\u0119cej ni\u017c tribute ! <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">To pe\u0142ne emocji muzyczne widowisko <b>w klimacie jazz &amp; soul, <\/b>inspirowane tw\u00f3rczo\u015bci\u0105 <b>AMY WINEHOUSE<\/b>. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">&nbsp; <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">15 lat<\/span><\/b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\"> od \u015bmierci Amy Winehouse. <b>20 lat<\/b> od premiery prze\u0142omowego albumu BACK TO BLACK. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">W\u0142a\u015bnie w tym symbolicznym momencie powsta\u0142 projekt, kt\u00f3ry wykracza daleko poza formu\u0142\u0119 klasycznego koncertu tribute. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">&nbsp; <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">BACK TO AMY <i>show<\/i><\/span><\/b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">\r\n to wyre\u017cyserowane, muzyczne widowisko, stworzone z mi\u0142o\u015bci do artystki,\r\n kt\u00f3ra na zawsze zmieni\u0142a wsp\u00f3\u0142czesn\u0105 muzyk\u0119. To starannie \r\nzaprojektowane do\u015bwiadczenie sceniczne, w kt\u00f3rym muzyka, obraz, \u015bwiat\u0142o i\r\n emocje tworz\u0105 jedn\u0105, hipnotyzuj\u0105c\u0105 ca\u0142o\u015b\u0107. Ten wiecz\u00f3r zaczyna si\u0119 \r\njeszcze przed pierwszym d\u017awi\u0119kiem wybrzmiewaj\u0105cym ze sceny. Ju\u017c od \r\nwej\u015bcia do foyer widzowie zanurz\u0105 si\u0119 w \u015bwiecie inspirowanym estetyk\u0105 \r\nsoulu, jazzowych klub\u00f3w i koncertowej energii lat 60. &nbsp;Pulsuj\u0105cy rytm, \r\nsubtelne muzyczne motywy i budowane stopniowo napi\u0119cie sprawi\u0105, \u017ce \r\ngranica mi\u0119dzy koncertem a teatralnym spektaklem zacznie si\u0119 poma\u0142u \r\nzaciera\u0107. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">&nbsp; <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">Na scenie wyst\u0105pi <a href=\"https:\/\/www.instagram.com\/sabinamachina\/\"><span style=\"color:blue\">SABINA KARWALA <\/span><\/a>\u2014\r\n aktorka i wokalistka, obdarzona niezwykle charakterystyczn\u0105, ciemn\u0105 \r\nbarw\u0105 g\u0142osu, uznawana za jedn\u0105 z najbardziej wyrazistych interpretatorek\r\n repertuaru Amy Winehouse w Polsce. <br>Artystka samodzielnie \r\nwyre\u017cyseruje widowisko, wykorzystuj\u0105c swoje do\u015bwiadczenie sceniczne, \r\nteatraln\u0105 wra\u017cliwo\u015b\u0107 i ogromn\u0105 dba\u0142o\u015b\u0107 o ka\u017cdy detal. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">&nbsp; <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">BACK TO AMY<\/span><\/b><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">\r\n zachwyca nie tylko wokalnie i muzycznie, ale r\u00f3wnie\u017c wizualnie. \r\nCharakterystyczny neon BACK TO AMY, czerwone dywany buduj\u0105ce intymn\u0105 \r\nprzestrze\u0144 dla muzyk\u00f3w, autorski kostium sceniczny, \u015bwiat\u0142o, narracja \r\noraz starannie stopniowane emocje sprawiaj\u0105, \u017ce koncert staje si\u0119 \r\npe\u0142nowymiarowym do\u015bwiadczeniem scenicznym. Muzycznie projekt si\u0119ga \r\nznacznie g\u0142\u0119biej ni\u017c sam repertuar Winehouse. Obok jej najwi\u0119kszych \r\nutwor\u00f3w us\u0142yszymy tak\u017ce inspiracje artystami, kt\u00f3rych Amy kocha\u0142a i \r\npodziwia\u0142a oraz tymi, na kt\u00f3rych sama wywar\u0142a ogromny wp\u0142yw \u2014 od ARETHY \r\nFRANKLIN i ELLI FITZGERALD po wsp\u00f3\u0142czesn\u0105 RAYE. Ca\u0142o\u015b\u0107 dope\u0142niaj\u0105 \r\nspecjalnie przygotowane aran\u017cacje wybitnego pianisty, kompozytora i \r\naran\u017cera <a href=\"https:\/\/www.facebook.com\/adam.jarzmik\"><span style=\"color:blue\">ADAMA JARZMIKA<\/span><\/a>. <br><br><i>\u201eProjekt <b>BACK TO AMY<\/b>\r\n jest spe\u0142nieniem marzenia, kt\u00f3re zrodzi\u0142o si\u0119 we mnie i Magdzie (1\/2 \r\nOperafixe) wiele lat temu. Gdyby nie Amy Winehouse, prawdopodobnie nigdy\r\n nie zacz\u0119\u0142abym \u015bpiewa\u0107, dlatego ogromnie si\u0119 ciesz\u0119, \u017ce mog\u0119 w taki \r\nspos\u00f3b odda\u0107 jej ho\u0142d. Zrobimy wszystko, by tw\u00f3rczo\u015b\u0107 Amy wybrzmia\u0142a jak\r\n najpi\u0119kniej!\u201d<\/i> \u2014 m\u00f3wi Sabina Karwala. <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">&nbsp; <o:p><\/o:p><\/span><\/p><p class=\"MsoNormal\"><i><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\">\u201eTo\r\n nie b\u0119dzie zwyk\u0142y koncert. To b\u0119dzie wiecz\u00f3r pe\u0142en emocji, nostalgii, \r\nelegancji i muzyki, kt\u00f3ra do dzi\u015b porusza miliony ludzi na ca\u0142ym \r\n\u015bwiecie!\u201d<\/span><\/i><span style=\"font-size:12.0pt;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-language:PL\"> - m\u00f3wi Magdalena Marek \/ operafixe&nbsp;<\/span><\/p><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"IMPREZY OBCE","categoryId":3,"omomoCategory":"1","duration":0,"image":"","artists":[]},"location":{"id":22,"name":"Uk\u0142ad Koncert","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Kalisz","city_id":2143,"zip":"","addresse":""}}},"passes":[]}