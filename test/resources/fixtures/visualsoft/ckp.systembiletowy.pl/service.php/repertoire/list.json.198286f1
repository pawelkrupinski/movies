vent\/\/1788524095.jpg","date":"2026-10-04T12:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-04 11:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-04 12:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1623,"name":"Zapomniana wyspa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524095.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12471":{"id":12471,"title":"Zapomniana wyspa ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-04-14-00","image":"\/uploads\/event\/\/1788524095.jpg","date":"2026-10-04T14:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-04 13:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-04 14:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1623,"name":"Zapomniana wyspa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524095.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12490":{"id":12490,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-04-16-00","image":"\/uploads\/event\/\/1788524368.jpg","date":"2026-10-04T16:00:00+02:00","availableTickets":290,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-04 15:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-04 16:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":290}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1624,"name":"Lalka ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci