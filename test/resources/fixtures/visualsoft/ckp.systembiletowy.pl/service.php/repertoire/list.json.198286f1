tartAt":"2026-08-05 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-09-26 14:00:00"},"products":[{"id":20,"name":"Bilet 14z\u0142","rawPrice":1400,"price":"14,00","allowSaleUsingPass":false,"available":265}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1620,"name":"Pucio kocha zwierzaki ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">U Pucia jak zwykle du\u017co si\u0119 dzieje. Sp\u0119dza wakacje u dziadk\u00f3w na wsi i sadzi swoje pierwsze drzewo, a podczas spaceru w parku rusza z Misi\u0105 na misj\u0119 ratunkow\u0105, by odnale\u017a\u0107 psa s\u0105siada. Kiedy ich w\u0142asny, ukochany Funio gorzej si\u0119 czuje, rodze\u0144stwo robi, co w ich mocy, by poprawi\u0107 mu humor. Wygl\u0105da jednak na to, \u017ce czas odwiedzi\u0107 weterynarza! Emocji nie zabraknie r\u00f3wnie\u017c w przedszkolu: Pucio pomo\u017ce nowej kole\u017cance Malinie odnale\u017a\u0107 si\u0119 w grupie i razem z kolegami odkryje, \u017ce nie trzeba ta\u0144czy\u0107 idealnie \u2013 liczy si\u0119 wyobra\u017ania i rado\u015b\u0107 z bycia razem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1785936388.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12415":{"id":12415,"title":"Pucio kocha zwierzaki ","url":"\/kup-bilet\/pucio-kocha-zwierzaki-2026-09-26-15-00","image":"\/uploads\/event\/\/1785936388.jpg","date":"2026-09-26T15:00:00+02:00","availableTickets":281,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"20