era granice mi\u0119dzy sercem a rozumem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524368.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12528":{"id":12528,"title":"Czas, kt\u00f3ry nie nadszed\u0142 ","url":"\/kup-bilet\/czas-ktory-nie-nadszedl-2026-10-28-20-00","image":"\/uploads\/event\/\/1788525044.jpg","date":"2026-10-28T20:00:00+01:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-28 19:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-28 20:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1626,"name":"Czas, kt\u00f3ry nie nadszed\u0142 ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">W \u015bwiecie, w kt\u00f3rym starzenie si\u0119 sta\u0142o si\u0119 najwi\u0119kszym tabu, Sara i Oskar planowali zestarze\u0107 si\u0119 razem. On jednak \u2013 jak wi\u0119kszo\u015b\u0107 \u2013 podda\u0142 si\u0119 rewolucyjnej kuracji antygeriatrycznej, zapewniaj\u0105cej m\u0142odo\u015b\u0107 i miejsce w nowym spo\u0142ecze\u0144stwie. Ona odm\u00f3wi\u0142a, skazuj\u0105c si\u0119 na \u017cycie w zamkni\u0119tym o\u015brodku izolacji. Po latach pr\u00f3ba ucieczki Sary sprawia, \u017ce ponownie si\u0119 spotykaj\u0105. Dzieli ich wygl\u0105d, \u0142\u0105czy brak odpowiedzi na pytania spychane przez lata na drugi plan. Czy uczucia mog\u0105 przetrwa\u0107 czas i nieodwracalne decyzje? Czy mo\u017cna by\u0107 wolnym i \u017cy\u0107 prawdziwie w \u015bwiecie, kt\u00f3ry odmawia prawa do przemijania?<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788525044.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12521":{"id":12521,"title":"Tedi i magiczna lampa ","url":"\/kup-bilet\/tedi-i-magiczna-lampa-2026-10-29-15-00","image":"\/uploads\/event\/\/1788524807.jpg","date":"2026-10-29T15:00:00+01:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-29 14:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-29 15:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1625,"name":"Tedi i magiczna lampa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Oli, nieustraszona dwuletnia c\u00f3rka Tadeo, sprawi\u0142a, \u017ce sta\u0142 si\u0119 on nadopieku\u0144czym ojcem, a urocza Mumia czuje si\u0119 odsuni\u0119ta na bok. Kiedy w Pa\u0142acu Buckingham znajduj\u0105 magiczn\u0105 lamp\u0119, Mumia prosi j\u0105 o przeniesienie w czasie do Paititi w Peru w 1502 roku. Tad, Sara i ca\u0142a ekipa b\u0119d\u0105 musieli pod\u0105\u017cy\u0107 za Mumi\u0105 w przesz\u0142o\u015b\u0107, zanim co\u015b zmieni bieg historii... Podr\u00f3\u017c zabierze ich przez Ocean Atlantycki z Peru do Grecji, a stamt\u0105d w g\u0142\u0105b Bliskiego Wschodu, a\u017c do jaskini Ali Baby i czterdziestu rozb\u00f3jnik\u00f3w.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524807.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12513":{"id":12513,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-29-17-00","image":"\/uploads\/event\/\/1788524368.jpg","date":"2026-10-29T17:00:00+01:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-29 16:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-29 17:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1624,"name":"Lalka ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kamila Urz\u0119dowska<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marek+Kondrat-253\" title=\"Marek Kondrat\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marek Kondrat<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524368.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12529":{"id":12529,"title":"Czas, kt\u00f3ry nie nadszed\u0142 ","url":"\/kup-bilet\/czas-ktory-nie-nadszedl-2026-10-29-20-00","image":"\/uploads\/event\/\/1788525044.jpg","date":"2026-10-29T20:00:00+01:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-29 19:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-29 20:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1626,"name":"Czas, kt\u00f3ry nie nadszed\u0142 ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">W \u015bwiecie, w kt\u00f3rym starzenie si\u0119 sta\u0142o si\u0119 najwi\u0119kszym tabu, Sara i Oskar planowali zestarze\u0107 si\u0119 razem. On jednak \u2013 jak wi\u0119kszo\u015b\u0107 \u2013 podda\u0142 si\u0119 rewolucyjnej kuracji antygeriatrycznej, zapewniaj\u0105cej m\u0142odo\u015b\u0107 i miejsce w nowym spo\u0142ecze\u0144stwie. Ona odm\u00f3wi\u0142a, skazuj\u0105c si\u0119 na \u017cycie w zamkni\u0119tym o\u015brodku izolacji. Po latach pr\u00f3ba ucieczki Sary sprawia, \u017ce ponownie si\u0119 spotykaj\u0105. Dzieli ich wygl\u0105d, \u0142\u0105czy brak odpowiedzi na pytania spychane przez lata na drugi plan. Czy uczucia mog\u0105 przetrwa\u0107 czas i nieodwracalne decyzje? Czy mo\u017cna by\u0107 wolnym i \u017cy\u0107 prawdziwie w \u015bwiecie, kt\u00f3ry odmawia prawa do przemijania?<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788525044.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}}},"passes":[]}