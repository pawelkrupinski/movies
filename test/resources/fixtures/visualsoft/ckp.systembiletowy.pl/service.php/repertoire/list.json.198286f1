144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12421":{"id":12421,"title":"Pucio kocha zwierzaki ","url":"\/kup-bilet\/pucio-kocha-zwierzaki-2026-10-01-15-00","image":"\/uploads\/event\/\/1785936388.jpg","date":"2026-10-01T15:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-01 14:00:00","startAt":"2026-08-05 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-01 15:00:00"},"products":[{"id":20,"name":"Bilet 14z\u0142","rawPrice":1400,"price":"14,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1620,"name":"Pucio kocha zwierzaki ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">U Pucia jak zwykle du\u017co si\u0119 dzieje. Sp\u0119dza wakacje u dziadk\u00f3w na wsi i sadzi swoje pierwsze drzewo, a podczas spaceru w parku rusza z Misi\u0105 na misj\u0119 ratunkow\u0105, by odnale\u017a\u0107 psa s\u0105siada. Kiedy ich w\u0142asny, ukochany Funio gorzej si\u0119 czuje, rodze\u0144stwo robi, co w ich mocy, by poprawi\u0107 mu humor. Wygl\u0105da jednak na to, \u017ce czas odwiedzi\u0107 weterynarza! Emocji nie zabraknie r\u00f3wnie\u017c w przedszkolu: Pucio pomo\u017ce nowej kole\u017cance Malinie odnale\u017a\u0107 si\u0119 w grupie i razem z kolegami odkryje, \u017ce nie trzeba ta\u0144czy\u0107 idealnie \u2013 liczy si\u0119 wyobra\u017ania i rado\u015b\u0107 z bycia razem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1785936388.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12426":{"id":12426,"title":"Ksi\u0119ga pustyni ","url":"\/kup-bilet\/ksiega-pustyni-2026-10-01-16-00","image":"\/uploads\/event\/\/1785936596.jpg","date":"2026-10-01T16:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-01 15:00:00","startAt":"2026-08-05 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-01 16:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1621,"name":"Ksi\u0119ga pustyni ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Czternastoletnia Sun wyrusza na Sahar\u0119, by rozwik\u0142a\u0107 sekret starej legendy opowiadanej przez dziadka. Na miejscu poznaje prawdziwe losy ch\u0142opca, kt\u00f3ry w wieku dw\u00f3ch lat zagin\u0105\u0142 podczas pot\u0119\u017cnej burzy piaskowej. Pozostawiony na pastw\u0119 pustyni, zostaje cudownie ocalony przez stado strusi. Sp\u0119dza z nimi nast\u0119pne dziesi\u0119\u0107 lat, ucz\u0105c si\u0119 jak przetrwa\u0107 i dorastaj\u0105c z dala od ludzi. Jego najlepszym przyjacielem i towarzyszem zabaw jest fenek - wielkouchy pustynny lisek. Ch\u0142opiec uczy si\u0119 komunikowa\u0107 ze zwierz\u0119tami, a dzika natura staje si\u0119 jego domem. To opowie\u015b\u0107 o niezwyk\u0142ej wi\u0119zi, kt\u00f3ra potrafi narodzi\u0107 si\u0119 nawet w najbardziej nieoczekiwanych miejscach.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1785936596.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12431":{"id":12431,"title":"Niebo nad Normandi\u0105 ","url":"\/kup-bilet\/niebo-nad-normandia-2026-10-01-18-00","image":"\/uploads\/event\/\/1785936754.jpg","date":"2026-10-01T18:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-01 17:00:00","startAt":"2026-08-05 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-01 18:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1622,"name":"Niebo nad Normandi\u0105 ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">72 godziny przed l\u0105dowaniem w Normandii, losy \u015bwiata maj\u0105 zale\u017ce\u0107 od... pogody. Wojna to nie tylko bitwy, to w szczeg\u00f3lno\u015bci strategie i decyzje, kt\u00f3rych skutki odczu\u0107 mog\u0105 miliony. Pracuj\u0105cy dla brytyjskiej armii meteorolog <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/James+Stagg-2869814\" title=\"James Stagg\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">James Stagg<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Andrew+Scott-61258\" title=\"Andrew Scott\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Andrew Scott<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) musi podj\u0105\u0107 najwa\u017cniejsz\u0105 decyzj\u0119 w swojej karierze \u2013 prognoza, kt\u00f3r\u0105 przedstawi, mo\u017ce przes\u0105dzi\u0107 o sukcesie lub kl\u0119sce najwi\u0119kszej operacji wojskowej w historii. Zamkni\u0119ty w atmosferze nieufno\u015bci i presji ze strony najwy\u017cszych dow\u00f3dc\u00f3w, Stagg toczy psychologiczn\u0105 walk\u0119 z czasem, wspierany jedynie przez kapitan <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kay+Summersby-393342\" title=\"Kay Summersby\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kay Summersby<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kerry+Condon-136125\" title=\"Kerry Condon\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kerry Condon<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). Nad wszystkim czuwa genera\u0142 <\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Dwight+D.+Eisenhower-210712\" title=\"Dwight D. Eisenhower\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Dwight D. Eisenhower<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\"> (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Brendan+Fraser-5137\" title=\"Brendan Fraser\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Brendan Fraser<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), kt\u00f3ry musi zdecydowa\u0107 czy ruszy\u0107 z inwazj\u0105, czy j\u0105 op\u00f3\u017ani\u0107 \u2013 ryzykuj\u0105c, \u017ce Niemcy odkryj\u0105 plany aliant\u00f3w.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1785936754.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12411":{"id":12411,"title":"Resident Evil ","url":"\/kup-bilet\/resident-evil-2026-10-01-20-15","image":"\/uploads\/event\/\/1785936212.png","date":"2026-10-01T20:15:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-01 19:15:00","startAt":"2026-08-05 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-01 20:15:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1619,"name":"Resident Evil ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Awaria laboratorium Umbrelli powoduje niekontrolowane uwolnienie wirusa. Mieszka\u0144cy Raccoon przemieniaj\u0105 si\u0119 w bezlitosne, krwio\u017cercze istoty. Bryan, przypadkowy \u015bwiadek katastrofy, zostaje uwi\u0119ziony po\u015br\u00f3d chaosu miasta.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1785936212.png","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12467":{"id":12467,"title":"Zapomniana wyspa ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-02-14-00","image":"\/uploads\/event\/\/1788524095.jpg","date":"2026-10-02T14:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 13:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 14:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1623,"name":"Zapomniana wyspa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524095.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12486":{"id":12486,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-02-16-00","image":"\/uploads\/event\/\/1788524368.jpg","date":"2026-10-02T16:00:00+02:00","availableTickets":277,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 15:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 16:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":277}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1624,"name":"Lalka ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kamila Urz\u0119dowska<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marek+Kondrat-253\" title=\"Marek Kondrat\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marek Kondrat<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524368.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12487":{"id":12487,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-02-19-00","image":"\/uploads\/event\/\/1788524368.jpg","date":"2026-10-02T19:00:00+02:00","availableTickets":282,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 18:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 19:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":282}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1624,"name":"Lalka ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Kamila Urz\u0119dowska<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marek+Kondrat-253\" title=\"Marek Kondrat\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marek Kondrat<\/a><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524368.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12577":{"id":12577,"title":"DISCO MCK ","url":"\/kup-bilet\/disco-mck-2026-10-02-19-00","image":"\/uploads\/event\/1631\/1789561297.jpg","date":"2026-10-02T19:00:00+02:00","availableTickets":31,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 18:00:00","startAt":"2026-09-16 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 19:00:00"},"products":[{"id":43,"name":"Bilet 30z\u0142","rawPrice":3000,"price":"30,00","allowSaleUsingPass":false,"available":31}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1631,"name":"DISCO MCK ","description":"<p class=\"MsoNormal\" style=\"margin: 0px; color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; background-color: rgb(255, 255, 255);\">Muzyczny wiecz\u00f3r w rytmach disco w Miejskim Centrum Kultury w P\u0142o\u0144sku. W programie znajd\u0105 si\u0119 najwi\u0119ksze przeboje lat 70., 80. i 90., taneczna muzyka oraz atmosfera nawi\u0105zuj\u0105ca do z\u0142otej ery dyskotek.&nbsp;<\/p><p class=\"MsoNormal\" style=\"margin: 0px; color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; background-color: rgb(255, 255, 255);\">Wydarzenie skierowane jest do wszystkich mi\u0142o\u015bnik\u00f3w muzyki tanecznej i dobrej zabawy. Szczeg\u00f3\u0142owe informacje dost\u0119pne s\u0105 na profilu MCK P\u0142o\u0144sk na Facebooku.<\/p>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/1631\/1789561297.jpg","artists":[]},"location":{"id":7,"name":"DISCO","institution_name":"Disco","location_description":"Sala dyskotekowa","location_type":2,"location_type_name":"otwarte","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"P\u0142ocka 50"}},"12468":{"id":12468,"title":"Zapomniana wyspa ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-03-12-00","image":"\/uploads\/event\/\/1788524095.jpg","date":"2026-10-03T12:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-03 11:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-03 12:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1623,"name":"Zapomniana wyspa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524095.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12469":{"id":12469,"title":"Zapomniana wyspa ","url":"\/kup-bilet\/zapomniana-wyspa-2026-10-03-14-00","image":"\/uploads\/event\/\/1788524095.jpg","date":"2026-10-03T14:00:00+02:00","availableTickets":292,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-03 13:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-03 14:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":292}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1623,"name":"Zapomniana wyspa ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Podczas \u015bwi\u0119towania ostatniej wsp\u00f3lnej nocy, Jo i Raissa natrafiaj\u0105 na tajemniczy portal, kt\u00f3ry przenosi je na fantastyczn\u0105 wysp\u0119 Nakali, pe\u0142n\u0105 magicznych i mitycznych stworze\u0144, o kt\u00f3rych s\u0142ucha\u0142y w opowie\u015bciach swoich filipi\u0144skich rodzin.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Niekt\u00f3re z tych postaci stan\u0105 si\u0119 przyjaci\u00f3\u0142mi, inne wrogami. Jo i Raissa musz\u0105 stawi\u0107 czo\u0142a najgro\u017aniejszemu stworzeniu na wyspie.&nbsp;<\/span><span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Kiedy odkryj\u0105, \u017ce wspomnienia ca\u0142ej ich przyja\u017ani s\u0105 cen\u0105 za powr\u00f3t do domu, Jo i Raissa b\u0119d\u0105 \u015bciga\u0107 si\u0119, by znale\u017a\u0107 spos\u00f3b na opuszczenie wyspy, zanim zapomn\u0105 o sobie na zawsze.<\/span>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1788524095.jpg","artists":[]},"location":{"id":5,"name":"Sala widowiskowo-kinowa","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"P\u0142o\u0144sk","city_id":350,"zip":"09-100","addresse":"ul. P\u0142ocka 50"}},"12488":{"id":12488,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-03-16-00","image":"\/uploads\/event\/\/1788524368.jpg","date":"2026-10-03T16:00:00+02:00","availableTickets":283,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-03 15:00:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-03 16:00:00"},"products":[{"id":70,"name":"Bilet","rawPrice":2000,"price":"20,00","allowSaleUsingPass":false,"available":283}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":1624,"name":"Lalka ","description":"<span style=\"color: rgb(36, 36, 36); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px; background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94); font-family: Lato, &quot;Noto Sans Symbols&quot;, sans-serif; font-size: 16px;\">Marcin Doroci\u0144ski<\/a><span style=\"