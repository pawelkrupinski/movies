"Arial\" style=\"\" size=\"2\"><br><\/font><\/span><\/div><div style=\"\"><span style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal; color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Zwiastun:&nbsp;<\/font><\/span><font color=\"#242424\" face=\"Arial\" size=\"2\">https:\/\/www.youtube.com\/watch?v=yYzIsz2qcwA<\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026D2D3506","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"1","duration":88,"image":"\/uploads\/event\/\/1788089528.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"966":{"id":966,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-02-17-30","image":"\/uploads\/event\/\/1788440681.jpg","date":"2026-10-02T17:30:00+02:00","availableTickets":10,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 17:20:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 17:30:00"},"products":[{"id":21,"name":"Bilet normalny","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":10}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":280,"name":"Lalka ","description":"<font face=\"Arial\" style=\"font-family: Arial, Verdana; font-size: 10pt;\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);\">&nbsp;<\/a>Doroci\u0144ski<span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);\">&nbsp;<\/a>Urz\u0119dowska<span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Konrad<\/span><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span><\/font><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><br><\/span><\/font><\/div><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">Czas trwania: 146 minut<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Produkcja: Polska<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Gatunek: Dramat<\/span><\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4432","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"3","duration":146,"image":"\/uploads\/event\/\/1788440681.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"967":{"id":967,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-02-20-20","image":"\/uploads\/event\/\/1788440681.jpg","date":"2026-10-02T20:20:00+02:00","availableTickets":21,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-02 20:10:00","startAt":"2026-09-03 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-02 20:20:00"},"products":[{"id":21,"name":"Bilet normalny","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":21}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":280,"name":"Lalka ","description":"<font face=\"Arial\" style=\"font-family: Arial, Verdana; font-size: 10pt;\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Marcin+Doroci%C5%84ski-42489\" title=\"Marcin Doroci\u0144ski\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);\">&nbsp;<\/a>Doroci\u0144ski<span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila<\/span><a class=\"internal\" href=\"https:\/\/www.filmweb.pl\/person\/Kamila+Urz%C4%99dowska-2638609\" title=\"Kamila Urz\u0119dowska\" style=\"box-sizing: inherit; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); margin: 0px; padding: 0px; margin-block: 0px; margin-inline: 0px; padding-inline-start: 0px; background-color: rgb(255, 255, 255); outline: none; color: rgb(151, 97, 3); text-decoration: none; cursor: pointer; transition: color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);\">&nbsp;<\/a>Urz\u0119dowska<span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Konrad<\/span><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/span><\/font><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><br><\/span><\/font><\/div><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">Czas trwania: 146 minut<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Produkcja: Polska<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Gatunek: Dramat<\/span><\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4432","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"3","duration":146,"image":"\/uploads\/event\/\/1788440681.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"959":{"id":959,"title":"Psi Patrol i dinozaury 2D Dubbing PL ","url":"\/kup-bilet\/psi-patrol-i-dinozaury-2d-dubbing-pl-2026-10-03-13-30","image":"\/uploads\/event\/\/1788089528.jpg","date":"2026-10-03T13:30:00+02:00","availableTickets":37,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-03 13:20:00","startAt":"2026-08-30 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-03 13:30:00"},"products":[{"id":21,"name":"Bilet normalny","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":37}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":278,"name":"Psi Patrol i dinozaury 2D Dubbing PL ","description":"<span style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal; color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Podczas tajemniczej burzy statek Psiego Patrolu rozbija si\u0119 na pe\u0142nej dinozaur\u00f3w tropikalnej wyspie. Bohaterowie spotykaj\u0105 tam Reksa, szczeniaka, kt\u00f3ry utkn\u0105\u0142 w tym miejscu przed laty i sta\u0142 si\u0119 ekspertem w sprawach dinozaur\u00f3w. Kiedy Humdinger, g\u0142\u00f3wny rywal Psiego Patrolu, zaczyna lekkomy\u015blnie eksploatowa\u0107 zasoby naturalne wyspy, doprowadza do wybuchu ogromnego, u\u015bpionego od lat wulkanu. Psi Patrol podejmuje si\u0119 najwi\u0119kszej akcji ratunkowej w swojej historii. Szczeniaczki musz\u0105 powstrzyma\u0107 Humdingera, zanim doprowadzi do zag\u0142ady ca\u0142ego \u017cycia na wyspie.<\/font><\/span><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\"><br><\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Czas trwania: 88 minut<\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Produkcja: Kanada, USA<\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Gatunek: Animowany, przygodowy<\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\"><br><\/font><\/span><\/div><div style=\"\"><span style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal; color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Zwiastun:&nbsp;<\/font><\/span><font color=\"#242424\" face=\"Arial\" size=\"2\">https:\/\/www.youtube.com\/watch?v=yYzIsz2qcwA<\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026D2D3506","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"1","duration":88,"image":"\/uploads\/event\/\/1788089528.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"968":{"id":968,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-03-15-30","image":"\/uploads\/event\/\/1788440681.jpg","date":"2026-10-03T15:30:00+02:00","availableTickets":26,"additionalInfo":"","info":{"sale