nt-weight: normal;\"><span style=\"font-family: Arial; font-size: small; background-color: rgb(255, 255, 255); color: rgb(36, 36, 36);\">Czas trwania: 97 min.<\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Produkcja: Australia, USA<\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Gatunek: Komedia<\/font><\/span><\/div><div style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal;\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\"><br><\/font><\/span><\/div><div style=\"\"><span style=\"font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal; color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><font face=\"Arial\" style=\"\" size=\"2\">Zwiastun:&nbsp;<\/font><\/span><font color=\"#242424\" face=\"Arial\" size=\"2\">https:\/\/www.youtube.com\/watch?v=9a6wRnfx2mA<\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026T2D4302","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"1","duration":97,"image":"\/uploads\/event\/\/1789741667.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"969":{"id":969,"title":"Lalka ","url":"\/kup-bilet\/lalka-2026-10-03-20-10","image":"\/uploads\/event\/\/178