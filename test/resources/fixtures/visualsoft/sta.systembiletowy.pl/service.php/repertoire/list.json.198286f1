ce mi\u0119dzy sercem a rozumem.<\/span><\/font><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\"><br><\/span><\/font><\/div><div style=\"font-family: Arial, Verdana; font-size: 10pt;\"><font face=\"Arial\" style=\"\" size=\"2\"><span style=\"color: rgb(36, 36, 36); background-color: rgb(255, 255, 255);\">Czas trwania: 146 minut<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Produkcja: Polska<\/span><\/font><\/div><div style=\"\"><font color=\"#242424\" face=\"Arial\" size=\"2\"><span style=\"background-color: rgb(255, 255, 255);\">Gatunek: Dramat<\/span><\/font><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"2026O2D4432","movieType":"","director":"","organizer":"","country":"","year":"","category":"KINO KADR","categoryId":1,"omomoCategory":"3","duration":146,"image":"\/uploads\/event\/\/1788440681.jpg","artists":[]},"location":{"id":11,"name":"KINO KADR (Ratusz ul. Rynek 1)","institution_name":"","location_description":"","location_type":1,"location_type_name":"sala","city":"Stasz\u00f3w","city_id":1862,"zip":"28-200","addresse":"Rynek 1"}},"987":{"id":987,"title":"The Social Reckoning: W sieci konsekwencji ","url":"\/kup-bilet\/the-social-reckoning-w-sieci-konsekwencji-2026-10-09-17-50","image":"\/uploads\/event\/\/1789742579.jpg","date":"2026-10-09T17:50:00+02:00","availableTickets":37,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-09 17:40:00","startAt":"2026-09-18 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-09 17:50:00"},"products":[{"id":21,"name":"Bilet normalny","rawPrice":2200,"price":"22,00","allowSaleUsingPass":false,"available":37}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":286,"name":"The Social Reckoning: W sieci konsekwencji ","descri