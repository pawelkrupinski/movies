-100","addresse":"Konstytucji 3-go Maja 16"}},"6021":{"id":6021,"title":"Supermocni ","url":"\/kup-bilet\/supermocni-2026-10-23-11-00","image":"\/uploads\/event\/\/1789149741.jpg","date":"2026-10-23T11:00:00+02:00","availableTickets":175,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 11:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 11:00:00"},"products":[{"id":308,"name":"Kanapa","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":11},{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":164}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":441,"name":"Supermocni ","description":"Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej dziwnej mutacji. Ale to nie jedyny problem. Ot\u00f3\u017c pewien \u017c\u0105dny w\u0142adzy naukowiec chce za pomoc\u0105 owej kosmicznej substancji przej\u0105\u0107 panowanie nad \u015bwiatem. Je\u015bli wpadnie ona w jego \u0142apy, na ratunek b\u0119dzie za p\u00f3\u017ano. Zo\u015bka i jej zwierzaki musz\u0105 zapanowa\u0107 nad swoimi super mocami i wykorzysta\u0107 je do ratowania planety","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789149741.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6022":{"id":6022,"title":"Supermocni ","url":"\/kup-bilet\/supermocni-2026-10-23-11-00-1","image":"\/uploads\/event\/\/1789149741.jpg","date":"2026-10-23T14:00:00+02:00","availableTickets":175,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 14:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 14:00:00"},"products":[{"id":308,"name":"Kanapa","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":11},{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":164}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":441,"name":"Supermocni ","description":"Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej dziwnej mutacji. Ale to nie jedyny problem. Ot\u00f3\u017c pewien \u017c\u0105dny w\u0142adzy naukowiec chce za pomoc\u0105 owej kosmicznej substancji przej\u0105\u0107 panowanie nad \u015bwiatem. Je\u015bli wpadnie ona w jego \u0142apy, na ratunek b\u0119dzie za p\u00f3\u017ano. Zo\u015bka i jej zwierzaki musz\u0105 zapanowa\u0107 nad swoimi super mocami i wykorzysta\u0107 je do ratowania planety","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789149741.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6035":{"id":6035,"title":"Jak \u017cy\u0107 \u017ceby nie zwariowa\u0107 ","url":"\/kup-bilet\/jak-zyc-zeby-nie-zwariowac-2026-10-23-17-00","image":"\/uploads\/event\/\/1789150226.jpg","date":"2026-10-23T17:00:00+02:00","availableTickets":175,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 17:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 17:00:00"},"products":[{"id":308,"name":"Kanapa","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":11},{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":164}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":442,"name":"Jak \u017cy\u0107 \u017ceby nie zwariowa\u0107 ","description":"Anka to ma fajne \u017cycie. Kochaj\u0105cy m\u0105\u017c, udane dzieci, dobra praca i \u015bwietne mieszkanie w centrum. Co mo\u017ce p\u00f3j\u015b\u0107 nie tak? Na przyk\u0142ad\u2026 wszystko. M\u0105\u017c zdradza, praca odchodzi, dzieci maj\u0105 humory, a mieszkaniem interesuje si\u0119 komornik. Przed Ank\u0105 zaskakuj\u0105co prosty wyb\u00f3r: albo po\u0142o\u017cy si\u0119 i umrze z rozpaczy albo zacznie wreszcie \u017cy\u0107! Na w\u0142asnych warunkach, wed\u0142ug swojego widzimisi\u0119 i na pe\u0142nej petardzie. W dobie recyclingu atrakcyjna panna z odzysku ma wielk\u0105 przysz\u0142o\u015b\u0107. Wystarczy, \u017ce si\u0119 troch\u0119 ogarnie, op\u0119dzi od nadopieku\u0144czej matki, dogada z dzie\u0107mi i znajdzie nowy pomys\u0142 na siebie. A uwierzcie, \u017ce pomys\u0142\u00f3w akurat Ance nie brakuje! Gar\u015b\u0107 odwagi, mn\u00f3stwo wiary w siebie, szczypta niezale\u017cno\u015bci i ocean poczucia humoru \u2013 to jest przepis na now\u0105 Ank\u0119","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789150226.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6042":{"id":6042,"title":"THE SOCIAL RECKONING: WSIECI KONSEKWENCJI ","url":"\/kup-bilet\/the-social-reckoning-wsieci-konsekwencji-2026-10-23-19-00","image":"\/uploads\/event\/\/1789150560.jpg","date":"2026-10-23T19:00:00+02:00","availableTickets":124,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-23 19:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-23 19:00:00"},"products":[{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":124}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":443,"name":"THE SOCIAL RECKONING: WSIECI KONSEKWENCJI ","description":"<p style=\"box-sizing: border-box; margin: 0px; color: rgb(51, 51, 51); font-family: Lat