","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789149741.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6037":{"id":6037,"title":"Jak \u017cy\u0107 \u017ceby nie zwariowa\u0107 ","url":"\/kup-bilet\/jak-zyc-zeby-nie-zwariowac-2026-10-23-17-00-2","image":"\/uploads\/event\/\/1789150226.jpg","date":"2026-10-25T17:00:00+01:00","availableTickets":175,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-25 17:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-25 17:00:00"},"products":[{"id":308,"name":"Kanapa","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":11},{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":164}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":442,"name":"Jak \u017cy\u0107 \u017ceby nie zwariowa\u0107 ","description":"Anka to ma fajne \u017cycie. Kochaj\u0105cy m\u0105\u017c, udane dzieci, dobra praca i \u015bwietne mieszkanie w centrum. Co mo\u017ce p\u00f3j\u015b\u0107 nie tak? Na przyk\u0142ad\u2026 wszystko. M\u0105\u017c zdradza, praca odchodzi, dzieci maj\u0105 humory, a mieszkaniem interesuje si\u0119 komornik. Przed Ank\u0105 zaskakuj\u0105co prosty wyb\u00f3r: albo po\u0142o\u017cy si\u0119 i umrze z rozpaczy albo zacznie wreszcie \u017cy\u0107! Na w\u0142asnych warunkach, wed\u0142ug swojego widzimisi\u0119 i na pe\u0142nej petardzie. W dobie recyclingu atrakcyjna panna z odzysku ma wielk\u0105 przysz\u0142o\u015b\u0107. Wystarczy, \u017ce si\u0119 troch\u0119 ogarnie, op\u0119dzi od nadopieku\u0144czej matki, dogada z dzie\u0107mi i znajdzie nowy pomys\u0142 na siebie. A uwierzcie, \u017ce pomys\u0142\u00f3w akurat Ance nie brakuje! Gar\u015b\u0107 odwagi, mn\u00f3stwo wiary w siebie, szczypta niezale\u017cno\u015bci i ocean poczucia humoru \u2013 to jest przepis na now\u0105 Ank\u0119","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789150226.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6044":{"id":6044,"title":"THE SOCIAL RECKONING: WSIECI KONSEKWENCJI ","url":"\/kup-bilet\/the-social-reckoning-wsieci-konsekwencji-2026-10-23-19-00-2","image":"\/uploads\/event\/\/1789150560.jpg","date":"2026-10-25T19:00:00+01:00","availableTickets":124,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-25 19:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-25 19:00:00"},"products":[{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":124}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":443,"name":"THE SOCIAL RECKONING: WSIECI KONSEKWENCJI ","description":"<p style=\"box-sizing: border-box; margin: 0px; color: rgb(51, 51, 51); font-family: Lato, sans-serif; font-size: 17px; background-color: rgb(255, 255, 255); text-align: justify;\"><span style=\"box-sizing: border-box; font-size: 14px;\"><span style=\"box-sizing: border-box; font-family: verdana, geneva, sans-serif;\">W nowym filmie zobaczymy nominowanego do Oscara Jeremy\u2019ego Stronga, kt\u00f3ry wcieli si\u0119 w rol\u0119 Marka Zuckerberga; lauretk\u0119 Oscara, Mikey Madison, kt\u00f3ra wcieli si\u0119 w rol\u0119 Frances Haugen; oraz laurea