tional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"","categoryId":null,"omomoCategory":"1","duration":0,"image":"\/uploads\/event\/\/1789149741.jpg","artists":[]},"location":{"id":4,"name":"Kino kawiarnia Goleni\u00f3w","institution_name":"","location_description":"arabskie oznaczenia rz\u0119d\u00f3w","location_type":1,"location_type_name":"sala","city":"Goleni\u00f3w","city_id":715,"zip":"72-100","addresse":"Konstytucji 3-go Maja 16"}},"6030":{"id":6030,"title":"Supermocni ","url":"\/kup-bilet\/supermocni-2026-10-23-11-00-9","image":"\/uploads\/event\/\/1789149741.jpg","date":"2026-10-31T14:00:00+01:00","availableTickets":175,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-31 14:00:00","startAt":"2026-09-11 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-31 14:00:00"},"products":[{"id":308,"name":"Kanapa","rawPrice":5000,"price":"50,00","allowSaleUsingPass":false,"available":11},{"id":309,"name":"Bilet N","rawPrice":2500,"price":"25,00","allowSaleUsingPass":false,"available":164}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":441,"name":"Supermocni ","description":"Zo\u015bka jest troch\u0119 zwariowan\u0105 nastolatk\u0105, kt\u00f3ra najbardziej na \u015bwiecie kocha swoje zwierzaki. Gdy pewnego dnia, w naukowym laboratorium jej mamy, dochodzi do ma\u0142ej demolki, a Zo\u015bka i zwierzaki stykaj\u0105 si\u0119 z tajemnicz\u0105 kosmiczn\u0105 substancj\u0105, \u017cycie ca\u0142ej rodziny staje na g\u0142owie! Dziewczynka i jej pupile zaczynaj\u0105 si\u0119 dziwnie zmienia\u0107. Ona staje si\u0119 bardziej dzika i zwinna, a futrzaki bardziej bystre i wygadane. Z jednej strony to \u015bwietna sprawa, bo wszyscy zyskuj\u0105 niesamowite moce, ale z drugiej, je\u015bli tak dalej p\u00f3jdzie, Zo\u015bka ca\u0142kiem zmieni si\u0119 w zwierzaka, a zwierzaki w ludzi. Zosta\u0142 im tylko jeden dzie\u0144 na odwr\u00f3cenie tej 