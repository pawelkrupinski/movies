eservation":{"enabled":false,"endAt":"2026-11-12 18:00:00"},"products":[{"id":52,"name":"95 z\u0142 (przedsprzeda\u017c do 30.09)","rawPrice":9500,"price":"95,00","saleMultiple":0,"allowSaleUsingPass":false,"available":125}]},"event":{"id":875,"name":"Legendy Polskiej Muzyki \/koncert\/ ","description":"Wyj\u0105tkowy koncert po\u015bwi\u0119cony tw\u00f3rczo\u015bci Zbigniewa Wodeckiego, Andrzeja Zauchy, Krzysztofa Krawczyka \u2013 pe\u0142en melodii, kt\u00f3re zna kilka pokole\u0144 Polak\u00f3w, ale zaprezentowanych w nowych, starannie przygotowanych aran\u017cacjach. Na scenie wyst\u0105pi\u0105 trzej znakomici wokali\u015bci: Micha\u0142 Szafraniec \u2013 Mrozu Band, Daniel Zako\u015bcielny \u2013 Teatr Roma, Kamil Grabarz \u2013 Skangur, go\u015bcinnie pojawi si\u0119 tak\u017ce Barbara Furma\u0144ska z towarzyszeniem orkiestry kameralnej pod batut\u0105 Wojciecha Zwierniaka.","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"koncert","categoryId":2,"omomoCategory":"21","duration":90,"image":"\/uploads\/event\/1788854628.jpg","artists":[]},"organizer":{"id":3,"name":"MDK","officialName":"Miejski Dom Kultury w Bochni","street":"ul. Regis 1","city":"Bochnia","postCode":"32-700","nip":"868-16-04-860","www":null},"location":{"id":12,"name":"Du\u017ca Sala","institution_name":"Kino Regis","location_description":"4K","location_type":1,"location_type_name":"sala","city":"Bochnia","city_id":462,"zip":"32-700","addresse":"ul. Regis 1"}},"6893":{"id":6893,"title":"Bochnia Rocks - ATOMIC ROOSTER koncert ","url":"\/kup-bilet\/bochnia-rocks-atomic-rooster-koncert-2026-11-19-20-00-2","image":"\/uploads\/event\/1785849419.jpg","date":"2026-11-19T20:00:00+01:00","availableTickets":105,"additionalInfo":"","regulationsUrl":null,"info":{"sale":{"enabled":true,"endAt":"2026-11-19 19:00:00","startAt":"2026-08-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-11-19 20:00:00"},"products":[{"id":41,"name":"130 z\u0142 koncert","rawPrice":13000,"price":"130,00","saleMultiple":0,"allowSaleUsingPass":false,"available":105}]},"event":{"id":859,"name":"Bochnia Rocks - ATOMIC ROOSTER koncert ","description":"Atomic Rooster - legendarny brytyjski zesp\u00f3\u0142 rockowy, za\u0142o\u017cony w 1969 \r\nroku przez klawiszowca Vincenta Crane\u2019a i perkusist\u0119 Carla Palmera. \r\nGrupa gra mroczny rock progresywny i hard rock, a jej najwi\u0119ksze \r\nprzeboje to \u201eTomorrow Night\u201d oraz \u201eThe Devil's Answer\u201d.\r\n<br>\r\n<br>Obecnie zesp\u00f3\u0142 wci\u0105\u017c koncertuje i tworzy, a na jego czele stoi \r\ngitarzysta z dawnego sk\u0142adu Steve \u201eBoltz\u201d Bolton (The Who, Paul Young). \r\nGrupa wyda\u0142a w pa\u017adzierniku 2025 roku album \u201eCircle the Sun\u201d (ich \r\npierwszy kr\u0105\u017cek od 42 lat) i regularnie koncertuje!\r\n<br>\r\n<br>\r\n<br>W sk\u0142ad reaktywowanej grupy wchodz\u0105:\r\n<br>\r\n<br>&nbsp;* <span class=\"moz-txt-tag\">*<\/span>Steve \u201eBoltz\u201d Bolton<span class=\"moz-txt-tag\">*<\/span> \u2013 gitara, \u015bpiew (muzyk z okresu 1971\u20131972 i\r\n<br>&nbsp;&nbsp; lider rekatywacji)\r\n<br>&nbsp;* <span class=\"moz-txt-tag\">*<\/span>Adrian Gautrey<span class=\"moz-txt-tag\">*<\/span> \u2013 instrumenty klawiszowe, \u015bpiew\r\n<br>&nbsp;* <span class=\"moz-txt-tag\">*<\/span>Shug Millidge<span class=\"moz-txt-tag\">*<\/span> \u2013 gitara basowa\r\n<br>&nbsp;* <span class=\"moz-txt-tag\">*<\/span>Paul Everett<span class=\"moz-txt-tag\">*<\/span> \u2013 perkusja&nbsp;","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"koncert","categoryId":2,"omomoCategory":"21","duration":0,"image":"\/uploads\/event\/1785849419.jpg","artists":[]},"organizer":{"id":3,"name":"MDK","officialName":"Miejski Dom Kultury w Bochni","street":"ul. Regis 1","city":"Bochnia","postCode":"32-700","nip":"868-16-04-860","www":null},"location":{"id":12,"name":"Du\u017ca Sala","institution_name":"Kino Regis","location_description":"4K","location_type":1,"location_type_name":"sala","city":"Bochnia","city_id":462,"zip":"32-700","addresse":"ul. Regis 1"}},"6551":{"id":6551,"title":"Bochnia Rocks - JAZZ SABBATH ","url":"\/kup-bilet\/bochnia-rocks-jazz-sabbath-2027-01-14-20-00","image":"\/uploads\/event\/1778675508.jpg","date":"2027-01-14T20:00:00+01:00","availableTickets":0,"additionalInfo":"","regulationsUrl":null,"info":{"sale":{"enabled":true,"endAt":"2027-01-14 19:00:00","startAt":"2026-05-13 00:00:00"},"reservation":{"enabled":false,"endAt":"2027-01-14 20:00:00"},"products":[{"id":50,"name":"199 Bochnia Rocks","rawPrice":19900,"price":"199,00","saleMultiple":0,"allowSaleUsingPass":false,"available":0}]},"event":{"id":822,"name":"Bochnia Rocks - JAZZ SABBATH ","description":"Energetyczny, w 100% jazzowy koncert dla fan\u00f3w jazzu, rocka i wszystkiego pomi\u0119dzy. <b>Jazz Sabbath <\/b>to trio jazzowe z Wielkiej Brytanii, graj\u0105ce (instrumentalne) jazzowe interpretacje utwor\u00f3w Black Sabbath, pod przewodnictwem pianisty <b>Adama Wakemana<\/b>, zdobywcy nagrody Grammy (od 2004 roku klawiszowca zespo\u0142u Black Sabbath i Ozzy'ego Osbourne\u2019a).&nbsp;","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"koncert","categoryId":2,"omomoCategory":"21","duration":0,"image":"\/uploads\/event\/1778675508.jpg","artists":[]},"organizer":{"id":3,"name":"MDK","officialName":"Miejski Dom Kultury w Bochni","street":"ul. Regis 1","city":"Bochnia","postCode":"32-700","nip":"868-16-04-860","www":null},"location":{"id":12,"name":"Du\u017ca Sala","institution_name":"Kino Regis","location_description":"4K","location_type":1,"location_type_name":"sala","city":"Bochnia","city_id":462,"zip":"32-700","addresse":"ul. Regis 1"}},"6898":{"id":6898,"title":"Bochnia Rocks - RIPPER OWENS koncert ","url":"\/kup-bilet\/bochnia-rocks-ripper-owens-koncert-2027-02-04-20-00","image":"\/uploads\/event\/1785864553.jpeg","date":"2027-02-04T20:00:00+01:00","availableTickets":88,"additionalInfo":"","regulationsUrl":null,"info":{"sale":{"enabled":true,"endAt":"2027-02-04 19:00:00","startAt":"2026-08-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2027-02-04 20:00:00"},"products":[{"id":35,"name":"150 Bochnia Rocks","rawPrice":15000,"price":"150,00","saleMultiple":0,"allowSaleUsingPass":false,"available":88}]},"event":{"id":864,"name":"Bochnia Rocks - RIPPER OWENS koncert ","description":"4 lutego 2027 do Bochni zawita jeden z najwi\u0119kszych g\u0142os\u00f3w \u015bwiata heavy \r\nmetalu. Tim \"Ripper\" Owens \u2013 by\u0142y wokalista takich zespo\u0142\u00f3w jak Judas \r\nPriest, Iced Earth, Yngwie Malmsteen\u2019s Rising Force oraz obecny frontman \r\nKK\u2019s Priest \u2013 wyst\u0105pi w ramach swojej europejskiej trasy koncertowej. \r\nOwens zdoby\u0142 mi\u0119dzynarodow\u0105 s\u0142aw\u0119, kiedy w 1996 roku zast\u0105pi\u0142 Roba \r\nHalforda w Judas Priest \u2013 a historia jego \u201eawansu\" z tribute bandu do \r\nzespo\u0142u, kt\u00f3ry kocha\u0142 zainspirowa\u0142a nawet tw\u00f3rc\u00f3w filmu Rock Star z \r\nMarkiem Wahlbergiem.\r\n<br>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"koncert","categoryId":2,"omomoCategory":"21","duration":0,"image":"\/uploads\/event\/1785864553.jpeg","artists":[]},"organizer":{"id":3,"name":"MDK","officialName":"Miejski Dom Kultury w Bochni","street":"ul. Regis 1","city":"Bochnia","postCode":"32-700","nip":"868-16-04-860","www":null},"location":{"id":12,"name":"Du\u017ca Sala","institution_name":"Kino Regis","location_description":"4K","location_type":1,"location_type_name":"sala","city":"Bochnia","city_id":462,"zip":"32-700","addresse":"ul. Regis 1"}}}}