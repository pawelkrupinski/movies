tution_name":"Miejski O\u015brodek Kultury w \u017borach","location_description":"","location_type":1,"location_type_name":"sala","city":"\u017bory","city_id":2332,"zip":"44-240","addresse":"ul. Ko\u015bciuszki 3"}},"2326":{"id":2326,"title":"Koncert zespo\u0142u LOR - Festiwal SARI ","url":"\/kup-bilet\/koncert-zespolu-lor-festiwal-sari-2026-10-11-18-00","image":"\/uploads\/event\/1784639236.jpg","date":"2026-10-11T18:00:00+02:00","availableTickets":208,"additionalInfo":"","regulationsUrl":null,"info":{"sale":{"enabled":true,"endAt":"2026-10-11 17:30:00","startAt":"2026-07-21 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-11 18:00:00"},"products":[{"id":142,"name":"Koncert LOR","rawPrice":10000,"price":"100,00","saleMultiple":0,"allowSaleUsingPass":false,"available":208}]},"event":{"id":423,"name":"Koncert zespo\u0142u LOR - Festiwal SARI ","description":"<p class=\"isSelectedEnd\" style=\"\"><font size=\"4\">Koncert zespo\u0142u <strong style=\"\">LOR<\/strong> b\u0119dzie fina\u0142em jubileuszowej edycji <strong style=\"\">Festiwalu SARI<\/strong>, organizowanej w ramach obchod\u00f3w <strong style=\"\">70-lecia Miejskiego O\u015brodka Kultury w \u017borach<\/strong>.<\/font><\/p><p class=\"isSelectedEnd\" style=\"\"><font size=\"4\">LOR to jedna z najciekawszych formacji m\u0142odego pokolenia na polskiej scenie muzycznej. Subtelne brzmienie, poetyckie teksty i wyj\u0105tkowa atmosfera ich koncert\u00f3w sprawiaj\u0105, \u017ce zesp\u00f3\u0142 od lat zdobywa uznanie publiczno\u015bci.<\/font><\/p><p class=\"isSelectedEnd\" style=\"\"><font size=\"4\"><strong>11 pa\u017adziernika 2026 | godz. 18:00<\/strong><br><strong>Kino na Star\u00f3wce<\/strong><\/font><\/p><p class=\"isSelectedEnd\" style=\"\"><strong><font size=\"4\">Bilety:<\/font><\/strong><\/p><ul data-spread=\"false\" style=\"\"><li><font size=\"4\">100 z\u0142 \u2013 przedsprzeda\u017c,<\/font><\/li><li><font size=\"4\">110 z\u0142 \u2013 w dniu koncertu.<\/font><\/li><\/ul><p class=\"isSelectedEnd\" style=\"\"><font size=\"4\">Rozszerzona formu\u0142a Festiwalu SARI jest jednym z najwa\u017cniejszych wydarze\u0144 przygotowanych z okazji <strong>70-lecia Miejskiego O\u015brodka Kultury w \u017borach<\/strong>. To \u015bwi\u0119to muzyki, spotka\u0144 i ludzi, kt\u00f3rzy od siedmiu dekad wsp\u00f3\u0142tworz\u0105 \u017cycie kulturalne miasta.<\/font><\/p><p style=\"\"><font size=\"4\">Przez trzy pa\u017adziernikowe dni \u017bory ponownie stan\u0105 si\u0119 miejscem spotkania artyst\u00f3w i publiczno\u015bci, potwierdzaj\u0105c, \u017ce Festiwal SARI niezmiennie pozostaje jednym z najwa\u017cniejszych muzycznych wydarze\u0144 regionu.<\/font><\/p>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"KONCERT","categoryId":2,"omomoCategory":"0","duration":60,"image":"\/uploads\/event\/1784639236.jpg","artists":[]},"organizer":{"id":1,"name":"MOK \u017bory","officialName":"Miejski O\u015brodek Kultury w \u017borach","street":"ul. Dolne Przedmie\u015bcie 1","city":"\u017bory","postCode":"44-240","nip":"651-00-09-658","www":null},"location":{"id":3,"name":"Kino Na Star\u00f3wce","institution_name":"Miejski O\u015brodek Kultury w \u017borach","location_description":"","location_type":1,"location_type_name":"sala","city":"\u017bory","city_id":2332,"zip":"44-240","addresse":"ul. Ko\u015bciuszki 3"}},"2562":{"id":2562,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-13-16-00","image":"\/uploads\/event\/1788527340.jpg","date":"2026-10-13T16:00:00+02:00","availableTickets":189,"additionalInfo":"","regulationsUrl":"","info":{"sale":{"enabled":true,"endAt":"2026-10-13 15:30:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-13 16:00:00"},"products":[{"id":2,"name":"BILET NORMALNY DO KINA","rawPrice":2000,"price":"20,00","saleMultiple":0,"allowSaleUsingPass":false,"available":189}]},"event":{"id":456,"name":"LALKA ","description":"<font size=\"4\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/font><div><span style=\"font-family: Lato, Arial; box-sizing: border-box; color: rgb(51, 51, 51); font-size: 14px;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; font-weight: 700;\">Produkcja\/rok:<\/span> <span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; color: rgb(0, 0, 0);\"><span style=\"font-family: Lato, Arial; box-sizing: border-box;\">Polska\/2026<\/span>&nbsp;<\/span>&nbsp;<span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; font-weight: 700;\">Gat