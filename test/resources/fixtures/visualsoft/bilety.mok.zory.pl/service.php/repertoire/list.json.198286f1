ryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"FILM","categoryId":1,"omomoCategory":"1","duration":110,"image":"\/uploads\/event\/469\/1789656497.jpg","artists":[]},"organizer":{"id":1,"name":"MOK \u017bory","officialName":"Miejski O\u015brodek Kultury w \u017borach","street":"ul. Dolne Przedmie\u015bcie 1","city":"\u017bory","postCode":"44-240","nip":"651-00-09-658","www":null},"location":{"id":3,"name":"Kino Na Star\u00f3wce","institution_name":"Miejski O\u015brodek Kultury w \u017borach","location_description":"","location_type":1,"location_type_name":"sala","city":"\u017bory","city_id":2332,"zip":"44-240","addresse":"ul. Ko\u015bciuszki 3"}},"2504":{"id":2504,"title":"LALKA ","url":"\/kup-bilet\/lalka-2026-10-01-16-00","image":"\/uploads\/event\/1788527340.jpg","date":"2026-10-01T16:00:00+02:00","availableTickets":188,"additionalInfo":"","regulationsUrl":"","info":{"sale":{"enabled":true,"endAt":"2026-10-01 15:30:00","startAt":"2026-09-04 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-01 16:00:00"},"products":[{"id":2,"name":"BILET NORMALNY DO KINA","rawPrice":2000,"price":"20,00","saleMultiple":0,"allowSaleUsingPass":false,"available":188}]},"event":{"id":456,"name":"LALKA ","description":"<font size=\"4\">Warszawa ko\u0144ca XIX wieku. Serce Stanis\u0142awa Wokulskiego (Marcin Doroci\u0144ski) ow\u0142adni\u0119te jest szalon\u0105 mi\u0142o\u015bci\u0105 do Izabeli \u0141\u0119ckiej (Kamila Urz\u0119dowska). On, dzi\u0119ki fortunie zdobytej na wojnie, powraca do kraju i postanawia wkroczy\u0107 do \u015bwiata wy\u017cszych sfer, aby zdoby\u0107 r\u0119k\u0119 ukochanej. Ona jest ol\u015bniewaj\u0105ca i wynios\u0142a, lecz mimo arystokratycznego pochodzenia zmaga si\u0119 z widmem finansowej ruiny. U boku Wokulskiego stoi jego wierny przyjaciel \u2013 Ignacy Rzecki (Marek Kondrat), romantyk, kt\u00f3ry z nostalgi\u0105 obserwuje, jak \u015bwiat idea\u0142\u00f3w ust\u0119puje miejsca spo\u0142ecznym aspiracjom i bezwzgl\u0119dnej grze interes\u00f3w. Wokulski wkracza w labirynt arystokratycznych salon\u00f3w, gdzie ka\u017cdy gest mo\u017ce by\u0107 pocz\u0105tkiem intrygi, a ka\u017cde s\u0142owo \u2013 zapowiedzi\u0105 zdrady. Staj\u0105cy na jego drodze rywale, niespodziewane sojusze i dramatyczne wybory wystawi\u0105 na pr\u00f3b\u0119 jego marzenia i wiar\u0119 w ludzi. To opowie\u015b\u0107 o mi\u0142osnym zauroczeniu, kt\u00f3re zmienia losy bohater\u00f3w i zaciera granice mi\u0119dzy sercem a rozumem.<\/font><div><span style=\"font-family: Lato, Arial; box-sizing: border-box; color: rgb(51, 51, 51); font-size: 14px;\"><span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; font-weight: 700;\">Produkcja\/rok:<\/span> <span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; color: rgb(0, 0, 0);\"><span style=\"font-family: Lato, Arial; box-sizing: border-box;\">Polska\/2026<\/span>&nbsp;<\/span>&nbsp;<span style=\"font-family: &quot;Titillium Web&quot;, sans-serif, &quot;Trebuchet MS&quot;, Verdana, Arial, Tahoma; box-sizing: border-box; font-weight: 700;\">Gatunek:<\/span>&nbsp;<\/span><span style=\"background-color: rgb(255, 255, 255); font-family: Lato, Arial; font-size: 14px;\">Kostiumowy, Dramat obyczajowy<\/span><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"FILM","categoryId":1,"omomoCategory":"1","duration":162,"image":"\/uploads\/event\/1788527340.jpg","artists":[]},"organizer":{"id":1,"name":"MOK \u017bory","officialName":"Miejski O\u015brodek Kultury w \u017borach","street":"ul. Dolne Przedmie\u015bcie 1","city":"\u017bory","postCode":"44-240","nip":"651-00-09-658","www":null},"location":{"i