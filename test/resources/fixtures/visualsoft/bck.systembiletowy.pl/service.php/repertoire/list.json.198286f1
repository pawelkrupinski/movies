caps: normal; font-weight: normal; text-align: justify;\"><font face=\"Arial, Verdana\"><span style=\"font-size: 13.3333px;\">Szanowni Pa\u0144stwo, podczas spotka\u0144 \/ warsztat\u00f3w mo\u017cliwa jest obecno\u015b\u0107 t\u0142umaczki polskiego j\u0119zyka migowego (PJM) oraz asystenta os\u00f3b ze szczeg\u00f3lnymi potrzebami. Prosimy o zg\u0142oszenie ich obecno\u015bci emailem: becekczyta@becek.pl lub telefonicznie 32 \/ 389 31 09 w. 100, na minimum 12 godzin przed spotkaniem.<\/span><\/font><\/div><div style=\"font-family: Arial, Verdana; font-size: 10pt; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: normal; text-align: justify;\"><br><\/div>","oryginal_title":"","additional_title":null,"distributor":null,"sKSIdent":"#f8a41e","movieType":"","director":"","organizer":"","country":"","year":"","category":"BECEK CZYTA","categoryId":19,"omomoCategory":"60","duration":0,"image":"\/uploads\/event\/3239\/1789469720.png","artists":[]},"location":{"id":81,"name":"Bytom, ul. Katowicka 46\/2","institution_name":"Pracownia \u201eFajna kreska\u201d","location_description":"","location_type":2,"location_type_name":"otwarte","city":"Bytom","city_id":1718,"zip":"41-902","addresse":"ul. Katowicka 46\/2"}},"12279":{"id":12279,"title":"BECEK CZYTA \u2013 Spotkanie autorskie: Dorota Combrzy\u0144ska-Nogala ","url":"\/kup-bilet\/becek-czyta-spotkanie-autorskie-dorota-combrzynska-nogala-2026-10-11-10-30","image":"\/uploads\/event\/3240\/1789470518.png","date":"2026-10-11T10:30:00+02:00","availableTickets":20,"additionalInfo":"","info":{"sale":{"enabled":true,"endAt":"2026-10-11 09:30:00","startAt":"2026-09-15 00:00:00"},"reservation":{"enabled":false,"endAt":"2026-10-11 10:30:00"},"products":[{"id":172,"name":"Spotkanie autorskie ","rawPrice":500,"price":"5,00","allowSaleUsingPass":false,"available":20}],"customerPassAvailable":[],"customerHaveTicket":[]},"event":{"id":3240,"name":"BECEK CZYTA \u2013 Spotkanie autorskie: Dorota Comb