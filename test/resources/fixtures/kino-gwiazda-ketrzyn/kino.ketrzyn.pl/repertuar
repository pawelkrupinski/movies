<script>
document.addEventListener('alpine:init', () => {
    // Generate movies array from Statamic data
    const movies = [
        { dates: ['2026-10-09'], cats: ['animacja'] },
        { dates: ['2026-09-26','2026-09-27'], cats: ['fantasy','komedia-romantyczna'] },
        { dates: ['2026-10-02','2026-10-03','2026-10-04','2026-10-05','2026-10-06','2026-10-07'], cats: ['animacja'] },
        { dates: ['2026-09-25','2026-09-26','2026-09-27','2026-09-28','2026-09-29'], cats: ['dramat'] },
        { dates: ['2026-09-25','2026-09-26','2026-09-27','2026-09-28','2026-09-29','2026-09-30'], cats: ['animacja'] },
        { dates: ['2026-09-30','2026-10-02','2026-10-02','2026-10-03','2026-10-03','2026-10-04','2026-10-04','2026-10-05','2026-10-05','2026-10-06','2026-10-06','2026-10-07','2026-10-07','2026-10-09','2026-10-09','2026-10-10','2026-10-10','2026-10-11','2026-10-11','2026-10-12','2026-10-12','2026-10-13','2026-10-13','2026-10-14','2026-10-14'], cats: ['dramat','romans'] },
        { dates: ['2026-10-08'], cats: ['dramat'] },
        { dates: ['2026-10-12'], cats: ['dramat'] },
        { dates: ['2026-10-11'], cats: ['dokumentalny'] },
        { dates: ['2026-09-25','2026-09-26','2026-09-27','2026-09-28','2026-09-29','2026-09-30'], cats: ['akcja','komedia'] }
        
    ];

    // Generate dates array
    const today = new Date();
    const days = ['Nd', 'Pn', 'Wt', 'Śr', 'Cz', 'Pt', 'Sb'];
    const fullDays = ['Niedziela', 'Poniedziałek', 'Wtorek', 'Środa', 'Czwartek', 'Piątek', 'Sobota'];
    const dates = [
        { value: 'all', label: 'Wszystkie dni', shortLabel: 'Wszystkie', date: null }
    ];

    const lastDayOfMonth = new Date(today.getFullYear(), today.getMonth() + 1, 0);
    const daysUntilEndOfMonth = Math.ceil((lastDayOfMonth - today) / (1000 * 60 * 60 * 24)) + 1;

    for (let i = 0; i < daysUntilEndOfMonth; i++) {
        const d = new Date(today);
        d.setDate(today.getDate() + i);
        const dayName = days[d.getDay()];
        const fullDayName = fullDays[d.getDay()];
        const dateStr = d.toISOString().split('T')[0];
        const dayNum = d.getDate().toString().padStart(2, '0');
        const monthNum = (d.getMonth() + 1).toString().padStart(2, '0');
        let label = '';
        let shortLabel = '';
        if (i === 0) {
            label = 'Dzisiaj';
            shortLabel = 'Dziś';
        } else if (i === 1) {
            label = 'Jutro';
            shortLabel = 'Jutro';
        } else {
            label = fullDayName + ', ' + dayNum + '.' + monthNum;
            shortLabel = dayName + ' ' + dayNum + '.' + monthNum;
        }
        dates.push({
            value: dateStr,
            label: label,
            shortLabel: shortLabel,
            date: d
        });
    }

    Alpine.store('repertoire', {
        selectedDate: 'all',
        selectedCategory: 'all',
        dates: dates,
        movies: movies,
        get visibleCount() {
            const date = this.selectedDate;
            const cat = this.selectedCategory;
            return this.movies.filter(m => {
                const dateMatch = date === 'all' || m.dates.includes(date);
                const catMatch = cat === 'all' || m.cats.some(c => c === cat);
                return dateMatch && catMatch;
            }).length;
        },
        countLabel(n) {
            if (n === 1) return 'film';
            if (n >= 2 && n <= 4) return 'filmy';
            return 'filmów';
        },
        updateUrl() {
            const params = new URLSearchParams(window.location.search);
            if (this.selectedDate !== 'all') {
                params.set('date', this.selectedDate);
            } else {
                params.delete('date');
            }
            if (this.selectedCategory !== 'all') {
                params.set('category', this.selectedCategory);
            } else {
                params.delete('category');
            }
            const newUrl = params.toString() ? window.location.pathname + '?' + params : window.location.pathname;
            window.history.replaceState({}, '', newUrl);
        }
    });
});
</script>
