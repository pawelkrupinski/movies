                <h2 data-movie="2343" data-movie-hide="0" data-movie-school="1" class="h5 bold mb-2 text-black movie-title pointer">Luna i rozgadana świnka              </h2>
                                <div class="tooltip tooltip-title"></div>
                                  </div>
                <p class="small mb-1 text-dark">Animowany, Francja / Belgia, 2026</p>                <p class="small mb-1 text-dark"><b>Czas trwania:</b> 88 min.</p>                <p class="small mb-1 text-dark"><b>Reżyseria:</b> Philippe Riche</p>                                <p class="small mb-3 text-dark"><b>Od&nbsp;lat:</b> 6</p>                              </div>
