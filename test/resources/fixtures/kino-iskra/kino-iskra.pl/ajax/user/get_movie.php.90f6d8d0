                                    <div class="btn-group position-absolute btn-group-poster-zoomed d-none d-md-inline-flex">
                                        <a href="https://kino-iskra.pl/uploads/img/movies/2324-1787132330.png" target="_blank" class="btn btn-info d-flex justify-content-center align-items-center pointer fix-width-36"><i class="fas fa-search-plus"></i></a>
