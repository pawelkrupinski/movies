              <img alt="Plakat: Stand-up: Tomasz Boras" class="w-100 poster-to-zoom pointer" src="https://kino-iskra.pl/uploads/img/movies/2324-1787132330.png"/>
              <div class="row no-gutters">
                <div class="col px-1 bg-light align-items-center">
                  <p class="d-vsmaller text-center w-100 my-1">15 października, 19:00</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-sm-9 col-12 pl-sm-1 pl-3">
          <div class="row no-gutters justify-content-between">
            <div class="col">
              <div class="position-relative d-inline">
                <h2 data-movie="2324" data-movie-hide="0" data-movie-school="0" class="h5 bold mb-2 text-black movie-title pointer">Stand-up: Tomasz Boras              </h2>
                                <div class="tooltip tooltip-title"></div>
                                  </div>
                <p class="small mb-1 text-dark">Stand-up na żywo</p>                <p class="small mb-1 text-dark"><b>Czas trwania:</b> 90 min.</p>                                                <p class="small mb-3 text-dark"><b>Od&nbsp;lat:</b> 18</p>                              </div>
            </div>
            <div class="row mb-2 order-1 pr-0 d-flex flex-wrap align-items-start justify-content-start">
              <div class="col">
                                                      <a  class="btn btn-opacity btn-sm vsmall mb-1 ml-1 rounded-0 poster-tag" style="background-color: #0A68CA; color: #FFFFFF;">Na żywo</a>
                                                </div>
            </div>
                          <div class="row">
                <div class="col">
                  <p class="small mb-3">Bilety na kupbilecik.pl</p>
                </div>
              </div>
                                      <div class="row">
                <div class="col">
                  <p class="small mb-3">Tomasz Boras wraca z nowym programem &quot;Kairos&quot; - opowieścią o momentach, nie tylko tych przełomowych ale też. To podróż przez codzienność, przegapione okazje, spóźnione przemyślenia i niespodziewane wglądy - podane w formie krótkich, celnych żartów, z których Boras znany jest najlepiej. Twórca, którego żarty wybrzmiały między innymi w Comedy Central, Polsacie i TVN oraz przede wszystkim przed licznym audytorium w świecie rzeczywistym. Boras z pozornie błahych spraw potrafi często w jednym zdaniu wycisnąć śmiech, refleksję, raz odrobinę, raz ocean absurdu. &quot;Kairos&quot; to program, który uderza z zaskoczenia, wybija z rytmu, zwłaszcza wtedy kiedy myślisz, że wszystko masz pod kontrolą. Rezerwuj miejsce i godnie przywitaj Borasa w swoim mieście. Do zobaczenia! <br />
<br />
P.S.: przed Borasem wystąpi również support.</p>
                </div>
              </div>
                                      <div class="row">
                <div class="col">
                  <div class="row">
                    <div class="col">
                      <p class="vsmall my-2">Nie możesz kupić/zarezerwować biletu dla tego filmu przez Internet</p>
                                                                      </div>
                      </div>
                      <div class="row">
                        <div class="col">
                          <span class="btn btn-sm btn-dark py-1 px-2 mb-1 mr-1 bold rounded-0">15 października</span>
                                                <div class="position-relative d-inline"><button type="button" title="Zobacz szczegóły wydarzenia o 19:00" class="position-relative btn btn-sm btn-accent-dark py-1 px-2 mb-1 mr-1 text-white pointer rounded-0 event-button" data-movie="2324" data-event="15205">19:00</button><div class="tooltip"></div></div>
                                            </div>
                  </div>
                </div>
              </div>
                            <div class="row">
                <div class="col">
                  <div class="d-flex justify-content-end align-items-start h5">
                                                                                  <a title="Drukuj kartę opisową" target="_blank" href="/functions/filemanipulation/descgenerator/?movie_id=2324" class="pointer fas fa-print ml-1 text-dark" aria-hidden="true"></a>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col">
                  <div id="movie-trailer-container">
                    <!-- place for trailer iframe -->
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <hr class="mb-0">

<script>
        $('.poster-to-zoom').click(function(){
        if($('.poster-zoomed-wrapper').hasClass('d-none')){
            $('.poster-zoomed-wrapper').removeClass('d-none');
            $('.poster-zoomed-wrapper').addClass('d-flex');
    }
    })
    $('.poster-zoomed-wrapper').click(function (data, handler){
        if (data.target == this && $('.poster-zoomed-wrapper').hasClass('d-flex')) {
            $('.poster-zoomed-wrapper').removeClass('d-flex');
            $('.poster-zoomed-wrapper').addClass('d-none');
        }
    } );
    $('.btn-close-poster-zoomed').click(function(){
        if($('.poster-zoomed-wrapper').hasClass('d-flex')){
            $('.poster-zoomed-wrapper').removeClass('d-flex');
            $('.poster-zoomed-wrapper').addClass('d-none');
        }
    })
        $('.movie-title').click(function(){
        var tooltip = $('.movie-title').parent().children('.tooltip');
        if($(tooltip).hasClass('d-block')){
            $(tooltip).removeClass('d-block');
        }else{
            var currentTooltipText = $(tooltip).html();
            $(tooltip).html(currentTooltipText+'<div class="btn-group-vertical text-white"><a class="btn p-2 pointer btn-info bold vsmall text-left"><i class="fas fa-spinner fa-spin"></i></a></div>');
            var movieId = $(this).attr('data-movie');
            var movieHide = $(this).attr('data-movie-hide');
            var movieSchool = $(this).attr('data-movie-school');
            var movieTitle = $(this).clone().children().remove().end().text();
            var getMovieTooltipUrl = "/ajax/user/get_movie_tooltip_page.php?movie="+movieId+"&hide="+movieHide+"&school="+movieSchool+"&movie_title="+movieTitle;
            $.get(getMovieTooltipUrl, function(result){
                $(tooltip).html(result);
            });
            $('.tooltip').removeClass('d-block');
            $(tooltip).addClass('d-block');
        }
    })
      $('#trailer-button').click(function(){
        var currentBtn = $(this);
        var currentBtnText = $(currentBtn).html();
        $(currentBtn).html(currentBtnText+'<i class="ml-2 fas fa-spinner fa-spin"></i>');
        var youtubeUrl = $(this).attr('data-trailer-url');
        var trailerToggle = $(this).attr('data-trailer-toggle');
        if(trailerToggle == 'closed'){
          var getTrailerUrl = "/ajax/user/get_trailer.php?trailer="+youtubeUrl;
          $.get(getTrailerUrl, function(result){
            $('#movie-trailer-container').html(result);
          })
          $(this).removeClass('text-dark');
          $(this).addClass('text-accent mb-3');
          $(this).attr('data-trailer-toggle', 'opened');
        }else{
          $('#movie-trailer-container').html('');
          $(this).addClass('text-dark');
          $(this).removeClass('text-accent mb-3');
          $(this).attr('data-trailer-toggle', 'closed');
        }
        $(currentBtn).html(currentBtnText);
      });
      $('.event-button').click(function(){
        var tooltip = $(this).parent().children('.tooltip');
        if($(tooltip).hasClass('d-block')){
          $(tooltip).removeClass('d-block');
        }else{
          var currentTooltipText = $(tooltip).html();
          $(tooltip).html(currentTooltipText+'<div class="btn-group-vertical text-white"><a class="btn p-2 pointer btn-info bold vsmall text-left"><i class="fas fa-spinner fa-spin"></i></a></div>');
          var eventId = $(this).attr('data-event');
          var movieId = $(this).attr('data-movie');
          var getEventTooltipUrl = "/ajax/user/get_event_tooltip.php?event="+eventId+"&movie="+movieId;
          $.get(getEventTooltipUrl, function(result){
            $(tooltip).html(result);
          });
          $('.tooltip').removeClass('d-block');
          $(tooltip).addClass('d-block');
        }
      })
    </script>
