                            <div class="row">
                <div class="col">
                  <div class="d-flex justify-content-end align-items-start h5">
                    <i data-trailer-toggle="closed" title="Zobacz zwiastun" data-trailer-url="https://www.youtube.com/watch?v=hd1WVXnMkKQ" id="trailer-button" class="fab fa-youtube ml-1 text-dark btn-opacity pointer" aria-hidden="true"></i>                                                              <a title="Drukuj kartę opisową" target="_blank" href="/functions/filemanipulation/descgenerator/?movie_id=2337" class="pointer fas fa-print ml-1 text-dark" aria-hidden="true"></a>
