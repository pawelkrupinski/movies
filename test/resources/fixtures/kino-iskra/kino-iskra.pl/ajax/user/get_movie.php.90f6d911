              <img alt="Plakat: Spektakl Magic Men" class="w-100 poster-to-zoom pointer" src="https://kino-iskra.pl/uploads/img/movies/2347-1789401139.jpg"/>
              <div class="row no-gutters">
                <div class="col px-1 bg-light align-items-center">
                  <p class="d-vsmaller text-center w-100 my-1">6 listopada</p>
