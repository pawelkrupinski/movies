                        <div class="col">
                          <span class="btn btn-sm btn-dark py-1 px-2 mb-1 mr-1 bold rounded-0">29 września</span>
                                                <div class="position-relative d-inline"><button type="button" title="Zobacz szczegóły wydarzenia o 15:30" class="position-relative btn btn-sm btn-accent-dark py-1 px-2 mb-1 mr-1 text-white pointer rounded-0 event-button" data-movie="2338" data-event="15347">15:30</button><div class="tooltip"></div></div>
