    $(".act-scroll-top").hide();
    $(function(){
      var stt_is_shown = false;
      $(window).scroll(function(){
        var win_height = 300;
        var scroll_top = $(document).scrollTop();
        if (scroll_top > win_height && !stt_is_shown) {
          stt_is_shown = true;
          $(".act-scroll-top").addClass('d-flex');
          $(".act-scroll-top").fadeIn();
        }else if (scroll_top < win_height && stt_is_shown) {
          stt_is_shown = false;
          $(".act-scroll-top").fadeOut();
          $(".act-scroll-top").removeClass('d-flex');
        }
      });
      $(".act-scroll-top").click(function(e){
      e.preventDefault();
      $('html, body').animate({scrollTop:0}, 1500);});
    });
