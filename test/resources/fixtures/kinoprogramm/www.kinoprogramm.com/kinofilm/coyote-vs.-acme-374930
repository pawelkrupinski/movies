            <article class="overflow-hidden rounded-xl border border-line/80 bg-deep/45 shadow-panel" data-film-summary>
                <div class="grid grid-cols-[clamp(270px,25vw,390px)_minmax(0,1fr)] items-stretch max-md:grid-cols-[230px_minmax(0,1fr)] max-sm:grid-cols-1">
