<style>
    .kino-week-film {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: 112px minmax(0, 1fr);
        scroll-margin-top: 1rem;
    }

    .kino-week-poster {
        aspect-ratio: 2 / 3;
        display: block;
        overflow: hidden;
        width: 112px;
    }

    .kino-week-days-wrap {
        grid-column: 1 / -1;
        width: 100%;
    }

    .kino-week-days {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .kino-week-day {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        flex: 1 1 90px;
        min-width: 72px;
        padding: 0.65rem;
        text-align: center;
    }

    .kino-week-time {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        box-sizing: border-box;
        display: block;
        margin: 0.35rem auto 0;
        max-width: 120px;
        min-height: 32px;
        padding: 0.3rem 0.45rem;
        width: 100%;
    }

    .kino-program-toggle {
        align-items: center;
        display: flex;
        justify-content: space-between;
        width: 100%;
    }

    .kino-program-section[data-expanded="false"] .kino-program-list {
        display: none;
    }

    .kino-program-section[data-expanded="true"] .kino-program-list {
        margin-top: 0.5rem;
    }

    .kino-program-section[data-expanded="true"] .kino-program-toggle svg {
        transform: rotate(180deg);
    }

    .kino-program-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .kino-program-link {
        background: rgba(255, 255, 255, 0.03);
        padding: 0.4rem 0.625rem;
        transition: background-color 160ms ease, color 160ms ease;
    }

    .kino-program-link:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .kino-info-toggle {
        display: none;
    }

    @media (max-width: 767px) {
        .kino-week-film {
            gap: 0.875rem;
            grid-template-columns: 90px minmax(0, 1fr);
        }

        .kino-week-poster {
            width: 90px;
        }

        .kino-week-day {
            flex-basis: 105px;
            min-width: 0;
        }

        .kino-info-box {
            height: auto;
            max-height: none;
            overflow: visible;
            padding: 0.75rem;
        }

        .kino-info-title {
            display: none;
        }

        .kino-info-toggle {
            align-items: center;
            display: flex;
            justify-content: space-between;
            width: 100%;
        }

        .kino-info-box[data-expanded="false"] .kino-info-content {
            display: none;
        }

        .kino-info-box[data-expanded="true"] .kino-info-content {
            display: block;
            margin-top: 0.35rem;
        }

        .kino-info-box[data-expanded="true"] .kino-info-toggle svg {
            transform: rotate(180deg);
        }

        .kino-info-box .kino-program-section[data-expanded="false"] .kino-program-list {
            display: none !important;
        }

        .kino-info-box > h2 {
            font-size: 0.7rem;
            margin-bottom: 0;
        }

        .kino-info-box dl {
            font-size: 0.65rem;
        }

        .kino-info-box dt,
        .kino-info-box dd {
            padding-bottom: 0.4rem;
            padding-top: 0.4rem;
        }

        .kino-info-map {
            margin-top: 0.65rem;
            padding-top: 0.65rem;
        }

        .kino-info-map > h3 {
            font-size: 0.7rem;
            margin-bottom: 0.5rem;
        }

        .kino-info-map-frame {
            aspect-ratio: 2.6;
        }

        .kino-info-route {
            margin-top: 0.5rem;
            padding-bottom: 0.45rem;
            padding-top: 0.45rem;
        }
    }
</style>

