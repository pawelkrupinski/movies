        height: 100%;
        object-fit: cover;
        object-position: center;
        transition: transform 300ms ease;
    }
    .career-ad:hover .career-ad__image { transform: scale(1.025); }
    .career-ad__content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
