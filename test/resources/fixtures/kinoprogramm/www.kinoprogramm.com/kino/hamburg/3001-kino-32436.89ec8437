edSoft" href="#" aria-label="YouTube"><svg class="size-5 fill-none stroke-current stroke-[1.7]" viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path class="fill-current stroke-none" d="m10 9 5 3-5 3V9Z"></path></svg></a></div></div>
