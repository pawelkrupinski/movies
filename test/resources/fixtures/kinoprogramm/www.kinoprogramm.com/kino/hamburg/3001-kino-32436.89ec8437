    </div>
</dialog>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const dayFilters = Array.from(document.querySelectorAll('[data-kino-week-filter]'));
        const versionFilter = document.querySelector('[data-kino-week-version-filter]');
        const infoBox = document.querySelector('.kino-info-box');
        const infoToggle = document.querySelector('[data-kino-info-toggle]');
        if (infoBox && infoToggle) {
            infoToggle.addEventListener('click', function () {
                const isExpanded = infoBox.dataset.expanded !== 'true';
                infoBox.dataset.expanded = String(isExpanded);
                infoToggle.setAttribute('aria-expanded', String(isExpanded));
                infoToggle.setAttribute('aria-label', isExpanded ? 'Kino-Info schließen' : 'Kino-Info öffnen');
            });
        }
        const programSection = document.querySelector('.kino-program-section');
        const programToggle = document.querySelector('[data-kino-program-toggle]');
        if (programSection && programToggle) {
            const setProgramExpanded = function (isExpanded) {
                programSection.dataset.expanded = String(isExpanded);
                programToggle.setAttribute('aria-expanded', String(isExpanded));
                programToggle.setAttribute('aria-label', isExpanded ? 'Filme im Programm schließen' : 'Filme im Programm öffnen');
            };
            programToggle.addEventListener('click', function () {
                const isExpanded = programSection.dataset.expanded !== 'true';
                setProgramExpanded(isExpanded);
            });
        }
        if (dayFilters.length === 0) {
            return;
        }

        let selectedDay = 'all';
        const updateWeeklyProgram = function () {
            const selectedVersion = versionFilter ? versionFilter.value : 'all';
            let visibleFilms = 0;

            dayFilters.forEach(function (button) {
                const isActive = button.dataset.kinoWeekFilter === selectedDay;
                button.dataset.active = String(isActive);
                button.setAttribute('aria-pressed', String(isActive));
            });

            document.querySelectorAll('[data-kino-week-film]').forEach(function (film) {
                let filmHasShowing = false;

                film.querySelectorAll('[data-kino-week-day]').forEach(function (day) {
                    const matchesDay = selectedDay === 'all' || day.dataset.kinoWeekDay === selectedDay;
                    let dayHasShowing = false;

                    day.querySelectorAll('[data-kino-week-version]').forEach(function (version) {
                        const matchesVersion = selectedVersion === 'all' || version.dataset.kinoWeekVersion === selectedVersion;
                        version.hidden = !matchesVersion;
                        if (matchesVersion && version.querySelector('[class~="kino-week-time"]')) {
                            dayHasShowing = true;
                        }
                    });

                    const noShowing = day.querySelector('[data-kino-week-no-showing]');
                    if (noShowing) {
                        noShowing.hidden = dayHasShowing;
                    }
                    day.hidden = !matchesDay;
                    if (matchesDay && dayHasShowing) {
                        filmHasShowing = true;
                    }
                });

                film.hidden = !filmHasShowing;
                if (filmHasShowing) {
                    visibleFilms++;
                }
            });

            const emptyOutput = document.querySelector('[data-kino-week-empty-filter]');
            if (emptyOutput) {
                emptyOutput.hidden = visibleFilms !== 0;
            }
        };

        dayFilters.forEach(function (button) {
            button.addEventListener('click', function () {
                selectedDay = button.dataset.kinoWeekFilter;
                updateWeeklyProgram();
            });
        });
        if (versionFilter) {
            versionFilter.addEventListener('change', updateWeeklyProgram);
        }
        updateWeeklyProgram();
    });
</script>

