        <button class="absolute right-3 top-3 z-10 grid size-11 cursor-pointer place-items-center rounded-full border border-white/30 bg-black/70 text-3xl leading-none text-white hover:scale-105 hover:border-accent hover:bg-accent hover:shadow-redSoft" type="button" data-trailer-modal-close aria-label="Trailer schließen">×</button>
