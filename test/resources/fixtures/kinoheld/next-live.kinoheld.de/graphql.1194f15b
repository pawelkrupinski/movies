3086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"111173","title":"Avengers: Doomsday","titleOriginal":"Avengers: Doomsday","urlSlug":"avengers-doomsday-6ac374fc8fe95","duration":165,"productionYear":null,"description":"\u201eAvengers 5: Doomsday\u201c wird die gr\u00f6\u00dften Heldinnen und Helden des Marvel Cinematic Universe ein weiteres Mal zusammenbringen, um gegen einen neuen, \u00fcberm\u00e4chtigen Gegner anzutreten: Doctor Doom (Robert Downey jr.). Dieser ist ein Meister sowohl modernster Wissenschaft als auch m\u00e4chtiger Magie und nutzt eine sich ausbreitende kosmische Krise im Multiversum, um seine finsteren Pl\u00e4ne in die Tat umzusetzen. Daher m\u00fcssen sich Heldenteams aus drei unterschiedlichen Universen zusammentun, um dieser enormen Bedrohung entgegenzuwirken: die Avenger und New Avengers von Erde-616, die Fantastic Four von Erde-828 und die X-Men von einer weiteren Erde, die bisher noch nicht benannt wurde. Doch bevor die Held*innen den Superschurken konfrontieren k\u00f6nnen, m\u00fcssen sie zun\u00e4chst ihre eigenen Differenzen \u00fcberw\u00e4ltigen, die bei der Kollision unterschiedlicher Universen leider unvermeidlich sind.","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Joe Russo"},{"name":"Anthony Russo"}],"actors":[{"name":"Robert Downey jr."},{"name":"Chris Evans"},{"name":"Chris Hemsworth"},{"name":"Pedro Pascal"},{"name":"Paul Rudd"},{"name":"Anthony Mackie"},{"name":"Florence Pugh"},{"name":"Vanessa Kirby"},{"name":"Ebon Moss-Bachrach"},{"name":"Wyatt Russell"},{"name":"Channing Tatum"},{"name":"Simu Liu"},{"name":"Ian McKellen"},{"name":"Hayley Atwell"},{"name":"Tom Hiddleston"},{"name":"James Marsden"},{"name":"Patrick Stewart"},{"name":"Joseph Quinn"},{"name":"Sebastian Stan"},{"name":"David Harbour"},{"name":"Letitia Wright"},{"name":"Lewis Pullman"},{"name":"Kelsey Grammer"},{"name":"Kathryn Newton"},{"name":"Danny Ramirez"},{"name":"Winston Duke"},{"name":"Alan Cumming"},{"name":"Hannah John-Kamen"},{"name":"Rebecca Romijn"},{"name":"Mabel Cadena"},{"name":"Tenoch Huerta Mej\u00eda"},{"name":"Wesley Holloway"},{"name":"Alex Livinalli"},{"name":"India Rose Hemsworth"},{"name":"Matilda Firth"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/avengers-doomsday-111173.v17916234067109.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=IXoUkkzkvLc"}]}},{"name":"Berliner Philharmoniker: Silvesterkonzert 2026\/27","beginning":"2026-12-31T17:00:00+01:00","urlSlug":"6ac687ad0f6803018ffa702f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=AB276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"103385","title":"Berliner Philharmoniker: Silvesterkonzert 2026","titleOriginal":"Berliner Philharmoniker: Silvesterkonzert 2026","urlSlug":"die-berliner-philharmoniker-live-das-silvesterkonzert-2026-27","duration":120,"productionYear":null,"description":"Kann \u00bbernste Musik\u00ab humorvoll sein? Unbedingt! Das zeigen die Berliner Philharmoniker und Chefdirigent Kirill Petrenko im Silvesterkonzert 2026: In seiner spritzigen Symphonie classique parodiert Sergej Prokofjew die Musik Haydns und Mozarts. Wiener Klassik hatte auch Dmitri Schostakowitsch im Ohr, als er sein gewitztes Doppelkonzert f\u00fcr Klavier und Trompete schrieb. An der Seite von Solotrompeter David Guerrier deb\u00fctiert hier der 2001 geborene Pianist Alexander Malofeev. Kirill Petrenko entfacht zudem ein Feuerwerk des Schabernacks mit Till Eulenspiegels lustige Streiche von Richard Strauss. Erleben Sie diesen schwungvollen Jahreswechsel live im Kino!","contentRating":{"minimumAge":6},"productionCountries":[],"genres":[{"name":"Konzert"}],"directors":[{"name":"Kirill Petrenko"}],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-berliner-philharmoniker-live-das-silvesterkonzert-2026-27-103385.v17824354435916.jpg"},"trailers":[]}},{"name":"Met Opera 2026\/27: Giacomo Puccini LA FANCIULLA DEL WEST","beginning":"2027-01-23T19:00:00+01:00","urlSlug":"6ac687c40f6803018ffa7072","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=5E276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"100839","title":"MET 2026\/27 Giacomo Puccini: LA FANCIULLA DEL WEST","titleOriginal":"MET 2026\/27 Giacomo Puccini: La fanciulla del west","urlSlug":"la-fanciulla-del-west-puccini-met-2026-27","duration":null,"productionYear":"2026","description":"An Silvester 2026 kehrt Puccinis mitrei\u00dfendes Drama aus dem Wilden Westen in einer neuen Inszenierung des renommierten britischen Regisseurs Richard Jones zur\u00fcck \u2013 die erste Neuproduktion von \u201eLa Fanciulla del West\u201c des Ensembles seit mehr als 30 Jahren. Die Sopranistin Vida Miknevi\u010di\u016bt\u0117 gibt ihr bedeutendes Met-Deb\u00fct als die \u00fcberlebensgro\u00dfe Minnie, die toughe Tavernenbesitzerin mit dem Herzen aus Gold, die die Liebe findet, als sie es am wenigsten erwartet. Tenor SeokJong Baek ist der schneidige Bandit, der in die abgelegene kalifornische Bergbaustadt streift, um ihr Herz zu stehlen, w\u00e4hrend Bariton Christopher Maltman als Gesetzesh\u00fcter auftritt, der entschlossen ist, harte Gerechtigkeit walten zu lassen \u2013 und Minnie f\u00fcr sich zu gewinnen. Maestro Keri-Lynn Wilson steht am Pult, um eines der actionreichsten Abenteuer der Oper zu dirigieren.\r\n","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Oper"},{"name":"Special Event"}],"directors":[{"name":"Richard Jones"}],"actors":[{"name":"Keri-Lynn Wilson"},{"name":"SeokJong Baek"},{"name":"Christopher Maltman"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/met-2026-27-giacomo-puccini-la-fanciulla-del-west-100839.v17803144649065.webp"},"trailers":[]}},{"name":"RBO Live 2026\/27: G\u00f6tterd\u00e4mmerung (Royal Opera)","beginning":"2027-02-03T17:45:00+01:00","urlSlug":"6ac687d20f6803018ffa7086","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=72476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101085","title":"RBO 2026\/27: G\u00f6tterd\u00e4mmerung (The Royal Opera)","titleOriginal":"Royal Ballet & Opera 2026\/27: G\u00f6tterd\u00e4mmerung","urlSlug":"rbo-goetterdaemmerung-royal-opera-live","duration":370,"productionYear":null,"description":"Eine Welt in Tr\u00fcmmern. Der Untergang der G\u00f6tter.  T\u00e4uschung f\u00fchrt zu Verrat und Verheerung, als Siegfried durch einen Trick dazu gebracht wird, Br\u00fcnnhilde zu verraten. Als sie von der Unschuld ihres Liebsten erf\u00e4hrt, gibt Br\u00fcnnhilde den Ring endlich den Rheint\u00f6chtern zur\u00fcck. Dann befiehlt sie, dass Walhalla von den Flammen verschlungen werden m\u00f6ge. F\u00fcr das lang ersehnte Finale Wagners epischer Sage platziert Regisseur Barrie Kosky das \u00fcppige apokalyptische Drama in der heutigen Zeit voller traum\u00e4hnlicher Turbulenzen. Antonio Pappano, Ehrendirigent der Royal Opera, kehrt zur\u00fcck und widmet sich der leidenschaftlichen, entr\u00fcckten Partitur \u2013 darunter Siegfrieds Trauermarsch und Br\u00fcnnhildes elektrisierende Opferszene. Das brillante Ensemble wird angef\u00fchrt von Elisabet Strid, Andreas Schager und Mika Kares, die mit der vollen Kraft des Orchestra of the Royal Opera House und dem Royal Opera Chorus diese Oper an ihr niederschmetterndes Ende f\u00fchren.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-2026-27-goetterdaemmerung-the-royal-opera-101085.v17810644274089.jpg"},"trailers":[]}},{"name":"RBO Live 2026\/27: Cos\u00ed fan tutte (Royal Opera)","beginning":"2027-02-23T19:45:00+01:00","urlSlug":"6ac687d20f6803018ffa7085","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=82476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"100841","title":"RBO 2026\/27: Cos\u00ec fan tutte (The Royal Opera)","titleOriginal":"Royal Ballet & Opera 2026\/27: Cos\u00ec fan tutte","urlSlug":"cosi-fan-tutte-mozart-met-2026-27","duration":195,"productionYear":"2026","description":"Angetrieben von einer Wette schmieden zwei junge M\u00e4nner einen Plan, um die Treue ihrer Freundinnen auf die Probe zu stellen. Was folgt, ist ein raffiniertes Spiel aus Verf\u00fchrung und Macht: Die vier Liebenden geraten in einen Strudel aus wechselnden Rollen und unsicheren Wahrheiten, in dem Realit\u00e4t und T\u00e4uschung immer st\u00e4rker verschwimmen.","contentRating":null,"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Oper"},{"name":"Klassisches Konzert"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-cosi-fan-tutte-royal-opera-live-100841.v17810120713635.jpg"},"trailers":[]}},{"name":"RBO 2026\/27: Alice im Wunderland (Royal Ballet)","beginning":"2027-03-28T17:00:00+02:00","urlSlug":"6ac687d10f6803018ffa7081","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=92476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101063","title":"RBO Live 2026\/27: Alice im Wunderland (Royal Ballet)","titleOriginal":"Royal Ballet & Opera - Alice's Adventures in Wonderland (2027)","urlSlug":"rbo-live-2026-27-alice-im-wunderland-royal-ballet","duration":170,"productionYear":"2026","description":"Bei einer Gartenparty an einem sonnigen Nachmittag ist Alice \u00fcberrascht, als sich Lewis Carroll, ein Freund ihrer Eltern, in ein wei\u00dfes Kaninchen verwandelt. Als sie ihm in den Kaninchenbau folgt, werden die Ereignisse immer seltsamer. Auf ihrer Reise durch das Wunderland begegnet Alice unz\u00e4hligen seltsamen Kreaturen. Verwirrung jagt Verwirrung. Dann erwacht Alice mit einem Ruck. War das alles nur ein Tagtraum?\r\n\r\nChristopher Wheeldons Alice Im Wunderland feierte 2011 ein rauschendes Deb\u00fct mit einem Feuerwerk an Farben, B\u00fchnenzauber und einer einfallsreichen wie anspruchsvollen Choreografie. Joby Talbots Partitur vereint zeitgen\u00f6ssische Klangwelten mit Melodien, die einen Fingerzeig auf die gro\u00dfen Ballett-Partituren des 19. Jahrhunderts richten. Bob Crowleys fantasievolle wie faszinierende Inszenierung f\u00e4hrt gro\u00df auf, von Marionettenspiel bis zu Projektionen, um das Wunderland wunderbar echt werden zu lassen. Folglich zeigt sich das Royal Ballet in Bestform und f\u00fchrt Weltklasse-Tanz mit verzaubernder Familienunterhaltung zusammen \u2013 ein wahres Fest der Musik und Inszenierung.\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Tanz"}],"directors":[],"actors":[{"name":"The Royal Ballet"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-live-2026-27-alice-im-wunderland-royal-ballet-101063.v17798680513996.png"},"trailers":[]}},{"name":"Met Opera 2026\/27: Jules Massenet MANON","beginning":"2027-04-03T18:00:00+02:00","urlSlug":"6acb1028026bf6041eaa4eb2","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=0E276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99705","title":"MET 2026\/27 Giuseppe Verdi: OTELLO","titleOriginal":"MET 2026\/27 Giuseppe Verdi: Otello ","urlSlug":"otello-verdi-met-2026-27","duration":210,"productionYear":"2026","description":"Zwei der derzeit f\u00fchrenden dramatischen Ten\u00f6re \u2013 Michael Fabiano und Brian Jagde \u2013 \u00fcbernehmen die anspruchsvolle Titelrolle in dem Werk, das viele als die ultimative italienische Oper betrachten: Verdis monumentale Shakespeare-Trag\u00f6die. Die beliebten Sopranistinnen Angel Blue und Ailyn P\u00e9rez geben ihr Deb\u00fct in dieser Rolle als die leidgepr\u00fcfte Desdemona, an ihrer Seite die Baritone Amartuvshin Enkhbat und Artur Ruci\u0144ski als der finstere Iago. Daniele Rustioni und Michele Mariotti leiten das gesamte Orchester und den Chor der Met in dieser mitrei\u00dfenden Partitur.\r\n","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Oper"},{"name":"Special Event"}],"directors":[{"name":"Bartlett Sher"}],"actors":[{"name":"Daniele Rustioni"},{"name":"Michele Mariotti"},{"name":"Angel Blue"},{"name":"Ailyn P\u00e9rez"},{"name":"Jennifer Johnson Cano"},{"name":"Deborah Nansteel"},{"name":"Michael Fabiano"},{"name":"Brian Jagde"},{"name":"Piotr Buszewski"},{"name":"Amartuvshin Enkhbat"},{"name":"Artur Rucinski"},{"name":"Vitalij Kowaljow"},{"name":"Yongzhao Yu"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/met-2026-27-giuseppe-verdi-otello-99705.v17803146058602.jpg"},"trailers":[]}},{"name":"RBO Live 2026\/27: Schwanensee (Royal Ballet)","beginning":"2027-04-22T20:15:00+02:00","urlSlug":"6acb1012026bf6041eaa4eb1","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=A2476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101245","title":"RBO 2026\/27: Schwanensee (The Royal Ballet)","titleOriginal":"Royal Ballet & Opera 2026\/27: Swan Lake","urlSlug":"rbo-schwanensee-royal-ballet-live","duration":180,"productionYear":"2026","description":"Prinzessin Odette ist einem Fluch erlegen und wurde vom b\u00f6sen Zauberer Rotbart in einen Schwan verwandelt. Dieser Fluch kann nur durch ein Versprechen ewiger Liebe gebrochen werden. Als sie auf Prinz Siegfried trifft, verf\u00e4llt dieser auf der Stelle ihrer Sch\u00f6nheit und schw\u00f6rt, sie zu befreien. Doch Odettes Freiheit ist alles andere als sicher, da Rotbart beabsichtigt, die Pl\u00e4ne der Liebenden zu durchkreuzen.","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Opera"}],"directors":[],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-2026-27-schwanensee-the-royal-ballet-101245.v17800277070632.jpg"},"trailers":[]}},{"name":"Met Opera 2026\/27: Giuseppe Verdi OTELLO","beginning":"2027-04-24T19:00:00+02:00","urlSlug":"6ac687c70f6803018ffa7073","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=FD276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"61003","title":"The Metropolitan Opera: Il Barbiere di Siviglia","titleOriginal":"The Metropolitan Opera: Il Barbiere di Siviglia","urlSlug":"met-rossini-il-barbiere-di-siviglia","duration":205,"productionYear":"2025","description":"Liebe, List und L\u00fcge. Daraus schuf Rossini ein Meisterwerk voller Lebendigkeit, Situationskomik und musikalischem Witz. Die Geschichte um den ber\u00fchmtesten Friseur aller Zeiten gilt als ein Hauptwerk der opera buffa. Die f\u00fcr ihre zahlreichen Ohrw\u00fcrmer ber\u00fchmte Oper bietet Aigul Akhmetshina Gelegenheit zu zeigen, dass sie nicht nur in ihrer Paraderolle Carmen gl\u00e4nzt, sondern auch \u00fcber ein umwerfendes kom\u00f6diantisches Talent verf\u00fcgt.","contentRating":null,"productionCountries":[{"name":"United States"}],"genres":[{"name":"Musik"}],"directors":[{"name":"Bartlett Sher"}],"actors":[{"name":"Aigul Akhmetshina"},{"name":"Jack Swanson"},{"name":"Andrey Zhilikhovsky"},{"name":"Peter K\u00e1lm\u00e1n"},{"name":"Alexander Vinogradov"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/met-opera-il-barbiere-di-siviglia-61003.v17179927439262.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=OogIx4GcMJg"}]}},{"name":"RBO Live 2026\/27: Tosca (Royal Opera)","beginning":"2027-05-05T20:00:00+02:00","urlSlug":"6acb1012026bf6041eaa4eb0","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=B2476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101073","title":"RBO Live 2026\/27: Tosca (Royal Opera)","titleOriginal":"Royal Ballet & Opera -Tosca (2027)","urlSlug":"rbo-live-2026-27-tosca-royal-opera","duration":195,"productionYear":"2026","description":"Floria Tosca und Mario Cavaradossi haben einander und ihr Leben der Kunst verschrieben. Doch als Cavaradossi einem fl\u00fcchtigen Str\u00e4fling hilft, macht sich das Liebespaar den Polizeichef Baron Scarpia zum Feind. Scarpias obsessive Begierden vollends ausgeliefert, muss sich Tosca auf einen schrecklichen Handel einlassen: Mit dem Mann zu schlafen, den sie hasst, um den Mann, den sie liebt, zu retten. Finden sie in aller Not einen Ausweg?\r\nOliver Mears\u2019 gefeierte Produktion kehrt zur\u00fcck und holt Puccinis Opern-Thriller in einem vom Krieg gezeichneten Rom in die heutige Zeit. Daniel Oren dirigiert Aleksandra Kurzak, die erneut die Titelrolle interpretiert und im Wechselspiel mit Saimir Pirgu als Cavaradossi und Christopher Maltman als Baron Scarpia brilliert.\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Opera"}],"directors":[],"actors":[{"name":"The Royal Ballet"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-live-2026-27-tosca-royal-opera-101073.v17798729538616.png"},"trailers":[]}},{"name":"RBO 2026\/27: Romeo und Julia (Royal Ballet)","beginning":"2027-05-30T17:00:00+02:00","urlSlug":"6ac687d10f6803018ffa7082","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=C2476000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101023","title":"RBO 2026\/27: Romeo und Julia (The Royal Ballet)","titleOriginal":"Royal Ballet & Opera 2026\/27: Romeo and Juliet","urlSlug":"rbo-live-2026-27-romeo-und-julia-royal-ballet-6a151d498d76c","duration":150,"productionYear":"2026","description":"Shakespeare zeitlose Geschichte \u00fcber die Liebe unter einem schlechten Stern wird in Kenneth MacMillans Interpretation in ein hypnotisierendes Ballett-Opus verwandelt. Die aufkeimende junge Liebe ist sowohl bei Romeo und Julias Begegnung in der Balkonszene greifbar als auch w\u00e4hrend ihrer letzten Augenblicke, als sie im Grab verzweifelt um ihr Leben ringen. Prokofjews bewegende Partitur bereitet den heimlichen romantischen Momenten und t\u00f6dlichen K\u00e4mpfen eine w\u00fcrdige B\u00fchne, auf der das Ballett seinem unausweichlichen wie tragischen Ende entgegengeht.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Opera"}],"directors":[],"actors":[{"name":"The Royal Ballet"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/rbo-live-2026-27-romeo-und-julia-royal-ballet-101023.v17828787322018.jpg"},"trailers":[]}},{"name":"Met Opera 2026\/27: Richard Wagner PARSIFAL","beginning":"2027-06-05T18:00:00+02:00","urlSlug":"6ac687cf0f6803018ffa7075","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=DD276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"22645","title":"The Metropolitan Opera: Lohengrin ","titleOriginal":"The Metropolitan Opera: Lohengrin","urlSlug":"met-opera-lohengrin-2023","duration":295,"productionYear":null,"description":"In einer stimmungsvollen Neuinszenierung verbindet Regisseur Fran\u00e7ois Girard seinen markanten visuellen Stil und sein dramatisches Verst\u00e4ndnis mit Wagners \u00fcberw\u00e4ltigender Musik.","contentRating":null,"productionCountries":[],"genres":[{"name":"Musik"}],"directors":[{"name":"Fran\u00e7ois Girard"}],"actors":[{"name":"Piotr Becza\u0142a"},{"name":"Tamara Wilson"},{"name":"Christine Goerke"},{"name":"Evgeny Nikitin"},{"name":"G\u00fcnther Groissb\u00f6ck"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/met-opera-lohengrin-2023-22645.v159.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=dLpFcocpou4"}]}}]}}}