lug":"casablanca-filmtheater","city":{"urlSlug":"bochum"}},"movie":{"id":"97093","title":"Alte Liebe","titleOriginal":"Alte Liebe","urlSlug":"alte-liebe-","duration":111,"productionYear":"2026","description":"Lore (Dagmar Manzel) und Harry (Joachim Kr\u00f3l) sind seit fast 40 Jahren verheiratet \u2013 und streiten mindestens genauso lange. W\u00e4hrend Harry nach seiner Pensionierung von einem ruhigen Leben tr\u00e4umt, f\u00fcrchtet Lore, im Alltag und Garten festzustecken. Alte Konflikte und unerf\u00fcllte W\u00fcnsche sorgen immer wieder f\u00fcr Spannungen. Als ihre Tochter Gloria zum dritten Mal heiraten will \u2013 ausgerechnet einen wohlhabenden Mann, der fast Harrys Alter hat \u2013, ger\u00e4t das Familienleben endg\u00fcltig aus dem Gleichgewicht.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Andreas Dresen"}],"actors":[{"name":"Dagmar Manzel"},{"name":"Joachim Kr\u00f3l"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/alte-liebe-97093.v17845368285016.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=rEQxPVhgz0I"}]}},{"name":"Pans Labyrinth","beginning":"2026-10-16T22:30:00+02:00","urlSlug":"6a43402bfad77a2813d4c27d","deeplink":"https:\/\/kinotickets.express\/bochum-casablanca\/booking\/58671","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Casablanca"},"cinema":{"urlSlug":"casablanca-filmtheater","city":{"urlSlug":"bochum"}},"movie":{"id":"50429","title":"Pans Labyrinth ","titleOriginal":"El laberinto del fauno","urlSlug":"pans-labyrinth","duration":112,"productionYear":"2006","description":"Spanien, 1944: Nach der Machtergreifung General Francos zieht die kleine Ofelia zusammen mit ihrer hochschwangeren Mutter zu ihrem Stiefvater aufs Land und wird dort schon bald mit dessen Unberechenbarkeit und Brutalit\u00e4t konfrontiert. Ihre einzige Chance ist die Flucht in eine selbst erschaffene, geheimnisvolle Fantasiewelt, die von wundersamen Fabelwesen bev\u00f6lkert ist. Nur hier findet das M\u00e4dchen Zuflucht vor dem Schrecken der Realit\u00e4t, aber nach und nach auch den Mut, diesem zu trotzen.","contentRating":{"minimumAge":16},"productionCountries":[{"name":"Spain"},{"name":"Mexico"},{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Fantasy"},{"name":"Kriegsfilm"}],"directors":[{"name":"Guillermo del Toro"}],"actors":[{"name":"Ivana Baquero"},{"name":"Sergi L\u00f3pez"},{"name":"Doug Jones"},{"name":"Maribel Verd\u00fa"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/pans-labyrinth-5042916939009581693900959.v17289675318060.jpg"},"trailers":[]}},{"name":"Pans Labyrinth","beginning":"2026-10-17T22:30:00+02:00","urlSlug":"6a43402bfad77a2813d4c27e","deeplink":"https:\/\/kinotickets.express\/bochum-casablanca\/booking\/58672","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Casablanca"},"cinema":{"urlSlug":"casablanca-filmtheater","city":{"urlSlug":"bochum"}},"movie":{"id":"50429","title":"Pans Labyrinth ","titleOriginal":"El laberinto del fauno","urlSlug":"pans-labyrinth","duration":112,"productionYear":"2006","description":"Spanien, 1944: Nach der Machtergreifung General Francos zieht die kleine Ofelia zusammen mit ihrer hochschwangeren Mutter zu ihrem Stiefvater aufs Land und wird dort schon bald mit dessen Unberechenbarkeit und Brutalit\u00e4t konfrontiert. Ihre einzige Chance ist die Flucht in eine selbst erschaffene, geheimnisvolle Fantasiewelt, die von wundersamen Fabelwesen bev\u00f6lkert ist. Nur hier findet das M\u00e4dchen Zuflucht vor dem Schrecken der Realit\u00e4t, aber nach und nach auch den Mut, diesem zu trotzen.","contentRating":{"minimumAge":16},"productionCountries":[{"name":"Spain"},{"name":"Mexico"},{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Fantasy"},{"name":"Kriegsfilm"}],"directors":[{"name":"Guillermo del Toro"}],"actors":[{"name":"Ivana Baquero"},{"name":"Sergi L\u00f3pez"},{"name":"Doug Jones"},{"name":"Ma