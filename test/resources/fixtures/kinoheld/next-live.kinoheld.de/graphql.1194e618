ame":"Mercedes Hern\u00e1ndez"},{"name":"Danny Kirrane"},{"name":"James Dryden"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/digger-96021.v17885811357140.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=qU-7KUMw-tk"}]}},{"name":"Toy Story 5","beginning":"2026-10-14T14:00:00+02:00","urlSlug":"6ac687ac0f6803018ffa7027","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=46086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"89785","title":"Toy Story 5","titleOriginal":"Toy Story 5","urlSlug":"toy-story-5","duration":90,"productionYear":"2026","description":"Die Aufgaben von Buzz, Woody, Jessie und Co. werden immer schwieriger, wenn sie es mit einer ganz neuen Bedrohung der Spielzeit zu tun bekommen: der Technik.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Familie"}],"directors":[{"name":"Andrew Stanton"}],"actors":[{"name":"Tom Hanks"},{"name":"Tim Allen"},{"name":"Joan Cusack"},{"name":"Greta Lee"},{"name":"Craig Robinson"},{"name":"Anna Faris"},{"name":"Tony Hale"},{"name":"Jay Hernandez"},{"name":"Lori Alan"},{"name":"Bonnie Hunt"},{"name":"Kristen Schaal"},{"name":"Wallace Shawn"},{"name":"John Ratzenberger"},{"name":"Blake Clark"},{"name":"Ernie Hudson"},{"name":"Jeff Garlin"},{"name":"Melissa Villase\u00f1or"},{"name":"Timothy Dalton"},{"name":"Jeff Pidgeon"},{"name":"Conan O'Brien"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/toy-story-5-89785.v17706383471510.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=QasqRjb5jV4"}]}},{"name":"Die Odyssee","beginning":"2026-10-14T14:00:00+02:00","urlSlug":"6ac687940f6803018ffa6f92","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=00186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99061","title":"Die Odyssee","titleOriginal":"The Odyssey","urlSlug":"die-odyssee-2026","duration":172,"productionYear":"2026","description":"Nach dem Trojanischen Krieg will Odysseus mit seinen Gef\u00e4hrten nach Ithaka zur\u00fcckkehren. Doch die Heimfahrt \u00fcber das Mittelmeer wird zu einer jahrelangen Irrfahrt: St\u00fcrme bringen ihre Schiffe vom Kurs ab, und auf dem Weg begegnen ihnen der Zyklop Polyphem und weitere gef\u00e4hrliche Wesen. W\u00e4hrend Odysseus um seine R\u00fcckkehr k\u00e4mpft, bedr\u00e4ngen in Ithaka Freier seine Frau Penelope und wollen die Herrschaft an sich bringen. Sein Sohn Telemachos macht sich auf die Suche nach dem vermissten Vater.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Christopher Nolan"}],"actors":[{"name":"Matt Lasky"},{"name":"Matt Damon"},{"name":"Tom Holland"},{"name":"Anne Hathaway"},{"name":"Robert Pattinson"},{"name":"Lupita Nyong'o"},{"name":"Charlize Theron"},{"name":"Zendaya"},{"name":"Benny Safdie"},{"name":"Jon Bernthal"},{"name":"John Leguizamo"},{"name":"Himesh Patel"},{"name":"Mia Goth"},{"name":"Will Yun Lee"},{"name":"Jimmy Gonzales"},{"name":"Elliot Page"},{"name":"Bill Irwin"},{"name":"Samantha Morton"},{"name":"Jesse Garcia"},{"name":"Rafi Gavron"},{"name":"Shiloh Fernandez"},{"name":"Corey Hawkins"},{"name":"Nick E. Tarabay"},{"name":"Maurice Compte"},{"name":"Michael Vlamis"},{"name":"Iddo Goldberg"},{"name":"Josh Stewart"},{"name":"Ryan Hurst"},{"name":"Anthony Molinari"},{"name":"Jovan Adepo"},{"name":"Logan Marshall-Green"},{"name":"James Remar"},{"name":"Travis Scott"},{"name":"Douglas Rouillard"},{"name":"Jorge L\u00e9on"},{"name":"Andrei Lenart"},{"name":"Kamden Riley"},{"name":"Ryan de Quintal"},{"name":"Jarreth J. Merz"},{"name":"Markie Farnsley"},{"name":"Stephen Murphy"},{"name":"Adam Croasdell"},{"name":"Jamie Harris"},{"name":"Niko Nicotera"},{"name":"Elyes Gabel"},{"name":"Sean Avery"},{"name":"Andrew Howard"},{"name":"Lupita Nyong\u2019o"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-odyssee-99061.v17811615267007.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=skiD2oYeCJY"},{"url":"https:\/\/www.youtube.com\/watch?v=1Js6B0_1-v4"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-14T14:00:00+02:00","urlSlug":"6ac6878b0f6803018ffa6f5c","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=1A186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Forgotten Island","beginning":"2026-10-14T14:00:00+02:00","urlSlug":"6ac687640f6803018ffa6e5c","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=02186000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"3d"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T14:10:00+02:00","urlSlug":"6ac687730f6803018ffa6ed9","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=B9086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Coyote vs. ACME","beginning":"2026-10-14T14:15:00+02:00","urlSlug":"6ac6878d0f6803018ffa6f6e","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=6B086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"104859","title":"Coyote vs. ACME","titleOriginal":"Coyote vs. Acme","urlSlug":"coyote-vs-acme","duration":101,"productionYear":"2026","description":"Nach all den Jahren vergeblicher Liebesm\u00fch hat Willi Kojote es satt, dass bisher jedes einzelne Produkt der ACME Corporation eine erfolgreiche Jagd auf den Road Runner vereitelt hat. Kojote beschlie\u00dft deshalb, das Unternehmen f\u00fcr seine mangelhafte Ware in die Verantwortung zu nehmen, und engagiert den ebenso gl\u00fcck- wie mittellosen Anwalt Kevin Avery (Will Forte), um gegen ACME vor Gericht zu ziehen. Als der herausfindet, dass die Rechtsabteilung des Konzerns von Buddy Crane (John Cena) geleitet wird, dem selbstgef\u00e4lligen Chef seiner ehemaligen Kanzlei, gibt er alles, um den Prozess zu gewinnen.\r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Abenteuer"},{"name":"Familie"}],"directors":[{"name":"Dave Green"}],"actors":[{"name":"Will Forte"},{"name":"Lana Condor"},{"name":"John Cena"},{"name":"Tone Bell"},{"name":"Eric Bauza"},{"name":"P.J. Byrne"},{"name":"Martha Kelly"},{"name":"Luis Guzm\u00e1n"},{"name":"Kenneth Choi"},{"name":"John Early"},{"name":"Jeff Bergman"},{"name":"Candi Milo"},{"name":"Nancy Linehan Charles"},{"name":"Ernie Vigil"},{"name":"Jim Cummings"},{"name":"Amy Rauch"},{"name":"Hayes Hargrove"},{"name":"Phuong Kubacki"},{"name":"Dani Payne"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/coyote-vs-acme-104859.v17866992587547.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=DvY-U39fyrM"}]}},{"name":"Das gewisse Etwas","beginning":"2026-10-14T14:15:00+02:00","urlSlug":"6ac6878f0f6803018ffa6f7e","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=D0186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91757","title":"Das gewisse Etwas","titleOriginal":"Das gewisse Etwas","urlSlug":"das-gewisse-etwas","duration":105,"productionYear":"2026","description":"Nach einem Juwelenraub verstecken sich Alex (Max von der Groeben) und sein Vater Karlo (Florian Lukas) ausgerechnet bei einer Gruppe junger Erwachsener mit Beeintr\u00e4chtigung, die mit ihren Betreuenden (Mala Emde, Jasmin Schwiers, Lorenzo Germeno) gerade in den Sommerurlaub aufbrechen. Die beiden Ganoven geben sich kurzerhand als der fehlende Mitreisende Otto und dessen Betreuer aus \u2013 eine fast perfekte Tarnung. Mit der Flucht vor der Polizei beginnt ein au\u00dfergew\u00f6hnliches Abenteuer, das allen Beteiligten nicht nur ungeahnte Herausforderungen beschert, sondern auch jede Menge Spa\u00df, gro\u00dfe Gef\u00fchle \u2013 und eine neue Sicht auf das Leben! \r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Marc Rothemund"}],"actors":[{"name":"Mala Emde"},{"name":"Max von der Groeben"},{"name":"Florian Lukas"},{"name":"Lorenzo Germeno"},{"name":"Jasmin Schwiers"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-gewisse-etwas-91757.v17891408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T14:15:00+02:00","urlSlug":"6ac687840f6803018ffa6f2f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=83186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-14T14:15:00+02:00","urlSlug":"6ac6879e0f6803018ffa6fd1","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=A4186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Paw Patrol: Der Dino Film","beginning":"2026-10-14T14:20:00+02:00","urlSlug":"6ac687a30f6803018ffa6ff7","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=9F086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"100821","title":"Paw Patrol: Der Dino Film","titleOriginal":"Paw Patrol 3","urlSlug":"paw-patrol-der-dino-film-3","duration":83,"productionYear":"2026","description":"Nach einem Sturm landet die Paw Patrol auf einer geheimnisvollen Dinosaurierinsel, wo sie den gestrandeten Welpen Rex trifft. Als Humdinger mit seinem r\u00fccksichtslosen Bergbau einen Vulkan zum Ausbruch bringt, steht das Team vor seiner bislang gr\u00f6\u00dften Rettungsmission: Es muss die Insel und ihre Bewohner vor der Katastrophe bewahren.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Canada"},{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Cal Brunker"}],"actors":[{"name":"Carter Young"},{"name":"Hayden Chamberlen"},{"name":"Mckenna Grace"},{"name":"Rain Janjua"},{"name":"Henry Bolan"},{"name":"Lucien Duncan-Reid"},{"name":"Nylan Parthipan"},{"name":"William Desrosiers"},{"name":"Jennifer Hudson"},{"name":"Fortune Feimster"},{"name":"Jameela Jamil"},{"name":"Terry Crews"},{"name":"Paris Hilton"},{"name":"Snoop Dogg"},{"name":"Bill Nye"},{"name":"Meredith MacNeill"},{"name":"Ron Pardo"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/paw-patrol-der-dino-film-100821.v17833263332096.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=OHGIHaDxYy8"}]}},{"name":"Resident Evil","beginning":"2026-10-14T14:30:00+02:00","urlSlug":"6ac6877f0f6803018ffa6f0f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=95186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"Spa Weekend","beginning":"2026-10-14T14:30:00+02:00","urlSlug":"6ac687a70f6803018ffa700f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=4B186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"103321","title":"Spa Weekend","titleOriginal":"Spa Weekend","urlSlug":"spa-weekend-","duration":100,"productionYear":"2026","description":"SPA WEEKEND ist eine bissige und freche Female-Buddy-Kom\u00f6die \u00fcber vier Freundinnen, die sich ein entspanntes Wellness-Wochenende in Palm Springs g\u00f6nnen wollen. Sonne, Spa, Sekt \u2013 alles soll relaxt und harmonisch sein. Im Mittelpunkt des Films stehen Jane, Coco und Sophie \u2013 doch als ihre unberechenbare Freundin Mel auftaucht, entwickelt sich die geplante Auszeit zu einem turbulenten Abenteuer und schnell wird klar: Dieser Luxus-Trip wird alles andere als erholsam. Was folgt, ist ein chaotisches Wochenende voller Missverst\u00e4ndnisse, verletzter Egos und \u00fcberraschender Wahrheiten. Ihre Freundschaft wird auf die Probe gestellt \u2013 bis zum unvermeidlichen Breakdown.\r\n\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Australia"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Jon Lucas"},{"name":"Scott Moore"}],"actors":[{"name":"Leslie Mann"},{"name":"Isla Fisher"},{"name":"Michelle Buteau"},{"name":"Anna Faris"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/spa-weekend-103321.v17823507842935.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=UObKFaw5SJc"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-14T14:50:00+02:00","urlSlug":"6ac687780f6803018ffa6eed","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=B6086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T16:30:00+02:00","urlSlug":"6ac687840f6803018ffa6f30","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=77186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Die Odyssee","beginning":"2026-10-14T16:40:00+02:00","urlSlug":"6ac687940f6803018ffa6f94","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=98186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99061","title":"Die Odyssee","titleOriginal":"The Odyssey","urlSlug":"die-odyssee-2026","duration":172,"productionYear":"2026","description":"Nach dem Trojanischen Krieg will Odysseus mit seinen Gef\u00e4hrten nach Ithaka zur\u00fcckkehren. Doch die Heimfahrt \u00fcber das Mittelmeer wird zu einer jahrelangen Irrfahrt: St\u00fcrme bringen ihre Schiffe vom Kurs ab, und auf dem Weg begegnen ihnen der Zyklop Polyphem und weitere gef\u00e4hrliche Wesen. W\u00e4hrend Odysseus um seine R\u00fcckkehr k\u00e4mpft, bedr\u00e4ngen in Ithaka Freier seine Frau Penelope und wollen die Herrschaft an sich bringen. Sein Sohn Telemachos macht sich auf die Suche nach dem vermissten Vater.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Christopher Nolan"}],"actors":[{"name":"Matt Lasky"},{"name":"Matt Damon"},{"name":"Tom Holland"},{"name":"Anne Hathaway"},{"name":"Robert Pattinson"},{"name":"Lupita Nyong'o"},{"name":"Charlize Theron"},{"name":"Zendaya"},{"name":"Benny Safdie"},{"name":"Jon Bernthal"},{"name":"John Leguizamo"},{"name":"Himesh Patel"},{"name":"Mia Goth"},{"name":"Will Yun Lee"},{"name":"Jimmy Gonzales"},{"name":"Elliot Page"},{"name":"Bill Irwin"},{"name":"Samantha Morton"},{"name":"Jesse Garcia"},{"name":"Rafi Gavron"},{"name":"Shiloh Fernandez"},{"name":"Corey Hawkins"},{"name":"Nick E. Tarabay"},{"name":"Maurice Compte"},{"name":"Michael Vlamis"},{"name":"Iddo Goldberg"},{"name":"Josh Stewart"},{"name":"Ryan Hurst"},{"name":"Anthony Molinari"},{"name":"Jovan Adepo"},{"name":"Logan Marshall-Green"},{"name":"James Remar"},{"name":"Travis Scott"},{"name":"Douglas Rouillard"},{"name":"Jorge L\u00e9on"},{"name":"Andrei Lenart"},{"name":"Kamden Riley"},{"name":"Ryan de Quintal"},{"name":"Jarreth J. Merz"},{"name":"Markie Farnsley"},{"name":"Stephen Murphy"},{"name":"Adam Croasdell"},{"name":"Jamie Harris"},{"name":"Niko Nicotera"},{"name":"Elyes Gabel"},{"name":"Sean Avery"},{"name":"Andrew Howard"},{"name":"Lupita Nyong\u2019o"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-odyssee-99061.v17811615267007.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=skiD2oYeCJY"},{"url":"https:\/\/www.youtube.com\/watch?v=1Js6B0_1-v4"}]}},{"name":"Spider-Man: Brand New Day","beginning":"2026-10-14T16:50:00+02:00","urlSlug":"6ac687aa0f6803018ffa701d","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=97086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"67487","title":"Spider-Man: Brand New Day","titleOriginal":"Spider-Man 4","urlSlug":"spider-man-brand-new-day","duration":146,"productionYear":"2026","description":"Vier Jahre sind seit den Ereignissen von \u201eNo Way Home\u201c vergangen. Peter ist nun erwachsen und lebt f\u00fcr sich allein, nachdem er sich freiwillig aus dem Leben und den Erinnerungen derer, die er liebt, ausgel\u00f6scht hat. Er bek\u00e4mpft Verbrechen in einem New York, das ihn und seinen Namen nicht mehr kennt, und widmet sich ganz dem Schutz seiner Stadt: Spider-Man in Vollzeit. Doch mit den steigenden Anforderungen l\u00f6st der Druck eine \u00fcberraschende k\u00f6rperliche Ver\u00e4nderung aus, die seine Existenz bedroht \u2013 gerade als eine seltsame neue Art von Verbrechen eine der m\u00e4chtigsten Bedrohungen hervorbringt, denen er je gegen\u00fcberstand.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Destin Daniel Cretton"}],"actors":[{"name":"Tom Holland"},{"name":"Zendaya"},{"name":"Sadie Sink"},{"name":"Jacob Batalon"},{"name":"Tramell Tillman"},{"name":"Michael Mando"},{"name":"Mark Ruffalo"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/spider-man-brand-new-day-67487.v17821309559165.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=G0Nmw8LbpCk"}]}},{"name":"Alte Liebe","beginning":"2026-10-14T16:50:00+02:00","urlSlug":"6ac687880f6803018ffa6f4e","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=B8086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"97093","title":"Alte Liebe","titleOriginal":"Alte Liebe","urlSlug":"alte-liebe-","duration":111,"productionYear":"2026","description":"Lore (Dagmar Manzel) und Harry (Joachim Kr\u00f3l) sind seit fast 40 Jahren verheiratet \u2013 und streiten mindestens genauso lange. W\u00e4hrend Harry nach seiner Pensionierung von einem ruhigen Leben tr\u00e4umt, f\u00fcrchtet Lore, im Alltag und Garten festzustecken. Alte Konflikte und unerf\u00fcllte W\u00fcnsche sorgen immer wieder f\u00fcr Spannungen. Als ihre Tochter Gloria zum dritten Mal heiraten will \u2013 ausgerechnet einen wohlhabenden Mann, der fast Harrys Alter hat \u2013, ger\u00e4t das Familienleben endg\u00fcltig aus dem Gleichgewicht.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Andreas Dresen"}],"actors":[{"name":"Dagmar Manzel"},{"name":"Joachim Kr\u00f3l"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/alte-liebe-97093.v17845368285016.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=rEQxPVhgz0I"}]}},{"name":"Resident Evil","beginning":"2026-10-14T16:55:00+02:00","urlSlug":"6ac6877f0f6803018ffa6f10","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=13186000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"imax"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"Forgotten Island","beginning":"2026-10-14T17:00:00+02:00","urlSlug":"6ac687640f6803018ffa6e5d","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=29186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Eiserne Wildnis - Heart Of The Beast","beginning":"2026-10-14T17:00:00+02:00","urlSlug":"6ac6879c0f6803018ffa6fc2","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=1F086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"104697","title":"Eiserne Wildnis - Heart of the Beast","titleOriginal":"Heart of the Beast","urlSlug":"eiserne-wildnis-heart-of-the-beast","duration":101,"productionYear":"2026","description":"Nach einem Flugzeugabsturz stranden der Special-Forces-Offizier James Belmont und sein Milit\u00e4rhund Odin tief in der Wildnis Alaskas. Ohne vertraute Umgebung beginnt f\u00fcr sie ein Kampf gegen die Elemente. Um zu \u00fcberleben, m\u00fcssen Mensch und Tier zusammenhalten und sich aufeinander verlassen. Ihre enge Verbindung wird dabei auf die Probe gestellt: Gemeinsam versuchen sie, den Gefahren der Natur standzuhalten und sich in einer Lage zu behaupten, in der sie ganz auf sich gestellt sind.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Thriller"}],"directors":[{"name":"David Ayer"}],"actors":[{"name":"Brad Pitt"},{"name":"J.K. Simmons"},{"name":"Anna Lambe"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/eiserne-wildnis-heart-of-the-beast-104697.v17863488342134.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=JWjDIeEec1g&list=PLz3nyt80mNyFyNtkMADyjYzs_6AQA30iz&index=2"}]}},{"name":"Digger","beginning":"2026-10-14T17:10:00+02:00","urlSlug":"6ac687990f6803018ffa6faf","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=5D086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96021","title":"Digger","titleOriginal":"Digger","urlSlug":"digger","duration":129,"productionYear":"2026","description":"Der in die Jahre gekommene, verschrobene, milliardenschwere Erd\u00f6lmagnat Digger Rockwell (Tom Cruise) hat durch seine skrupellosen Gesch\u00e4ftstaktiken lange genug den Planeten ausgebeutet. Dadurch hat er eine Umweltkatastrophe verursacht, welche die Menschheit bedroht. Bevor die Welt im Chaos versinkt und die Apokalypse kommt, muss ein letzter Plan geschmiedet werden. Daf\u00fcr verlangt der Pr\u00e4sident der Vereinigten Staaten von Amerika (John Goodman) von Digger Rockwell, die Suppe, die er allen eingebrockt hat, selbst auszul\u00f6ffeln und die Erde zu retten. Dieser nimmt die Herausforderung an, denn als Egomane k\u00e4me es ihm ganz recht, als gro\u00dfer Retter der Menschheit dazustehen und gegen die Natur in den Krieg zu ziehen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Alejandro G. I\u00f1\u00e1rritu"}],"actors":[{"name":"Tom Cruise"},{"name":"Riz Ahmed"},{"name":"John Goodman"},{"name":"Sandra H\u00fcller"},{"name":"Michael Stuhlbarg"},{"name":"Jesse Plemons"},{"name":"Robert John Burke"},{"name":"Emma D'Arcy"},{"name":"Burn Gorman"},{"name":"Sophie Wilde"},{"name":"Pip Torrens"},{"name":"Mercedes Hern\u00e1ndez"},{"name":"Danny Kirrane"},{"name":"James Dryden"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/digger-96021.v17885811357140.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=qU-7KUMw-tk"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T17:10:00+02:00","urlSlug":"6ac687730f6803018ffa6ed8","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=2A086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-14T17:10:00+02:00","urlSlug":"6ac6879e0f6803018ffa6fd2","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=EA086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Pressure","beginning":"2026-10-14T17:10:00+02:00","urlSlug":"6ac687a50f6803018ffa6fff","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=89186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"108961","title":"Pressure","titleOriginal":"Pressure","urlSlug":"pressure-6aa7fd60c3fb2","duration":101,"productionYear":"2026","description":"England, Juni 1944: Unter dem Oberbefehl von US-General Dwight D. Eisenhower (Brendan Fraser) steht die gr\u00f6\u00dfte See-Invasion der Menschheitsgeschichte kurz bevor. Ob der Angriff der Alliierten in der Normandie gelingt, h\u00e4ngt jedoch von einer entscheidenden Bedingung ab \u2013 dem richtigen Wetter. In den letzten, entscheidenden 72 Stunden vor dem D-Day muss der britische Chefmeteorologe Captain James Stagg (Andrew Scott) die folgenreichste Vorhersage seines Lebens treffen und ger\u00e4t dabei in einen erbitterten Konflikt mit der alliierten F\u00fchrung. Nur wenige Stunden bleiben, um den Moment zu finden, der \u00fcber Erfolg oder Scheitern der Invasion \u2013 und damit den Ausgang des gesamten Krieges \u2013 entscheidet. \r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"},{"name":"Kriegsfilm"},{"name":"Historie"}],"directors":[{"name":"Anthony Maras"}],"actors":[{"name":"Andrew Scott"},{"name":"Brendan Fraser"},{"name":"Kerry Condon"},{"name":"Chris Messina"},{"name":"Damian Lewis"},{"name":"Tamsin Topolski"},{"name":"Jojo Macari"},{"name":"Con O'Neill"},{"name":"Alexander Hanson"},{"name":"Robert Portal"},{"name":"Joshua Hill"},{"name":"Toby Williams"},{"name":"Richard Clothier"},{"name":"Michael Benz"},{"name":"Crispin Letts"},{"name":"Harrison Osterfield"},{"name":"Sebastian Orozco"},{"name":"Pedro Leandro"},{"name":"Wil Coban"},{"name":"Max Croes"},{"name":"Taylor Uttley"},{"name":"Aidan Cheng"},{"name":"Daniel Quinn-Toye"},{"name":"Charles Camrose"},{"name":"Patrick Flannery"},{"name":"John Schwab"},{"name":"Orlando Seale"},{"name":"Paul Bailey"},{"name":"Roseanna Brown"},{"name":"Henry Ashton"},{"name":"Joshua Reid"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/pressure-108961.v17894721594172.jpg"},"trailers":[]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-14T17:15:00+02:00","urlSlug":"6ac687780f6803018ffa6eee","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=27086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Resident Evil","beginning":"2026-10-14T17:30:00+02:00","urlSlug":"6ac6877f0f6803018ffa6f11","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=06186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"L\u00fcgen \u00fcber meine Mutter","beginning":"2026-10-14T17:50:00+02:00","urlSlug":"6ac687a10f6803018ffa6feb","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=28186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"100743","title":"L\u00fcgen \u00fcber meine Mutter","titleOriginal":"L\u00fcgen \u00fcber meine Mutter","urlSlug":"luegen-ueber-meine-mutter","duration":115,"productionYear":"2026","description":"L\u00dcGEN \u00dcBER MEINE MUTTER erz\u00e4hlt von der ersten gro\u00dfen Liebe unseres Lebens: der Liebe zwischen Mutter und Kind. Angesiedelt in der westdeutschen Provinz der 1980er Jahre, in einer Familie, in der ein Thema alles beherrscht: das K\u00f6rpergewicht der Mutter Cornelia (Rosalie Thomass). Ist diese sch\u00f6ne, eigenwillige, unberechenbare Frau zu dick? Muss sie dringend abnehmen? Ja, das muss sie. Entscheidet ihr Ehemann Werner (Golo Euler), der immer st\u00e4rker beherrscht wird von der fixen Idee, das \u00dcbergewicht seiner Frau w\u00e4re verantwortlich f\u00fcr alles, was ihm versagt bleibt: die Bef\u00f6rderung, der soziale Aufstieg, die Anerkennung in der Dorfgemeinschaft. Cornelia ist dem ausgesetzt, Tag f\u00fcr Tag, w\u00e4hrend Tochter Ela (Elise Lindner) zwischen den St\u00fchlen steht und zunehmend vom Vater infiltriert wird \u00fcber die in seinen Augen unzumutbar dicke Mutter. Doch was ist die Wahrheit und wer bel\u00fcgt hier eigentlich wen?\r\n\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Aron Lehmann"}],"actors":[{"name":"Rosalie Thomass"},{"name":"Golo Euler"},{"name":"Elise Lindner"},{"name":"Rainer Laupichler"},{"name":"Anneke Kim Sarnau"},{"name":"Juliane K\u00f6hler"},{"name":"Johanna Gastdorf"},{"name":"Ulrich Brandhoff"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/luegen-ueber-meine-mutter-100743.v17833290750021.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=BfSGBCplV5Y"}]}},{"name":"Die Odyssee","beginning":"2026-10-14T19:15:00+02:00","urlSlug":"6ac687950f6803018ffa6f95","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=AC086000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"imax"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99061","title":"Die Odyssee","titleOriginal":"The Odyssey","urlSlug":"die-odyssee-2026","duration":172,"productionYear":"2026","description":"Nach dem Trojanischen Krieg will Odysseus mit seinen Gef\u00e4hrten nach Ithaka zur\u00fcckkehren. Doch die Heimfahrt \u00fcber das Mittelmeer wird zu einer jahrelangen Irrfahrt: St\u00fcrme bringen ihre Schiffe vom Kurs ab, und auf dem Weg begegnen ihnen der Zyklop Polyphem und weitere gef\u00e4hrliche Wesen. W\u00e4hrend Odysseus um seine R\u00fcckkehr k\u00e4mpft, bedr\u00e4ngen in Ithaka Freier seine Frau Penelope und wollen die Herrschaft an sich bringen. Sein Sohn Telemachos macht sich auf die Suche nach dem vermissten Vater.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Christopher Nolan"}],"actors":[{"name":"Matt Lasky"},{"name":"Matt Damon"},{"name":"Tom Holland"},{"name":"Anne Hathaway"},{"name":"Robert Pattinson"},{"name":"Lupita Nyong'o"},{"name":"Charlize Theron"},{"name":"Zendaya"},{"name":"Benny Safdie"},{"name":"Jon Bernthal"},{"name":"John Leguizamo"},{"name":"Himesh Patel"},{"name":"Mia Goth"},{"name":"Will Yun Lee"},{"name":"Jimmy Gonzales"},{"name":"Elliot Page"},{"name":"Bill Irwin"},{"name":"Samantha Morton"},{"name":"Jesse Garcia"},{"name":"Rafi Gavron"},{"name":"Shiloh Fernandez"},{"name":"Corey Hawkins"},{"name":"Nick E. Tarabay"},{"name":"Maurice Compte"},{"name":"Michael Vlamis"},{"name":"Iddo Goldberg"},{"name":"Josh Stewart"},{"name":"Ryan Hurst"},{"name":"Anthony Molinari"},{"name":"Jovan Adepo"},{"name":"Logan Marshall-Green"},{"name":"James Remar"},{"name":"Travis Scott"},{"name":"Douglas Rouillard"},{"name":"Jorge L\u00e9on"},{"name":"Andrei Lenart"},{"name":"Kamden Riley"},{"name":"Ryan de Quintal"},{"name":"Jarreth J. Merz"},{"name":"Markie Farnsley"},{"name":"Stephen Murphy"},{"name":"Adam Croasdell"},{"name":"Jamie Harris"},{"name":"Niko Nicotera"},{"name":"Elyes Gabel"},{"name":"Sean Avery"},{"name":"Andrew Howard"},{"name":"Lupita Nyong\u2019o"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-odyssee-99061.v17811615267007.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=skiD2oYeCJY"},{"url":"https:\/\/www.youtube.com\/watch?v=1Js6B0_1-v4"}]}},{"name":"Die Tribute von Panem - The Hunger Games","beginning":"2026-10-14T19:30:00+02:00","urlSlug":"6ac687950f6803018ffa6f96","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=AE086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"415","title":"Die Tribute von Panem - The Hunger Games","titleOriginal":"The Hunger Games","urlSlug":"die-tribute-von-panem-the-hunger-games","duration":142,"productionYear":"2012","description":"Krieg und Naturkatastrophen haben die einst m\u00e4chtigen Vereinigten Staaten in die Knie gezwungen, die St\u00e4dte zerst\u00f6rt und nichts als Verzweiflung zur\u00fcckgelassen. Aus dem Staub der Tr\u00fcmmer ist das Land Panem entstanden, das mit harter Hand regiert wird und in dem Elend und Armut herrschen. Jedes Jahr werden hier unmenschliche Hungerspiele veranstaltet, bei denen der gewinnt, der am Ende \u00fcberlebt. Als ihre Schwester f\u00fcr diesen grausamen Kampf ausgew\u00e4hlt wird, geht die junge Katniss an ihrer Stelle und trifft dabei auf Peeta - ihren Lebensretter und Gegner... (j.b.)","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"},{"name":"Thriller"}],"directors":[{"name":"Gary Ross"}],"actors":[{"name":"Josh Hutcherson"},{"name":"Stanley Tucci"},{"name":"Toby Jones"},{"name":"Jennifer Lawrence"},{"name":"Liam Hemsworth"},{"name":"Woody Harrelson"},{"name":"Elizabeth Banks"},{"name":"Lenny Kravitz"},{"name":"Donald Sutherland"},{"name":"Wes Bentley"},{"name":"Alexander Ludwig"},{"name":"Isabelle Fuhrman"},{"name":"Amandla Stenberg"},{"name":"Willow Shields"},{"name":"Sandra Ellis Lafferty"},{"name":"Paula Malcomson"},{"name":"Rhoda Griffis"},{"name":"Sandino Moya-Smith"},{"name":"Raiko Bowman"},{"name":"Dwayne Boyd"},{"name":"Anthony Reynolds"},{"name":"Judd Lormand"},{"name":"Kimiko Gelman"},{"name":"Nelson Ascencio"},{"name":"Brooke Bundy"},{"name":"Dayo Okeniyi"},{"name":"Leven Rambin"},{"name":"Jack Quaid"},{"name":"Latarsha Rose"},{"name":"Ian Nelson"},{"name":"Kalia Prescott"},{"name":"Ethan Jamieson"},{"name":"Jacqueline Emerson"},{"name":"Mackenzie Lintz"},{"name":"Imanol Yepez-Frias"},{"name":"Annie Thurman"},{"name":"Dakota Hood"},{"name":"Amber Chaney"},{"name":"Karan Kendrick"},{"name":"Shane Bissell"},{"name":"Kate Kneeland"},{"name":"Steve Coulter"},{"name":"Sharon Conley"},{"name":"Tim Taylor"},{"name":"John Ross"},{"name":"Phillip Troy Linger"},{"name":"Julie Ivey"},{"name":"Mark Meekins"},{"name":"Jeremy Marinas"},{"name":"Kelly Lynn Reiter"},{"name":"Rachel Huggins"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/4\/die-tribute-von-panem-the-hunger-games-41516976731911697673353169767335616976733571697673358169767336016976733611697673432169767344116976734541697673462169767346816976734741697673478169767413816976746.v17243749628522.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=4aenVJ5o5bY"}]}},{"name":"L\u00fcgen \u00fcber meine Mutter","beginning":"2026-10-14T19:30:00+02:00","urlSlug":"6ac687a10f6803018ffa6fec","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=C1186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"100743","title":"L\u00fcgen \u00fcber meine Mutter","titleOriginal":"L\u00fcgen \u00fcber meine Mutter","urlSlug":"luegen-ueber-meine-mutter","duration":115,"productionYear":"2026","description":"L\u00dcGEN \u00dcBER MEINE MUTTER erz\u00e4hlt von der ersten gro\u00dfen Liebe unseres Lebens: der Liebe zwischen Mutter und Kind. Angesiedelt in der westdeutschen Provinz der 1980er Jahre, in einer Familie, in der ein Thema alles beherrscht: das K\u00f6rpergewicht der Mutter Cornelia (Rosalie Thomass). Ist diese sch\u00f6ne, eigenwillige, unberechenbare Frau zu dick? Muss sie dringend abnehmen? Ja, das muss sie. Entscheidet ihr Ehemann Werner (Golo Euler), der immer st\u00e4rker beherrscht wird von der fixen Idee, das \u00dcbergewicht seiner Frau w\u00e4re verantwortlich f\u00fcr alles, was ihm versagt bleibt: die Bef\u00f6rderung, der soziale Aufstieg, die Anerkennung in der Dorfgemeinschaft. Cornelia ist dem ausgesetzt, Tag f\u00fcr Tag, w\u00e4hrend Tochter Ela (Elise Lindner) zwischen den St\u00fchlen steht und zunehmend vom Vater infiltriert wird \u00fcber die in seinen Augen unzumutbar dicke Mutter. Doch was ist die Wahrheit und wer bel\u00fcgt hier eigentlich wen?\r\n\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Aron Lehmann"}],"actors":[{"name":"Rosalie Thomass"},{"name":"Golo Euler"},{"name":"Elise Lindner"},{"name":"Rainer Laupichler"},{"name":"Anneke Kim Sarnau"},{"name":"Juliane K\u00f6hler"},{"name":"Johanna Gastdorf"},{"name":"Ulrich Brandhoff"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/luegen-ueber-meine-mutter-100743.v17833290750021.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=BfSGBCplV5Y"}]}},{"name":"Forgotten Island","beginning":"2026-10-14T19:40:00+02:00","urlSlug":"6ac687640f6803018ffa6e5e","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=2E086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Alte Liebe","beginning":"2026-10-14T19:40:00+02:00","urlSlug":"6ac687890f6803018ffa6f4f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=19086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"97093","title":"Alte Liebe","titleOriginal":"Alte Liebe","urlSlug":"alte-liebe-","duration":111,"productionYear":"2026","description":"Lore (Dagmar Manzel) und Harry (Joachim Kr\u00f3l) sind seit fast 40 Jahren verheiratet \u2013 und streiten mindestens genauso lange. W\u00e4hrend Harry nach seiner Pensionierung von einem ruhigen Leben tr\u00e4umt, f\u00fcrchtet Lore, im Alltag und Garten festzustecken. Alte Konflikte und unerf\u00fcllte W\u00fcnsche sorgen immer wieder f\u00fcr Spannungen. Als ihre Tochter Gloria zum dritten Mal heiraten will \u2013 ausgerechnet einen wohlhabenden Mann, der fast Harrys Alter hat \u2013, ger\u00e4t das Familienleben endg\u00fcltig aus dem Gleichgewicht.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Andreas Dresen"}],"actors":[{"name":"Dagmar Manzel"},{"name":"Joachim Kr\u00f3l"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/alte-liebe-97093.v17845368285016.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=rEQxPVhgz0I"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T20:00:00+02:00","urlSlug":"6ac687840f6803018ffa6f31","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=DA186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T20:10:00+02:00","urlSlug":"6ac687740f6803018ffa6eda","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=9A086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Corpus Delicti","beginning":"2026-10-14T20:10:00+02:00","urlSlug":"6ac6878c0f6803018ffa6f66","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=25186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"77667","title":"CORPUS DELICTI ","titleOriginal":"CORPUS DELICTI ","urlSlug":"corpus-delicti","duration":103,"productionYear":"2026","description":"In einer nahen Zukunft garantiert die \u201eMethode\" umfassende Gesundheit und Transparenz in der Gesellschaft. Das Leben der Wissenschaftlerin Mia Holl (Hannah Herzsprung) \u00e4ndert sich schlagartig, als ihr Bruder Moritz (Damian Hardung) des Mordes beschuldigt wird. Die Beweise sind erdr\u00fcckend \u2013 und doch ist Mia von seiner Unschuld \u00fcberzeugt. Ein Widerspruch, der sie zum Handeln zwingt \u2013 gegen ein System, das keinen Zweifel zul\u00e4sst. Doch wem kann sie noch trauen? Ihrer Kollegin Christiane (Haley Louise Jones), dem Anwalt ihres Bruders (Christian Friedel) oder dem charismatischen Journalisten Kramer (Alexander Fehling)? Ihr Kampf um Wahrheit und Gerechtigkeit macht sie selbst zur Gejagten.","contentRating":null,"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Lena Stahl"}],"actors":[{"name":"Hannah Herzsprung"},{"name":"Damian Hardung"},{"name":"Alexander Fehling"},{"name":"Haley Louise Jones"},{"name":"Christian Friedel"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/corpus-delicti-77667.v17883329713390.webp"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=v8zdrItWSac"}]}},{"name":"Das gewisse Etwas","beginning":"2026-10-14T20:10:00+02:00","urlSlug":"6ac687900f6803018ffa6f7f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=41186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91757","title":"Das gewisse Etwas","titleOriginal":"Das gewisse Etwas","urlSlug":"das-gewisse-etwas","duration":105,"productionYear":"2026","description":"Nach einem Juwelenraub verstecken sich Alex (Max von der Groeben) und sein Vater Karlo (Florian Lukas) ausgerechnet bei einer Gruppe junger Erwachsener mit Beeintr\u00e4chtigung, die mit ihren Betreuenden (Mala Emde, Jasmin Schwiers, Lorenzo Germeno) gerade in den Sommerurlaub aufbrechen. Die beiden Ganoven geben sich kurzerhand als der fehlende Mitreisende Otto und dessen Betreuer aus \u2013 eine fast perfekte Tarnung. Mit der Flucht vor der Polizei beginnt ein au\u00dfergew\u00f6hnliches Abenteuer, das allen Beteiligten nicht nur ungeahnte Herausforderungen beschert, sondern auch jede Menge Spa\u00df, gro\u00dfe Gef\u00fchle \u2013 und eine neue Sicht auf das Leben! \r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Marc Rothemund"}],"actors":[{"name":"Mala Emde"},{"name":"Max von der Groeben"},{"name":"Florian Lukas"},{"name":"Lorenzo Germeno"},{"name":"Jasmin Schwiers"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-gewisse-etwas-91757.v17891408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"Spider-Man: Brand New Day","beginning":"2026-10-14T20:15:00+02:00","urlSlug":"6ac687aa0f6803018ffa701e","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=08086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"67487","title":"Spider-Man: Brand New Day","titleOriginal":"Spider-Man 4","urlSlug":"spider-man-brand-new-day","duration":146,"productionYear":"2026","description":"Vier Jahre sind seit den Ereignissen von \u201eNo Way Home\u201c vergangen. Peter ist nun erwachsen und lebt f\u00fcr sich allein, nachdem er sich freiwillig aus dem Leben und den Erinnerungen derer, die er liebt, ausgel\u00f6scht hat. Er bek\u00e4mpft Verbrechen in einem New York, das ihn und seinen Namen nicht mehr kennt, und widmet sich ganz dem Schutz seiner Stadt: Spider-Man in Vollzeit. Doch mit den steigenden Anforderungen l\u00f6st der Druck eine \u00fcberraschende k\u00f6rperliche Ver\u00e4nderung aus, die seine Existenz bedroht \u2013 gerade als eine seltsame neue Art von Verbrechen eine der m\u00e4chtigsten Bedrohungen hervorbringt, denen er je gegen\u00fcberstand.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Destin Daniel Cretton"}],"actors":[{"name":"Tom Holland"},{"name":"Zendaya"},{"name":"Sadie Sink"},{"name":"Jacob Batalon"},{"name":"Tramell Tillman"},{"name":"Michael Mando"},{"name":"Mark Ruffalo"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/spider-man-brand-new-day-67487.v17821309559165.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=G0Nmw8LbpCk"}]}},{"name":"Digger","beginning":"2026-10-14T20:20:00+02:00","urlSlug":"6ac687990f6803018ffa6fb0","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=CD086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"96021","title":"Digger","titleOriginal":"Digger","urlSlug":"digger","duration":129,"productionYear":"2026","description":"Der in die Jahre gekommene, verschrobene, milliardenschwere Erd\u00f6lmagnat Digger Rockwell (Tom Cruise) hat durch seine skrupellosen Gesch\u00e4ftstaktiken lange genug den Planeten ausgebeutet. Dadurch hat er eine Umweltkatastrophe verursacht, welche die Menschheit bedroht. Bevor die Welt im Chaos versinkt und die Apokalypse kommt, muss ein letzter Plan geschmiedet werden. Daf\u00fcr verlangt der Pr\u00e4sident der Vereinigten Staaten von Amerika (John Goodman) von Digger Rockwell, die Suppe, die er allen eingebrockt hat, selbst auszul\u00f6ffeln und die Erde zu retten. Dieser nimmt die Herausforderung an, denn als Egomane k\u00e4me es ihm ganz recht, als gro\u00dfer Retter der Menschheit dazustehen und gegen die Natur in den Krieg zu ziehen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Alejandro G. I\u00f1\u00e1rritu"}],"actors":[{"name":"Tom Cruise"},{"name":"Riz Ahmed"},{"name":"John Goodman"},{"name":"Sandra H\u00fcller"},{"name":"Michael Stuhlbarg"},{"name":"Jesse Plemons"},{"name":"Robert John Burke"},{"name":"Emma D'Arcy"},{"name":"Burn Gorman"},{"name":"Sophie Wilde"},{"name":"Pip Torrens"},{"name":"Mercedes Hern\u00e1ndez"},{"name":"Danny Kirrane"},{"name":"James Dryden"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/digger-96021.v17885811357140.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=qU-7KUMw-tk"}]}},{"name":"Resident Evil","beginning":"2026-10-14T20:30:00+02:00","urlSlug":"6ac6877f0f6803018ffa6f12","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=66186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T20:30:00+02:00","urlSlug":"6ac687840f6803018ffa6f32","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=14186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Eiserne Wildnis - Heart Of The Beast","beginning":"2026-10-14T20:30:00+02:00","urlSlug":"6ac6879c0f6803018ffa6fc3","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=9E086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"104697","title":"Eiserne Wildnis - Heart of the Beast","titleOriginal":"Heart of the Beast","urlSlug":"eiserne-wildnis-heart-of-the-beast","duration":101,"productionYear":"2026","description":"Nach einem Flugzeugabsturz stranden der Special-Forces-Offizier James Belmont und sein Milit\u00e4rhund Odin tief in der Wildnis Alaskas. Ohne vertraute Umgebung beginnt f\u00fcr sie ein Kampf gegen die Elemente. Um zu \u00fcberleben, m\u00fcssen Mensch und Tier zusammenhalten und sich aufeinander verlassen. Ihre enge Verbindung wird dabei auf die Probe gestellt: Gemeinsam versuchen sie, den Gefahren der Natur standzuhalten und sich in einer Lage zu behaupten, in der sie ganz auf sich gestellt sind.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Thriller"}],"directors":[{"name":"David Ayer"}],"actors":[{"name":"Brad Pitt"},{"name":"J.K. Simmons"},{"name":"Anna Lambe"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/eiserne-wildnis-heart-of-the-beast-104697.v17863488342134.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=JWjDIeEec1g&list=PLz3nyt80mNyFyNtkMADyjYzs_6AQA30iz&index=2"}]}},{"name":"Exit 8","beginning":"2026-10-14T22:30:00+02:00","urlSlug":"6ac6879f0f6803018ffa6fd8","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=FB086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"78699","title":"Exit 8","titleOriginal":"\uff18\u756a\u51fa\u53e3","urlSlug":"exit-8","duration":95,"productionYear":"2025","description":"Ein Mann ist in einem seltsam sterilen U-Bahn-Gang gefangen, der sich in einer scheinbar endlosen Schleife st\u00e4ndig wiederholt. Um zu entkommen, muss er den \u201eExit 8\u201c finden. Die Regeln sind einfach: Entdeckst du eine Ver\u00e4nderung, kehr sofort um. Entdeckst du keine, geh weiter. Wenn du auch nur einen einzigen Hinweis \u00fcbersiehst, musst du zur\u00fcck zum Anfang. Wird er je den \u201eExit 8\u201c finden und diesem albtraumhaften Labyrinth entkommen?\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Japan"}],"genres":[{"name":"Horror"},{"name":"Mystery"}],"directors":[{"name":"Genki Kawamura"}],"actors":[{"name":"Kazunari Ninomiya"},{"name":"Naru Asanuma"},{"name":"Kotone Hanase"},{"name":"Nana Komatsu"},{"name":"Yamato Kochi"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/exit-8-78699.v17846323645741.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=1MfT2pIOelo"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T22:30:00+02:00","urlSlug":"6ac687740f6803018ffa6edb","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=C3186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Hope","beginning":"2026-10-14T22:30:00+02:00","urlSlug":"6ac687860f6803018ffa6f40","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=6A186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"106955","title":"Hope","titleOriginal":"\ud638\ud504","urlSlug":"hope-26","duration":160,"productionYear":"2026","description":"In dem abgelegenen s\u00fcdkoreanischen Dorf Hope Harbor werden Polizeichef Bum-seok und die Polizistin Sung-ae gerufen, um Ermittlungen gegen eine mysteri\u00f6se Kreatur aufzunehmen, die in der Gemeinde Chaos anrichtet. Doch nicht alles ist so, wie es scheint, und der erste Eindruck kann t\u00e4uschen. Was als Unwissenheit beginnt, s\u00e4t den Keim f\u00fcr eine Katastrophe, die sich durch menschliche Konflikte zu einer Trag\u00f6die von kosmischem Ausma\u00df zuspitzt.\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"South Korea"}],"genres":[{"name":"Science Fiction"},{"name":"Action"},{"name":"Mystery"}],"directors":[{"name":"Na Hong-jin"}],"actors":[{"name":"Hwang Jung-min"},{"name":"Zo In-sung"},{"name":"Hoyeon"},{"name":"Alicia Vikander"},{"name":"Michael Fassbender"},{"name":"Taylor Russell"},{"name":"Cameron Britton"},{"name":"Lee Sang-hee"},{"name":"Um Mun-suk"},{"name":"Im Hyun-sik"},{"name":"Hwang Seok-jeong"},{"name":"Han Woo-yeol"},{"name":"Chyu Kwang-hyun"},{"name":"Oh Doo-won"},{"name":"Yoo Jun-hong"},{"name":"Seo Beom-Sik"},{"name":"Baek Seung-chul"},{"name":"Cho Ji-hoon"},{"name":"Kwon Joong"},{"name":"Kim Ki-cheon"},{"name":"Lee Yong-nyeo"},{"name":"Min Kyung-jin"},{"name":"Yoo Soon-woong"},{"name":"Jung Jae-won"},{"name":"Kim Han-jong"},{"name":"Jeong Ji-sun"},{"name":"Lee Sang-jin"},{"name":"Kim Kyu-baek"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/hope-106955.v17871147797025.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=C75lKk6PXZI"}]}},{"name":"Insidious: Out of the Further","beginning":"2026-10-14T23:00:00+02:00","urlSlug":"6ac6879f0f6803018ffa6fdd","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=48086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"104597","title":"Insidious: Out of the Further","titleOriginal":"Insidious: Out of the Further","urlSlug":"insidious-out-of-the-further","duration":106,"productionYear":"2026","description":"In Insidious: Out of the Further spielt Amelia Eve die junge Mutter Gemma, die gemeinsam mit ihrer Tochter in das Haus ihrer Kindheit zur\u00fcckkehrt. Dort entdeckt sie, dass sie The Further betreten kann \u2013 das jenseitige Reich verlorener Seelen im Zentrum des Insidious-Universums. Als eine b\u00f6se Macht Jagd auf sie macht, erkennt Gemma, dass ihre F\u00e4higkeit noch au\u00dfergew\u00f6hnlicher ist: Sie kann nicht nur The Further betreten, sondern auch dessen Bewohner in die reale Welt zur\u00fcckbringen. Als die D\u00e4monen von ihrer Gabe erfahren, wird unsere Welt zu ihrem neuen Jagdrevier.","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Jacob Chase"}],"actors":[{"name":"Amelia Eve"},{"name":"Island Austin"},{"name":"Lin Shaye"},{"name":"Sam Spruell"},{"name":"Brandon Perea"},{"name":"Maisie Richardson-Sellers"},{"name":"Joseph Lopez"},{"name":"Laura Gordon"},{"name":"Charli Penton"},{"name":"Taylor Bogrand"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/insidious-out-of-the-further-104597.v17863500215093.jpg"},"trailers":[]}},{"name":"Resident Evil","beginning":"2026-10-14T23:00:00+02:00","urlSlug":"6ac687800f6803018ffa6f13","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=92186000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"imax"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T23:00:00+02:00","urlSlug":"6ac687840f6803018ffa6f33","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=07186000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Primetime","beginning":"2026-10-14T23:00:00+02:00","urlSlug":"6ac687a50f6803018ffa7004","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=5C086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"111213","title":"Primetime","titleOriginal":"Primetime","urlSlug":"primetime-","duration":111,"productionYear":"2026","description":"Mitte der 2000er-Jahre moderiert Chris Hansen in den USA die Fernsehsendung \u201eTo Catch a Predator\u201c. Mithilfe von Lockv\u00f6geln konfrontiert sein Team M\u00e4nner, die im Internet Kontakt zu vermeintlich Minderj\u00e4hrigen gesucht haben, vor laufenden Kameras. Die Sendung wird immer erfolgreicher, und mit den Einschaltquoten wachsen auch die Ambitionen der Beteiligten. Hansen, seine Produzentin Andie und der junge Schauspieler Dan setzen sich zunehmend unter Druck, immer aufsehenerregendere F\u00e4lle zu finden. W\u00e4hrend die Arbeit das Team vereinnahmt, wird Hansen von beunruhigenden Visionen verfolgt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Lance Oppenheim"}],"actors":[{"name":"Robert Pattinson"},{"name":"Skyler Gisondo"},{"name":"Merritt Wever"},{"name":"Phoebe Bridgers"},{"name":"Matthew Maher"},{"name":"Bokeem Woodbine"},{"name":"Alex Winter"},{"name":"Anna Faris"},{"name":"Eric Rahill"},{"name":"Bill Heck"},{"name":"Tony Revolori"},{"name":"Bob Ari"},{"name":"Jonathan Lipnicki"},{"name":"Matt Smith"},{"name":"Michael Chachere"},{"name":"Jessica Hecht"},{"name":"Creed Bratton"},{"name":"Franco Brocato"},{"name":"Luca Brocato"},{"name":"Jeff Zucker"},{"name":"Sean Bridgers"},{"name":"Jessica Blackmore"},{"name":"Mike Harkins"},{"name":"Daniel Garber"},{"name":"Christopher Berry"},{"name":"Ja'Quan Monroe-Henderson"},{"name":"David Rosenberg"},{"name":"Trey Burvant"},{"name":"Caroline Hebert"},{"name":"Brent Caballero"},{"name":"Abigail Rowe"},{"name":"Adam Bhala Lough"},{"name":"Rob Eubanks"},{"name":"Owen Campbell"},{"name":"Jon Bass"},{"name":"Brian Brier"},{"name":"Caveh Zahedi"},{"name":"David Fierro"},{"name":"Ed Malone"},{"name":"David Pridemore"},{"name":"Charles Schneider"},{"name":"Jonathan Francis"},{"name":"A.J. Leitell"},{"name":"Berwick Lagarde"},{"name":"Joe Skinner"},{"name":"Jason Woliner"},{"name":"Ryan Hyon"},{"name":"Roy Oppenheim"},{"name":"Ellen Oppenheim"},{"name":"P. Nadipkumar"},{"name":"Mariya Journey Appuhami"},{"name":"Senevirathne Bandara"},{"name":"Sriyani Lunuwila"},{"name":"G. Wimalasooriya"},{"name":"W.A.D. Priyanka Renuka"},{"name":"M. Vidushika"},{"name":"S. Chandrabose"},{"name":"Brittany Seals"},{"name":"Eugene Kotlyarenko"},{"name":"Christian Vazquez"},{"name":"Sue-Lynn Ansari"},{"name":"Victor Brunette"},{"name":"Daniel Congleton"},{"name":"Lacey Dover"},{"name":"Russell C. Gibbs"},{"name":"Miles Glew"},{"name":"Fun"},{"name":"Chad Governale"},{"name":"Ty Johnson"},{"name":"Joseph Karre"},{"name":"Ernest Marsh"},{"name":"Dan Matteucci"},{"name":"Reginald Murray"},{"name":"Melvin Pittman"},{"name":"Ron Usie"},{"name":"Gerrold Vincent"},{"name":"Stanley White Jr."},{"name":"Francis Wong"},{"name":"Billy Bob Thornton"},{"name":"James Lipton"},{"name":"John Qui\u00f1ones"},{"name":"Jason Lee"},{"name":"Terry O'Quinn"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/primetime-111213.v17912593226793.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=iaO2VzUthKc"}]}},{"name":"Das Ding mit Federn","beginning":"2026-10-15T20:00:00+02:00","urlSlug":"6ac687ae0f6803018ffa7032","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=95D76000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"109743","title":"Das Ding mit Federn","titleOriginal":"The Thing with Feathers","urlSlug":"das-ding-mit-den-federn","duration":99,"productionYear":null,"description":"Nach dem unerwarteten Tod seiner Frau ist ein junger Vater (Benedict Cumberbatch) mit seinen kleinen S\u00f6hnen pl\u00f6tzlich auf sich allein gestellt. Doch je mehr er sich um Halt bem\u00fcht, desto deutlicher sp\u00fcrt er in seiner Wohnung eine unheilvolle Pr\u00e4senz: eine \u00fcbergro\u00dfe, menschen\u00e4hnliche Kr\u00e4he, die aus den Schatten auftaucht und sich nicht mehr verscheuchen l\u00e4sst. Je tiefer sich der Vater in seiner Verzweiflung verliert, desto schwerer l\u00e4sst sich die Kreatur von seiner eigenen aufgew\u00fchlten Psyche trennen \u2013 bis er nicht mehr wei\u00df, wovor er seine Kinder eigentlich sch\u00fctzen muss.  Regisseur Dylan Southern verfilmt Max Porters Bestseller TRAUER IST DAS DING MIT FEDERN, der als Theateradaption international gefeiert wurde, als psychologischen Thriller von radikal expressionistischer Bildsprache. Benedict Cumberbatch liefert eine intensive, kompromisslose Interpretation eines Mannes an der Grenze zur Selbstaufl\u00f6sung, die lange im Ged\u00e4chtnis bleibt.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Drama"}],"directors":[{"name":"Dylan Southern"}],"actors":[{"name":"Benedict Cumberbatch"},{"name":"David Thewlis"},{"name":"Sam Spruell"},{"name":"Vinette Robinson"},{"name":"Leo Bill"},{"name":"Garry Cooper"},{"name":"Jessie Cave"},{"name":"Adam Basil"},{"name":"Lizzie Clarke"},{"name":"Tim Plester"},{"name":"Dwane Walcott"},{"name":"Eric Lampaert"},{"name":"Kevin Howarth"},{"name":"Pierre Bergman"},{"name":"Max Porter"},{"name":"Lesley Molony"},{"name":"Claire Cartwright"},{"name":"Nandi Bhebhe"},{"name":"Mat Wright"},{"name":"Rimca Karmakar"},{"name":"Richard Boxall"},{"name":"Henry Boxall"},{"name":"Steve Paget"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-ding-mit-federn-109743.v17902255592161.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=bRFMZqpRhCc"}]}},{"name":"Met Opera 2026\/27: Giuseppe Verdi MACBETH","beginning":"2026-10-17T19:00:00+02:00","urlSlug":"6acb100b026bf6041eaa4eaf","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=6E276000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"101157","title":"MET 2026\/27 Giuseppe Verdi: MACBETH","titleOriginal":"MET 2026\/27 Giuseppe Verdi: Macbeth","urlSlug":"met-2026-27-giuseppe-verdi-macbeth","duration":null,"productionYear":"2026","description":"Die Saison beginnt mit haarstr\u00e4ubendem Drama und spektakul\u00e4rem Gesang, wenn zwei der au\u00dfergew\u00f6hnlichsten K\u00fcnstler der Opernwelt in \u201eMacbeth\u201c zu sehen sind, Verdis packender Interpretation der unsterblichen Shakespeare-Erz\u00e4hlung \u00fcber das intrigante Paar, das entschlossen ist, um jeden Preis die Macht an sich zu rei\u00dfen. Nach fr\u00fcheren Triumphen in vielen von Verdis charakteristischen Baritonrollen ist Quinn Kelsey der schottische K\u00f6nig, der von den Geistern seines m\u00f6rderischen Aufstiegs zum Thron heimgesucht wird, an der Seite von Lise Davidsen \u2013 der weltweit f\u00fchrenden dramatischen Sopranistin \u2013 als machtbesessene Lady Macbeth, deren ruin\u00f6ser Ehrgeiz beide ins Verderben st\u00fcrzt. Met-Musikdirektor Yannick N\u00e9zet-S\u00e9guin steht am Pult f\u00fcr eine eindringliche Inszenierung von Louisa Proske, einer brillanten jungen Regisseurin, die weltweit f\u00fcr Aufsehen sorgt. Abgerundet wird die Starbesetzung durch den Tenor Freddie De Tommaso als den heldenhaften Macduff und den Bassbariton Ryan Speedo Green als Macbeths Freund und sp\u00e4teres Opfer Banquo.\r\n","contentRating":null,"productionCountries":[],"genres":[],"directors":[{"name":"Louisa Proske"}],"actors":[{"name":"Yannick N\u00e9zet-S\u00e9guin"},{"name":"Lise Davidsen"},{"name":"Freddie De Tommaso"},{"name":"Quinn Kelsey"},{"name":"Ryan Speedo Green"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/met-2026-27-giuseppe-verdi-macbeth-101157.v17803143730244.jpg"},"trailers":[]}},{"name":"Der perfekte Urlaub","beginning":"2026-10-21T20:00:00+02:00","urlSlug":"6ac687650f6803018ffa6e5f","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=79876000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91759","title":"Der perfekte Urlaub","titleOriginal":"Der perfekte Urlaub","urlSlug":"der-perfekte-urlaub","duration":100,"productionYear":"2026","description":"Mehr als f\u00fcnf Millionen Deutsche reisen jedes Jahr nach Mallorca. Leo (Elyas M\u2019Barek), Pepe (Florian David Fitz), Rocco (Wotan Wilke M\u00f6hring) und Simon (Frederick Lau) nehmen sich ebenfalls eine Auszeit im 17. Bundesland. Erst mal Wunden lecken, sich sammeln, Abstand gewinnen. Seit dem entgleisten Handy-Spiel ist nichts mehr, wie es war. Guter Plan. Bl\u00f6d nur, dass aus dem entspannten Jungs-Trip nichts wird: Eva (Jessica Schwarz), Carlotta (Karoline Herfurth) und ihre beste Freundin Maus (Diana Amft) haben sich in derselben Villa auf Malle einquartiert. Auf die harte Tour muss die dysfunktionale Clique herausfinden, was von Freundschaft, Vertrauen und Liebe \u00fcberhaupt noch \u00fcbrig ist. Und als die Finca in Flammen aufgeht und die Freunde in einem Gute-Laune-Clubhotel stranden, bringen alte Wunden und neue Enth\u00fcllungen die Fassaden endg\u00fcltig zum Br\u00f6ckeln. Bald steht nicht nur jede einzelne Beziehung, sondern die gesamte Freundschaft auf dem Spiel. Kann Leo nach seiner SMS-Aff\u00e4re Carlottas Vertrauen zur\u00fcckgewinnen? Eva hat nicht nur Stress mit ihrer Teenager-Tochter Sophie (Emily Kusche), sondern auch mit ihrem Mann. Beide ahnen, dass sie sich gegenseitig etwas verschweigen, doch mit Roccos Zweithandy hatte Eva nicht gerechnet. Pepe, frisch geoutet, w\u00fcnscht sich mehr Support von seinen Hetero-Kumpels, w\u00e4hrend er sich selbst noch nicht ganz gefunden hat. Und Simon ist der Charmeur geblieben, der jede Konsequenz wegwitzelt. Doch als seine Ex-Freundin Bianca (Jella Haase) auftaucht, geht es ans Eingemachte \u2026 VAMOS A LA DRAMA!\r\n\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Bora Dagtekin"}],"actors":[{"name":"Elyas M'Barek"},{"name":"Karoline Herfurth"},{"name":"Florian David Fitz"},{"name":"Jella Haase"},{"name":"Frederick Lau"},{"name":"Wotan Wilke M\u00f6hring"},{"name":"Jessica Schwarz"},{"name":"Emily Kusche"},{"name":"Diana Amft"},{"name":"Malick Bauer"},{"name":"Elzemarieke De Vos"},{"name":"David Korbmann"},{"name":"Maria Dragus"},{"name":"Inez Bj\u00f8rg David"},{"name":"Daniel Zillmann"},{"name":"Jan van Weyde"},{"name":"Jannis Hain"},{"name":"Caroline Frier"},{"name":"Paul Ahrens"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/der-perfekte-urlaub-91759.v17884223088592.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Kaeu2N-S_Qw"}]}},{"name":"Der perfekte Urlaub","beginning":"2026-10-22T14:00:00+02:00","urlSlug":"6ac687650f6803018ffa6e61","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=6AB76000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"imax"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"91759","title":"Der perfekte Urlaub","titleOriginal":"Der perfekte Urlaub","urlSlug":"der-perfekte-urlaub","duration":100,"productionYear":"2026","description":"Mehr als f\u00fcnf Millionen Deutsche reisen jedes Jahr nach Mallorca. Leo (Elyas M\u2019Barek), Pepe (Florian David Fitz), Rocco (Wotan Wilke M\u00f6hring) und Simon (Frederick Lau) nehmen sich ebenfalls eine Auszeit im 17. Bundesland. Erst mal Wunden lecken, sich sammeln, Abstand gewinnen. Seit dem entgleisten Handy-Spiel ist nichts mehr, wie es war. Guter Plan. Bl\u00f6d nur, dass aus dem entspannten Jungs-Trip nichts wird: Eva (Jessica Schwarz), Carlotta (Karoline Herfurth) und ihre beste Freundin Maus (Diana Amft) haben sich in derselben Villa auf Malle einquartiert. Auf die harte Tour muss die dysfunktionale Clique herausfinden, was von Freundschaft, Vertrauen und Liebe \u00fcberhaupt noch \u00fcbrig ist. Und als die Finca in Flammen aufgeht und die Freunde in einem Gute-Laune-Clubhotel stranden, bringen alte Wunden und neue Enth\u00fcllungen die Fassaden endg\u00fcltig zum Br\u00f6ckeln. Bald steht nicht nur jede einzelne Beziehung, sondern die gesamte Freundschaft auf dem Spiel. Kann Leo nach seiner SMS-Aff\u00e4re Carlottas Vertrauen zur\u00fcckgewinnen? Eva hat nicht nur Stress mit ihrer Teenager-Tochter Sophie (Emily Kusche), sondern auch mit ihrem Mann. Beide ahnen, dass sie sich gegenseitig etwas verschweigen, doch mit Roccos Zweithandy hatte Eva nicht gerechnet. Pepe, frisch geoutet, w\u00fcnscht sich mehr Support von seinen Hetero-Kumpels, w\u00e4hrend er sich selbst noch nicht ganz gefunden hat. Und Simon ist der Charmeur geblieben, der jede Konsequenz wegwitzelt. Doch als seine Ex-Freundin Bianca (Jella Haase) auftaucht, geht es ans Eingemachte \u2026 VAMOS A LA DRAMA!\r\n\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Bora Dagtekin"}],"actors":[{"name":"Elyas M'Barek"},{"name":"Karoline Herfurth"},{"name":"Florian David Fitz"},{"name":"Jella Haase"},{"name":"Frederick Lau"},{"name":"Wotan Wilke M