02565e8c4","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57811\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"104291","title":"Der Regenbogenfisch","titleOriginal":"De R\u00e4gebogefisch","urlSlug":"der-regenbogenfisch","duration":70,"productionYear":"2026","description":"Der Regenbogenfisch ist mit seinen schillernden Schuppen der sch\u00f6nste Fisch im ganzen Ozean. Doch er ist auch eitel und stolz, und st\u00f6\u00dft damit die anderen Fische vor den Kopf. Das l\u00e4sst ihn immer einsamer werden. Als er schlie\u00dflich eine seiner geliebten Glitzerschuppen verliert, ist es ausgerechnet der Kleine Blaue, der ihn auf der Suche danach in die tiefste Tiefsee begleitet. Eine abenteuerliche Meeresreise beginnt \u2013 und der Regenbogenfisch erkennt, dass man gemeinsam viel mutiger ist als allein und dass echte Freundschaft kostbarer ist als das pr\u00e4chtigste Schuppenkleid.\r\n","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"Florian Moch"}],"actors":[{"name":"Jannik Sch\u00fcmann"},{"name":"Luna Wedler"},{"name":"Andrea Sawatzki"},{"name":"Bjarne M\u00e4del"},{"name":"Tom B\u00f6ttcher"},{"name":"Tobi Krell"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/der-regenbogenfisch-104291.v17918030658361.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=AoCj-M27pGM"}]}},{"name":"Klassiker: Batman h\u00e4lt die Welt in Atem","beginning":"2026-11-08T15:00:00+01:00","urlSlug":"6a97f8ffd2273ae7895f74dd","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-54727\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"41353","title":"Batman h\u00e4lt die Welt in Atem","titleOriginal":"Batman","urlSlug":"batman-the-mie","duration":105,"productionYear":"1966","description":"Die \u201cVereinigte Umwelt\u201d will die Weltherrschaft \u00fcbernehmen. Zu diesem Zweck stehlen Joker, Pinguin, Riddler und Catwoman eine Erfindung mit deren Hilfe sie die gesamte Menschheit pulverisieren k\u00f6nnten. Nur zwei sind in der Lage diesen d\u00fcsteren Plan zu stoppen: Batman und Robin! Doch auch die Gegner wissen was es hei\u00dft, wenn das R\u00e4cher-Duo ins Spiel kommt und so locken sie die beiden heimt\u00fcckisch in eine Falle\u2026 Wird es den beiden Fledermaus-Helden gelingen das skrupellose Verbrechersyndikat rechtzeitig auszutricksen, um so die Welt vor der drohenden Katastrophe zu retten?","contentRating":{"minimumAge":6},"productionCountries":[{"name":"United Kingdom"},{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Abenteuer"},{"name":"Krimi"}],"directors":[{"name":"Leslie H. Martinson"}],"actors":[{"name":"Adam West"},{"name":"Burt Ward"},{"name":"Lee Meriwether"},{"name":"Cesar Romero"},{"name":"Frank Gorshin"},{"name":"Burgess Meredith"},{"name":"Gil Perkins"},{"name":"Milton Frome"},{"name":"Dick Crockett"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/batman-haelt-die-welt-in-atem-41353.v1.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=nh1VNWlluy8"}]}},{"name":"Klassiker: Lethal Weapon 2 - Brennpunkt L.A.","beginning":"2026-11-11T20:00:00+01:00","urlSlug":"6ac60f9dc2969cb3b2a48d27","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57791\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"111463","title":"Lethal Weapon 2 - Brennpunkt L.A.","titleOriginal":"Lethal Weapon 2","urlSlug":"klassiker-lethal-weapon-2-brennpunkt-l-a","duration":114,"productionYear":null,"description":"Die beiden Cops Martin Riggs und Roger Murtaugh bekommen nach einer missgl\u00fcckten Verfolgungsjagd auf eine Bande Drogengangster den scheinbar leichten Auftrag, einen kleinen Buchmacher namens Leo Getz bis zu dessen Gerichtsaussage zu sch\u00fctzen. Dieser arbeitet jedoch f\u00fcr die Organisation, hinter der Riggs und Murtaugh her sind. Die Spuren f\u00fchren die beiden Cops direkt in die s\u00fcdafrikanische Botschaft.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Action"},{"name":"Thriller"},{"name":"Krimi"}],"directors":[{"name":"Richard Donner"}],"actors":[{"name":"Mel Gibson"},{"name":"Danny Glover"},{"name":"Joe Pesci"},{"name":"Joss Ackland"},{"name":"Derrick O'Connor"},{"name":"Patsy Kensit"},{"name":"Darlene Love"},{"name":"Traci Wolfe"},{"name":"Mark Rolston"},{"name":"Steve Kahan"},{"name":"Jenette Goldstein"},{"name":"Dean Norris"},{"name":"Juney Smith"},{"name":"Nestor Serrano"},{"name":"Philip Suriano"},{"name":"Grand L. Bush"},{"name":"Tony Carreiro"},{"name":"Damon Hines"},{"name":"Ebonie Smith"},{"name":"Allan Dean Moore"},{"name":"Jack McGee"},{"name":"Paul Tuerpe"},{"name":"Philip Maurice Miller"},{"name":"Sherman Howard"},{"name":"Bruce Young"},{"name":"Guy Mack"},{"name":"Danny Wynands"},{"name":"Pat Skipper"},{"name":"Robert Fol"},{"name":"Virginia Shannon"},{"name":"Dan Ondrejko"},{"name":"Jim Piddock"},{"name":"Kenneth Tigar"},{"name":"Jim Birge"},{"name":"Patrick Cameron"},{"name":"Mary Ellen Trainor"},{"name":"David Marciano"},{"name":"Tommy Hinkley"},{"name":"Norman D. Wilson"},{"name":"Jeanne McGuire"},{"name":"Catherine Guel"},{"name":"Lionel Douglass"},{"name":"James Oliver"},{"name":"Salim Jaidi"},{"name":"Al Weber Jr."},{"name":"Edward J. Rosen"},{"name":"Jay Della"},{"name":"Marian Collier"},{"name":"Orlando Bonner"},{"name":"Cynthia Burr"},{"name":"J. Mills Goodloe"},{"name":"Jorga Caye"},{"name":"Lana Houston"},{"name":"Beau Lotterman"},{"name":"Larry Clardy"},{"name":"Conrad Hurtt"},{"name":"Bettina M. Johnson"},{"name":"Todd Blood"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/lethal-weapon-2-brennpunkt-l-a-111463.v17914336264500.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=-wrxmrEh8qA"}]}},{"name":"George Michael: The Faith Tour","beginning":"2026-11-12T20:00:00+01:00","urlSlug":"6ac664a095648729052f35f3","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57807\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"111337","title":"George Michael - The Faith Tour","titleOriginal":"George Michael: The Faith Tour","urlSlug":"george-michael-the-faith-tour-6ac5c4f740d0b","duration":113,"productionYear":"2026","description":"Mit seinen Songs pr\u00e4gte er eine \u00c4ra: George Michael. Mit dem neuen Konzertfilm GEORGE MICHAEL \u2013 THE FAITH TOUR erwacht seine legend\u00e4re Faith-Tour im Kino noch einmal zum Leben, mit nie zuvor gezeigtem Material, spektakul\u00e4r \u00fcberarbeitet und remastered.\r\n\r\nGEORGE MICHAEL \u2013 THE FAITH TOUR zeigt einen der einflussreichsten Stars seiner Generation auf dem H\u00f6hepunkt seines kreativen Schaffens. Das wiederentdeckte 35-mm-Filmmaterial seines Auftritts 1988 in Paris, im Palais Omnisports de Paris-Bercy (heute Accor Arena), ist ein wahrer Gl\u00fccksfall. Dank der aufwendigen Restaurierung l\u00e4sst sich die rekordbrechende Faith-Tour noch einmal auf der gro\u00dfen Leinwand erleben. Zugleich wird ein Moment wieder lebendig, der die Popkultur nachhaltig gepr\u00e4gt hat.\r\n\r\nDen Auftakt bildet Mary McCartneys (If These Walls Could Sing) Kurzfilm Finding Faith. Neu entdeckte Bild- und Tonaufnahmen aus den Jahren 1986 bis 1988 gew\u00e4hren einen ebenso lebendigen wie intimen Einblick in George Michaels Gedankenwelt \u2013 in einer Zeit, die sein Leben und seine Karriere entscheidend ver\u00e4nderte.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Dokumentarfilm"},{"name":"Musik"}],"directors":[{"name":"Andy Morahan"},{"name":"David Austin"}],"actors":[{"name":"George Michael"},{"name":"Herb Ritts"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/george-michael-the-faith-tour-111337.v17918008587980.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=22HaIau2Dd0"}]}},{"name":"Festtagsspa\u00df mit Peppa \u2013 Das Kinoerlebnis","beginning":"2026-11-14T11:30:00+01:00","urlSlug":"6ac664a095648729052f35f4","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57797\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"110311","title":"Festtagsspa\u00df mit Peppa - Das Kinoerlebnis","titleOriginal":"Festive Fun with Peppa","urlSlug":"festive-fun-with-peppa-cinema-experience","duration":null,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[{"name":"Animation"},{"name":"Familie"}],"directors":[],"actors":[{"name":"Morwenna Banks"},{"name":"Richard Ridings"},{"name":"Amelie Bea Smith"}],"thumbnailImage":null,"trailers":[]}},{"name":"Festtagsspa\u00df mit Peppa \u2013 Das Kinoerlebnis","beginning":"2026-11-14T13:00:00+01:00","urlSlug":"6ac664a095648729052f35f5","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57792\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"110311","title":"Festtagsspa\u00df mit Peppa - Das Kinoerlebnis","titleOriginal":"Festive Fun with Peppa","urlSlug":"festive-fun-with-peppa-cinema-experience","duration":null,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[{"name":"Animation"},{"name":"Familie"}],"directors":[],"actors":[{"name":"Morwenna Banks"},{"name":"Richard Ridings"},{"name":"Amelie Bea Smith"}],"thumbnailImage":null,"trailers":[]}},{"name":"Festtagsspa\u00df mit Peppa \u2013 Das Kinoerlebnis","beginning":"2026-11-14T15:00:00+01:00"