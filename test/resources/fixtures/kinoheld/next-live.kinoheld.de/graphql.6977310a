tors":[{"name":"Damiano Michieletto"}],"actors":[{"name":"Alex Esposito"},{"name":"Julie Boulianne"},{"name":"Alastair Miles"},{"name":"Juan Diego Fl\u00f3rez"},{"name":"Olga Pudova"},{"name":"Ermonela Jaho"},{"name":"Marina Costa-Jackson"},{"name":"Christophe Mortagne"},{"name":"Vincent Ordonneau"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/live-royal-opera-house-2024-25-offenbach-s-hoffmanns-erzaehlungen-60845.v17193063485416.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=joK9D_t2KJY"}]}},{"name":"Festtagsspa\u00df mit Peppa \u2013 Das Kinoerlebnis","beginning":"2026-11-15T15:00:00+01:00","urlSlug":"6ac664a195648729052f35f9","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57794\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"110311","title":"Festtagsspa\u00df mit Peppa - Das Kinoerlebnis","titleOriginal":"Festive Fun with Peppa","urlSlug":"festive-fun-with-peppa-cinema-experience","duration":null,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[{"name":"Animation"},{"name":"Familie"}],"directors":[],"actors":[{"name":"Morwenna Banks"},{"name":"Richard Ridings"},{"name":"Amelie Bea Smith"}],"thumbnailImage":null,"trailers":[]}},{"name":"Klassiker: Der mit dem Wolf tanzt","beginning":"2026-11-15T15:30:00+01:00","urlSlug":"6a9f7527b1c1c65c1b8e3b69","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-56880\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108519","title":"Der mit dem Wolf tanzt","titleOriginal":"Dances with Wolves","urlSlug":"der-mit-dem-wolf-tanzt","duration":236,"productionYear":"1990","description":"Der Film brachte 1991 acht Oscars und Kevin Costner den gro\u00dfen Durchbruch als Regisseur: Ein Soldat l\u00e4\u00dft sich zur Zeit des amerikanischen B\u00fcrgerkriegs an die westliche \"Frontier\" versetzen, dorthin, wo das Indianerland anf\u00e4ngt. Er lernt die Sprache und Kultur der Sioux kennen, jagt mit ihnen B\u00fcffel und wird zu einem der ihren.","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Drama"},{"name":"Abenteuer"},{"name":"Western"}],"directors":[{"name":"Kevin Costner"}],"actors":[{"name":"Mary McDonnell"},{"name":"Graham Greene"},{"name":"Rodney A. Grant"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/der-mit-dem-wolf-tanzt-35-jaehriges-jubilaeum-108519.v17887737397196.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=hscyO-jRrHk"}]}},{"name":"Klassiker:Liebling,ich habe die Kinder geschrumpft","beginning":"2026-11-15T15:45:00+01:00","urlSlug":"6abe984bfccc849d3db4a151","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57541\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"42355","title":"Klassiker:Liebling,ich habe die Kinder geschrumpft","titleOriginal":"Honey, I Shrunk the Kids","urlSlug":"liebling-ich-habe-die-kinder-geschrumpft","duration":93,"productionYear":null,"description":"Der Wissenschaftler Wayne Szalinski ist ein leidenschaftlicher Forscher, der auch ungew\u00f6hnliche Erfindungen sch\u00e4tzt. Sein neustes Werk ist eine Maschine, mit der sich Objekte auf Miniaturgr\u00f6\u00dfe schrumpfen lassen. Die Umgebung Szalinskis teilt den Enthusiasmus des Wissenschaftlers nicht, davon l\u00e4sst er sich jedoch \u00fcberhaupt nicht beeindrucken. Aber dann passiert ein unl\u00fcckseliger Zwischenfall, der in Szalisnkis Planungen nicht vorgesehen war. Seine eigenen Kinder Amy und Nick sowie Ronald und Russell, die beiden S\u00f6hne seines Nachbarn Russell Thompson Sr., geraten in den Wirkungskreis der Maschine und werden zu Liliputanern. Jetzt m\u00fcssen die Kinder zusammenhalten, um in der unwirtlichen Umgebung \u00fcberleben zu k\u00f6nnen. Denn Grashalme wirken f\u00fcr sie wie B\u00e4ume und harmlose Insekten sind eine t\u00f6dliche Gefahr. Vom Garten bis zum rettenden Haus ist es ein weiter Weg, aber die Kinder nehmen die Herausforderung an.","contentRating":null,"productionCountries":[],"genres":[{"name":"Kom\u00f6die"},{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Joe Johnston"}],"actors":[{"name":"Rick Moranis"},{"name":"Matt Frewer"},{"name":"Marcia Strassman"},{"name":"Kristine Sutherland"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/liebling-ich-habe-die-kinder-geschrumpft-42355.v17722587867364.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=zxto3MbuQFw"}]}},{"name":"George Michael: The Faith Tour","beginning":"2026-11-15T17:45:00+01:00","urlSlug":"6ac664a195648729052f35fa","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57808\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"111337","title":"George Michael - The Faith Tour","titleOriginal":"George Michael: The Faith Tour","urlSlug":"george-michael-the-faith-tour-6ac5c4f740d0b","duration":113,"productionYear":"2026","description":"Mit seinen Songs pr\u00e4gte er eine \u00c4ra: George Michael. Mit dem neuen Konzertfilm GEORGE MICHAEL \u2013 THE FAITH TOUR erwacht seine legend\u00e4re Faith-Tour im Kino noch einmal zum Leben, mit nie zuvor gezeigtem Material, spektakul\u00e4r \u00fcberarbeitet und remastered.\r\n\r\nGEORGE MICHAEL \u2013 THE FAITH TOUR zeigt einen der einflussreichsten Stars seiner Generation auf dem H\u00f6hepunkt seines kreativen Schaffens. Das wiederentdeckte 35-mm-Filmmaterial seines Auftritts 1988 in Paris, im Palais Omnisports de Paris-Bercy (heute Accor Arena), ist ein wahrer Gl\u00fccksfall. Dank der aufwendigen Restaurierung l\u00e4sst sich die rekordbrechende Faith-Tour noch einmal auf der gro\u00dfen Leinwand erleben. Zugleich wird ein Moment wieder lebendig, der die Popkultur nachhaltig gepr\u00e4gt hat.\r\n\r\nDen Auftakt bildet Mary McCartneys (If These Walls Could Sing) Kurzfilm Finding Faith. Neu entdeckte Bild- und Tonaufnahmen aus den Jahren 1986 bis 1988 gew\u00e4hren einen ebenso lebendigen wie intimen Einblick in George Michaels Gedankenwelt \u2013 in einer Zeit, die sein Leben und seine Karriere entscheidend ver\u00e4nderte.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Dokumentarfilm"},{"name":"Musik"}],"directors":[{"name":"Andy Morahan"},{"name":"David Austin"}],"actors":[{"name":"George Michael"},{"name":"Herb Ritts"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/george-michael-the-faith-tour-111337.v17918008587980.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=22HaIau2Dd0"}]}},{"name":"Klassiker: Your Name.","beginning":"2026-11-18T20:00:00+01:00","urlSlug":"6a9f752bb1c1c65c1b8e3b6a","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-56878\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"8470","title":"Your Name. - Gestern, heute und f\u00fcr immer","titleOriginal":"\u541b\u306e\u540d\u306f\u3002","urlSlug":"your-name-gestern-heute-und-fuer-immer","duration":111,"productionYear":"2016","description":"Mitsuha lebt gemeinsam mit ihrer kleinen Schwester Yotsuha bei ihrer Gro\u00dfmutter in einer l\u00e4ndlichen Kleinstadt Japans. Insgeheim beklagt sie ihr abgeschiedenes Dasein in der Provinz und w\u00fcnscht sich ein aufregendes Leben in der Gro\u00dfstadt. Taki w\u00fcrde sich freuen, so beschaulich aufzuwachsen, denn er wohnt in der Millionen-Metropole Tokio, verbringt viel Zeit mit seinen Freunden und jobbt neben der Schule in einem italienischen Restaurant. Eines Tages scheint Mitsuha einen Traum zu haben, in dem sie sich als Junge in Tokio wiederfindet. Parallel macht Taki eine \u00e4hnliche Erfahrung: Er findet sich als M\u00e4dchen in einer Kleinstadt in den Bergen wieder, wo er noch nie zuvor war. Doch wie kommt es zu dieser schicksalhaften Verstrickung und welches Geheimnis verbirgt sich wirklich hinter den Tr\u00e4umen der beiden Teenager? (Quelle: Verleih)","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Japan"}],"genres":[{"name":"Drama"},{"name":"Animation"},{"name":"Lovestory"}],"directors":[{"name":"Makoto Shinkai"}],"actors":[{"name":"Ry\u00fbnosuke Kamiki"},{"name":"Mone Kamishiraishi"},{"name":"Ry\u00f4 Narita"},{"name":"Aoi Yuki"},{"name":"Masami Nagasawa"},{"name":"Etsuko Ichihara"},{"name":"Nobunaga Shimazaki"},{"name":"Kaito Ishikawa"},{"name":"Kanon Tani"},{"name":"Masaki Terasoma"},{"name":"Sayaka Ohara"},{"name":"Kana Hanazawa"},{"name":"Chafurin"},{"name":"Kazuhiko Inoue"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/4\/your-name-gestern-heute-und-fuer-immer-8470.v17113444761489.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=FeSydF3JRtg"}]}},{"name":"Festtagsspa\u00df mit Peppa \u2013 Das Kinoerlebnis","beginning":"2026-11-21T11:30:00+01:00","urlSlug":"6ac664a295648729052f35fb","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57798\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"110311","title":"Festtagsspa\u00df mit Peppa - Das Kinoerlebnis","titleOriginal":"Festive Fun with Peppa","urlSlug":"festive-fun-with-peppa-cinema-experience","duration":null,"productionYear":null,"description":null,"contentRating":null,"productionCountries":[],"genres":[{"name":"Animation"},{"name":"Familie"}],"directors":[],"actors":[{"name":"Morwenna Banks"},{"name":"Richard Ridings"},{"name":"Amelie Bea Smith"}],"thumbnailImage":null,"trailers":[]}},{"name":"Festtagsspa\u00df mit Pepp