ctors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"Die Tribute von Panem - The Hunger Games","beginning":"2026-10-18T17:15:00+02:00","urlSlug":"6ac9b44fb1d7d3378168a209","deeplink":"https:\/\/kinotickets.express\/bochum-capitol\/booking\/62762","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"capitol","city":{"urlSlug":"bochum"}},"movie":{"id":"415","title":"Die Tribute von Panem - The Hunger Games","titleOriginal":"The Hunger Games","urlSlug":"die-tribute-von-panem-the-hunger-games","duration":142,"productionYear":"2012","description":"Krieg und Naturkatastrophen haben die einst m\u00e4chtigen Vereinigten Staaten in die Knie gezwungen, die St\u00e4dte zerst\u00f6rt und nichts als Verzweiflung zur\u00fcckgelassen. Aus dem Staub der Tr\u00fcmmer ist das Land Panem entstanden, das mit harter Hand regiert wird und in dem Elend und Armut herrschen. Jedes Jahr werden hier unmenschliche Hungerspiele veranstaltet, bei denen der gewinnt, der am Ende \u00fcberlebt. Als ihre Schwester f\u00fcr diesen grausamen Kampf ausgew\u00e4hlt wird, geht die junge Katniss an ihrer Stelle und trifft dabei auf Peeta - ihren Lebensretter und Gegner... (j.b.)","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"},{"name":"Thriller"}],"directors":[{"name":"Gary Ross"}],"actors":[{"name":"Josh Hutcherson"},{"name":"Stanley Tucci"},{"name":"Toby Jones"},{"name":"Jennifer Lawrence"},{"name":"Liam Hemsworth"},{"name":"Woody Harrelson"},{"name":"Elizabeth Banks"},{"name":"Lenny Kravitz"},{"name":"Donald Sutherland"},{"name":"Wes Bentley"},{"name":"Alexander Ludwig"},{"name":"Isabelle Fuhrman"},{"name":"Amandla Stenberg"},{"name":"Willow Shields"},{"name":"Sandra Ellis Lafferty"},{"name":"Paula Malcomson"},{"name":"Rhoda Griffis"},{"name":"Sandino Moya-Smith"},{"name":"Raiko Bowman"},{"name":"Dwayne Boyd"},{"name":"Anthony Reynolds"},{"name":"Judd Lormand"},{"name":"Kimiko Gelman"},{"name":"Nelson Ascencio"},{"name":"Brooke Bundy"},{"name":"Dayo Okeniyi"},{"name":"Leven Rambin"},{"name":"Jack Quaid"},{"name":"Latarsha Rose"},{"name":"Ian Nelson"},{"name":"Kalia Prescott"},{"name":"Ethan Jamieson"},{"name":"Jacqueline Emerson"},{"name":"Mackenzie Lintz"},{"name":"Imanol Yepez-Frias"},{"name":"Annie Thurman"},{"name":"Dakota Hood"},{"name":"Amber Chaney"},{"name":"Karan Kendrick"},{"name":"Shane Bissell"},{"name":"Kate Kneeland"},{"name":"Steve Coulter"},{"name":"Sharon Conley"},{"name":"Tim Taylor"},{"name":"John Ross"},{"name":"Phillip Troy Linger"},{"name":"Julie Ivey"},{"name":"Mark Meekins"},{"name":"Jeremy Marinas"},{"name":"Kelly Lynn Reiter"},{"name":"Rachel Huggins"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/4\/die-tribute-von-panem-the-hunger-games-41516976731911697673353169767335616976733571697673358169767336016976733611697673432169767344116976734541697673462169767346816976734741697673478169767413816976746.v17243749628522.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=4aenVJ5o5bY"}]}},{"name":"Innere Emigranten","beginning":"2026-10-21T18:00:00+02:00","urlSlug":"6ac8052cc35cdd1e8db397d2","deeplink":"https:\/\/kinotickets.express\/bochum-capitol\/booking\/62758","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"capitol","city":{"urlSlug":"bochum"}},"movie":{"id":"97717","title":"Innere Emigranten","titleOriginal":"Innere Emigranten","urlSlug":"innere-emigranten","duration":93,"productionYear":"2026","description":"Drei ehrenamtliche Psycholog:innen einer Moskauer Krisenhotline leisten seit Beginn des Angriffskrieges auf die Ukraine, freiwilligen Telefondienst. Die Auswirkungen der russischen Propaganda auf die eigene Bev\u00f6lkerung werden w\u00e4hrend ihrer Arbeit besonders sp\u00fcrbar. Zwischen beruflicher Verantwortung und den weitreichenden Einschr\u00e4nkungen der Meinungsfreiheit m\u00fcssen die Psycholog:innen einen Weg finden. In dem aufreibenden Balanceakt zwischen den Bed\u00fcrfnissen der Hilfesuchenden und ihrer eigenen psychischen Gesundheit, wird das Risiko sichtbar \u2013 selbst zu Kompliz:innen des totalit\u00e4ren Systems zu werden.\r\n\r\nWas bedeutet \u201eNeutralit\u00e4t\u201d? Wo sollten die Grenzen gezogen werden? Und wie setzen die Psycholog:innen diese Grenzen, w\u00e4hrend sie sich bem\u00fchen, ihre berufliche Integrit\u00e4t, pers\u00f6nliche Sicherheit und Psyche zu sch\u00fctzen?\r\n","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"},{"name":"France"}],"genres":[{"name":"Dokumentarfilm"}],"directors":[{"name":"Lena Karbe"}],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/innere-emigranten-97717.v17779709125242.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=2WMDpHh_xUc"}]}},{"name":"Clayface","beginning":"2026-10-21T20:15:00+02:00","urlSlug":"6ac65eaefc254e0db5b4c485","deeplink":"https:\/\/kinotickets.express\/bochum-capitol\/booking\/62739","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"capitol","city":{"urlSlug":"bochum"}},"movie":{"id":"110057","title":"Clayface","titleOriginal":"Clayface","urlSlug":"clayface-","duration":108,"productionYear":"2026","description":"\u201eClayface\u201c schildert den ersch\u00fctternden Niedergang eines Mannes vom aufstrebenden Hollywood-Star zum von Rachegel\u00fcsten getriebenen Monster. Die Geschichte erz\u00e4hlt vom Verlust der eigenen Identit\u00e4t und Menschlichkeit, von der zerst\u00f6rerischen Kraft der Liebe und von der Schattenseite wissenschaftlichen Ehrgeizes.","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United Sta