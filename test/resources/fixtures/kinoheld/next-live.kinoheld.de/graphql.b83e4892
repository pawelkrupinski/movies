s":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Watching People Watching Birds","beginning":"2026-10-12T17:45:00+02:00","urlSlug":"6ac4956bc3ea5a16326f7b21","deeplink":"https:\/\/kinotickets.express\/bochum-capitol\/booking\/62576","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"capitol","city":{"urlSlug":"bochum"}},"movie":{"id":"99197","title":"Watching People Watching Birds","titleOriginal":"Watching People Watching Birds","urlSlug":"watching-people-watching-birds-dok-fest","duration":92,"productionYear":"2026","description":"Politisch brisant, ernst und doch humorvoll \u2013 dieser Film begleitet Menschen mit einer Leidenschaft f\u00fcr die Vogelbeobachtung. Der weltber\u00fchmte Autor Jonathan Franzen, die B\u00e4ckereiverk\u00e4uferin, das junge Team von Ornithologen: Sie alle verbindet die Liebe zu einer stark bedrohten Art. Durch ihre Augen und Ohren tauchen wir in die Welt der V\u00f6gel ein \u2013 eine Welt, die zu einer eindringlichen Metapher f\u00fcr den Zustand unseres Planeten wird.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Dokumentarfilm"}],"directors":[{"name":"Michael Loeken"},{"name":"Ulrike Franke"}],"actors":[{"name":"Jonathan Franzen"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/watching-people-watching-birds-99197.v17881674422630.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=PgtwGs32oBs"}]}},{"name":"Primetime","beginning":"2026-10-12T17:45:00+02:00","urlSlug":"6ac4956fc3ea5a16326f7b33","deeplink":"https:\/\/kinotickets.express\/bochum-capitol\/booking\/62602","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"capitol","city":{"urlSlug":"bochum"}},"movie":{"id":"111213","title":"Primetime","titleOriginal":"Primetime","urlSlug":"primetime-","duration":111,"productionYear":"2026","description":"Mitte der 2000er-Jahre moderiert Chris Hansen in den USA die Fernsehsendung \u201eTo Catch a Predator\u201c. Mithilfe von Lockv\u00f6geln konfrontiert sein Team M\u00e4nner, die im Internet Kontakt zu vermeintlich Minderj\u00e4hrigen gesucht haben, vor laufenden Kameras. Die Sendung wird immer erfolgreicher, und mit den Einschaltquoten wachsen auch die Ambitionen der Beteiligten. Hansen, seine Produzentin Andie und der junge Schauspieler Dan setzen sich zunehmend unter Druck, immer aufsehenerregendere F\u00e4lle zu finden. W\u00e4hrend die Arbeit das Team vereinnahmt, wird Hansen von beunruhigenden Visionen verfolgt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Lance Oppenheim"}],"actors":[{"name":"Robert Pattinson"},{"name":"Skyler Gisondo"},{"name":"Merritt Wever"},{"name":"Phoebe Bridgers"},{"name":"Matthew Maher"},{"name":"Bokeem Woodbine"},{"name":"Alex Winter"},{"name":"Anna Faris"},{"name":"Eric Rahill"},{"name":"Bill Heck"},{"name":"Tony Revolori"},{"name":"Bob Ari"},{"name":"Jonathan Lipnicki"},{"name":"Matt Smith"},{"name":"Michael Chachere"},{"name":"Jessica Hecht"},{"name":"Creed Bratton"},{"name":"Franco Brocato"},{"name":"Luca Brocato"},{"name":"Jeff Zucker"},{"name":"Sean Bridgers"},{"name":"Jessica Blackmore"},{"name":"Mike Harkins"},{"name":"Daniel Garber"},{"name":"Christopher Berry"},{