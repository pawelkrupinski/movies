es":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-19T17:00:00+02:00","urlSlug":"6ace5b723e4a7433cbd4f26a","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57948\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-19T17:00:00+02:00","urlSlug":"6ace5b723e4a7433cbd4f26f","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-58031\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Whalefall","beginning":"2026-10-19T17:00:00+02:00","urlSlug":"6ace5b723e4a7433cbd4f26e","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57951\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108957","title":"Whalefall","titleOriginal":"Whalefall","urlSlug":"whalefall","duration":98,"productionYear":null,"description":"Ein Taucher wird bei der Suche nach den \u00dcberresten seines Vaters von einem 24 Meter langen, 60 Tonnen schweren Pottwal verschluckt und hat nur eine Stunde Zeit zu entkommen, bevor sein Sauerstoff ausgeht.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Thriller"}],"directors":[{"name":"Brian Duffield"}],"actors":[{"name":"Austin Abrams"},{"name":"Josh Brolin"},{"name":"Elisabeth Shue"},{"name":"John Ortiz"},{"name":"Jane Levy"},{"name":"Emily Rudd"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/whalefall-108957.v17918750680513.jpg"},"trailers":[]}},{"name":"Das gewisse Etwas","beginning":"2026-10-19T17:15:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f271","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57963\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91757","title":"Das gewisse Etwas","titleOriginal":"Das gewisse Etwas","urlSlug":"das-gewisse-etwas","duration":105,"productionYear":"2026","description":"Nach einem Juwelenraub verstecken sich Alex (Max von der Groeben) und sein Vater Karlo (Florian Lukas) ausgerechnet bei einer Gruppe junger Erwachsener mit Beeintr\u00e4chtigung, die mit ihren Betreuenden (Mala Emde, Jasmin Schwiers, Lorenzo Germeno) gerade in den Sommerurlaub aufbrechen. Die beiden Ganoven geben sich kurzerhand als der fehlende Mitreisende Otto und dessen Betreuer aus \u2013 eine fast perfekte Tarnung. Mit der Flucht vor der Polizei beginnt ein au\u00dfergew\u00f6hnliches Abenteuer, das allen Beteiligten nicht nur ungeahnte Herausforderungen beschert, sondern auch jede Menge Spa\u00df, gro\u00dfe Gef\u00fchle \u2013 und eine neue Sicht auf das Leben! \r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Marc Rothemund"}],"actors":[{"name":"Mala Emde"},{"name":"Max von der Groeben"},{"name":"Florian Lukas"},{"name":"Lorenzo Germeno"},{"name":"Jasmin Schwiers"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-gewisse-etwas-91757.v17891408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"Forgotten Island","beginning":"2026-10-19T17:15:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f270","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57965\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-19T17:30:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f272","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57962\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Jailer 2","beginning":"2026-10-19T19:30:00+02:00","urlSlug":"6abd43119c0a626e8cdc5be7","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57537\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"111409","title":"Jailer 2","titleOriginal":"\u0b9c\u0bc6\u0baf\u0bbf\u0bb2\u0bb0\u0bcd 2","urlSlug":"jailer-2","duration":160,"productionYear":null,"description":"Nach den Ereignissen in \u201eJailer\u201c muss sich der ehemals skrupellose Polizist Muthuvel Pandian einer noch gr\u00f6\u00dferen Bedrohung stellen.","contentRating":{"minimumAge":18},"productionCountries":[],"genres":[{"name":"Kom\u00f6die"},{"name":"Action"}],"directors":[{"name":"Nelson Dilipkumar"}],"actors":[{"name":"Rajinikanth"},{"name":"S. J. Suryah"},{"name":"Suraj Venjaramoodu"},{"name":"Mithun Chakraborty"},{"name":"Ramya Krishnan"},{"name":"Vidya Balan"},{"name":"Yogi Babu"},{"name":"Mirnaa"},{"name":"Rithvik"},{"name":"Jatin Sarna"},{"name":"Bagavathi Perumal"},{"name":"Kottayam Nazeer"},{"name":"Sunil Sukhada"},{"name":"Sujith Sankar"},{"name":"Hakkim Shajahan"},{"name":"Vineeth Thattil David"},{"name":"Ramachandran Durairaj"},{"name":"Namo Narayana"},{"name":"Bjorn Surrao"},{"name":"Anna Reshma Rajan"},{"name":"Tamizh"},{"name":"Saravana Vel"},{"name":"Mohanlal"},{"name":"Shiva Rajkumar"},{"name":"Hrithik Roshan"},{"name":"Vijay Sethupathi"},{"name":"Vinayakan"},{"name":"Vasanth Ravi"},{"name":"Poorna"},{"name":"Rajesh Madhavan"},{"name":"Meghana Raj"},{"name":"Santhanam"},{"name":"Upendra Limaye"},{"name":"Jaffer Sadiq"},{"name":"Vadivel Murugan"},{"name":"Apeksha Porwal"},{"name":"Nora Fatehi"},{"name":"Sunil"},{"name":"Noble K. James"},{"name":"Wamiqa Gabbi"},{"name":"Jackie Shroff"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/jailer-2-111409.v17913780934859.jpg"},"trailers":[]}},{"name":"Klassiker: Die Tribute von Panem - Catching Fire","beginning":"2026-10-19T19:30:00+02:00","urlSlug":"6ac664b495648729052f3601","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57805\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"267","title":"Die Tribute von Panem - Catching Fire","titleOriginal":"The Hunger Games: Catching Fire","urlSlug":"die-tribute-von-panem-catching-fire","duration":146,"productionYear":"2013","description":"Zwar hat Katniss die Hungerspiele \u00fcberlebt, doch damit ist f\u00fcr sie und ihren Freund Peeta das Ganze noch lange nicht vorbei. Auf ihrer Reise durch die Distrikte m\u00fcssen die beiden nicht nur weiterhin so tun, als w\u00e4ren sie ein Liebespaar, sondern die Brutalit\u00e4t der Regierung im Kapitol hautnah miterleben. Doch immer mehr zeichnet sich auch eine nahende Rebellion ab, die alles \u00e4ndern k\u00f6nnte und zu deren Symbolfigur Katniss geworden ist. Um das zu verhindern, trifft Pr\u00e4sident Snow eine Entscheidung: Es wird neue Hungerspiele geben - und Katniss muss erneut daran teilnehmen... (j.b.)","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"},{"name":"Thriller"}],"directors":[{"name":"Francis Lawrence"}],"actors":[{"name":"Philip Seymour Hoffman"},{"name":"Liam Hemsworth"},{"name":"Lenny Kravitz"},{"name":"Jennifer Lawrence"},{"name":"Josh Hutcherson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/2\/die-tribute-von-panem-catching-fire-26716976741351697674667169767694316977139661698019027169804104516981063691698106665169827899516982796691698365322169837979816984520701698473238169854189016985421701.v17244589718086.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=nJlSdw8H4QA"}]}},{"name":"Street Fighter","beginning":"2026-10-19T19:30:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f273","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57961\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108955","title":"Street Fighter","titleOriginal":"Street Fighter","urlSlug":"street-fighter-","duration":120,"productionYear":"2026","description":"Im Jahr 1993 haben sich die K\u00e4mpfer Ryu und Ken Masters voneinander entfernt. Als die r\u00e4tselhafte Chun-Li sie f\u00fcr das n\u00e4chste World Warrior Tournament anwirbt, geraten beide erneut in einen erbitterten Wettkampf. Doch hinter dem Turnier zeichnet sich eine t\u00f6dliche Verschw\u00f6rung ab. Ryu und Ken m\u00fcssen sich nicht nur ihren Gegnern stellen, sondern auch einander und den Schatten ihrer Vergangenheit. W\u00e4hrend die K\u00e4mpfe n\u00e4her r\u00fccken, bleibt offen, ob sie ihre Differenzen \u00fcberwinden k\u00f6nnen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Kitao Sakurai"}],"actors":[{"name":"Andrew Koji"},{"name":"Noah Centineo"},{"name":"Callina Liang"},{"name":"Joe Anoa'i"},{"name":"David Dastmalchian"},{"name":"Cody Rhodes"},{"name":"Andrew Schulz"},{"name":"Eric Andr\u00e9"},{"name":"Vidyut Jammwal"},{"name":"Mel Jarnson"},{"name":"Orville Peck"},{"name":"Olivier Richters"},{"name":"50 Cent"},{"name":"Jason Momoa"},{"name":"Hirooki Goto"},{"name":"Rayna Vallandingham"},{"name":"Alexander Volkanovski"},{"name":"Kyle Mooney"},{"name":"Kristy Best"},{"name":"Michael Philippou"},{"name":"Danny Philippou"},{"name":"Lannan Eacott"},{"name":"Lachlan Power"},{"name":"Curtis Jackson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/street-fighter-108955.v17905950437368.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=fLKrPneNyTA"}]}},{"name":"The Social Reckoning","beginning":"2026-10-19T19:45:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f274","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57960\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Digger","beginning":"2026-10-19T20:00:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f276","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-58032\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96021","title":"Digger","titleOriginal":"Digger","urlSlug":"digger","duration":129,"productionYear":"2026","description":"Der in die Jahre gekommene, verschrobene, milliardenschwere Erd\u00f6lmagnat Digger Rockwell (Tom Cruise) hat durch seine skrupellosen Gesch\u00e4ftstaktiken lange genug den Planeten ausgebeutet. Dadurch hat er eine Umweltkatastrophe verursacht, welche die Menschheit bedroht. Bevor die Welt im Chaos versinkt und die Apokalypse kommt, muss ein letzter Plan geschmiedet werden. Daf\u00fcr verlangt der Pr\u00e4sident der Vereinigten Staaten von Amerika (John Goodman) von Digger Rockwell, die Suppe, die er allen eingebrockt hat, selbst auszul\u00f6ffeln und die Erde zu retten. Dieser nimmt die Herausforderung an, denn als Egomane k\u00e4me es ihm ganz recht, als gro\u00dfer Retter der Menschheit dazustehen und gegen die Natur in den Krieg zu ziehen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Alejandro G. I\u00f1\u00e1rritu"}],"actors":[{"name":"Tom Cruise"},{"name":"Riz Ahmed"},{"name":"John Goodman"},{"name":"Sandra H\u00fcller"},{"name":"Michael Stuhlbarg"},{"name":"Jesse Plemons"},{"name":"Robert John Burke"},{"name":"Emma D'Arcy"},{"name":"Burn Gorman"},{"name":"Sophie Wilde"},{"name":"Pip Torrens"},{"name":"Mercedes Hern\u00e1ndez"},{"name":"Danny Kirrane"},{"name":"James Dryden"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/digger-96021.v17885811357140.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=qU-7KUMw-tk"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-19T20:00:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f275","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57959\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Whalefall","beginning":"2026-10-19T20:15:00+02:00","urlSlug":"6ace5b733e4a7433cbd4f277","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57966\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108957","title":"Whalefall","titleOriginal":"Whalefall","urlSlug":"whalefall","duration":98,"productionYear":null,"description":"Ein Taucher wird bei der Suche nach den \u00dcberresten seines Vaters von einem 24 Meter langen, 60 Tonnen schweren Pottwal verschluckt und hat nur eine Stunde Zeit zu entkommen, bevor sein Sauerstoff ausgeht.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Thriller"}],"directors":[{"name":"Brian Duffield"}],"actors":[{"name":"Austin Abrams"},{"name":"Josh Brolin"},{"name":"Elisabeth Shue"},{"name":"John Ortiz"},{"name":"Jane Levy"},{"name":"Emily Rudd"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/whalefall-108957.v17918750680513.jpg"},"trailers":[]}},{"name":"Eiserne Wildnis - Heart of the Beast","beginning":"2026-10-19T20:15:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f278","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57967\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"104697","title":"Eiserne Wildnis - Heart of the Beast","titleOriginal":"Heart of the Beast","urlSlug":"eiserne-wildnis-heart-of-the-beast","duration":101,"productionYear":"2026","description":"Nach einem Flugzeugabsturz stranden der Special-Forces-Offizier James Belmont und sein Milit\u00e4rhund Odin tief in der Wildnis Alaskas. Ohne vertraute Umgebung beginnt f\u00fcr sie ein Kampf gegen die Elemente. Um zu \u00fcberleben, m\u00fcssen Mensch und Tier zusammenhalten und sich aufeinander verlassen. Ihre enge Verbindung wird dabei auf die Probe gestellt: Gemeinsam versuchen sie, den Gefahren der Natur standzuhalten und sich in einer Lage zu behaupten, in der sie ganz auf sich gestellt sind.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Thriller"}],"directors":[{"name":"David Ayer"}],"actors":[{"name":"Brad Pitt"},{"name":"J.K. Simmons"},{"name":"Anna Lambe"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/eiserne-wildnis-heart-of-the-beast-104697.v17863488342134.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=JWjDIeEec1g&list=PLz3nyt80mNyFyNtkMADyjYzs_6AQA30iz&index=2"}]}},{"name":"Minions & Monster","beginning":"2026-10-20T11:30:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f279","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57999\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"66263","title":"MINIONS & MONSTER","titleOriginal":"Minions 3","urlSlug":"minions-4","duration":90,"productionYear":"2026","description":"MINIONS & MONSTER erz\u00e4hlt die abgefahrene, aberwitzige und nat\u00fcrlich absolut wahre Geschichte von den Minions und wie sie Hollywood erobern, Filmstars werden, alles verlieren, Monster auf die Welt loslassen und sich dann heldenhaft daranmachen, den Planeten vor genau dem Chaos zu retten, das sie selbst angerichtet haben.\r\n\r\nIn den mehr als zehn Jahren seit ihrem ersten Auftritt sind die Minions die absoluten Kult-Animationsfiguren ihrer Generation geworden. Global bekannt und von Fans jeden Alters geliebt, haben die Illumination Franchises Ich \u2013 Einfach unverbesserlich und Minions weltweit mehr als 5,6 Milliarden US-Dollar an den Kinokassen eingespielt.\r\n\r\nMINIONS & MONSTER wird von dem Oscar\u00ae-nominierten Regisseur Pierre Coffin inszeniert, der bereits f\u00fcr die ersten drei Ich \u2013 Einfach unverbesserlich-Filme und den ersten Minions-Film verantwortlich zeichnete. Au\u00dferdem leiht Coffin den Minions seit ihrem Filmdeb\u00fct 2010 seine Stimme. Das Drehbuch stammt von Brian Lynch (Minions, Pets-Filme) und Pierre Coffin. Produziert wird der Film von Chris Meledandri, dem Oscar\u00ae-nominierten Gr\u00fcnder und CEO von Illumination, und Bill Ryan (Executive Producer von Der Super Mario Bros. Film).","contentRating":{"minimumAge":6},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Pierre Coffin"}],"actors":[{"name":"Allison Janney"},{"name":"Christoph Waltz"},{"name":"Jeff Bridges"},{"name":"Trey Parker"},{"name":"Bobby Moynihan"},{"name":"Phil LaMarr"},{"name":"Jesse Eisenberg"},{"name":"Zoey Deutch"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/minions-4-66263.v17784969226410.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EabfVeaKpoA"}]}},{"name":"David","beginning":"2026-10-20T11:30:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27b","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57993\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"92515","title":"David","titleOriginal":"David","urlSlug":"david-699d32065070f","duration":109,"productionYear":"2025","description":"In einem K\u00f6nigreich, zerrissen von Angst und Korruption, w\u00e4chst ein junger Hirte in Bethlehem auf \u2013 unscheinbar, aber mit einem gro\u00dfen Herzen. Als der Krieger Goliath ein ganzes Volk bedroht, tritt David mit nichts als seinem Glauben und einer Schleuder gegen den Riesen an \u2013 und ver\u00e4ndert die Geschichte f\u00fcr immer.\r\n\r\nDoch der Sieg ist erst der Anfang. Zwischen Loyalit\u00e4t und \u00dcberleben, Freundschaft und Schicksal wird Davids Mut auf eine harte Probe gestellt. Auf seinem Weg vom Hirtenjungen zum K\u00f6nig nach dem Herzen Gottes entdeckt er, was es wirklich hei\u00dft, mit \u00dcberzeugung zu f\u00fchren und Gr\u00f6\u00dfe mit Demut zu verbinden.","contentRating":null,"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Animation"},{"name":"Familie"}],"directors":[{"name":"Phil Cunningham"},{"name":"Brent Dawes"}],"actors":[{"name":"Adam Gold"},{"name":"Brandon Engman"},{"name":"Brian Stivale"},{"name":"Shahar Taboch"},{"name":"Aaron Tavaler"},{"name":"Hector"},{"name":"Miri Mesika"},{"name":"Jack Wagman"},{"name":"Jonathan Shaboo"},{"name":"Sloan Lucas Muldown"},{"name":"Mike Ciporkin"},{"name":"Katie Bernstein"},{"name":"Lauren Daigle"},{"name":"Mark Jacobson"},{"name":"Nitzan Sitzer"},{"name":"Adam Meir"},{"name":"Asim Chaudhry"},{"name":"Kamran Nikhad"},{"name":"Phil Wickham"},{"name":"David Rosenberg"},{"name":"Ashley Boettcher"},{"name":"Mick Wingert"},{"name":"Mark Whitten"},{"name":"Doron Rechlis"},{"name":"Will De Renzy-Martin"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/david-92515.v17721145596603.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=ZHNPwUOI1KI"}]}},{"name":"Monster Mia","beginning":"2026-10-20T11:30:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27a","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57992\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105593","title":"Monster Mia","titleOriginal":"Monster Mia","urlSlug":"monster-mia","duration":81,"productionYear":"2026","description":"Die quirlige Au\u00dfenseiterin Mia ist fest davon \u00fcberzeugt: Monster gibt es wirklich! Als sie mit ihrer Monsterbegeisterung zu weit geht, fliegt sie von der Schule und landet ausgerechnet an der schaurig-sch\u00f6nen Finsterwald Academy. Dort entdeckt Mia eine Welt voller Geheimnisse: Flederm\u00e4use unter dem Dach, ein mysteri\u00f6ser Schulleiter und Mitsch\u00fcler, die tats\u00e4chlich echte Monster sind. F\u00fcr Mia geht ein Traum in Erf\u00fcllung! Doch Menschen sind an der Finsterwald Academy alles andere als willkommen, und so muss Mia allerlei Tricks einsetzen, um selbst als waschechtes Monster durchzugehen. Bis sie hinter die d\u00fcsteren Pl\u00e4ne von Schulleiter Van Vlad kommt, der alle Menschen in Monster verwandeln will. Jetzt liegt es an Mia, ihre Freunde zu retten und zu beweisen, dass manchmal gerade die ungew\u00f6hnlichsten Monster die gr\u00f6\u00dften Helden sind.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"},{"name":"Austria"},{"name":"Spain"}],"genres":[{"name":"Animation"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Verena Fels"}],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/monster-mia-105593.v17853746005536.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=RB10MT41GY0"}]}},{"name":"PAW Patrol: Der Dino Film","beginning":"2026-10-20T11:45:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27c","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57996\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"100821","title":"Paw Patrol: Der Dino Film","titleOriginal":"Paw Patrol 3","urlSlug":"paw-patrol-der-dino-film-3","duration":83,"productionYear":"2026","description":"Nach einem Sturm landet die Paw Patrol auf einer geheimnisvollen Dinosaurierinsel, wo sie den gestrandeten Welpen Rex trifft. Als Humdinger mit seinem r\u00fccksichtslosen Bergbau einen Vulkan zum Ausbruch bringt, steht das Team vor seiner bislang gr\u00f6\u00dften Rettungsmission: Es muss die Insel und ihre Bewohner vor der Katastrophe bewahren.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Canada"},{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Cal Brunker"}],"actors":[{"name":"Carter Young"},{"name":"Hayden Chamberlen"},{"name":"Mckenna Grace"},{"name":"Rain Janjua"},{"name":"Henry Bolan"},{"name":"Lucien Duncan-Reid"},{"name":"Nylan Parthipan"},{"name":"William Desrosiers"},{"name":"Jennifer Hudson"},{"name":"Fortune Feimster"},{"name":"Jameela Jamil"},{"name":"Terry Crews"},{"name":"Paris Hilton"},{"name":"Snoop Dogg"},{"name":"Bill Nye"},{"name":"Meredith MacNeill"},{"name":"Ron Pardo"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/paw-patrol-der-dino-film-100821.v17833263332096.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=OHGIHaDxYy8"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-20T11:45:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27e","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57998\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Forgotten Island","beginning":"2026-10-20T11:45:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27d","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57997\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-20T12:00:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f280","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57995\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-20T12:00:00+02:00","urlSlug":"6ace5b743e4a7433cbd4f27f","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57994\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Spider-Man: Brand New Day","beginning":"2026-10-20T13:30:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f281","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57991\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"111095","title":"Spider-Man: Brand New Day","titleOriginal":"Spider-Man: Brand New Day","urlSlug":"spider-man-brand-new-day-","duration":150,"productionYear":"2026","description":"Vier Jahre sind seit den Ereignissen von \u201eNo Way Home\u201c vergangen. Peter ist nun erwachsen und lebt f\u00fcr sich allein, nachdem er sich freiwillig aus dem Leben und den Erinnerungen derer, die er liebt, ausgel\u00f6scht hat. Er bek\u00e4mpft Verbrechen in einem New York, das ihn und seinen Namen nicht mehr kennt, und widmet sich ganz dem Schutz seiner Stadt: Spider-Man in Vollzeit. Doch mit den steigenden Anforderungen l\u00f6st der Druck eine \u00fcberraschende k\u00f6rperliche Ver\u00e4nderung aus, die seine Existenz bedroht \u2013 gerade als eine seltsame neue Art von Verbrechen eine der m\u00e4chtigsten Bedrohungen hervorbringt, denen er je gegen\u00fcberstand.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Destin Daniel Cretton"}],"actors":[{"name":"Tom Holland"},{"name":"Sadie Sink"},{"name":"Tramell Tillman"},{"name":"Zendaya"},{"name":"Jacob Batalon"},{"name":"Jon Bernthal"},{"name":"Mark Ruffalo"},{"name":"Florence Pugh"},{"name":"Liza Col\u00f3n-Zayas"},{"name":"Marisa Tomei"},{"name":"Naomi Watts"},{"name":"Michael Mando"},{"name":"Keith David"},{"name":"Marvin Jones III"},{"name":"Olivia Booth-Ford"},{"name":"Taryn Marie Butler"},{"name":"Johnny Myers"},{"name":"Billy Clements"},{"name":"Zabryna Guevara"},{"name":"Nina Rose Galano"},{"name":"Maikol Roque"},{"name":"Jamel Davall Rodriguez"},{"name":"Ethan Sokontwe"},{"name":"Tariy\u00e9 Peterside"},{"name":"Phoenix Di Sebastiani"},{"name":"Vivien Keene"},{"name":"Kurtis Lowe"},{"name":"Marc Small"},{"name":"David Hepple"},{"name":"Jamaal Burcher"},{"name":"Lieve Carchon"},{"name":"Mary Stillwaggon Stewart"},{"name":"Luka Hays"},{"name":"Camila L\u00f3pez"},{"name":"Robert Veng"},{"name":"Aoife Haakenson"},{"name":"Gabriel Blaikie"},{"name":"Eman Esfandi"},{"name":"Shing Moussa Chung"},{"name":"Akil Young"},{"name":"Benedict Cezair-Thompson"},{"name":"Shannon Young Cho"},{"name":"Niyi Akin"},{"name":"Carlos Agualusa"},{"name":"Shelley Williams"},{"name":"Jud Charlton"},{"name":"John Moraitis"},{"name":"Beatriz Do O"},{"name":"Daisy Sequerra"},{"name":"Nezar Alderazi"},{"name":"Daniel Kabanda"},{"name":"Michael Magnet"},{"name":"Simon Schatzberger"},{"name":"Sean Carrington"},{"name":"Anthony Nyro"},{"name":"Michael Amariah"},{"name":"Fan Xiaoshuang"},{"name":"Elvis Carlos"},{"name":"Pat Kiernan"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/spider-man-brand-new-day-111095.v17914340344769.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=6S1CDWZfuM0"}]}},{"name":"Street Fighter","beginning":"2026-10-20T14:10:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f282","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57971\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108955","title":"Street Fighter","titleOriginal":"Street Fighter","urlSlug":"street-fighter-","duration":120,"productionYear":"2026","description":"Im Jahr 1993 haben sich die K\u00e4mpfer Ryu und Ken Masters voneinander entfernt. Als die r\u00e4tselhafte Chun-Li sie f\u00fcr das n\u00e4chste World Warrior Tournament anwirbt, geraten beide erneut in einen erbitterten Wettkampf. Doch hinter dem Turnier zeichnet sich eine t\u00f6dliche Verschw\u00f6rung ab. Ryu und Ken m\u00fcssen sich nicht nur ihren Gegnern stellen, sondern auch einander und den Schatten ihrer Vergangenheit. W\u00e4hrend die K\u00e4mpfe n\u00e4her r\u00fccken, bleibt offen, ob sie ihre Differenzen \u00fcberwinden k\u00f6nnen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Kitao Sakurai"}],"actors":[{"name":"Andrew Koji"},{"name":"Noah Centineo"},{"name":"Callina Liang"},{"name":"Joe Anoa'i"},{"name":"David Dastmalchian"},{"name":"Cody Rhodes"},{"name":"Andrew Schulz"},{"name":"Eric Andr\u00e9"},{"name":"Vidyut Jammwal"},{"name":"Mel Jarnson"},{"name":"Orville Peck"},{"name":"Olivier Richters"},{"name":"50 Cent"},{"name":"Jason Momoa"},{"name":"Hirooki Goto"},{"name":"Rayna Vallandingham"},{"name":"Alexander Volkanovski"},{"name":"Kyle Mooney"},{"name":"Kristy Best"},{"name":"Michael Philippou"},{"name":"Danny Philippou"},{"name":"Lannan Eacott"},{"name":"Lachlan Power"},{"name":"Curtis Jackson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/street-fighter-108955.v17905950437368.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=fLKrPneNyTA"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-20T14:15:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f284","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57970\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Monster Mia","beginning":"2026-10-20T14:15:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f283","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57969\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105593","title":"Monster Mia","titleOriginal":"Monster Mia","urlSlug":"monster-mia","duration":81,"productionYear":"2026","description":"Die quirlige Au\u00dfenseiterin Mia ist fest davon \u00fcberzeugt: Monster gibt es wirklich! Als sie mit ihrer Monsterbegeisterung zu weit geht, fliegt sie von der Schule und landet ausgerechnet an der schaurig-sch\u00f6nen Finsterwald Academy. Dort entdeckt Mia eine Welt voller Geheimnisse: Flederm\u00e4use unter dem Dach, ein mysteri\u00f6ser Schulleiter und Mitsch\u00fcler, die tats\u00e4chlich echte Monster sind. F\u00fcr Mia geht ein Traum in Erf\u00fcllung! Doch Menschen sind an der Finsterwald Academy alles andere als willkommen, und so muss Mia allerlei Tricks einsetzen, um selbst als waschechtes Monster durchzugehen. Bis sie hinter die d\u00fcsteren Pl\u00e4ne von Schulleiter Van Vlad kommt, der alle Menschen in Monster verwandeln will. Jetzt liegt es an Mia, ihre Freunde zu retten und zu beweisen, dass manchmal gerade die ungew\u00f6hnlichsten Monster die gr\u00f6\u00dften Helden sind.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"},{"name":"Austria"},{"name":"Spain"}],"genres":[{"name":"Animation"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Verena Fels"}],"actors":[],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/monster-mia-105593.v17853746005536.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=RB10MT41GY0"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-20T14:30:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f285","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57980\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Forgotten Island","beginning":"2026-10-20T14:30:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f286","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57981\/seats","flags":[{"category":"TECHNOLOGY","code":"3d"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-20T14:45:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f288","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57979\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-20T14:45:00+02:00","urlSlug":"6ace5b753e4a7433cbd4f287","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57978\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Whalefall","beginning":"2026-10-20T16:45:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f289","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57977\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108957","title":"Whalefall","titleOriginal":"Whalefall","urlSlug":"whalefall","duration":98,"productionYear":null,"description":"Ein Taucher wird bei der Suche nach den \u00dcberresten seines Vaters von einem 24 Meter langen, 60 Tonnen schweren Pottwal verschluckt und hat nur eine Stunde Zeit zu entkommen, bevor sein Sauerstoff ausgeht.","contentRating":{"minimumAge":16},"productionCountries":[],"genres":[{"name":"Thriller"}],"directors":[{"name":"Brian Duffield"}],"actors":[{"name":"Austin Abrams"},{"name":"Josh Brolin"},{"name":"Elisabeth Shue"},{"name":"John Ortiz"},{"name":"Jane Levy"},{"name":"Emily Rudd"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/whalefall-108957.v17918750680513.jpg"},"trailers":[]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-20T17:00:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28b","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57975\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-20T17:00:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28a","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57974\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-20T17:00:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28c","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-58033\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Das gewisse Etwas","beginning":"2026-10-20T17:15:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28d","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57990\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91757","title":"Das gewisse Etwas","titleOriginal":"Das gewisse Etwas","urlSlug":"das-gewisse-etwas","duration":105,"productionYear":"2026","description":"Nach einem Juwelenraub verstecken sich Alex (Max von der Groeben) und sein Vater Karlo (Florian Lukas) ausgerechnet bei einer Gruppe junger Erwachsener mit Beeintr\u00e4chtigung, die mit ihren Betreuenden (Mala Emde, Jasmin Schwiers, Lorenzo Germeno) gerade in den Sommerurlaub aufbrechen. Die beiden Ganoven geben sich kurzerhand als der fehlende Mitreisende Otto und dessen Betreuer aus \u2013 eine fast perfekte Tarnung. Mit der Flucht vor der Polizei beginnt ein au\u00dfergew\u00f6hnliches Abenteuer, das allen Beteiligten nicht nur ungeahnte Herausforderungen beschert, sondern auch jede Menge Spa\u00df, gro\u00dfe Gef\u00fchle \u2013 und eine neue Sicht auf das Leben! \r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Marc Rothemund"}],"actors":[{"name":"Mala Emde"},{"name":"Max von der Groeben"},{"name":"Florian Lukas"},{"name":"Lorenzo Germeno"},{"name":"Jasmin Schwiers"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-gewisse-etwas-91757.v17891408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"Forgotten Island","beginning":"2026-10-20T17:15:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28f","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57973\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Street Fighter","beginning":"2026-10-20T17:15:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f28e","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57972\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108955","title":"Street Fighter","titleOriginal":"Street Fighter","urlSlug":"street-fighter-","duration":120,"productionYear":"2026","description":"Im Jahr 1993 haben sich die K\u00e4mpfer Ryu und Ken Masters voneinander entfernt. Als die r\u00e4tselhafte Chun-Li sie f\u00fcr das n\u00e4chste World Warrior Tournament anwirbt, geraten beide erneut in einen erbitterten Wettkampf. Doch hinter dem Turnier zeichnet sich eine t\u00f6dliche Verschw\u00f6rung ab. Ryu und Ken m\u00fcssen sich nicht nur ihren Gegnern stellen, sondern auch einander und den Schatten ihrer Vergangenheit. W\u00e4hrend die K\u00e4mpfe n\u00e4her r\u00fccken, bleibt offen, ob sie ihre Differenzen \u00fcberwinden k\u00f6nnen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Kitao Sakurai"}],"actors":[{"name":"Andrew Koji"},{"name":"Noah Centineo"},{"name":"Callina Liang"},{"name":"Joe Anoa'i"},{"name":"David Dastmalchian"},{"name":"Cody Rhodes"},{"name":"Andrew Schulz"},{"name":"Eric Andr\u00e9"},{"name":"Vidyut Jammwal"},{"name":"Mel Jarnson"},{"name":"Orville Peck"},{"name":"Olivier Richters"},{"name":"50 Cent"},{"name":"Jason Momoa"},{"name":"Hirooki Goto"},{"name":"Rayna Vallandingham"},{"name":"Alexander Volkanovski"},{"name":"Kyle Mooney"},{"name":"Kristy Best"},{"name":"Michael Philippou"},{"name":"Danny Philippou"},{"name":"Lannan Eacott"},{"name":"Lachlan Power"},{"name":"Curtis Jackson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/street-fighter-108955.v17905950437368.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=fLKrPneNyTA"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-20T17:30:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f290","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57989\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Street Fighter","beginning":"2026-10-20T19:30:00+02:00","urlSlug":"6ace5b763e4a7433cbd4f291","deeplink":"https:\/\/web.filmwerk-gt.de\/order\/showtimes\/1000-57988\/seats","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"cinestar","city":{"urlSlug":"guetersloh"}},"movie":{"id":"108955","title":"Street Fighter","titleOriginal":"Street Fighter","urlSlug":"street-fighter-","duration":120,"productionYear":"2026","description":"Im Jahr 1993 haben sich die K\u00e4mpfer Ryu und Ken Masters voneinander entfernt. Als die r\u00e4tselhafte Chun-Li sie f\u00fcr das n\u00e4chste World Warrior Tournament anwirbt, geraten beide erneut in einen erbitterten Wettkampf. Doch hinter dem Turnier zeichnet sich eine t\u00f6dliche Verschw\u00f6rung ab. Ryu und Ken m\u00fcssen sich nicht nur ihren Gegnern stellen, sondern auch einander und den Schatten ihrer Vergangenheit. W\u00e4hrend die K\u00e4mpfe n\u00e4her r\u00fccken, bleibt offen, ob sie ihre Differenzen \u00fcberwinden k\u00f6nnen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Kitao Sakurai"}],"actors":[{"name":"Andrew Koji"},{"name":"Noah Centineo"},{"name":"Callina Liang"},{"name":"Joe Anoa'i"},{"name":"David Dastmalchian"},{"name":"Cody Rhodes"},{"name":"Andrew Schulz"},{"name":"Eric Andr\u00e9"},{"name":"Vidyut Jammwal"},{"name":"Mel Jarnson"},{"name":"Orville Peck"},{"name":"Olivier Richters"},{"name":"50 Cent"},{"name":"Jason Momoa"},{"name":"Hirooki Goto"},{"name":"Rayna Vallandingham"},{"name":"Alexander Volkanovski"},{"name":"Kyle Mooney"},{"name":"Kristy Best"},{"name":"Michael Philippou"},{"name":"Danny Philippou"},{"name":"Lannan Eacott"},{"name":"Lachlan Power"},{"name":"Curtis Jackson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/street-fighter-108955.v17905950437368.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=fLKrPneNyTA"}]}}]}}}