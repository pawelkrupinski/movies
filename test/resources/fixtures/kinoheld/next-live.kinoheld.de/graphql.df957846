e":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"Forgotten Island","beginning":"2026-10-13T20:50:00+02:00","urlSlug":"146133","deeplink":null,"flags":[{"category":"TECHNOLOGY","code":"3d"}],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Bibi Blocksberg - Die total verhexte Zeitreise","beginning":"2026-10-14T16:00:00+02:00","urlSlug":"146088","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 5"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"105743","title":"Bibi Blocksberg - Die total verhexte Zeitreise","titleOriginal":"Bibi Blocksberg - Die total verhexte Zeitreise","urlSlug":"bibi-blocksberg-die-total-verhexte-zeitreise-6a6ec17973b72","duration":90,"productionYear":"2026","description":"Bibi Blocksberg hat die Anmeldung f\u00fcr das Schulpraktikum verpasst und bekommt nur noch einen Platz im Museum. Dort hilft sie bei den Vorbereitungen f\u00fcr eine Ausstellung, als eine wertvolle Spieluhr verschwindet. Um herauszufinden, was geschehen ist, hext sich Bibi mit ihrer Freundin Marita in die Nacht des Einbruchs zur\u00fcck. Stattdessen landen die beiden 139 Jahre in der Vergangenheit auf Schloss Klunkerburg. Dort treffen sie Fritzi, deren Tante ein Spieluhr-Erbst\u00fcck an sich bringen will. Bibi und Marita versuchen, Fritzi zu helfen und einen Weg zur\u00fcck in ihre Zeit zu finden.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Gregor Schnitzler"}],"actors":[{"name":"Nala"},{"name":"Fia-Marie Lin"},{"name":"Fritzi Haberlandt"},{"name":"Friedrich M\u00fccke"},{"name":"Rosalie Thomass"},{"name":"Palina Rojinski"},{"name":"Carla Demmin"},{"name":"Philomena Amari"},{"name":"Nilam Farooq"},{"name":"Thorsten Merten"},{"name":"Ludger B\u00f6kelmann"},{"name":"Langston Uibel"},{"name":"Carmen Diego"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/bibi-blocksberg-die-total-verhexte-zeitreise-105743.v17856433881906.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=n8BFBzShKhg"}]}},{"name":"Emil und die Detektive","beginning":"2026-10-14T16:00:00+02:00","urlSlug":"146242","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 6"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"91881","title":"Emil und die Detektive","titleOriginal":"Emil und die Detektive","urlSlug":"emil-und-die-detektive-69940b0eb9c8b","duration":100,"productionYear":"2026","description":"Emil soll die Sommerferien bei seiner Gro\u00dfmutter in Berlin verbringen. Doch die Reise nimmt eine unerwartete Wendung: Im Zug stiehlt ihm der Betr\u00fcger Max Grundeis sein Geld. Emil will den Diebstahl nicht hinnehmen und folgt dem Mann durch die Stadt. Dort bekommt er Unterst\u00fctzung von Pony, Gustav, Dienstag, Anh und Jason. Gemeinsam machen sich die Kinder auf die Suche nach Grundeis und verfolgen seine Spur quer durch Berlin. Aus dem geplanten Besuch bei der Gro\u00dfmutter wird f\u00fcr Emil eine Detektivjagd, bei der er sich auf seine neuen Freunde verlassen kann.","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Abenteuer"}],"directors":[{"name":"David Dietl"}],"actors":[{"name":"Nicholas Jonah Peter"},{"name":"Merlin Sandmeyer"},{"name":"Luise Heyer"},{"name":"Lara Toni L\u00fcdders"},{"name":"Kilian Kasa"},{"name":"Bela Louis Plass"},{"name":"Ai Vy Bui"},{"name":"Camille Moltzen"},{"name":"Ursula Werner"},{"name":"Danilo Kamperidis"},{"name":"Amy Mu\u00dful"},{"name":"Yung Ngo"},{"name":"Anna Stieblich"},{"name":"Timo Weisschnur"},{"name":"Zah1de"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/emil-und-die-detektive-91881.v17912168110727.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=HCnFyyvkM5s"}]}},{"name":"Forgotten Island","beginning":"2026-10-14T16:00:00+02:00","urlSlug":"146197","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 4"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-14T16:00:00+02:00","urlSlug":"146149","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Toy Story 5","beginning":"2026-10-14T16:00:00+02:00","urlSlug":"146115","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"89785","title":"Toy Story 5","titleOriginal":"Toy Story 5","urlSlug":"toy-story-5","duration":90,"productionYear":"2026","description":"Die Aufgaben von Buzz, Woody, Jessie und Co. werden immer schwieriger, wenn sie es mit einer ganz neuen Bedrohung der Spielzeit zu tun bekommen: der Technik.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Familie"}],"directors":[{"name":"Andrew Stanton"}],"actors":[{"name":"Tom Hanks"},{"name":"Tim Allen"},{"name":"Joan Cusack"},{"name":"Greta Lee"},{"name":"Craig Robinson"},{"name":"Anna Faris"},{"name":"Tony Hale"},{"name":"Jay Hernandez"},{"name":"Lori Alan"},{"name":"Bonnie Hunt"},{"name":"Kristen Schaal"},{"name":"Wallace Shawn"},{"name":"John Ratzenberger"},{"name":"Blake Clark"},{"name":"Ernie Hudson"},{"name":"Jeff Garlin"},{"name":"Melissa Villase\u00f1or"},{"name":"Timothy Dalton"},{"name":"Jeff Pidgeon"},{"name":"Conan O'Brien"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/toy-story-5-89785.v17706383471510.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=QasqRjb5jV4"}]}},{"name":"Das gewisse Etwas","beginning":"2026-10-14T16:20:00+02:00","urlSlug":"146124","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"91757","title":"Das gewisse Etwas","titleOriginal":"Das gewisse Etwas","urlSlug":"das-gewisse-etwas","duration":105,"productionYear":"2026","description":"Nach einem Juwelenraub verstecken sich Alex (Max von der Groeben) und sein Vater Karlo (Florian Lukas) ausgerechnet bei einer Gruppe junger Erwachsener mit Beeintr\u00e4chtigung, die mit ihren Betreuenden (Mala Emde, Jasmin Schwiers, Lorenzo Germeno) gerade in den Sommerurlaub aufbrechen. Die beiden Ganoven geben sich kurzerhand als der fehlende Mitreisende Otto und dessen Betreuer aus \u2013 eine fast perfekte Tarnung. Mit der Flucht vor der Polizei beginnt ein au\u00dfergew\u00f6hnliches Abenteuer, das allen Beteiligten nicht nur ungeahnte Herausforderungen beschert, sondern auch jede Menge Spa\u00df, gro\u00dfe Gef\u00fchle \u2013 und eine neue Sicht auf das Leben! \r\n\r\n","contentRating":{"minimumAge":6},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Marc Rothemund"}],"actors":[{"name":"Mala Emde"},{"name":"Max von der Groeben"},{"name":"Florian Lukas"},{"name":"Lorenzo Germeno"},{"name":"Jasmin Schwiers"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/das-gewisse-etwas-91757.v17891408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T16:30:00+02:00","urlSlug":"146169","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"My Private Lumen"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T16:40:00+02:00","urlSlug":"146112","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 7"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Eiserne Wildnis - Heart Of The Beast","beginning":"2026-10-14T18:00:00+02:00","urlSlug":"146228","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 5"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"104697","title":"Eiserne Wildnis - Heart of the Beast","titleOriginal":"Heart of the Beast","urlSlug":"eiserne-wildnis-heart-of-the-beast","duration":101,"productionYear":"2026","description":"Nach einem Flugzeugabsturz stranden der Special-Forces-Offizier James Belmont und sein Milit\u00e4rhund Odin tief in der Wildnis Alaskas. Ohne vertraute Umgebung beginnt f\u00fcr sie ein Kampf gegen die Elemente. Um zu \u00fcberleben, m\u00fcssen Mensch und Tier zusammenhalten und sich aufeinander verlassen. Ihre enge Verbindung wird dabei auf die Probe gestellt: Gemeinsam versuchen sie, den Gefahren der Natur standzuhalten und sich in einer Lage zu behaupten, in der sie ganz auf sich gestellt sind.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Thriller"}],"directors":[{"name":"David Ayer"}],"actors":[{"name":"Brad Pitt"},{"name":"J.K. Simmons"},{"name":"Anna Lambe"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/eiserne-wildnis-heart-of-the-beast-104697.v17863488342134.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=JWjDIeEec1g&list=PLz3nyt80mNyFyNtkMADyjYzs_6AQA30iz&index=2"}]}},{"name":"Resident Evil","beginning":"2026-10-14T18:00:00+02:00","urlSlug":"146211","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 6"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"Verity - Dunkle Geheimnisse","beginning":"2026-10-14T18:00:00+02:00","urlSlug":"146170","deeplink":null,"flags":[{"category":"TECHNOLOGY","code":"dbox"}],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"101987","title":"Verity \u2013 Dunkle Geheimnisse","titleOriginal":"Verity","urlSlug":"verity-dunkle-geheimnisse-","duration":114,"productionYear":"2026","description":"Die Schriftstellerin Lowen Ashleigh hat bislang wenig Erfolg. Als sie das Angebot erh\u00e4lt, f\u00fcr die bekannte Autorin Verity Crawford als Ghostwriterin zu arbeiten, zieht sie auf das abgelegene Anwesen der Familie Crawford. Dort st\u00f6\u00dft Lowen auf Aufzeichnungen, die Verity offenbar \u00fcber ihr eigenes Leben verfasst hat. Was darin \u00fcber Veritys Ehemann Jeremy steht, verst\u00f6rt Lowen zunehmend. W\u00e4hrend sie versucht, die Hintergr\u00fcnde zu verstehen, wird immer unklarer, ob die Texte Erlebtes schildern oder erfunden sind. Auch ihre Gef\u00fchle f\u00fcr Jeremy machen es ihr schwer, den Ereignissen zu trauen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Mystery"}],"directors":[{"name":"Michael Showalter"}],"actors":[{"name":"Dakota Johnson"},{"name":"Anne Hathaway"},{"name":"Josh Hartnett"},{"name":"Ismael Cruz C\u00f3rdova"},{"name":"Brady Wagner"},{"name":"Irina Dvorovenko"},{"name":"Michael Abbott Jr."},{"name":"K.K. Moggie"},{"name":"Alex Cooper"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/verity-dunkle-geheimnisse-101987.v17863675550376.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=_ohZppCclN4&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=11"}]}},{"name":"The Social Reckoning","beginning":"2026-10-14T18:10:00+02:00","urlSlug":"146101","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 1"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"107363","title":"The Social Reckoning","titleOriginal":"The Social Reckoning","urlSlug":"the-social-reckoning-","duration":120,"productionYear":"2026","description":"Die junge Facebook-Ingenieurin Frances Haugen wendet sich an Jeff Horwitz, einen Reporter des Wall Street Journal. Gemeinsam wollen sie Geheimnisse des sozialen Netzwerks ans Licht bringen. Damit stellen sie sich einem m\u00e4chtigen Konzern entgegen und begeben sich auf einen gef\u00e4hrlichen Weg. Der von wahren Begebenheiten inspirierte Film begleitet Haugen und Horwitz bei ihrem Versuch, Informationen \u00fcber Facebook \u00f6ffentlich zu machen. Was sie aufdecken wollen, betrifft einen der gr\u00f6\u00dften Social-Media-Konzerne der Welt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Drama"},{"name":"Thriller"}],"directors":[{"name":"Aaron Sorkin"}],"actors":[{"name":"Mikey Madison"},{"name":"Jeremy Allen White"},{"name":"Jeremy Strong"},{"name":"Wunmi Mosaku"},{"name":"Betty Gilpin"},{"name":"Billy Magnussen"},{"name":"Bill Burr"},{"name":"Gbenga Akinnagbe"},{"name":"Anna Lambe"},{"name":"Aidan Laprete"},{"name":"Kelley Pereira"},{"name":"Nelson Franklin"},{"name":"Portia Doubleday"},{"name":"Patrick Fischler"},{"name":"Joseph Brooks"},{"name":"Sierra Capri"},{"name":"Tehmina Sunny"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/the-social-reckoning-107363.v17901714220605.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=3lDnIvr5FKE&list=PLV8SYu5H_eOKSKr_OyL-TPh9g5Ch_I9zL&index=3"}]}},{"name":"Shaun das Schaf - Spuk im K\u00fcrbisfeld","beginning":"2026-10-14T18:20:00+02:00","urlSlug":"146178","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 4"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96025","title":"Shaun das Schaf \u2013 Spuk im K\u00fcrbisfeld","titleOriginal":"Shaun The Sheep: The Beast Of Mossy Bottom","urlSlug":"shaun-das-schaf-spuk-im-kuerbisfeld-2026","duration":80,"productionYear":"2026","description":"Auf der Mossy-Bottom-Farm bereiten sich Shaun und die Schafherde auf Halloween vor. Doch kurz vor dem Fest zerst\u00f6rt der Farmer ihren K\u00fcrbisgarten. Shaun sucht nach einer L\u00f6sung und macht sich wie ein verr\u00fcckter Wissenschaftler ans Werk. W\u00e4hrenddessen verschwindet der Farmer pl\u00f6tzlich. Auch in den W\u00e4ldern von Mossingham ist etwas nicht in Ordnung: Dort streift ein Ungeheuer umher. F\u00fcr Shaun und die anderen ger\u00e4t die Vorbereitung auf Halloween damit gr\u00fcndlich durcheinander.","contentRating":{"minimumAge":0},"productionCountries":[{"name":"United Kingdom"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Science Fiction"},{"name":"Familie"}],"directors":[{"name":"Matthew Walker"},{"name":"Steve Cox"}],"actors":[{"name":"Justin Fletcher"},{"name":"John Sparkes"},{"name":"Kate Harbour"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/shaun-das-schaf-spuk-im-kuerbisfeld-96025.v17899891295082.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=Ik8diQEcRiI"}]}},{"name":"Forgotten Island","beginning":"2026-10-14T18:30:00+02:00","urlSlug":"146198","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 2"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96019","title":"Die vergessene Insel","titleOriginal":"Forgotten Island","urlSlug":"die-vergessene-insel","duration":109,"productionYear":"2026","description":"Jo und Raissa sind seit ihrer Kindheit auf den Philippinen eng befreundet. Nach dem Schulabschluss steht ihnen eine Trennung bevor: Raissa soll zum Studium in die USA ziehen, w\u00e4hrend Jo sie zum Bleiben bewegen m\u00f6chte. Dann geraten die beiden durch ein r\u00e4tselhaftes Portal auf die Insel Nakali. In der Welt voller \u00fcbernat\u00fcrlicher Wesen suchen sie einen Weg nach Hause. Doch ihr Aufenthalt birgt eine Gefahr: Sie k\u00f6nnten ihre Erinnerungen an ihr Leben und ihre gemeinsame Vergangenheit verlieren.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"},{"name":"Animation"},{"name":"Abenteuer"},{"name":"Fantasy"},{"name":"Familie"}],"directors":[{"name":"Januel Mercado"},{"name":"Joel Crawford"}],"actors":[{"name":"H.E.R."},{"name":"Liza Soberano"},{"name":"Dave Franco"},{"name":"Lea Salonga"},{"name":"Manny Jacinto"},{"name":"Jenny Slate"},{"name":"Dolly de Leon"},{"name":"Jo Koy"},{"name":"Ronny Chieng"},{"name":"Amielynn Abellera"},{"name":"Kevin McCann"},{"name":"Kristin Villanueva"},{"name":"Sophia Laforteza"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-vergessene-insel-96019.v17893841278781.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=wNyGJ8lqMko"}]}},{"name":"Die Odyssee","beginning":"2026-10-14T19:00:00+02:00","urlSlug":"146273","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"My Private Lumen"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"99061","title":"Die Odyssee","titleOriginal":"The Odyssey","urlSlug":"die-odyssee-2026","duration":172,"productionYear":"2026","description":"Nach dem Trojanischen Krieg will Odysseus mit seinen Gef\u00e4hrten nach Ithaka zur\u00fcckkehren. Doch die Heimfahrt \u00fcber das Mittelmeer wird zu einer jahrelangen Irrfahrt: St\u00fcrme bringen ihre Schiffe vom Kurs ab, und auf dem Weg begegnen ihnen der Zyklop Polyphem und weitere gef\u00e4hrliche Wesen. W\u00e4hrend Odysseus um seine R\u00fcckkehr k\u00e4mpft, bedr\u00e4ngen in Ithaka Freier seine Frau Penelope und wollen die Herrschaft an sich bringen. Sein Sohn Telemachos macht sich auf die Suche nach dem vermissten Vater.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Action"},{"name":"Fantasy"}],"directors":[{"name":"Christopher Nolan"}],"actors":[{"name":"Matt Lasky"},{"name":"Matt Damon"},{"name":"Tom Holland"},{"name":"Anne Hathaway"},{"name":"Robert Pattinson"},{"name":"Lupita Nyong'o"},{"name":"Charlize Theron"},{"name":"Zendaya"},{"name":"Benny Safdie"},{"name":"Jon Bernthal"},{"name":"John Leguizamo"},{"name":"Himesh Patel"},{"name":"Mia Goth"},{"name":"Will Yun Lee"},{"name":"Jimmy Gonzales"},{"name":"Elliot Page"},{"name":"Bill Irwin"},{"name":"Samantha Morton"},{"name":"Jesse Garcia"},{"name":"Rafi Gavron"},{"name":"Shiloh Fernandez"},{"name":"Corey Hawkins"},{"name":"Nick E. Tarabay"},{"name":"Maurice Compte"},{"name":"Michael Vlamis"},{"name":"Iddo Goldberg"},{"name":"Josh Stewart"},{"name":"Ryan Hurst"},{"name":"Anthony Molinari"},{"name":"Jovan Adepo"},{"name":"Logan Marshall-Green"},{"name":"James Remar"},{"name":"Travis Scott"},{"name":"Douglas Rouillard"},{"name":"Jorge L\u00e9on"},{"name":"Andrei Lenart"},{"name":"Kamden Riley"},{"name":"Ryan de Quintal"},{"name":"Jarreth J. Merz"},{"name":"Markie Farnsley"},{"name":"Stephen Murphy"},{"name":"Adam Croasdell"},{"name":"Jamie Harris"},{"name":"Niko Nicotera"},{"name":"Elyes Gabel"},{"name":"Sean Avery"},{"name":"Andrew Howard"},{"name":"Lupita Nyong\u2019o"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/die-odyssee-99061.v17811615267007.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=skiD2oYeCJY"},{"url":"https:\/\/www.youtube.com\/watch?v=1Js6B0_1-v4"}]}},{"name":"Spider-Man: Brand New Day","beginning":"2026-10-14T19:15:00+02:00","urlSlug":"146261","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 7"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"67487","title":"Spider-Man: Brand New Day","titleOriginal":"Spider-Man 4","urlSlug":"spider-man-brand-new-day","duration":146,"productionYear":"2026","description":"Vier Jahre sind seit den Ereignissen von \u201eNo Way Home\u201c vergangen. Peter ist nun erwachsen und lebt f\u00fcr sich allein, nachdem er sich freiwillig aus dem Leben und den Erinnerungen derer, die er liebt, ausgel\u00f6scht hat. Er bek\u00e4mpft Verbrechen in einem New York, das ihn und seinen Namen nicht mehr kennt, und widmet sich ganz dem Schutz seiner Stadt: Spider-Man in Vollzeit. Doch mit den steigenden Anforderungen l\u00f6st der Druck eine \u00fcberraschende k\u00f6rperliche Ver\u00e4nderung aus, die seine Existenz bedroht \u2013 gerade als eine seltsame neue Art von Verbrechen eine der m\u00e4chtigsten Bedrohungen hervorbringt, denen er je gegen\u00fcberstand.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Destin Daniel Cretton"}],"actors":[{"name":"Tom Holland"},{"name":"Zendaya"},{"name":"Sadie Sink"},{"name":"Jacob Batalon"},{"name":"Tramell Tillman"},{"name":"Michael Mando"},{"name":"Mark Ruffalo"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/spider-man-brand-new-day-67487.v17821309559165.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=G0Nmw8LbpCk"}]}},{"name":"Eiserne Wildnis - Heart Of The Beast","beginning":"2026-10-14T20:10:00+02:00","urlSlug":"146229","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 5"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"104697","title":"Eiserne Wildnis - Heart of the Beast","titleOriginal":"Heart of the Beast","urlSlug":"eiserne-wildnis-heart-of-the-beast","duration":101,"productionYear":"2026","description":"Nach einem Flugzeugabsturz stranden der Special-Forces-Offizier James Belmont und sein Milit\u00e4rhund Odin tief in der Wildnis Alaskas. Ohne vertraute Umgebung beginnt f\u00fcr sie ein Kampf gegen die Elemente. Um zu \u00fcberleben, m\u00fcssen Mensch und Tier zusammenhalten und sich aufeinander verlassen. Ihre enge Verbindung wird dabei auf die Probe gestellt: Gemeinsam versuchen sie, den Gefahren der Natur standzuhalten und sich in einer Lage zu behaupten, in der sie ganz auf sich gestellt sind.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Thriller"}],"directors":[{"name":"David Ayer"}],"actors":[{"name":"Brad Pitt"},{"name":"J.K. Simmons"},{"name":"Anna Lambe"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/eiserne-wildnis-heart-of-the-beast-104697.v17863488342134.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=JWjDIeEec1g&list=PLz3nyt80mNyFyNtkMADyjYzs_6AQA30iz&index=2"}]}},{"name":"Resident Evil","beginning":"2026-10-14T20:10:00+02:00","urlSlug":"146212","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 4"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"99509","title":"Resident Evil","titleOriginal":"Resident Evil","urlSlug":"resident-evil-2026","duration":99,"productionYear":"2026","description":"Der Kurierfahrer Bryan nimmt einen scheinbar harmlosen Auftrag an: die Lieferung eines biomedizinischen Pakets. Was wie ein gew\u00f6hnlicher Arbeitstag beginnt, wird zur H\u00f6lle auf Erden. Eine Nacht, kein Ausweg \u2013 und ein Horror, der alles verschlingt.\r\n\r\n","contentRating":{"minimumAge":16},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Thriller"},{"name":"Horror"}],"directors":[{"name":"Zach Cregger"}],"actors":[{"name":"Paul Walter Hauser"},{"name":"Austin Abrams"},{"name":"Zach Cherry"},{"name":"Kali Reis"},{"name":"Johnno Wilson"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/resident-evil-99509.v17881630467867.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=KoRLG1qLE5E"}]}},{"name":"Digger","beginning":"2026-10-14T20:20:00+02:00","urlSlug":"146248","deeplink":null,"flags":[],"subtitleLanguage":null,"auditorium":{"name":"Kino 6"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"96021","title":"Digger","titleOriginal":"Digger","urlSlug":"digger","duration":129,"productionYear":"2026","description":"Der in die Jahre gekommene, verschrobene, milliardenschwere Erd\u00f6lmagnat Digger Rockwell (Tom Cruise) hat durch seine skrupellosen Gesch\u00e4ftstaktiken lange genug den Planeten ausgebeutet. Dadurch hat er eine Umweltkatastrophe verursacht, welche die Menschheit bedroht. Bevor die Welt im Chaos versinkt und die Apokalypse kommt, muss ein letzter Plan geschmiedet werden. Daf\u00fcr verlangt der Pr\u00e4sident der Vereinigten Staaten von Amerika (John Goodman) von Digger Rockwell, die Suppe, die er allen eingebrockt hat, selbst auszul\u00f6ffeln und die Erde zu retten. Dieser nimmt die Herausforderung an, denn als Egomane k\u00e4me es ihm ganz recht, als gro\u00dfer Retter der Menschheit dazustehen und gegen die Natur in den Krieg zu ziehen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Kom\u00f6die"}],"directors":[{"name":"Alejandro G. I\u00f1\u00e1rritu"}],"actors":[{"name":"Tom Cruise"},{"name":"Riz Ahmed"},{"name":"John Goodman"},{"name":"Sandra H\u00fcller"},{"name":"Michael Stuhlbarg"},{"name":"