1408461680.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=EmU-mGLAW4k"}]}},{"name":"Extrawurst","beginning":"2026-10-23T16:00:00+02:00","urlSlug":"144753","deeplink":null,"flags":[{"category":"EVENT","code":"kaffee-klatsch"},{"category":"EVENT","code":"sonderveranstaltung"}],"subtitleLanguage":null,"auditorium":{"name":"Kino 6"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{"id":"71221","title":"Extrawurst","titleOriginal":"Extrawurst","urlSlug":"extrawurst","duration":100,"productionYear":"2026","description":"In einem Tennisclub im l\u00e4ndlichen Deutschland werden die Vorbereitungen f\u00fcr das Sommerfest von Heribert geleitet. Als f\u00fcr Erol, das einzige muslimische Mitglied des Clubs, ein separater Grill vorgeschlagen wird, kommt es zu Spannungen. Was als einfache Diskussion beginnt, entwickelt sich schnell zu einer Debatte \u00fcber gesellschaftliche und pers\u00f6nliche Konflikte, die den Verein zu zerrei\u00dfen droht.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"}],"genres":[{"name":"Drama"},{"name":"Kom\u00f6die"}],"directors":[{"name":"Marcus H. Rosenm\u00fcller"}],"actors":[{"name":"Hape Kerkeling"},{"name":"Fahri Yardim"},{"name":"Christoph Maria Herbst"},{"name":"Anja Knauer"},{"name":"Gaby Dohm"},{"name":"Friedrich M\u00fccke"},{"name":"Rona R."},{"name":"Katrin R\u00f6ver"},{"name":"Patrick Joswig"},{"name":"Malene Becker"},{"name":"Milan Peschel"},{"name":"Konstantin K\u00f6nig"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/extrawurst-71221.v17659640143365.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=YbC8F45HRr4"}]}},{"name":"Der perfekte Urlaub","beginning":"2026-10-23T18:00:00+02:00","urlSlug":"146059","deeplink":null,"flags":[{"category":"TECHNOLOGY","code":"dbox"}],"subtitleLanguage":null,"auditorium":{"name":"Kino 3"},"cinema":{"urlSlug":"das-lumen-filmtheater-solingen","city":{"urlSlug":"solingen"}},"movie":{