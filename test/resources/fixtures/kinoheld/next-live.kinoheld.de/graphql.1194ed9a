elt.de\/?perf_id=35086000023JHWJXVF&site_id=46","flags":[{"category":"TECHNOLOGY","code":"imax"}],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"108431","title":"Dune: Part Three","titleOriginal":"Dune: Part Three","urlSlug":"dune-part-three-","duration":140,"productionYear":"2026","description":"Fast zwei Jahrzehnte, nachdem Paul Atreides als skrupelloser Imperator die Macht \u00fcber das Universum \u00fcbernommen hat, sieht er sich nun mit den Folgen seiner Herrschaft konfrontiert: Alte Verb\u00fcndete kehren zur\u00fcck, schreckliche neue Bedrohungen erheben sich \u2013 und in jedem Schatten lauert Verrat. Geplagt von Visionen vom Untergang des Imperiums und von der R\u00fcckkehr seiner l\u00e4ngst verlorenen Liebe ger\u00e4t Paul immer tiefer in eine weitreichende Verschw\u00f6rung, in der Chani eine entscheidende Rolle zu spielen scheint. W\u00e4hrend sich eine Rebellion anbahnt und die Feinde immer n\u00e4her r\u00fccken, muss sich Paul mit dem wahren Preis der Macht und dem Schicksal derer auseinandersetzen, die er am meisten liebt.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"United States"}],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"}],"directors":[{"name":"Denis Villeneuve"}],"actors":[{"name":"Timoth\u00e9e Chalamet"},{"name":"Zendaya"},{"name":"Jason Momoa"},{"name":"Florence Pugh"},{"name":"Rebecca Ferguson"},{"name":"Isaach de Bankol\u00e9"},{"name":"Charlotte Rampling"},{"name":"Anya Taylor-Joy"},{"name":"Robert Pattinson"},{"name":"Javier Bardem"},{"name":"Nakoa-Wolf Momoa"},{"name":"Ida Brooke"},{"name":"Josh Brolin"},{"name":"L\u00e9a Seydoux"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/dune-part-three-108431.v17889415300750.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=71LjZ7dB9sM"}]}},{"name":"Avengers: Doomsday","beginning":"2026-12-16T00:01:00+01:00","urlSlug":"6ac687570f6803018ffa6e0b","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=D4086000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"111173","title":"Avengers: Doomsday","titleOriginal":"Avengers: Doomsday","urlSlug":"avengers-doomsday-6ac374fc8fe95","duration":165,"productionYear":null,"description":"\u201eAvengers 5: Doomsday\u201c wird die gr\u00f6\u00dften Heldinnen und Helden des Marvel Cinematic Universe ein weiteres Mal zusammenbringen, um gegen einen neuen, \u00fcberm\u00e4chtigen Gegner anzutreten: Doctor Doom (Robert Downey jr.). Dieser ist ein Meister sowohl modernster Wissenschaft als auch m\u00e4chtiger Magie und nutzt eine sich ausbreitende kosmische Krise im Multiversum, um seine finsteren Pl\u00e4ne in die Tat umzusetzen. Daher m\u00fcssen sich Heldenteams aus drei unterschiedlichen Universen zusammentun, um dieser enormen Bedrohung entgegenzuwirken: die Avenger und New Avengers von Erde-616, die Fantastic Four von Erde-828 und die X-Men von einer weiteren Erde, die bisher noch nicht benannt wurde. Doch bevor die Held*innen den Superschurken konfrontieren k\u00f6nnen, m\u00fcssen sie zun\u00e4chst ihre eigenen Differenzen \u00fcberw\u00e4ltigen, die bei der Kollision unterschiedlicher Universen leider unvermeidlich sind.","contentRating":{"minimumAge":12},"productionCountries":[],"genres":[{"name":"Abenteuer"},{"name":"Science Fiction"},{"name":"Action"}],"directors":[{"name":"Joe Russo"},{"name":"Anthony Russo"}],"actors":[{"name":"Robert Downey jr."},{"name":"Chris Evans"},{"name":"Chris Hemsworth"},{"name":"Pedro Pascal"},{"name":"Paul Rudd"},{"name":"Anthony Mackie"},{"name":"Florence Pugh"},{"name":"Vanessa Kirby"},{"name":"Ebon Moss-Bachrach"},{"name":"Wyatt Russell"},{"name":"Channing Tatum"},{"name":"Simu Liu"},{"name":"Ian McKellen"},{"name":"Hayley Atwell"},{"name":"Tom Hiddleston"},{"name":"James Marsden"},{"name":"Pa