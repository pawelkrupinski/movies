{"data":{"programShows":{"paginatorInfo":{"hasMorePages":true},"data":[{"name":"ENHYPEN VR CONCERT : DESTINY","beginning":"2026-11-08T19:00:00+01:00","urlSlug":"6aca76b2123b7500191076f9","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=36B76000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-kinowelt-ruhr-park","city":{"urlSlug":"bochum"}},"movie":{"id":"81717","title":"ENHYPEN VR CONCERT: IMMERSION","titleOriginal":"ENHYPEN VR CONCERT: IMMERSION","urlSlug":"enhypen-vr-concert-immersion-68f8662675d8b","duration":56,"productionYear":"2025","description":"Eine r\u00e4tselhafte Botschaft und ein Fl\u00fcstern im Korridor er\u00f6ffnen den Zugang zu sich wandelnden Welten: ein Hochhausdach unter zwei Monden, eine verlassene, pulsierende Fabrik und ein surrealer B\u00fcroraum voller Echos der Vergangenheit. Jeder dieser Orte wird zum Portal in die Musik, die Emotionen und die Fantasie von ENHYPEN. Mit eindrucksvollen Bildern und intensiven Performances pr\u00e4sentieren die Mitglieder Welthits wie \u201eBite Me\u201c, \u201eXO (Only If You Say Yes)\u201c und das gef\u00fchlvolle \u201eHighway 1009\u201c. So verschmelzen Choreografie, Gef\u00fchle und Geschichten zu einem unvergleichlichen VR-Konzerterlebnis.","contentRating":null,"productionCountries":[{"name":"South Korea"}],"genres":[{"name":"Musik"}],"directors":[{"name":"Belift Lab"}],"actors":[{"name":"Jungwon"},{"name":"Heeseung"},{"name":"Jay"},{"name":"Jake"},{"name":"NI-KI"},{"name":"Sunoo"},{"name":"Sunghoon"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/enhypen-vr-concert-immersion-81717.v17770138547299.jpg"},"trailers":[]}},{"name":"ENHYPEN VR CONCERT : DESTINY","beginning":"2026-11-08T21:00:00+01:00","urlSlug":"6aca76b2123b7500191076fa","deeplink":"https:\/\/buchung.uci-kinowelt.de\/?perf_id=46B76000023JHWJXVF&site_id=46","flags":[],"subtitleLanguage":null,"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"uci-k