ilm\/teenage-sex-and-death-at-camp-miasma-101745.v17840264932032.png"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=1kDVF_bkDtY"}]}},{"name":"CAMOUFLAGE","beginning":"2026-10-20T20:15:00+02:00","urlSlug":"3677618390","deeplink":null,"flags":[{"category":"LANGUAGE","code":"subtitled"}],"subtitleLanguage":{"isocode":"de"},"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"schanzenkino-73","city":{"urlSlug":"hamburg"}},"movie":{"id":"143017","title":"Camouflage","titleOriginal":"\u041a\u0430\u043c\u0443\u0444\u043b\u044f\u0436","urlSlug":"camouflage","duration":102,"productionYear":null,"description":"Als Vitaly (22) seine Mutter und Schwester in der Ukraine zur\u00fcckl\u00e4sst, tr\u00e4umt er von einem neuen Leben als Student in M\u00fcnchen. Am 24.02.20222 platzt dieser Traum. Innerhalb von einer Nacht stehen pl\u00f6tzlich zwei harte Realit\u00e4ten vor seiner T\u00fcr: die politische Weltlage und die eigene Familie. Am 09.10. Filmgespr\u00e4ch mit Mykyta Giablenko (Regie) und Klara Lange (Darstellerin)","contentRating":null,"productionCountries":[],"genres":[{"name":"Drama"}],"directors":[{"name":"Mykyta Gibalenko"}],"actors":[{"name":"Arthur Aliiev"},{"name":"Yelyzaveta Tsilyk"},{"name":"Klara Lange"},{"name":"Hanna Yaremchuk-Bobalo"},{"name":"Alina Danko"},{"name":"Andrii Kudin"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/mo\/1624-143017.v17901760117505.jpeg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=4Rj0chKhz3Q?si=2n48DAhHmzcJXEQW"}]}},{"name":"CALL ME QUEEN OmeU","beginning":"2026-10-21T18:00:00+02:00","urlSlug":"3677598963","deeplink":null,"flags":[{"category":"LANGUAGE","code":"subtitled"}],"subtitleLanguage":{"isocode":"de"},"auditorium":{"name":"Saal 2"},"cinema":{"urlSlug":"schanzenkino-73","city":{"urlSlug":"hamburg"}},"movie":{"id":"106545","title":"Call Me Queen","titleOriginal":"Call Me Queen","urlSlug":"call-me-queen","duration":105,"productionYear":"2026","description":"Queen (Eliane Umuhire) ist eine selbstbewusste, willensstarke Frau, die sich mit ihren zwei Kindern im Nairobi der 1990er Jahre durchschl\u00e4gt. Als sie der irischen Journalistin Anna (Denise Gough) begegnet, die als Auslandskorrespondentin in Nairobi arbeitet, entsteht zun\u00e4chst eine unerwartete Verbindung und schlie\u00dflich eine au\u00dfergew\u00f6hnliche Freundschaft.\r\nAls klar wird, dass Queen an Aids erkrankt ist, erm\u00f6glicht ihr Anna den Zugang zu einer Behandlung. Queen \u00fcberlebt, w\u00e4hrend ihre Freundinnen und Nachbarinnen weiterhin an den Folgen der Infektion sterben. Ihr \u00dcberleben wird f\u00fcr sie zur Verpflichtung: Sie beginnt gegen die Ungerechtigkeit zu k\u00e4mpfen.","contentRating":{"minimumAge":12},"productionCountries":[{"name":"Germany"},{"name":"France"},{"name":"United Kingdom"},{"name":"Kenya"}],"genres":[{"name":"Drama"}],"directors":[{"name":"Emily Atef"}],"actors":[{"name":"Eliane Umuhire"},{"name":"Denise Gough"},{"name":"Dominic West"},{"name":"Charlie Carrick"},{"name":"Danny Sapani"},{"name":"Michelle Tiren"},{"name":"Nice Githinji"},{"name":"Lwanda Jawar"}],"thumbnailImage":{"url":"https:\/\/static.kinoheld.de\/images\/film\/call-me-queen-106545.v17883384549488.jpg"},"trailers":[{"url":"https:\/\/www.youtube.com\/watch?v=nVvVm1ADKBo"}]}},{"name":"NAZA","beginning":"2026-10-21T18:30:00+02:00","urlSlug":"3677593922","deeplink":null,"flags":[{"category":"LANGUAGE","code":"subtitled"}],"subtitleLanguage":{"isocode":"en"},"auditorium":{"name":"Saal 1"},"cinema":{"urlSlug":"schanzenkino-73","city":{"urlSlug":"hamburg"}},"movie":{"id":"142985","title":"Naza","titleOriginal":"Naza","urlSlug":"naza","duration":80,"productionYear":null,"description":"\u00dcber drei Jahre hinweg sprachen Abraham und Szor mit Angeh\u00f6rigen des israelischen Milit\u00e4rs und der Geheimdienste. 24 israelische Geheimdienstoffiziere und Soldaten kommen im Film anonymisiert zu Wort; ihre Stimmen und ihr Erscheinungsbild wurden digital verfremdet. Ihre Aussagen bilden 