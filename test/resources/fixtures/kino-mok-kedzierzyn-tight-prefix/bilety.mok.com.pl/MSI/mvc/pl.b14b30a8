                <div class="col-12 movies-movie__single__info">
                    <h3 class="movies-movie__single__title" title="Chemik-.Naznaczony:Wyjście z mrocznego wymiaru">Chemik-.Naznaczony:Wyjście z mrocznego wymiaru</h3>
                    <ul class="movies-movie__single__moreinfo">
