le":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_StageGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"Tommy Blaize – the voice of BBC Strictly Come Dancing – comes to BEAM with his full live band in a\r\nspectacular new show, The Golden Age of Swing.\r\nFrom Frank Sinatra and Nat King Cole to Louis Armstrong, Ray Charles, Ella Fitzgerald, Dean Martin and many more,\r\nTommy performs timeless ballroom and Great American Songbook classics that has become synonymous with his\r\nvoice for millions across the country, backed by a hand-picked ensemble of some of the UK’s finest musicians.","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"https://system.spektrix.com/beamhertford/files/c8319584-5d0c-4cf9-971d-6e455b19f38f.jpg","isOnSale":true,"name":"Tommy Blaize: The Golden Age Of Swing","instanceDates":"3 April-3 April","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/c8319584-5d0c-4cf9-971d-6e455b19f38f-thumbnail.jpg","webUrl":"","webEventId":null,"id":"254001AMKMLCSPVBMNRJMBRQNKPQQTGHD","firstInstanceDateTime":"2027-04-03T19:30:00","firstInstanceDateTimeUtc":"2027-04-03T18:30:00Z","lastInstanceDateTime":"2027-04-03T19:30:00","lastInstanceDateTimeUtc":"2027-04-03T18:30:00Z","altText":"","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Date Night – Ideal for couples looking for a special evening.","attribute_IncludeInterval":true,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_StageGenre":"Music","attribute_Rating":"","attribute_AgeRecommendation":"","attribute_EDIFilmNumber":"","attribute_SendToDCM":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","