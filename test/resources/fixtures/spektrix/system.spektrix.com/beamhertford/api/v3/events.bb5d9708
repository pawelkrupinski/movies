[{"description":"Mrs Smith was an ordinary teacher in an ordinary school until she went viral on Facebook and accidentally became a stand-up comedian. 1,2,3 Eyes on Me! is the follow up to her sellout tour of 2023 that debuted at the Edinburgh Fringe. \r\n18+ Only - Photography and Recording is not permitted due to Mrs Smith’s anonymity. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":115,"imageUrl":"https://system.spektrix.com/beamhertford/files/a20de16f-2889-4d6d-ab4b-f38ea296832a.jpg","isOnSale":true,"name":"123, Eyes On Me!","instanceDates":"30 May-30 May","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/a20de16f-2889-4d6d-ab4b-f38ea296832a-thumbnail.jpg","webUrl":"","webEventId":null,"id":"279001ABTRKRMGMNVMRJDNBSNPPRRSSQJ","firstInstanceDateTime":"2027-05-30T19:45:00","firstInstanceDateTimeUtc":"2027-05-30T18:45:00Z","lastInstanceDateTime":"2027-05-30T19:45:00","lastInstanceDateTimeUtc":"2027-05-30T18:45:00Z","altText":"","attribute_AgeRecommendation":"18+ only","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Laughs Guaranteed – Lighthearted, fun vibe.","attribute_IncludeInterval":false,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_SendToDCM":"No","attribute_StageGenre":"Comedy","attribute_StageGenreSECONDARY":"Celebrity Talk","attribute_Rating":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"The Award winning Flabbergast Theatre bring a rambunctious approach to Shakespeare’s much-\r\nloved comedy A Midsummer Night’s Dream, Goblins and Sprites run amok as the King and Queen of\r\nthe Faeries settle a spat causing havoc among the humans caught up in their machinations.\r\nThe action focusses on a troupe of players travelling with their beautiful vintage Haywain frantically\r\nmulti-role-ing and bringing the world to life with joy and excitement.\r\nArcadian folk songs, slapstick comedy, and mask work combine with a respectful approach to the\r\ntext, an irreverent attitude and a focus on storytelling to bring the magic of midsummer alive with\r\nphysical comedy, song, and dance.","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"https://system.spektrix.com/beamhertford/files/4bfe30e7-c11c-44a6-9f0c-7c0081e38bd2.jpg","isOnSale":true,"name":"A Midsummer Night's Dream","instanceDates":"17 March-18 March","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/4bfe30e7-c11c-44a6-9f0c-7c0081e38bd2-thumbnail.jpg","webUrl":"","webEventId":null,"id":"247001AQDRVNKPVSCJQSDPLSRGQPMBJLG","firstInstanceDateTime":"2027-03-17T19:00:00","firstInstanceDateTimeUtc":"2027-03-17T19:00:00Z","lastInstanceDateTime":"2027-03-18T13:00:00","lastInstanceDateTimeUtc":"2027-03-18T13:00:00Z","altText":"","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Thought-Provoking – Stimulates conversation and reflection.","attribute_IncludeInterval":true,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_StageGenre":"Theatre","attribute_Rating":"","attribute_AgeRecommendation":"","attribute_EDIFilmNumber":"","attribute_SendToDCM":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_StageGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"A laugh-out-loud comedy whodunnit featuring four actors, a dozen characters and a whole load of chaos. When a priceless painting vanishes at a manor auction, Detective Stuart Pidcock and his unlikely ally must interrogate eccentric suspects, outwit a cunning thief, and crack the century’s mystery.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"https://system.spektrix.com/beamhertford/files/333f0797-4ad3-45a6-bb0d-249e233446ab.jpg","isOnSale":true,"name":"A Shoddy Detective","instanceDates":"11 February-13 February","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/333f0797-4ad3-45a6-bb0d-249e233446ab-thumbnail.jpg","webUrl":"","webEventId":null,"id":"189601ASQBMRBRRBJRQLNKTBTBPJTLRVH","firstInstanceDateTime":"2027-02-11T19:30:00","firstInstanceDateTimeUtc":"2027-02-11T19:30:00Z","lastInstanceDateTime":"2027-02-13T19:30:00","lastInstanceDateTimeUtc":"2027-02-13T19:30:00Z","altText":"","attribute_AgeRecommendation":"Under 14s to be accompanied by an adult","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Laughs Guaranteed – Lighthearted, fun vibe.","attribute_IncludeInterval":true,"attribute_KioskPromoted":true,"attribute_KioskUnavailable":false,"attribute_MustSeeEvent":"Yes","attribute_SendToDCM":"No","attribute_StageGenre":"Comedy","attribute_StageGenreSECONDARY":"Theatre","attribute_Rating":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"Award nominated stand-up and improviser Jon Hipkiss brings together the ultimate celebration of comedy and fandom. Based solely on your suggestions, Jon will improvise an entirely new Star Wars film all by himself. He's all the trailers, all the characters, all the music, the ships, everything. It's beautifully funny improvised chaos!","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"https://system.spektrix.com/beamhertford/files/5ad2820c-c29a-4208-be43-d3483b6e4d4a.jpg","isOnSale":true,"name":"A Star Wars Improv Show: The One-Man Made-Up Movie Parody","instanceDates":"4 February-4 February","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/5ad2820c-c29a-4208-be43-d3483b6e4d4a-thumbnail.jpg","webUrl":"","webEventId":null,"id":"241601AKVTTSPBGDSTQRSBHJPBJQGGSVP","firstInstanceDateTime":"2027-02-04T19:45:00","firstInstanceDateTimeUtc":"2027-02-04T19:45:00Z","lastInstanceDateTime":"2027-02-04T19:45:00","lastInstanceDateTimeUtc":"2027-02-04T19:45:00Z","altText":"","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Laughs Guaranteed – Lighthearted, fun vibe.","attribute_IncludeInterval":true,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_SendToDCM":"No","attribute_StageGenre":"Theatre","attribute_StageGenreSECONDARY":"Comedy","attribute_Rating":"","attribute_AgeRecommendation":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"BAFTA-winning comedian Adam Kay celebrates a decade of his global smash This is Going to Hurt, with an all-new live tour featuring the most hilarious (and heartbreaking) entries from his diaries as a junior doctor. Expect a mix of all-time favourites alongside some never told-before stories, followed by a Q&A as Adam reflects on how the NHS has changed in the ten years since his diaries first stuck an index finger inside it. This time it’s really going to hurt.","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"https://system.spektrix.com/beamhertford/files/9dd5abec-9cc2-487f-a308-27b3b6510aa2.jpg","isOnSale":true,"name":"Adam Kay: This Is Going To Hurt","instanceDates":"2 April-2 April","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/9dd5abec-9cc2-487f-a308-27b3b6510aa2-thumbnail.jpg","webUrl":"","webEventId":null,"id":"256601APMCLSPMNBVRGBCNVLJLMNJCKRH","firstInstanceDateTime":"2027-04-02T18:30:00","firstInstanceDateTimeUtc":"2027-04-02T17:30:00Z","lastInstanceDateTime":"2027-04-02T21:00:00","lastInstanceDateTimeUtc":"2027-04-02T20:00:00Z","altText":"","attribute_AgeRecommendation":"16+","attribute_ContentWarning":"This show contains medical themes and stories that some may find distressing.","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Thought-Provoking – Stimulates conversation and reflection.","attribute_IncludeInterval":true,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_SendToDCM":"No","attribute_StageGenre":"Celebrity Talk","attribute_StageGenreSECONDARY":"Comedy","attribute_Rating":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"Join pianist Louis Demetrius Alvanis for an evening celebrating Beethoven’s timeless power and universal appeal, marking the bicentenary of the composer’s death. The programme features four of Beethoven’s piano sonatas, including three of his most famous: the dramatic Pathétique, the radiant Waldstein and the thrilling Appassionata.","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"https://system.spektrix.com/beamhertford/files/cc9b3b7e-a0da-483f-aa05-3eed2f8112ca.jpg","isOnSale":true,"name":"Alvanis plays Beethoven: An Evening of Great Piano Music","instanceDates":"31 March-31 March","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/cc9b3b7e-a0da-483f-aa05-3eed2f8112ca-thumbnail.jpg","webUrl":"","webEventId":null,"id":"272001AKGNHCMVGJVGMRHPVNLKPRKMQVV","firstInstanceDateTime":"2027-03-31T19:30:00","firstInstanceDateTimeUtc":"2027-03-31T18:30:00Z","lastInstanceDateTime":"2027-03-31T19:30:00","lastInstanceDateTimeUtc":"2027-03-31T18:30:00Z","altText":"","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Feel-Good Escape – Comforting, uplifting entertainment.","attribute_IncludeInterval":false,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_SendToDCM":"No","attribute_StageGenre":"Music","attribute_StageGenreSECONDARY":"Theatre","attribute_Rating":"","attribute_AgeRecommendation":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"Get ready for a night of laughs, banter, and legendary football stories as Liverpool icons John Barnes and Jan Mølby take the stage! From unforgettable goals and European nights to dressing-room gossip and cheeky rivalries, nothing is off-limits.\r\nExpect plenty of humour, mischief, and a live audience Q&A, where you can put your questions to the legends themselves — and maybe get a few surprises in return! This is football storytelling with a wink, a nudge, and a whole lot of Liverpool charm — a night to remember for fans, laughter-lovers, and anyone who enjoys a brilliant story told live.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"https://system.spektrix.com/beamhertford/files/bb608b24-caa0-4a28-964b-cc1b458d639d.jpg","isOnSale":true,"name":"An Evening with Liverpool Legends","instanceDates":"13 January-13 January","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/bb608b24-caa0-4a28-964b-cc1b458d639d-thumbnail.jpg","webUrl":"","webEventId":null,"id":"241401ABSDTNNJSDQTBNJJDNJJGSQRSGM","firstInstanceDateTime":"2027-01-13T19:30:00","firstInstanceDateTimeUtc":"2027-01-13T19:30:00Z","lastInstanceDateTime":"2027-01-13T19:30:00","lastInstanceDateTimeUtc":"2027-01-13T19:30:00Z","altText":"","attribute_AgeRecommendation":"14+","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Big Night Out – High-impact, social occasion, visually impressive.","attribute_IncludeInterval":true,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_MeetAndGreetIncludes":"Premium seating, VIP lanyard on arrival, meet and greet the players, a professional photo with the players to take away on the night","attribute_MeetAndGreetStartTime":"6pm","attribute_MeetAndGreetTickets":"Yes","attribute_SendToDCM":"No","attribute_StageGenre":"Celebrity Talk","attribute_StageGenreSECONDARY":"Theatre","attribute_Rating":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"BEAM are delighted to bring you an evening with one of the world’s top Rugby Referees - Nigel Owens MBE. After playing to a sell-out crowd across venues in the UK, Nigel is visiting to share numerous tales from on and off the field.","htmlDescription":"<div id>\r\n\t<span><br/></span><span><br/></span>Nigel is one of the most engaging and humorous characters in the game of Rugby Union, gaining an international following of fans and admirers with his charm, wit and indeed fairness. <span><br/></span><span><br/></span>He is also the only referee to be appointed for three consecutive Heineken Cup finals and forever will be renowned and admired for displaying a dry sense of humour when dealing with players during the heat of battle.<span><br/></span><span><br/></span>Making this an evening simply not to be missed for any sports fan as he recounts stories from his life and career.<span><br/></span><span><br/></span>There will also be an opportunity for a live Q&A in the second half of the evening to ask Nigel anything (off the record!)<span><br/></span>\r\n</div>","duration":120,"imageUrl":"https://system.spektrix.com/beamhertford/files/cc2bd567-fb57-413e-afc3-164198caa881.jpg","isOnSale":true,"name":"An Evening with Nigel Owens MBE","instanceDates":"28 January-28 January","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/cc2bd567-fb57-413e-afc3-164198caa881-thumbnail.jpg","webUrl":"","webEventId":null,"id":"187201ATQTBPJHSKGGTCNKDVLSTDMSVGK","firstInstanceDateTime":"2027-01-28T19:30:00","firstInstanceDateTimeUtc":"2027-01-28T19:30:00Z","lastInstanceDateTime":"2027-01-28T19:30:00","lastInstanceDateTimeUtc":"2027-01-28T19:30:00Z","altText":"","attribute_EDISiteNumber":"997653","attribute_EventType":"Stage","attribute_ExperienceDescriptors":"Thought-Provoking – Stimulates conversation and reflection.","attribute_IncludeInterval":false,"attribute_KioskPromoted":false,"attribute_KioskUnavailable":false,"attribute_SendToDCM":"No","attribute_StageGenre":"Celebrity Talk","attribute_StageGenreSECONDARY":"Comedy","attribute_Rating":"","attribute_AgeRecommendation":"","attribute_EDIFilmNumber":"","attribute_WebsiteGenreSeasonal":"","attribute_ScreenStrands":"","attribute_Accessible":"","attribute_MustSeeEvent":"","attribute_ContentWarning":"","attribute_FinanceFilter":"","attribute_FilmGenrePRIMARY":"","attribute_FilmGenreSECONDARY":"","attribute_MeetAndGreetTickets":"","attribute_MeetAndGreetStartTime":"","attribute_MeetAndGreetIncludes":"","attribute_YearOfRelease":"","attribute_Director":"","attribute_Language":""},{"description":"Join football legend Sir Trevor Brooking – “The Boleyn Knight” – for a very special evening of stories, memories and fascinating behind-the-scenes insight from one of English football’s most respected figures.\r\n\r\nHosted by former West Ham United captain Tony Gale and joined by very special guest Julian Dicks – “The Terminator”, this exclusive live event brings together three true Hammers favourites for an unforgettable night packed with laughter, nostalgia, dressing-room stories and incredible football memories.\r\nA limited number of VIP tickets afford the opportunity for premium seating, VIP lanyard on arrival, an exclusive meet and greet and professional photo to take away on the night, PLUS a digital copy of the photo downloadable 24 hours after the event! ","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"https://system.spektrix.com/beamhertford/files/273ad5a3-01ed-48c5-aaf4-ba15ed9a3aa1.jpg","isOnSale":true,"name":"An Evening with Sir Trevor Brooking","instanceDates":"28 February-28 February","thumbnailUrl":"https://system.spektrix.com/beamhertford/files/273ad5a3-01ed-48c5-aaf4-ba15ed9a3aa1-thumbnail.jpg","webUrl":"","webEventId":null,"id":"264401ABLNMKKVTRBBHHHRPDCGMCKCRRN","firstInstanceDateTime":"2027-02-28T19:30:00","firstInstanceDateTimeUtc":"2027-02-28T19:30:00Z","lastInstanceDateTime"