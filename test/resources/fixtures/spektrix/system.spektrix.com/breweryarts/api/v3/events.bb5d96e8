ebsiteCategory":"Music","attribute_ConfirmationText":"","attribute_Tutor":"","attribute_FilmCertificate":"","attribute_VideoURL":"","attribute_WebsiteCopy":"","attribute_CLVenue":"","attribute_EDIFilmNumber":"","attribute_IDRequired":"","attribute_FilmGenre":"","attribute_FILMDISTRIBUTOR":""},{"description":"Comedy | Doors 7pm | Starts 8pm | Malt Room Cabaret Unreserved Seating | Tickets £18.50 |  | Capacity 150 | Staff comps ok | Age guidance 18+ |\t","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"COMEDY CLUB","instanceDates":"30 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"969244ACMDRQJKKNBBTMTMLQRCCKPHKNB","firstInstanceDateTime":"2026-10-30T19:00:00","firstInstanceDateTimeUtc":"2026-10-30T19:00:00Z","lastInstanceDateTime":"2027-10-29T19:00:00","lastInstanceDateTimeUtc":"2027-10-29T18:00:00Z","altText":"","attribute_AccountCode":"4000 Ticket Sales","attribute_AreWeTheTicketAgent":false,"attribute_BreweryMember48hPriorityBooking":false,"attribute_Classification":"Comedy","attribute_ClassificationCode":"THE","attribute_ConfirmationText":"Age Guidance: 18+","attribute_DeptCode":"22 - LE Comedy","attribute_FACMainCategory":"Comedy","attribute_FACSecondaryCategory":"Stand up","attribute_ForDCM":false,"attribute_IncludedInX6GroupBookingOffer":false,"attribute_LongEventNameLine1":"Comedy Club","attribute_LongEventNameLine2":"Age Guidance: 18+","attribute_LongEventNameLine3":"Doors 7pm. Starts 8pm","attribute_LongEventNameLine4":"Pizza orders must be made by 7.40pm","attribute_ShortName":"COMEDY CLUB","attribute_ThirdPartyListings":false,"attribute_WebsiteCategory":"Comedy","attribute_EventInfo":"","attribute_Tutor":"","attribute_FilmCertificate":"","attribute_VideoURL":"","attribute_WebsiteCopy":"","attribute_CLVenue":"","attribute_EDIFilmNumber":"","attribute_IDRequired":"","attribute_FilmGenre":"","attribute_FILMDISTRIBUTOR":""},{"description":"RBO (Opera)\r\nCosì fan Tutte - The Royal Opera\r\n(12A) 210min | As Live | The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park, where the two pairs of lovers at the heart of the tale find themselves on one emotional—and literal—thrill ride after another. Soprano Federica Lombardi and mezzo-soprano Samantha Hankey sing Fiordiligi and Dorabella, opposite tenor Duke Kim and baritone Andrey Zhilikhovsky as Ferrando and Guglielmo. Bass-baritone Gerald Finley reprises his portrayal of the cynical Don Alfonso, with soprano Ana María Martínez as the witty maid Despina.","htmlDescription":"<div id>\r\n\r\n</div>","duration":210,"imageUrl":"https://system.spektrix.com/breweryarts/files/a047b4ea-454d-4a12-8fdf-83373e201f7f.jpg","isOnSale":true,"name":"Così fan Tutte - The Royal Opera","instanceDates":"23 February-23 February","thumbnailUrl":"https://system.spektrix.com/breweryarts/files/a047b4ea-454d-4a12-8fdf-83373e201f7f-thumbnail.jpg","webUrl":"","webEventId":null,"id":"1134444ANSVVVPNQPGPKTSKNKLQVGSGJM","firstInstanceDateTime":"2027-02-23T18:30:00","firstInstanceDateTimeUtc":"2027-02-23T18:30:00Z","lastInstanceDateTime":"2027-02-23T18:30:00","lastInstanceDateTimeUtc":"2027-02-23T18:30:00Z","altText":"","attribute_AccountCode":"4000 Ticket Sales","attribute_BreweryMember48hPriorityBooking":false,"attribute_Classification":"Live Screenings","attribute_ClassificationCode":"THE","attribute_DeptCode":"13 - CIN Stage on Screen","attribute_EDIFilmNumber":"500519","attribute_FACMainCategory":"Film","attribute_FACSecondaryCategory":"Performances on screen","attribute_FilmCertificate":"12A","attribute_FILMDISTRIBUTOR":"Trafalgar Releasing","attribute_FilmGenre":"THEATRE","attribute_ForDCM":true,"attribute_IncludedInX6GroupBookingOffer":false,"attribute_ShortName":"Così fan Tutte","attribute_ThirdPartyListings":false,"attribute_WebsiteCategory":"Cinema","attribute_WebsiteCopy":"The Met: Live in HD season continues with Mozart’s satirical comedy of fickle young love. Phelim McDermott’s “colorful, inventive” (The New York Times) staging, inspired by Coney Island in the 1950s, sets the uproarious story at a boardwalk amusement park","attribute_EventInfo":"","attribute_ConfirmationText":"","attribute_LongEventNameLine1":"","attribute_LongEventNameLine2":"","attribute_LongEventNameLine3":"","attribute_Tutor":"","attribute_VideoURL":"","attribute_LongEventNameLine4":"","attribute_CLVenue":"","attribute_IDRequired":"","attribute_AreWeTheTicketAgent":false},{"description":"RBO (Opera)\r\nCosì fan Tutte - The Royal Opera\r\n(12A) 210min | As Live | Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable. \r\nCosì fan tutte has lost none of its sting since it first scandalised audiences in 1790. In her Main Stage debut, Netia Jones, Associate Director of The Royal Opera, reimagines Mozart’s comedy of manners through a sharp contemporary lens, where 18th-century romantic trickery meets deeply satirical high-tech deceit. Taking on the roles of the lovers is an exciting young cast led by Louise Alder, Simone McIntosh, Mingjie Lei and Huw Montague Rendall, with Gerald Finley as their manipulative game-master Don Alfonso and Emily Pogorelc as Despina. Thomas Hengelbrock conducts, bringing out the exquisite melodies that underpin the provocative, and resolutely modern, themes at the heart of the opera.\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":210,"imageUrl":"https://system.spektrix.com/breweryarts/files/b9652835-d2e9-4b85-b7b7-799616e8116d.jpg","isOnSale":true,"name":"Così fan Tutte RBO The Royal Opera","instanceDates":"23 February-23 February","thumbnailUrl":"https://system.spektrix.com/breweryarts/files/b9652835-d2e9-4b85-b7b7-799616e8116d-thumbnail.jpg","webUrl":"","webEventId":null,"id":"1158644ARBCPMLPHCLBQMHGCHGNTBHCRS","firstInstanceDateTime":"2027-02-23T18:30:00","firstInstanceDateTimeUtc":"2027-02-23T18:30:00Z","lastInstanceDateTime":"2027-02-23T18:30:00","lastInstanceDateTimeUtc":"2027-02-23T18:30:00Z","altText":"","attribute_AccountCode":"4100","attribute_AreWeTheTicketAgent":false,"attribute_BreweryMember48hPriorityBooking":false,"attribute_Classification":"Live Screenings","attribute_ClassificationCode":"THE","attribute_DeptCode":"13 - CIN Stage on Screen","attribute_EDIFilmNumber":"500519","attribute_FACMainCategory":"Film","attribute_FACSecondaryCategory":"Performances on screen","attribute_FilmCertificate":"12A","attribute_FILMDISTRIBUTOR":"Trafalgar Releasing","attribute_FilmGenre":"THEATRE","attribute_ForDCM":false,"attribute_IncludedInX6GroupBookingOffer":false,"attribute_ShortName":"Così fan Tutte","attribute_ThirdPartyListings":false,"attribute_WebsiteCategory":"Cinema","attribute_WebsiteCopy":"Spurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstabl","attribute_EventInfo":"","attribute_ConfirmationText":"","attribute_LongEventNameLine1":"","attribute_LongEventNameLine2":"","attribute_LongEventNameLine3":"","attribute_Tutor":"","attribute_VideoURL":"","attribute_LongEventNameLine4":"","attribute_CLVenue":"","attribute_IDRequired":""},{"description":"Music Gig | Doors: 8pm | Start: 8.30pm | Malt Room Standing | Tickets: £21.50/ £19.70 concs. | 10% group and 20% student disc. apply | Support: Bossyking | ","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"CUT CAPERS","instanceDates":"6 November-6 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"1110844ABTSJVBBQJCQSPLQDCMRTGCHLJ