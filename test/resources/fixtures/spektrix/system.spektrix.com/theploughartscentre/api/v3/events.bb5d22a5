[{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":" Barnstaple Bygone Brothel Tour (South End)","instanceDates":"10 December-10 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"125402ANCQGMDCMJJQJPMKKMVSJCQDKSH","firstInstanceDateTime":"2026-12-10T19:30:00","firstInstanceDateTimeUtc":"2026-12-10T19:30:00Z","lastInstanceDateTime":"2026-12-10T19:30:00","lastInstanceDateTimeUtc":"2026-12-10T19:30:00Z","altText":"","attribute_Category":"History Tour","attribute_Rating":"","attribute_Type":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"3 Daft Monkeys","instanceDates":"27 November-27 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"79601ASCTKDBCBKCCCJCJDVJJNHDMCPQK","firstInstanceDateTime":"2026-11-27T20:00:00","firstInstanceDateTimeUtc":"2026-11-27T20:00:00Z","lastInstanceDateTime":"2026-11-27T20:00:00","lastInstanceDateTimeUtc":"2026-11-27T20:00:00Z","altText":"","attribute_Category":"Live Music","attribute_Type":"Other Music - Standing Gig","attribute_Rating":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"A Night at the Movies","instanceDates":"16 October-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"136001AHBTCQRKJMMSTPVJNKDLDQDTTBG","firstInstanceDateTime":"2026-10-16T19:30:00","firstInstanceDateTimeUtc":"2026-10-16T18:30:00Z","lastInstanceDateTime":"2026-10-16T19:30:00","lastInstanceDateTimeUtc":"2026-10-16T18:30:00Z","altText":"","attribute_Category":"Live Music","attribute_Type":"Musical Theatre","attribute_Rating":""},{"description":"PRIORITY BOOKING FOR SUPPORTERS ONLY UNTIL 2 MARCH 2026\r\nAn evening of classic comedy, poetry and beautiful piano music – three great shows in one!","htmlDescription":"<div id>\r\n\tAn evening of classic comedy, poetry and beautiful piano music – three great shows in one!<span><br/></span>Following his Sony album reaching No 1 in the Classical charts, Alistair McGowan combined his talents as master impressionist and comedian with his new-found talents as a classical pianist.<span><br/></span><span><br/></span> <span><br/></span><span><br/></span>Last year he published a book of poetry, Not What We were Expecting.<span><br/></span><span><br/></span> <span><br/></span><span><br/></span>Expect the comedy and impressions for which Alistair is known and loved, poignant and clever poetry, and much-loved piano gems by Chopin, Elgar, Grieg, Satie and Bill Evans, to name but a few. Beautiful music, beautiful words, and a large dose of Alistair’s trademark comedy!<span><br/></span><span><br/></span> <span><br/></span><span><br/></span>“Alistair McGowan’s impressions are faultless” – The Sunday Times<span><br/></span><span><br/></span> <span><br/></span><span><br/></span>“He plays the piano splendidly” – The Observer<span><br/></span><span><br/></span> <span><br/></span><span><br/></span>“You don’t get to be a great impressionist without a feel for rhythm and rhyme and pitch. These are terrific, truthful poems” – Sir Richard Stilgoe\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"Alistair McGowan - 3 in 1","instanceDates":"15 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"89801ALTKSQNTKRRGLGJGSSPLNBCNLDPP","firstInstanceDateTime":"2026-10-15T19:30:00","firstInstanceDateTimeUtc":"2026-10-15T18:30:00Z","lastInstanceDateTime":"2026-10-15T19:30:00","lastInstanceDateTimeUtc":"2026-10-15T18:30:00Z","altText":"","attribute_Category":"Live Comedy","attribute_Type":"Classical Music & Opera","attribute_Rating":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Along the Seashore in Watercolours","instanceDates":"23 January-23 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"141401ABJQPSTCPSRRGNSCLMDRNGDVBHD","firstInstanceDateTime":"2027-01-