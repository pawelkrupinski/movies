[{"description":"Neil Diamond Tribute ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"A Beautiful Noise","instanceDates":"20 February-20 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"459401APRNKSSVGPKBBBMTKJQHTHNMHLD","firstInstanceDateTime":"2027-02-20T19:30:00","firstInstanceDateTimeUtc":"2027-02-20T19:30:00Z","lastInstanceDateTime":"2027-02-20T19:30:00","lastInstanceDateTimeUtc":"2027-02-20T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6378","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"A Night To Remember: Motown Show takes you back in time to 1960’s Detroit. Be prepared for a high energy show, packed with the greatest Motown hits of all time. \r\n\r\nStarring The Voice UK finalist, Bizzi Dixon, and backed by the soulful vocal dynamics of The Motown Divas, this musical celebration is sure to have you singing along and dancing in the aisles and the streets.\r\n\r\nDon’t look any further! Reach out and grab your ticket to find out just how sweet it is to party all night long. This live show is guaranteed to be a night to remember!","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"A Night to Remember Motown Show","instanceDates":"11 June-11 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"463801ABLBHLJPNKDGPNBJBMLCRSSTCPD","firstInstanceDateTime":"2027-06-11T19:30:00","firstInstanceDateTimeUtc":"2027-06-11T18:30:00Z","lastInstanceDateTime":"2027-06-11T19:30:00","lastInstanceDateTimeUtc":"2027-06-11T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"4+","attribute_BlockBookings":false,"attribute_EMSEventID":"6669","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Fronted by Sting look and sound-a-like Owen James and his band ‘The Rozzers’, ‘A Tribute to Sting & The Police’ is the most authentic Sting tribute in Europe. From Roxanne and Every Breath You Take to Fields of Gold and Englishman in New York, all the hits are reproduced with stunning authenticity and vocal accuracy.","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"A Tribute to Sting & The Police - starring The Rozzers","instanceDates":"23 October-23 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"426602AMQNNVTNMKVCJKHDPJGGJMHTCKL","firstInstanceDateTime":"2026-10-23T19:30:00","firstInstanceDateTimeUtc":"2026-10-23T18:30:00Z","lastInstanceDateTime":"2026-10-23T19:30:00","lastInstanceDateTimeUtc":"2026-10-23T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6294","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"Across The Universe - The Beatles ‘66-70’","instanceDates":"14 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506801AVGPMLPKNGHSKBPCDGDPTCDTNKD","firstInstanceDateTime":"2027-10-14T19:30:00","firstInstanceDateTimeUtc":"2027-10-14T18:30:00Z","lastInstanceDateTime":"2027-10-14T19:30:00","lastInstanceDateTimeUtc":"2027-10-14T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6966","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Welcome to Adventures in Hidden History!—a joyfully interactive show\r\n\r\ncelebrating the lives, stories, and imaginations of Global Majority\r\n\r\ntrailblazers across time. Blending oral history, live music, and\r\n\r\nimaginative storytelling, the show invites audiences of all ages to explore\r\n\r\nhidden histories and dream forward into the dazzling realms of\r\n\r\nAfrofuturism. A tribute to our past, celebration of our present and an\r\n\r\ninvitation to let hidden history inspire our future. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Adventures in Hidden History","instanceDates":"23 October-23 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"490401AQJJGMCHQHDGKMSVLBPSJPVLRHS","firstInstanceDateTime":"2026-10-23T11:00:00","firstInstanceDateTimeUtc":"2026-10-23T10:00:00Z","lastInstanceDateTime":"2026-10-23T11:00:00","lastInstanceDateTimeUtc":"2026-10-23T10:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"7+","attribute_BlockBookings":false,"attribute_EMSEventID":"6900","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Waterstones is proud to welcome multi-Sunday Times bestselling author and poet Donna Ashworth to Taunton as she returns with a collection of poems and essays that teaches readers how to master the art of being easily pleased. Her most honest and hopeful book yet, it’s a collection that solidifies Donna’s status as a midlife cultural icon. Beloved by her 2M+ strong audience, Donna is known for her precise and relatable reflections on ageing, femininity and acceptance. In this book, fans will specifically learn how to live a life led by delight, wonder - and joy. The secret behind Donna’s power and meteoric rise is how she uses her poetic voice to help people truly adopt a more hopeful perspective.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"An Evening with Donna Ashworth","instanceDates":"1 November-1 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"502801AVDQHHMHCVVMGTTQVMQJRGJTJVP","firstInstanceDateTime":"2026-11-01T19:30:00","firstInstanceDateTimeUtc":"2026-11-01T19:30:00Z","lastInstanceDateTime":"2026-11-01T19:30:00","lastInstanceDateTimeUtc":"2026-11-01T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"7036","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":165,"imageUrl":"","isOnSale":true,"name":"André Rieu’s 2026 Christmas Concert: Let It Snow","instanceDates":"7 December-7 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"483201AQKDNHMBTRVRVKBSDLCLGQLMJSS","firstInstanceDateTime":"2026-12-07T19:30:00","firstInstanceDateTimeUtc":"2026-12-07T19:30:00Z","lastInstanceDateTime":"2026-12-07T19:30:00","lastInstanceDateTimeUtc":"2026-12-07T19:30:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6801","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"End Time: 21:15\r\n\r\nA Wimbledon line judge for 20 years, comedian Pauline Eyre is ready to spill the Pimms on tennis gossip from the fragrant royal box to the musty locker room, and why line judges are OUT! \r\nExpect smashing stories, ace anecdotes and a 40-love letter to the game. \r\nAnd there’s nobody to say ‘quiet please’. \r\nShe cannot be serious… can she? \r\n\r\n“Laughs aplenty… juicy locker room secrets... naughty line judge-y anarchy...motivational joy… Nice.”  5***** Northwestend ","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"Anyone for Tennis?","instanceDates":"16 October-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"437601AMRGHKJTJCBBRVTPPCJSCNVQDLL","firstInstanceDateTime":"2026-10-16T19:30:00","firstInstanceDateTimeUtc":"2026-10-16T18:30:00Z","lastInstanceDateTime":"2026-10-16T19:30:00","lastInstanceDateTimeUtc":"2026-10-16T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"16+","attribute_BlockBookings":false,"attribute_EMSEventID":"6423","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"50 years since ABBA’s iconic Arrival album first lit up the charts, the multi-award-winning show that shares the same name, Arrival – The Hits of ABBA, is back with a brand-new production!\r\n\r\nThis year, the show is more immersive than ever. Alongside even more songs from the landmark ‘Arrival’ album and the addition of interactive video projection, you can sing along to the lyrics on screen at the top of your lungs and become part of the performance!\r\n\r\nWith sensational vocals, expert musicianship, dazzling costumes, and breathtaking visuals, Arrival – The Hits of ABBA takes you on an unforgettable journey through the timeless music that changed pop history. From the Eurovision-winning ‘Waterloo’ to infectious disco anthems like ‘Gimme! Gimme! Gimme!’, ‘Mamma Mia’, ‘Voulez-Vous’, and ‘Fernando’, every song will have you dancing in the aisles and singing along with pure joy and nostalgia!\r\n\r\nWhether you’ve been a fan since day one or are discovering their magic for the first time, this is the ultimate celebration of a legendary band and the ‘Arrival’ album that helped define an era.","htmlDescription":"<div id>\r\n\r\n</div>","duration":170,"imageUrl":"","isOnSale":true,"name":"Arrival - The Hits of ABBA","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"439201ANBNJHRRTHSSHCVKRMKNDTGGGKG","firstInstanceDateTime":"2026-10-17T19:30:00","firstInstanceDateTimeUtc":"2026-10-17T18:30:00Z","lastInstanceDateTime":"2026-10-17T19:30:00","lastInstanceDateTimeUtc":"2026-10-17T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"5320","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Beyond the Barricade, the UK’s longest running Musical Theatre Concert Tour, is\r\nback. Join the cast for two hours of the best of Broadway and the West End,\r\nfeaturing the songs that have made audiences return over and over again for more\r\nthan 25 years. Enjoy numbers from The Phantom of the Opera, Jesus Christ\r\nSuperstar, West Side Story, The Lion King, Blood Brothers, Miss Saigon, Hamilton\r\nand many others, climaxing with a spectacular finale from, of course, Les\r\nMisérables!\r\nThe concert tour will feature Andy Reiss, David Fawcett, Katie Leeming and Poppy\r\nTierney, who have all played principal roles in both the West End and UK Tours of\r\nLes Misérables, together with a live band who capture the feel of the original\r\norchestrations of the chosen musicals.\r\nTo this day every musical note is still played and sung live – very rare indeed.\r\nBeyond the Barricade gives musical theatre songs a bold concert format treatment –\r\nbut with the conviction and intention to deliver the material as if the audience are\r\nwatching the original performance.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Beyond the Barricade","instanceDates":"2 April-2 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482401ABDBTPDVDHGKBSGQRQGVRJRDGQS","firstInstanceDateTime":"2027-04-02T19:30:00","firstInstanceDateTimeUtc":"2027-04-02T18:30:00Z","lastInstanceDateTime":"2027-04-02T19:30:00","lastInstanceDateTimeUtc":"2027-04-02T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6721","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The swirling majesty and joyous sounds of the traditional Viennese Gala will see you spinning into the New Year with a flourish! Merry waltzes, polkas and marches from Johann Strauss II, his family and contemporaries fill this sparkling concert that will transport you from your seat in the Theatre all the way into the traditional gala halls of Vienna.\r\n\r\n\r\n\r\n\r\nThis concert of joyous music includes all of Strauss’ greats such as the Fledermaus Overture, Thunder and Lightning Polka, Radetzky March and, of course, The Blue Danube! This beguiling performance that will ensure a glamorous start to your New Year!","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"BSO 2027: New Year’s Viennese Gala","instanceDates":"2 January-2 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"479201AQDRKRDHGGHTJLTLJGBNVDGBPJS","firstInstanceDateTime":"2027-01-02T19:30:00","firstInstanceDateTimeUtc":"2027-01-02T19:30:00Z","lastInstanceDateTime":"2027-01-02T19:30:00","lastInstanceDateTimeUtc":"2027-01-02T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6554","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"CHOOSE GEORGE - Celebrating George Michael","instanceDates":"27 February-27 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506201ASQNHJPMVDNGRKSMHGTNSGCCLNM","firstInstanceDateTime":"2027-02-27T19:30:00","firstInstanceDateTimeUtc":"2027-02-27T19:30:00Z","lastInstanceDateTime":"2027-02-27T19:30:00","lastInstanceDateTimeUtc":"2027-02-27T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6644","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"CINEMA: Coco","instanceDates":"30 October-30 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"503001ABNMCMBBCLGGCKTJJMNQTBBTQDS","firstInstanceDateTime":"2026-10-30T11:00:00","firstInstanceDateTimeUtc":"2026-10-30T11:00:00Z","lastInstanceDateTime":"2026-10-30T11:00:00","lastInstanceDateTimeUtc":"2026-10-30T11:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6972","attribute_FacilitatedBookings":false,"attribute_FilmClassification":"PG","attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":92,"imageUrl":"","isOnSale":true,"name":"CINEMA: Familiar Touch","instanceDates":"19 October-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"503401APTPRRCTMMMMNSMCMRRNJTVLVLP","firstInstanceDateTime":"2026-10-19T11:00:00","firstInstanceDateTimeUtc":"2026-10-19T10:00:00Z","lastInstanceDateTime":"2026-10-19T11:00:00","lastInstanceDateTimeUtc":"2026-10-19T10:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"7017","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"COLDPLACE","instanceDates":"9 September-9 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"503601ADCDVKSBDMCTNKJKBHKPKBHVJCD","firstInstanceDateTime":"2027-09-09T19:30:00","firstInstanceDateTimeUtc":"2027-09-09T18:30:00Z","lastInstanceDateTime":"2027-09-09T19:30:00","lastInstanceDateTimeUtc":"2027-09-09T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"7020","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_TriggerWarning":"use of lasers","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"Join bestselling crime author, Clare Donoghue and the Taunton Thespians at the Brewhouse Theatre for a thrilling evening of death, detective work and drinks and nibbles.\r\n\r\nThe Brewhouse Bards are making their final preparations for their Halloween performance of Bram Stoker’s Dracula. With only a handful of main parts and stage time to fight for, competition is fierce. On the night of the dress rehearsal, a selective few members of the public have been invited to the performance. However, as with all dress rehearsals they’ve been told to expect delays, interruptions and the occasional missed line, and entrance. What they didn’t expect was murder.\r\n\r\nCan our audience, turned detectives, solve the murder before the killer strikes again?\r\n\r\nDetectives will be put into teams of 6 to solve the murder and there will be special prizes for the top three teams.\r\n\r\nBook a full team of 6 in one transaction and get £5 off per person! Tickets include the murder mystery experience, nibbles supplied by Mr Miles, plus a book by Clare Donoghue. Clare will also do a book signing at the end of the event.","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"'Dracula is Dead' Murder Mystery with Taunton Thespians","instanceDates":"19 October-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"483401AJKLDRQSGMQLCCQPDNTGVRVJVJC","firstInstanceDateTime":"2026-10-19T18:00:00","firstInstanceDateTimeUtc":"2026-10-19T17:00:00Z","lastInstanceDateTime":"2026-10-19T18:00:00","lastInstanceDateTimeUtc":"2026-10-19T17:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"5986","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"From the Olivier nominated duo behind the hugely celebrated critically acclaimed West End hit ERIC & LITTLE ERN.\r\n\r\nThis is a show for all the family from 8 to 80!\r\n\r\nA brilliant homage crammed full of renditions of those famous comedy sketches, that hits all the right notes!\r\n\r\nFrom Greig’s Piano concerto to Mr Memory, “Arsenal!” It’s a show full of Morecambe and Wise’s most loved routines, songs and sketches and of course a musical guest.\r\n\r\nThis wonderful show, evokes memories of times when whole families would huddle around the telly to watch those fantastic Christmas specials.\r\n\r\nYou’ll feel you’ve experienced the real thing and been taken back to a world of sunshine and laughter.\r\n\r\nAs seen on The One show BBC1 and The Alan Titchmarsh Show ITV.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Eric & Ern","instanceDates":"21 October-21 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"456401AVDRHLTJNTLTPRQCTGTNCRNGBPC","firstInstanceDateTime":"2026-10-21T19:30:00","firstInstanceDateTimeUtc":"2026-10-21T18:30:00Z","lastInstanceDateTime":"2026-10-21T19:30:00","lastInstanceDateTimeUtc":"2026-10-21T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6429","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Join us for a spectacular recording of Sir Kenneth MacMillan’s exquisite ballet, performed in a limited run at The Royal Albert Hall, with performances that will leave you spellbound.\r\n\r\nFor wonder and enchantment, look no further than this classic fairytale ballet. Experience all that is grand, gleaming and gorgeous in a stunning version of one of the world’s favourite stories.\r\n\r\nAs a baby, Princess Aurora is cursed by the wicked Carabosse: on her 16th birthday, she will prick her finger and die. Her godmother the Lilac Fairy alters the spell so Aurora will not die, but sleep for 100 years. Only a true love’s kiss can break the spell and awaken her.\r\n\r\nFrom Aurora’s christening in the grand hall of the palace, to her jubilant wedding celebrations, the bewitching fairy tale is brought to life before your eyes.","htmlDescription":"<div id>\r\n\r\n</div>","duration":144,"imageUrl":"","isOnSale":true,"name":"EVENT CINEMA: English National Ballet presents The Sleeping Beauty","instanceDates":"18 October-18 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"505801AKKCJLDQKJDHPTMHBVDPSPNQQHD","firstInstanceDateTime":"2026-10-18T14:00:00","firstInstanceDateTimeUtc":"2026-10-18T13:00:00Z","lastInstanceDateTime":"2026-10-18T14:00:00","lastInstanceDateTimeUtc":"2026-10-18T13:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"7053","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"EVENT CINEMA: Fallen Angels by Noël Coward","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"498001ANMQPBSGVGJKCPVJHVHRDNVGPBM","firstInstanceDateTime":"2026-10-25T19:30:00","firstInstanceDateTimeUtc":"2026-10-25T19:30:00Z","lastInstanceDateTime":"2026-10-25T19:30:00","lastInstanceDateTimeUtc":"2026-10-25T19:30:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6984","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Exhibition on Screen - Monet","instanceDates":"11 May-11 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484401ANKHGQMGHHTHLNTRHGRGBHPKNQG","firstInstanceDateTime":"2027-05-11T19:30:00","firstInstanceDateTimeUtc":"2027-05-11T18:30:00Z","lastInstanceDateTime":"2027-05-11T19:30:00","lastInstanceDateTimeUtc":"2027-05-11T18:30:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6877","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Exhibition on Screen - Renoir and Love","instanceDates":"19 January-19 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484001ALSBSMSJGLMTNCLTHVJMRPTVPMN","firstInstanceDateTime":"2027-01-19T19:30:00","firstInstanceDateTimeUtc":"2027-01-19T19:30:00Z","lastInstanceDateTime":"2027-01-19T19:30:00","lastInstanceDateTimeUtc":"2027-01-19T19:30:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6876","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"This series of workshops will focus on 'How to work in a folk ensemble'. Archie Churchill-Moss is an experienced mixed-instrument workshop leader having lead ensembles at Halsway Manor, Cambridge folk festival and his continuous work on the National Youth Folk Ensemble. The course is open to all players of instruments of an intermediate level with a curiosity for how to: arrange instrumental folk music, understand diatonic harmony and communicate with other musicians in an ensemble. These sessions will be sequential and whilst there is no obligation to attend every session please understand that we will be building on previous sessions to produce performable music and work towards tangible ensemble goals.\r\n\r\nAbout the artist: Archie Churchill-Moss’s journey through the musical landscape is one of rich collaboration and unwavering commitment to the diatonic button accordion—a craft that has earned him widespread acclaim and reverence. A pioneer in combining folk music with live electronics and a celebrated composer, Archie’s innovative approach seamlessly blends traditional idioms with contemporary composition. His keen attention to modern influences has enabled him to create soundscapes that expand the horizons of folk music. His music has resonated widely, receiving multiple plays on BBC Radio 2 and BBC Radio 3. Archie's career as a session musician is a testament to his versatility and skill. He has collaborated with esteemed folk and traditional artists such as Seth Lakeman, Sam Sweeney, Cara Dillon, Jim Moray, Eliza Carthy, Sam Kelly, and Sam Carter. Outside the ‘folk-sphere’, Archie has worked on projects with world-renowned Welsh opera singer Sir Bryn Terfel, and has received performance credits alongside Sting, Patrick Rimes, and Port Isaac’s Fisherman’s Friends. These collaborations have led to appearances on S4C, BBC, and Channel 4’s Sunday Brunch.\r\n\r\n\r\n\r\nBeyond the stage, Archie’s role as an educator amplifies his impact on the musical landscape. As a Principal Lecturer at Leeds Conservatoire, he has developed a teaching style characterised by warmth and insight, guiding musicians to discover their own voices within the rich tradition of folk music. His expertise also extends to the master’s program at the University of Limerick, where he works closely with postgraduate students to develop their instrumental performance skills.","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Folk Workshop with Archie Churchill-Moss","instanceDates":"16 January-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"504201ADCKKKGTRNCRPNMDGNPGMDLKHJC","firstInstanceDateTime":"2027-01-16T10:00:00","firstInstanceDateTimeUtc":"2027-01-16T10:00:00Z","lastInstanceDateTime":"2027-10-16T10:00:00","lastInstanceDateTimeUtc":"2027-10-16T09:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6845","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Giovanni - Unstoppable","instanceDates":"22 March-23 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482801AKPHHSDRTDGTQCHPLGRHMGKMCSJ","firstInstanceDateTime":"2027-03-22T19:30:00","firstInstanceDateTimeUtc":"2027-03-22T19:30:00Z","lastInstanceDateTime":"2027-03-23T19:30:00","lastInstanceDateTimeUtc":"2027-03-23T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6867","attribute_FacilitatedBookings":false,"attribute_Genre":"Dance","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Sun-soaked, harmony-fuelled and bursting with fresh energy, this is a Beach Boys celebration unlike anything you've seen before.\r\n\r\nA new generation of world-class musicians brings the legendary California sound roaring back to life with stunning vocals, exceptional musicianship and effortless cool.\r\n\r\nNo gimmicks. No impersonations. Just real voices, real instruments and the timeless songs that defined a generation, performed with passion, authenticity and infectious energy.\r\n\r\nFrom surf-rock anthems and chart-topping classics to beautifully crafted hidden gems, this feel-good production captures the heart and spirit of the originals while delivering a vibrant, contemporary theatre experience for today's audiences.\r\n\r\nBigger, brighter and more alive than ever, get ready to rediscover the music that made the world smile.","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"Good Vibrations - The Beach Boys Experience","instanceDates":"27 May-27 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"499601AGDQMDDGTSMHSNJLMMPPVCGMNDM","firstInstanceDateTime":"2027-05-27T19:30:00","firstInstanceDateTimeUtc":"2027-05-27T18:30:00Z","lastInstanceDateTime":"2027-05-27T19:30:00","lastInstanceDateTimeUtc":"2027-05-27T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6842","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Harriet’s life has been in constant chaos for as long as she can remember. So what happens when things start to go right for the multi-award winning stand-up comedian? \r\n\r\nFollowing her eye opening appearance on Last One Laughing UK, Harriet is back on tour with a new show about dating, mushrooms and how she’s trying her absolute best to be a bit of a floozy.\r\n\r\nAs seen and heard on Live at the Apollo, Would I Lie to You?, 8 Out of 10 Cats Does Countdown and co-host of the wildly successful Single Ladies In Your Area podcast.\r\n\r\n‘Extraordinarily talented’ ★★★★ Scotsman \r\n‘Packs in high calibre jokes’★★★★ Guardian \r\n‘A masterful hour’ ★★★★ Skinny\r\n‘Effervescent’ ★★★★ EdFest Mag","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Harriet Kemsley: Floozy","instanceDates":"12 February-12 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"467801AHQTBMMPKBTRGPRKDJVKGVPPKJC","firstInstanceDateTime":"2027-02-12T19:30:00","firstInstanceDateTimeUtc":"2027-02-12T19:30:00Z","lastInstanceDateTime":"2027-02-12T19:30:00","lastInstanceDateTimeUtc":"2027-02-12T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6692","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Roll Up! Roll Up! The risqué, raunchy & ridiculous people of Hundred Watt Club return to Taunton with another glittering and glorious evening of burlesque, vaudeville & comedy!\r\n\r\nStep into a world of old time glamour and new time wit, with a seductive, sizzling and sometimes very silly cast hand selected by Hundred Watt Club’s Lena Lenman, this show is a no-holds barred, full throttle journey into the wonderful world of showgirls, spectacles & songbirds.\r\n\r\nHundred Watt Club is proud to be one of the longest running burlesque revues in the UK…Expect the unexpected, but gear up for a good old fashioned, very grown up evening of variety entertainment. Forget your troubles and come to the cabaret!\r\n\r\nCONTENT WARNINGS:\r\nStrong language, adult themes, partial nudity, loud noises. Over 18s only.\r\n\r\nDRESS CODE:\r\nGlamorous, red carpet style attire is encouraged (we love it when you dress up!) but not enforced; wear what you’re comfy in.\r\n\r\nWHAT THE CRITICS SAY:\r\n“Old school mischief and timeless raunchiness collide at the Hundred Watt Club. Hats – and corsets – off to Lena Mae for an excellent night of entertainment” – Sussex Express\r\n\r\n“Coarse and unpleasant…for coarse and unpleasant people” – Seetickets review\r\n\r\n“A mix of wild talent, quick wit and fearless self-expression. From high-flying juggling skills to comedy with bite, it was an evening that danced on the edge and winked as it did so.” – Lulu & Scott\r\n\r\n“Harking back to the gin drenched halcyon days of a grimy Berlin nightclub in the 1930s, Hundred Watt Club sparkles, fizzles and shines brightly on a dark night” – Fringe Review (Brighton)","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Hundred Watt Club - An evening of burlesque & cabaret","instanceDates":"19 February-19 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"505401ARJBPMQQPTMJTQKPNNGQBVRDKGJ","firstInstanceDateTime":"2027-02-19T19:30:00","firstInstanceDateTimeUtc":"2027-02-19T19:30:00Z","lastInstanceDateTime":"2027-02-19T19:30:00","lastInstanceDateTimeUtc":"2027-02-19T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6751","attribute_FacilitatedBookings":false,"attribute_Genre":"Variety","attribute_TriggerWarning":"Mental health ","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"Family theatre and rock star legend Kid Carpet is back with a totally brand new show! \r\n\r\nKid Carpet hates panto. The Noisy Animals absolutely love it. So guess what they’re doing? Yep. A panto. Now there’s a beanstalk in the middle of everything and nobody’s quite sure what’s going on.\r\n\r\nFeaturing Bear, Gorilla, Badger and Hedgehog (with possible appearances from Hedgehog’s golden eggs), this is Jack & the Beanstalk like it’s been thrown in a blender with a drum machine and dodgy celebrity lookalikes. Part air guitar workshop, part magical mess, this lo-fi, hi-tech, big-beat bonkers show is stuffed with songs, silliness and surprise grannies.\r\n\r\nBring your kids. Bring yer nan. Bring snacks. It’s theatre, but it’s loud, proud and completely off its bean(stalk).\r\n\r\nPerfect for ages 3–10, families, party monsters and fans of noisy nonsense.\r\n\r\nFrom the makers of Kid Carpet & The Noisy Animals, Noisy Holiday, Kid Carpet & The Noisy Neighbours, Noisy Nativity, Kid Carpet & The Noisy Garden Centre, Kid Carpet’s Super Mega Rockin’ Rock Show and more!\r\n\r\nWith help from Chris Collier, Stephanie Kempson and Natalie Otto. Illustration by Hannah Broadway.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Jack & the Beanstalk (Sort Of)","instanceDates":"3 April-3 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"455201AGQPVGTRHRVLMBMBQMMTHSBQKDV","firstInstanceDateTime":"2027-04-03T11:00:00","firstInstanceDateTimeUtc":"2027-04-03T10:00:00Z","lastInstanceDateTime":"2027-04-03T14:00:00","lastInstanceDateTimeUtc":"2027-04-03T13:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"3-10","attribute_BlockBookings":false,"attribute_EMSEventID":"6528","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"A show by Jack about jokes. Who doesn’t like jokes? If your answer to that question is “Me!” then steer well clear of this show. Celebrating 40 years in standup comedy, Jack takes us on a memoir of all his favourite old stories. Jokes and funny anecdotes have intrigued Jack for as long as he can remember. Now he has assembled the best of them to form a new show that offers a glimpse of the influences that led him into and helped shape his comedy career. Guaranteed no new material.\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Jack Dee: Jack’s Joke Show","instanceDates":"19 May-19 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"505001ABVHCMVCSJKDQVRMVLBJCDJCPNN","firstInstanceDateTime":"2027-05-19T19:30:00","firstInstanceDateTimeUtc":"2027-05-19T18:30:00Z","lastInstanceDateTime":"2027-05-19T19:30:00","lastInstanceDateTimeUtc":"2027-05-19T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"strictly 14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6989","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Tilting at Windmills is the brand-new stand-up show from Taskmaster alumni and double Edinburgh Comedy Award Winner, John Kearns.\r\nA fragmented, digressing portrayal of a 38-year-old man’s life, alluding to books he hasn’t read, touching on the modern condition. Plus VAT! More allusive and bleak as ever, it is unreal the comedian you become. And for who? Decent craic with the right crowd. A show for those who have read about but not committed to the Guinness Nitrosurge.  \r\n\r\nSeen bewildered on Taskmaster (Channel 4), terrified on Live at the Apollo (BBC), getting through Never Mind the Buzzcocks (Sky), and implicating others on his Sky stand-up special The Varnishing Days.\r\n\r\nMore comfortable on pods but comes alive on stage, for your pleasure.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"John Kearns: Tilting at Windmills","instanceDates":"4 November-4 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"436401AJTKMNRNKRHDPCCJRMMCDSCPQPG","firstInstanceDateTime":"2026-11-04T19:30:00","firstInstanceDateTimeUtc":"2026-11-04T19:30:00Z","lastInstanceDateTime":"2026-11-04T19:30:00","lastInstanceDateTimeUtc":"2026-11-04T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6426","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"King of Pop","instanceDates":"14 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"366001ASNRQCRGGNGJSBKKJRNBJJVBHSM","firstInstanceDateTime":"2026-10-14T19:30:00","firstInstanceDateTimeUtc":"2026-10-14T18:30:00Z","lastInstanceDateTime":"2026-10-14T19:30:00","lastInstanceDateTimeUtc":"2026-10-14T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"5615 ","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"“Enter… Stranger!” The smash hit comedy show of the cult 90s TV dungeon adventure is back! With devilish new puzzles, terrifying new monsters and as always, a talking wall.\u2028\r\n\r\nSidestep left into adventure as dungeon master Treguard opens the doors once more for the award-winning, live action, fantasy gameshow where you might finally get the chance to don the Helmet of Justice and battle Lord Fear’s army of goblins, spinning blades and tricky word puzzles.\r\n\r\n\u2028Join us for a family friendly, hilarious and full hearted homage to the iconic TV show where you’ll finally get to shout “you’re in a room!” Starring Tom Bell (The Mash Report), Paul Flannery and a host of brilliant guest comedians.\r\n\r\n★★★★★ \u2028\"Spellcasting A-W-E-S-O-M-E\"\u2028INDEPENDENT \u2028\r\n\r\n★★★★★ \u2028TIME OUT\u2028“A nostalgic dream come true!”\u2028","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Knightmare Live","instanceDates":"6 March-6 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"499201AVCKTTNTDMGTKJTPVMPCRDQVKVP","firstInstanceDateTime":"2027-03-06T19:30:00","firstInstanceDateTimeUtc":"2027-03-06T19:30:00Z","lastInstanceDateTime":"2027-03-06T19:30:00","lastInstanceDateTimeUtc":"2027-03-06T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"8+","attribute_BlockBookings":false,"attribute_EMSEventID":"6973","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Taunton Brewhouse are excited to be working in partnership with Hestercombe House and Gardens to bring you a special series of festive craft workshops in the beautiful surroundings of Hestercombe Estate. Your ticket includes access to the house and gardens (adult ticket usually £16.90)  so you can enjoy a short walk or a look around the house in your lunch break or after the workshop too.  Hestercombe opening hours are 10am – 5pm.\r\n\r\nThere is free parking at Hestercombe and on arrival please report to the main ticket office where you will be directed to the workshop room.\r\n\r\nPlease note: use the postcode TA2 8LQ for Sat Nav*\r\n\r\nWhat 3 Words address: ///fancy.arena.tanks\r\n\r\nThe route is marked out with brown daisy signs from the motorway all the way to Cheddon Fitzpaine.\r\n\r\nUpon following the sign from Cheddon Fitzpaine, stay on the main road until you reach Hestercombe Gardens. Do not take a turn onto Hestercombe Road as this will take you to the farm and not to Hestercombe Gardens.\r\n\r\n........................................................................................\r\n\r\n\r\n\r\nJoin printmaker Alex Williams for an introductory session to lino printing. Linocut is a satisfying way of creating bold, repeatable images. Alex will guide you to develop your design ready for carving into a piece of lino and teach you how to safely carve it. You’ll then learn how to ink up your carved plate ready to print onto paper. You can make your own cards or print directly onto paper.\r\n\r\nPlease feel free to bring along a packed lunch to enjoy in your lunch break, tea and coffee will be available in the workshop room.\r\n\r\n\r\n\r\nAbout your workshop leader:\r\n\r\nI am a Somerset based artist and printmaker whose work focuses on still life, ceramics and architecture. In my work I seek to simplify form and pattern and enjoys using a bright and bold colour palette to create joyful prints. I have a BA in Fine Art/Illustration and Art History where I first learnt a range of different printmaking methods. I also have a PGCE in Art and Design and am an experienced teacher and workshop leader - I run a number of the children’s and young people’s workshops here at Taunton Brewhouse as well as printmaking and art workshops for adults. I love printmaking as a medium as I love the problem-solving aspect and the multi-step processes involved in creating each piece. I use a range of different linocut techniques depending on the outcome I'm hoping to achieve but also enjoy experimenting with more direct methods of monoprinting to create one off pieces. One of the things I love about linocut is the way that you can create multiple original pieces from the same plate but that each print will never be exactly the same as the next - as such, prints can be an affordable way of bringing original art into your home. My work is all about colour and pattern and I'm inspired by all sorts of things from the kitchen shelves to museum displays, auction catalogues, vintage fabrics and beautiful flowers. My work is all about colour and pattern and I'm inspired by all sorts of things from the kitchen shelves to museum displays, auction catalogues, vintage fabrics and beautiful flowers. It has a hint of history or nostalgia about it but with its colours maximised, creating pieces people will want to hang on their walls and enjoy looking at every day.\r\n\r\n....................\r\n\r\nInclude hestercombe logo and web link","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"LEARN at Hestercombe: Beginners Lino Printing","instanceDates":"17 November-17 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"495001ARGTKHTTRNMLTRQHRMTJSHRLDSN","firstInstanceDateTime":"2026-11-17T10:30:00","firstInstanceDateTimeUtc":"2026-11-17T10:30:00Z","lastInstanceDateTime":"2026-11-17T10:30:00","lastInstanceDateTimeUtc":"2026-11-17T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6946","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Taunton Brewhouse are excited to be working in partnership with Hestercombe House and Gardens to bring you a special series of festive craft workshops in the beautiful surroundings of Hestercombe Estate. Your ticket includes access to the house and gardens (adult ticket usually £16.90)  so you can enjoy a short walk or a look around the house in your lunch break or after the workshop too.  Hestercombe opening hours are 10am – 5pm.\r\n\r\nThere is free parking at Hestercombe and on arrival please report to the main ticket office where you will be directed to the workshop room.\r\n\r\nPlease note: use the postcode TA2 8LQ for Sat Nav*\r\n\r\nWhat 3 Words address: ///fancy.arena.tanks\r\n\r\nThe route is marked out with brown daisy signs from the motorway all the way to Cheddon Fitzpaine.\r\n\r\nUpon following the sign from Cheddon Fitzpaine, stay on the main road until you reach Hestercombe Gardens. Do not take a turn onto Hestercombe Road as this will take you to the farm and not to Hestercombe Gardens.\r\n\r\n\r\n\r\n............................\r\n\r\nIf you joined Ali this morning for the rag wreath workshop, you'll already know that she has a talent for turning beautiful fabric scraps into something genuinely special. This afternoon, you're going to do it again — this time in miniature.\r\n\r\nThese fabric baubles are a joy to make. Tactile, satisfying, and finished far faster than you'd expect, they're the kind of thing you find yourself wanting to make in multiples — working through Ali's gorgeous fabric selection, mixing colours and textures until you've got a little collection worth hanging on the tree.\r\n\r\nThey also happen to be one of the most sustainable decorations you can make. Every scrap of fabric finds a use, and what you go home with is entirely handmade and completely your own.\r\n\r\nThe workshop includes everything you need, and Ali will guide you through each step. No experience necessary — just come ready to enjoy a slow, creative afternoon.\r\n\r\n\r\n\r\nAbout your workshop leader: \r\n\r\nAli is a designer and multidisciplinary maker with a love of colour, pattern and print, who is happiest when she’s creating. She’s passionate about sharing her enthusiasm for sewing, dressmaking and textile design whether through inspiring conversations, relaxed and friendly workshops, or connecting with others over beautiful fabrics.\r\n\r\nAli has supported creatives in a wide range of settings, nurturing confidence and encouraging personal growth through hands-on making, curiosity and thoughtful guidance. She studied Textile Design at Loughborough College of Art and has worked across printed textile design, interior design, visual merchandising and education.\r\n\r\n...............................\r\n\r\ninclude hestercombe logo and web link","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN at Hestercombe: Fabric Baubles","instanceDates":"19 November-19 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"495401APBJRVDLVHHGVPSGVNCGMHQJDPG","firstInstanceDateTime":"2026-11-19T14:30:00","firstInstanceDateTimeUtc":"2026-11-19T14:30:00Z","lastInstanceDateTime":"2026-11-19T14:30:00","lastInstanceDateTimeUtc":"2026-11-19T14:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6950","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Taunton Brewhouse are excited to be working in partnership with Hestercombe House and Gardens to bring you a special series of festive craft workshops in the beautiful surroundings of Hestercombe Estate. Your ticket includes access to the house and gardens (adult ticket usually £16.90)  so you can enjoy a short walk or a look around the house in your lunch break or after the workshop too.  Hestercombe opening hours are 10am – 5pm.\r\n\r\nThere is free parking at Hestercombe and on arrival please report to the main ticket office where you will be directed to the workshop room.\r\n\r\nPlease note: use the postcode TA2 8LQ for Sat Nav*\r\n\r\nWhat 3 Words address: ///fancy.arena.tanks\r\n\r\nThe route is marked out with brown daisy signs from the motorway all the way to Cheddon Fitzpaine.\r\n\r\nUpon following the sign from Cheddon Fitzpaine, stay on the main road until you reach Hestercombe Gardens. Do not take a turn onto Hestercombe Road as this will take you to the farm and not to Hestercombe Gardens.\r\n\r\n\r\n\r\n............................\r\n\r\nAli is a maker who wastes nothing. Every beautiful fabric she works with — and she works with a lot — gets used to its fullest. Larger pieces find their way into garment linings and bag pockets. Smaller scraps get cut into strips. And even the tiniest offcuts get kept, because Ali knows that good fabric deserves a second life.\r\n\r\nThose strips and scraps are exactly what you'll be working with in this workshop, transforming them into a gorgeous rag wreath to take home and hang on your door this Christmas.\r\n\r\nRag wreaths are a wonderfully satisfying make — tactile, forgiving, and genuinely enjoyable to put together, whatever your experience level. Ali's fabric choices are beautiful: rich colours and textures that make for a wreath that feels considered and special rather than thrown together.\r\n\r\nEverything you need is included in your workshop, so you can just turn up, settle in, and make something lovely.\r\n\r\n\r\n\r\nAbout your workshop leader: \r\n\r\nAli is a designer and multidisciplinary maker with a love of colour, pattern and print, who is happiest when she’s creating. She’s passionate about sharing her enthusiasm for sewing, dressmaking and textile design whether through inspiring conversations, relaxed and friendly workshops, or connecting with others over beautiful fabrics.\r\n\r\nAli has supported creatives in a wide range of settings, nurturing confidence and encouraging personal growth through hands-on making, curiosity and thoughtful guidance. She studied Textile Design at Loughborough College of Art and has worked across printed textile design, interior design, visual merchandising and education.\r\n\r\n...............................\r\n\r\ninclude hestercombe logo and web link","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"LEARN at Hestercombe: Rag Wreaths","instanceDates":"19 November-19 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"495201ASJGKJQJLRHBLHKHLKKSLHQTDRL","firstInstanceDateTime":"2026-11-19T10:30:00","firstInstanceDateTimeUtc":"2026-11-19T10:30:00Z","lastInstanceDateTime":"2026-11-19T10:30:00","lastInstanceDateTimeUtc":"2026-11-19T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6948","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Taunton Brewhouse are excited to be working in partnership with Hestercombe House and Gardens to bring you a special series of festive craft workshops in the beautiful surroundings of Hestercombe Estate. Your ticket includes access to the house and gardens (adult ticket usually £16.90)  so you can enjoy a short walk or a look around the house in your lunch break or after the workshop too.  Hestercombe opening hours are 10am – 5pm.\r\n\r\nThere is free parking at Hestercombe and on arrival please report to the main ticket office where you will be directed to the workshop room.\r\n\r\nPlease note: use the postcode TA2 8LQ for Sat Nav*\r\n\r\nWhat 3 Words address: ///fancy.arena.tanks\r\n\r\nThe route is marked out with brown daisy signs from the motorway all the way to Cheddon Fitzpaine.\r\n\r\nUpon following the sign from Cheddon Fitzpaine, stay on the main road until you reach Hestercombe Gardens. Do not take a turn onto Hestercombe Road as this will take you to the farm and not to Hestercombe Gardens.\r\n\r\n\r\n\r\n............................\r\n\r\nUnleash your creative side and make your own Christmas centre piece with Amanda. Learn how to make a willow reindeer using locally sourced Somerset willow. The workshop is suitable for beginners with no experience of willow weaving or those who have already tried it.  Amanda will guide you through the process of creating your sculpture step by step and give you options so that you can customise your sculpture.\r\nAll materials will be provided, however willow weaving is messy activity so please wear old comfortable clothing or an apron.\r\n\r\nAbout your workshop leader:\r\n\r\n\"I fell in love with willow at Christmas 2000 when I was a student in a willow weaving workshop, and it has been my material of choice ever since. The willow I use is grown on the Somerset Levels within a mile of my house making it a local and sustainable material. However, being a full-time teacher weaving was just a hobby as I never had the time to fully commit to my art. That all changed in 2022 when after 33 years of teaching I retired and started Amanda Webb Makes creating and selling my sculptures along with sharing my passion through teaching people of all ages how to weave in my workshops.\"\r\n\r\nPlease feel free to bring along a packed lunch to enjoy in your lunch break, tea and coffee will be available in the workshop room.\r\n\r\n...............................\r\n\r\ninclude hestercombe logo and web link on our webpage","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"LEARN at Hestercombe: Willow Reindeer","instanceDates":"12 November-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"494801ADRMTRJBRPJGCPRKHDPJPTTSLMJ","firstInstanceDateTime":"2026-11-12T10:30:00","firstInstanceDateTimeUtc":"2026-11-12T10:30:00Z","lastInstanceDateTime":"2026-11-12T10:30:00","lastInstanceDateTimeUtc":"2026-11-12T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6861","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"If you already have some ballet experience, perhaps you learnt as a child and want to keep developing your skills, this friendly and supportive class is for you. Each week, Claire will help you build strength, confidence and musicality, while refining technique and posture in a relaxed, encouraging environment.\r\n\r\nPerfect for those who know the basics and are ready to progress, this termly class offers the chance to move with grace, enjoy beautiful music, and connect with others who share a love of dance. Wear something comfortable you can move in, with soft shoes or ballet pumps, and bring a bottle of water. Payment is for the full term at the time of booking.\r\nIf you are uncertain if this class will suit your skill level or you are nervous to return to dance, please do contact the LEARN coordinator for an informal chat to help you decide if the class is for you.\r\nAbout your workshop leader:\r\nClaire Butler is an experienced and passionate ballet dancer and teacher, having worked with children, young people and adults throughout her career.   In addition to her various dancing and teaching qualifications she has completed all her ballet exams and is completing a level four Diploma in Dance Education from the Imperial Society of Teachers of Dancing. She is excited to be working with a new group of adults at Taunton Brewhouse sharing her love for this dance form with complete beginners and those returning to dance after a break.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"LEARN: Adult Ballet for Improvers","instanceDates":"14 January-21 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"443601ARBJDNKLHKLNKJMNCNNSMBMQTQL","firstInstanceDateTime":"2026-01-14T18:45:00","firstInstanceDateTimeUtc":"2026-01-14T18:45:00Z","lastInstanceDateTime":"2026-10-21T18:45:00","lastInstanceDateTimeUtc":"2026-10-21T17:45:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6465","attribute_FacilitatedBookings":false,"attribute_Genre":"Dance","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"If you struggle with plot, the answer might be simpler than you think – start with character. This workshop focuses on building vivid, believable people whose choices and contradictions naturally generate story.\r\n\r\nYou’ll develop a character from the ground up, exploring voice, desire, flaws and backstory, before placing them into different situations to see how they respond. By the end, you’ll have a fully realised character, a stronger grasp of motivation and voice, and multiple story directions you could take next. Ideal for anyone who wants their writing to feel more natural, engaging and alive.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Character First: Creating People Who Drive the Story","instanceDates":"12 November-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"490001ARBJPHKNDKLHCCHVGVKJCBMGRPK","firstInstanceDateTime":"2026-11-12T18:30:00","firstInstanceDateTimeUtc":"2026-11-12T18:30:00Z","lastInstanceDateTime":"2026-11-12T18:30:00","lastInstanceDateTimeUtc":"2026-11-12T18:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6843","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Make it clear in the copy that it is £6 per jumper \r\n\r\nMake yourself a Christmas jumper that nobody else has! This drop-in session is for families who want to give theirs a bit more personality — whether you're rescuing an old favourite, transforming a plain knit, or just adding something extra to make it properly yours.\r\n\r\nArrive any time between 1.30pm - 3pm and bring along a jumper (or a hat or a scarf)— a plain one you'd like to decorate, or an old Christmas one you want to refresh — and we'll supply the rest: sewing trimmings, decorations, and everything you need to get creative. There's no set project and no right or wrong way to do it but we will have lots of ideas for you. You just turn up, settle in, and make something you'll have lots of fun wearing.\r\n\r\nWe'll also have a jumper swap rail running throughout the session. If you've got a Christmas jumper at home that's ready for a new owner, bring it along, hang it on the rail, and help yourself to something different. One person's unwanted reindeer is another person's treasure.\r\n\r\nSuitable for all ages — children and adults are very welcome, and little ones will need a grown-up with them.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Christmas Jumper Surgery","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"493801AJMGJBVQDLNMHLKCTRKMNMRVPTL","firstInstanceDateTime":"2026-11-07T13:30:00","firstInstanceDateTimeUtc":"2026-11-07T13:30:00Z","lastInstanceDateTime":"2026-11-07T13:30:00","lastInstanceDateTimeUtc":"2026-11-07T13:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6916","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Get into the festive spirit with a\r\nburst of creativity this Christmas!\r\n\r\nJoin printmaker Alex Williams for a fun and engaging 2.5-hour workshop where\r\nyou’ll learn the basics of relief printing and create a bright, cheerful\r\nChristmas garland to take home.\r\nIn this beginner-friendly session, Alex will guide you through designing and creating your own relief printing plates from craft foam, then show you how to print your designs\r\nin classic festive colours. You’ll turn your prints into a beautiful handmade\r\ngarland ready to hang up at home or for\r\ngifting to someone special this holiday season. You’ll be able to take\r\nyour relief plates and your knowledge home with you to print more garlands,\r\ncards or gift tags. Come along, try something new,\r\nand enjoy a relaxed creative morning or afternoon; whether you come with\r\nfriends, bring a loved one, or treat yourself to a little festive making time! \r\n\r\n\r\n\r\nAbout your workshop leader:\r\nAlex studied Fine Art and Illustration at university and has a PGCE in secondary Art and Design. She is an experienced teacher and workshop leader and combines this with her practice as a freelance artist and illustrator, working with both print and paint.\r\n\r\n\r\nAlex loves colour and pattern and is inspired by richly decorated, historical ceramics, architecture and bright florals and often uses still life compositions in her work. Alex’s printmaking and drawing styles often consist of flat layers of bold colour which lends itself to using the ‘jigsaw’ method to create prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"LEARN: Festive Garland Making","instanceDates":"11 December-11 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"448601AVTMMBJGRRMQBDGNDCTQMRJPRRQ","firstInstanceDateTime":"2026-12-11T10:30:00","firstInstanceDateTimeUtc":"2026-12-11T10:30:00Z","lastInstanceDateTime":"2026-12-11T14:00:00","lastInstanceDateTimeUtc":"2026-12-11T14:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6359","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Find Your Balance - Therapist Led Yoga For 50+\r\n\r\nThis gentle, therapist-led yoga class is designed especially for adults 50 and over who want to move with more ease, strength, and confidence. Combining the mindfulness of yoga with functional movements that support everyday independence and mobility, each session helps improve balance, flexibility, and body awareness in a safe, supportive environment.\r\n\r\nBefore your first session the workshop leader Jade will ask you to complete a health questionnaire and waiver to help her to best prepare the course for you.  Taunton Brewhouse, as organiser and host, will hold a copy of this information for the duration of the course.\r\n\r\nAbout your workshop leader:\r\n\r\nJade is an experienced Occupational Therapist and founder of Wild Warrior Yoga UK. Having practiced Yoga for over a decade, she spent many years sharing her passion with friends, family, and colleagues before formalising her practice through teacher training. With extensive experience supporting older adults in acute care, Jade brings a compassionate, holistic approach to wellbeing that blends evidence-based practice with mindful, soulful teaching. A mum of three, Jade’s continued training in areas such as Chair Yoga and Postnatal Yoga reflects her commitment to making yoga accessible to all. Through her classes, she offers a grounded and nurturing space that encourages presence, self-compassion, and the quiet courage to keep showing up - both on and off the mat.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"LEARN: Find Your Balance - Therapist Led Yoga For 50+","instanceDates":"29 January-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"448001AQNLSCKPVVRJQCQVSRVDJBHVTPH","firstInstanceDateTime":"2026-01-29T10:15:00","firstInstanceDateTimeUtc":"2026-01-29T10:15:00Z","lastInstanceDateTime":"2026-10-29T12:15:00","lastInstanceDateTimeUtc":"2026-10-29T12:15:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"50+","attribute_BlockBookings":false,"attribute_EMSEventID":"6537","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Create your own beautiful lampshade from hand-carved stamps \r\n\r\n\r\n\r\nJoin printmaker Alex Williams for a brilliant multi-skill workshop where you’ll design, carve, print, and assemble your very own unique lampshade.\r\n\r\nAlex will guide you step-by-step through carving your own set of stamps, then show you how to plan and handprint your designs onto pre-cut strips of natural cotton fabric. You’ll have plenty of time to practise your patterns before printing your final piece.\r\n\r\nOnce your fabric is ready, you’ll turn it into a stunning lampshade, ready to brighten up your home with your one-of-a-kind design. The finished lampshade is a 20cm diameter drum shade. This friendly, hands-on session is perfect for anyone who loves to make, create, and take home something truly special.\r\n\r\nPlease feel free to bring along a packed lunch to enjoy in your lunch break, tea and coffee will be available in the workshop room.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"LEARN: Handprinted Lampshade","instanceDates":"25 April-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"445201AHSJLGMKBLVDKBVQSJQDPBDDVRS","firstInstanceDateTime":"2026-04-25T10:30:00","firstInstanceDateTimeUtc":"2026-04-25T09:30:00Z","lastInstanceDateTime":"2026-10-17T10:30:00","lastInstanceDateTimeUtc":"2026-10-17T09:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6538","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Gather with fellow parents for an inspiring affirmation workshop, led by Jess, an experienced art teacher who wholeheartedly believes in the powerful benefits affirmations can bring to your wellbeing. The session will open with guided mindfulness exercises and an engaging exploration of the science behind how affirmations—both written and visual—can positively influence our lives. Together, we’ll delve into practical ways to use affirmations during challenging moments in parenting, sharing insights and supporting each other.\r\n\r\nParticipants will then create their own set of affirmations, translating these uplifting words into vibrant watercolour artworks. These pieces will serve as meaningful reminders of your achievements and strengths as a parent, perfect for displaying at home. No prior painting experience is necessary; you’ll receive step-by-step guidance throughout, and all materials will be provided. This workshop offers a relaxed, supportive environment where creativity and self-care go hand in hand.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Painted affirmations: A mindful workshop for parents","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"496001AQVCTQBDBRGSVKLRKKLCHRLRHPJ","firstInstanceDateTime":"2026-11-07T14:30:00","firstInstanceDateTimeUtc":"2026-11-07T14:30:00Z","lastInstanceDateTime":"2026-11-07T14:30:00","lastInstanceDateTimeUtc":"2026-11-07T14:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6917","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"A weekly art group for those who are returning to art after a break.  A chance to try out a variety of materials in a fun informal and sociable group. Returning to Art is a refresher course for rekindling that love of Art from school but perhaps haven’t had a chance to continue, this is an opportunity to reignite the spark for the creative subject.  You can book the whole term or come to a session as a one off.\r\n\r\n\r\n\r\nIf you are looking for a course in a specific art technique please look at Lynne's Monday afternoon short courses which offer a smaller group size and detailed teaching in individual art forms.  If you are returning to art, perhaps start by coming to the morning session and then progressing to an afternoon course once you feel confident.\r\n\r\n\r\n\r\nThe term will be taking an extended break due to rehearsals for The Nutcracker between late October to early December. Please refer to the schedule listed for term dates.\r\n\r\n\r\n\r\n(see the PDF in uploads for details of what's planned for each week, please just list the morning session titles not the afternoon)\r\n\r\n\r\n\r\nABOUT THE WORKSHOP LEADER:\r\n\r\nThe course is led by Lynne Mackay, an artist and secondary school art teacher for over 20 years. As a farmer’s daughter growing up on the Somerset Levels, she has always had a huge passion for natural beauty. Lynne is inspired by the surrounding landscapes, flora and fauna of the Somerset Levels and Cornish seascapes.\r\n\r\n\r\nLynne loves to capture treasured memories in pencil, acrylic and watercolour painting, reduction lino printing, hand embroidered felt appliqué and machine embroidery.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"LEARN: Returning to Art ","instanceDates":"26 January-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"415201ARDVHQCQMMLPQMSTCRLCDPPQQRC","firstInstanceDateTime":"2026-01-26T10:15:00","firstInstanceDateTimeUtc":"2026-01-26T10:15:00Z","lastInstanceDateTime":"2026-10-19T10:15:00","lastInstanceDateTimeUtc":"2026-10-19T09:15:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6079","attribute_FacilitatedBookings":false,"attribute_Genre":"Visual Arts","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Breaking It Down A talk by Chloë Haywood, Chloë Haywood London & REWARDROBE\r\n\r\nThere's a thread that runs through everything Chloë Haywood does — and it's been there from the beginning.\r\n\r\nIn this honest and personal talk, Chloë traces her creative journey from a childhood rooted in making and repurposing, through launching Hatastic! — her award-winning sustainable hat brand which showed at London and Milan Fashion Weeks — to rebranding as Chloë Haywood London and founding REWARDROBE, a costume and textile recirculation business listed on the BAFTA Albert Suppliers Directory, serving the film, TV and theatre industries.\r\n\r\nLong before sustainability became a buzzword, Chloë was already working that way. This talk is about what happens when you stay true to your values, follow the thread, and build something that genuinely means something.\r\n\r\n.............\r\n\r\nlink to scraps to patches workshop with chloe in the afternoon","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Breaking it Down","instanceDates":"5 November-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"493401AVKCNTQJRKSGBBBLGHVDHSHVNRP","firstInstanceDateTime":"2026-11-05T11:00:00","firstInstanceDateTimeUtc":"2026-11-05T11:00:00Z","lastInstanceDateTime":"2026-11-05T11:00:00","lastInstanceDateTimeUtc":"2026-11-05T11:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6884","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"part of Rewoven — a season of textile repair and reuse\r\n\r\nWe all have something — a favourite jumper with a worn elbow, a shirt that's been at the back of the wardrobe. This workshop is the place to bring that thing back.\r\n\r\nGuided by textile artist Beth Philpot, whose intricate work is rooted in the rich textures of the Devon landscape, you'll use hand embroidery to repair, embellish and breathe new life into a piece of clothing you already love. Whether you're covering a hole, reinforcing a seam or simply adding something beautiful to a plain old favourite, Beth will guide you through the techniques and help you find an approach that suits your piece.\r\n\r\nNo embroidery experience needed — just bring the garment and a willingness to look at it differently.\r\n\r\nWhat to bring: one or two items of clothing you'd like to mend or embellish - a jumper, jeans, shirt, top or T-shirt would be ideal. All embroidery materials provided. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Loved and Mended","instanceDates":"4 November-4 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"493001ATJHKMSMNTDJGGRGCKMRJMGLMQD","firstInstanceDateTime":"2026-11-04T10:30:00","firstInstanceDateTimeUtc":"2026-11-04T10:30:00Z","lastInstanceDateTime":"2026-11-04T10:30:00","lastInstanceDateTimeUtc":"2026-11-04T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6880","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"part of Rewoven — a season of textile repair and reuse\r\n\r\nThere's something quietly astonishing about laying a dried flower or a handful of leaves onto silk, rolling it tight, steaming it, and waiting. You can't quite predict what you'll get. That's rather the point.\r\n\r\nIn this workshop, Pam Martin of Somerset Stitch — who has spent years exploring the rich, unpredictable world of natural dyeing — will guide you through the art of eco printing on silk. Using dried natural materials, you'll learn how to prepare your fabric, arrange your chosen botanicals, and use steam to transfer their colour and form onto the cloth. The results are one of a kind, shaped as much by the materials as by you.\r\n\r\nIt's a slow, meditative process, and all the more satisfying for it. You'll leave with a piece of printed silk and a new appreciation for what nature can do when you give it a little heat and time.\r\n\r\nAll materials provided. No experience necessary.","htmlDescription":"<div id>\r\n\r\n</div>","duration":240,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Printed by Nature","instanceDates":"27 October-27 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"492801ARCJMTPBBSLMMJQJGPNLJGKNLMJ","firstInstanceDateTime":"2026-10-27T10:30:00","firstInstanceDateTimeUtc":"2026-10-27T10:30:00Z","lastInstanceDateTime":"2026-10-27T10:30:00","lastInstanceDateTimeUtc":"2026-10-27T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6879","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Scraps to Patches A workshop by Chloë Haywood, Chloë Haywood London & REWARDROBE\r\n\r\nEver wondered what happens to the fabrics left behind on a film set or theatre production? In this hands-on two hour workshop, Chloë Haywood guides you through the art of turning offcuts — sourced from real film, TV and theatre productions — into a unique, one-of-a-kind patch that is entirely your own.\r\n\r\nNo sewing experience necessary. Just bring your creativity and leave with something you've made with your own hands from materials that might otherwise have been thrown away.\r\n\r\nA perfect companion to the morning's Breaking It Down talk — this is where the theory becomes practice, and the scraps become something beautiful.\r\n\r\nAll materials and equipment is provided. Every patch is unique — just like the fabric it came from.","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Scraps to Patches","instanceDates":"5 November-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"493601AMLKBDVGSMCMTQDNKCCBMGQRCBR","firstInstanceDateTime":"2026-11-05T13:30:00","firstInstanceDateTimeUtc":"2026-11-05T13:30:00Z","lastInstanceDateTime":"2026-11-05T13:30:00","lastInstanceDateTimeUtc":"2026-11-05T13:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6885","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Join textile artist Rachel Watkins in our bright riverside room to make a colourful wall hanging for your home.  Learn the exciting creative technique of weaving loose fibres on a frame loom in your own design.  Rachel will guide you through the whole process from choosing colours to stringing the loom and finishing techniques.\r\n\r\nAll materials required to complete your wall hanging will be provided including a frame loom, weaving tools, an oak dowel and a wide selection of luxurious natural yarns and recycled fibres to choose from on the day.\r\n\r\nYour finished wall art will measure approximately 20cm wide x 40 cm long . Please feel free to bring along a packed lunch or plan to visit one of our nearby cafes for lunch, tea and coffee will be supplied.\r\n\r\n\r\n\r\nAbout your workshop leader Rachel Watkins\r\n\r\n\r\n\r\n\r\n\r\n\r\nRachel’s life long passion for making things with wool, led her to discover the art of small frame loom weaving a decade or so ago, igniting a love for tactile and colourful fibre creations. She draws inspiration from the beauty of the world around her, transforming these elements into inviting artwork for the home. \r\n\r\n\r\n\r\n\r\nAs the workshop leader, Rachel brings a wealth of experience as a learning and development specialist, and will utilise her group facilitation skills to create a welcoming, fun and friendly atmosphere for all participants. She invites you to come and tap into your inner creativity, learn new skills and revel in the joy of crafting with luxurious natural fibres\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Textile Wall Hanging","instanceDates":"13 November-13 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"494601AJQDHJMSGCPCGQNKPBDQPRJLDLM","firstInstanceDateTime":"2026-11-13T10:30:00","firstInstanceDateTimeUtc":"2026-11-13T10:30:00Z","lastInstanceDateTime":"2026-11-13T10:30:00","lastInstanceDateTimeUtc":"2026-11-13T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6069","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"There's a particular kind of quiet that comes with slow stitching. No rushing, no right answer — just fabric, thread, and time to let something take shape in your hands.\r\n\r\nIn this full-day workshop, textile tutor Claire Nichol introduces you to the art of the slow scroll: a stitched, layered piece made from recycled and reclaimed materials. Every piece of fabric has a history, and that's exactly the point. Claire's whole practice is rooted in reusing and reworking — nothing wasted, everything considered.\r\n\r\nYou're welcome to bring along a men's shirt or other fabric you'd like to give a second life. Otherwise, Claire will have materials ready to work with. Using patchwork, hand stitching and slow stitch techniques, you'll build up your scroll over the course of the day, leaving with a finished piece to hang on your wall and keep.\r\n\r\nNo experience needed — this is a workshop for anyone who wants to slow down and make something with intention.\r\n\r\nAll materials provided. Bring a shirt if you have one you'd like to use.","htmlDescription":"<div id>\r\n\r\n</div>","duration":330,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: The Slow Scroll","instanceDates":"11 November-11 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"494201ABNBBLGLMTLJCHCVPMNPDQDHQHR","firstInstanceDateTime":"2026-11-11T10:30:00","firstInstanceDateTimeUtc":"2026-11-11T10:30:00Z","lastInstanceDateTime":"2026-11-11T10:30:00","lastInstanceDateTimeUtc":"2026-11-11T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6882","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Fabric can make or break the success a garment, this masterclass is all about helping you\r\nchoose, understand, and work with fabric more confidently. Join Ali for this hands on\r\npresentation, designed for dressmakers, covering how different fabrics behave, their suitability for\r\ngarments, and how to get the best results for a variety of projects. Ideal for beginner sewers or\r\nanyone who would like to develop their knowledge of fabrics.\r\nWe’ll explore natural, synthetic, and blended fabrics, learning how to identify them, assess drape,\r\nweight, stretch, and structure, and match them to the right garment styles. You’ll discover how the\r\nright fabric choices can transform your finished pieces. You’ll also learn practical tips for and\r\nadvice on what to look out for when buying fabric in person or online and have the opportunity to\r\nplay and sew with some samples.\r\nExpect real garments from Ali’s handmade wardrobe, touch and feel comparisons and expert\r\nguidance that you can immediately apply to your own sewing projects. There will be plenty of\r\ntime for discussion, feel free to bring patterns that you may need help choosing fabric for. You\r\ndon’t need to bring anything for this workshop, however a notebook is handy to have to keep your\r\nown personal notes. There will be more info available on Ali’s upcoming workshops and an\r\nopportunity to book on the day.\r\nTea and coffee will be available\r\n\r\n\r\n\r\nAbout your workshop leader: \r\n\r\nAli is a designer and multidisciplinary maker with a love of colour, pattern and print, who is happiest when she’s creating. She’s passionate about sharing her enthusiasm for sewing, dressmaking and textile design whether through inspiring conversations, relaxed and friendly workshops, or connecting with others over beautiful fabrics.\r\n\r\nAli has supported creatives in a wide range of settings, nurturing confidence and encouraging personal growth through hands-on making, curiosity and thoughtful guidance. She studied Textile Design at Loughborough College of Art and has worked across printed textile design, interior design, visual merchandising and education.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Understanding Fabrics","instanceDates":"30 April-4 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"466801ASCBRTMRPDVBRTSHGQDQLRVHTTQ","firstInstanceDateTime":"2026-04-30T10:30:00","firstInstanceDateTimeUtc":"2026-04-30T09:30:00Z","lastInstanceDateTime":"2026-11-04T19:15:00","lastInstanceDateTimeUtc":"2026-11-04T19:15:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6652","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"This special creative workshop begins with an inspiring illustrated talk by Maggie Hague and Trisha McGarry, exploring the fascinating history of costume jewellery and her unique role in supporting the hospital charity Love Musgrove. Maggie receives donated jewellery which she sells on behalf of others to raise vital funds, and through this work she uncovers some truly bizarre, surprising, and wonderful stories. Her talk offers a behind-the-scenes look at the hidden world of costume jewellery, including unexpected discoveries, unusual pieces, and her experiences working with auction houses.\r\n\r\nFollowing the talk, participants will take part in a 2.5-hour hands-on workshop led by artist Trisha McGarry, transforming costume jewellery into a one-of-a-kind art piece. You are welcome to bring your own jewellery to work with, but this is not essential, Trisha will provide a wide selection of materials. With clear, step-by-step guidance throughout, you’ll be supported from initial ideas through to completion, making the process accessible to all skill levels.\r\n\r\nThe session concludes with a beautiful, finished artwork for you to take home; an object that carries both personal meaning and creative expression, inspired by the stories and materials of costume jewellery.\r\n\r\nAfter her talk Maggie would welcome receiving donations of unwanted/broken jewellery and watches towards her charitable work for Love Musgrove.\r\n\r\nPlease bring along a packed lunch to enjoy between the talk and workshop which starts at 12:45.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Unlikely Jewels: History, Charity and Creative ReUse","instanceDates":"18 November-18 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"497201AQHNLCMSRTTGVBLGTQKDVNTHGGL","firstInstanceDateTime":"2026-11-18T10:45:00","firstInstanceDateTimeUtc":"2026-11-18T10:45:00Z","lastInstanceDateTime":"2026-11-18T10:45:00","lastInstanceDateTimeUtc":"2026-11-18T10:45:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6608","attribute_FacilitatedBookings":false,"attribute_Genre":"Talk/Lecture","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"You know that pile of shirts at the back of someone's wardrobe? The ones that are perfectly good but nobody's wearing? This workshop is for those.\r\n\r\nAli will guide you through the possibilities — what a shirt can become when you stop thinking of it as a shirt. We'll have a selection of men's shirts ready to work with, or bring one of your own if it's been quietly judging you from a hanger or the fabric to use pile.\r\n\r\nThis is an exploratory session rather than a follow-the-pattern one. You'll experiment, make decisions, and leave with something genuinely transformed — and a much better idea of what you can do with fabric you already own.\r\n\r\nWith a maximum of eight of us in the room, there's plenty of time to think through your ideas with Ali and actually make them happen.\r\n\r\nNo experience necessary. Curiosity required. This is a whole day workshop so please bring along a packed lunch, tea and coffee are supplied\r\n\r\n\r\n\r\nAbout your workshop leader: \r\n\r\nAli is a designer and multidisciplinary maker with a love of colour, pattern and print, who is happiest when she’s creating. She’s passionate about sharing her enthusiasm for sewing, dressmaking and textile design whether through inspiring conversations, relaxed and friendly workshops, or connecting with others over beautiful fabrics.\r\n\r\nAli has supported creatives in a wide range of settings, nurturing confidence and encouraging personal growth through hands-on making, curiosity and thoughtful guidance. She studied Textile Design at Loughborough College of Art and has worked across printed textile design, interior design, visual merchandising and education.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"LEARN: Rewoven: Upcycle a Shirt","instanceDates":"12 November-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"494401AQSKJGMPRCBHRSKBLNVHHGRBDCS","firstInstanceDateTime":"2026-11-12T10:15:00","firstInstanceDateTimeUtc":"2026-11-12T10:15:00Z","lastInstanceDateTime":"2026-11-12T10:15:00","lastInstanceDateTimeUtc":"2026-11-12T10:15:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6883","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Storytime with the Sugar Plum Fairy & Father Christmas \r\nA sweet festive experience for little ones aged under 4 and their grown-ups \r\n\r\nJoin the friendly Sugar Plum Fairy for a gentle, joy-filled storytime designed especially for toddlers and preschoolers. With soft lighting, festive tales, and a sprinkle of fairy magic, this is the perfect way to introduce your little one to the wonder of Christmas.  Storytime is informal and interactive, everyone is welcome, perfect for joining in if you feel like it or quietly watching if that's your mood.\r\n\r\nAs the story draws to a close, a very special guest arrives… Father Christmas himself! There’ll be time for photos and each child will receive a small festive gift to take home.\r\n\r\nThis calm and cosy session is designed with younger children in mind—short, sweet, and packed with Christmas cheer.\r\n\r\n🎁 Perfect for under 4s\r\n\r\n📸 Includes time for photos with Father Christmas\r\n\r\n🎅 Each child receives a small gift\r\n\r\n🎀 A magical memory for you and your little one\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nSpaces are limited to keep things relaxed —book early to avoid disappointment!","htmlDescription":"<div id>\r\n\r\n</div>","duration":30,"imageUrl":"","isOnSale":true,"name":"LEARN: Storytime with the Sugar Plum Fairy and Father Christmas","instanceDates":"17 December-18 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"502201AKMBVJQLCLHLQCQCGJKVMQDNKDD","firstInstanceDateTime":"2026-12-17T10:15:00","firstInstanceDateTimeUtc":"2026-12-17T10:15:00Z","lastInstanceDateTime":"2026-12-18T11:45:00","lastInstanceDateTimeUtc":"2026-12-18T11:45:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"1-5 years","attribute_BlockBookings":false,"attribute_FacilitatedBookings":false,"attribute_FixedSeriesWebID":"6256","attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeries":"","attribute_EMSEventID":"","attribute_TriggerWarning":""},{"description":"The Christmas Quest: A Magical Adventure with Father Christmas and Mowenna Mapwize For children aged 5+ and their grown-ups\r\n\r\nStep into a mysterious seafaring adventure. This year, meeting Father Christmas is unlike anything you've experienced before.\r\n\r\nThe secret of Christmas has vanished from the map.\r\n\r\nWith Christmas Eve fast approaching, Father Christmas has called on an unlikely ally — Mowenna Mapwize, cartographer extraordinaire, who has been charting the world's hidden places since 1750 and knows a thing or two about finding what's lost. Together, they need a team of clever, curious children to help them track it down.\r\n\r\nYour quest takes place inside Mowenna's extraordinary study — a room unstuck in time, where old sea charts cover the walls, lanterns cast a golden glow across dark wood and curiosities, and somewhere among the telescopes, globes and mysterious bottles, the clues are waiting to be found.\r\n\r\nThis is not a sit-and-wait grotto. It's a story come to life, where children become the heroes of their own Christmas adventure. Working together, they'll solve puzzles, crack clues and piece together the mystery — with plenty of giggling and exploring along the way.\r\n\r\nAnd yes, there will be time for photos and a small festive gift from Father Christmas at the end.\r\n\r\n\r\n\r\nGood to know: Each quest has space for up to 8 children, so you'll share the adventure with one or two other families. If you'd prefer the experience to be exclusive to your group, you're welcome to book all 8 places.\r\n\r\nEvery child must be accompanied by a participating grown-up. Suitable for ages 5+.\r\n\r\n\r\n\r\nIs it suitable for my teenager?\r\n\r\nThe Quest challenges are best suited to primary school children, a teenager will probably find it a bit easy.  Older children (11+) and young people are very welcome to book onto the Quest especially if they are coming to support a younger sibling.  It will be a fun activity to do together.\r\n\r\n\r\n\r\nCan I bring my baby?\r\n\r\nYes, babes in arms are welcome to come with you and don't need a ticket.  However they won't receive a gift from Father Christmas.  Gifts in this activity are best suited to children aged 5 - 11 years old.\r\n\r\n\r\n\r\nWhat gift will the children get?\r\n\r\nFather Christmas will give each child a small gift at the end of the Quest.  It will be something creative to do at home and the presents are not gendered.  It's best suited to children aged 5 - 11 years old.  Babies who attend with you without a ticket will not receive a gift.\r\n\r\n\r\n\r\nIs it a performance?\r\n\r\nThe actors playing Father Christmas and Mowenna Mapwize will be in character throughout your Quest.  They are following a flexible storyline which will respond to the children taking part.  They will set the scene, keep everything moving to time and make sure everyone completes the Quest for a happy ending!  You will all be taking part throughout and not sitting to watch a performance at any time.  It's more of a workshop than a performance and hence part of our LEARN programme.\r\n\r\n\r\n\r\nI'm a wheelchair user, will it be accessible?\r\n\r\nYes.  Please let us know if you are booking for a wheelchair user so that we can ensure you have the best experience.\r\n\r\n\r\n\r\nCan I bring my buggy in?\r\n\r\nIdeally not.  We would like the most space possible in the room to do the activities planned.  There is a safe space to leave your buggy in box office or just outside the gallery - Mowenna will show you where.\r\n\r\n\r\n\r\nWill we get to have a photo with Father Christmas?\r\n\r\nYes.  At the successful end to the Quest Father Christmas will invite each child to recieve a gift and photos can be taken with him then.  You are also welcome to take pictures of your own child throughout the event.\r\n\r\n\r\n\r\nCan we book the whole Quest for my child and their group of friends?\r\n\r\nYes.  If 8 places are available on the Quest timeslot you would like then you can book the whole session.\r\n\r\n\r\n\r\nWhat should we wear?\r\n\r\nWhatever you like!  But please be comfortable and able to move around, there's nothing messy involved.  Throw on your Christmas jumper!\r\n\r\n\r\n\r\nWhat happens if we are late arriving or we get there early?\r\n\r\nIt's not possible to join the Quest as a latecomer so please plan to arrive in plenty of time for your session, remember town centre car parks can be busy during the festive season.  There's space to wait in the Brewhouse foyer and bar area so you won't be stood outside.  Each Quest will start promptly at the time on your ticket so that there's plenty of time for all the planned activity and photos with Father Christmas at the end.","htmlDescription":"<div id>\r\n\r\n</div>","duration":45,"imageUrl":"","isOnSale":true,"name":"LEARN: The Christmas Quest","instanceDates":"4 December-23 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"502401AHPCJBCSCGNTBTMTQJBHKBPVJVT","firstInstanceDateTime":"2026-12-04T15:45:00","firstInstanceDateTimeUtc":"2026-12-04T15:45:00Z","lastInstanceDateTime":"2026-12-23T16:30:00","lastInstanceDateTimeUtc":"2026-12-23T16:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"Age 5+ and their grown up","attribute_BlockBookings":false,"attribute_EMSEventID":"6865","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"If you always find yourself shouting at the TV watching Death in Paradise then this is for you! The Friday Murder Club is an interactive, escape-room-in-a-box style murder mystery evening where participants become detectives for the night. Each event centres around a bespoke cold case crime dossier created by local author Jo Middleton, packed with clues, evidence files, character profiles, maps and timelines. Guests work in small groups to crack the case before time runs out, with expert help on hand whenever they get stuck.\r\n\r\nGrab a partner or a group of friends and secure your spot now! Teams of up to 6 people - it’s friendly, social and perfect for anyone who enjoys puzzles, storytelling or crime fiction.  Teams of up to 6 people and the bar will be open from 6.30pm to buy drinks before the game starts at 7pm.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: The Friday Murder Club","instanceDates":"22 May-11 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"459601ARVCBBNPDKVPRKJPLMSSNRCTLGT","firstInstanceDateTime":"2026-05-22T19:00:00","firstInstanceDateTimeUtc":"2026-05-22T18:00:00Z","lastInstanceDateTime":"2026-12-11T19:00:00","lastInstanceDateTimeUtc":"2026-12-11T19:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6610","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Theatre Academy – Group 1 is designed for those aged 5yrs to 9yrs and is perfect for those looking for a fun-filled activity, with lots of games, the opportunity to make friends and to have an introduction to the world of theatre.\r\n\r\nBenefits of being a Theatre Academy Member include:\r\n\r\nExclusive discounts and offers on some of our productions and theatre-related workshops\r\nPerformance opportunities including the End of Year Sharing to friends and family in our Studio Theatre\r\nRegular newsletters via email updating you on what is coming up in our Youth Theatre Programme\r\nInterested in a taster session? Please register your interest here and a member of the team will be in touch soon. For further information, please email programme@tauntonbrewhouse.co.uk.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"LEARN: Theatre Academy - Group 1","instanceDates":"13 January-15 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"395001AGNQLSTKTCJKGHPGCSCSKPVKGRN","firstInstanceDateTime":"2026-01-13T17:00:00","firstInstanceDateTimeUtc":"2026-01-13T17:00:00Z","lastInstanceDateTime":"2026-12-15T17:00:00","lastInstanceDateTimeUtc":"2026-12-15T17:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"5-9","attribute_BlockBookings":false,"attribute_EMSEventID":"5691","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Theatre Academy – Group 2 is tailored for those aged 9-11 years and is a group designed to explore imagination and learn core performance skills. For Summer 2025, Group 2 will be taking place on Wednesdays, 17:00 to 18:15 - please see term dates listed below.\r\n\r\nEach session will include lots of fun and be the perfect opportunity to build confidence. Benefits of being a Theatre Academy Member include:\r\n\r\nTicket offers to some of our most exciting visiting productions\r\nExclusive discounts on theatre-related workshops delivered as part of our Youth Theatre Programme\r\nPerformance opportunities including the chance to audition for our Christmas show\r\nInterested in a taster session? Please register your interest here and a member of the team will be in touch soon. For further information, please email programme@tauntonbrewhouse.co.uk.","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"LEARN: Theatre Academy - Group 2","instanceDates":"14 January-16 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"395201AKKTKRJVNNRQBNKJMNRBKDJKMMT","firstInstanceDateTime":"2026-01-14T17:00:00","firstInstanceDateTimeUtc":"2026-01-14T17:00:00Z","lastInstanceDateTime":"2026-12-16T17:00:00","lastInstanceDateTimeUtc":"2026-12-16T17:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"9-11","attribute_BlockBookings":false,"attribute_EMSEventID":"6085","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Theatre Academy – Group 3 is designed for those aged 11-13 years and offers the perfect opportunity for those wanting to build their confidence in performing while also boosting their social skills.\r\n\r\nRecent sessions for this group have focused on musical theatre, comedy, and creative adaptation. Benefits of being a Theatre Academy Member include:\r\n\r\nTicket offers to some of our most exciting visiting productions\r\nExclusive discounts on theatre-related workshops as part of our Youth Theatre Programme\r\nPerformance opportunities including the chance to audition for our Christmas show\r\nInterested in a taster session? Please register your interest here and a member of the team will be in touch soon. For further information, please email programme@tauntonbrewhouse.co.uk.","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"LEARN: Theatre Academy - Group 3","instanceDates":"13 January-15 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"395401APQRHMGVDNMRCJNBDJGTJNCVGRR","firstInstanceDateTime":"2026-01-13T18:10:00","firstInstanceDateTimeUtc":"2026-01-13T18:10:00Z","lastInstanceDateTime":"2026-12-15T18:10:00","lastInstanceDateTimeUtc":"2026-12-15T18:10:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"11-13","attribute_BlockBookings":false,"attribute_EMSEventID":"6086","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Theatre Academy – Group 5 offers young people aged 15-19 years who are serious about performance the chance to advance their skills. From Summer 2025, this group will be taking place on Thursdays, 19:30 to 21:30.\r\n\r\nTheatre Academy - Group 5 is perfect for those thinking about the next steps of their further or higher education as members will have access to advice about progressing their career in the arts industry.\r\n\r\nOther benefits of being a Theatre Academy member include:\r\n\r\nTicket offers to some of our most exciting visiting productions\r\nExclusive discounts on theatre-related workshops as part of the Youth Theatre Programme\r\nPerformance opportunities including the chance to audition for our Christmas show\r\nInterested in a taster session? Please register your interest here and a member of the team will be in touch soon. For further information, please email programme@tauntonbrewhouse.co.uk.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"LEARN: Theatre Academy - Group 5 ","instanceDates":"15 January-17 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"395801ACNKRNGKHCRRMDQKMQHBHQJSHGB","firstInstanceDateTime":"2026-01-15T19:30:00","firstInstanceDateTimeUtc":"2026-01-15T19:30:00Z","lastInstanceDateTime":"2026-12-17T19:30:00","lastInstanceDateTimeUtc":"2026-12-17T19:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"15-19","attribute_BlockBookings":false,"attribute_EMSEventID":"6071","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Creative dance and play for under 5s and their adults. A chance for families to have fun together with creative input and resources such as scarves, feathers and hoops. Each session includes child-friendly warm-ups, action songs, improvisation, free play and various themes. Tiny Dancers is led by Lucy Hartland-Mann, a dance graduate from Liverpool Institute for Performing Arts. Lucy specialises in community dance, movement and circus. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":45,"imageUrl":"","isOnSale":true,"name":"LEARN: Tiny Dancers","instanceDates":"20 January-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"358001AKNGVBQKBJPRRLGMKHJDDQTGPCT","firstInstanceDateTime":"2026-01-20T10:15:00","firstInstanceDateTimeUtc":"2026-01-20T10:15:00Z","lastInstanceDateTime":"2026-10-20T10:15:00","lastInstanceDateTimeUtc":"2026-10-20T09:15:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_BlockBookings":false,"attribute_EMSEventID":"5547","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Activities","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":375,"imageUrl":"","isOnSale":true,"name":"LEARN: Willow Reindeer","instanceDates":"6 November-6 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"420401APTSMDQSMGDRPPCHBMCCNNDJHJH","firstInstanceDateTime":"2026-11-06T10:30:00","firstInstanceDateTimeUtc":"2026-11-06T10:30:00Z","lastInstanceDateTime":"2026-11-06T10:30:00","lastInstanceDateTimeUtc":"2026-11-06T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6292","attribute_FacilitatedBookings":false,"attribute_Genre":"Visual Arts","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Have you been wanting your child to learn a musical instrument but found it hard to\r\n\r\naccess lessons, costly to purchase instruments, feel they might be too young to start an orchestral\r\n\r\ninstrument, and you really don’t want them to learn the recorder!? Well here is what you have been\r\n\r\nwaiting for! Learning on a Nuvo ’Toot’ is just like learning a 'real' instrument only lighter, easier to\r\n\r\nhold and control the sound, robust, and most importantly tuneful and fun! In term one your child\r\n\r\nwill make their first sound, learn to make music in a group, and read music for the first time. In\r\n\r\npartnership with the Taunton Music Trust (TMT) this new group starts weekly sessions at the Taunton\r\n\r\nBrewhouse from September for Key Stage 1 age students. For the equivalent of £1 a week, these sessions will include specialist\r\n\r\nteaching, use of a Nuvo ’Toot’ mini flute during the sessions and, should your child wish to have their own ’Toot’ to use at home, TMT will also subsidise the cost of that instrument purchase. Your child will follow the Windstars curriculum from 'Sound before Sight' up to playing ‘orchestral’ style\r\n\r\ninstruments that are still lightweight and easy to manipulate in an ensemble environment.","htmlDescription":"<div id>\r\n\r\n</div>","duration":30,"imageUrl":"","isOnSale":true,"name":"LEARN: Windstars 1 'Toot' Music Lessons","instanceDates":"22 January-17 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"357801ALSVKMRKBPRPJPPJKSDBQGPLCNB","firstInstanceDateTime":"2026-01-22T16:00:00","firstInstanceDateTimeUtc":"2026-01-22T16:00:00Z","lastInstanceDateTime":"2026-12-17T16:00:00","lastInstanceDateTimeUtc":"2026-12-17T16:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"5 - 7 (KS1 school age at September 2025)","attribute_BlockBookings":false,"attribute_EMSEventID":"5403","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Whether you’re curious about writing for stage or a newer playwright looking to build your craft join award-winning local playwright Bea Roberts in a fun and informal writing workshop exploring telling stories for stage. Through guided exercises and discussion you’ll discover how to create characters that leap off the page, structure your story for maximum drama and learn tips and tricks for writing sparky, distinctive dialogue. \r\n\r\n\r\n\r\nYou might have something you’re working on, the seed of an idea or just a passion to learn more about playwriting. By the end of the day you’ll leave with a host of new ideas and some top tips to create a hit script. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":210,"imageUrl":"","isOnSale":true,"name":"LEARN: Writing for the Stage","instanceDates":"14 November-14 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"495801ATBKPCHSMRTQMVHQTVMMKKCHRJT","firstInstanceDateTime":"2026-11-14T10:30:00","firstInstanceDateTimeUtc":"2026-11-14T10:30:00Z","lastInstanceDateTime":"2026-11-14T10:30:00","lastInstanceDateTimeUtc":"2026-11-14T10:30:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6908","attribute_FacilitatedBookings":false,"attribute_Genre":"Learn","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Beginners\r\nJoin Lucy Hartland-Mann and discover all that is Street Dance. Street Dance covers hip-hop, house, breaking, popping, locking, waacking, waving and tutting. Each term you will uncover the tools and techniques that are at the forefront of the commercial industry, combining these into fun-filled routines. These styles originated from social dances born on the streets and are heavily influenced by the music of the time. This is a class that promotes lots of fun and energy!\r\n\r\nAll abilities welcome. Siblings are welcome to join the same session if that is more suitable, contact to enquire. \r\nSuggested age is 6 - 10 years\r\nBooking is for the whole term only as the group will progress through the term together","htmlDescription":"<div id>\r\n\r\n</div>","duration":55,"imageUrl":"","isOnSale":true,"name":"LEARN: Youth Street Dance Group 1","instanceDates":"15 January-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"329601ALPDNNLTQQTKPHQRGRNSPLQGDNP","firstInstanceDateTime":"2026-01-15T17:00:00","firstInstanceDateTimeUtc":"2026-01-15T17:00:00Z","lastInstanceDateTime":"2026-10-22T17:00:00","lastInstanceDateTimeUtc":"2026-10-22T16:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"6-10","attribute_BlockBookings":false,"attribute_EMSEventID":"5406","attribute_FacilitatedBookings":false,"attribute_Genre":"Dance","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":55,"imageUrl":"","isOnSale":true,"name":"LEARN: Youth Street Dance Group 2","instanceDates":"15 January-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"329401AJTLNTKPVLRLDQNRNDJNSKGRNTJ","firstInstanceDateTime":"2026-01-15T18:00:00","firstInstanceDateTimeUtc":"2026-01-15T18:00:00Z","lastInstanceDateTime":"2026-10-22T18:00:00","lastInstanceDateTimeUtc":"2026-10-22T17:00:00Z","altText":"","attribute_AccountCode":"10-03 Learning & Participation","attribute_AgeGuidance":"10-16","attribute_BlockBookings":false,"attribute_EMSEventID":"5407","attribute_FacilitatedBookings":false,"attribute_Genre":"Dance","attribute_Type":"Activities","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Legends of Motown is a tribute show jam packed with all of Motown’s biggest hits, with stunning vocals and amazing live band, celebrating the music of the iconic and timeless Motown era.\r\n\r\nTake a trip down memory lane with the music authentic to the Motown label from artists such as Marvin Gaye, Stevie Wonder, The Supremes, Smokey Robinson, The Four Tops, Martha Reeves, The Temptations, Jimmy Ruffin and many more!","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"Legends of Motown 2026","instanceDates":"30 October-30 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"426801ADCBLCTNGVRNTCDNSRVLDLPNLKH","firstInstanceDateTime":"2026-10-30T19:30:00","firstInstanceDateTimeUtc":"2026-10-30T19:30:00Z","lastInstanceDateTime":"2026-10-30T19:30:00","lastInstanceDateTimeUtc":"2026-10-30T19:30:00Z","altText":"","attribute_AccountCode":"10-10 Ticketed Hires","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6348","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Let's Rock 70s is a show performing hits from the 1970s of Rock, Pop and classic songs.\r\n\r\nIt comprises of 6 band members and 2 technicians. \r\n\r\nLET's ROCK THE 70s is an exhilarating tribute show celebrating the iconic music and artists of the 1970s.Experience electrifying performances of classics from Queen, AC/DC, Elton John, Fleetwood Mac, and many more.\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Let's Rock the 70s (2027)","instanceDates":"14 May-14 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"475401AVBPMKKLJGQGMHHRJSKJHRSVTNG","firstInstanceDateTime":"2027-05-14T19:30:00","firstInstanceDateTimeUtc":"2027-05-14T18:30:00Z","lastInstanceDateTime":"2027-05-14T19:30:00","lastInstanceDateTimeUtc":"2027-05-14T18:30:00Z","altText":"","attribute_AccountCode":"10-10 Ticketed Hires","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6750","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Entering their third decade as a leading tribute act, Limehouse Lizzy continues to honour the legacy of Philip Lynott and Thin Lizzy with electrifying performances that dominate the live Classic Rock circuit. Recognised with a PRS/Billboard award as Britain’s Hardest Working Act, featuring in the BBC’s acclaimed ‘Arena’ series, and lead singer Wayne Ellis being a former member of original Thin Lizzy member Brian Robertson's The Clan, have contributed to the band remaining a force on and off the stage, earning widespread acclaim. \r\n\r\n \r\n\r\n2024/25 has been their most successful period yet, with 41 sold-out shows on their Anniversary Tour, whilst continuing with their legacy of international performances including the USA, UAE, the Caribbean, NL and Scandinavia. \r\n\r\n\r\n\r\nAs Limehouse Lizzy heads into 2027, their tribute to Thin Lizzy’s timeless hits continues to captivate audiences worldwide","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Limehouse Lizzy - The Greatest Hits of Phil Lynott and Thin Lizzy","instanceDates":"26 February-26 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"475201ATGJJDGPKHGCHSBMHQGCDTJTPBD","firstInstanceDateTime":"2027-02-26T20:00:00","firstInstanceDateTimeUtc":"2027-02-26T20:00:00Z","lastInstanceDateTime":"2027-02-26T20:00:00","lastInstanceDateTimeUtc":"2027-02-26T20:00:00Z","altText":"","attribute_AccountCode":"10-10 Ticketed Hires","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6784","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Country fans are given a taste of Nashville with Soul Street Productions’ sell-out show Made in Tennessee - A Night of Country Music.\r\n\r\nWith a band made up of some of UK’s finest country musicians, Made in Tennessee takes you through the decades of the nation's fastest growing music genre, from Country’s origin in the Southern States of America to modern day Country heard around the world.\r\n\r\nFeaturing classics from Johnny, June, Dolly and Hank, legends like Garth Brooks and Carrie Underwood and modern country superstars such as Kacey Musgraves and Chris Stapleton.\r\n\r\nBook your tickets now to experience the best show east of Tennessee! ","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Made In Tennessee 2026","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"455801ARGMKLGNKJTPSSNGQBQBPCBJMDK","firstInstanceDateTime":"2026-10-31T19:30:00","firstInstanceDateTimeUtc":"2026-10-31T19:30:00Z","lastInstanceDateTime":"2026-10-31T19:30:00","lastInstanceDateTimeUtc":"2026-10-31T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6504","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"end time 22:00","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Mercury – The Ultimate Queen Tribute","instanceDates":"6 November-6 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"435602AKTPTVHNDCGKSCTMLHCTVPCSCCG","firstInstanceDateTime":"2026-11-06T19:30:00","firstInstanceDateTimeUtc":"2026-11-06T19:30:00Z","lastInstanceDateTime":"2026-11-06T19:30:00","lastInstanceDateTimeUtc":"2026-11-06T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"7+","attribute_BlockBookings":false,"attribute_EMSEventID":"6163","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Should you know about your dad’s seduction techniques?\r\n\r\n\r\n\r\n\r\nIn 2025 Milo Edwards found a box of old letters in the back of his late Mother’s wardrobe. Catamaran is a show about his parents and the letters they wrote and the 1980s, in which Milo asks what remains of a human life, what’s torn out, what happens if that life was surprisingly horny…and whatever happened to Jim Lock’s catamaran?\r\n\r\n\r\n\r\n\r\n‘A formidable stand up force’ (British Comedy Guide), ‘One of the UK’s smartest, most vital stand-ups’ (Chortle), 'Near perfect.' ★★★★★ (Wee Review), 'Must surely go onwards and upwards.’ ★★★★ (Telegraph)","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Milo Edwards: Catamaran","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"477401ABNRRPMMRBKJMMDTKBRHRJPLMLQ","firstInstanceDateTime":"2026-11-07T20:00:00","firstInstanceDateTimeUtc":"2026-11-07T20:00:00Z","lastInstanceDateTime":"2026-11-07T20:00:00","lastInstanceDateTimeUtc":"2026-11-07T20:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"18+","attribute_BlockBookings":false,"attribute_EMSEventID":"6718","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The extended set headliner of this very special night of stand up is none other than absurdist one liner, Mock The Week and Live At The Apollo superstar, Milton Jones! Milton is one of the nation’s favourite comedians; his live shows are a mainstay of UK comedy with his tours Lion Whisperer, On the Road, Temple of Daft, Milton Jones Is Out There, Milton: Impossible and Ha! Milton, all playing to well over 100,000 people.\r\n \r\nMilton will be joined by two brilliant guest comedians – names TBA soon!\r\n \r\n“King of the surreal one liner.” – The Times\r\n“No-one can touch Jones when he hits his stride.” – The Guardian","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"MILTON JONES AND GUESTS!","instanceDates":"29 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"483601AHHHLMNMKCBCMKBJMGRGSQGJCPN","firstInstanceDateTime":"2026-10-29T20:00:00","firstInstanceDateTimeUtc":"2026-10-29T20:00:00Z","lastInstanceDateTime":"2026-10-29T20:00:00","lastInstanceDateTimeUtc":"2026-10-29T20:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"13+","attribute_BlockBookings":false,"attribute_EMSEventID":"6854","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Money for Nothing are back after their success last year. Celebrating 26\r\n\r\nyears of performing their tribute to legendary rockers Dire Straits.\r\n\r\nHaving toured the world with their fully-live two-hour show and tipped\r\n\r\nas the world’s number one Dire Straits tribute, join them for a night of\r\n\r\nclassic Dire Straits hits including versions from the ‘Alchemy’, ‘Brothers\r\n\r\nin Arms’ and ‘On Every Street’ tours. You will be blown away with the\r\n\r\nattention to detail and musicality whilst taking a trip down memory lane.\r\n\r\nA must for any rock enthusiast or Dire Straits fan.\r\n\r\n“This band is INCREDIBLE! Go and buy tickets for them right now! You will\r\n\r\nnot be disappointed!”\r\n\r\n- Playhouse Whitley Bay Managemen","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"Money For Nothing ","instanceDates":"13 October-13 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"481801AHVHNSKBHDRJBTKJMMJQBKQSNLG","firstInstanceDateTime":"2026-10-13T19:30:00","firstInstanceDateTimeUtc":"2026-10-13T18:30:00Z","lastInstanceDateTime":"2026-10-13T19:30:00","lastInstanceDateTimeUtc":"2026-10-13T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6604","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Don your deerstalker, grab your magnifying glass and get your ‘finger of suspicion’ at the ready because Edinburgh Fringe favourites, Degrees of Error, are bringing back their multiple sell-out show for your sleuthing pleasure.\r\n\r\nThey’ll create a classic murder mystery on-the-spot in this ingenious improvised comedy. You, the audience, become the author as the cast act out your very own Agatha Christie-inspired masterpiece live on stage. At each show this extraordinarily talented company use audience suggestions to create a unique, original and extremely comical murder mystery just for you. All you have to do... is solve it!\r\n\r\nMs Gold poisoned at a synchronised swimming gala? Dr Blue exploded by cannon during a hot air balloon race? Professor Violet crushed to death at a Love Island recoupling? You decide!\r\n\r\nBut will you guess whodunnit before the killer is revealed?","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Murder, She Didn’t Write","instanceDates":"28 January-28 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"499001ARJMNSKCDGTBHRQMJKKLMBNQSLG","firstInstanceDateTime":"2027-01-28T19:30:00","firstInstanceDateTimeUtc":"2027-01-28T19:30:00Z","lastInstanceDateTime":"2027-01-28T19:30:00","lastInstanceDateTimeUtc":"2027-01-28T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"12+","attribute_BlockBookings":false,"attribute_EMSEventID":"6937","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Natural History Museum presents Dinosaurs Live!","instanceDates":"28 October-28 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"438401ASHVQHJGVQDQBHJTTHDSDTSQLLP","firstInstanceDateTime":"2026-10-28T12:30:00","firstInstanceDateTimeUtc":"2026-10-28T12:30:00Z","lastInstanceDateTime":"2026-10-28T15:30:00","lastInstanceDateTimeUtc":"2026-10-28T15:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"3+","attribute_BlockBookings":false,"attribute_EMSEventID":"6438","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The Signatures Northern Soul Live\r\n\r\nImmerse yourself in the energy of a ten-piece live band, showcasing their exceptional talent in their own distinctive style. Experience the soul-stirring magic, power & expression of The Signatures 10 on stage including 3 horns. With special guest Original Northern Soul artist LORRAINE SILVER . Wigan Casino Favourite 'LOST SUMMER LOVE'\r\n\r\nThis live show guarantees an evening filled with more than just the Northern Soul classics, presented in a unique and exhilarating manner.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"NORTHERN SOUL LIVE - THE SIGNATURES WITH SPECIAL GUEST ORIGINAL NORTHERN SOUL ARTIST LORRAINE SILVER","instanceDates":"10 September-10 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"504801AJMTSHDJRDQDKJHRSHDTGLGLDCM","firstInstanceDateTime":"2027-09-10T19:30:00","firstInstanceDateTimeUtc":"2027-09-10T18:30:00Z","lastInstanceDateTime":"2027-09-10T19:30:00","lastInstanceDateTimeUtc":"2027-09-10T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6856","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"There are Elvis tributes….. and then there’s Lee Memphis King.\r\n\r\nLee Memphis King, Europe’s most successful Elvis Presley tribute artist, recreates the essence of the King with consummate ease and an almost unbelievable combination of stunningly accurate vocals and incredible passion in every performance.\r\n\r\nIn this latest production, Lee Memphis King portrays Elvis Presley at his peak celebrating the iconic ‘Vegas Years’ from 1969 – 1977. Resplendent in the most authentic costumes from Elvis’s performance and an orchestra backing this incredible performer prepare to be taken back in time to see Elvis in the way it was.","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"One Night of Elvis starring Lee Memphis King","instanceDates":"30 January-30 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"460201ABLVQSHKHRJGPKDLVCPJBGRKBTH","firstInstanceDateTime":"2027-01-30T19:30:00","firstInstanceDateTimeUtc":"2027-01-30T19:30:00Z","lastInstanceDateTime":"2027-01-30T19:30:00","lastInstanceDateTimeUtc":"2027-01-30T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6534","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"An autobiographical story of love, loss and resilience.\r\n\r\nFacing a two-week eviction notice just days after his mum’s death, Kirris sets up a makeshift podcast studio in his childhood council flat, recording the story of his life before he has to leave.\r\n\r\nWeaving memories, music and fragments from his journal, he brings to life the experiences that have shaped him, confronting identity, grief and the lifelong struggle with systemic racism.\r\n\r\nAt the heart of the show is his fiercely optimistic mum, whose love, humour and creativity continue to guide him.\r\n\r\nWith original music, raw vulnerability and powerful storytelling, Pieces of My Life is a deeply human exploration of defiance, family and home.\r\n\r\nWritten and performed by TV and theatre actor Kirris Riviere (Hollyoaks, The Sandman) and produced by award-winning theatre company Ad Infinitum (Last Rites, Beautiful Evil Things).","htmlDescription":"<div id>\r\n\r\n</div>","duration":55,"imageUrl":"","isOnSale":true,"name":"Pieces of My Life by Kirris Riviere","instanceDates":"27 October-27 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"481001APGDPSVVVTSCHCCVRKLJRLPDGSC","firstInstanceDateTime":"2026-10-27T19:30:00","firstInstanceDateTimeUtc":"2026-10-27T19:30:00Z","lastInstanceDateTime":"2026-10-27T19:30:00","lastInstanceDateTimeUtc":"2026-10-27T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"12+","attribute_BlockBookings":false,"attribute_EMSEventID":"6478","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"PROGRAMME: Treasure Island","instanceDates":"9 December-27 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"488001AMPDDRTBMCVSPTJCNJMHQLDNBJM","firstInstanceDateTime":"2026-12-09T19:00:00","firstInstanceDateTimeUtc":"2026-12-09T19:00:00Z","lastInstanceDateTime":"2026-12-27T15:00:00","lastInstanceDateTimeUtc":"2026-12-27T15:00:00Z","altText":"","attribute_AccountCode":"10-11 Christmas Show Revenue","attribute_BlockBookings":false,"attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Other","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_EMSEventID":"","attribute_TriggerWarning":""},{"description":"At a garden party on a sunny afternoon, Alice is surprised to see her parents’ friend Lewis Carroll\r\ntransform into a white rabbit. When she follows him down a rabbit hole, events become curiouser\r\nand curiouser…As Alice journeys through Wonderland, she encounters countless strange creatures.\r\nShe’s swept off her feet by the charming Knave of Hearts, who’s on the run for stealing the tarts.\r\nConfusion piles upon confusion. Then Alice wakes with a start. Was it all a daydream?\r\nChristopher Wheeldon’s Alice’s Adventures in Wonderland burst onto the stage in 2011 in an\r\nexplosion of colour, stage magic and inventive, sophisticated choreography. Joby Talbot’s score\r\ncombines contemporary soundworlds with sweeping melodies that gesture to ballet scores of the\r\n19th century. Bob Crowley’s wildly imaginative, eye-popping designs draw on everything from\r\npuppetry to projections to make Wonderland wonderfully real. The result shows The Royal Ballet at\r\nits best, bringing together world-class dance with enchanting family entertainment and ingenious\r\nmusic and design","htmlDescription":"<div id>\r\n\r\n</div>","duration":170,"imageUrl":"","isOnSale":true,"name":"RBO Live - Alice's Adventures in Wonderland","instanceDates":"30 March-30 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"485801AJBDNVDTCBNRPQBBDTNCPGGCKHH","firstInstanceDateTime":"2027-03-30T19:00:00","firstInstanceDateTimeUtc":"2027-03-30T18:00:00Z","lastInstanceDateTime":"2027-03-30T19:00:00","lastInstanceDateTimeUtc":"2027-03-30T18:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6841","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\nCarmen GINGER COSTA-JACKSON\r\n\r\nDon José RUSSELL THOMAS\r\n\r\nMicaëla ADRIANA GONZÁLEZ\r\n\r\nEscamillo ALEXANDER VINOGRADOV\r\n\r\nZuniga BARNABY REA\r\n\r\n \r\n\r\nCreatives: \r\n\r\nMusic GEORGES BIZET\r\n\r\nLibretto HENRI MEILHAC, LUDOVIC HALÉVY\r\n\r\nConductor SESTO QUATRINI\r\n\r\nDirector DAMIANO MICHIELETTO\r\n\r\nSet Designer PAOLO FANTIN\r\n\r\nCostume Designer CARLA TETI\r\n\r\nLighting Designer ALESSANDRO CARLETTI\r\n\r\nDramaturg ELISA ZANINOTTO\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nUnder the oppressive heat of the Spanish sun, the fiercely independent Carmen attracts the attention of Don José. She warns him not to fall in love with her, but his obsession knows no bounds. Damiano Michieletto’s searing production returns, casting scorching light on the lust, violence and destructive desire of Bizet’s ever-popular opera.\r\n\r\nAn all-star cast brings this white-hot drama to life, with Ginger Costa-Jackson in the fiery title role, alongside Russell Thomas as the jealous and despairing Don José. Following his 2023 Royal Opera debut, Sesto Quatrini returns to conduct Bizet’s electrifying and sensual score.\r\n\r\nSung in French with English Subtitles","htmlDescription":"<div id>\r\n\r\n</div>","duration":215,"imageUrl":"","isOnSale":true,"name":"RBO Live - Carmen","instanceDates":"15 November-15 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484801AVHMNCRBKQPHRRVLMLQVNJLQHDP","firstInstanceDateTime":"2026-11-15T14:00:00","firstInstanceDateTimeUtc":"2026-11-15T14:00:00Z","lastInstanceDateTime":"2026-11-15T14:00:00","lastInstanceDateTimeUtc":"2026-11-15T14:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6804","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\n \r\n\r\nFiordiligi LOUISE ALDER\r\n\r\nDorabella SIMONE MCINTOSH\r\n\r\nFerrando MINGJIE LEI\r\n\r\nGuglielmo HUW MONTAGUE RENDALL\r\n\r\nDon Alfonso GERALD FINLEY\r\n\r\nDespina EMILY POGORELC\r\n\r\n \r\n\r\nCreatives: \r\n\r\n \r\n\r\nMusic WOLFGANG AMADEUS MOZART\r\n\r\nConductor THOMAS HENGELBROCK\r\n\r\nDirector NETIA JONES\r\n\r\nSet Designer HYEMI SHIN\r\n\r\nCostume Designers NETIA JONES, HYEMI SHIN\r\n\r\nLighting Designer LUCY CARTER\r\n\r\nMovement Director ANNA MORRISSEY\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nSpurred on by a bet, two young men hatch a plan to test the fidelity of their girlfriends. What follows is a slippery game of seduction and power, the four lovers plunging into a dizzying world of shifting reality, where truth becomes increasingly unstable.\r\n\r\nCosì fan tutte has lost none of its sting since it first scandalised audiences in 1790. In her Main Stage debut, Netia Jones, Associate Director of The Royal Opera, reimagines Mozart’s comedy of manners through a sharp contemporary lens, where 18th-century romantic trickery meets deeply satirical high-tech deceit. Taking on the roles of the lovers is an exciting young cast led by Louise Alder, Simone McIntosh, Mingjie Lei and Huw Montague Rendall, with Gerald Finley as their manipulative game-master Don Alfonso and Emily Pogorelc as Despina. Thomas Hengelbrock conducts, bringing out the exquisite melodies that underpin the provocative, and resolutely modern, themes at the heart of the opera.\r\n\r\nSung in italian with English subtitles","htmlDescription":"<div id>\r\n\r\n</div>","duration":210,"imageUrl":"","isOnSale":true,"name":"RBO Live - Così fan Tutte","instanceDates":"23 February-23 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"485601AGTMBHPCRBDDCTNSKPVHNMDGQPL","firstInstanceDateTime":"2027-02-23T18:45:00","firstInstanceDateTimeUtc":"2027-02-23T18:45:00Z","lastInstanceDateTime":"2027-02-23T18:45:00","lastInstanceDateTimeUtc":"2027-02-23T18:45:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6807","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\n \r\n\r\nSiegfried ANDREAS SCHAGER\r\n\r\nGunther THOMAS LEHMAN\r\n\r\nHagen MIKA KARES\r\n\r\nAlberich CHRISTOPHER PURVES\r\n\r\nBrünnhilde ELISABET STRID\r\n\r\nGutrune AMANDA MAJESKI\r\n\r\nWaltraute ANNIKA SCHLICHT\r\n\r\nFirst Norn NOA BEINART\r\n\r\nSecond Norn CLAIRE BARNETT-JONES\r\n\r\nThird Norn CATHARINE WOODWARD\r\n\r\nWoglinde SARAH BRADY\r\n\r\nWellgunde NIAMH O’SULLIVAN\r\n\r\nFlosshilde SIAN GRIFFITHS\r\n\r\n \r\n\r\nCreatives: \r\n\r\n \r\n\r\nMusic RICHARD WAGNER\r\n\r\nConductor ANTONIO PAPPANO\r\n\r\nDirector BARRIE KOSKY\r\n\r\nSet Designer RUFUS DIDWISZUS\r\n\r\nCostume Designer VICTORIA BEHR\r\n\r\nLighting Designer ALESSANDRO CARLETTI\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nAn earth in ruin. The twilight of the Gods.\r\n\r\nDeception leads to treachery, then devastation, when Siegfried is tricked into betraying Brünnhilde. Learning the truth of her beloved’s innocence, Brünnhilde at last returns the ring to the Rhinemaidens, before ordering that Valhalla be swallowed in flames. For the long-awaited finale of Wagner’s epic saga, director Barrie Kosky situates the rich apocalyptic drama in a contemporary world of dream-like turmoil. Antonio Pappano, Conductor Laureate of The Royal Opera, returns to take on the impassioned, otherworldly music – including Siegfried’s transporting Funeral March and Brünnhilde’s electrifying Immolation Scene. The brilliant cast is led by Elisabet Strid, Andreas Schager and Mika Kares, who together with the full forces of the Orchestra of the Royal Opera House and the Royal Opera Chorus bring opera’s greatest journey to its shattering end.\r\n\r\nSung in German with English subtitles","htmlDescription":"<div id>\r\n\r\n</div>","duration":350,"imageUrl":"","isOnSale":true,"name":"RBO Live - Götterdämmerung","instanceDates":"3 February-3 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484802AKJRPVDHDGVRKCSCJPBCNRDRCHV","firstInstanceDateTime":"2027-02-03T16:45:00","firstInstanceDateTimeUtc":"2027-02-03T16:45:00Z","lastInstanceDateTime":"2027-02-03T16:45:00","lastInstanceDateTimeUtc":"2027-02-03T16:45:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6806","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\n \r\n\r\nMinnie SONDRA RADVANOVSKY\r\n\r\nDick Johnson SEOKJONG BAEK\r\n\r\nJack Rance CHRISTOPHER MALTMAN\r\n\r\n \r\n\r\nCreatives:\r\n\r\n \r\n\r\nMusic GIACOMO PUCCINI\r\n\r\nConductor KERI-LYNN WILSON\r\n\r\nDirector RICHARD JONES\r\n\r\nSet Designer MIRIAM BUETHER\r\n\r\nCostume Designer NICKY GILLIBRAND\r\n\r\nLighting Designer MIMI JORDAN SHERIN\r\n\r\nChoreographer LUCY BURGE\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nPuccini’s exhilarating drama of the Wild West returns in a new staging by celebrated British director Richard Jones, marking the company’s first new production of La Fanciulla del West in more than 30 years. Soprano Sondra Radvanovsky adds to her already remarkable Met repertoire, making her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver rough justice—and win Minnie for himself. Maestro Keri-Lynn Wilson takes the podium to conduct one of opera’s most action-packed adventures, live from the Met stage to cinemas worldwide. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.","htmlDescription":"<div id>\r\n\r\n</div>","duration":195,"imageUrl":"","isOnSale":true,"name":"RBO Live - La Fanciulla del West","instanceDates":"26 January-26 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"485401ADKDTDLDHLRHNPHMQLTJCQVJQNC","firstInstanceDateTime":"2027-01-26T18:00:00","firstInstanceDateTimeUtc":"2027-01-26T18:00:00Z","lastInstanceDateTime":"2027-01-26T18:00:00","lastInstanceDateTimeUtc":"2027-01-26T18:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6805","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\nMacbeth QUINN KELSEY\r\n\r\nLady Macbeth LISE DAVIDSEN\r\n\r\nMacduff FREDDIE DE TOMMASO\r\n\r\nBanquo RYAN SPEEDO GREEN\r\n\r\n \r\n\r\nCreatives: \r\n\r\nMusic GIUSEPPE VERDI\r\n\r\nConductor YANNICK NÉZET-SÉGUIN\r\n\r\nDirector LOUISA PROSKE\r\n\r\nSet Designer JON BAUSOR\r\n\r\nCostume Designer MONTANA LEVI BLANCO\r\n\r\nLighting Designer ADAM SILVERMAN\r\n\r\nChoreographer JORRELL LAWYER-JEFFERSON\r\n\r\nFight Director RAN ARTHUR BRAUN\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nTwo of opera’s most extraordinary artists return to The Met: Live in HD for Verdi’s thrilling take on the immortal Shakespearean tale of the scheming couple determined to seize power at any cost. Following past triumphs in many of Verdi’s signature baritone roles, Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite Lise Davidsen—the world’s reigning dramatic soprano—as the power-mad Lady Macbeth, whose ruinous ambition damns them both. Met Music Director Yannick Nézet-Séguin takes the podium for a penetrating production by Louisa Proske, a brilliant young director making waves around the world. Rounding out the all-star cast are tenor Freddie De Tommaso as the heroic Macduff and bass-baritone Ryan Speedo Green as Macbeth’s friend-turned-victim Banquo. This production is part of the Met’s award-winning Live in HD series, bringing opera to cinemas across the globe.\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":210,"imageUrl":"","isOnSale":true,"name":"RBO Live - Macbeth","instanceDates":"20 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"485201AHGNGHNDNRMKKQCBHHCVNTSRJCD","firstInstanceDateTime":"2026-10-20T18:00:00","firstInstanceDateTimeUtc":"2026-10-20T17:00:00Z","lastInstanceDateTime":"2026-10-20T18:00:00","lastInstanceDateTimeUtc":"2026-10-20T17:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6802","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast: \r\n\r\n \r\n\r\nTo be confirmed\r\n\r\n \r\n\r\nCreatives: \r\n\r\nChoreography KENNETH MACMILLAN\r\n\r\nMusic JULES MASSENET\r\n\r\nOrchestration MARTIN YATES\r\n\r\nConductor KOEN KESSELS\r\n\r\nDesigner NICHOLAS GEORGIADIS\r\n\r\nLighting Designer JACOPO PANTANI\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nIn the seedy underbelly of 18th-century Paris, money is king. Nothing is sacred – even love itself can be bought for the right price. A native of this hedonistic underworld, Manon is caught between twin desires when she falls in love with the student Des Grieux. Steadfast and devoted, he offers the possibility of an honourable life. Yet, the riches promised by the world of Parisian society remain tempting...\r\n\r\nManon’s inner turmoil and struggle for survival lie at the devastating heart of Kenneth MacMillan’s 1974 adaptation of Abbé Prévost’s novel. In this signature work of The Royal Ballet, MacMillan’s nuanced understanding of human psychology makes for an unflinching look into the moral degradation of Manon’s Paris, while all its decadence and decay are brought to life through Jules Massenet’s score and Nicholas Georgiadis’s designs.","htmlDescription":"<div id>\r\n\r\n</div>","duration":190,"imageUrl":"","isOnSale":true,"name":"RBO Live - Manon","instanceDates":"27 October-27 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"485001ACRTHQRBJQSKCPLKDHGCDDCJQBS","firstInstanceDateTime":"2026-10-27T19:15:00","firstInstanceDateTimeUtc":"2026-10-27T19:15:00Z","lastInstanceDateTime":"2026-10-27T19:15:00","lastInstanceDateTimeUtc":"2026-10-27T19:15:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6803","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast: \r\n\r\n \r\n\r\nJuliet FUMI KANEKO\r\n\r\nRomeo VADIM MUNTAGIROV\r\n\r\nMercutio FRANCISCO SERRANO\r\n\r\nTybalt RYOICHI HIRANO\r\n\r\nBenvolio GIACOMO ROVERO\r\n\r\nParis LUKAS B. BRÆNDSRØD\r\n\r\nLord Capulet BENNET GARTSIDE\r\n\r\nLady Capulet CHRISTINA ARESTIS\r\n\r\nEscalus, Prince of Verona HARRIS BELL\r\n\r\nRosaline ANNETTE BUVOLI\r\n\r\nNurse OLIVIA COWLEY\r\n\r\nFriar Laurence THOMAS WHITEHEAD\r\n\r\nLord Montague THOMAS WHITEHEAD\r\n\r\nLady Montague LARA TURK\r\n\r\n \r\n\r\nCreatives: \r\n\r\n \r\n\r\nChoreography KENNETH MACMILLAN\r\n\r\nMusic SERGEY PROKOFIEV\r\n\r\nConductor KOEN KESSELS\r\n\r\nDesigner NICHOLAS GEORGIADIS\r\n\r\nLighting Designer JOHN B. READ\r\n\r\nStaging and Artistic Supervisor to the MacMillan Estate LAURA MORERA\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nThe Capulets and Montagues are sworn enemies. Yet it is love at first sight for Romeo Montague and Juliet Capulet when they meet each other at the Capulet ball, into which Romeo has snuck. The two fall in love and they profess their devotion to each other at Juliet’s balcony. They secretly get married.  \r\n\r\nThe stakes are raised for the young couple when Romeo avenges the death of his friend Mercutio who has been killed by Tybalt, Juliet’s cousin. For this, Romeo is exiled from Verona. Meanwhile, Juliet’s parents are forcing her to marry another suitor. In order to be together, Romeo and Juliet must risk it all.","htmlDescription":"<div id>\r\n\r\n</div>","duration":170,"imageUrl":"","isOnSale":true,"name":"RBO Live - Romeo & Juliet","instanceDates":"25 May-25 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"486202ARSSQGPNKCBSLSGJPPGSQRSTMLN","firstInstanceDateTime":"2027-05-25T19:15:00","firstInstanceDateTimeUtc":"2027-05-25T18:15:00Z","lastInstanceDateTime":"2027-05-25T19:15:00","lastInstanceDateTimeUtc":"2027-05-25T18:15:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6811","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:\r\n\r\n \r\n\r\nTo be confirmed\r\n\r\n \r\n\r\nCreatives: \r\n\r\n \r\n\r\nChoreography MARIUS PETIPA, LEV IVANOV\r\n\r\nAdditional Choreography LIAM SCARLETT, FREDERICK ASHTON\r\n\r\nMusic PYOTR IL’YICH TCHAIKOVSKY\r\n\r\nConductor KOEN KESSELS\r\n\r\nProduction LIAM SCARLETT\r\n\r\nDesigner JOHN MACFARLANE\r\n\r\nLighting Designer DAVID FINN\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nPrincess Odette is bound by a curse, turned into a swan by the evil sorcerer Von Rothbart. The spell can only be broken by a pledge of eternal love. When she meets Prince Siegfried, he is immediately enamoured by her fragile beauty and pledges to free her. But freedom is not promised for Odette as Von Rothbart conspires to thwart the lovers’ plans.\r\n\r\nLiam Scarlett’s production for The Royal Ballet brings together Tchaikovsky’s towering score and John Macfarlane’s picturesque designs to create an enduring ballet spectacle of love, treachery and forgiveness.","htmlDescription":"<div id>\r\n\r\n</div>","duration":205,"imageUrl":"","isOnSale":true,"name":"RBO Live - Swan Lake","instanceDates":"22 April-22 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"486001AGTGSJSQSQRQMDCTNTLQKHRTRTP","firstInstanceDateTime":"2027-04-22T19:15:00","firstInstanceDateTimeUtc":"2027-04-22T18:15:00Z","lastInstanceDateTime":"2027-04-22T19:15:00","lastInstanceDateTimeUtc":"2027-04-22T18:15:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6809","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cast:  \r\n\r\n \r\n\r\nFloria Tosca ALEKSANDRA KURZAK\r\n\r\nMario Cavaradossi SAIMIR PIRGU\r\n\r\nBaron Scarpia CHRISTOPHER MALTMAN\r\n\r\nSpoletta ALED HALL\r\n\r\nCesare Angelotti PAWEŁ HORODYSKI\r\n\r\nSacristan JONATHAN LEMALU\r\n\r\nSciarrone SAM HIRD\r\n\r\n \r\n\r\nCreatives: \r\n\r\n \r\n\r\nMusic GIACOMO PUCCINI\r\n\r\nConductor DANIEL OREN\r\n\r\nDirector OLIVER MEARS\r\n\r\nSet Designer SIMON LIMA HOLDSWORTH\r\n\r\nCostume Designer ILONA KARAS\r\n\r\nLighting Designer FABIANA PICCIOLI\r\n\r\nMovement Director ANNA MORRISSEY\r\n\r\n \r\n\r\nSynopsis: \r\n\r\nFloria Tosca and Mario Cavaradossi live for each other and for their art. But when Cavaradossi helps an escaped prisoner, the lovers make a deadly enemy in the form of Baron Scarpia, Chief of Police. At the mercy of Scarpia’s twisted desires, Tosca is forced to make a horrific bargain: sleeping with the man she hates, in order to save the man she loves. Can she find a way out?\r\n\r\nOliver Mears’s acclaimed production returns, setting Puccini’s operatic thriller in a contemporary, war-torn Rome. Daniel Oren conducts Aleksandra Kurzak, who returns to the title role, joined by Saimir Pirgu as Cavaradossi and Christopher Maltman as Baron Scarpia.","htmlDescription":"<div id>\r\n\r\n</div>","duration":195,"imageUrl":"","isOnSale":true,"name":"RBO Live - Tosca","instanceDates":"5 May-5 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"486201AVKQQVSKDMRRCGTCVBKTSRVSLPQ","firstInstanceDateTime":"2027-05-05T19:00:00","firstInstanceDateTimeUtc":"2027-05-05T18:00:00Z","lastInstanceDateTime":"2027-05-05T19:00:00","lastInstanceDateTimeUtc":"2027-05-05T18:00:00Z","altText":"","attribute_AccountCode":"10-02 Cinema Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6810","attribute_FacilitatedBookings":false,"attribute_Genre":"Film","attribute_Type":"Cinema","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"This fast-paced, high-energy adaptation of Romeo and Juliet places the audience at the heart of the action. With just three actors and minimal staging, the production strips the play back to its core, highlighting the urgency of the story and the emotional stakes faced by its young characters.\r\n\r\nA bold, modern narrator guides the piece, using humour, reflection and direct audience involvement to challenge the idea of “true love” and pull viewers into the drama. Scenes shift rapidly in tone and tempo, blending sharp choreography, clear storytelling and rich character work to create a dynamic experience that speaks directly to young audiences.\r\n\r\nThis version of Romeo and Juliet is both accessible and uncompromising, offering a fresh take on Shakespeare’s tragedy that resonates with today’s students.\r\n\r\nSuitable for students in years 9, 10 & 11.","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"Romeo & Juliet","instanceDates":"24 March-24 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"481601ANHGJQGMDPNMQDDPBKRKCMGDHNC","firstInstanceDateTime":"2027-03-24T11:00:00","firstInstanceDateTimeUtc":"2027-03-24T11:00:00Z","lastInstanceDateTime":"2027-03-24T14:00:00","lastInstanceDateTimeUtc":"2027-03-24T14:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"12+","attribute_BlockBookings":false,"attribute_EMSEventID":"6425","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"Scummy Mummies: On The Edge","instanceDates":"12 May-13 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"502601AGDCQDRBGHLMQPGNSSSLQSHGQDV","firstInstanceDateTime":"2027-05-12T19:30:00","firstInstanceDateTimeUtc":"2027-05-12T18:30:00Z","lastInstanceDateTime":"2027-05-13T19:30:00","lastInstanceDateTimeUtc":"2027-05-13T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"18+ no babes in arms","attribute_BlockBookings":false,"attribute_EMSEventID":"6903","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"Seven Drunken Nights 2027","instanceDates":"25 February-25 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"498401APJMCCSKLGTJDGGLHMNKPRRLGGS","firstInstanceDateTime":"2027-02-25T19:30:00","firstInstanceDateTimeUtc":"2027-02-25T19:30:00Z","lastInstanceDateTime":"2027-02-25T19:30:00","lastInstanceDateTimeUtc":"2027-02-25T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6393","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Sh!t-faced Shakespeare®: Romeo and Juliet\r\n\r\n\r\nThe smash-hit, internationally acclaimed, award-winning, multi-sell-out phenomenon is back. Our cast will present an unconventional, no-holds-barred interpretation of 'Romeo and Juliet', with a tipsily tragic take on William Shakespeare's most iconic roll call of characters: from a rat-arsed Romeo to a juiced-up Juliet, a trollied Tybalt or a mashed-up Mercutios, along with enough booze to sterilise a brewery floor. This will be a tragedy like no other—the cup overfloweth.\r\n\r\n\r\nThere is no love lost between the Capulet and Montague families, and everyone in Verona knows it. Surely the only hangover cure to centuries of family feuds is two forlorn teenagers from opposite households falling in love with each other? And a swig (or two) of the finest spirits to nudge them in the right direction, of course... What could possibly go wrong?\r\n\r\n\r\nWarning: Sh!t-faced Shakespeare® may feature foul language, nudity, disembowelled limbs and, occasionally, some Shakespeare.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Sh!t-faced Shakespeare® Romeo & Juliet","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"450801AQGCCNMRHQTGHCBTRHJDVQNTKQH","firstInstanceDateTime":"2026-10-24T19:30:00","firstInstanceDateTimeUtc":"2026-10-24T18:30:00Z","lastInstanceDateTime":"2026-10-24T19:30:00","lastInstanceDateTimeUtc":"2026-10-24T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"16+","attribute_BlockBookings":false,"attribute_EMSEventID":"6314","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_TriggerWarning":"foul language, nudity","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"Versatile and prolific Leeds-based pianist & composer Simeon Walker has quickly emerged as a leading light in the burgeoning modern classical scene. Alongside a busy performance and touring schedule across the UK and Europe, in recent years he has supported a variety of high-profile artists including Neil Cowley,  Submotion Orchestra, Erland Cooper and LYR (Simon Armitage’s musical project) and performed notable live sets at Latitude, Timber Festival, the Edinburgh Fringe and SXSW London.\r\n\r\nHis music is regularly broadcast on BBC Radio 3 and ClassicFM, and has received listening figures in excess of 50 million streams across platforms, whilst his piece ‘Reverie’ notably features on the first official Piano Day compilation (2022) by the LEITER label, alongside modern classical luminaries Nils Frahm, Olafur Arnalds and Chilly Gonzales.\r\n\r\nAn in-demand collaborator, Simeon has worked with numerous musicians, composers and performers across a wide range of genres and musical styles. With a keen interest in interdisciplinary work, he has received commissions to collaborate on projects involving fellow creatives such as artist Mary Griffiths, Portuguese choreographer Sara Afonso, writer Emma White, filmmakers Will Killen and Ben Cohen, plus organisations including BBC Radio 4 and University of Leeds. As a session musician, he regularly records for composers working in the film and television industries, and recently completed a range of compositional work for the popular estate agent, publisher and journal The Modern House. \r\n\r\nWhilst studying for a Masters in Composition, he studied under the tutelage of the recently-appointed Master of the King’s Music Errollyn Wallen. With a background in classical music alongside a keen interest in jazz, folk and ambient music, Simeon’s diverse and varied creative output coupled with his informal, invitational and warm-hearted approach to live performance reflects the extremes of human experience and emotion, aiming to bring people together around the joy of shared musical experiences.\r\n\r\nEncompassing moments of quiet, gentle solitude through to boisterous, flowing exuberance - this is music composed and performed from the heart; simultaneously capturing a sense of open, spacious landscapes and grandeur, paired with sincerity, intimacy and warmth. Listeners are invited to gather around the piano; to find beauty and meaning as much in the spaces between the notes as the notes themselves, as tender, expressive and heartfelt musical stories are woven engagingly together, delivered with a uniquely delicate touch and a self-deprecatory wry smile.\r\n\r\n\r\n“A singular and enchanting hour” - The Fringe Review\r\n\r\n“Sublime, assured and immersive compositions” - SY Gigs \r\n\r\n“Remarkable stage presence and command of the instrument “ - Modellbahn Music \r\n\r\n“For those who aren’t generally fans of classical music, this new movement offers a modern take that reconnects us with the beauty of the piano and how composers like Simeon Walker can use it in different ways to convey what it is that makes us human” - Louder Than War","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Simeon Walker - An Evening Around The Piano","instanceDates":"16 October-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"472001AVBNSGGRPHVGTBKKJVHCPMPNGDH","firstInstanceDateTime":"2026-10-16T19:45:00","firstInstanceDateTimeUtc":"2026-10-16T18:45:00Z","lastInstanceDateTime":"2026-10-16T19:45:00","lastInstanceDateTimeUtc":"2026-10-16T18:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"12+","attribute_BlockBookings":false,"attribute_EMSEventID":"6349","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"Some Guys Have All The Luck - The Rod Stewart Story","instanceDates":"13 February-13 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"479401ARNTJVBNHRCTQKBMVRLCLCKRKNH","firstInstanceDateTime":"2027-02-13T19:30:00","firstInstanceDateTimeUtc":"2027-02-13T19:30:00Z","lastInstanceDateTime":"2027-02-13T19:30:00","lastInstanceDateTimeUtc":"2027-02-13T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6369","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":115,"imageUrl":"","isOnSale":true,"name":"Spiers & Boden","instanceDates":"4 May-4 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"501801AHJVTGSJJKDNBVNTQGCDPPHHGLL","firstInstanceDateTime":"2027-05-04T19:30:00","firstInstanceDateTimeUtc":"2027-05-04T18:30:00Z","lastInstanceDateTime":"2027-05-04T19:30:00","lastInstanceDateTimeUtc":"2027-05-04T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6720","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Now undoubtedly one of the most established and successful Tribute Bands in the world, The SUPREME QUEEN Production is a brilliantly designed presentation paying homage to the halcyon days of one of the greatest rock bands ever.\r\n\r\nMusically exceptional throughout, the production brings together some of the finest and most recognisable Queen tribute performers in the world, complimented by the stunning production values: Authentic stage settings and specialist sound and lighting effects, that are all designed to provide the most memorable of evenings for the millions of Queen fans worldwide","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Supreme Queen","instanceDates":"10 April-10 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484201AHGMNDTGGGBCPBCLRKLSJKBJTPP","firstInstanceDateTime":"2027-04-10T19:30:00","firstInstanceDateTimeUtc":"2027-04-10T18:30:00Z","lastInstanceDateTime":"2027-04-10T19:30:00","lastInstanceDateTimeUtc":"2027-04-10T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6625","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Talon have risen from humble beginnings to become one of the most successful theatre touring shows in the UK and BUSY BEING FABULOUS ‘25/26 will once again feature the Eagles timeless back catalogue including Hotel California, Take It Easy, One Of These Nights, Take It To The Limit, Desperado, Lyin’ Eyes, Life In The Fast Lane and many more.\r\n\r\nRevered by their peers and loved by their fans, this world class seven-piece band are a phenomenon.","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"TALON - THE BEST OF EAGLES.","instanceDates":"22 January-22 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"458001APSJKDPHNJGMPRGMDMRRGNDSDQC","firstInstanceDateTime":"2027-01-22T19:30:00","firstInstanceDateTimeUtc":"2027-01-22T19:30:00Z","lastInstanceDateTime":"2027-01-22T19:30:00","lastInstanceDateTimeUtc":"2027-01-22T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6173","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Grab your mates, brush up on your general knowledge and join us for another special fundraising quiz night.\r\n\r\nDon't be fooled: this isn't like any ordinary quiz. The format is fast, fun and fierce with points on offer for correct answers and the fastest finger of each question - but get too confident and you could lose it all in the dreaded final 'evil round'.\r\n\r\nTeams of up to 6 people are welcome. You will need to bring a smartphone or tablet with you and make sure you have downloaded the ‘SpeedQuizzing’ app ahead of the quiz. Only one smartphone or tablet is required per team.\r\n\r\nYour ticket covers your entry to the quiz plus a donation to Taunton Brewhouse (Registered Charity Number 1156472) and all monies raised from the ticket price and raffle will help support the work we do at Taunton Brewhouse.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Taunton Brewhouse Fundraising Quiz","instanceDates":"20 February-28 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"443401ACBRQRBSNKKMLQPJDHBNCSCJTBC","firstInstanceDateTime":"2026-02-20T19:00:00","firstInstanceDateTimeUtc":"2026-02-20T19:00:00Z","lastInstanceDateTime":"2026-10-28T19:00:00","lastInstanceDateTimeUtc":"2026-10-28T19:00:00Z","altText":"","attribute_AccountCode":"12-03 Fundraising Activity","attribute_BlockBookings":false,"attribute_EMSEventID":"6514","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Other","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Cut off from the outside world by its remote location and shunned by all who know its forbidding and sinister reputation, Hill House has remained empty and silent except for the daily visits of its grumbling caretaker, Mrs. Dudley. Its isolation is broken by the arrival of Dr. Montague, an investigator of supernatural phenomena who has been granted a short lease by the present owner. His mission is to delve into the morbid history of the house and to come to grips with the occult forces that have made it uninhabitable for many years. He is joined by three others, all unacquainted, but all having their particular reasons for accepting Dr. Montague’s invitation to share his Hill House sojourn. Their visit begins with jovial informality, but their sensibilities are soon jolted by strange and eerie occurrences. As they struggle to disguise their mounting fears they are joined by Dr. Montague’s wife and a friend, who have come to Hill House for purposes of their own. They too are absorbed by the supernatural, but their approach is via direct communication with the departed spirits—a type of psychic research which is regarded fearfully by Dr. Montague and which, as subsequent events bear out, brings on a crisis in which the evil forces of Hill House are goaded to a new and, for one of those present, fatal fury.","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"Taunton Thespians present The Haunting of Hill House","instanceDates":"10 November-14 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"500401AMJGGSPVVMMTQDHQNLQSLHVSPHK","firstInstanceDateTime":"2026-11-10T19:30:00","firstInstanceDateTimeUtc":"2026-11-10T19:30:00Z","lastInstanceDateTime":"2026-11-14T19:30:00","lastInstanceDateTimeUtc":"2026-11-14T19:30:00Z","altText":"","attribute_AccountCode":"10-10 Ticketed Hires","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6240","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Step into the World of  \"Tease\" – the ultimate burlesque and cabaret experience where sensuality and unadulterated fun collide to create an unforgettable evening.\r\n\r\nLed by London’s top comedy compere and award-winning West End burlesque sensations, \"Turkish Delight\" and \"Violet Thistletease\", and our famous \"Tease\" group dancers.  Combined with cabaret, circus and variety acts from across the UK, set to hit tracks from \"Burlesque\", \"Chicago\" and chart-topping tunes from Cher, Christina Aguilera and many more favourites. \"Tease\" is a captivating experience that will linger in your memory long after the curtains fall.\r\n\r\nAs the lights dim and the music fills the air, surrender yourself to the allure of \"Tease.\" Feel liberated, sexy, and empowered as you laugh, cheer, and applaud along with a crowd united in the joy of the moment. Experience \"Tease\" – it's a celebration of love, life and the power of self-expression.\r\n\r\nSo book now and let's make a night to remember!","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Tease - The Ultimate Burlesque and Cabaret Experience","instanceDates":"17 September-17 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"455001ASRMHBCKSGHKCQQSLCKDBRNNMKC","firstInstanceDateTime":"2027-09-17T19:30:00","firstInstanceDateTimeUtc":"2027-09-17T18:30:00Z","lastInstanceDateTime":"2027-09-17T19:30:00","lastInstanceDateTimeUtc":"2027-09-17T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"16+","attribute_BlockBookings":false,"attribute_EMSEventID":"6517","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The show is inspired by Alice’s Adventures in Wonderland and features many elements we are all familiar with. The music describes the hot summers day by the river, going down the rabbit hole, the Cheshire Cat, the Caterpiller, Mad Hatters Tea Party etc.\r\n\r\nIt has the added twists of aural interventions from interviews we have done throughout 2024. Our starting point was the realisation that the New Forest was where the real Alice, Alice Liddell, who was the inspiration for the book, lived and died. The piece reflects the New Forest in the music — and draws thematic links from the forest and interviews with its inhabitants. Including the 40 Alices we tracked down to record.Instruments on stage will include: A Moog, a full drum kit, piano, a miniature piano, harmonium, melodica, accordion, clarinet, bass guitar, a collection of souped up tea-cups and home-made noise makers, many loop pedals for the circular caucus races and mad hatters tea parties, a megaphone, all mashed together with a load of surreal samples.\r\n\r\nThe show is full of fun, surreal adventure, plus all the elements of Alice that we’re so familiar with. Aimed at adults and young people but not the normal Alice family show - for the curious and the curiouser...","htmlDescription":"<div id>\r\n\r\n</div>","duration":85,"imageUrl":"","isOnSale":true,"name":"The Alice Project","instanceDates":"30 October-30 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"481201ALJSVRSCMPSPLCHBLJGBMKSQDSQ","firstInstanceDateTime":"2026-10-30T19:45:00","firstInstanceDateTimeUtc":"2026-10-30T19:45:00Z","lastInstanceDateTime":"2026-10-30T19:45:00","lastInstanceDateTimeUtc":"2026-10-30T19:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"10+","attribute_BlockBookings":false,"attribute_EMSEventID":"6830 ","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"The Bob Dylan Story","instanceDates":"23 September-23 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"504001AVNCNMHVRCQNKCQQNNSCKDHCKNS","firstInstanceDateTime":"2027-09-23T19:30:00","firstInstanceDateTimeUtc":"2027-09-23T18:30:00Z","lastInstanceDateTime":"2027-09-23T19:30:00","lastInstanceDateTimeUtc":"2027-09-23T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"7010","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The Bubble Show\r\nStep right up, ladies and gentlemen, boys and girls! Mr Bubbles is coming to town, and he’s making a splash with “The Bubble Show”!\r\nBrace yourselves to be dazzled by an enchanting array of whimsical soap bubbles in all shapes and sizes! From the exciting eruption of the bubble volcano to the spiralling marvel of the fire tornado, prepare to be astounded! \r\n\r\nThis is no ordinary bubble show; it's an original, interactive adventure, where the fusion of magic, storytelling, and science converge in a breathtaking display of bubble artistry.\r\n\r\nAnd leading the charge is none other than the legendary Highland Joker, actor, storyteller and Guinness World Record Holder, renowned as one of the foremost bubble artists in the world!  \r\nWhether you're a wide-eyed child or a child at heart, prepare to be captivated by the spellbinding wonder of bubbles! So come one, come all, and let your imagination soar as we dive headfirst into the spectacular world of bubbles!\r\nSuitable for ages 3-12+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"The Bubble Show","instanceDates":"7 March-7 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"468001ADGQHDCJVTLNLLRJBJBBBQMDGPK","firstInstanceDateTime":"2027-03-07T14:00:00","firstInstanceDateTimeUtc":"2027-03-07T14:00:00Z","lastInstanceDateTime":"2027-03-07T14:00:00","lastInstanceDateTimeUtc":"2027-03-07T14:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"3+","attribute_BlockBookings":false,"attribute_EMSEventID":"6506","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"The Carole King and James Taylor Songbook","instanceDates":"20 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"507001AMQBGVVHKKTGJGPSKBPPTVHVGVL","firstInstanceDateTime":"2027-10-20T19:30:00","firstInstanceDateTimeUtc":"2027-10-20T18:30:00Z","lastInstanceDateTime":"2027-10-20T19:30:00","lastInstanceDateTimeUtc":"2027-10-20T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"7045","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The Cavern Club Story is a spectacular live show celebrating 70 years of music history from the legendary Liverpool venue that changed popular music forever.\r\n\r\n\r\n\r\nFully endorsed by The Cavern Club, this powerful production takes audiences on a journey through the club’s underground beginnings on Mathew Street to its status as a global cultural landmark. For decades, The Cavern has stood at the heart of live music, launching iconic careers and hosting artists who went on to shape generations.\r\n\r\n\r\n\r\nFeaturing a superb cast of live musicians, including some of the UK’s leading West End performers, the show combines outstanding live performances with original footage and striking visuals. The set list spans decades of timeless music, celebrating songs such as I Want To Hold Your Hand, You Really Got Me, Anyone Who Had A Heart, Satisfaction, Everybody Loves A Lover and Rolling In The Deep.\r\n\r\n\r\n\r\nEmotional, uplifting and packed with unforgettable moments, The Cavern Club Story is a must-see celebration of the venue where music history was made.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Cavern Club Story","instanceDates":"16 September-16 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"475601ASDNHPPJDSPQGJLJPCHCKPNMLQR","firstInstanceDateTime":"2027-09-16T19:30:00","firstInstanceDateTimeUtc":"2027-09-16T18:30:00Z","lastInstanceDateTime":"2027-09-16T19:30:00","lastInstanceDateTimeUtc":"2027-09-16T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6693","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Following their sell out 2026 show and fresh off the stage in London’s West End, The Dazzling Diamonds proudly present their smash-hit comedy drag show.\r\n\r\nThis isn’t just any show – these “ladies” deliver a fast-paced, laugh-out-loud spectacle like no other.\r\nFeaturing a cast of three internationally acclaimed performers, the show is a dazzling mix of outrageous comedy, sensational live vocals and jaw-dropping dance routines. Expect iconic hits from Tina Turner, Adele, Lady Gaga, Elton John, and many more – though not quite like you’ve seen them before!\r\n\r\nHeading out on the road for their third and biggest tour to date, The Dazzling Diamonds are bringing an all-new show packed with hilarious new routines, alongside some of the fan favourites that audiences have come to know and love. They’ve been wowing audiences everywhere, leaving them with aching jaws, tears of laughter, and standing ovations night after night. Don’t miss your chance to see why audiences are calling this “the funniest night on the road.”\r\n\r\nSo, grab your gang, dust off the sequins, and get ready for an evening of glitz, glamour, and non-stop entertainment. The Dazzling Diamonds are here to shine – and trust us, you won’t want to miss a moment.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Dazzling Diamonds - Comedy Drag Show 2027","instanceDates":"23 January-23 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"464601AVKKTPDJHLDNRVKNTTTCDNRVNKL","firstInstanceDateTime":"2027-01-23T19:30:00","firstInstanceDateTimeUtc":"2027-01-23T19:30:00Z","lastInstanceDateTime":"2027-01-23T19:30:00","lastInstanceDateTimeUtc":"2027-01-23T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"16+","attribute_BlockBookings":false,"attribute_EMSEventID":"6288","attribute_FacilitatedBookings":false,"attribute_Genre":"Comedy","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The D-Day Darlings\r\n\r\nVICTORIOUS\r\n\r\nDirect from the Royal Albert Hall.\r\n\r\n\r\nFollowing the success of their VE Day 80 tour and triumphant performances at the iconic Royal Albert Hall, Britain’s beloved songbirds, The D-Day Darlings, proudly present their brand-new stage spectacular, Victorious, fronted by founder and lead singer Katie Ashby.\r\n\r\nThis uplifting show takes audiences on a nostalgic journey through the defining sounds of the 20th century, from the heartfelt harmonies of the 1940s to the swinging rhythms of the post war eras.\r\n\r\nWith vintage glamour, soaring vocals, and moving storytelling, Victorious pays tribute to the heroes of the past while igniting the spirit of a new generation.\r\n\r\nExpect timeless classics from Vera Lynn, The Andrews Sisters, and other musical icons whose songs have stood the test of time and stirred the hearts of millions.\r\n\r\nThe D-Day Darlings deliver another unforgettable show; filled with patriotism, elegance, and joy. This is more than a performance… it’s a celebration of resilience, love, and legacy.\r\n\r\n\r\nSuitable for all the family! NOT TO BE MISSED!\"","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The D-Day darlings - Victorious","instanceDates":"13 March-13 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"480001ATGGMSLDTQLPGMNQMKCPSJJGBNH","firstInstanceDateTime":"2027-03-13T14:00:00","firstInstanceDateTimeUtc":"2027-03-13T14:00:00Z","lastInstanceDateTime":"2027-03-13T14:00:00","lastInstanceDateTimeUtc":"2027-03-13T14:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6670","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"The celebration of a true British pop icon Dusty Springfield . An unforgettable evening of wall to wall hits and classics spanning a decade of Dusty's life and music. Louise Masters, accompanied by her seven piece band takes you from the debut ' I Only Want To Be With You ' and 'Stay A While ' through to the 'Ready Steady Go ' Motown era, Dusty In Memphis ' Son Of A Preacher Man ' and so many more.\r\nCome and join us to reminisce in tribute to our very own 'Queen OF British Pop'","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"The Dusty Show","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"438601AGBDMSQCGTTMSCGKLSQVKHHSBHG","firstInstanceDateTime":"2026-11-07T19:30:00","firstInstanceDateTimeUtc":"2026-11-07T19:30:00Z","lastInstanceDateTime":"2026-11-07T19:30:00","lastInstanceDateTimeUtc":"2026-11-07T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6413","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Ellie Gowers is a UK singer-songwriter crafting emotionally rich, story-driven music\r\n\r\ndescribed as a “sunset-hued 70s folk-pop hug.” Blending folk, indie, and acoustic pop\r\n\r\ninfluences, she has gained acclaim through her debut album Dwelling by the Weir, EP You,\r\n\r\nthe Passenger, and captivating live performances across the UK.","htmlDescription":"<div id>\r\n\r\n</div>","duration":165,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Ellie Gowers","instanceDates":"23 April-23 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"501601AQMBSPPSDTSLHJDDMTRDKNLGRDC","firstInstanceDateTime":"2027-04-23T19:45:00","firstInstanceDateTimeUtc":"2027-04-23T18:45:00Z","lastInstanceDateTime":"2027-04-23T19:45:00","lastInstanceDateTimeUtc":"2027-04-23T18:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6449","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Wielding the distinct voices of fiddle, concertina and mandolin, the Grace Smith Trio brings together three like-minded musicians to create one dynamic and expressive musical dialogue. Acclaimed fiddle and viola player Grace Smith is joined by Sam Partridge (concertina) and Tom Kimber (mandolin) in this innovative ensemble, which offers a fresh take on folk. Drawing deeply from tradition, whilst also expanding their repertoire with new melodies of their own, the Grace Smith Trio explores the boundaries of what folk can be to mesmerising effect; their music will stay with you long after you finish listening. Their debut album Overleaf was released in Autumn 2023 to great critical reception. In their review of Overleaf, Klof Mag said; “If you’re looking for the exciting future of instrumental folk music, you need search no further.”\r\n\r\n“One of the most spellbinding releases in the last decade” - Bright Young Folk\r\n\r\n\r\n\r\n“The trio explore traditional dance tunes, and add compositions of their own, in a way that is uplifting, occasionally reflective, and played with the kind of dash that just sweeps you along. In short: magnificent. ” - The Crack Magazine\r\n\r\n“Grace is doing a thing that many musicians take decades to do, she’s making an honest expression of herself through her music, and I love it!” - Sam Sweeney","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Grace Smith Trio","instanceDates":"13 March-13 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506001AKBPBVBNBNBGQMMBGVTPJGNLMJD","firstInstanceDateTime":"2027-03-13T19:45:00","firstInstanceDateTimeUtc":"2027-03-13T19:45:00Z","lastInstanceDateTime":"2027-03-13T19:45:00","lastInstanceDateTimeUtc":"2027-03-13T19:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6443","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Janice Burns & Jon Doran are an award-winning Anglo-Scottish duo who came together after discovering a shared love of traditional music. Their songs tell vivid stories about the nature of life and our place in the world.\r\n\r\n\r\n\r\n\r\nJanice & Jon’s ‘clever and uncluttered musical storytelling’ (Songlines) comes alive through tight vocal harmonies and sensitive interplay between mandolin, bouzouki and guitar. Their arrangements have a spellbinding presence and an understated energy that transports songs from the pages of books and manuscripts into the imagination of the listener.\r\n\r\n\r\n\r\n\r\nWith their relaxed and personable approach to performance, Janice & Jon are renowned for the warmth of their connection with audiences. From opening Stage 2 at Cambridge Folk Festival, to playing at the likes of Celtic Connections, Edinburgh Tradfest, Sidmouth Folk Festival and Cecil Sharp House, the duo are highly sought after across the UK and beyond.\r\n\r\n\r\n\r\n\r\nFollowing the success of their self-titled EP in 2020, Janice & Jon released their debut album, \"No More the Green Hills\", in Autumn 2022. The album had overwhelmingly positive feedback, finding its place in the Official UK Folk Albums Chart, as well as gaining airplay on BBC Radio 2 and BBC Radio Scotland. In 2024, they followed this up with \"Great Joy to the New\", an album of winter songs which reached #17 in the Official Folk Albums Chart, as well as being played on BBC Radio 2 and featured in The Guardian.\r\n\r\n\r\n\r\n\r\nThe duo's winter gigs have become something of a tradition over the last few years. People have always forged customs to survive the winter, with rituals that bring people together and bring light to the dark nights. These rituals have often been born of necessity. Beautiful, colourful, musical traditions, linked by the common cause of sustaining people spiritually, mentally, or financially through a harsh winter. Janice and Jon’s new album and live show explores these themes through a collection of traditional folk songs about Christmas, winter, and optimism for the new year.","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Janice Burns & Jon Doran: Festive Show","instanceDates":"4 December-4 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482201ACLPLTDDQMDPCLPKMPBPPHQBLCJ","firstInstanceDateTime":"2026-12-04T19:45:00","firstInstanceDateTimeUtc":"2026-12-04T19:45:00Z","lastInstanceDateTime":"2026-12-04T19:45:00","lastInstanceDateTimeUtc":"2026-12-04T19:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6419","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Recognised with a double page feature in global Guitarist magazine, Jon is a guitarist of exceptional calibre. His stand-out talent has received regular acclaim from publications such as Uncut Magazine and The Guardian.\r\n\r\nWith his latest album, Needless Alley, has come a further raft of appreciation – ‘Wilks is a genuine gem in British folk and beyond.’ (Songlines ****). ‘Wilks fully deserves his place alongside names such as Jansch, Carthy and Simpson.’ (KlofMag) His penultimate album was chosen as The Guardian Folk Album of the Month. His recent music career includes five solo albums and one EP.\r\n\r\nReleased on 19th September 2025, Jon’s 5th solo album is a patchwork of memories, “what you’d find if you rummaged around in my head for an afternoon.” Both lyrically and sonically, Needless Alley looks back at the sounds Jon connected with in his teens, shaped by early songwriting instincts and formative band experiences. With influences including Nick Drake, The Pentangle, Paul Simon and other folk luminaries the album never strays too far from the folk music he’s become known for. The title and title track relate to a street in Birmingham, Jon’s home city, on which he used to busk as a teenager.\r\n\r\nWith this album Jon makes a shift from his previous, more traditional repertoire to a collection of nearly all original songs. It’s a recording that is set to unite Jon’s heartfelt songwriting with his wide-ranging influences and experience in traditional music and far beyond.","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Jon Wilks in Concert","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"445203ATTDDVGNVKTBNTMBDQPSNQHPGMV","firstInstanceDateTime":"2026-10-17T19:45:00","firstInstanceDateTimeUtc":"2026-10-17T18:45:00Z","lastInstanceDateTime":"2026-10-17T19:45:00","lastInstanceDateTimeUtc":"2026-10-17T18:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6450","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"After many years of collaborating in various guises, Nick Hart and Tom Moore are finally on the road as a duo. Both renowned interpreters of English traditional music, Tom's playing has been described as “ingenious” (The Guardian) and “irresistible” (The Independent), while Nick has been called “...probably the finest interpreter of traditional English folk songs this generation has produced...” (tradfolk.co).\r\n\r\nThe unusual combination of Tom's viola and Nick's tenor viol creates a rich set of textures with which they explore a variety of traditional songs and tunes. The result is an absorbing expression of English music by two master players.\r\n\r\n2023 Saw the release of their first LP, 'The Colour of Amber', which quickly garnered much critical acclaim and featured in many top ten lists for the year, being described as “An inspired pairing of two musicians at the top of their game.” (Folk London) and “...head and shoulders above just about any English traditional album of the last few years” (FRUK).","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Nick Hart & Tom Moore","instanceDates":"8 May-8 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"500601ABPSQLDCTCJGCCKMPBNBNBGJGPL","firstInstanceDateTime":"2027-05-08T19:45:00","firstInstanceDateTimeUtc":"2027-05-08T18:45:00Z","lastInstanceDateTime":"2027-05-08T19:45:00","lastInstanceDateTimeUtc":"2027-05-08T18:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6544","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_TriggerWarning":"Violence including sexual violence","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"Sam Kelly is a BBC Radio 2 Folk Award winning musician, singer, songwriter, and producer from Norfolk, UK. His band The Lost Boys are festival favourites across the UK folk scene and beyond, and his portfolio as a guitar and bouzouki player includes playing with the likes of Kate Rusby, Seth Lakeman, John McCusker, Phil Beer, and Katherine Priddy. Sam has become known as a unique and innovative arranger and pioneer of traditional folk song, and has produced albums by The Changing Room, Kitty Macfarlane, Chris Cleverley, Ainsley Hamill and more. He is also is a published songwriter, with his music being used on Sky Sports, Sky Arts, Channel 4, Channel 5, as well as BBC Radio 1, 2, and 3. Described by legendary folk broadcaster Mike Harding as ‘one of my favourite singers ever’ and by Cara Dillon as ‘an amazing singer with so much soul’, Sam will be performing a rare solo show, showcasing material from across all of his varied projects, with a signature dash of humour!","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"The Folk Series: Sam Kelly","instanceDates":"12 February-12 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"462001ANGLHTRJTTDPDTKRMJQDPHMCRQR","firstInstanceDateTime":"2027-02-12T19:45:00","firstInstanceDateTimeUtc":"2027-02-12T19:45:00Z","lastInstanceDateTime":"2027-02-12T19:45:00","lastInstanceDateTimeUtc":"2027-02-12T19:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6448","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"People get ready, the ultimate soul celebration is back!\r\n\r\nAfter taking a break from touring last year, The History of Soul is back for 2026 and bigger than ever before! Join us for an unforgettable night as we transport you through the greatest eras of soul music, featuring timeless hits from legends Aretha Franklin, Marvin Gaye, James Brown, Sam Cooke, Ray Charles and The Temptations and many more.\r\n\r\nRediscover the songs that shaped the music industry as we know it, with these Motown and Stax hits never sounding better!\r\n\r\nA must see for any fan of Soul! Experience this iconic music brought back to life by an exceptional band consisting of some of the finest musicians and performers from around the world.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"The History of Soul","instanceDates":"12 March-12 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"471201APNSLDLGLGQRLTCJQHJRJBLLHDQ","firstInstanceDateTime":"2027-03-12T19:30:00","firstInstanceDateTimeUtc":"2027-03-12T19:30:00Z","lastInstanceDateTime":"2027-03-12T19:30:00","lastInstanceDateTimeUtc":"2027-03-12T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6561","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Join us for an unforgettable evening featuring the legendary Paul Jones and Tom McGuinness, two original members of Manfred Mann, along with the talented Marcus Cliffe, Simon Currie, Pete Riley, and Mike Gorman. Experience a thrilling two-hour performance packed with iconic hits, dynamic jazz, and powerful blues.\r\nThis exceptional line-up has become one of the most sought after live bands touring the UK and, in 2026, they're inviting you to celebrate their timeless classics. Enjoy favourites like \"5-4-3-2-1,\" \"Pretty Flamingo,\" \"Mighty Quinn,\" and \"Do Wah Diddy Diddy,\" alongside a captivating selection of rhythm and blues-inspired gems and unforgettable solo successes.\r\nDon't miss out on this electrifying event! Join their journey and GET YOUR KICKS ON TOUR '26 with THE MANFREDS\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Manfreds - Get Your Kicks On Tour '26","instanceDates":"5 November-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"441801ANCSDNGKMRSQMJKPDBBJQBHHVLR","firstInstanceDateTime":"2026-11-05T19:30:00","firstInstanceDateTimeUtc":"2026-11-05T19:30:00Z","lastInstanceDateTime":"2026-11-05T19:30:00","lastInstanceDateTimeUtc":"2026-11-05T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6222","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"The Radiohead Project 2027","instanceDates":"15 May-15 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506401AHJMJNVKHPRLTRRBCHPKDNCLNGD","firstInstanceDateTime":"2027-05-15T19:30:00","firstInstanceDateTimeUtc":"2027-05-15T18:30:00Z","lastInstanceDateTime":"2027-05-15T19:30:00","lastInstanceDateTimeUtc":"2027-05-15T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"7046","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_TriggerWarning":"Haze and flashing Lights ","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"THE REAL THING ORIGINAL HIT RECORDING GROUP 3 NO 1 RECORDS 'YOU TO ME ARE EVERYTHING' 'CANT GET BY WITHOUT YOU' & 'FEEL THE FORCE. ORIGINAL SINGERS CHRIS AMOO & DAVE SMITH","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Real Thing","instanceDates":"21 May-21 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484601AHRRMMSNCNVVRBHSMJMGCCPPGMR","firstInstanceDateTime":"2027-05-21T19:30:00","firstInstanceDateTimeUtc":"2027-05-21T18:30:00Z","lastInstanceDateTime":"2027-05-21T19:30:00","lastInstanceDateTimeUtc":"2027-05-21T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6855","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Hailed as the UK’s leading guitar-fest, The Story of Guitar Heroes has garnered critical acclaim both at home and abroad for its incredible homage to the most iconic guitarists from the past 50 years of popular music.\r\n\r\nFeaturing world-class musicianship and state-of-the-art video projection, this epic concert journeys through five decades, from 1950s Rock & Roll to the most influential guitar heroes of the modern era.\r\n\r\nRenowned for recreating the unique sounds of each guitar legend with incredible accuracy, The Story of Guitar Heroes utilises no less than 35 authentic guitars.\r\n\r\nExpect classic hits from legends including Hank Marvin, Eric Clapton, Jimi Hendrix, Brian May, Jimmy Page, Mark Knopfler, David Gilmour, Ritchie Blackmore, Tony Iommi, Van Halen, Slash and many more.\r\n\r\n★★★★★\r\n‘Every lick is expertly played by highly experienced, gifted musicians’ Time Out","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"The Story of Guitar Heroes","instanceDates":"21 January-21 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"454801APSJBLRQMMNGSCSBNBKNGJDMQLP","firstInstanceDateTime":"2027-01-21T19:30:00","firstInstanceDateTimeUtc":"2027-01-21T19:30:00Z","lastInstanceDateTime":"2027-01-21T19:30:00","lastInstanceDateTimeUtc":"2027-01-21T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"12+","attribute_BlockBookings":false,"attribute_EMSEventID":"6119","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"From The Ratpack to Robbie, from Basie to Bublé. . .\r\nPresented by award-winning vocalist and world-class trumpet player, Gareth John, and featuring the stunning SOS Big Band – The Story of Swing takes you on a musical journey through decades of the iconic genre of swing and big band music.\r\nFeaturing the classic, much-loved hits of Bobby Darin, Frank Sinatra, Dean Martin and Sammy Davis Jr, right through to modern day crooners such as Michael Buble, Robbie Williams, Matt Goss, Paul Anka and Harry Connick Jr.","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"The Story of Swing","instanceDates":"15 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"462401ACDCKMQGTDLTHRGGMGHTBVLGPNL","firstInstanceDateTime":"2026-10-15T19:30:00","firstInstanceDateTimeUtc":"2026-10-15T18:30:00Z","lastInstanceDateTime":"2026-10-15T19:30:00","lastInstanceDateTimeUtc":"2026-10-15T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"all ages","attribute_BlockBookings":false,"attribute_EMSEventID":"6633","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"As Take That celebrate over 30 years as the UK's number one boy band, The Take That Experience  mark over a decade together as their most popular and recognised tribute act. \r\nWith acclaimed vocal performances, stunning replica costumes and iconic dance routines, The Take That  Experience recreate the magic of Take That live on stage with their ‘Greatest Hits Tour’. \r\n“THE CLOSEST THING TO TAKE THAT” - NIGEL MARTIN-SMITH \r\nThis incredible show features hit after hit from Take That’s career spanning three decades - from classic  90s hits through to their most recent triumphs. Songs include Pray, Relight My Fire, Patience, Shine,  These Days, Rule The World and more. \r\n“ONE WORD - AMAZING!” - RUSSELL WATSON \r\nThis show is a must for any Take That fan as the boys don’t just give you a night you’ll Never Forget…  they give you The Take That Experience! ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Take That Experience","instanceDates":"18 February-18 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"498601AGKMJVKKMMQRSNQVVTMRQLPLPJQ","firstInstanceDateTime":"2027-02-18T19:30:00","firstInstanceDateTimeUtc":"2027-02-18T19:30:00Z","lastInstanceDateTime":"2027-02-18T19:30:00","lastInstanceDateTimeUtc":"2027-02-18T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6952","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Paying homage to the greatest band in history, ‘The Upbeat Beatles’ takes the audience  through the whole of the Beatles’ career; \r\n\r\nWith authentic instruments, costume changes, multimedia, and featuring an ensemble cast of professional musicians with West End experience, this is a two-hour spectacular show not to be missed, for Beatles fans new and old!","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"The Upbeat Beatles","instanceDates":"29 January-29 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"463601AJTGJLHSGVDDLNCVNGSTKHDMLHS","firstInstanceDateTime":"2027-01-29T19:30:00","firstInstanceDateTimeUtc":"2027-01-29T19:30:00Z","lastInstanceDateTime":"2027-01-29T19:30:00","lastInstanceDateTimeUtc":"2027-01-29T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6676","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"\r\nJoin us for Aladdin, a magical pantomime packed with laughter, adventure, and a whole lot of family fun! Follow the exciting journey of Aladdin, a kind-hearted dreamer whose life changes forever when he discovers a mysterious magic lamp hidden deep within a secret cave. With the help of a larger-than-life Genie, Aladdin sets off on an unforgettable adventure filled with wishes, wonder, and a chance to win the heart of the beautiful Princess Jasmine. But danger is never far away, as the wicked magician, Abanazar, plots to steal the lamp and its incredible powers for himself. Along the way, Aladdin must rely on courage, friendship, and a little bit of magic to outsmart the villain and save the day. Packed with traditional panto comedy, catchy songs, dazzling costumes, and plenty of audience participation, this sparkling retelling of the classic tale promises entertainment for the whole family. Expect heroes to cheer, villains to boo, and magical moments at every turn in this feel-good post-festive spectacular where dreams really can come true. Aladdin is a delightful festive treat not to be missed!","htmlDescription":"<div id>\r\n\r\n</div>","duration":140,"imageUrl":"","isOnSale":true,"name":"The Wayfarers present Aladdin","instanceDates":"10 January-16 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"496801AGKDJNVPKGMDMJTNQPPVCSPTSTH","firstInstanceDateTime":"2027-01-10T13:30:00","firstInstanceDateTimeUtc":"2027-01-10T13:30:00Z","lastInstanceDateTime":"2027-01-16T19:30:00","lastInstanceDateTimeUtc":"2027-01-16T19:30:00Z","altText":"","attribute_AccountCode":"10-10 Ticketed Hires","attribute_AgeGuidance":"3+","attribute_BlockBookings":false,"attribute_EMSEventID":"6017","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Tommy Blaize: The Golden Age Of Swing","instanceDates":"17 April-17 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"505201AQDHLHJJNHCCKJNDRKVKTSMSGQD","firstInstanceDateTime":"2027-04-17T19:30:00","firstInstanceDateTimeUtc":"2027-04-17T18:30:00Z","lastInstanceDateTime":"2027-04-17T19:30:00","lastInstanceDateTimeUtc":"2027-04-17T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6799","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Totally Tina","instanceDates":"22 September-22 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"503801AMDLBQCMKGKSGVBRBTRHLKMJGGS","firstInstanceDateTime":"2027-09-22T19:30:00","firstInstanceDateTimeUtc":"2027-09-22T18:30:00Z","lastInstanceDateTime":"2027-09-22T19:30:00","lastInstanceDateTimeUtc":"2027-09-22T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"7006","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Treasure Island (Christmas 2026)","instanceDates":"9 December-27 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"464801ATKLSSRGPHTKTVHJSNMBQQBPGHM","firstInstanceDateTime":"2026-12-09T19:00:00","firstInstanceDateTimeUtc":"2026-12-09T19:00:00Z","lastInstanceDateTime":"2026-12-27T15:00:00","lastInstanceDateTimeUtc":"2026-12-27T15:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_BlockBookings":false,"attribute_EMSEventID":"6642","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_AgeGuidance":"","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Twinkle Twinkle – a nocturnal journey for early years by The Last Baguette\r\nInspired by The Star by Jane Taylor\r\n\r\nIt’s the longest night of the year and it’s hard to sleep. Gazing at the stars, surprising things start to happen…..\r\n\r\nAs the sun sets and the stars come out to shine, join the woodland animals as they gather together to celebrate the solstice.\r\n\r\nTogether we will discover the light that shines in the darkness.\r\n\r\n‘Tis your bright and tiny spark,\r\nLights the trav'ller in the dark :\r\nTho' I know not what you are,\r\nTwinkle, twinkle, little star.\r\n\r\nA playful, gentle journey based on the poem The Star by Jane Taylor (first published 1806) with original music, puppetry, joyful jokes, a host of woodland animals and lots of starlight.\r\nThe Last Baguette makes entertaining, accessible and eccentric work for family audiences.\r\n\r\n**** \"Funny, charming and thought-provoking\" - CreativeReviewsUK on The Bird Show\r\n\r\nCreated for ages 2-6 and their grown-ups. Younger and older siblings welcome!\r\n\r\nthelastbaguette.com","htmlDescription":"<div id>\r\n\r\n</div>","duration":55,"imageUrl":"","isOnSale":true,"name":"Twinkle Twinkle - a nocturnal journey for early years","instanceDates":"11 December-13 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"497401ASNDVHCSVPCTNNVSKTLRKMJMVJL","firstInstanceDateTime":"2026-12-11T11:00:00","firstInstanceDateTimeUtc":"2026-12-11T11:00:00Z","lastInstanceDateTime":"2026-12-13T14:00:00","lastInstanceDateTimeUtc":"2026-12-13T14:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"early years and their grown ups (2-6)","attribute_BlockBookings":false,"attribute_EMSEventID":"6643","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"In 2027, the UK Pink Floyd Experience celebrates the 50th anniversary of Animals with a landmark tour honouring one of the band’s most powerful and enduring albums. Audiences will experience a complete live performance of Animals,  delivered with the precision, atmosphere, and sonic detail that have made this production a favourite with fans across the UK.\r\n\r\nThe show also journeys through Pink Floyd’s remarkable catalogue, bringing together iconic tracks from every era, along with a few carefully chosen surprises. Known for their meticulous approach, the musicians recreate the sound and feel of the original recordings while adding the energy of a live performance.\r\n\r\nAccompanied by a striking, fully synchronised light and visual show, this is more than a concert—it is an immersive tribute. Expect over two hours of unforgettable music, including ‘Money’, ‘Time’, ‘Another Brick in the Wall’, and ‘Comfortably Numb’. A must-see event for devoted fans and newcomers alike. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"UK Pink Floyd Experience 2027","instanceDates":"12 June-12 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506601ARQKJQVKDBVJTJPLKCTHPLVRNDV","firstInstanceDateTime":"2027-06-12T19:30:00","firstInstanceDateTimeUtc":"2027-06-12T18:30:00Z","lastInstanceDateTime":"2027-06-12T19:30:00","lastInstanceDateTimeUtc":"2027-06-12T18:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"ALL AGES","attribute_BlockBookings":false,"attribute_EMSEventID":"6833","attribute_FacilitatedBookings":false,"attribute_Genre":"Music","attribute_TriggerWarning":"haze and flashing lights","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Utterly Revolting Science Show","instanceDates":"17 February-17 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"500201ABVLSVVHCLDBNQNRTSMJNGSGDTP","firstInstanceDateTime":"2027-02-17T11:30:00","firstInstanceDateTimeUtc":"2027-02-17T11:30:00Z","lastInstanceDateTime":"2027-02-17T15:00:00","lastInstanceDateTimeUtc":"2027-02-17T15:00:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"5+","attribute_BlockBookings":false,"attribute_EMSEventID":"6863","attribute_FacilitatedBookings":false,"attribute_Genre":"Family","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""},{"description":"Argentine Tango King and Strictly Come Dancing legend, Vincent Simone, returns to the\r\nstage in 2027 with ‘Tango Passions’.\r\nAccompanied by world-class Argentine Tango and Latin specialists, let the original Italian\r\nstallion take you on a journey to Buenos Aires and tell the tale of love, passion and lust\r\nset at the turn of the 20th century.\r\nFeaturing classic and modern Argentine Tango music from the likes of Astor Piazzolla and\r\nGotan Project.\r\nA sexy, steamy, passionate night not to be missed!","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"Vincent Simone - Tango Passions","instanceDates":"11 March-11 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"473201APMSCJNHVQJLCPSRRJNLJJLMCRJ","firstInstanceDateTime":"2027-03-11T19:30:00","firstInstanceDateTimeUtc":"2027-03-11T19:30:00Z","lastInstanceDateTime":"2027-03-11T19:30:00","lastInstanceDateTimeUtc":"2027-03-11T19:30:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"14+","attribute_BlockBookings":false,"attribute_EMSEventID":"6588","attribute_FacilitatedBookings":false,"attribute_Genre":"Dance","attribute_TriggerWarning":"haze, smoke, pyrotechnics and flashing light","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Winter Calling","instanceDates":"18 December-18 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"498201AKVNSDQLPJVNNSDJTJTPQRBGPHB","firstInstanceDateTime":"2026-12-18T19:45:00","firstInstanceDateTimeUtc":"2026-12-18T19:45:00Z","lastInstanceDateTime":"2026-12-18T19:45:00","lastInstanceDateTimeUtc":"2026-12-18T19:45:00Z","altText":"","attribute_AccountCode":"10-01 Performance Revenue","attribute_AgeGuidance":"Suitable for all ages but aimed at adults","attribute_BlockBookings":false,"attribute_EMSEventID":"6898","attribute_FacilitatedBookings":false,"attribute_Genre":"Drama","attribute_Type":"Live","attribute_FilmClassification":"","attribute_FixedSeriesWebID":"","attribute_FixedSeries":"","attribute_TriggerWarning":""}]