_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Mayhem presents the best new short film talent from a global, gruesome graveyard of sinister shocks, scares and more…\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"Mayhem 2026: Short Film Showcase #2","instanceDates":"18 October-18 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"273002ASHDPMLGMMCLRLVCCHSNVJMRSHQ","firstInstanceDateTime":"2026-10-18T16:00:00","firstInstanceDateTimeUtc":"2026-10-18T15:00:00Z","lastInstanceDateTime":"2026-10-18T16:00:00","lastInstanceDateTimeUtc":"2026-10-18T15:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CountryOfOrigin":"International","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Various","attribute_Distributor":"Noel Murphy","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Mayhem Film Festival 2026","attribute_Film":true,"attribute_FilmDuration":"100","attribute_FilmRating":"18","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"What begins as a weekend visit among old friends gradually spirals into paranoia, suspicion and escalating violence, forcing the group to confront long-buried resentments and envy. From Steve Pink, the mind behind Hot Tub Time Machine, comes a spider web of twists and turns.  \r\n\r\n\r\n“Ingeniously entertaining” - Variety \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Mayhem 2026: Terrestrial","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"272001AKGNHCMVGJVGMRHPVNLKPRKMQVV","firstInstanceDateTime":"2026-10-17T12:00:00","firstInstanceDateTimeUtc":"2026-10-17T11:00:00Z","lastInstanceDateTime":"2026-10-17T12:00:00","lastInstanceDateTimeUtc":"2026-10-17T11:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Jermaine Fowler, James Morosini, Pauline Chalamet","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Steve Pink","attribute_Distributor":"Hurley/Pickle Productions","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Mayhem Film Festival 2026","attribute_Film":true,"attribute_FilmDuration":"90","attribute_FilmRating":"18","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"2025","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"From the director of the groundbreaking The Silent House and the producers of When Evil Lurks comes this disturbing horror story. Escaping from their bloodthirsty father, a brother and sister hide out in their mother’s deserted mansion—but something just as terrifying awaits them there.  \r\n\r\n\r\n“A genre blender, part folk horror, part supernatural tale driven by a vampire narrative” - Variety\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"Mayhem 2026: The Whisper ","instanceDates":"18 October-18 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"272002AKSBBNMMKDHTRLDPPHTTQGPHJHV","firstInstanceDateTime":"2026-10-18T14:00:00","firstInstanceDateTimeUtc":"2026-10-18T13:00:00Z","lastInstanceDateTime":"2026-10-18T14:00:00","lastInstanceDateTimeUtc":"2026-10-18T13:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Luciano Acosta, Romina Bentancur, Franco Pisano","attribute_CountryOfOrigin":"Uruguay","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Gustavo Hernández ","attribute_Distributor":"Latido Films","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Mayhem Film Festival 2026","attribute_Film":true,"attribute_FilmDuration":"100","attribute_FilmRating":"18","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"From the writer of past Mayhem hits Beyond The Infinite Two Minutes and River. Ueda’s directing debut is fun, clever, quirky and keeps twisting and turning, blurring the line between film and audience.\r\n\r\n\r\n“An exuberant celebration of the cinematic possibilities still to be found” - Japan Times\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":68,"imageUrl":"","isOnSale":true,"name":"Mayhem 2026: You Are the Film","instanceDates":"16 October-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"271401ADVBLCMVMGBQCLMVQQKJGVSQVCJ","firstInstanceDateTime":"2026-10-16T16:15:00","firstInstanceDateTimeUtc":"2026-10-16T15:15:00Z","lastInstanceDateTime":"2026-10-16T16:15:00","lastInstanceDateTimeUtc":"2026-10-16T15:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Riko Fujitani, Takafumi Imai, Kai Inowaki","attribute_CountryOfOrigin":"Japan","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Makoto Ueda","attribute_Distributor":"Third Window","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Mayhem Film Festival 2026","attribute_Film":true,"attribute_FilmDuration":"68","attribute_FilmRating":"18","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Giacomo Puccini | Libretto by Guelfo Civinini and Carlo Zangarini\r\nSoprano Sondra Radvanovsky makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":195,"imageUrl":"","isOnSale":true,"name":"Met Opera: La Fanciulla del West","instanceDates":"24 January-24 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"244602APGVSKKMMGQJQDVQBNJTLRKBTQK","firstInstanceDateTime":"2027-01-24T12:00:00","firstInstanceDateTimeUtc":"2027-01-24T12:00:00Z","lastInstanceDateTime":"2027-01-24T12:00:00","lastInstanceDateTimeUtc":"2027-01-24T12:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"195","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Giuseppe Verdi | Libretto by Francesco Maria Piave and Andrea Maffei\r\nBaritone Quinn Kelsey is the Scottish king haunted by the ghosts of his murderous ascent to the throne, opposite soprano Lise Davidsen as the power-mad Lady Macbeth, whose ruinous ambition damns them both.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":209,"imageUrl":"","isOnSale":true,"name":"Met Opera: Macbeth","instanceDates":"19 October-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"244401AKPMPPBRSDVMDDGLKDRGHVCBGCS","firstInstanceDateTime":"2026-10-19T18:30:00","firstInstanceDateTimeUtc":"2026-10-19T17:30:00Z","lastInstanceDateTime":"2026-10-19T18:30:00","lastInstanceDateTimeUtc":"2026-10-19T17:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"209","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Jules Massenet | Libretto by Henri Meilhac and Philippe Gille\r\nSuperstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":264,"imageUrl":"","isOnSale":true,"name":"Met Opera: Manon","instanceDates":"4 April-4 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"245001ALKLVHVMSHGGBMTRKVBRBVVDNSH","firstInstanceDateTime":"2027-04-04T12:00:00","firstInstanceDateTimeUtc":"2027-04-04T11:00:00Z","lastInstanceDateTime":"2027-04-04T12:00:00","lastInstanceDateTimeUtc":"2027-04-04T11:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"264","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Giuseppe Verdi | Libretto by Arrigo Boito\r\nOne of today’s leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera. Verdi’s monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":201,"imageUrl":"","isOnSale":true,"name":"Met Opera: Otello","instanceDates":"25 April-25 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"244003AGLPDMCLDCSNGHDPNBQBKGCVDQD","firstInstanceDateTime":"2027-04-25T12:00:00","firstInstanceDateTimeUtc":"2027-04-25T11:00:00Z","lastInstanceDateTime":"2027-04-25T12:00:00","lastInstanceDateTimeUtc":"2027-04-25T11:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"201","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Composed by Richard Wagner | Libretto by the composer\r\nA profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight’s heroic quest for the Holy Grail returns to the big screen in François Girard’s celebrated production.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":365,"imageUrl":"","isOnSale":true,"name":"Met Opera: Parsifal","instanceDates":"6 June-6 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"245201AJTRCGSHCQJNGRMQBPQLMJTHCMR","firstInstanceDateTime":"2027-06-06T12:00:00","firstInstanceDateTimeUtc":"2027-06-06T11:00:00Z","lastInstanceDateTime":"2027-06-06T12:00:00","lastInstanceDateTimeUtc":"2027-06-06T11:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"365","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Camille Saint-Saëns | Libretto by Ferdinand Lemaire\r\nSaint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him, returns in the Met’s larger-than-life production starring Clay Hilley, Aigul Akmetshina and Quinn Kelsey.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":234,"imageUrl":"","isOnSale":true,"name":"Met Opera: Samson et Dalila","instanceDates":"6 December-6 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"244601ARVVBGHBNLKTJRKTJSRKCSDBNDT","firstInstanceDateTime":"2026-12-06T12:00:00","firstInstanceDateTimeUtc":"2026-12-06T12:00:00Z","lastInstanceDateTime":"2026-12-06T12:00:00","lastInstanceDateTimeUtc":"2026-12-06T12:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"234","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Music by Kevin Puts | Libretto by Mark Campbell\r\nThis Pulitzer Prize-winning opera by Kevin Puts takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Met Opera: Silent Night","instanceDates":"21 March-21 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"244801ANGRDVTHCNSHSSHNNMCLSMHSPGV","firstInstanceDateTime":"2027-03-21T12:00:00","firstInstanceDateTimeUtc":"2027-03-21T12:00:00Z","lastInstanceDateTime":"2027-03-21T12:00:00","lastInstanceDateTimeUtc":"2027-03-21T12:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":false,"attribute_Distributor":"Trafalgar Releasing","attribute_EventCinema":true,"attribute_FestivalOrSeason":"Met Opera 2026-27","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"TBC","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Why are so many women in Gothic fiction imprisoned in attics, asylums, and haunted houses? Why has female anger so often been translated into madness, obsession, or monstrosity? And why does the figure of the ‘madwoman’ continue to haunt literature and cinema more than two centuries after the birth of the Gothic novel?\r\n\r\nThis three-hour illustrated course explores the evolution of one of Gothic storytelling's most enduring figures: the rebellious, dangerous, and supposedly ‘wicked’ woman, whose perceived madness often conceals a deeper struggle against patriarchal power.\r\n \r\nAlongside literary and cinematic analysis, we will draw on feminist theory, social history, and accounts from women confined to Victorian asylums to uncover the cultural anxieties that shaped these narratives. \r\n\r\nThe course expands beyond the traditional Anglo-American canon to explore how the Female Gothic has been examined through race, colonialism, migration, and cultural identity. From Wide Sargasso Sea and Mexican Gothic to Beloved, and from Rosemary's Baby to Nanny, La Llorona, and Mārama, we will explore how contemporary Gothic relocates the ‘madwoman’ from the attic to new cultural landscapes shaped by colonial hauntology and displacement.\r\n\r\nFinally, the course considers the future of female gothic, asking why audiences remain fascinated by women who refuse to be passive and obedient. Has the madwoman escaped the attic, or has she simply found new places to haunt?\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Monsters in the Attic: The ‘Wicked’ Women of Gothic","instanceDates":"28 November-29 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"266001ALLCHHGNHSDCDRSGPMTDHGMGCMP","firstInstanceDateTime":"2026-11-28T14:00:00","firstInstanceDateTimeUtc":"2026-11-28T14:00:00Z","lastInstanceDateTime":"2026-11-29T14:00:00","lastInstanceDateTimeUtc":"2026-11-29T14:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":true,"attribute_DirectedBy":"Clelia McElvoy","attribute_Distributor":"Clelia McElroy","attribute_EventCinema":false,"attribute_FestivalOrSeason":"One-Day Courses & Workshops","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"UC","attribute_Genre1":"Film Course","attribute_SpecialGuestEvent":false,"attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_Year":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"When it comes to classic monster movies Hollywood and other territories have provided us with some of the very best in larger-than-life delights, with the likes of King Kong (1933), Godzilla (1954) and Them! (1955) still towering above the competition. But what happens when those famous creations are revisited or examined through more contemporary eyes? Including plenty of clips ad discussion, this course will explore a handful of remakes or reworkings of classic monsters. Among those being discussed will be John Carpenter’s The Thing (1982), King Kong (1976), Invasion of the Body Snatchers (1979) The Fly (1986) and Godzilla Minus One (2024). You have been warned. Again. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Monsters Remade - The Good, the Bad and the Ugly of Creature Feature Remakes","instanceDates":"5 December-5 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"266201ARSRSRMJPDTVNDLKPCNBHBDNDQB","firstInstanceDateTime":"2026-12-05T14:00:00","firstInstanceDateTimeUtc":"2026-12-05T14:00:00Z","lastInstanceDateTime":"2026-12-05T14:00:00","lastInstanceDateTimeUtc":"2026-12-05T14:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":true,"attribute_DirectedBy":"Andrew Graves","attribute_Distributor":"Andrew Graves","attribute_EventCinema":false,"attribute_FestivalOrSeason":"One-Day Courses & Workshops","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"UC","attribute_Genre1":"Film Course","attribute_SpecialGuestEvent":false,"attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_Year":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Reel People was formed in November 2025 by a small group of independent filmmakers looking to create a vibrant and supportive film production community in Nottingham. \r\n \r\nOver the last twelve months the group has grown in numbers and the five short films screening represent a collection of the first projects that were fully pitched, produced and edited as part of the monthly group meet ups.\r\n \r\nFate is written and directed by Zefi Toska, Daylong is written and directed by Caroline Salzedo, Beer Advisor is written and directed by Duncan Ashton, The Hold Up is written and directed by Katherine Buttfield and Compersion is written and directed by Venanzio Capretta.\r\n \r\nIf you would like to find out more about Reel People and their regular meet ups you can contact keith@reel-people.org or jeff@reel-people.org or follow their Instagram at @we_are_reel_people\r\n\r\nAll tickets: £5\r\n\r\nThis MY MOVIE is presented by local filmmakers Reel People.","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"My Movie: Reel People Short Film Showcase","instanceDates":"29 November-29 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"295401AHMLHKGLJGLPJTKMHLKDNRQTDGC","firstInstanceDateTime":"2026-11-29T12:00:00","firstInstanceDateTimeUtc":"2026-11-29T12:00:00Z","lastInstanceDateTime":"2026-11-29T12:00:00","lastInstanceDateTimeUtc":"2026-11-29T12:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_Distributor":"Keith Allott","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"90","attribute_FilmRating":"UC","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_DirectedBy":"","attribute_WebImportId":"","attribute_Genre1":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Josh O’Connor leads the cast in this searing revival of Clifford Odets’ knockout American classic. \r\n1930s New York, at the height of the Depression. Joe Bonaparte is a gifted young violinist with a future in music, until a chance at fame and fortune lures him into the brutal world of professional boxing. He must confront what he’s willing to sacrifice, who he’s willing to become and how to find his place in a world that demands he choose a side. \r\nBrought to life with a live string quartet and filmed live from the Almeida Theatre. Olivier Award-winner Sam Yates directs this propulsive drama exploring ambition, identity, and the high price of success. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"National Theatre Live: Golden Boy","instanceDates":"5 November-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"280802APCHLGCSRHBPQSQSMHMBPHKHCLR","firstInstanceDateTime":"2026-11-05T19:00:00","firstInstanceDateTimeUtc":"2026-11-05T19:00:00Z","lastInstanceDateTime":"2026-11-05T19:00:00","lastInstanceDateTimeUtc":"2026-11-05T19:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Josh O'Connor, Daniel Mays","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Sam Yates","attribute_Distributor":"National Theatre","attribute_EventCinema":true,"attribute_FestivalOrSeason":"National Theatre Live","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"15","attribute_Genre1":"Event Cinema","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Emmy and Tony winner Christine Baranski makes her West End debut alongside Academy Award-nominated stage and screen legend Richard E. Grant in Noël Coward’s irresistible comedy.\r\nJudith Bliss retired from her life-on-stage and she misses the applause. Idling away at their\r\ncountry home, the rest of the family are too self-involved to be a good audience. So, Judith\r\ninvites a young fan as her guest for the weekend. But unbeknownst to her, each of the Blisses has a guest of their own arriving at the very same time.","htmlDescription":"<div id>\r\n\r\n</div>","duration":160,"imageUrl":"","isOnSale":true,"name":"National Theatre Live: Hay Fever","instanceDates":"14 January-14 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"293601AHBQDGMNBLGQDCDHRRGVGKVTPVK","firstInstanceDateTime":"2027-01-14T19:00:00","firstInstanceDateTimeUtc":"2027-01-14T19:00:00Z","lastInstanceDateTime":"2027-01-14T19:00:00","lastInstanceDateTimeUtc":"2027-01-14T19:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Christine Baranski, Richard E. Grant","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Emily Burns","attribute_Distributor":"National Theatre","attribute_EventCinema":true,"attribute_FestivalOrSeason":"National Theatre Live","attribute_Film":false,"attribute_FilmDuration":"160","attribute_FilmRating":"12A","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre1":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"The fierce and funny five-star play returns to the big screen. Sam Mendes (The Lehman Trilogy) directs Mark Gatiss in an Olivier Award-winning performance as John Gielgud.\r\n1964: Richard Burton (Johnny Flynn), newly married to Elizabeth Taylor (Tuppence Middleton), is set to play the title role in an experimental new Broadway production of Hamlet under Gielgud’s exacting direction. But as rehearsals progress, two ages of theatre collide and the collaboration between actor and director soon threatens to unravel.\r\nFrom multi-award-winning writer Jack Thorne (Adolescence), this acclaimed production was\r\nfilmed live during its sold-out London run in 2023.","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"National Theatre Live: The Motive and the Cue (Encore)","instanceDates":"18 February-18 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"293801AMBQRNPLSPBBGBPLCKMDTHQSBQT","firstInstanceDateTime":"2027-02-18T19:00:00","firstInstanceDateTimeUtc":"2027-02-18T19:00:00Z","lastInstanceDateTime":"2027-02-18T19:00:00","lastInstanceDateTimeUtc":"2027-02-18T19:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Mark Gatiss, Johnny Flynn","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Sam Mendes","attribute_Distributor":"National Theatre","attribute_EventCinema":true,"attribute_FestivalOrSeason":"National Theatre Live","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"15","attribute_SpecialGuestEvent":false,"attribute_Year":"2027","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre1":"","attribute_Genre2":"","attribute_Language":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Shot at night on the rooftops of Tel Aviv, NAZA reveals the systems behind Israel’s bombing of Gaza and its mass killing of Palestinian civilians. The film is directed by Yuval Abraham and Rachel Szor, two of the four co-directors of the 2024 Oscar-winning documentary No Other Land (NYFF62), and produced by the Guardian and James Wilson (JW Films) and executive produced by Jonathan Glazer. Wilson and Glazer are the Oscar-winning team behind The Zone of Interest. NAZA is titled for a military acronym euphemistically used by Israeli intelligence to indicate the number of civilians that it expects will be killed in an airstrike. The film builds on revelations first published by the Israeli-Palestinian publication +972 Magazine, Hebrew-language outlet Local Call, and the Guardian between 2023 and 2025. [New York Film Festival 2026] ","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"NAZA","instanceDates":"16 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"291601ARQSLDHVBLJPNTVSRCKCRHJDMQD","firstInstanceDateTime":"2026-10-16T17:15:00","firstInstanceDateTimeUtc":"2026-10-16T16:15:00Z","lastInstanceDateTime":"2026-10-22T19:45:00","lastInstanceDateTimeUtc":"2026-10-22T18:45:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Yuval Abraham & Rachel Szor","attribute_Distributor":"Dogwoof","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"80","attribute_FilmRating":"TBC","attribute_Genre1":"Documentary","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"In 2001, American Samoa suffered the worst defeat in international football history! Losing an astonishing 31–0 to Australia, a decade later, still regarded as one of the world's worst sides, they bring in down on his luck hot headed coach Thomas Rongen, played by Michael Fassbender, with what seems like a modest ambition: to turn things around and finally score a goal!\r\nFunny, warm and hugely likeable, Next Goal Wins is an underdog story about football, friendship, teamwork and camaraderie.\r\nThese themes are reflected and explored in the work of Community Men2Men Buddying (CM2M), which provides one-to-one buddying for men aged 55+, offering companionship, shared activities and opportunities to get out and enjoy life, whilst providing valuable respite for carers, who can relax safe in the knowledge that their loved ones are well supported.\r\nCM2M is looking to develop its buddying service in Nottingham. Come along, enjoy a great film and discover what CM2M could offer you or someone you care about.\r\nStay around for a lively discussion about why staying connected, maintaining friendships and avoiding isolation matters so much as we get older.\r\nEveryone is welcome to this special screening, created with men in mind.\r\n\r\n12pm to 2.45pm, including a break.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Next Goal Wins: Presented by Ebony Reels and CM2M","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"294401ADVRGSPPSPVMNTDLPNHGSDCKGSJ","firstInstanceDateTime":"2026-10-25T12:00:00","firstInstanceDateTimeUtc":"2026-10-25T12:00:00Z","lastInstanceDateTime":"2026-10-25T12:00:00","lastInstanceDateTimeUtc":"2026-10-25T12:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Michael Fassbender, Oscar Kightley, Kaimana","attribute_CountryOfOrigin":"New Zealand","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Taika Waititi","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Special Events","attribute_Film":true,"attribute_FilmDuration":"104","attribute_FilmRating":"12A","attribute_Genre1":"Comedy","attribute_SpecialGuestEvent":false,"attribute_Year":"2023","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Based on the true story, Lance Oppenheim’s take on the notorious US TV show To Catch A Predator sees host Chris Hanson set out to make television history in 2006, turning an undercover investigation into one of the most controversial cultural phenomena of the decade.","htmlDescription":"<div id>\r\n\r\n</div>","duration":129,"imageUrl":"","isOnSale":true,"name":"Primetime","instanceDates":"30 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"295001AVQJVKBMVGNLCJJSGHJNCRDMHBV","firstInstanceDateTime":"2026-10-30T17:30:00","firstInstanceDateTimeUtc":"2026-10-30T17:30:00Z","lastInstanceDateTime":"2026-11-05T19:45:00","lastInstanceDateTimeUtc":"2026-11-05T19:45:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Robert Pattinson, Merritt Weaver","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Lance Oppenheim","attribute_Distributor":"A24","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"109","attribute_FilmRating":"15","attribute_Genre1":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Out Laws follows three queer activists challenging the laws that criminalise them. From the UK to Namibia, the film reveals how colonial rule entrenched homophobia around the world. Amid rising murders,\r\ncourt battles, church-led backlash and coordinated disinformation campaigns, Out Laws captures a global movement fighting not only for justice, but for survival.\r\n\r\nThis screening will be followed by a Q&A with the filmmakers.\r\n\r\nPresented as part of Queer Up Duck! Festival 2026.","htmlDescription":"<div id>\r\n\r\n</div>","duration":109,"imageUrl":"","isOnSale":true,"name":"Queer Up Duck! Festival: Out Laws + Q&A","instanceDates":"20 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"282001ADLJCDDNRMHQTPLKPVHHTTTVGHP","firstInstanceDateTime":"2026-10-20T18:00:00","firstInstanceDateTimeUtc":"2026-10-20T17:00:00Z","lastInstanceDateTime":"2026-10-20T18:00:00","lastInstanceDateTimeUtc":"2026-10-20T17:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CountryOfOrigin":"UK & Namibia","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Lexi Power & James Lewis","attribute_Distributor":"Queer the Way","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Special Events","attribute_Film":true,"attribute_FilmDuration":"79","attribute_FilmRating":"15","attribute_Genre1":"Documentary","attribute_SpecialGuestEvent":false,"attribute_Year":"2025","attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Set on an isolated island in 18th-century Brittany, the film follows painter Marianne as she is commissioned to secretly paint the wedding portrait of Héloïse. As she studies her subject by day and paints from memory at night, their relationship evolves into a deep intimacy and desire.","htmlDescription":"<div id>\r\n\r\n</div>","duration":141,"imageUrl":"","isOnSale":true,"name":"Queer Up Duck! Festival: Portrait of a Lady on Fire","instanceDates":"2 November-2 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"287401APTKLDBSGKBHBPCMGCRRNCVCHDL","firstInstanceDateTime":"2026-11-02T19:45:00","firstInstanceDateTimeUtc":"2026-11-02T19:45:00Z","lastInstanceDateTime":"2026-11-02T19:45:00","lastInstanceDateTimeUtc":"2026-11-02T19:45:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Noémie Merlant, Adèle Haenel","attribute_CountryOfOrigin":"France","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Celine Sciamma","attribute_Distributor":"Curzon Artificial Eye","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"121","attribute_FilmRating":"15","attribute_Genre1":"Romance","attribute_Language":"French with English Subtitles","attribute_SpecialGuestEvent":false,"attribute_Year":"2019","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"In 1976, Sylvester Stallone stepped into the ring as a plucky, lovable unknown, desperate to take a swing at a chance at Hollywood stardom. Several major awards later, and his character of Rocky Balboa became the go-to movie icon for the underdog succeeding against all the odds.\r\nIn its 50th anniversary year, join us for an affectionate exploration of the story, the character and the films that have driven, inspired and been shaped by this cherished movie. It’s time to go one more round…\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Rocky: The Roots & Legacy of a Boxing Classic","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"258801ASJTPPGSBKTHTGJVDBKVGHJQQJD","firstInstanceDateTime":"2026-11-07T14:00:00","firstInstanceDateTimeUtc":"2026-11-07T14:00:00Z","lastInstanceDateTime":"2026-11-07T14:00:00","lastInstanceDateTimeUtc":"2026-11-07T14:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":true,"attribute_DirectedBy":"Adam Pepper","attribute_Distributor":"Adam Pepper","attribute_EventCinema":false,"attribute_FestivalOrSeason":"One-Day Courses & Workshops","attribute_Film":false,"attribute_FilmRating":"UC","attribute_Genre1":"Film Course","attribute_SpecialGuestEvent":false,"attribute_IVRCode":"","attribute_CastDetails":"","attribute_FilmDuration":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_Year":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Dune: Part Three is set nearly two decades after Paul Atreides seized control of the Imperium. Now a ruthless Emperor, Paul must face the consequences of his reign as old allies return, terrifying new threats emerge, and betrayal lurks in every shadow. Haunted by visions of Imperial collapse and the reappearance of his long-lost love, Paul is drawn into a sweeping conspiracy, with Chani at the heart of its unfolding mystery. As rebellion brews and enemies close in, Paul must confront the true cost of power and the fate of those he loves the most.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":160,"imageUrl":"","isOnSale":true,"name":"See It First – Dune: Part Three","instanceDates":"15 December-15 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"286201ANPSQNNHKSNVGLLRKDRRKMQBRMP","firstInstanceDateTime":"2026-12-15T19:30:00","firstInstanceDateTimeUtc":"2026-12-15T19:30:00Z","lastInstanceDateTime":"2026-12-15T19:30:00","lastInstanceDateTimeUtc":"2026-12-15T19:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Timothee Chalamet, Zendaya, Jason Momoa","attribute_CountryOfOrigin":"US","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Denis Villeneuve","attribute_Distributor":"Warners","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"140","attribute_FilmRating":"TBC","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre1":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Daisy Edgar-Jones stars in this lush new adaptation of Jane Austen’s classic. Sisters Elinor and Marianne Dashwood navigate love, uncertainty and societal pressures in the wake of their father’s death.","htmlDescription":"<div id>\r\n\r\n</div>","duration":151,"imageUrl":"","isOnSale":true,"name":"Sense and Sensibility","instanceDates":"25 September-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"275002ADRKCMHSMVSGDRBDJMRGNHJMRNL","firstInstanceDateTime":"2026-09-25T14:00:00","firstInstanceDateTimeUtc":"2026-09-25T13:00:00Z","lastInstanceDateTime":"2026-10-15T13:15:00","lastInstanceDateTimeUtc":"2026-10-15T12:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Daisy Edgar-Jones, George MacKay","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Georgia Oakley","attribute_Distributor":"Universal","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"131","attribute_FilmRating":"U","attribute_Genre1":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"This screening is presented by Jackie Treehorn as part of their ongoing Heist season, taking place throughout the year at both Broadway and Mammoth. \r\n\r\nA re-release of Jonathan Glazer's mould-breaking, stylish thriller in dazzling new 4K.\r\n\r\nEx-villain Gal Dove (Ray Winstone) has served his time behind bars and is blissfully retired to a Spanish villa paradise with a wife he adores. The idyll is shattered by the arrival of his gangster nemesis Don Logan (Ben Kingsley), intent on persuading Gal to return to London for one last big job. Desperate not to sacrifice his enchanted existence, Dove is drawn into a shocking and explosive battle of wills with Logan, and takes part in a sensational underwater heist, risking everything to protect the woman he loves.","htmlDescription":"<div id>\r\n\r\n</div>","duration":89,"imageUrl":"","isOnSale":true,"name":"Sexy Beast - Presented by Jackie Treehorn","instanceDates":"21 October-21 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"292401ABCGSHTPLQJVLNBNNRJJPVCTQNG","firstInstanceDateTime":"2026-10-21T20:15:00","firstInstanceDateTimeUtc":"2026-10-21T19:15:00Z","lastInstanceDateTime":"2026-10-21T20:15:00","lastInstanceDateTimeUtc":"2026-10-21T19:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Ray Winstone, Ben Kingsley, Amanda Redman","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Jonathan Glazer","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Special Events","attribute_Film":true,"attribute_FilmDuration":"89","attribute_FilmRating":"18","attribute_Genre1":"Crime","attribute_SpecialGuestEvent":false,"attribute_Year":"2000","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Everyone is looking forward to Halloween on Mossy Bottom Farm – until the clumsy Farmer trashes the Flock’s beloved pumpkin patch! But when Shaun turns MAD SCIENTIST to fix the problem, things rapidly spiral out of control. With the Farmer missing and a wild beast roaming the woods of Mossingham, all the ingredients are in place for a monstrously fun family adventure…","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"Shaun the Sheep: The Beast of Mossy Bottom","instanceDates":"23 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"290001AJPSVSDDDSNHSBHSTCBGRHMRTBC","firstInstanceDateTime":"2026-10-23T14:45:00","firstInstanceDateTimeUtc":"2026-10-23T13:45:00Z","lastInstanceDateTime":"2026-10-29T13:30:00","lastInstanceDateTimeUtc":"2026-10-29T13:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Justin Fletcher, John Sparkes, Kate Harbour","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Steve Cox, Matthew Walker","attribute_Distributor":"Studio Canal","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"80","attribute_FilmRating":"U","attribute_Genre1":"Children","attribute_Genre2":"Animation","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Clarence Williams III stars as an eccentric funeral director Mr. Simms who attempts to scare four teenage drug dealers with terrifying cautionary tales. \r\nA certified hood classic. Released during the boom of independent Black cinema in the 1990s, Tales from the Hood is a politically angry anthology with incredible life lessons told in a satirical and brutal way. This title features one of the earliest horror-film depictions of police brutality as a system rather than an individual.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":117,"imageUrl":"","isOnSale":true,"name":"Tales from the Hood","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"284601AGHDRDCMKNVJSMPVSHJRMQJJDDQ","firstInstanceDateTime":"2026-10-24T20:45:00","firstInstanceDateTimeUtc":"2026-10-24T19:45:00Z","lastInstanceDateTime":"2026-10-24T20:45:00","lastInstanceDateTimeUtc":"2026-10-24T19:45:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Clarence Williams III, Joe Torry","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Rusty Cundieff","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Horror Noire","attribute_Film":true,"attribute_FilmDuration":"97","attribute_FilmRating":"18","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"1995","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Presented by Club Jok\r\n\r\nHave you ever wondered what Seven Samurai would look like if it centred around a down-on-its-luck ramen restaurant and its timid yet passionate owner? A masterful blend of film styles, genres, and cultures, Juzo Itami’s cornerstone of Japanese cinema, Tampopo, demonstrates the grit of independent spirit and celebrates the wonderful world of the culinary industry in an effortlessly funny, mind-bogglingly meta, and extrasensory filmic experience.\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":135,"imageUrl":"","isOnSale":true,"name":"Tampopo + Introduction","instanceDates":"24 November-24 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"292601AHDLGGKSRGCLVJLSKBKQSBCJCDH","firstInstanceDateTime":"2026-11-24T19:30:00","firstInstanceDateTimeUtc":"2026-11-24T19:30:00Z","lastInstanceDateTime":"2026-11-24T19:30:00","lastInstanceDateTimeUtc":"2026-11-24T19:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Tsutomu Yamazaki, Nobuko Miyamoto, Koji Yakusho","attribute_CountryOfOrigin":"Japan","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Juzo Itami","attribute_Distributor":"Janus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Special Events","attribute_Film":true,"attribute_FilmDuration":"115","attribute_FilmRating":"15","attribute_Genre1":"Cult Film","attribute_Language":"Japanese with English Subtitles","attribute_SpecialGuestEvent":false,"attribute_Year":"1988","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Wilder’s much-lauded classic is a film of contradictions: a romantic comedy about suicide and adultery, at once glaringly ‘Hollywood’ yet relatably mundane. Everyman CC Baxter lives a banal existence filled with sacrifice in pursuit of ambition, enlivened only by the vibrant charm of an errant elevator operator. Balancing quips with existential crises, it will break your heart and warm it all at once. –BFI","htmlDescription":"<div id>\r\n\r\n</div>","duration":145,"imageUrl":"https://system.spektrix.com/broadwaynottingham/files/23e311b8-ca71-4207-a3d6-74427874c1a0.jpg","isOnSale":true,"name":"The Apartment","instanceDates":"20 December-31 December","thumbnailUrl":"https://system.spektrix.com/broadwaynottingham/files/23e311b8-ca71-4207-a3d6-74427874c1a0-thumbnail.jpg","webUrl":"","webEventId":null,"id":"11401ADJMJHLSTCBJCSJGTJRVLDRSDLQV","firstInstanceDateTime":"2023-12-20T19:45:00","firstInstanceDateTimeUtc":"2023-12-20T19:45:00Z","lastInstanceDateTime":"2026-12-31T13:00:00","lastInstanceDateTimeUtc":"2026-12-31T13:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Jack Lemmon, Shirley Maclaine, Fred MacMurray","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Billy Wilder","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"125","attribute_FilmRating":"PG","attribute_Genre1":"Classics","attribute_SpecialGuestEvent":false,"attribute_Year":"1960","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_AudioDescribed":false,"attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"The students of Barton Academy depart for the winter holidays, leaving behind a ragtag bunch with nowhere to go, whose ‘babysitter’ is the cantankerous Professor Hunham. But as the days pass, the grumpy professor forms an unexpected bond with student Angus and the school’s cook, Mary, who is grieving the loss of her son. Alexander Payne reunites with his Sideways star Paul Giamatti in a film that strikes the perfect balance between pathos and playfulness. –LFF","htmlDescription":"<div id>\r\n\r\n</div>","duration":153,"imageUrl":"https://system.spektrix.com/broadwaynottingham/files/44f13f67-5ef4-494b-b320-5885693dd54d.jpg","isOnSale":true,"name":"The Holdovers","instanceDates":"19 December-18 December","thumbnailUrl":"https://system.spektrix.com/broadwaynottingham/files/44f13f67-5ef4-494b-b320-5885693dd54d-thumbnail.jpg","webUrl":"","webEventId":null,"id":"19402ARTDGVRDMVTMJJRBSCSHVCVTKCJB","firstInstanceDateTime":"2025-12-19T15:00:00","firstInstanceDateTimeUtc":"2025-12-19T15:00:00Z","lastInstanceDateTime":"2026-12-18T20:00:00","lastInstanceDateTimeUtc":"2026-12-18T20:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Paul Giamatti, Dominic Sessa, Da’Vine Joy Randolph","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Alexander Payne","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"133","attribute_FilmRating":"15","attribute_Genre1":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2023","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"A beloved holiday favourite regularly ranked among the greatest Christmas films of all time, The Muppet Christmas Carol is sure to delight audiences and generations for decades to come. With a terrific central performance from Michael Caine as Ebenzer Scrooge and a cavalcade of much-loved musical numbers, this raucous retelling of the Charles Dickens story is a Christmas classic not to be missed.","htmlDescription":"<div id>\r\n\r\n</div>","duration":109,"imageUrl":"https://system.spektrix.com/broadwaynottingham/files/e2534893-f2e3-4b62-8e78-f9d081bd93aa.jpg","isOnSale":true,"name":"The Muppet Christmas Carol","instanceDates":"20 December-24 December","thumbnailUrl":"https://system.spektrix.com/broadwaynottingham/files/e2534893-f2e3-4b62-8e78-f9d081bd93aa-thumbnail.jpg","webUrl":"","webEventId":null,"id":"10801ADHCBQTDNRNBLLTSCPBVDKMJGHCJ","firstInstanceDateTime":"2025-12-20T15:30:00","firstInstanceDateTimeUtc":"2025-12-20T15:30:00Z","lastInstanceDateTime":"2026-12-24T10:00:00","lastInstanceDateTimeUtc":"2026-12-24T10:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Michael Caine, Dave Goelz, Steve Whitmire","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Brian Henson","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"89","attribute_FilmRating":"U","attribute_Genre1":"Animation","attribute_Genre2":"Children","attribute_SpecialGuestEvent":false,"attribute_Year":"1992","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"A beloved festive favourite regularly ranked among the greatest Christmas films of all time, The Muppet Christmas Carol is sure to delight audiences and generations for decades to come. With a terrific central performance from Michael Caine as Ebenezer Scrooge and a cavalcade of much-loved musical numbers, this raucous retelling of the Charles Dickens story is a Christmas classic not to be missed.","htmlDescription":"<div id>\r\n\r\n</div>","duration":109,"imageUrl":"","isOnSale":true,"name":"The Muppet Christmas Carol - Pay What You Feel","instanceDates":"20 December-20 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"107802ANRBQQDTQCGRMJNPRCHSVLSGQCB","firstInstanceDateTime":"2025-12-20T12:45:00","firstInstanceDateTimeUtc":"2025-12-20T12:45:00Z","lastInstanceDateTime":"2025-12-20T12:45:00","lastInstanceDateTimeUtc":"2025-12-20T12:45:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Michael Caine, Dave Goelz, Steve Whitmire","attribute_CountryOfOrigin":"USA/UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Brian Henson","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"89","attribute_FilmRating":"U","attribute_Genre1":"Classics","attribute_Genre2":"Children","attribute_SpecialGuestEvent":false,"attribute_Year":"1992","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"We know you know the words, and we invite you to sing loud and proud at our special screening of this much-loved festive favourite.\r\nFollowing along with the lyrics on screen, we will  “whooo” along with Marley and Marley, and join Kermet as he declares there’s “only one more sleep ‘til Christmas”. \r\n \r\nWe will be joined by Pipes, a judgement-free, non-audition social singing group for adults focusing on millennial R&B, pop, Disney, and throwback hits. Pipes will guide us through a fun warm up to loosen our vocal cord and inhibitions and then lead the singing throughout to ensure you’ll never be the only one crooning along!\r\n\r\nA beloved holiday favourite regularly ranked among the greatest Christmas films of all time, The Muppet Christmas Carol is sure to delight audiences and generations for decades to come. With a terrific central performance from Michael Caine as Ebenzer Scrooge and a cavalcade of much-loved musical numbers, this raucous retelling of the Charles Dickens story is a Christmas classic not to be missed. \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":109,"imageUrl":"","isOnSale":true,"name":"The Muppet Christmas Carol - Sing Along","instanceDates":"19 December-19 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"296201AKNMSNHSHDDTDCHQPVTTVKJBMNJ","firstInstanceDateTime":"2026-12-19T13:00:00","firstInstanceDateTimeUtc":"2026-12-19T13:00:00Z","lastInstanceDateTime":"2026-12-19T13:00:00","lastInstanceDateTimeUtc":"2026-12-19T13:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Michael Caine, Dave Goelz, Steve Whitmire","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Brian Henson","attribute_Distributor":"Disney","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"89","attribute_FilmRating":"U","attribute_Genre1":"Animation","attribute_Genre2":"Children","attribute_SpecialGuestEvent":false,"attribute_Year":"1992","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Nicole Kidman stars in this classic gothic thriller. On Jersey in 1945, a hyper-protective mother shields her two children away in a grand but dark mansion, claiming they possess an allergy-like disease to sunlight. While waiting for her husband (Christopher Eccleston) to return home from the war, she becomes convinced her house is haunted.","htmlDescription":"<div id>\r\n\r\n</div>","duration":124,"imageUrl":"","isOnSale":true,"name":"The Others - 25th Anniversary","instanceDates":"20 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"289001AHTKCJPCPNDKGTJLCKTBDSNCMPJ","firstInstanceDateTime":"2026-10-20T20:30:00","firstInstanceDateTimeUtc":"2026-10-20T19:30:00Z","lastInstanceDateTime":"2026-10-22T17:15:00","lastInstanceDateTimeUtc":"2026-10-22T16:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Nicole Kidman, Christopher Eccleston, Fionnula Flanagan","attribute_CountryOfOrigin":"Spain/US","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Alejandro Amenábar","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"104","attribute_FilmRating":"12A","attribute_Genre1":"Drama","attribute_Genre2":"Cult Film","attribute_SpecialGuestEvent":false,"attribute_Year":"2001","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Trapped inside a fortified home owned by a mysterious couple, a young boy quickly learns the true nature of the homicidal inhabitants, and secret creatures hidden deep within the walls.\r\nDirected by Wes Craven and inspired by a real news story. Then People Under the Stairs was one of the first horror films to explicitly tackle gentrification and housing inequality for Black folks. The villains in this story embody predatory systems in capitalism and white supremacy. It’s arguably Craven’s strongest political messaging in film; its protagonist, Fool, is one of the most resourceful horror heroes of the era and set the tone for resilience against odds. Director Jordan Peele has repeatedly cited the film as an influence for him. \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":118,"imageUrl":"","isOnSale":true,"name":"The People Under the Stairs","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"284801APKNCHRSQLSBQTTPRKNRBHQMBJG","firstInstanceDateTime":"2026-10-31T20:30:00","firstInstanceDateTimeUtc":"2026-10-31T20:30:00Z","lastInstanceDateTime":"2026-10-31T20:30:00","lastInstanceDateTimeUtc":"2026-10-31T20:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Brandon Adams, Everett McGill","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Wes Craven","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Horror Noire","attribute_Film":true,"attribute_FilmDuration":"98","attribute_FilmRating":"15","attribute_Genre1":"Horror","attribute_SpecialGuestEvent":false,"attribute_Year":"1991","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Step aboard the magical Polar Express and experience an enchanting, immersive screening that will captivate the whole family. This special Christmas event brings the beloved story of The Polar Express to life in a winter wonderland Screen 1. \r\nEarly booking recommended as this magical event is sure to sell out.\r\nTickets: £25 children / £10 accompanying adults\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"The Polar Express – Santa Extravaganza","instanceDates":"13 December-13 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"193601AGSTTQMTKTKNBLKLRDRSGHPGQVR","firstInstanceDateTime":"2025-12-13T10:00:00","firstInstanceDateTimeUtc":"2025-12-13T10:00:00Z","lastInstanceDateTime":"2026-12-13T10:00:00","lastInstanceDateTimeUtc":"2026-12-13T10:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Tom Hanks, Chris Coppola","attribute_CountryOfOrigin":"USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Robert Zemeckis","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"180","attribute_FilmRating":"U","attribute_Genre1":"Animation","attribute_Genre2":"Children","attribute_SpecialGuestEvent":false,"attribute_Year":"2003","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"In tribute to the late, great Tim Curry, we invite you up to the Screen 1 Lab., for the ultimate interactive film event: The Rocky Horror Picture Show. \r\nReturning as our fabulous host, the \"broadest broad of Broad Street” – local drag legend, Liv!\r\n\r\nReleased in 1975, Richard O’Brien’s love-letter to science-fiction and the horror B-movies of the 1930-60s, the film has become famous for its midnight screenings and audience participation, inspiring community, self-expression, and scores of Creatures of the Night to express themselves authentically. We will celebrate the life and work of Tim Curry, revelling in his defining role as Frank-N-Furter.\r\n\r\nWhat to expect: Your glamorous host, Liv, will be on hand to get you loosened up and amply prepped before we dive stiletto-first into this kitsch classic.\r\nOutfits are highly encouraged, and you’ll have an opportunity to strut your stuff for all to enjoy.\r\n\r\nProp bags will be provided and contain all the items you’ll need to interact with the on-screen action. (Please note the following are not permitted: rice, water pistols, toast) \r\nAll participation is voluntary and there will be no forced fun or virgin rituals!\r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":100,"imageUrl":"","isOnSale":true,"name":"The Rocky Horror Picture Show ","instanceDates":"8 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"191201ANPMKHDGNNHMNMTTCMDPCQBRGKV","firstInstanceDateTime":"2025-11-08T20:30:00","firstInstanceDateTimeUtc":"2025-11-08T20:30:00Z","lastInstanceDateTime":"2026-11-07T20:30:00","lastInstanceDateTimeUtc":"2026-11-07T20:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Tim Curry, Susan Sarandon","attribute_CountryOfOrigin":"UK/USA","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Jim Sharman","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Special Events","attribute_Film":true,"attribute_FilmDuration":"100","attribute_FilmRating":"15","attribute_Genre1":"Musical","attribute_Genre2":"Cult Film","attribute_SpecialGuestEvent":false,"attribute_Year":"1975","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Following up on The Social Network, and based on real-life events. Aaron Sorkin (The West Wing) directs the eye-opening whistleblowing behind The Wall Street Journal’s exposé, The Facebook Files. Mikey Madison stars in her first role since her Oscar-winning performance in Anora, as a Facebook engineer working with reporter Jeff Horwitz (Jeremy Allen White) to uncover dangerous truths in the website’s code.","htmlDescription":"<div id>\r\n\r\n</div>","duration":132,"imageUrl":"","isOnSale":true,"name":"The Social Reckoning","instanceDates":"9 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"288003ATRLQVLSHJKBJJCBNVLNHPCLMBG","firstInstanceDateTime":"2026-10-09T14:00:00","firstInstanceDateTimeUtc":"2026-10-09T13:00:00Z","lastInstanceDateTime":"2026-10-15T20:00:00","lastInstanceDateTimeUtc":"2026-10-15T19:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Jeremy Allen White, Betty Gilpin, Mikey Madison","attribute_CountryOfOrigin":"US","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Aaron Sorkin","attribute_Distributor":"Sony","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"112","attribute_FilmRating":"15","attribute_Genre1":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"4 x 3 hour sessions:\r\nSat 29 Aug 2026\r\nSat 26 Sep 2026\r\nSat 24 Oct 2026\r\nSat 21 Nov 2026\r\n\r\n\r\nMaking a film is only half the challenge. The other half is getting people to watch it.\r\n \r\nWhether you have made a film at university or independently, one of the biggest obstacles filmmakers face is finding an audience, securing screenings and creating a marketing strategy that gives the film a life beyond the edit suite.\r\n \r\nThis unique four-part course explores the practical realities of film distribution and audience development. Learn how to build viewership whilst making your film, create effective trailers and posters, organise screenings, approach cinemas, generate reviews and from screenings into effective social media content.\r\n \r\nDrawing on their experiences, having taken two independent documentaries to cinemas across the UK and abroad including OTT platforms, Filmmaker and Barrister Haresh Sood and Editor Will Silvester, will teach lessons on mistakes and strategies they wish they had known when they started.\r\n \r\nThis is a unique filmmaking course that begins where most film courses end.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Things You Never Got Taught at Film School","instanceDates":"29 August-21 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"255601AQLNBMJBMCBPPBSJRVRSSSCNLSR","firstInstanceDateTime":"2026-08-29T14:00:00","firstInstanceDateTimeUtc":"2026-08-29T13:00:00Z","lastInstanceDateTime":"2026-11-21T14:00:00","lastInstanceDateTimeUtc":"2026-11-21T14:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CreateAndLearn":true,"attribute_DirectedBy":"Haresh Sood","attribute_Distributor":"Haresh Sood","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Weekly Film Courses","attribute_Film":false,"attribute_FilmDuration":"180","attribute_FilmRating":"UC","attribute_Genre1":"Film Course","attribute_SpecialGuestEvent":false,"attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_Year":"","attribute_CountryOfOrigin":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"King of the Jews\r\nWhen Alice and Benj’s eight-year-old Jewish son, Ezra, is cast as King Herod in his school Nativity, the couple clash over whether to intervene. The debate escalates as the two argue over who has final say in an interfaith family. Benj, playing the ‘Jewish card’, insists they should stay out of it, scarred by memories of his own overbearing parents, that is, until he sees Ezra’s gleefully murderous rehearsal.\r\nFish, Chips & Faith\r\nFish, Chips & Faith tells the uplifting story of a Leeds restaurant bringing communities together by serving Kosher and Halal food under one roof.\r\nRambling\r\nOver the last 50 years The Pennine Wayfarers have become a community all of their own. Combining friendship and adventure, they travel a route that resonates with British-Jewish history.\r\nRachel Jones Needs a Boyfriend not a Bat-Mitzvah\r\nRachel Jones follows a young Welsh Jewish girl on her quest for a boyfriend, while also trying to prepare for her upcoming Bat Mitzvah.\r\nThe Last Jewel\r\nAt 89, Joseph Ullmann keeps the tradition of his grandfather’s Budapest antique jewellery business alive. In today’s Hatton Garden, he and his shop are the last of their kind.\r\nThe Dead Parent Club\r\nOllie’s dad has unexpectedly died, and neither is ready to let go. With an unlikely sidekick, Ollie embarks on a chaotic, thoughtful quest for peace.\r\nOslo Court\r\nA film about the 1970s-style London restaurant, Oslo Court, and its cultural importance to the Jewish community, with waiter, Neil, at its beating heart.\r\nMizrahi Mismatch\r\nJudith and Menahem met in 1959, and wed within weeks. They are fire and water, ghormeh sabzi and gachun, yet somehow have survived 67 years together.\r\nThe Goyfriend\r\nAviva is excited to bring James to his first Passover Seder, until her parents admit that grandma has no idea that her potential future grandson-in-law isn’t Jewish. Determined to keep the peace, Aviva’s family attempt to pass James off as ‘one of us’.\r\n\r\nQ&A (30mins) \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":109,"imageUrl":"","isOnSale":true,"name":"UK Jewish Film Festival:  British-Jewish Life on Film: Nottingham + Q&A","instanceDates":"22 November-22 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"295801AMRVPHHBVHVNNMRQQSMVNNKBDJT","firstInstanceDateTime":"2026-11-22T17:30:00","firstInstanceDateTimeUtc":"2026-11-22T17:30:00Z","lastInstanceDateTime":"2026-11-22T17:30:00","lastInstanceDateTimeUtc":"2026-11-22T17:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Various","attribute_Distributor":"UK Jewish Film Festival","attribute_EventCinema":false,"attribute_FestivalOrSeason":"UK Jewish Film Festival","attribute_Film":true,"attribute_FilmDuration":"79","attribute_FilmRating":"UC","attribute_Genre1":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_CastDetails":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"A beautiful portrayal of young love swept up by the dark tides of history, and a remarkable cinematic depiction of sound. In May 1940, German forces are massing along the borders of Belgium, Luxembourg, and the Netherlands. At a Brussels radio station, Elza (Femke Vanhove) is a talented young voice actor. She’s also, secretly, a Jewish refugee from Vienna. Meanwhile, Berre (Jef Hellemans) is an innovative introverted sound engineer, who creates the sound effects for the station’s radio plays. The two fall deeply in love, but as war looms, and Elza’s true identity is exposed, their relationship is put to the ultimate test.\r\n\r\n“This film is a standout: meditative, innovative, and profoundly moving.” – Hollywood Times \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"UK Jewish Film Festival: The Soundman","instanceDates":"15 November-15 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"295601ARRDRDQVHBPHBKQLQLPQQNJRMTC","firstInstanceDateTime":"2026-11-15T17:30:00","firstInstanceDateTimeUtc":"2026-11-15T17:30:00Z","lastInstanceDateTime":"2026-11-15T17:30:00","lastInstanceDateTimeUtc":"2026-11-15T17:30:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Femke Vanhove, Jef Hellemans","attribute_CountryOfOrigin":"Belgium","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Frank van Passel","attribute_Distributor":"UK Jewish Film Festival","attribute_EventCinema":false,"attribute_FestivalOrSeason":"UK Jewish Film Festival","attribute_Film":true,"attribute_FilmDuration":"120","attribute_FilmRating":"TBC","attribute_Genre1":"Drama","attribute_Language":"Dutch, Hebrew with English subtitles","attribute_SpecialGuestEvent":false,"attribute_Year":"2025","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"Adapted from Colleen Hoover's best-selling novel, this seductive, psychological thriller follows renowned author Verity Crawford (Anne Hathaway) and Lowen Ashleigh (Dakota Johnson), a struggling writer who relocates to the remote Crawford estate to ghostwrite for Verity. After Lowen uncovers what appears to be Verity's chilling autobiographical notes, she wrestles with the disturbing and twisted confessions about Verity’s husband Jeremy (Josh Hartnett), and finds it hard to separate fiction from reality, manipulation from attraction, and opportunity from obsession.","htmlDescription":"<div id>\r\n\r\n</div>","duration":137,"imageUrl":"","isOnSale":true,"name":"Verity","instanceDates":"2 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"288002ANJLMBQMSHSTBJGPMQDQVGNQQBK","firstInstanceDateTime":"2026-10-02T14:30:00","firstInstanceDateTimeUtc":"2026-10-02T13:30:00Z","lastInstanceDateTime":"2026-10-15T20:15:00","lastInstanceDateTimeUtc":"2026-10-15T19:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Anne Hathaway, Dakota Johnson, Josh Hartnett","attribute_CountryOfOrigin":"US","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Michael Showalter","attribute_Distributor":"Sony","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"117","attribute_FilmRating":"15","attribute_Genre1":"Drama","attribute_Genre2":"Romance","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"A whip-smart rom-com gem written by the great Nora Ephron, When Harry Met Sally begins as the fast-talking Harry shares a drive from Chicago to New York with no-nonsense Sally. Over the course of the journey, and the subsequent years, the two become close friends until eventually realising they may have found the one in each other.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":112,"imageUrl":"","isOnSale":true,"name":"When Harry Met Sally","instanceDates":"31 December-31 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"16001ARGQQRHSBPHJPVSHSDBVGRTHPBSV","firstInstanceDateTime":"2024-12-31T17:00:00","firstInstanceDateTimeUtc":"2024-12-31T17:00:00Z","lastInstanceDateTime":"2026-12-31T17:00:00","lastInstanceDateTimeUtc":"2026-12-31T17:00:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Billy Crystal, Meg Ryan, Carrie Fisher","attribute_CountryOfOrigin":"United States","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Rob Reiner","attribute_Distributor":"Park Circus","attribute_EventCinema":false,"attribute_FestivalOrSeason":"Christmas","attribute_Film":true,"attribute_FilmDuration":"92","attribute_FilmRating":"15","attribute_Genre1":"Comedy","attribute_SpecialGuestEvent":false,"attribute_Year":"1989","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Genre2":"","attribute_Language":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"After a reclusive fisherwoman is ostracised for her repulsive smell, she sarcastically commissions a husband handwoven out of wicker, only for him to magically come alive. The couple’s romance becomes the talk of their medieval town, before becoming chaos for everyone involved.","htmlDescription":"<div id>\r\n\r\n</div>","duration":125,"imageUrl":"","isOnSale":true,"name":"Wicker","instanceDates":"30 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"290601ARDTDMBSSDDVQLCPMCKGCPVKSQR","firstInstanceDateTime":"2026-10-30T15:15:00","firstInstanceDateTimeUtc":"2026-10-30T15:15:00Z","lastInstanceDateTime":"2026-11-05T20:15:00","lastInstanceDateTimeUtc":"2026-11-05T20:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"Olivia Colman, Alexander Skarsgård","attribute_CountryOfOrigin":"UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Alex Huston Fischer, Eleanor Wilson","attribute_Distributor":"Black Bear","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"105","attribute_FilmRating":"TBC","attribute_Genre1":"Comedy","attribute_Genre2":"Drama","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"John Malkovich and Sam Rockwell star in director Martin McDonaugh’s (The Banshees of Inisherin) latest caper – as a pair of CIA agents wrestling with their dark pasts and present conspiracies on Easter Island before the 1973 Chilean coup.","htmlDescription":"<div id>\r\n\r\n</div>","duration":138,"imageUrl":"","isOnSale":true,"name":"Wild Horse Nine","instanceDates":"6 November-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"295201AGGVRGBRBTMLVPHDGVNDSSKRLTQ","firstInstanceDateTime":"2026-11-06T14:30:00","firstInstanceDateTimeUtc":"2026-11-06T14:30:00Z","lastInstanceDateTime":"2026-11-12T20:15:00","lastInstanceDateTimeUtc":"2026-11-12T20:15:00Z","altText":"","attribute_ArtsAndTechnology":false,"attribute_AudioDescribed":false,"attribute_CafeBarEvent":false,"attribute_CastDetails":"John Malkovich, Sam Rockwell","attribute_CountryOfOrigin":"USA/UK","attribute_CreateAndLearn":false,"attribute_DirectedBy":"Martin McDonagh","attribute_Distributor":"Searchlight","attribute_EventCinema":false,"attribute_Film":true,"attribute_FilmDuration":"118","attribute_FilmRating":"15","attribute_Genre1":"Drama","attribute_Genre2":"Comedy","attribute_SpecialGuestEvent":false,"attribute_Year":"2026","attribute_IVRCode":"","attribute_WebImportId":"","attribute_Language":"","attribute_FestivalOrSeason":"","attribute_DotdigitalEventField1":"","attribute_DotdigitalEventField2":"","attribute_DotdigitalEventField3":""},{"description":"From the makers of Coraline, Wildwood is a sweeping, darkly magical adventure about Prue, a young girl who journeys into a hidden forest to rescue her younger brother. Along the way she encounters warring factions, extraordinary creatures, and a world unlike anything she's ever known.","htmlDescription":"<div id>\r\n\r\n</div>","duration":152,"imageUrl":"","isOnSale":true,"name":"Wildwood","instanceDates":"23 October-29 October","thumbnailUrl":""