[{"description":"Age 10+ with adult accompanying, Discovery Film Festival workshop inspired by film Olivia and the Invisible Earthquake. learn how to make a 3D model for stop motion animation. \r\n\r\nWe will have lots of materials and tried and tested models to follow.","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"3D Character Creation Workshop","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"978632APSVGBTPRDPSCJMCHKCGVBBCVNM","firstInstanceDateTime":"2026-10-31T11:30:00","firstInstanceDateTimeUtc":"2026-10-31T11:30:00Z","lastInstanceDateTime":"2026-10-31T11:30:00","lastInstanceDateTimeUtc":"2026-10-31T11:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Give letterpress a try with an easy to use, table top press. Adana Letterpress Machines revolutionised letterpress and moveable type and have been used for printing by professionals and hobbyists for over 100 years. This class is perfect for anyone wanting to learn some simple desktop publishing. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Adana Press: Desktop Letterpress (February 2027)","instanceDates":"4 February-4 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955637ALRDHHVJNSQTPPRJJBBQCRBTBLQ","firstInstanceDateTime":"2027-02-04T18:00:00","firstInstanceDateTimeUtc":"2027-02-04T18:00:00Z","lastInstanceDateTime":"2027-02-04T18:00:00","lastInstanceDateTimeUtc":"2027-02-04T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Give letterpress a try with an easy to use, table top press. Adana Letterpress Machines revolutionised letterpress and moveable type and have been used for printing by professionals and hobbyists for over 100 years. This class is perfect for anyone wanting to learn some simple desktop publishing. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Adana Press: Desktop Letterpress (October 2026)","instanceDates":"22 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955433ALKTJJJTMHSJVVDPBVJGSRQCNDC","firstInstanceDateTime":"2026-10-22T18:00:00","firstInstanceDateTimeUtc":"2026-10-22T17:00:00Z","lastInstanceDateTime":"2026-10-22T18:00:00","lastInstanceDateTimeUtc":"2026-10-22T17:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to use aquatinting techniques to create tonal prints. This three-evening course teaches you how to apply hand painted tonal marks to metal etching plates, demonstrating how to create layers of tone to illuminate your drawn etched lines. An ideal follow up class for those who have already completed Introduction to Etching, or for artists wanting to refresh their intaglio skills.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Aquatint Etching (March 2027)","instanceDates":"11 March-11 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958633AGQDSRDLPCPMLJBJHCLLJKDPVRH","firstInstanceDateTime":"2027-03-11T18:00:00","firstInstanceDateTimeUtc":"2027-03-11T18:00:00Z","lastInstanceDateTime":"2027-03-11T18:00:00","lastInstanceDateTimeUtc":"2027-03-11T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to use aquatinting techniques to create tonal prints. This three-evening course teaches you how to apply hand painted tonal marks to metal etching plates, demonstrating how to create layers of tone to illuminate your drawn etched lines. An ideal follow up class for those who have already completed Introduction to Etching, or for artists wanting to refresh their intaglio skills.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Aquatint Etching (November 2026)","instanceDates":"10 November-10 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955633ANTMSLJNNVBHVPVQKLCTDTBLNNP","firstInstanceDateTime":"2026-11-10T18:00:00","firstInstanceDateTimeUtc":"2026-11-10T18:00:00Z","lastInstanceDateTime":"2026-11-10T18:00:00","lastInstanceDateTimeUtc":"2026-11-10T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: U / Director: Sarah Smith / Country: USA/ UK / Year: 2011 / Duration: 1h 37m  \r\n\r\nCelerbating its 15th anniversary this year, Arthur Christmas was Aardman’s highly ambitious second CGI animated feature film. Featuring the voices of James McAvoy, Hugh Laurie, Bill Nighy, Jim Broadbent, Imelda Staunton, and Ashley Jensen, the film was a co-production between Sony Pictures Entertainment and Aardman Animations. \r\n\r\nHow CAN Santa deliver billions of presents to the whole world in just one night? With an army of one million combat-style Field Elves and a vast, state-of-the-art control centre under the ice of the North Pole! So how could this incredible mission have MISSED one child?! To Santa’s young son, Arthur, it threatens to end the magic of Christmas. With retired Grandsanta, a rebellious elf, and old sleigh and some untrained reindeer, Arthur sets out on a crazy mission to deliver the last present. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":97,"imageUrl":"","isOnSale":true,"name":"Arthur Christmas (15th Anniversary)","instanceDates":"19 December-24 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982632AJNNMPHGBDGCSTTBKQDKSQGJKSP","firstInstanceDateTime":"2026-12-19T12:30:00","firstInstanceDateTimeUtc":"2026-12-19T12:30:00Z","lastInstanceDateTime":"2026-12-24T12:00:00","lastInstanceDateTimeUtc":"2026-12-24T12:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Christmas","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18 \r\nDirectors: Richard Brooks \r\nCountry: USA  \r\nYear: 1977 \r\nDuration: 2h 16m \r\nDistributor: Park Circus\r\n\r\nDiane Keaton stars in this provocative and disturbing film from 1977, the same year as her star-making turn in Annie Hall. The film is based on the 1975 novel of the same name by Judith Rossner, which in turn was inspired by real-life events.  \r\n\r\nKeaton plays Theresa Dunn, a charismatic and dedicated schoolteacher who spends her nights cruising bars, looking for men with whom she can engage in progressively violent sexual encounters. The film also features early roles for Richard Gere, Tom Berenger, and LeVar Burton. Keaton gives an utterly fearless performance, there is an intoxicating nocturnal atmosphere, while the whole thing culminates in a harrowing ending.","htmlDescription":"<div id>\r\n\r\n</div>","duration":136,"imageUrl":"","isOnSale":true,"name":"Artist's Choice Screening: Looking for Mr. Goodbar (35mm)","instanceDates":"20 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"947433ATGQGBPKRCTSNDGVBTBGNMSCKLB","firstInstanceDateTime":"2026-10-20T20:00:00","firstInstanceDateTimeUtc":"2026-10-20T19:00:00Z","lastInstanceDateTime":"2026-10-20T20:00:00","lastInstanceDateTimeUtc":"2026-10-20T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Artist's Choice Screenings","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn how to process your black and white film, make contact sheets and explore black and white printing. Bring an exposed 35mm Ilford FP4 or HP5 film with you and our expert tutor will teach you all the stages of film development, including developing and fixing your photographic prints. You will be working in a darkroom in very low-level lighting (red safe light) and complete darkness. If you think you may find this difficult let the tutor know beforehand, most people adjust very quickly though. You should leave with some good photographs and a feeling of achievement.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Black and White Photography: Darkroom for Beginners (December 2026)","instanceDates":"5 December-5 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957432ATLBKSMCKCQVHMQKDBLJPTPVTRR","firstInstanceDateTime":"2026-12-05T12:00:00","firstInstanceDateTimeUtc":"2026-12-05T12:00:00Z","lastInstanceDateTime":"2026-12-05T12:00:00","lastInstanceDateTimeUtc":"2026-12-05T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to process your black and white film, make contact sheets and explore black and white printing. Bring an exposed 35mm Ilford FP4 or HP5 film with you and our expert tutor will teach you all the stages of film development, including developing and fixing your photographic prints. You will be working in a darkroom in very low-level lighting (red safe light) and complete darkness. If you think you may find this difficult let the tutor know beforehand, most people adjust very quickly though. You should leave with some good photographs and a feeling of achievement.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Black and White Photography: Darkroom for Beginners (March 2027)","instanceDates":"20 March-20 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"959832AKRJCCPCMRTHCCHBCCCQQLVKMBS","firstInstanceDateTime":"2027-03-20T12:00:00","firstInstanceDateTimeUtc":"2027-03-20T12:00:00Z","lastInstanceDateTime":"2027-03-20T12:00:00","lastInstanceDateTimeUtc":"2027-03-20T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"DCA is the new home of Breast Buddies Dundee. \r\n\r\nThis group offers a nurturing, non-judgmental space for mums and mums-to-be to come along with their bumps and babies. Join us to socialise, meet new friends and get breastfeeding and infant feeding support.\r\nThis friendly group offers a safe place to speak openly about challenges and feel supported by your peers.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Breast Buddies Dundee","instanceDates":"23 June-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"798232AJTBSHLNVHBLVLDPNPGMGVJSMHG","firstInstanceDateTime":"2025-06-23T13:00:00","firstInstanceDateTimeUtc":"2025-06-23T12:00:00Z","lastInstanceDateTime":"2026-10-29T13:00:00","lastInstanceDateTimeUtc":"2026-10-29T13:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: U / Directors: Steve Cox & Matthew Walker / Country: UK/ France/ USA / Year: 2026 / Duration: 1h20m \r\n\r\nTo celebrate 50 years of the iconic and influential Aardman Animations studio, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nShaun the Sheep: The Beast of Mossy Bottom sees the residents of Mossy Bottom Farm looking forward to Halloween – until the clumsy Farmer trashes the Flock’s beloved pumpkin patch! When Shaun turns mad scientist to fix the problem, things rapidly spiral out of control... With The Farmer missing and a wild beast roaming the woods of Mossingham, all the ingredients are in place for a monstrously fun family adventure. \r\n\r\nThe film is the third stop motion animated feature film from Aardman’s globally loved brand, following Shaun the Sheep Movie (2015) and A Shaun the Sheep Movie: Farmageddon (2019). ","htmlDescription":"<div id>\r\n\r\n</div>","duration":81,"imageUrl":"","isOnSale":true,"name":"Bring a Baby: Shaun the Sheep: The Beast of Mossy Bottom ","instanceDates":"15 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"976832ATPGBTVHLQHNBRMVSLPDJGDSPLH","firstInstanceDateTime":"2026-10-15T10:30:00","firstInstanceDateTimeUtc":"2026-10-15T09:30:00Z","lastInstanceDateTime":"2026-10-15T10:30:00","lastInstanceDateTimeUtc":"2026-10-15T09:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Bring a Baby","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: U / Director: Yoshifumi Kondō / Country: Japan / Year: 1995 / Duration: 1h51m \r\n\r\nDiscover the brilliance of this heartwarming coming-of-age classic from the legendary Studio Ghibli, creators of My Neighbour Totoro and the Academy Award®-winning Spirited Away. \r\n\r\nA chance encounter with a mysterious cat sends Shizuku, a girl with her head in the clouds, on a quest for her true talent. Together with Seiji, a boy determined to follow his dreams, and enchanted by The Baron, an antique cat figurine who guides her to listen to the whispers of her heart, Shizuku embarks on a life-changing adventure that takes her beyond the boundaries of her imagination. Based on a screenplay and storyboards from Hayao Miyazaki, WHISPER OF THE HEART is a precious gem in the Studio Ghibli catalogue, directed by veteran animator Yoshifumi Kondo. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":111,"imageUrl":"","isOnSale":true,"name":"Bring a Baby: Whisper of the Heart (English Dub, 4K Restoration)","instanceDates":"22 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980832ALRRRLTMTVQSBGKDMNCBHGMPRQS","firstInstanceDateTime":"2026-10-22T10:30:00","firstInstanceDateTimeUtc":"2026-10-22T09:30:00Z","lastInstanceDateTime":"2026-10-22T10:30:00","lastInstanceDateTimeUtc":"2026-10-22T09:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Bring a Baby","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Travis Knight / Country: USA/ UK/ Canada / Year: 2026 / Duration: 2h12m \r\n\r\nAfter her baby brother is abducted by a murder of crows, headstrong teenager Prue McKeel launches a desperate rescue mission into an enchanted forest hidden just beyond Portland, Oregon. Joined by a hapless but loyal classmate, Prue risks it all as she navigates a world of bandits, talking animals and powerful figures driven by grief and ambition. \r\n\r\nThis breathtaking, hugely ambitious new film from LAIKA Studios (Coraline, Kubo and the Two Strings) is a masterpiece of stop-motion storytelling on an epic scale and quite unlike anything previously seen. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":132,"imageUrl":"","isOnSale":true,"name":"Bring a Baby: Wildwood","instanceDates":"29 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"979833AHMSLJSTRMCCQVTTVGHBKGRJDQL","firstInstanceDateTime":"2026-10-29T10:30:00","firstInstanceDateTimeUtc":"2026-10-29T10:30:00Z","lastInstanceDateTime":"2026-10-29T10:30:00","lastInstanceDateTimeUtc":"2026-10-29T10:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Bring a Baby","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Dominik Moll / Country: France / Year: 2025 / Duration: 2h2m / \r\nLanguage: French with English subtitles  \r\n\r\nSet against the backdrop of mass protests in Paris, Case 137 follows Stéphanie, a meticulous internal affairs investigator working on the case of a teenager severely wounded by police fire. As she searches for the truth her inquiry collides with institutional resistance and pressure mounts as the case takes a personal turn when she discovers the victim is from her hometown. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":122,"imageUrl":"","isOnSale":true,"name":"Case 137","instanceDates":"23 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981832AHHGRLSTQLPPMPLHGJGQRCDLNJQ","firstInstanceDateTime":"2026-10-23T17:30:00","firstInstanceDateTimeUtc":"2026-10-23T16:30:00Z","lastInstanceDateTime":"2026-10-29T17:30:00","lastInstanceDateTimeUtc":"2026-10-29T17:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate:  U/ Director: Nick Park & Peter Lord / Country:  UK/ France/ USA / Year: 2000 / Duration: 1h24m  \r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nAardman’s first full-length theatrical feature film was influential in the creation of the Best Animated Feature category at the Academy Awards, and it still remains the highest-grossing stop motion animation film of all time.  \r\n\r\nLife on Tweedy's Chicken Farm is far from pleasant for the inmates. Ginger the hen's various attempts at escape have failed, but when Rocky the famous Flying Rooster crash lands in the farm, she sees the chance she has been waiting for: Rocky can teach everyone how to fly, and they can stage a mass break-out! However, the braggardly Rocky is not all that he seems; can he really help Ginger and the others find freedom before Mrs Tweedy hatches her fowl plan to turn them all into chicken pies? ","htmlDescription":"<div id>\r\n\r\n</div>","duration":84,"imageUrl":"","isOnSale":true,"name":"Chicken Run","instanceDates":"13 October-13 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977432AMMCDBCMLNCGTGTCKCRHTJJTNNB","firstInstanceDateTime":"2026-10-13T12:15:00","firstInstanceDateTimeUtc":"2026-10-13T11:15:00Z","lastInstanceDateTime":"2026-10-13T12:15:00","lastInstanceDateTimeUtc":"2026-10-13T11:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Back for 2026! This year we have not one, but two Christmas Crafternoons. Each features different activities and techniques, meaning you can come to one or both for that extra festive hit!\r\n\r\nJoin us for the second of this year’s Christmas craft workshops, where we’ll be focusing on beautiful ways to bring some festive cheer to your home. \r\n\r\nThere will be no glass balls, plastic or glitter, just simple, eco-friendly options, including hand embroidered tree ornaments, paper stars and our annual alternative wreath. \r\n\r\nEnjoy a sweet treat, some Christmas tunes and leave feeling invigorated for the festive season! \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Christmas Crafternoon: Decorations","instanceDates":"6 December-6 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"969232ALQDMJPRVMGLHMLMLCCTGLVKNKG","firstInstanceDateTime":"2026-12-06T12:00:00","firstInstanceDateTimeUtc":"2026-12-06T12:00:00Z","lastInstanceDateTime":"2026-12-06T12:00:00","lastInstanceDateTimeUtc":"2026-12-06T12:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_Catergory":"Craft Sunday","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":""},{"description":"Back for 2026! This year we have not one, but two Christmas Crafternoons. Each features different activities and techniques, meaning you can come to one or both for that extra festive hit!\r\n \r\nJoin us for the first of this year’s Christmas craft workshops to make a personalised leather gift with S.K Works and a range of festive paper goods, including boxes, bags and gift wrap. \r\n\r\nIan and Ashley of S.K Works are back to show you how to make a decorated leather keyring – the perfect handmade festive gift or stocking filler. \r\n\r\nWe’ll be printing, sticking, folding and sewing everything you need to get ready to wrap your gifts. Use a selection of different techniques including printmaking, embroidery and paper folding. \r\n\r\nUnwind and enjoy a sweet treat, some Christmas tunes and leave feeling invigorated for the season!  \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Christmas Crafternoon: Gifts and Wrapping","instanceDates":"29 November-29 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"969033AHQRPQHRPQLGCVCTKGQTSTNRSGM","firstInstanceDateTime":"2026-11-29T12:00:00","firstInstanceDateTimeUtc":"2026-11-29T12:00:00Z","lastInstanceDateTime":"2026-11-29T12:00:00","lastInstanceDateTimeUtc":"2026-11-29T12:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_Catergory":"Craft Sunday","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":""},{"description":"Certificate: 12A / Director: Paweł Pawlikowski / Country: Poland/ Germany/ Italy/ France / Year: 2026 / Duration: 1h22m / Language: German with English subtitles  \r\n\r\nIn a masterclass of control and precision, Paweł Pawlikowski explores the fragmented soul of postwar Germany through a father-daughter road trip dominated by personal ghosts. \r\n\r\nFatherland centres on the relationship between the Nobel Prize-winning writer Thomas Mann (Hanns Zischler) and his daughter Erika (Sandra Hüller) - actress, writer and rally driver. In the summer of 1949, at the height of the Cold War, father and daughter embark on a challenging and emotional road trip in a black Buick taking them across a Germany in ruins - from US dominated Frankfurt to Soviet controlled Weimar. Returning home after sixteen years of exile in the US, Thomas Mann has to face not only a divided fatherland, but also a deep fracture within his own family. \r\n\r\nWith Fatherland, Pawlikowski picks up where he left off with his award-winning Ida and Cold War, exploring – in his elliptic, distilled style - the themes of identity, family, love and guilt amid the turmoil and confusion of post-war Europe ","htmlDescription":"<div id>\r\n\r\n</div>","duration":82,"imageUrl":"","isOnSale":true,"name":"Ciné Sunday: Fatherland","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980633ADBLBHBCRHPBQDTRHMMQCKSVDLS","firstInstanceDateTime":"2026-10-25T11:00:00","firstInstanceDateTimeUtc":"2026-10-25T11:00:00Z","lastInstanceDateTime":"2026-10-25T11:00:00","lastInstanceDateTimeUtc":"2026-10-25T11:00:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cine Sunday","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Frank Berry / Country: Ireland/ UK / Year: 2026 / Duration: 1h24m \r\n\r\nIn rural Ireland, amateur historian Catherine Corless begins researching a former institution for unmarried mothers and their children, uncovering a shocking hidden history of loss.  \r\n\r\nProduced by Liam Neeson, based on the true story and featuring a powerful performance from BAFTA winner Monica Dolan (Mr Bates vs The Post Office), THE LOST CHILDRENOF TUAM is a deeply moving portrait of one woman’s fight for justice.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":84,"imageUrl":"","isOnSale":true,"name":"Ciné Sunday: The Lost Children of Tuam","instanceDates":"18 October-18 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980432ADJGPKQQQKHMRQPKRLLLRLQRMRM","firstInstanceDateTime":"2026-10-18T11:00:00","firstInstanceDateTimeUtc":"2026-10-18T10:00:00Z","lastInstanceDateTime":"2026-10-18T11:00:00","lastInstanceDateTimeUtc":"2026-10-18T10:00:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cine Sunday","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Age: 15+\r\nDirector: Rafiki Fariala \r\nCountries of Production: Central African Republic, France, Democratic Republic of the Congo, Italy \r\nLanguage: Sango, French, Lingala, Swahili with English Subtitles  \r\nDuration: 1h 31min \r\nYear: 2026\r\n\r\nDiscovery Young Programmers are a group of 15- to 18-year-olds who are passionate about film. They attended a two-week summer programme to learn all about putting on a film festival through a series of sessions and workshops with DCA staff and visiting guest experts, as well as attending film screenings in our cinema.  \r\n\r\nThis year's Discovery Young Programmers are Emily, Mia, Izzy and Logan and they have selected the film Congo Boy to share with our audiences during this year's Discovery Film Festival. \r\n\r\nBangui, Central African Republic. 17-year-old Congolese teenager Robert dreams of a career in music, but civil war is tearing the country apart. When both his parents are thrown into prison, he is left to look after his four younger siblings on his own, juggling daily life, odd jobs, school exams and concert stages, but determined to follow his dream. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":91,"imageUrl":"","isOnSale":true,"name":"Congo Boy","instanceDates":"8 November-8 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"973232AGKDCSBJCJHGGHBNGRVTBMSGRBG","firstInstanceDateTime":"2026-11-08T15:30:00","firstInstanceDateTimeUtc":"2026-11-08T15:30:00Z","lastInstanceDateTime":"2026-11-08T15:30:00","lastInstanceDateTimeUtc":"2026-11-08T15:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Join artist Amy Jones for a relaxed workshop where you’ll learn how to make your own mini quilted wall hanging. \r\n\r\nExplore free-form quilting with Amy guiding you through each step, from sketching design ideas, choosing your fabric and creating your wall hanging. You’ll use hand sewing, embroidery and patchwork techniques and have the chance to incorporate more unusual surface decoration such as drawing and painting. \r\n\r\nWe’ll have plenty of tea, coffee and biscuits to help fuel your making throughout the afternoon. \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Craft Sunday: Mini Quilted Wall Hangings with Amy Jones ","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"968832ARKPDRPBGNVLMTTMMCMDSDDPHJQ","firstInstanceDateTime":"2026-10-25T11:00:00","firstInstanceDateTimeUtc":"2026-10-25T11:00:00Z","lastInstanceDateTime":"2026-10-25T11:00:00","lastInstanceDateTimeUtc":"2026-10-25T11:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_Catergory":"Craft Sunday","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":""},{"description":"Free, drop-in event\r\nDCA Galleries\r\n11:00 - 17:30\r\nSat 21 & Sun 22 November\r\n\r\nJoin us DCA Galleries for our annual festive market. \r\n\r\nBrowse and buy work from some of the best contemporary makers from across Scotland, with different creatives joining us on each day. You can expect talented designers and makers in the fields of jewellery, textiles, illustration, print, homeware and more, all offering a wide range of great gift ideas.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Crafted 2026","instanceDates":"21 November-22 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"952832ANVVVPHSGDBCTDJRVSTRSBPSGBD","firstInstanceDateTime":"2026-11-21T17:30:00","firstInstanceDateTimeUtc":"2026-11-21T17:30:00Z","lastInstanceDateTime":"2026-11-22T17:30:00","lastInstanceDateTimeUtc":"2026-11-22T17:30:00Z","altText":"","attribute_AccountCode":"GAL","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Exhibitions","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Create Space is a flexible, comfortable and imaginative space; a space in which people of all ages can see, think, make and do. \r\n\r\nInside you'll find activity sheets inspired by our exhibitions and cinema programme.\r\n\r\nAlongside getting creative with activity sheets and art materials, you can browse the books in our art library for children and spend some time in the Play Box, a small, safe play space for very wee ones and their grown-ups.  \r\n\r\nIf Create Space is closed when you visit, you can find a selection of activity sheets and materials on our Art Cart which is located in the Information Space. You can check the opening times for Create Space below. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Create Space","instanceDates":"1 July-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"940232ADLCRPTPVSCNCPTHHKJBDNKQKTK","firstInstanceDateTime":"2026-07-01T18:00:00","firstInstanceDateTimeUtc":"2026-07-01T17:00:00Z","lastInstanceDateTime":"2026-10-31T18:00:00","lastInstanceDateTimeUtc":"2026-10-31T18:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: 15 / Director: Alejandro G. Iñárritu / Country: UK/ Mexico/ USA  / Year: 2026 / Duration: 2h 8m \r\n\r\nAcademy Award-winning filmmaker Alejandro G. Iñárritu (Birdman, The Revenant) returns with his original film DIGGER, starring Tom Cruise in the title role. \r\n \r\nThe most powerful man in the world embarks on a frantic mission to prove he is humanity’s savior before the disaster he’s unleashed destroys everything. \r\n \r\nCruise stars alongside Oscar winner Riz Ahmed, John Goodman, Oscar nominee Sandra Hüller, Michael Stuhlbarg, and Oscar nominee Jesse Plemons. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":128,"imageUrl":"","isOnSale":true,"name":"Digger","instanceDates":"2 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"974232AKDNLVBMJJCGSDSQBNNVRKQGGDQ","firstInstanceDateTime":"2026-10-02T13:00:00","firstInstanceDateTimeUtc":"2026-10-02T12:00:00Z","lastInstanceDateTime":"2026-10-15T20:00:00","lastInstanceDateTimeUtc":"2026-10-15T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Free, drop in creative activities at Discovery Film Festival 2026.","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Discovery Art Cart","instanceDates":"31 October-8 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"978432ALLPBLSCLBNVBHBJKRSNTBSBKMG","firstInstanceDateTime":"2026-10-31T11:00:00","firstInstanceDateTimeUtc":"2026-10-31T11:00:00Z","lastInstanceDateTime":"2026-11-08T11:00:00","lastInstanceDateTimeUtc":"2026-11-08T11:00:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Age: 0+ (recommended for ages 7+) \r\nDirs: Various   \r\nVarious countries 2025 – 2026 / 53min /  \r\nDialogue free \r\nThemes: Prehistoric Times, waste and the environment, friendship, learning to change, fantasy and imagination, accepting differences, music for self-expression.\r\n\r\nThis collection of short films from Romania, Czech Republic, Belgium, Hungary, Italy and the UK present stories that are perfectly suited for learners aged 7+.  \r\n\r\nUsing a wide range of animation techniques, these films explore the importance of imagination and learning from each other, and how friendship and collaboration help us through challenges. On the first day of winter, two little stoats must learn to adapt to their new surroundings; a lonely mythical boy whose head shines like the sun, struggles to make friends in the clouds but when he falls down to Earth, everything changes; two little emergency workers from a strange planet go on an emergency mission to save one of their friends who has been crushed by debris falling from the sky; a small prehistoric amphibian goes on a journey with the goal of finding its mate; a sand creature and a baby sea turtle meet by a sudden turn of events; a bored boy leaves his bed-building task for a magical mushroom realm of endless possibilities, away from his father’s supervision. \r\n\r\nAll these short films are dialogue free.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":53,"imageUrl":"","isOnSale":true,"name":"Discovery Shorts for Families 2026","instanceDates":"1 November-13 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"971832ADSQPTSTHQKRGCTGLJTGDCCSLBC","firstInstanceDateTime":"2026-11-01T11:30:00","firstInstanceDateTimeUtc":"2026-11-01T11:30:00Z","lastInstanceDateTime":"2026-11-13T12:30:00","lastInstanceDateTimeUtc":"2026-11-13T12:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Ages 0-3\r\nDirector: Various \r\nCountries: Various Y\r\nears: Various \r\nRuntime: 60 min\r\nNo dialogue \r\n\r\nThis 60-minute programme for very young children combines a selection of films from our Shorts for Wee Ones collection with creative activities which give you and your family the chance to respond to the film you’ve just enjoyed. Previous film-related activities have seen us creating coloured mosaics of our favourite animals, taking a percussion instrument and making sound along with the characters, and dancing along with a giant Tyrannosaurus Rex!","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Discovery Shorts for Tinies 2026","instanceDates":"31 October-8 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"973233AGGKDRLQHLSTTBKVNJKNRGQTSQK","firstInstanceDateTime":"2026-10-31T10:30:00","firstInstanceDateTimeUtc":"2026-10-31T10:30:00Z","lastInstanceDateTime":"2026-11-08T10:30:00","lastInstanceDateTimeUtc":"2026-11-08T10:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age: 0+ (recommended for ages 3+)\r\nDirs: Various  \r\nVarious countries 2025 – 2026 / 40min /  \r\nDialogue free  \r\nAlways a popular feature of any Discovery Film Festival, this collection of seven short films for our youngest viewers is sure to delight and amuse. We’ve gathered a variety of stories and styles from France, Belgium, Switzerland, Germany, Croatia, and Singapore.  \r\n\r\nFeaturing bats helping bugs, a tiny but adventurous mouse, a farm dog willing to share his food with a chicken, a cheeky squirrel in search of a walnut, a dancing snowman, a porcelain dog’s chase for its ball through a pottery shelf, and a human fish creature. The films in this programme focus on curiosity and discovery, surprising friendships; promoting kindness and finding new perspectives.  \r\n\r\nAll these short films are dialogue free. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":40,"imageUrl":"","isOnSale":true,"name":"Discovery Shorts for Wee Ones 2026","instanceDates":"31 October-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"971632AJBVLBPJHKLVNMCLHHJBHLCDJLT","firstInstanceDateTime":"2026-10-31T11:30:00","firstInstanceDateTimeUtc":"2026-10-31T11:30:00Z","lastInstanceDateTime":"2026-11-12T12:30:00","lastInstanceDateTimeUtc":"2026-11-12T12:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 12A\r\nDirector:  Terence Fisher  \r\nCountry: UK  \r\nYear: 1958  \r\nDuration: 1h26m50s + 10m short\r\nDistributor:  Hammer / Dave Woodward\r\n\r\nHammer horror is almost a genre unto itself. Two words which conjure up a bonafide British filmmaking institution, a world of the gothic and the macabre, of candles, heavy curtains and leather armchairs, red-poster-paint-blood, smoking jackets, clipped diction and the supernatural, always shot with thrifty ingenuity, headlined by either Christopher Lee or Peter Cushing, or sometimes both.  \r\n\r\n1958’s Dracula was the film which put Hammer on the tea-stained, hand-drawn map. Cushing is Van Helsing opposite Lee’s dashing, vicious Count.  \r\n\r\nLee would play Dracula for Hammer no less than seven times. For a generation or more, it was the role for which he was best known, at least until Star Wars and the Lord of the Rings gave him a late-career renaissance.  \r\n\r\nWhile Bela Lugosi’s Dracula still looms large in the pop culture consciousness, so too does Hammer’s version of the Count. According to some historians, it was here that Dracula first appeared with canine fangs (Nosferatu’s vampire famously had fangs out in front). The fangs in Hammer’s Dracula were so shocking, and their employment in a moment of blood-letting so violent, that the film fell foul of the censors. The cut footage was lost to the annals of history until recently. This newly-rediscovered footage has been reinstated into a stunning brand new 4K restoration, allowing audiences to see the film fully uncut for the first time since its release. The recovered material has never been released before in the UK, and was previously only seen by audiences attending the film’s original Japanese theatrical release in 1958. \r\n\r\nDracula remains one of horror’s most iconic and enduring characters, and one who is regularly adapted, reconfigured and remixed to fit and reflect time periods, or moods, or tones. While there is never a bad time to revisit the classics, perhaps the success of Robert Egger’s Nosferatu could give us an indication that audiences are looking for adaptations that hark back to more classical modes of film-making. So come and see the film that launched one of the definitive portrayals of a classic horror character.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":137,"imageUrl":"","isOnSale":true,"name":"Dundead Halloween: Dracula (1958, 4K Restoration) ","instanceDates":"16 October-16 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"960632ACPMPGQVTRPQPDCKQQDJQHBKSHV","firstInstanceDateTime":"2026-10-16T20:15:00","firstInstanceDateTimeUtc":"2026-10-16T19:15:00Z","lastInstanceDateTime":"2026-10-16T20:15:00","lastInstanceDateTimeUtc":"2026-10-16T19:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundead Halloween","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Dundead","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Dundead Halloween: Surprise Preview 2026","instanceDates":"26 October-26 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"961032AVLSGSMHLRBBJNCGNRGKNBPRBVL","firstInstanceDateTime":"2026-10-26T20:15:00","firstInstanceDateTimeUtc":"2026-10-26T20:15:00Z","lastInstanceDateTime":"2026-10-26T20:15:00","lastInstanceDateTimeUtc":"2026-10-26T20:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundead Halloween","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Dundead","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18\r\nDirector:  Ken Russell  \r\nCountry: UK  \r\nYear: 1971  \r\nDuration: 1h 51m \r\n\r\nCensored for more than half a century, Ken Russell’s visionary and controversial The Devils returns to UK cinemas. Fully restored in 4K and cut to Russell’s direction, this is the first publicly released version of the film as intended by the filmmaker. This definitive version arrives 55 years after the film’s original release This release marks the first time Russell’s defining masterpiece has been made officially accessible to the public. \r\n\r\nAn enduring masterpiece of cinema starring Oliver Reed and Vanessa Redgrave, Ken Russell’s The Devils is a prescient epic of obsession and corruption, and a defining work of art from the seminal British filmmaker Ken Russell, director of such films as Tommy, Altered States, and The Lair of the White Worm. Russell was a true disruptor, and a singular figure in British cinema, straddling high art and real transgression.  \r\n\r\nInspired by the true story of 17th-century priest Urbain Grandier, accused of bewitching a convent of nuns, the film lays bare the collusion of church and state through a searing vision of religious persecution, collective hysteria and institutional corruption. In addition to powerhouse performances from Reed and Redgrave, Ken Russell’s The Devils showcases the stunning work of artists at the peak of their craft: Academy Award-winning cinematographer David Watkin (Out of Africa, Chariots of Fire); editor Michael Bradsell (Local Hero, Jabberwocky); and visual artist Derek Jarman (Jubilee, Caravaggio), whose work as production designer marked his feature film debut.","htmlDescription":"<div id>\r\n\r\n</div>","duration":111,"imageUrl":"","isOnSale":true,"name":"Dundead Halloween: The Devils (4K Restoration)","instanceDates":"30 October-30 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"961232ABRRPPJLPDSKRNQTCHMRPDGJVMP","firstInstanceDateTime":"2026-10-30T20:30:00","firstInstanceDateTimeUtc":"2026-10-30T20:30:00Z","lastInstanceDateTime":"2026-10-30T20:30:00","lastInstanceDateTimeUtc":"2026-10-30T20:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundead Halloween","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Dundead","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"This screening includes short film Season's Greetings (3m47s) \r\nCertificate: 15 \r\nDirector:  Richard Donner   \r\nCountry: UK / USA \r\nYear: 1976  \r\nDuration: 1h 51m  \r\nDistributor: Park Circus\r\n\r\nDirector Richard Donner may well be one of American popular cinema’s most influential under-sung creative guiding forces. Films like 1978’s Superman, and later The Goonies and Lethal Weapon, all of which he directed, continue to be genre-defining, but his name perhaps never carried the instant recognition of Steven Spielberg or James Cameron. 1976’s The Omen was Donner’s first feature that was not made for television, and likewise, is perhaps the most influential of the Satanic horror sub-genre.  \r\n\r\nPresumably inspired by earlier films like Rosemary’s Baby, the film is of course famous for introducing the character of Damien into the public consciousness, a horror icon who has been endlessly parodied and referenced.  \r\n\r\nThe Omen follows Robert Thorn, an American ambassador played by Gregory Peck, and his wife Katherine (Lee Remick). The couple live an affluent life in the UK, where they are raising their son Damien, but strange and disturbing things begin happening around them. Veteran character actor Patrick Troughton (best known as the second actor to play Doctor Who) plays a catholic priest who is suspicious of these sinister occurrences, and the great David Warner (Tron, Twin Peaks, Time Bandits) plays a photographer who becomes caught up in the grisly goings-on.  \r\n\r\nThe plot is terrifically simple and compelling, and there are some fabulous moments of cinematic invention; the death scenes in The Omen would go on to inspire the Final Destination series, and the scenes involving Warner and his camera are perfectly creepy moments of horror-movie magic. The score, by Jerry Goldmsith, is a perennial horror classic (and in fact made an appearance on the soundtrack of Dundead fest 2026 hit Silencio), and won the composer his only Oscar. \r\n\r\nSo come mark the 50th anniversary of a genuine horror classic with Dundead on Halloween night.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":111,"imageUrl":"","isOnSale":true,"name":"Dundead Halloween: The Omen (50th Anniversary, 4K Restoration)","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"960832AHMMKNGCKBHJDJRVSMGNPKJDMQP","firstInstanceDateTime":"2026-10-31T20:30:00","firstInstanceDateTimeUtc":"2026-10-31T20:30:00Z","lastInstanceDateTime":"2026-10-31T20:30:00","lastInstanceDateTimeUtc":"2026-10-31T20:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundead Halloween","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Dundead","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18\r\nDirector:  Dan O’Bannon  \r\nCountry: USA  \r\nYear: 1985  \r\nDuration: 1h 31m + 15 min drag performance/intro \r\n\r\nThe Return of the Living Dead is the directorial debut of Dan O’Bannon, who is probably best known to genre fans as the writer of the original Alien film. Tonally, Return of the Living Dead is about as far from that 1979 xenomorph classic as possible.  \r\n\r\nWhile Alien has a certain moody sleekness of design and storytelling, Return of the Living Dead is pure gaudy shlock. A wilfully daft ‘80s punk zombie comedy with equal helpings of gags and gore. As the original poster promised – “THEY’RE BACK FROM THE GRAVE AND READY TO PARTY!”  \r\n\r\nA hapless pair of warehouse employees accidentally kick off a chain of events that soon lead to a full-scale zombie insurgence, and humanity’s hopes seem to rest in the hands a gaggle of leather-and-mohawk ‘80s punks, a few gormless idiots, and one eccentric tracksuit-wearing, pipe-smoking, Lueger-wielding Nazi mortician.  \r\n\r\nThere is some satire among the slapstick silliness, including a barnstormingly entertaining finale, but mostly, this is trashy, broad and very fun. Return of the Living Dead is also notable for a genuine development in horror and pop culture history; it is apparently the first film to feature zombies who groan for “brraaiiinnnns”.  \r\n\r\nScored by an immortally cool punk/psychobilly soundtrack (featuring The Cramps, The Flesh Eaters and Tall Boys), The Return of the Living Dead has rib-tickling gags and gut-churning gore by the bucketload. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":91,"imageUrl":"","isOnSale":true,"name":"Dundead Halloween: The Return of the Living Dead with live drag performance","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"960232AJHHNDGHNSDJRDBHDGVVGKBNHJJ","firstInstanceDateTime":"2026-10-24T20:30:00","firstInstanceDateTimeUtc":"2026-10-24T19:30:00Z","lastInstanceDateTime":"2026-10-24T20:30:00","lastInstanceDateTimeUtc":"2026-10-24T19:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundead Halloween","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Dundead","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: PG / Director: Nick Park / Country: UK/ France/ USA / Year: 2018 / Duration:  1h 29min \r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nEarly Man is a prehistoric comedy adventure directed by Nick Park. Shot in Aardman’s distinctive style, it takes audiences on an extraordinary journey into an exciting new world, unleashing an unforgettable tribe of unique and funny characters voiced by an all-star British cast. \r\n\r\nSet at the dawn of time, when prehistoric creatures roamed the earth, Early Man tells the story of courageous caveman hero Dug (Eddie Redmayne) and his best friend Hognob, as they unite his tribe against a mighty enemy, Lord Nooth (Tom Hiddleston), and his Bronze Age City to save their home. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":89,"imageUrl":"","isOnSale":true,"name":"Early Man","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977433ANCHJQLJPHRMMNSBTNTNTSDHVLM","firstInstanceDateTime":"2026-10-25T12:00:00","firstInstanceDateTimeUtc":"2026-10-25T12:00:00Z","lastInstanceDateTime":"2026-10-25T12:00:00","lastInstanceDateTimeUtc":"2026-10-25T12:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"PG","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Ages 5+\r\n\r\nEnchanted Cinema is back! This interactive show celebrates the 100th anniversary of Lotte Reiniger’s The Adventures of Prince Achmed - the oldest surviving animated feature film in the world – bringing her magical animated tales to life.  \r\n\r\nWith dancing frogs, a blue-grassing grasshopper, and a mystical flying horse, cinema becomes something you can hear, feel and play.  \r\n\r\nUsing hands, voices and unique sounds audience members transform into enchanted creatures, discovering their own voice before joining together to animate the screen and adding rhythm, music and effects to every story.  \r\n\r\nThis magical, interactive cinema event is an unforgettable experience for ages 5+.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Enchanted Cinema Presents 'Enchanted Creatures and How to Become One'","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"972432AMLLHRMJDPBSSBCPHLTCKQPHQBP","firstInstanceDateTime":"2026-11-07T10:30:00","firstInstanceDateTimeUtc":"2026-11-07T10:30:00Z","lastInstanceDateTime":"2026-11-07T10:30:00","lastInstanceDateTimeUtc":"2026-11-07T10:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: tbc\r\nYear: 2027 \r\nDuration:  1h 30m \r\nDistributor: Seventh Art \r\n\r\nTo celebrate Tate Britain’s blockbuster Monet and Time exhibition, Exhibition on Screen is delighted to bring the iconic story of Claude Monet to cinema screens in May 2027. \r\n\r\nUndeniably one of the world’s favourite artists and the figurehead of the Impressionist movement prepare to be dazzled by his spectacular and revolutionary use of light and colour and step into one the most famous gardens in art history. \r\n\r\nImmerse yourself in iconic masterpieces and discover the incredible story of passion and rebellion in this exciting documentary on the man who named the world’s favourite art movement. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Exhibition on Screen: Monet","instanceDates":"11 May-11 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"970032ADJBMNMNNSKNVQMKKSBBSVVMSBN","firstInstanceDateTime":"2027-05-11T18:00:00","firstInstanceDateTimeUtc":"2027-05-11T17:00:00Z","lastInstanceDateTime":"2027-05-11T18:00:00","lastInstanceDateTimeUtc":"2027-05-11T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Exhibition on Screen","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Alternative content","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: tbc \r\nDirector: Ali Ray \r\nYear: 2027 \r\nDuration:  1h 30m \r\nDistributor: Seventh Art \r\n\r\nPierre-Auguste Renoir is one of the world’s favourite artists; a founding member of the Impressionist movement and a constantly evolving artist, he is unmatched at depicting human connection. The National Gallery’s blockbuster exhibition brings together vibrant masterpieces which explore love in all its forms, bringing colour and warmth into the cold winter months. \r\n\r\nWith exclusive access to this exciting new show, Exhibition on Screen will bring these world class works to cinema audiences, with close examination of the art and leading experts exploring the immense skill and influence of this master of colour and connection. Be transported back to a Parisian summer of love through the eyes of a true visionary. An unmissable opportunity to fall in love with Renoir this winter. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Exhibition on Screen: Renoir & Love","instanceDates":"19 January-19 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"969832AJBGKNTPHDMPHLRGDQKKTCJCRGL","firstInstanceDateTime":"2027-01-19T18:00:00","firstInstanceDateTimeUtc":"2027-01-19T18:00:00Z","lastInstanceDateTime":"2027-01-19T18:00:00","lastInstanceDateTimeUtc":"2027-01-19T18:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Exhibition on Screen","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Alternative content","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Join Dan Brown, DCA’s Head of Exhibitions, for a slow-looking tour of the current show. This guided tour will encourage a thoughtful and unhurried engagement with the artworks, providing space to explore the themes, processes and practices in France-Lise McGurn’s exhibition. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Exhibition Tours: France-Lise McGurn","instanceDates":"3 September-19 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"953832AKGTNDKLGDCRCSNNJVPRRVQDGDC","firstInstanceDateTime":"2026-09-03T18:00:00","firstInstanceDateTimeUtc":"2026-09-03T17:00:00Z","lastInstanceDateTime":"2026-11-19T14:00:00","lastInstanceDateTimeUtc":"2026-11-19T14:00:00Z","altText":"","attribute_AccountCode":"GAL","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Exhibitions","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Explore lino etching, a versatile and painterly printmaking technique. You'll learn how to create gestural marks, tonal gradients and textures on lino, while combining traditional cutting techniques for a dynamic and layered approach. Experiment with various tools and methods, including caustic soda paste for etching, as well as using precision tools like the Dremel and lino carving gauges. The course will also cover key skills such as registration and multi-block printing, enabling you to create complex, multi-layered prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Experimental Relief Etch Printing (March 2027)","instanceDates":"13 March-13 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"959432ATTDSSQTNTPJPGKPCRRJGGTKQNT","firstInstanceDateTime":"2027-03-13T10:30:00","firstInstanceDateTimeUtc":"2027-03-13T10:30:00Z","lastInstanceDateTime":"2027-03-13T10:30:00","lastInstanceDateTimeUtc":"2027-03-13T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: tbc \r\nDirector: Scott Ellis \r\nDuration:  1h 50m \r\nDistributor: Trafalgar ","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"Fallen Angels by Noël Coward","instanceDates":"22 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"952232ANTNRKQPLJVSLQNVPNPCDPSLNVR","firstInstanceDateTime":"2026-10-22T20:00:00","firstInstanceDateTimeUtc":"2026-10-22T19:00:00Z","lastInstanceDateTime":"2026-10-25T14:15:00","lastInstanceDateTimeUtc":"2026-10-25T14:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Theatre","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Family Art Labs offer relaxed time and space to get making as a family. Try out creative with activities and explore techniques presented by local artists, in this fully led session","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Family Art Lab: France-Lise McGurn (November) ","instanceDates":"14 November-14 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"962232ARHSDHMJMLRJHQJMKBKTPGHNQVQ","firstInstanceDateTime":"2026-11-14T11:00:00","firstInstanceDateTimeUtc":"2026-11-14T11:00:00Z","lastInstanceDateTime":"2026-11-14T11:00:00","lastInstanceDateTimeUtc":"2026-11-14T11:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Suitable for all ages family groups together \r\n\r\nFamily Art Labs offer relaxed time and space to get making as a family, you can be creative with activities and explore techniques presented by local artists. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Family Art Lab: France-Lise McGurn (October)","instanceDates":"25 October-25 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"962032ATLPGRPBSHRCSSMJKHCPLKKKBBG","firstInstanceDateTime":"2026-10-25T11:00:00","firstInstanceDateTimeUtc":"2026-10-25T11:00:00Z","lastInstanceDateTime":"2026-10-25T11:00:00","lastInstanceDateTimeUtc":"2026-10-25T11:00:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Paweł Pawlikowski / Country: Poland/ Germany/ Italy/ France / Year: 2026 / Duration: 1h22m / Language: German with English subtitles  \r\n\r\nIn a masterclass of control and precision, Paweł Pawlikowski explores the fragmented soul of postwar Germany through a father-daughter road trip dominated by personal ghosts. \r\n\r\nFatherland centres on the relationship between the Nobel Prize-winning writer Thomas Mann (Hanns Zischler) and his daughter Erika (Sandra Hüller) - actress, writer and rally driver. In the summer of 1949, at the height of the Cold War, father and daughter embark on a challenging and emotional road trip in a black Buick taking them across a Germany in ruins - from US dominated Frankfurt to Soviet controlled Weimar. Returning home after sixteen years of exile in the US, Thomas Mann has to face not only a divided fatherland, but also a deep fracture within his own family. \r\n\r\nWith Fatherland, Pawlikowski picks up where he left off with his award-winning Ida and Cold War, exploring – in his elliptic, distilled style - the themes of identity, family, love and guilt amid the turmoil and confusion of post-war Europe ","htmlDescription":"<div id>\r\n\r\n</div>","duration":82,"imageUrl":"","isOnSale":true,"name":"Fatherland","instanceDates":"23 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981232AHDNNKTVSTBRVMNCLQVCSQLSJBV","firstInstanceDateTime":"2026-10-23T15:30:00","firstInstanceDateTimeUtc":"2026-10-23T14:30:00Z","lastInstanceDateTime":"2026-11-05T17:00:00","lastInstanceDateTimeUtc":"2026-11-05T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: David Bowers & Sam Fell / Country: UK/ USA / Year: 2006 / Duration: 1h25m \r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nFlushed Away was the third and final animated feature Aardman produced with DreamWorks, and the first Aardman project made entirely in CGI animation as opposed to stop-motion. Directed by David Bowers and Sam Fell, the film stars the voices of Hugh Jackman, Kate Winslet, Shane Richie, Bill Nighy, Andy Serkis, Ian McKellen and Jean Reno. \r\n\r\nRoddy St. James is a pampered pet rat who thinks he’s got it made. But when a sewer rat named Sid comes spewing out of the sink and decides it’s his turn to enjoy the lap of luxury, Roddy schemes to rid himself of the pest by luring him into the loo for a dip in the “whirlpool.” Roddy’s plan backfires when he winds up being the one flushed away into the bustling world down below. Underground, Roddy discovers a vast metropolis where he meets Rita, a street-wise rat who is on a mission of her own. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":85,"imageUrl":"","isOnSale":true,"name":"Flushed Away (20th Anniversary)","instanceDates":"20 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977832AJDLVJNCKVKQLBVHJVRKPLDJBLS","firstInstanceDateTime":"2026-10-20T12:00:00","firstInstanceDateTimeUtc":"2026-10-20T11:00:00Z","lastInstanceDateTime":"2026-10-20T12:00:00","lastInstanceDateTimeUtc":"2026-10-20T11:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"In The Charm Offensive, McGurn’s paintings spill from the canvas to walls, creating a site-specific installation where paintings created in the studio have a new life.  Her wall paintings make ‘new’ of works already made – recontextualising them in the gallery space. She assembles varied images and exiled objects from the studio and city in constellations - implying location, time or feeling, and creating a sense of immediacy. This new development in her work is made possible by the scale of DCA galleries and the accompanying events programme, including her Artist's Choice Screenings, films selected by McGurn to expand on and complement the exhibition.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":540,"imageUrl":"","isOnSale":false,"name":"France-Lise McGurn: The Charm Offensive","instanceDates":"21 August-15 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954232ATKPQHQRCNMVJTDDRJSTPPRTKNL","firstInstanceDateTime":"2026-08-21T11:00:00","firstInstanceDateTimeUtc":"2026-08-21T10:00:00Z","lastInstanceDateTime":"2026-11-15T11:00:00","lastInstanceDateTimeUtc":"2026-11-15T11:00:00Z","altText":"","attribute_AccountCode":"GAL","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Exhibitions","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: PG / Director: Simon Hynd / Country: UK / Year: 2026 / Duration: 1h 37m \r\n\r\nThe beloved and award-winning BBC comedy GHOSTS arrives on the big screen this Halloween. GHOSTS' stars, writers and creators Mathew Baynton, Simon Farnaby, Martha Howe-Douglas, Jim Howick, Laurence Rickard and Ben Willbond are back, along with Lolly Adefope, Charlotte Ritchie and Kiell Smith-Bynoe, in a feature length family adventure. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":97,"imageUrl":"","isOnSale":true,"name":"Ghosts: The Possession of Button House","instanceDates":"23 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981632ACPKVBRKLKLKDNLSSRKTKVTVQCS","firstInstanceDateTime":"2026-10-23T20:30:00","firstInstanceDateTimeUtc":"2026-10-23T19:30:00Z","lastInstanceDateTime":"2026-10-29T17:15:00","lastInstanceDateTimeUtc":"2026-10-29T17:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"PG","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: tbc\r\nDirector: Nicholas Hytner   \r\nDuration:  2h 16m  \r\nDistributor: Trafalgar ","htmlDescription":"<div id>\r\n\r\n</div>","duration":136,"imageUrl":"","isOnSale":true,"name":"GIANT – The Play","instanceDates":"19 November-19 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"952432AQMGKKPMQRPSSJQSSVPKLVJVPKD","firstInstanceDateTime":"2026-11-19T20:00:00","firstInstanceDateTimeUtc":"2026-11-19T20:00:00Z","lastInstanceDateTime":"2026-11-19T20:00:00","lastInstanceDateTimeUtc":"2026-11-19T20:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Theatre","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 12A\r\nDirector: Brett Sullivan \r\nDuration:  2h 22m  \r\nDistributor: Trafalgar \r\n\r\nThe international hit musical comes to the big screen!  \r\nWinner of eight Tony Awards in 2019 including Best Musical and the 2020 Grammy Award for Best Musical Theatre Album, HADESTOWN: THE MUSICAL is the genre-defying musical blending modern American folk music with New Orleans-inspired jazz to reimagine a sweeping ancient tale of two intertwining love stories, that of young dreamers Orpheus and Eurydice, and King Hades and his wife Persephone.   \r\n\r\nFilmed live on stage in London’s West End and featuring the original Broadway stars, HADESTOWN: THE MUSICAL invites audiences on a hell-raising journey to the underworld and back.","htmlDescription":"<div id>\r\n\r\n</div>","duration":142,"imageUrl":"","isOnSale":true,"name":"Hadestown: The Musical","instanceDates":"13 October-27 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"952032ABLRDKPBSSDMMVJJGRMBHQJSGQM","firstInstanceDateTime":"2026-10-13T20:00:00","firstInstanceDateTimeUtc":"2026-10-13T19:00:00Z","lastInstanceDateTime":"2026-10-27T19:45:00","lastInstanceDateTimeUtc":"2026-10-27T19:45:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Theatre","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Create beautiful hardcover books that you could use as a gift or keep for yourself. Learn how to construct hardcovers using board, book cloth and papers decorated in class using Suminagashi, a Japanese marbling technique. You will then combine these elements to create beautiful hardcover books that can be used as journals or scrapbooks.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Hardcover Bookbinding with Suminagashi Decoration (March 2027)","instanceDates":"10 March-10 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"959232AMCDDQRRMTSBSHRRVMLVGDSPNRK","firstInstanceDateTime":"2027-03-10T18:00:00","firstInstanceDateTimeUtc":"2027-03-10T18:00:00Z","lastInstanceDateTime":"2027-03-10T18:00:00","lastInstanceDateTimeUtc":"2027-03-10T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn all about Lightroom, the streamlined photo-retouching and organisational software from the makers of Photoshop. Taking Adobe's photo-specific functions and putting them into one package, Lightroom is perfect if you want to edit and adjust your images easily. In this course you'll be introduced to the Lightroom interface and its layout and functions. You'll be taken through all stages of using the software, from importing, organising and rating files to editing and adjusting photographs, exporting finished files and print and web preparation.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Introduction to Adobe Lightroom (January 2027)","instanceDates":"30 January-30 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955233ANTTJTLSNGGNMHGLVDJKJHMKQMT","firstInstanceDateTime":"2027-01-30T12:00:00","firstInstanceDateTimeUtc":"2027-01-30T12:00:00Z","lastInstanceDateTime":"2027-01-30T12:00:00","lastInstanceDateTimeUtc":"2027-01-30T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Photoshop is made easy in this weekend course. Using our computers (or your own laptop if you prefer) you will use the most well known photo-editing software, Adobe Photoshop, to adjust and improve your images.  You will learn how to use the programme tools, menus, and functions, to colour correct, adjust tone, clone and remove small objects, add text, understand and use layers and selections. Photoshop can also be used for drawing and painting in a digital workspace.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Introduction to Adobe Photoshop (October 2026)","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955832APVGHCDBCNKSSGMGDGCHTDDSQDV","firstInstanceDateTime":"2026-10-24T10:30:00","firstInstanceDateTimeUtc":"2026-10-24T09:30:00Z","lastInstanceDateTime":"2026-10-24T10:30:00","lastInstanceDateTimeUtc":"2026-10-24T09:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Unlock the creative potential of your camera and take control of your photos. Ever wondered what all those setting on your camera mean? This two-day course will explain the benefits of taking control of these settings for yourself. You will learn how to achieve correct exposure, improve your colours, different aperture and shutter speed settings and how they affect your images, and how to compensate for different lighting conditions in a creative way to achieve improved results. The course will take place over two days and will allow you to learn all of these things at a comfortable pace through a combination of lessons, discussions and practical exercises in the comfort of the DCA, and also out and about in the real world for continued learning and to put your new skills into practice. Regardless of whether your camera is a DSLR, Mirrorless, or Compact, as long as it has the capability to use manual settings it will be suitable for this course. Please note: If your camera does not have the ability to manually change exposure settings (aperture/shutter speed/ ISO), then it will not be suitable.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Introduction to Digital Photography (February 2027)","instanceDates":"27 February-27 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958233ALDNCNDTRQMMTJNHDCMJLKVKDSL","firstInstanceDateTime":"2027-02-27T12:00:00","firstInstanceDateTimeUtc":"2027-02-27T12:00:00Z","lastInstanceDateTime":"2027-02-27T12:00:00","lastInstanceDateTimeUtc":"2027-02-27T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Unlock the creative potential of your camera and take control of your photos. Ever wondered what all those setting on your camera mean? This two-day course will explain the benefits of taking control of these settings for yourself. You will learn how to achieve correct exposure, improve your colours, different aperture and shutter speed settings and how they affect your images, and how to compensate for different lighting conditions in a creative way to achieve improved results. The course will take place over two days and will allow you to learn all of these things at a comfortable pace through a combination of lessons, discussions and practical exercises in the comfort of the DCA, and also out and about in the real world for continued learning and to put your new skills into practice. Regardless of whether your camera is a DSLR, Mirrorless, or Compact, as long as it has the capability to use manual settings it will be suitable for this course. Please note: If your camera does not have the ability to manually change exposure settings (aperture/shutter speed/ ISO), then it will not be suitable.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Introduction to Digital Photography (November 2026)","instanceDates":"21 November-21 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957032AVRLLCPNNKRMSVMRSBRRPTPGMVD","firstInstanceDateTime":"2026-11-21T12:00:00","firstInstanceDateTimeUtc":"2026-11-21T12:00:00Z","lastInstanceDateTime":"2026-11-21T12:00:00","lastInstanceDateTimeUtc":"2026-11-21T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn the basics of etching over two evenings. Explore a variety of processes and leave with a small edition of prints. This class is suitable for people who want try out the basic etching process using small plates. You will learn how to prepare a metal plate for etching by filing and polishing, then applying a wax hard ground to the surface for drawing onto. A copper sulphate solution is used to etch the designs on the plate. You will spend time learning how to prepare the paper and ink up the plate to produce a small edition of prints using different colours of ink and Chine Colle.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Etching (January 2027)","instanceDates":"14 January-14 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957634AJKCHSBBMVDNVLBRBDPHNHTRTNG","firstInstanceDateTime":"2027-01-14T18:00:00","firstInstanceDateTimeUtc":"2027-01-14T18:00:00Z","lastInstanceDateTime":"2027-01-14T18:00:00","lastInstanceDateTimeUtc":"2027-01-14T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn the basics of etching over two evenings. Explore a variety of processes and leave with a small edition of prints. This class is suitable for people who want try out the basic etching process using small plates. You will learn how to prepare a metal plate for etching by filing and polishing, then applying a wax hard ground to the surface for drawing onto. A copper sulphate solution is used to etch the designs on the plate. You will spend time learning how to prepare the paper and ink up the plate to produce a small edition of prints using different colours of ink and Chine Colle.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Etching (October 2026)","instanceDates":"14 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954832ALRCDHVLDQQBVVMGQMHDKJGBVVV","firstInstanceDateTime":"2026-10-14T18:00:00","firstInstanceDateTimeUtc":"2026-10-14T17:00:00Z","lastInstanceDateTime":"2026-10-14T18:00:00","lastInstanceDateTimeUtc":"2026-10-14T17:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Join us for a one-day introduction to our laser cutter. Learn how to laser-cut and engrave hand-drawn, computer-generated and photographic images onto different materials such as paper, wood and Perspex. This course is perfect for artists, designers and individuals who want to explore using CNC technology to make print matrixes.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Introduction to Laser Cutting (December 2026)","instanceDates":"19 December-19 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957832APKVDQBMMCSHKCQTSSMCNQRKPDM","firstInstanceDateTime":"2026-12-19T10:30:00","firstInstanceDateTimeUtc":"2026-12-19T10:30:00Z","lastInstanceDateTime":"2026-12-19T10:30:00","lastInstanceDateTimeUtc":"2026-12-19T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Join us for a one-day introduction to our laser cutter. Learn how to laser-cut and engrave hand-drawn, computer-generated and photographic images onto different materials such as paper, wood and Perspex. This course is perfect for artists, designers and individuals who want to explore using CNC technology to make print matrixes.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Introduction to Laser Cutting (March 2027)","instanceDates":"6 March-6 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958632AVPVLJGRKKQLDMJJCSDMTTSBKLP","firstInstanceDateTime":"2027-03-06T10:30:00","firstInstanceDateTimeUtc":"2027-03-06T10:30:00Z","lastInstanceDateTime":"2027-03-06T10:30:00","lastInstanceDateTimeUtc":"2027-03-06T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"This two-week class is perfect for total beginners, catering for people who would like to learn the basic stages of lino cutting. Use specialist tools to create intricate hand-carved blocks, which are then printed on a vintage press. Learn how to make a monotone lino cut print, from using cutting tools to transfer your design onto a lino block to using oil-based inks to print with. At the end of the course you should have completed some lino prints to take home (or collect from the Print Studio at a later date).","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Lino Cutting (February 2027)","instanceDates":"2 February-2 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956035AMNJBHRRVSHMHQJGVDHSRSHJKKM","firstInstanceDateTime":"2027-02-02T18:00:00","firstInstanceDateTimeUtc":"2027-02-02T18:00:00Z","lastInstanceDateTime":"2027-02-02T18:00:00","lastInstanceDateTimeUtc":"2027-02-02T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"This two-week class is perfect for total beginners, catering for people who would like to learn the basic stages of lino cutting. Use specialist tools to create intricate hand-carved blocks, which are then printed on a vintage press. Learn how to make a monotone lino cut print, from using cutting tools to transfer your design onto a lino block to using oil-based inks to print with. At the end of the course you should have completed some lino prints to take home (or collect from the Print Studio at a later date).","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Lino Cutting (October 2026)","instanceDates":"13 October-13 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954632ARPPLSDJSCTLQQPHMDQLPSMMNBP","firstInstanceDateTime":"2026-10-13T18:00:00","firstInstanceDateTimeUtc":"2026-10-13T17:00:00Z","lastInstanceDateTime":"2026-10-13T18:00:00","lastInstanceDateTimeUtc":"2026-10-13T17:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Perfect for beginners and a great introduction to the world of printmaking. This course will introduce several different types of mono printing, each with their own distinctive characteristics. Images will be created by using specialist equipment, layering up inked stencils with painted and drawn marks to create unique one-off monotype prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Introduction to Mono Printing (November 2026)","instanceDates":"21 November-21 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956832AVJCDMTRHNKSRRLBKGPQLRSJCCP","firstInstanceDateTime":"2026-11-21T10:30:00","firstInstanceDateTimeUtc":"2026-11-21T10:30:00Z","lastInstanceDateTime":"2026-11-21T10:30:00","lastInstanceDateTimeUtc":"2026-11-21T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Enjoy an introduction to our Print Studio and try some simple printmaking processes at this fun and relaxed afternoon workshop. Take a tour of our state-of-the-art equipment and find out about the main types of etching, relief printing, screen printing and photography. You'll get the chance to try some of the simpler stages of printmaking and produce a few prints to take home. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Introduction to Printmaking (January 2027)","instanceDates":"9 January-9 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956034APCCHDSHQGPLVBJBTHDGGQQTGPL","firstInstanceDateTime":"2027-01-09T13:00:00","firstInstanceDateTimeUtc":"2027-01-09T13:00:00Z","lastInstanceDateTime":"2027-01-09T13:00:00","lastInstanceDateTimeUtc":"2027-01-09T13:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Enjoy an introduction to our Print Studio and try some simple printmaking processes at this fun and relaxed afternoon workshop. Take a tour of our state-of-the-art equipment and find out about the main types of etching, relief printing, screen printing and photography. You'll get the chance to try some of the simpler stages of printmaking and produce a few prints to take home. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Introduction to Printmaking (November 2026)","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956432ACVRQDRHSGCPBKNLPMCSPJBNTKV","firstInstanceDateTime":"2026-11-07T13:00:00","firstInstanceDateTimeUtc":"2026-11-07T13:00:00Z","lastInstanceDateTime":"2026-11-07T13:00:00","lastInstanceDateTimeUtc":"2026-11-07T13:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"The perfect introduction to the screen printing process. Screen printing is one of the most popular printmaking techniques in DCA Print Studio. In this one-day workshop you will learn how to create wonderfully colourful and graphic prints using hand-cut paper stencils. This class will give you the basic skills needed to move onto more advanced screen printing courses. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Introduction to Screen Printing (February 2027)","instanceDates":"21 February-21 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956037AGCDJLRHJKTVGLBTNBLPQKHMSHP","firstInstanceDateTime":"2027-02-21T10:30:00","firstInstanceDateTimeUtc":"2027-02-21T10:30:00Z","lastInstanceDateTime":"2027-02-21T10:30:00","lastInstanceDateTimeUtc":"2027-02-21T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"The perfect introduction to the screen printing process. Screen printing is one of the most popular printmaking techniques in DCA Print Studio. In this one-day workshop you will learn how to create wonderfully colourful and graphic prints using hand-cut paper stencils. This class will give you the basic skills needed to move onto more advanced screen printing courses. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Introduction to Screen Printing (January 2027)","instanceDates":"16 January-16 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955634AQKRNTNLTDBQTHQVPCDLGKRBHMH","firstInstanceDateTime":"2027-01-16T10:30:00","firstInstanceDateTimeUtc":"2027-01-16T10:30:00Z","lastInstanceDateTime":"2027-01-16T10:30:00","lastInstanceDateTimeUtc":"2027-01-16T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"The perfect introduction to the screen printing process. Screen printing is one of the most popular printmaking techniques in DCA Print Studio. In this three-week course you will learn how to create wonderfully colourful and graphic prints using hand-cut paper stencils. This class will give you the basic skills needed to move onto more advanced screen printing courses. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Screen Printing (November 2026)","instanceDates":"18 November-18 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955435AHCJLTDKQTLNLBKPGHDMBGTDGKP","firstInstanceDateTime":"2026-11-18T18:00:00","firstInstanceDateTimeUtc":"2026-11-18T18:00:00Z","lastInstanceDateTime":"2026-11-18T18:00:00","lastInstanceDateTimeUtc":"2026-11-18T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Explore the process of Stone Lithography in this five-week course. Developed in the late 18th Century, stone lithography is a traditional printmaking process where an image is drawn on and then printed from a flat slab of limestone. This course offers an introduction to the process where you will be guided through the different stages to create your own stone lithograph print.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Introduction to Stone Lithography (January 2027)","instanceDates":"13 January-13 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958032ATBDSTHGDJGPVJCLDQVQJSHHGKQ","firstInstanceDateTime":"2027-01-13T18:00:00","firstInstanceDateTimeUtc":"2027-01-13T18:00:00Z","lastInstanceDateTime":"2027-01-13T18:00:00","lastInstanceDateTimeUtc":"2027-01-13T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Explore the process of Stone Lithography in this weekend course. Developed in the late 18th Century, stone lithography is a traditional printmaking process where an image is drawn on and then printed from a flat slab of limestone. This two-day class offers an introduction to the process where you will be guided through the different stages to create your own stone lithograph print.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Introduction to Stone Lithography (November 2026)","instanceDates":"28 November-28 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956633ALHDDPTVNJLGSMKKGKJQKCJLCRG","firstInstanceDateTime":"2026-11-28T10:30:00","firstInstanceDateTimeUtc":"2026-11-28T10:30:00Z","lastInstanceDateTime":"2026-11-28T10:30:00","lastInstanceDateTimeUtc":"2026-11-28T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"This course offers a great introduction into the tools and techniques needed for creating prints from wood engravings. Working with an end grain practice block as well as a resin one, you’ll use traditional wood engraving tools to create your designs. From these blocks you will then create wonderful repeat patterns on Japanese papers. At the end of the class, you’ll be able to take away a small collection of repeat pattern prints, as well as the blocks which can be worked on and re-printed in the future.","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Introduction to Wood Engraving (January 2027)","instanceDates":"17 January-17 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958232ALJDPNNMDKRHPPLSKLNCNTGRQBC","firstInstanceDateTime":"2027-01-17T10:30:00","firstInstanceDateTimeUtc":"2027-01-17T10:30:00Z","lastInstanceDateTime":"2027-01-17T10:30:00","lastInstanceDateTimeUtc":"2027-01-17T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"This course offers a great introduction into the tools and techniques needed for creating prints from wood engravings. Working with an end grain practice block as well as a resin one, you’ll use traditional wood engraving tools to create your designs. From these blocks you will then create wonderful repeat patterns on Japanese papers. At the end of the class, you’ll be able to take away a small collection of repeat pattern prints, as well as the blocks which can be worked on and re-printed in the future.","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Introduction to Wood Engraving (October 2026)","instanceDates":"18 October-18 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955232AKHRVKBMPSMMQNNPSTPRGJRSHBD","firstInstanceDateTime":"2026-10-18T10:30:00","firstInstanceDateTimeUtc":"2026-10-18T09:30:00Z","lastInstanceDateTime":"2026-10-18T10:30:00","lastInstanceDateTimeUtc":"2026-10-18T09:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: U / Director: Frank Capra / Country: USA / Year: 1946 / Duration: 2h 10m \r\n\r\nScreening It's a Wonderful Life is a DCA tradition, so we’re delighted to announce it will be gracing our screens once again this year in celebration of its 80th anniversary.  \r\n\r\nMade to give hope to post-war America, the film shows us all the hardships of life, yet in a final sublime moment, reminds us why every individual matters and why life is worth living. Nearly 80 years on, It’s a Wonderful Life not only continues to give comfort but remains as vital and relevant as ever.  \r\n\r\nBeset with personal and professional problems, George Bailey finds his previously happy life falling apart around him on Christmas Eve. Seeing no way out, George considers suicide from the edge of a bridge - but Clarence, his guardian angel, intervenes and shows George what his beloved hometown of Bedford Falls would be like without him. Shocked by what he sees and at the unforeseen circumstances of his absence, George reconsiders and begs Clarence to return him to the problems of the present and the loving community he has fostered throughout his life. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"It's a Wonderful Life (80th Anniversary)","instanceDates":"19 December-24 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982633ARHQCHDPDTQDDQLBMCTLRRDCBTK","firstInstanceDateTime":"2026-12-19T15:00:00","firstInstanceDateTimeUtc":"2026-12-19T15:00:00Z","lastInstanceDateTime":"2026-12-24T17:00:00","lastInstanceDateTimeUtc":"2026-12-24T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Christmas","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Gain an insight into the ancient art form of ‘Shodo’, the ‘Way of the Brush’. Experience an ink grinding meditation to centre and still the mind. Experience drawing a Zen circle, draw numerous characters using different styles of calligraphy, and explore the use of various kinds of brushes. You will learn how to hold and use a traditional brush, and how to structure a Kanji (a Chinese character). You will practise several styles of brush calligraphy, with the opportunity to use different brushes and work on different scales. Add the finishing touch to your favourite works by placing the signature in the shape of a name seal.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Japanese Brush Calligraphy (November 2026)","instanceDates":"22 November-22 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957232AQHHHHTMQCMQJMJJGLLTJBBGBGJ","firstInstanceDateTime":"2026-11-22T10:30:00","firstInstanceDateTimeUtc":"2026-11-22T10:30:00Z","lastInstanceDateTime":"2026-11-22T10:30:00","lastInstanceDateTimeUtc":"2026-11-22T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: 18 / Director:  Ken Russell / Country: UK  \r\nYear: 1971  / Duration: 1h 51m \r\n\r\nCensored for more than half a century, Ken Russell’s visionary and controversial The Devils returns to UK cinemas. Fully restored in 4K and cut to Russell’s direction, this is the first publicly released version of the film as intended by the filmmaker. This definitive version arrives 55 years after the film’s original release This release marks the first time Russell’s defining masterpiece has been made officially accessible to the public. \r\n\r\nAn enduring masterpiece of cinema starring Oliver Reed and Vanessa Redgrave, Ken Russell’s The Devils is a prescient epic of obsession and corruption, and a defining work of art from the seminal British filmmaker Ken Russell, director of such films as Tommy, Altered States, and The Lair of the White Worm. Russell was a true disruptor, and a singular figure in British cinema, straddling high art and real transgression.  \r\n\r\nInspired by the true story of 17th-century priest Urbain Grandier, accused of bewitching a convent of nuns, the film lays bare the collusion of church and state through a searing vision of religious persecution, collective hysteria and institutional corruption. In addition to powerhouse performances from Reed and Redgrave, Ken Russell’s The Devils showcases the stunning work of artists at the peak of their craft: Academy Award-winning cinematographer David Watkin (Out of Africa, Chariots of Fire); editor Michael Bradsell (Local Hero, Jabberwocky); and visual artist Derek Jarman (Jubilee, Caravaggio), whose work as production designer marked his feature film debut.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Ken Russell's The Devils (4K Restoration)","instanceDates":"1 November-4 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981833ARGBGCKDGRHCGGDVVHQJNRQNCCG","firstInstanceDateTime":"2026-11-01T17:30:00","firstInstanceDateTimeUtc":"2026-11-01T17:30:00Z","lastInstanceDateTime":"2026-11-04T15:00:00","lastInstanceDateTimeUtc":"2026-11-04T15:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Vintage","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"In this lo-fi workshop, you'll learn how to make experimental, abstract images. Known as ‘chemigrams’, these lie somewhere between photography and painting. This process involves using light-sensitive paper, photographic chemicals and household products, including oil, masking tape, lemon juice and toothpaste. Plant based developers will be used alongside traditional darkroom chemicals to develop your images. There will also be to try making photographic prints with Vaseline and leaves/feathers.","htmlDescription":"<div id>\r\n\r\n</div>","duration":240,"imageUrl":"","isOnSale":true,"name":"Kitchen Darkroom Photography (November 2026)","instanceDates":"29 November-29 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955434AGJSBDDSKGJLHSHLSBPDRGRNDCQ","firstInstanceDateTime":"2026-11-29T12:00:00","firstInstanceDateTimeUtc":"2026-11-29T12:00:00Z","lastInstanceDateTime":"2026-11-29T12:00:00","lastInstanceDateTimeUtc":"2026-11-29T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn the very basics of lithography in this fun, lo-fi workshop. Experiment with this form of printmaking using materials found in your kitchen, such as tinfoil and fizzy drinks. The process results in detailed drawn images.","htmlDescription":"<div id>\r\n\r\n</div>","duration":330,"imageUrl":"","isOnSale":true,"name":"Kitchen Lithography (January 2027)","instanceDates":"30 January-30 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957833AVSDTDJQCKHVDLLJPPLHCLKLNVC","firstInstanceDateTime":"2027-01-30T10:30:00","firstInstanceDateTimeUtc":"2027-01-30T10:30:00Z","lastInstanceDateTime":"2027-01-30T10:30:00","lastInstanceDateTimeUtc":"2027-01-30T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Use letterpress to design and print a Victorian style poster.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Letterpress: Victorian Poster (December 2026)","instanceDates":"5 December-5 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955436ARDPBDNPMPTRTSRTGBPQDDLCHDM","firstInstanceDateTime":"2026-12-05T10:30:00","firstInstanceDateTimeUtc":"2026-12-05T10:30:00Z","lastInstanceDateTime":"2026-12-05T10:30:00","lastInstanceDateTimeUtc":"2026-12-05T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Puccini / 2h35m\r\nSoprano Vida Miknevičiūtė makes her role debut as Minnie, the tough tavern owner with a heart of gold who finds love when she least expects it. Tenor SeokJong Baek is the dashing bandit who rambles into the remote California mining town to steal her heart, opposite baritone Christopher Maltman as the lawman determined to deliver justice—and win Minnie for himself.","htmlDescription":"<div id>\r\n\r\n</div>","duration":195,"imageUrl":"","isOnSale":true,"name":"Live from the Met: La Fanciulla del West","instanceDates":"23 January-23 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927035AHKNKVGQJPVHTLBRQQHVDDTJBVD","firstInstanceDateTime":"2027-01-23T18:00:00","firstInstanceDateTimeUtc":"2027-01-23T18:00:00Z","lastInstanceDateTime":"2027-01-23T18:00:00","lastInstanceDateTimeUtc":"2027-01-23T18:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Verdi / 3h29m\r\n\r\nNew production of Verdi's opera starring Lide Davidsen as Lady Macbeth and baritone Quinn Kelsey as the Scottish king. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":209,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Macbeth","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927033AVBJLNMVGRRHTLLJHMLHHCVHNVC","firstInstanceDateTime":"2026-10-17T18:00:00","firstInstanceDateTimeUtc":"2026-10-17T17:00:00Z","lastInstanceDateTime":"2026-10-17T18:00:00","lastInstanceDateTimeUtc":"2026-10-17T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Jules Massenet / 4h24m\r\nSuperstar soprano Nadine Sierra takes on another alluring French heroine, the irresistible title character of Massenet’s passionate drama.","htmlDescription":"<div id>\r\n\r\n</div>","duration":264,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Manon","instanceDates":"3 April-3 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927432AMBSMBTDBMMVQQKBBQLLHHQKRJR","firstInstanceDateTime":"2027-04-03T17:00:00","firstInstanceDateTimeUtc":"2027-04-03T16:00:00Z","lastInstanceDateTime":"2027-04-03T17:00:00","lastInstanceDateTimeUtc":"2027-04-03T16:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Verdi / 3h21m\r\nOne of today’s leading dramatic tenors, Brian Jagde, takes on the tour-de-force title role of what many consider the ultimate Italian opera. Verdi’s monumental Shakespearean tragedy also features soprano Ailyn Pérez in her company role debut as the long-suffering Desdemona, alongside baritone Artur Ruciński as the sinister Iago.","htmlDescription":"<div id>\r\n\r\n</div>","duration":201,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Otello ","instanceDates":"24 April-24 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927632AKMCHCLRSDGQSHJGPKRDNRDQSQV","firstInstanceDateTime":"2027-04-24T18:00:00","firstInstanceDateTimeUtc":"2027-04-24T17:00:00Z","lastInstanceDateTime":"2027-04-24T18:00:00","lastInstanceDateTimeUtc":"2027-04-24T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Wagner / 6h5m\r\nA profound philosophical meditation on compassion and reconciliation, this transcendent rendering of a medieval knight’s heroic quest for the Holy Grail returns to the big screen in François Girard’s celebrated production.","htmlDescription":"<div id>\r\n\r\n</div>","duration":365,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Parsifal","instanceDates":"5 June-5 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927832ABGMVTQRCDVQCKQTVKDMJVHBSLQ","firstInstanceDateTime":"2027-06-05T17:00:00","firstInstanceDateTimeUtc":"2027-06-05T16:00:00Z","lastInstanceDateTime":"2027-06-05T17:00:00","lastInstanceDateTimeUtc":"2027-06-05T16:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Saint-Saens / 3h54m\r\nSaint-Saëns’s spectacular take on the biblical hero of legendary strength and the seductive Philistine whose beauty overpowers him, returns in the Met’s larger-than-life production starring Clay Hilley, Aigul Akmetshina and Quinn Kelsey.","htmlDescription":"<div id>\r\n\r\n</div>","duration":234,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Samson et Dalila","instanceDates":"5 December-5 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927034ARBQPVBJLJKNNJTKDVGBCLSHRPP","firstInstanceDateTime":"2026-12-05T17:00:00","firstInstanceDateTimeUtc":"2026-12-05T17:00:00Z","lastInstanceDateTime":"2026-12-05T17:00:00","lastInstanceDateTimeUtc":"2026-12-05T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Kevin Puts / 3h\r\n\r\nThis Pulitzer Prize-winning opera by Kevin Puts takes the audience directly to the battlefields of the Western Front with a star-studded cast, featuring soprano Elza van den Heever and tenors Ben Bliss and Rolando Villazón.","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"Live from the Met: Silent Night","instanceDates":"20 March-20 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"927232ADPTKVBHKGLMBVGCVKNQRSHLVPT","firstInstanceDateTime":"2027-03-20T17:00:00","firstInstanceDateTimeUtc":"2027-03-20T17:00:00Z","lastInstanceDateTime":"2027-03-20T17:00:00","lastInstanceDateTimeUtc":"2027-03-20T17:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Live From The Met","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Live Performance Screening","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn how to fold paper into sections and then sew them into covers using the same methods that have been used since the Middle Ages. Incorporate leather elements and decorative stitches to create unusual books that you could use as a gift or keep for yourself as a journal or scrapbook.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Long Stitch Bookbinding (October 2026)","instanceDates":"21 October-21 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955432ANHSCLKKNGHPCSRNJHGNSBHBJPB","firstInstanceDateTime":"2026-10-21T18:00:00","firstInstanceDateTimeUtc":"2026-10-21T17:00:00Z","lastInstanceDateTime":"2026-10-21T18:00:00","lastInstanceDateTimeUtc":"2026-10-21T17:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Dave Robinson / Country: UK /Year: 1981 / Duration: 1h26m\r\n\r\nTake It Or Leave It, originally released in 1981, is the highly entertaining and brilliantly nostalgic story of how Madness, one of the most successful and enduring British bands of all time, originally got together. \r\n\r\nFilmed after Madness enjoyed a bunch of Top 10 singles, endearing themselves to the British public with the humour of their iconic music videos, the film travels back in time, chronicling how seven mates living in 1970s Camden Town formed a band. It details the jobs they left behind, the line-up changes, the rows, the laughs, and how their distinctive ska-pop ‘Nutty Sound’ evolved. \r\n\r\nFeaturing classic songs including One Step Beyond, Night Boat to Cairo and Embarrassment. The cinema release will be supported by a brand-new trailer and new quad poster. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":86,"imageUrl":"","isOnSale":true,"name":"Madness: Take it or Leave It (4K Restoration)","instanceDates":"10 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"976032ABGLPHDCJSKTKTLHGDPKSSCQCSS","firstInstanceDateTime":"2026-10-10T20:30:00","firstInstanceDateTimeUtc":"2026-10-10T19:30:00Z","lastInstanceDateTime":"2026-10-15T17:45:00","lastInstanceDateTimeUtc":"2026-10-15T16:45:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Vintage","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn how to create beautiful swirling patterns. Make marble patterns in different tones onto etching plates. Perfect for the those who want to add to their etching skills portfolio.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Marbling Etching (February 2027)","instanceDates":"6 February-6 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957035ABBBBCHGVCTPTLJTTVDQKDNGLHK","firstInstanceDateTime":"2027-02-06T10:30:00","firstInstanceDateTimeUtc":"2027-02-06T10:30:00Z","lastInstanceDateTime":"2027-02-06T10:30:00","lastInstanceDateTimeUtc":"2027-02-06T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Age 7+\r\nDirector: Marcel Barelli \r\nCountries of Production: Switzerland, Belgium \r\nLanguage: French with English subtitles \r\nDuration: 1h 12min \r\nYear: 2025 \r\nIn 1811, Mary Anning spends her days searching for fossils on the Dorset coast. Her father suddenly disappears, leaving behind a mysterious drawing and a struggling family. As we follow Mary on her journey, she goes on to discover more than just fossils: friendships, adventures, and the very start of palaeontology. \r\n\r\nThe film celebrates the early contributions of real-life British palaeontologist Mary Anning (1799 – 1847), whose discoveries in Jurassic marine fossils on the Southwest coast of England contributed to changes in scientific thinking about prehistoric life. Using stunning 2D animation, where each frame is painstakingly crafted by hand, and a punk rock soundtrack, this is the perfect film to introduce the youngest audiences to the history and legacy of a woman who defied societal expectations. An empowering and inspiring true story about remaining curious and audacious, believing in yourself and questioning the systems that confine you. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":72,"imageUrl":"","isOnSale":true,"name":"Mary Anning","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"971635AHLDCNKDSRPHDLBNMMLSLJGQRQQ","firstInstanceDateTime":"2026-11-07T11:30:00","firstInstanceDateTimeUtc":"2026-11-07T11:30:00Z","lastInstanceDateTime":"2026-11-07T11:30:00","lastInstanceDateTimeUtc":"2026-11-07T11:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Advance your knowledge of Japanese woodblock printing in this three-day masterclass. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Masterclass: Mokuhanga (Japanese Woodblock) (March 2027)","instanceDates":"26 March-26 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"960032ASMDHDJVJPLDPBSSGLDJQMLPSTD","firstInstanceDateTime":"2027-03-26T10:30:00","firstInstanceDateTimeUtc":"2027-03-26T10:30:00Z","lastInstanceDateTime":"2027-03-26T10:30:00","lastInstanceDateTimeUtc":"2027-03-26T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_Catergory":"Masterclass","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":""},{"description":"Join us for messy, sensory and creative sessions for little ones. These messy sessions respond to our exhibitions, with activities designed to give little ones a chance to explore art materials and make their mark. You can expect an art activity, a sensory play activity and lots of ideas for things to do at home or out and about. There are a variety of days and times available each month to give as many people as possible the chance to try the activities. Each session will be led by an art therapist and an artist tutor, with activities changing each month. As the name suggests, these sessions can get messy and we recommend dressing with this in mind. At the end of each session we provide a warm water bath and towels for clean up. Occasionally these sessions are observed by university students for research purposes.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Messy Play for 0-3s (December 2026)","instanceDates":"8 December-13 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"941833AVDQJBTSVRGLKKSSLRTRRQHSJTQ","firstInstanceDateTime":"2026-12-08T10:30:00","firstInstanceDateTimeUtc":"2026-12-08T10:30:00Z","lastInstanceDateTime":"2026-12-13T10:00:00","lastInstanceDateTimeUtc":"2026-12-13T10:00:00Z","altText":"","attribute_AccountCode":"LEARNDWYC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Join us for messy, sensory and creative sessions for little ones. These messy sessions respond to our exhibitions, with activities designed to give little ones a chance to explore art materials and make their mark. You can expect an art activity, a sensory play activity and lots of ideas for things to do at home or out and about. There are a variety of days and times available each month to give as many people as possible the chance to try the activities. Each session will be led by an art therapist and an artist tutor, with activities changing each month. As the name suggests, these sessions can get messy and we recommend dressing with this in mind. At the end of each session we provide a warm water bath and towels for clean up. Occasionally these sessions are observed by university students for research purposes.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Messy Play for 0-3s (November 2026)","instanceDates":"13 November-15 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"942033ACKMHJSLHBPQJGJJGSKRSGSNGQG","firstInstanceDateTime":"2026-11-13T10:30:00","firstInstanceDateTimeUtc":"2026-11-13T10:30:00Z","lastInstanceDateTime":"2026-11-15T10:00:00","lastInstanceDateTimeUtc":"2026-11-15T10:00:00Z","altText":"","attribute_AccountCode":"LEARNDWYC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Education","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to make prints using this form of lithography developed in Japan. Mokulito is a form of lithography developed in the 1970s, which replaces the stone matrix surface with wood. The term Mokulito derives from the Japanese words ‘Moku’ meaning wood and ‘Lito’ meaning Lithography. Learn how to make prints using this wonderful process, that infuses the unique grain of the wood matrix along with hand painted marks and incisions of the artist.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Mokulito: Japanese Wood Lithography (January 2027)","instanceDates":"23 January-23 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955636APVMHVPNKTKNCBCPDLKDQRQMLBL","firstInstanceDateTime":"2027-01-23T10:30:00","firstInstanceDateTimeUtc":"2027-01-23T10:30:00Z","lastInstanceDateTime":"2027-01-23T10:30:00","lastInstanceDateTimeUtc":"2027-01-23T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Join fashion and textile designer and printmaker Beca Lipscombe in conversation with Dan Brown, DCA's Head of Exhibitions, as they explore the work of France-Lise McGurn through the lens of their shared experience of growing up in Scotland's Central Belt during the 1980s and 1990s. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Murals, Mums and What Every Woman Wants: France-Lise McGurn, Fashion and Public Space  ","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"953632AQQBCDQSJMSKGVQBGPLSHQHTRDN","firstInstanceDateTime":"2026-10-24T14:00:00","firstInstanceDateTimeUtc":"2026-10-24T13:00:00Z","lastInstanceDateTime":"2026-10-24T14:00:00","lastInstanceDateTimeUtc":"2026-10-24T13:00:00Z","altText":"","attribute_AccountCode":"GAL","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Exhibitions","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: tbc / Director: Yuval Abraham and Rachel Szor / Country: UK/ USA/ Israel / Year: 2026 / \r\nDuration: 1h20m \r\n\r\nShot at night on the rooftops of Tel Aviv, the film reveals in detail the systems behind Israel’s calculated mass killing of Palestinian civilians in Gaza. NAZA is a military acronym euphemistically used by Israeli intelligence to indicate the number of civilians that it expects will be killed in an airstrike. \r\n\r\nThe film is directed by Yuval Abraham and Rachel Szor, two of the four co-directors of the 2024 Oscar-winning documentary NO OTHER LAND, and produced by The Guardian and James Wilson (JW Films) and executive produced by Jonathan Glazer (The Zone of Interest). ","htmlDescription":"<div id>\r\n\r\n</div>","duration":80,"imageUrl":"","isOnSale":true,"name":"NAZA","instanceDates":"16 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"979832ALLBJBCJGPHLVPKVBLDGJTMHNGQ","firstInstanceDateTime":"2026-10-16T13:00:00","firstInstanceDateTimeUtc":"2026-10-16T12:00:00Z","lastInstanceDateTime":"2026-10-22T15:15:00","lastInstanceDateTimeUtc":"2026-10-22T14:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Documentary","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate:  15 tbc \r\nDirector: Sam Yates \r\nDuration:  3h tbc \r\nDistributor: NT Live  \r\n\r\nJosh O’Connor (The Crown; Challengers) leads the cast in this searing revival of Clifford Odets’ knockout American classic.  \r\n\r\n1930s New York, at the height of the Depression. Joe Bonaparte is a gifted young violinist with a future in music, until a chance at fame and fortune lures him into the brutal world of professional boxing. He must confront what he’s willing to sacrifice, who he’s willing to become and how to find his place in a world that demands he choose a side.  \r\n\r\nBrought to life with a live string quartet and filmed live from the Almeida Theatre, Olivier Award-winner Sam Yates (Vanya) directs this propulsive drama exploring ambition, identity, and the high price of success.   ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"NT Live: Golden Boy ","instanceDates":"5 November-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954032AKCSHCJJRVHSCMNKLKJQLNKCLSJ","firstInstanceDateTime":"2026-11-05T19:00:00","firstInstanceDateTimeUtc":"2026-11-05T19:00:00Z","lastInstanceDateTime":"2026-11-05T19:00:00","lastInstanceDateTimeUtc":"2026-11-05T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"NT Live","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Alternative content","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate:  12A / Director: Emily Burns / Duration:  2h 40m \r\n\r\nEmmy and Tony winner Christine Baranski makes her West End debut alongside Academy Award-nominated stage and screen legend Richard E. Grant in Noël Coward’s irresistible comedy. \r\n\r\nJudith Bliss retired from her life-on-stage and she misses the applause. Idling away at their country home, the rest of the family are too self-involved to be a good audience. So, Judith invites a young fan as her guest for the weekend. But unbeknownst to her, each of the Blisses has a guest of their own arriving at the very same time.  \r\n\r\nFilmed live from the West End, Emily Burns directs this stinging new production. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":160,"imageUrl":"","isOnSale":true,"name":"NT Live: Hay Fever","instanceDates":"14 January-14 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"983232AGNRVNBGCQKNPTJBNJCGLBMTPVT","firstInstanceDateTime":"2027-01-14T19:00:00","firstInstanceDateTimeUtc":"2027-01-14T19:00:00Z","lastInstanceDateTime":"2027-01-14T19:00:00","lastInstanceDateTimeUtc":"2027-01-14T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"NT Live","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Alternative content","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate:  15 / Director: Sam Mendes / Duration:  3h  \r\n\r\nThe fierce and funny five-star play returns to the big screen. Sam Mendes (The Lehman Trilogy) directs Mark Gatiss in an Olivier Award-winning performance as John Gielgud. \r\n\r\n1964: Richard Burton (Johnny Flynn), newly married to Elizabeth Taylor (Tuppence Middleton), is set to play the title role in an experimental new Broadway production of Hamlet under Gielgud’s exacting direction. But as rehearsals progress, two ages of theatre collide and the collaboration between actor and director soon threatens to unravel. \r\n\r\nFrom multi-award-winning writer Jack Thorne (Adolescence), this acclaimed production was filmed live during its sold-out London run in 2023. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":180,"imageUrl":"","isOnSale":true,"name":"NT Live: The Motive and the Cue","instanceDates":"18 February-18 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"983432ABCLDQPPKDBKNLDTSNTPMTBVLBR","firstInstanceDateTime":"2027-02-18T19:00:00","firstInstanceDateTimeUtc":"2027-02-18T19:00:00Z","lastInstanceDateTime":"2027-02-18T19:00:00","lastInstanceDateTimeUtc":"2027-02-18T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"NT Live","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Alternative content","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age: 10+\r\nDirector: Irene Iborra Rizo \r\nCountries of Production: Spain, France, Belgium, Switzerland \r\nLanguage: Catalan with English subtitles \r\nDuration: 1h 11min \r\nYear: 2025 \r\nOlivia, her little brother Tim, and their mother Ingrid are forced to leave their home and start over in a different neighbourhood. While Ingrid struggles to resolve the situation, Olivia invents a protective fantasy for herself and her brother: everything they're experiencing isn't real; they're filming a movie. But this fantasy has unexpected consequences. Fortunately, a new family forms around them, with whom they'll experience incredible adventures. Amid laughter, tears, magic, and friendship, they will discover they are indeed the incredible everyday heroes of their own lives. \r\n\r\nOlivia and the Invisible Earthquake tackles, from a child’s point of view, difficult subjects with great tenderness and a real warmth. Set in the vibrant and colourful streets of Barcelona, the film captures the city’s spirit, energy, and close-knit communities willing to step up to help each other. This beautiful stop-motion animation allows young audiences to embrace the story from a “safe distance”, without being overwhelmed by its realism, but still identifying with the characters. An ode to life, the film shows us the importance of community and being able to ask for help, and the vital power we all have: the ability to choose how we respond to what happens to us. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":71,"imageUrl":"","isOnSale":true,"name":"Olivia and the Invisible Earthquake","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"972032ADSSJQBNRQNBCQNBQVKLHLCGQTJ","firstInstanceDateTime":"2026-10-31T13:30:00","firstInstanceDateTimeUtc":"2026-10-31T13:30:00Z","lastInstanceDateTime":"2026-10-31T13:30:00","lastInstanceDateTimeUtc":"2026-10-31T13:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age: 0+ (recommended for ages 5+) \r\nDirector: Priscilla Kellen \r\nCountry of Production: Brazil \r\nLanguage: No dialogue \r\nDuration: 1h 14min \r\nYear: 2025 \r\n\r\nPassionate about the idea of flying, a tiny papaya seed struggles to conform to what’s expected of her and earn her mother’s pride. Her curiosity and uncontrollable desire for freedom make her different from other seeds and when she realises that her destiny is to become a tree, she rebels.  \r\n\r\nFighting against her nature, Papaya stays in constant motion to avoid rooting. On her journey away from the mother tree, she learns a great deal about the creatures of the forest, travelling to a strange industrial world. Through perseverance, she discovers the power of her roots, connecting life through deep and mysterious paths, and triggering a major revolution which transforms her environment, making her dreams come true in an unexpected way. \r\n\r\nWith its uplifting soundtrack and vibrant colours, Papaya lets imagination take centre stage telling a story of resistance and coming to terms with change. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":74,"imageUrl":"","isOnSale":true,"name":"Papaya","instanceDates":"8 November-8 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"972632AJMGKGQJVQGKPLNDGLRDGPHPKQL","firstInstanceDateTime":"2026-11-08T11:30:00","firstInstanceDateTimeUtc":"2026-11-08T11:30:00Z","lastInstanceDateTime":"2026-11-08T11:30:00","lastInstanceDateTimeUtc":"2026-11-08T11:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Swap technology for a lo-fi form of photography using your own hand made tin box camera. \r\n\r\nLearn how to make a workable film camera using a coffee or biscuit tin from your kitchen cupboards. These cameras roll back the years to when photography was a new science. \r\n\r\nOnce you’ve build your camera, you’ll take some snaps it and then learn how to develop paper photos in a professional darkroom.","htmlDescription":"<div id>\r\n\r\n</div>","duration":240,"imageUrl":"","isOnSale":true,"name":"Pinhole Camera (January 2027)","instanceDates":"17 January-17 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955635AMDJBHTGTCHSGKCSLBGKNMVKQSK","firstInstanceDateTime":"2027-01-17T12:00:00","firstInstanceDateTimeUtc":"2027-01-17T12:00:00Z","lastInstanceDateTime":"2027-01-17T12:00:00","lastInstanceDateTimeUtc":"2027-01-17T12:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: tbc / Director: Lee Chang-dong / Country: South Korea/ USA / Year: 2026 / Duration: 2h44m / Language: Korean with English subtitles  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":164,"imageUrl":"","isOnSale":true,"name":"Possible Love","instanceDates":"30 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982432ANVLRDTNKLKGDSHLJDSMDPBDLQG","firstInstanceDateTime":"2026-10-30T13:30:00","firstInstanceDateTimeUtc":"2026-10-30T13:30:00Z","lastInstanceDateTime":"2026-11-05T14:15:00","lastInstanceDateTimeUtc":"2026-11-05T14:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18 / Director: Lance Oppenheim / \r\nCountry: USA / Year: 2026 / Duration: 1h50m ","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"Primetime","instanceDates":"30 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982232ALPQSMTJMMVPSBDHRHSKVMDRGRB","firstInstanceDateTime":"2026-10-30T15:00:00","firstInstanceDateTimeUtc":"2026-10-30T15:00:00Z","lastInstanceDateTime":"2026-11-05T20:15:00","lastInstanceDateTimeUtc":"2026-11-05T20:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"12A / Garth Jennings / UK 2026 / 1h 39m + 30m Q&A A tribute to Pulp, with concert tour footage, archive video, interviews with the band and more. Recorded Q&A after the screening. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":130,"imageUrl":"","isOnSale":true,"name":"Pulp: What Do You Do for an Encore + Recorded Q&A","instanceDates":"14 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"979432AQJLMRHGDKVLSRJVDDSMCSLTVRL","firstInstanceDateTime":"2026-10-14T20:30:00","firstInstanceDateTimeUtc":"2026-10-14T19:30:00Z","lastInstanceDateTime":"2026-10-14T20:30:00","lastInstanceDateTimeUtc":"2026-10-14T19:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Documentary","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 15 / Director: Lance Hammer / Country: UK/ USA / Year: 2026 / Duration: 2h2m\r\n\r\nQueen at Sea follows Amanda (Binoche) and her stepfather, Martin (Courtenay), at odds over a moral quandary involving Amanda’s mother, Leslie (Calder-Marshall). In the advanced stages of dementia, they quarrel over whether Leslie has lost all ability to make critical decisions in her own best interests, and, if so, who is responsible – a spouse, a child, an institution – for making such a determination? As Amanda and Martin are forced to make increasingly difficult choices, the repercussions spiral out of their control. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":121,"imageUrl":"","isOnSale":true,"name":"Queen at Sea","instanceDates":"9 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"975432ANLJVTLNLSSHLMRHDBVBGDGMTVJ","firstInstanceDateTime":"2026-10-09T15:00:00","firstInstanceDateTimeUtc":"2026-10-09T14:00:00Z","lastInstanceDateTime":"2026-10-15T20:15:00","lastInstanceDateTimeUtc":"2026-10-15T19:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Explore a variety of methods to produce single and multiple colour prints. This course will cover use of tools, equipment and techniques for both reduction and multi-block printing. You'll learn how to make a lino print, from how to transfer your design onto a lino block to printing your design using oil-based inks and a Victorian relief printing press. The course will also introduce a few ideas for achieving half-tones or texture and you'll leave with a small portfolio of prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Reduction Lino Printing (December 2026)","instanceDates":"12 December-12 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957632AHTVCLRPCCKNPKRDVJMNNQLKGHV","firstInstanceDateTime":"2026-12-12T10:30:00","firstInstanceDateTimeUtc":"2026-12-12T10:30:00Z","lastInstanceDateTime":"2026-12-12T10:30:00","lastInstanceDateTimeUtc":"2026-12-12T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Explore a variety of methods to produce single and multiple colour prints. This course will cover use of tools, equipment and techniques for both reduction and multi-block printing. You'll learn how to make a lino print, from how to transfer your design onto a lino block to printing your design using oil-based inks and a Victorian relief printing press. The course will also introduce a few ideas for achieving half-tones or texture and you'll leave with a small portfolio of prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":420,"imageUrl":"","isOnSale":true,"name":"Reduction Lino Printing (February 2027)","instanceDates":"27 February-27 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954433APVRGSJPNTTLRNNVBDSHQPHBLGQ","firstInstanceDateTime":"2027-02-27T10:30:00","firstInstanceDateTimeUtc":"2027-02-27T10:30:00Z","lastInstanceDateTime":"2027-02-27T10:30:00","lastInstanceDateTimeUtc":"2027-02-27T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Age: 0+ (recommended for ages 7+) Dirs: Various Various countries 2025 – 2026 / 53min / Dialogue free Themes: Prehistoric Times, waste and the environment, friendship, learning to change, fantasy and imagination, accepting differences, music for self-expression. This collection of short films from Romania, Czech Republic, Belgium, Hungary, Italy and the UK present stories that are perfectly suited for learners aged 7+. Using a wide range of animation techniques, these films explore the importance of imagination and learning from each other, and how friendship and collaboration help us through challenges. On the first day of winter, two little stoats must learn to adapt to their new surroundings; a lonely mythical boy whose head shines like the sun, struggles to make friends in the clouds but when he falls down to Earth, everything changes; two little emergency workers from a strange planet go on an emergency mission to save one of their friends who has been crushed by debris falling from the sky; a small prehistoric amphibian goes on a journey with the goal of finding its mate; a sand creature and a baby sea turtle meet by a sudden turn of events; a bored boy leaves his bed-building task for a magical mushroom realm of endless possibilities, away from his father’s supervision. All these short films are dialogue free.","htmlDescription":"<div id>\r\n\r\n</div>","duration":53,"imageUrl":"","isOnSale":true,"name":"Relaxed: Discovery Shorts for Families 2026","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"973032ARCMBCJNRTDGGKLKTPHRQTDHGJK","firstInstanceDateTime":"2026-11-07T13:30:00","firstInstanceDateTimeUtc":"2026-11-07T13:30:00Z","lastInstanceDateTime":"2026-11-07T13:30:00","lastInstanceDateTimeUtc":"2026-11-07T13:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"\r\nAge: 0+ (recommended for ages 3+) Dirs: Various Various countries 2025 – 2026 / 40min / Dialogue free Always a popular feature of any Discovery Film Festival, this collection of seven short films for our youngest viewers is sure to delight and amuse. We’ve gathered a variety of stories and styles from France, Belgium, Switzerland, Germany, Croatia, and Singapore. Featuring bats helping bugs, a tiny but adventurous mouse, a farm dog willing to share his food with a chicken, a cheeky squirrel in search of a walnut, a dancing snowman, a porcelain dog’s chase for its ball through a pottery shelf, and a human fish creature. The films in this programme focus on curiosity and discovery, surprising friendships; promoting kindness and finding new perspectives. All these short films are dialogue free.","htmlDescription":"<div id>\r\n\r\n</div>","duration":40,"imageUrl":"","isOnSale":true,"name":"Relaxed: Discovery Shorts for Wee Ones 2026","instanceDates":"8 November-8 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"972832AGGJHHPBNGNSMTSTQBLTSQHQGKT","firstInstanceDateTime":"2026-11-08T13:30:00","firstInstanceDateTimeUtc":"2026-11-08T13:30:00Z","lastInstanceDateTime":"2026-11-08T13:30:00","lastInstanceDateTimeUtc":"2026-11-08T13:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn all about the wonderful world of Risograph printing and create multilayered prints. ‘Riso’ is a fast-paced process that uses soy based inks and recycled paper. This course is perfect for using all kinds of hand drawn techniques and collage to create richly coloured multi-layered prints. You'll learn how to prepare your design by using collage, drawing, and painting in colour-separated layers. Then you'll print your design by choosing from our selection of bright colours.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Riso Printing (Beginners) (December 2026)","instanceDates":"10 December-10 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956233ABTKPLRVBDNGMMDMPPHVRCGKKBP","firstInstanceDateTime":"2026-12-10T18:00:00","firstInstanceDateTimeUtc":"2026-12-10T18:00:00Z","lastInstanceDateTime":"2026-12-10T18:00:00","lastInstanceDateTimeUtc":"2026-12-10T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn all about the wonderful world of Risograph printing and create multilayered prints. ‘Riso’ is a fast-paced process that uses soy based inks and recycled paper. This course is perfect for using all kinds of hand drawn techniques and collage to create richly coloured multi-layered prints. You'll learn how to prepare your design by using collage, drawing, and painting in colour-separated layers. Then you'll print your design by choosing from our selection of bright colours.","htmlDescription":"<div id>\r\n\r\n</div>","duration":330,"imageUrl":"","isOnSale":true,"name":"Riso Printing (Beginners) (February 2027)","instanceDates":"20 February-20 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956036AQCRLPMBDDBBNLGPRKDRCRTNDGS","firstInstanceDateTime":"2027-02-20T10:30:00","firstInstanceDateTimeUtc":"2027-02-20T10:30:00Z","lastInstanceDateTime":"2027-02-20T10:30:00","lastInstanceDateTimeUtc":"2027-02-20T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn all about the wonderful world of Risograph printing and create multilayered prints. ‘Riso’ is a fast-paced process that uses soy based inks and recycled paper. This course is perfect for using all kinds of hand drawn techniques and collage to create richly coloured multi-layered prints. You'll learn how to prepare your design by using collage, drawing, and painting in colour-separated layers. Then you'll print your design by choosing from our selection of bright colours.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Riso Printing (Beginners) (January 2027)","instanceDates":"12 January-12 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957633AHPBVRQCGHQPVLLDDBSQGDSDTMB","firstInstanceDateTime":"2027-01-12T18:00:00","firstInstanceDateTimeUtc":"2027-01-12T18:00:00Z","lastInstanceDateTime":"2027-01-12T18:00:00","lastInstanceDateTimeUtc":"2027-01-12T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn all about the wonderful world of Risograph printing and create multilayered prints. ‘Riso’ is a fast-paced process that uses soy based inks and recycled paper. This course is perfect for using all kinds of hand drawn techniques and collage to create richly coloured multi-layered prints. You'll learn how to prepare your design by using collage, drawing, and painting in colour-separated layers. Then you'll print your design by choosing from our selection of bright colours.","htmlDescription":"<div id>\r\n\r\n</div>","duration":330,"imageUrl":"","isOnSale":true,"name":"Riso Printing (Beginners) (November 2026)","instanceDates":"14 November-14 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956033ASPSKSLBQMSTKQBTBRLQGDJVMCG","firstInstanceDateTime":"2026-11-14T10:30:00","firstInstanceDateTimeUtc":"2026-11-14T10:30:00Z","lastInstanceDateTime":"2026-11-14T10:30:00","lastInstanceDateTimeUtc":"2026-11-14T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn all about the wonderful world of Risograph printing and create multilayered prints. ‘Riso’ is a fast-paced process that uses soy based inks and recycled paper. This course is perfect for using all kinds of hand drawn techniques and collage to create richly coloured multi-layered prints. You'll learn how to prepare your design by using collage, drawing, and painting in colour-separated layers. Then you'll print your design by choosing from our selection of bright colours.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Riso Printing (Beginners) (October 2026)","instanceDates":"27 October-27 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956032ACDBJBCDJMDTGRKLGGLTGSDJGHK","firstInstanceDateTime":"2026-10-27T18:00:00","firstInstanceDateTimeUtc":"2026-10-27T18:00:00Z","lastInstanceDateTime":"2026-10-27T18:00:00","lastInstanceDateTimeUtc":"2026-10-27T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"A hybrid of photocopying and silkscreen, this eco-friendly, fast-paced process uses soy-based inks and recycled paper and lends itself to making zines.  Spend a weekend being creative and making with our duo drum Risograph machine. This course is perfect for those who have used Riso before and want to learn more. Come with some ideas to make your very own fanzine, comic, or storybook and see it come to life over two days.","htmlDescription":"<div id>\r\n\r\n</div>","duration":330,"imageUrl":"","isOnSale":true,"name":"Riso Zine (March 2027)","instanceDates":"20 March-20 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"959632AJSNPDNTKVNKPNNDMLMDBVJGBVS","firstInstanceDateTime":"2027-03-20T10:30:00","firstInstanceDateTimeUtc":"2027-03-20T10:30:00Z","lastInstanceDateTime":"2027-03-20T10:30:00","lastInstanceDateTimeUtc":"2027-03-20T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate:  18 / Director: Maasja Ooms / Country:  Netherlands / Year: 2026  / Duration: 2h 3min\r\n\r\nFive people who hear voices take part in an innovative form of therapy, where psychiatrist Dirk Corstens speaks both about and directly with their voices. \r\n\r\nExploring who the voices are, what they want and how they relate to past experiences, the sessions open paths towards greater insight and acceptance. My Word Against Mine is a powerful, hopeful and vividly cinematic portrait of resilience, trauma and the human mind. \r\n\r\nIncludes a post-screening discussion with Dirk Corstens, co-presented with Hearing Voices Network Dundee. \r\n\r\nContent Note: Themes of childhood sexual abuse, trauma, suicide and voice hearing.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":143,"imageUrl":"","isOnSale":true,"name":"Scottish Mental Health Arts Festival: My Word Against Mine + Q&A","instanceDates":"28 October-28 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"978033AKMDQCLCVCDKJLCHGLTSQBCSBMJ","firstInstanceDateTime":"2026-10-28T19:30:00","firstInstanceDateTimeUtc":"2026-10-28T19:30:00Z","lastInstanceDateTime":"2026-10-28T19:30:00","lastInstanceDateTimeUtc":"2026-10-28T19:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Documentary","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Develop your skills using photographic techniques and power-assisted screen printing tables. This course covers all aspects of how to construct a screenprint using images from photo stencils. You will first be shown examples of limited edition prints that were produced in DCA Print Studio. These examples demonstrate the range of mark making and types of images that can be used in screen printing. You will also try basic drawing and block-printing techniques, which can be used in your designs. This will be followed by in-depth demonstrations for using the studio equipment to coat, expose, develop and print a screen. This course requires previous experience of screen printing at a beginner’s level.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Screen Printing (Intermediate) (February 2027)","instanceDates":"13 February-13 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958033ARGGMBMMBKNTQSSVRMHTPQSKNPB","firstInstanceDateTime":"2027-02-13T10:30:00","firstInstanceDateTimeUtc":"2027-02-13T10:30:00Z","lastInstanceDateTime":"2027-02-13T10:30:00","lastInstanceDateTimeUtc":"2027-02-13T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Develop your skills using photographic techniques and power-assisted screen printing tables. This course covers all aspects of how to construct a screenprint using images from photo stencils. You will first be shown examples of limited edition prints that were produced in DCA Print Studio. These examples demonstrate the range of mark making and types of images that can be used in screen printing. You will also try basic drawing and block-printing techniques, which can be used in your designs. The following three weeks will include in-depth demonstrations for using the studio equipment to coat, expose, develop and print a screen. This course requires previous experience of screen printing at a beginner’s level.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Screen Printing (Intermediate) (March 2027)","instanceDates":"9 March-9 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"959032AGJJRNPGRBSSKCMMJVQSPMTBKRD","firstInstanceDateTime":"2027-03-09T18:00:00","firstInstanceDateTimeUtc":"2027-03-09T18:00:00Z","lastInstanceDateTime":"2027-03-09T18:00:00","lastInstanceDateTimeUtc":"2027-03-09T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Develop your skills using photographic techniques and power-assisted screen printing tables. This course covers all aspects of how to construct a screenprint using images from photo stencils. You will first be shown examples of limited edition prints that were produced in DCA Print Studio. These examples demonstrate the range of mark making and types of images that can be used in screen printing. You will also try basic drawing and block-printing techniques, which can be used in your designs. The following three weeks will include in-depth demonstrations for using the studio equipment to coat, expose, develop and print a screen. This course requires previous experience of screen printing at a beginner’s level.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Screen Printing (Intermediate) (November 2026)","instanceDates":"24 November-24 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"957033AKJMNBRNQLPTTDNQRTPDGGSMDTC","firstInstanceDateTime":"2026-11-24T18:00:00","firstInstanceDateTimeUtc":"2026-11-24T18:00:00Z","lastInstanceDateTime":"2026-11-24T18:00:00","lastInstanceDateTimeUtc":"2026-11-24T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Develop your skills using photographic techniques and power-assisted screen printing tables. This course covers all aspects of how to construct a screenprint using images from photo stencils. You will first be shown examples of limited edition prints that were produced in DCA Print Studio. These examples demonstrate the range of mark making and types of images that can be used in screen printing. You will also try basic drawing and block-printing techniques, which can be used in your designs. This will be followed by in-depth demonstrations for using the studio equipment to coat, expose, develop and print a screen. This course requires previous experience of screen printing at a beginner’s level.","htmlDescription":"<div id>\r\n\r\n</div>","duration":390,"imageUrl":"","isOnSale":true,"name":"Screen Printing (Intermediate) (October 2026)","instanceDates":"24 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955632ABQDVTLHVMPTPMTJRHRCKGDPBNM","firstInstanceDateTime":"2026-10-24T10:30:00","firstInstanceDateTimeUtc":"2026-10-24T09:30:00Z","lastInstanceDateTime":"2026-10-24T10:30:00","lastInstanceDateTimeUtc":"2026-10-24T09:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Test event for seat dedication","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Seat Dedication - Cinema 1","instanceDates":"21 March-21 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"770632AMKMNLMDCNTLCRSKCLKCBBVSHDD","firstInstanceDateTime":"2035-03-21T17:00:00","firstInstanceDateTimeUtc":"2035-03-21T17:00:00Z","lastInstanceDateTime":"2035-03-21T17:00:00","lastInstanceDateTimeUtc":"2035-03-21T17:00:00Z","altText":"","attribute_AccountCode":"DONATION","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Seat Dedication","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Paweł Pawlikowski / Country: Poland/ Germany/ Italy/ France / Year: 2026 / Duration: 1h22m / Language: German with English subtitles  \r\n\r\nIn a masterclass of control and precision, Paweł Pawlikowski explores the fragmented soul of postwar Germany through a father-daughter road trip dominated by personal ghosts. \r\n\r\nFatherland centres on the relationship between the Nobel Prize-winning writer Thomas Mann (Hanns Zischler) and his daughter Erika (Sandra Hüller) - actress, writer and rally driver. In the summer of 1949, at the height of the Cold War, father and daughter embark on a challenging and emotional road trip in a black Buick taking them across a Germany in ruins - from US dominated Frankfurt to Soviet controlled Weimar. Returning home after sixteen years of exile in the US, Thomas Mann has to face not only a divided fatherland, but also a deep fracture within his own family. \r\n\r\nWith Fatherland, Pawlikowski picks up where he left off with his award-winning Ida and Cold War, exploring – in his elliptic, distilled style - the themes of identity, family, love and guilt amid the turmoil and confusion of post-war Europe ","htmlDescription":"<div id>\r\n\r\n</div>","duration":82,"imageUrl":"","isOnSale":true,"name":"Senior Citizen Kane: Fatherland","instanceDates":"29 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981432AGSJNPCDJGDNVKCTQRVLCNTKVDS","firstInstanceDateTime":"2026-10-29T10:30:00","firstInstanceDateTimeUtc":"2026-10-29T10:30:00Z","lastInstanceDateTime":"2026-10-29T10:30:00","lastInstanceDateTimeUtc":"2026-10-29T10:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Senior Citizen Kane","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: 15 / Director: Lance Hammer / Country: UK/ USA / Year: 2026 / Duration: 2h2m\r\n\r\nQueen at Sea follows Amanda (Binoche) and her stepfather, Martin (Courtenay), at odds over a moral quandary involving Amanda’s mother, Leslie (Calder-Marshall). In the advanced stages of dementia, they quarrel over whether Leslie has lost all ability to make critical decisions in her own best interests, and, if so, who is responsible – a spouse, a child, an institution – for making such a determination? As Amanda and Martin are forced to make increasingly difficult choices, the repercussions spiral out of their control. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":121,"imageUrl":"","isOnSale":true,"name":"Senior Citizen Kane: Queen at Sea","instanceDates":"15 October-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"975832ATNJKHCGMHGTBHLLRHKHPLHNBKM","firstInstanceDateTime":"2026-10-15T10:30:00","firstInstanceDateTimeUtc":"2026-10-15T09:30:00Z","lastInstanceDateTime":"2026-10-15T10:30:00","lastInstanceDateTimeUtc":"2026-10-15T09:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Senior Citizen Kane","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: 12A / Director: Frank Berry / Country: Ireland/ UK / Year: 2026 / Duration: 1h24m \r\n\r\nIn rural Ireland, amateur historian Catherine Corless begins researching a former institution for unmarried mothers and their children, uncovering a shocking hidden history of loss.  \r\n\r\nProduced by Liam Neeson, based on the true story and featuring a powerful performance from BAFTA winner Monica Dolan (Mr Bates vs The Post Office), THE LOST CHILDRENOF TUAM is a deeply moving portrait of one woman’s fight for justice.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":84,"imageUrl":"","isOnSale":true,"name":"Senior Citizen Kane: The Lost Children of Tuam","instanceDates":"22 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980632ALHRRDGBHJDKNHHCQMGHKNMSQTK","firstInstanceDateTime":"2026-10-22T10:30:00","firstInstanceDateTimeUtc":"2026-10-22T09:30:00Z","lastInstanceDateTime":"2026-10-22T10:30:00","lastInstanceDateTimeUtc":"2026-10-22T09:30:00Z","altText":"","attribute_AccountCode":"CINCATERING","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Senior Citizen Kane","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_Catergory":""},{"description":"Certificate: U \r\nDirector: Georgia Oakley \r\nCountry: UK/ USA \r\nYear: 2026 \r\nDuration: 2h11m \r\nDistributor: Universal \r\n\r\nSisters Elinor and Marianne Dashwood must leave their Sussex estate following the sudden loss of their wealthy father and are forced to move in with a distant relative. The two sisters attempt to find security and happiness whilst navigating their vastly different approaches to love. \r\n\r\nAn irresistible new take on Jane Austen's iconic novel, Sense and Sensibility is a charming, witty, and deeply relatable story of love and sisterhood starring Daisy Edgar-Jones, Esmé Creed-Miles, George Mackay and Fiona Shaw. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":131,"imageUrl":"","isOnSale":true,"name":"Sense and Sensibility","instanceDates":"25 September-15 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"970232ARBCRQGPPHVCMLDRTQVRGRHLBMP","firstInstanceDateTime":"2026-09-25T13:00:00","firstInstanceDateTimeUtc":"2026-09-25T12:00:00Z","lastInstanceDateTime":"2026-10-15T12:30:00","lastInstanceDateTimeUtc":"2026-10-15T11:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Directors: Steve Cox & Matthew Walker / Country: UK/ France/ USA / Year: 2026 / Duration: 1h20m \r\n\r\nTo celebrate 50 years of the iconic and influential Aardman Animations studio, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nShaun the Sheep: The Beast of Mossy Bottom sees the residents of Mossy Bottom Farm looking forward to Halloween – until the clumsy Farmer trashes the Flock’s beloved pumpkin patch! When Shaun turns mad scientist to fix the problem, things rapidly spiral out of control... With The Farmer missing and a wild beast roaming the woods of Mossingham, all the ingredients are in place for a monstrously fun family adventure. \r\n\r\nThe film is the third stop motion animated feature film from Aardman’s globally loved brand, following Shaun the Sheep Movie (2015) and A Shaun the Sheep Movie: Farmageddon (2019). ","htmlDescription":"<div id>\r\n\r\n</div>","duration":81,"imageUrl":"","isOnSale":true,"name":"Shaun the Sheep: The Beast of Mossy Bottom","instanceDates":"10 October-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"976632AHLTQNHNMCVCLRKGGVQKQTCSTDB","firstInstanceDateTime":"2026-10-10T12:30:00","firstInstanceDateTimeUtc":"2026-10-10T11:30:00Z","lastInstanceDateTime":"2026-10-24T12:30:00","lastInstanceDateTimeUtc":"2026-10-24T11:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn traditional hand-lettering for signwriting. Learn the basics of signwriting: from brush-handling skills to illustrative work and gold-leaf or glass gilding. This introductory course covers various brushes, paints, mahlsticks, pounce patterns and tracings, chalks, tapes, letterform layout & hand-drawing of Sans Serif, Roman & Casual Scripts. If you've been before then the tutor can help you move on to a different technique.","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Signwriting (March 2027)","instanceDates":"6 March-6 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958432ATVTGTRKHGHGGLPMVBLKCLSSHNH","firstInstanceDateTime":"2027-03-06T10:30:00","firstInstanceDateTimeUtc":"2027-03-06T10:30:00Z","lastInstanceDateTime":"2027-03-06T10:30:00","lastInstanceDateTimeUtc":"2027-03-06T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn traditional hand-lettering for signwriting. Learn the basics of signwriting: from brush-handling skills to illustrative work and gold-leaf or glass gilding. This introductory course covers various brushes, paints, mahlsticks, pounce patterns and tracings, chalks, tapes, letterform layout & hand-drawing of Sans Serif, Roman & Casual Scripts. If you've been before then the tutor can help you move on to a different technique.","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Signwriting (November 2026)","instanceDates":"14 November-14 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956632AMCTVHDDNTRSVTRHPPHJPJSSDDK","firstInstanceDateTime":"2026-11-14T10:30:00","firstInstanceDateTimeUtc":"2026-11-14T10:30:00Z","lastInstanceDateTime":"2026-11-14T10:30:00","lastInstanceDateTimeUtc":"2026-11-14T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Bring a feather and use it to create an edition of beautiful prints. Whether you have some knowledge of etching or you’re a complete beginner, this is lo-fi method of printmaking is fun and creates great results. You will learn how to prepare small zinc plates for the soft ground etching technique and then use it to create feather prints with a variety of deckled edged papers, inks and ‘Chine Colle’.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Soft Ground Etching with Feathers (October 2026)","instanceDates":"31 October-31 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"956232ACHCJLDDMBSPNMCMNCCBMBRQMTK","firstInstanceDateTime":"2026-10-31T10:30:00","firstInstanceDateTimeUtc":"2026-10-31T10:30:00Z","lastInstanceDateTime":"2026-10-31T10:30:00","lastInstanceDateTimeUtc":"2026-10-31T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"A two-part CLPL taking you through practical animation activities and ideas for your class. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"Teachers CLPL: Stop Motion Animation Top Tips for the Classroom ","instanceDates":"3 November-3 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"966432AJMSPQLGHHSSPBBJGQVCQBTHJKT","firstInstanceDateTime":"2026-11-03T16:15:00","firstInstanceDateTimeUtc":"2026-11-03T16:15:00Z","lastInstanceDateTime":"2026-11-03T16:15:00","lastInstanceDateTimeUtc":"2026-11-03T16:15:00Z","altText":"","attribute_AccountCode":"LEARNING","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to do dry point printing the lo-fi way using recycled Tetra Paks. Tetra Pak printing is essentially an intaglio printmaking process, similar to etching or dry point on metal. Instead of using metal plates as the printing matrix, this class uses recycled Tetra Pak cartons. This material can be cut easily into different shapes and it's possible to achieve very fine line drawings or textured areas. You will also use 'Chine Colle' techniques to introduce pre-glued pieces of coloured papers. This is a perfect course for both beginner and intermediate printmakers, and you will leave with a collection of wonderfully detailed intaglio prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Tetra Pak Dry Point Printing (February 2027)","instanceDates":"20 February-20 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"954633ACLCRVDDSNVDBRBCJNMSPRNDDHJ","firstInstanceDateTime":"2027-02-20T10:30:00","firstInstanceDateTimeUtc":"2027-02-20T10:30:00Z","lastInstanceDateTime":"2027-02-20T10:30:00","lastInstanceDateTimeUtc":"2027-02-20T10:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to do dry point printing the lo-fi way using recycled Tetra Paks. Tetra Pak printing is essentially an intaglio printmaking process, similar to etching or dry point on metal. Instead of using metal plates as the printing matrix, this class uses recycled Tetra Pak cartons. This material can be cut easily into different shapes and it's possible to achieve very fine line drawings or textured areas. You will also use 'Chine Colle' techniques to introduce pre-glued pieces of coloured papers. This is a perfect course for both beginner and intermediate printmakers, and you will leave with a collection of wonderfully detailed intaglio prints.","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Tetra Pak Dry Point Printing (October 2026)","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955032AJLNVJDGCCCGPMSQDDRJNGQVDBS","firstInstanceDateTime":"2026-10-17T10:30:00","firstInstanceDateTimeUtc":"2026-10-17T09:30:00Z","lastInstanceDateTime":"2026-10-17T10:30:00","lastInstanceDateTimeUtc":"2026-10-17T09:30:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Director: Ganesh Panday   \r\nCountry: Nepal \r\nYear: 2026 \r\nDuration: 32m +  approx 30 min Q&A\r\nCertificate: 12A \r\nDistributor: Dundee Mountain Film Festival  \r\nPricing: Usual cinema  \r\nAds & trailers:  No \r\n \r\nDundee Mountain Film Festival Sunday November 22nd – (SCR1) 18:00 \r\nThe Everest Dream  \r\nNepal, 32 minutes, 45 seconds, Director Ganesh Panday  + Intro + Q & A \r\nThe Everest Dream is an inspiring mountaineering documentary that follows a remarkable journey of resilience, hope and human determination. The film tells the story of a group of traumatic brain injury survivors from Scotland who embarked on an extraordinary trek to Everest Base Camp in the Nepal Himalaya – a challenge many once believed they would never be able to attempt again. After life-changing brain injuries that affected their memory, speech and mobility, participants such as Nicolas, Peter, Michael, Colin and Niall faced years of rehabilitation and uncertainty. Doctors once told some of them they might never walk, talk or live independently again. Yet through determination, support from family and intensive therapy they slowly rebuilt their lives and set their sights on an ambitious goal: trekking to Everest Base Camp at 5,364 meters. Led by James Lamb and supported by families, Sherpa guides and the people of Nepal, the team travelled from Scotland to Kathmandu and into the heart of the Himalayas. Along the way, the film captures both the breathtaking beauty of Nepal and the emotional struggles of the climbers as they confronted altitude, physical limitations and the lingering effects of their injuries. The journey is not without setbacks. At one point, Nicholas goes missing from the group on the trail, while Michael must make the difficult decision to stop short of Everest Base Camp due to health concerns. Yet these moments reveal the true spirit of the expedition — that success is not measured only by reaching a destination, but by the courage to keep moving forward. Through powerful personal stories, emotional reunions with family members, and moments of connection with local communities along the trail, The Everest Dream explores the transformative power of adventure, friendship, and perseverance. Ultimately, the film shows that even after devastating injury, life can still hold extraordinary possibilities. More than a story about climbing mountains, The Everest Dream is a testament to resilience, proving that every step forward, no matter how small, can be a victory. \r\nSponsored by The Munro Society ","htmlDescription":"<div id>\r\n\r\n</div>","duration":62,"imageUrl":"","isOnSale":true,"name":"The Everest Dream + Q&A","instanceDates":"22 November-22 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"979632AJPNKNRTPPHQVTGVNTNLMPHGBTT","firstInstanceDateTime":"2026-11-22T18:00:00","firstInstanceDateTimeUtc":"2026-11-22T18:00:00Z","lastInstanceDateTime":"2026-11-22T18:00:00","lastInstanceDateTimeUtc":"2026-11-22T18:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Dundee Mountain Film Festival","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 18 / Director: Sergio Leone / Country: Italy/ Spain/ West Germany/ USA / Year: 1966 / Duration: 2h59m / Language: English and Italian with English subtitles  \r\n\r\n \r\n\r\nBlistering new 4K restoration of the 179-minute Extended Cut, using the original 2-perf Techniscope negative.","htmlDescription":"<div id>\r\n\r\n</div>","duration":179,"imageUrl":"","isOnSale":true,"name":"The Good, the Bad, and the Ugly (60th Anniversary, 4K Restoration)","instanceDates":"25 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982032AGQVCNSCDNSLPNMBSSNKTBDCNSD","firstInstanceDateTime":"2026-10-25T16:30:00","firstInstanceDateTimeUtc":"2026-10-25T16:30:00Z","lastInstanceDateTime":"2026-10-29T19:30:00","lastInstanceDateTimeUtc":"2026-10-29T19:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Vintage","attribute_FilmCertification":"18","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 12A / Director: Frank Berry / Country: Ireland/ UK / Year: 2026 / Duration: 1h24m \r\n\r\nIn rural Ireland, amateur historian Catherine Corless begins researching a former institution for unmarried mothers and their children, uncovering a shocking hidden history of loss.  \r\n\r\nProduced by Liam Neeson, based on the true story and featuring a powerful performance from BAFTA winner Monica Dolan (Mr Bates vs The Post Office), THE LOST CHILDRENOF TUAM is a deeply moving portrait of one woman’s fight for justice.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":84,"imageUrl":"","isOnSale":true,"name":"The Lost Children of Tuam","instanceDates":"16 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980232AJNVVRTKVJHBBSHVVSMDLKKQHBR","firstInstanceDateTime":"2026-10-16T15:15:00","firstInstanceDateTimeUtc":"2026-10-16T14:15:00Z","lastInstanceDateTime":"2026-10-29T13:30:00","lastInstanceDateTimeUtc":"2026-10-29T13:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Brian Henson / Country: USA/ UK / Year: 1992 / Duration: 1h 29m \r\n\r\nThe Muppets take on a classic Dickens story, with plenty of laughs, music and singing vegetables!  \r\n\r\nThis terrific family-friendly adaptation stars Michael Caine as a miserly but musical Ebenezer Scrooge. Brian Henson directs his late father's creations in the Charles Dickens classic, the best known (and most oft-filmed) Christmas story of all time.  \r\n\r\nKermit is Scrooge’s long-suffering but ever-hopeful employee Bob Cratchit, Miss Piggy plays Cratchit's wife, and a host of Muppets (including the Great Gonzo as an unlikely Charles Dickens) take on other primary roles in this bright, playful adaptation of the sombre tale. Or at least it starts brightly enough--the anarchic humour soon settles into mirthful memories and a sense of melancholy as the ghosts of Christmas past, present, and future take Scrooge on a journey of his lonely, wasted life.  \r\n\r\nMichael Caine makes a wonderful Scrooge, delightfully rediscovering the meaning of life as fantastic creations from Henson's Creature Shop (developed specially for this film) take the reins as the three ghosts. While the odd mix of offbeat humour and drama undercuts the power of Dickens's drama, this kid-friendly retelling makes an excellent family drama that adults and children alike can enjoy. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":89,"imageUrl":"","isOnSale":true,"name":"The Muppet Christmas Carol","instanceDates":"20 December-24 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"982832ALKHCRKRSDLMLBKRBQPDPCNRNQB","firstInstanceDateTime":"2026-12-20T14:15:00","firstInstanceDateTimeUtc":"2026-12-20T14:15:00Z","lastInstanceDateTime":"2026-12-24T14:30:00","lastInstanceDateTimeUtc":"2026-12-24T14:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Christmas","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Peter Lord & Jeff Newitt / Country: UK/ USA / Year: 2012 / Duration:  1h28m \r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nThe Pirates! In an Adventure with Scientists was based on Gideon Defoe’s 2004 novel and follows a crew of hapless pirates in their attempt to win the much coveted Pirate of the Year Award. \r\n\r\nHugh Grant starred in his first animated role as the luxuriantly bearded Pirate Captain – a boundlessly enthusiastic, if somewhat less-than-successful, terror of the High Seas. With a rag-tag crew at his side (Martin Freeman, Brendan Gleeson, Russell Tovey, and Ashley Jensen), and seemingly blind to the impossible odds stacked against him, the Captain has one dream: to beat his bitter rivals Black Bellamy (Jeremy Piven) and Cutlass Liz (Salma Hayek) to the Pirate Of The Year Award. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":88,"imageUrl":"","isOnSale":true,"name":"The Pirates! In an Adventure with Scientists!","instanceDates":"23 October-23 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"978032ATQTMPGSGKJNSKNBRDKNRPVQQNH","firstInstanceDateTime":"2026-10-23T13:00:00","firstInstanceDateTimeUtc":"2026-10-23T12:00:00Z","lastInstanceDateTime":"2026-10-23T13:00:00","lastInstanceDateTimeUtc":"2026-10-23T12:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age rating: U (BBFC rated)\r\nDirector: Albert Lamorisse \r\nCountries of Production: France \r\nLanguage: French with English subtitles \r\nDuration: 36min \r\nYear: 1956 \r\n\r\nThe Red Balloon is a magical tale about the friendship between a little boy and a balloon in 1950s Paris. A boy finds a red balloon tied to a streetlight. From then on, the balloon follows him everywhere in the streets of Paris, causing surprise in the whole neighbourhood and jealousy among other children. \r\n\r\nWith very little dialogue, the film focuses on its poetic, visual storytelling, capturing the extraordinary nature of everyday and the beauty of childhood imagination. Set in post-war Paris, the greyness of the city contrasted with the vivid red of this magic balloon. Winner of Best Original Screenplay at the 1956 Oscars and the Short Film Palme d’Or at Cannes the same year, the film celebrates its 70th anniversary in 2026. This beautiful restoration of the film supervised by the director’s son (the film’s protagonist) offers a great opportunity to discover one of the greatest children’s films of all time. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":36,"imageUrl":"","isOnSale":true,"name":"The Red Balloon","instanceDates":"1 November-1 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"972232AKSPGGSJRKRTNRVVQMPLHGLMVQH","firstInstanceDateTime":"2026-11-01T13:30:00","firstInstanceDateTimeUtc":"2026-11-01T13:30:00Z","lastInstanceDateTime":"2026-11-01T13:30:00","lastInstanceDateTimeUtc":"2026-11-01T13:30:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age: 9+\r\nDirector: Norbert Lechner \r\nCountries of Production: Germany, Austria, Luxembourg \r\nLanguage: German with English subtitles \r\nDuration: 1h 31min \r\nYear: 2025 \r\n\r\nKarli, a 12-year-old boy, moves to the Alps, where his parents are making their dream of running a hotel come true. But instead of a holiday, Karli grudgingly helps his parents scrape old wallpaper. Suddenly, he discovers an old lift– that takes him back in time to the year 1938! There, he befriends the spirited Jewish girl Hannah and the shoeshine boy Georg. Together, they solve an exciting mystery case. But as Karli grows closer to his new friends, he begins to sense the dark shadow looming over their world and is soon confronted with the reality of National Socialism. \r\n\r\nFilmed in stunning Alpine locations, The Secret Floor is a time-travel adventure, offering a fresh perspective on a crucial historical period (National Socialism), while also keeping it light-hearted. Turning a difficult but important theme into a creative and imaginative film, we dive into a foreign world along with Karli, uncovering its secrets. The film tackles a relevant topic without ever leaving the child’s perspective, making it accessible and comprehensible for young audiences. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":91,"imageUrl":"","isOnSale":true,"name":"The Secret Floor","instanceDates":"1 November-1 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"971633ACVBVHKSNLTLLPJSRGCNVGQTTDS","firstInstanceDateTime":"2026-11-01T15:00:00","firstInstanceDateTimeUtc":"2026-11-01T15:00:00Z","lastInstanceDateTime":"2026-11-01T15:00:00","lastInstanceDateTimeUtc":"2026-11-01T15:00:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 15 / Director: Aaron Sorkin / Country: USA / Year: 2026 / Duration: 1h52m \r\n\r\nA companion piece to the hit film, The Social Network, Sorkin’s original screenplay tells the true story of how Frances Haugen (Madison), a young Facebook engineer, enlists the help of Jeff Horwitz (White), a Wall Street Journal reporter, to go on a dangerous journey that ends up blowing the whistle on the social network’s most guarded secrets. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":112,"imageUrl":"","isOnSale":true,"name":"The Social Reckoning","instanceDates":"16 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"980032ADQDDDHRBTKLVDGTBPPDKJJHRTV","firstInstanceDateTime":"2026-10-16T14:30:00","firstInstanceDateTimeUtc":"2026-10-16T13:30:00Z","lastInstanceDateTime":"2026-10-22T20:15:00","lastInstanceDateTimeUtc":"2026-10-22T19:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 15 / Director: Christopher Hampson & Oscar Sansom / Country: UK / Year: 2025 / Duration: 1h35m \r\n\r\nTHESE VIOLENT DELIGHTS contains a sequence of flashing lights which might affect customers who are susceptible to photosensitive epilepsy. \r\n\r\nHaving established a name for creating innovative dance on stage, Scottish Ballet’s THESE VIOLENT DELIGHTS is their first major feature-length film. \r\n\r\nJuliet awakens from a fever dream. How did we get here? The lines between hallucination and memory blur as cinema and dance collide in a kaleidoscopic journey of belonging, defiance, and self-discovery. \r\n\r\nIn this vivid, contemporary re-telling without words, fate is rewritten on the dancefloor. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"These Violent Delights + Recorded Q&A","instanceDates":"21 October-21 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"978232AHBBKHHCRSLDVRKVSDRJNJLDDQH","firstInstanceDateTime":"2026-10-21T20:00:00","firstInstanceDateTimeUtc":"2026-10-21T19:00:00Z","lastInstanceDateTime":"2026-10-21T20:00:00","lastInstanceDateTimeUtc":"2026-10-21T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Ballet","attribute_FilmCertification":"15","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Nick Park  / Country: UK / Year: 1989/ 1993/ 1995 / Duration: 1h23m\r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nJoin us for this triple bill of Aardman’s first Wallace and Gromit productions.  \r\n\r\nA Grand Day Out: \r\nWallace & Gromit have to decide where to go for their annual picnic. With a home-made rocket and large appetite, they head for the moon, hoping to find it made of cheese. \r\n\r\nThe Wrong Trousers: \r\nA mysterious penguin and a pair of automated techno-trousers are the catalysts for this fast-moving comedy thriller, in which mild mannered Wallace finds himself an unwitting accomplice to a daring diamond robbery. \r\n\r\nA Close Shave: \r\nLove blossoms in the course of Wallace and Gromit’s latest business, the Wash ’n’ Go Window cleaning service, when they are called out to clean the windows of the attractive Wendolene Ramsbottom. Little do they know that a lamb, Shaun is hiding in their house after escaping from the clutches of evil sheep rustlers.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":83,"imageUrl":"","isOnSale":true,"name":"Wallace & Gromit: A Grand Day Out/ The Wrong Trousers/ A Close Shave","instanceDates":"11 October-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977232ACRDKGRKRDNRHNHJHNHKVLPVKDL","firstInstanceDateTime":"2026-10-11T11:30:00","firstInstanceDateTimeUtc":"2026-10-11T10:30:00Z","lastInstanceDateTime":"2026-10-19T15:30:00","lastInstanceDateTimeUtc":"2026-10-19T14:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Nick Park & Steve Box / Country: UK/ USA / Year: 2005 / Duration: 1h25m \r\n\r\nTo celebrate 50 years of the iconic Aardman Animations studio and to play alongside their latest release Shaun the Sheep: The Beast of Mossy Bottom, we’re bringing selection of Aardman favourites back to the big screen for the October school holidays. \r\n\r\nThe Curse of the Were-Rabbit was Wallace and Gromit’s first feature film. Peter Sallis was joined by a voice cast including Helena Bonham-Carter, Ralph Fiennes and Peter Kay. It was a critical and commercial success and won the Academy Award for Best Animated Feature. \r\n\r\nWallace and Gromit’s latest business venture – a humane pest-control outfit called ‘Anti-Pesto’ – is booming, but the enterprising duo are finding it hard to manage all the captive rabbits taking over West Wallaby Street. \r\n\r\nAnd now they’ve been tasked with tracking down the mysterious beast that’s been decimating the town’s vegetable plots. With the fate of Lady Tottington’s much-loved Giant Vegetable Competition hanging in the balance, can Wallace and Gromit save the day? ","htmlDescription":"<div id>\r\n\r\n</div>","duration":85,"imageUrl":"","isOnSale":true,"name":"Wallace & Gromit: The Curse of the Were-Rabbit","instanceDates":"17 October-17 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977632AHRNTCVMBQDSQLCLVPHVRHRLJDT","firstInstanceDateTime":"2026-10-17T12:30:00","firstInstanceDateTimeUtc":"2026-10-17T11:30:00Z","lastInstanceDateTime":"2026-10-17T12:30:00","lastInstanceDateTimeUtc":"2026-10-17T11:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Aardman: 50 Years of Clay","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Age self-certification: 0+ (recommended for ages 5+) Director: Karsten Kiilerich \r\nCountries of Production: Denmark \r\nLanguage: English version \r\nDuration: 1h 23min \r\nYear: 2026 \r\n\r\nRecommended for ages 5+ \r\n\r\nWhen Mumbo Jumbo magically grows giant, he has to go on a dangerous journey with his three friends to find the scary witch, Baba Yaga, so she can turn him small again. It is an adventurous journey which might make Mumbo Jumbo small again, but a whole lot bigger on the inside. \r\n\r\nWhen Mumbo Jumbo Grew Giant is a tale about believing in the strength within yourself and accepting your own size in the universe. When our little hippo hero suddenly grows enormous, he must find the courage to step outside his familiar world and fix the mess he unwillingly created, together with his friends. This colourful and humorous film will take the youngest audiences on a cinematic journey about friendship and identity, but also about the strength and stubbornness that we all carry.  ","htmlDescription":"<div id>\r\n\r\n</div>","duration":83,"imageUrl":"","isOnSale":true,"name":"When Mumbo Jumbo Grew Giant","instanceDates":"7 November-7 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"971634AVDJQHPKCTJTCVLCVJDNRGTLSQB","firstInstanceDateTime":"2026-11-07T13:00:00","firstInstanceDateTimeUtc":"2026-11-07T13:00:00Z","lastInstanceDateTime":"2026-11-07T13:00:00","lastInstanceDateTimeUtc":"2026-11-07T13:00:00Z","altText":"","attribute_AccountCode":"DISCOVERY","attribute_Catergory":"DFF Public","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"DFF Festival","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Yoshifumi Kondō / Country: Japan / Year: 1995 / Duration: 1h51m \r\n\r\nDiscover the brilliance of this heartwarming coming-of-age classic from the legendary Studio Ghibli, creators of My Neighbour Totoro and the Academy Award®-winning Spirited Away. \r\n\r\nA chance encounter with a mysterious cat sends Shizuku, a girl with her head in the clouds, on a quest for her true talent. Together with Seiji, a boy determined to follow his dreams, and enchanted by The Baron, an antique cat figurine who guides her to listen to the whispers of her heart, Shizuku embarks on a life-changing adventure that takes her beyond the boundaries of her imagination. Based on a screenplay and storyboards from Hayao Miyazaki, WHISPER OF THE HEART is a precious gem in the Studio Ghibli catalogue, directed by veteran animator Yoshifumi Kondo. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":111,"imageUrl":"","isOnSale":true,"name":"Whisper of the Heart (English Dub, 4K Restoration) ","instanceDates":"15 October-22 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"976232ATHQBMSKQDTBSDRPTLHVSHLKPSL","firstInstanceDateTime":"2026-10-15T15:15:00","firstInstanceDateTimeUtc":"2026-10-15T14:15:00Z","lastInstanceDateTime":"2026-10-22T13:30:00","lastInstanceDateTimeUtc":"2026-10-22T12:30:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Anime","attribute_FilmCertification":"U","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: U / Director: Yoshifumi Kondō / Country: Japan / Year: 1995 / Duration: 1h51m \r\n\r\nDiscover the brilliance of this heartwarming coming-of-age classic from the legendary Studio Ghibli, creators of My Neighbour Totoro and the Academy Award®-winning Spirited Away. \r\n\r\nA chance encounter with a mysterious cat sends Shizuku, a girl with her head in the clouds, on a quest for her true talent. Together with Seiji, a boy determined to follow his dreams, and enchanted by The Baron, an antique cat figurine who guides her to listen to the whispers of her heart, Shizuku embarks on a life-changing adventure that takes her beyond the boundaries of her imagination. Based on a screenplay and storyboards from Hayao Miyazaki, WHISPER OF THE HEART is a precious gem in the Studio Ghibli catalogue, directed by veteran animator Yoshifumi Kondo. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":111,"imageUrl":"","isOnSale":true,"name":"Whisper of the Heart (Subtitled, 4K Restoration)","instanceDates":"10 October-19 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"977233AGBGTKGTGNRKQTRNNNBLTGVTDDG","firstInstanceDateTime":"2026-10-10T15:00:00","firstInstanceDateTimeUtc":"2026-10-10T14:00:00Z","lastInstanceDateTime":"2026-10-19T20:00:00","lastInstanceDateTimeUtc":"2026-10-19T19:00:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"Anime","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":""},{"description":"Certificate: TBC / Directors: Alex Huston Fischer and Eleanor Wilson / Country: UK/ USA/ Australia/ Hungary / Year: 2026 / Duration: 1h 45m \r\n\r\nOn the outskirts of a village by the sea, lives a fisherwoman; smelly, single and perpetually ridiculed. One day, fed up with her stuffy, small-minded neighbours, she commissions herself a husband to be made from wicker. In an otherwise conservative town, this unconventional romance sparks outrage, jealousy and chaos. \r\n\r\nStarring Olivia Colman, Alexander Skarsgård, Peter Dinklage & Elizabeth Debicki.","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"Wicker","instanceDates":"30 October-5 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"983032ADBNTVRBVDGBDNDLGCQMRVBMPDR","firstInstanceDateTime":"2026-10-30T12:30:00","firstInstanceDateTimeUtc":"2026-10-30T12:30:00Z","lastInstanceDateTime":"2026-11-05T17:45:00","lastInstanceDateTimeUtc":"2026-11-05T17:45:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"TBC","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Certificate: 12A / Director: Travis Knight / Country: USA/ UK/ Canada / Year: 2026 / Duration: 2h12m \r\n\r\nAfter her baby brother is abducted by a murder of crows, headstrong teenager Prue McKeel launches a desperate rescue mission into an enchanted forest hidden just beyond Portland, Oregon. Joined by a hapless but loyal classmate, Prue risks it all as she navigates a world of bandits, talking animals and powerful figures driven by grief and ambition. \r\n\r\nThis breathtaking, hugely ambitious new film from LAIKA Studios (Coraline, Kubo and the Two Strings) is a masterpiece of stop-motion storytelling on an epic scale and quite unlike anything previously seen. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":132,"imageUrl":"","isOnSale":true,"name":"Wildwood","instanceDates":"23 October-29 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"981032ALTQGMPJQCNNJNTVHSPBSHVQCVM","firstInstanceDateTime":"2026-10-23T12:30:00","firstInstanceDateTimeUtc":"2026-10-23T11:30:00Z","lastInstanceDateTime":"2026-10-29T20:15:00","lastInstanceDateTimeUtc":"2026-10-29T20:15:00Z","altText":"","attribute_AccountCode":"CIN","attribute_Catergory":"New Film","attribute_FilmCertification":"12A","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Cinema","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":""},{"description":"Learn how to work with this beautiful form of printmaking and use fine engraving tools to create detailed designs. Create images by cutting into the surface of the end grain of box, lemon or cherry wood. You'll be taken through all stages of the wood engraving process, from preparing woodblocks, and practising on starter blocks to engraving your design, selecting your paper and printing. You will finish the course with a small collection of prints, block printed in black and white, as well as the wood blocks which can be worked on and re-printed in the future. Please note that we are using end grain wood blocks therefore the prints are petite. This allows the printmaker to create small delicate pieces.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Wood Engraving (March 2027)","instanceDates":"8 March-8 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"958832ANMDTKPQGLVLSVRLGHRLDDBJRSH","firstInstanceDateTime":"2027-03-08T18:00:00","firstInstanceDateTimeUtc":"2027-03-08T18:00:00Z","lastInstanceDateTime":"2027-03-08T18:00:00","lastInstanceDateTimeUtc":"2027-03-08T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""},{"description":"Learn how to work with this beautiful form of printmaking and use fine engraving tools to create detailed designs. Create images by cutting into the surface of the end grain of box, lemon or cherry wood. You'll be taken through all stages of the wood engraving process, from preparing woodblocks, and practising on starter blocks to engraving your design, selecting your paper and printing. You will finish the course with a small collection of prints, block printed in black and white, as well as the wood blocks which can be worked on and re-printed in the future. Please note that we are using end grain wood blocks therefore the prints are petite. This allows the printmaker to create small delicate pieces.","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Wood Engraving (November 2026)","instanceDates":"12 November-12 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"955833ANDNDNMCTKQRNLCJKDJBDNGTMNG","firstInstanceDateTime":"2026-11-12T18:00:00","firstInstanceDateTimeUtc":"2026-11-12T18:00:00Z","lastInstanceDateTime":"2026-11-12T18:00:00","lastInstanceDateTimeUtc":"2026-11-12T18:00:00Z","altText":"","attribute_AccountCode":"PS","attribute_MembershipDiscountAllowed":false,"attribute_Type":"Print Studio","attribute_EventInfo1":"","attribute_EventInfo2":"","attribute_ConfirmationText":"","attribute_Description":"","attribute_FilmCertification":"","attribute_Catergory":""}]