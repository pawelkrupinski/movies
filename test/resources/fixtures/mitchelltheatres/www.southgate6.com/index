        if (movieRows.length > 0) {
            const currentDate = new Date();
            const targetEndDate = new Date(endDate);
            targetEndDate.setDate(targetEndDate.getDate() + 1); // Add one day

            const timeDiff = targetEndDate - currentDate;
            const daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));

            if (daysDiff >= 0) {
                const subtitleContainer = document.createElement('td');
