<script>
    function leavingFilms() {
        // Check if the body has the class 'noSort'
        if (hasNoSortClass()) {
            console.log('We are NOT adding the Leaving Films div');
            return; // Do nothing
        }

        // Select all showtimesContainer elements
        const showtimesContainers = document.querySelectorAll('.sortedFilms');

        showtimesContainers.forEach(showtimesContainer => {
            const leavingFilmsDiv = document.createElement('div');
            leavingFilmsDiv.className = 'leavingFilms';
            showtimesContainer.appendChild(leavingFilmsDiv);
        });

        function moveLeavingFilmsToDiv(showtimesContainer) {
            // Check if the body has the class 'noSort'
            if (hasNoSortClass()) {
                console.log('We are NOT moving leaving films to the Leaving Films div');
                return; // Do nothing
            }

            // Get the Leaving Films div within the current showtimesContainer
            const leavingFilmsDiv = showtimesContainer.querySelector('.leavingFilms');

            if (leavingFilmsDiv) {
                // Find all films with the data-leaving attribute within the current showtimesContainer
                const leavingFilms = Array.from(showtimesContainer.querySelectorAll('[data-leaving]'));

                // Create an object to group films by leaving date
                const filmsByLeavingDate = {};

                leavingFilms.forEach((film) => {
                    const leavingDate = film.getAttribute('data-leaving');
                    if (!filmsByLeavingDate[leavingDate]) {
                        filmsByLeavingDate[leavingDate] = [];
                    }
                    filmsByLeavingDate[leavingDate].push(film);
                });

                // Sort the films by leaving date in ascending order (furthest date first)
                const sortedLeavingDates = Object.keys(filmsByLeavingDate).sort((a, b) => {
                    const dateA = new Date(a);
                    const dateB = new Date(b);
                    return dateA - dateB;
                });

                // Reverse the sorted array to have furthest date first
                sortedLeavingDates.reverse();

                // Append films to Leaving Films div in sorted order
                sortedLeavingDates.forEach((leavingDate) => {
                    const leavingDateDiv = document.createElement('div');
                    leavingDateDiv.className = `leavingFilms-${leavingDate}`;
                    leavingFilmsDiv.appendChild(leavingDateDiv);

                    // Sort films within each leaving date div by release date (newest first)
                    const filmsInLeavingDate = filmsByLeavingDate[leavingDate].sort((a, b) => {
                        const openingDateA = new Date(a.getAttribute('data-opening'));
                        const openingDateB = new Date(b.getAttribute('data-opening'));
                        return openingDateB - openingDateA;
                    });

                    filmsInLeavingDate.forEach((film) => {
                        leavingDateDiv.appendChild(film);
                    });
                });
            }
        }

        // Call the moveLeavingFilmsToDiv function for each showtimesContainer
        showtimesContainers.forEach(showtimesContainer => {
            moveLeavingFilmsToDiv(showtimesContainer);
        });
    }

    // Call the leavingFilms function when you want to add the div
    document.addEventListener('DOMContentLoaded', function () {
        // This code will run once the page is fully loaded
        leavingFilms();
    });
</script>


