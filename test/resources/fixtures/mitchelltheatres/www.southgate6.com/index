<script>
    let players = {};

    // Initialize YouTube IFrame API
    function onYouTubeIframeAPIReady() {
        $('iframe[src*="youtube.com/embed"]').each(function () {
            const iframe = $(this);
            const id = iframe.attr('id') || `youtube-player-${Math.random().toString(36).substr(2, 9)}`;
            iframe.attr('id', id);

            // Only initialize if not already initialized
            if (!players[id]) {
                players[id] = new YT.Player(id);
            }
        });
    }

    // Pause the YouTube video in the modal
    function pauseYouTubeVideo($modal) {
        const iframe = $modal.find('iframe[src*="youtube.com/embed"]');
        if (iframe.length) {
            const playerId = iframe.attr('id');
            if (players[playerId] && typeof players[playerId].pauseVideo === 'function') {
                players[playerId].pauseVideo();
            } else {
                console.warn(`YouTube Player with ID ${playerId} is not properly initialized.`);
            }
        }
    }

    // Handle Foundation close event for additional safety
    $(document).on('closed.fndtn.reveal', '[data-reveal]', function () {
        pauseYouTubeVideo($(this)); // Pause the video if the modal closes by any other means
    });
</script>

