<script>
    function stripFormatTags(raw) {
        if (!raw) return "";
        return raw
            .toString()
            .replace(/\s*\(?\s*3D\s*\)?\s*/gi, " ")
            .replace(/\s*[-–:]\s*3D\s*/gi, " ")
            .replace(/\s*\(?\s*2D\s*\)?\s*/gi, " ")
            .replace(/\s*[-–:]\s*2D\s*/gi, " ")
            .replace(/\s+/g, " ")
            .trim()
            .toLowerCase();
    }

    function hasTag(title, tag) {
        const t = (title || "").toString();
        const re = new RegExp(`(^|\\W)${tag}($|\\W)`, "i");
        return re.test(t);
    }

    function group3DThen2DOrPlainWithin($container) {
        const $movies = $container.find(".veeziMovie");
        if (!$movies.length) return;

        const map = new Map();

        // Build map for THIS container only
        $movies.each(function () {
            const $m = $(this);
            const title = $m.attr("data-title") || "";
            const base = stripFormatTags(title);

            if (!map.has(base)) map.set(base, { twoD: [], plain: [] });

            const bucket = map.get(base);
            if (hasTag(title, "2D")) bucket.twoD.push($m);
            else if (!hasTag(title, "3D")) bucket.plain.push($m); // store non-3D mates
        });

        // For each 3D in THIS container, move it directly above its mate (2D preferred)
        $movies.each(function () {
            const $threeD = $(this);
            const title = $threeD.attr("data-title") || "";

            if (!hasTag(title, "3D")) return;
            if ($threeD.closest(".leavingFilms").length) return;

            const base = stripFormatTags(title);
            const bucket = map.get(base);
            if (!bucket) return;

            const mateList = bucket.twoD.length ? bucket.twoD : bucket.plain;

            // pick the first mate that is still in THIS container and not in leavingFilms
            const $mate = mateList.find($m =>
                $m.closest($container).length && !$m.closest(".leavingFilms").length
            );

            if ($mate && $mate.length) {
                $threeD.insertAfter($mate); // regular/2D first, then 3D (within this section)
            }
        });
    }

    function group3DThen2DOrPlain() {
        if (document.body.classList.contains("noSort")) return;

        // Prefer sortedFilms if it exists
        let $containers = $(".sortedFilms");

        // Fallback: find the common parent that actually contains veeziMovie
        if (!$containers.length) {
            $containers = $(".veeziMovie").first().parent();
        }

        $containers.each(function () {
            group3DThen2DOrPlainWithin($(this));
        });
    }

    $(window).on("load", function () {
        group3DThen2DOrPlain();
    });
</script>
