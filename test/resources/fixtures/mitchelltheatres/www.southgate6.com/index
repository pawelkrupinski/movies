    // Get the user's timezone if possible, otherwise fall back to US Central
    function getUserTimeZone() {
        try {
            if (
                typeof Intl !== "undefined" &&
                Intl.DateTimeFormat &&
                typeof Intl.DateTimeFormat().resolvedOptions === "function"
            ) {
                const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
                if (tz) {
                    return tz; // e.g. "America/New_York"
                }
            }
        } catch (e) {
            // If anything goes wrong, just fall through to the fallback
        }

        // Fallback: US Central Time
        return "America/Chicago";
    }

    const USER_TIME_ZONE = getUserTimeZone();

    // Log which timezone is being used
    console.log("Using timezone:", USER_TIME_ZONE);

    // In case we want to not run the sorting (Aud and Box Office)
    function hasNoSortClass() {
        return document.body.classList.contains('noSort');
    }

    function addSubtitle(filmID, actionText, date) {
        // Check if the body has the class 'noSort'
        if (hasNoSortClass()) {
            return; // Do nothing
        }

        const movieTitleRow = document.querySelector(`.${filmID} tr.movieTitleRow`);
        const parentDiv     = document.querySelector(`.${filmID}`);

        if (movieTitleRow && parentDiv) {
            const currentDate = new Date();
            const targetDate  = new Date(date);
            targetDate.setDate(targetDate.getDate() + 1); // keep your +1 day hack

            const dayNames = [
                'Sunday', 'Monday', 'Tuesday',
                'Wednesday', 'Thursday', 'Friday', 'Saturday'
            ];
            const dayOfWeek     = dayNames[targetDate.getDay()];
            const shortDayOfWeek = dayOfWeek.substring(0, 3);

            const timeDiff = targetDate - currentDate;
            const daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));

            const subtitleElement    = document.createElement('td');
            subtitleElement.className = 'moviesubtitle';
            subtitleElement.colSpan   = 2;

            let displayText = '';
            let subclass    = '';

            const actionLower = actionText.toLowerCase();

            // ⬇️ NEW LOGIC: for Leaving / Returning show day-of-week + MM/DD
            if (actionLower === 'leaving' || actionLower === 'returning') {
                const month = String(targetDate.getMonth() + 1).padStart(2, '0');
                const day   = String(targetDate.getDate()).padStart(2, '0');
                const formattedDate = `${month}/${day}`;   // e.g. 12/12

                displayText = `${actionText} ${dayOfWeek} ${formattedDate}`;
                // e.g. "Leaving Friday 12/12"

                // Keep your special Friday styling hook
                if (dayOfWeek.toLowerCase() === 'friday') {
                    subclass = 'showtimes pretext leavingFri';
                }
            } else {
                const month = String(targetDate.getMonth() + 1).padStart(2, '0');
                const day   = String(targetDate.getDate()).padStart(2, '0');
                const formattedDate = `${month}/${day}`;

                if (daysDiff <= 6) {
                    displayText = `${actionText} ${dayOfWeek} ${formattedDate}`;
                } else {
                    displayText = `${actionText} Next ${dayOfWeek} ${formattedDate}`;
                }
            }

            if (actionLower === 'leaving' || actionLower === 'returning') {
                // include any extra subclass (like leavingFri) if set
                const spanClass = `${actionLower}${shortDayOfWeek} ${subclass}`.trim();
                subtitleElement.innerHTML =
                    `<span class="${spanClass}" data-date="${date}">${displayText}</span>`;
                parentDiv.dataset[actionLower] = date;

                const subtitleRow = document.createElement('tr');
                subtitleRow.appendChild(subtitleElement);
                movieTitleRow.insertAdjacentElement('afterend', subtitleRow);
            } else if (actionLower === 'starting') {
                // Remove any existing PHP-rendered starting subtitle for this film
                parentDiv.querySelectorAll('td.moviesubtitle span[class*="starting"]').forEach(span => {
                    const row = span.closest('tr');
                    if (row) row.remove();
                });
                parentDiv.dataset.opening = date;
                subtitleElement.innerHTML = `<span data-date="${date}">${displayText}</span>`;
                const subtitleRow = document.createElement('tr');
                subtitleRow.appendChild(subtitleElement);
                movieTitleRow.insertAdjacentElement('afterend', subtitleRow);
                subtitleElement
                    .querySelector('span')
                    .classList.add('pretext', `starting${shortDayOfWeek}`);
            } else {
                movieTitleRow.dataset.releaseDate = date;
                subtitleElement.innerHTML = `<span>${displayText}</span>`;
                const subtitleRow = document.createElement('tr');
                subtitleRow.appendChild(subtitleElement);
                movieTitleRow.insertAdjacentElement('afterend', subtitleRow);
            }

            // Keep your existing sort
            sortFilmsByReleaseDate();
        }
    }

    function sortFilmsByReleaseDate() {
        // Check if the body has the class 'noSort'
        if (!hasNoSortClass()) {
            // Find all .veeziMovie elements
            const veeziMovies = document.querySelectorAll('.veeziMovie');
            const sortedVeeziMovies = Array.from(veeziMovies)
                .filter((veeziMovie) => {
                    // Exclude films that are 'returning' or 'leaving'
                    return (
                        !veeziMovie.classList.contains('returning') &&
                        !veeziMovie.classList.contains('leaving')
                    );
                })
                .sort((a, b) => {
                    const dateA = new Date(a.dataset.opening);
                    const dateB = new Date(b.dataset.opening);
                    return dateB - dateA; // Reverse the order to show the newest date first
                });

            if (veeziMovies.length > 0) {
                // Assuming all veeziMovie elements have the same parent
                const parentElement = veeziMovies[0].parentNode;
                // Add the 'sortedFilms' class to the parent element
                parentElement.classList.add('sortedFilms');

                // Clear the existing order and append sorted elements
                parentElement.innerHTML = ''; // Clear the existing order

                sortedVeeziMovies.forEach((veeziMovie) => {
                    parentElement.appendChild(veeziMovie);
                });
            }
        }
    }


    // Examples of calling this function
    // addSubtitle('ST00000190', 'Leaving', '2023-09-07');
    // addSubtitle('ST00000172', 'Returning', '2023-09-14');
