<script>
    // Function to generate a random number within a specified range
    function getRandomNumber(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    // Function to apply a random background color and gradient
    function applyRandomBackground() {
        const colors = [
            '#3a0741', '#49302f', '#3a1717', '#1f2244',
            '#1e4249', '#213819', '#673e13'
        ];

        // Generate two unique random indices for gradient colors
        let index1 = getRandomNumber(0, colors.length - 1);
        let index2 = getRandomNumber(0, colors.length - 1);
        while (index1 === index2) {  // Ensure index2 is different from index1
            index2 = getRandomNumber(0, colors.length - 1);
        }

        // Generate a random degree for the gradient
        const randomDegrees = getRandomNumber(0, 360);

        // Construct the gradient and image background style
        const backgroundImage = `url("https://www.mitchelltheatres.com/media/svg/masks.svg"), linear-gradient(${randomDegrees}deg, ${colors[index1]}, ${colors[index2]})`;

        // Apply the background style to the body
        document.body.style.backgroundImage = backgroundImage;

        // Add the class 'randomBg' to the body
        document.body.classList.add('randomBg');
    }

