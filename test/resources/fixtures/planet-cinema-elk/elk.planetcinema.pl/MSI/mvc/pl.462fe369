    <div class="shopping-cart-expired-modal modal fade" id="shoppingCartExpiredModal" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="shoppingCartExpiredModalTitle" aria-describedby="shoppingCartExpiredModalBody" aria-hidden="true" hidden>
        <div class="modal-dialog modal-dialog-centered">
