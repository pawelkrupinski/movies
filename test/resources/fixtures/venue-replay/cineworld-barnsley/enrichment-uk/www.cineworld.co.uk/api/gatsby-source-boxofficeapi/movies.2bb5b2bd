[{"id":"1000049428","title":"Always Lalisa","runtime":6120,"genres":"Documentary, Music","__typename":"Movie","altId":["422452","424943"],"poster":"https://all.web.img.acsta.net/img/2c/d5/2cd578b2ba7615fba04cc5e7c232142d.jpg","coDirectors":{"nodes":[],"__typename":"CreditsPager"},"images":[{"url":"https://all.web.img.acsta.net/img/37/32/3732fd82bc5d97a4d9ecbd1f5287cba1.jpg","__typename":"Image"},{"url":"https://all.web.img.acsta.net/img/a4/f9/a4f96653738260f957f811e12fe4b6ec.jpg","__typename":"Image"}],"quadImages":["https://all.web.img.acsta.net/img/be/54/be54d815bfb7e86812d17f6bef4b644a.jpg"],"directors":{"__typename":"CreditsPager","nodes":[{"__typename":"MovieCredit","person":{"firstName":"Sue","lastName":"Kim (II)","__typename":"Person"}}]},"locale":{"title":"Always Lalisa","synopsis":"Always Lalisa is a feature-length documentary following global superstar LISA during a transformative year away from Blackpink, the K-pop phenomenon that made her one of the world's most recognizable performers. As the group pauses activities, LISA embarks on the first true chapter of her solo career, confronting the question of who she is beyond\nBlackpink.\n\nThe film follows LISA as she writes, records, and releases her debut solo album, Alter Ego, makes her acting debut in the third season of The White Lotus, and prepares for her first major solo performance at the 2025 Coachella Music Festival. Born and raised in Thailand, LISA left home at fourteen to train in South Korea's demanding K-pop system, ultimately\nrising to global superstardom. But forging her own path, particularly in the Western music market, brings new pressures, relentless scrutiny, and the challenge of redefining herself on her own terms.\n\nIntimate, emotional, and revealing, Always Lalisa captures an artist at a crossroads, documenting a year of risk, reinvention, and self-discovery as LISA begins to define not only her next chapter, but the woman and artist she wants to become.","__typename":"MovieLocali