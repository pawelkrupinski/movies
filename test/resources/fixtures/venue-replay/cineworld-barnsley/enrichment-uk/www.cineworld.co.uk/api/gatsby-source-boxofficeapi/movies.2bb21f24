[{"id":"1000041856","title":"George Michael: The Faith Tour","runtime":6780,"genres":"Concert, Documentary, Music","__typename":"Movie","altId":["413488","424759"],"quadImages":[],"poster":"https://all.web.img.acsta.net/img/71/8a/718afaea6754ac35c776f7653373fc47.jpg","coDirectors":{"nodes":[],"__typename":"CreditsPager"},"images":[{"url":"https://all.web.img.acsta.net/img/1f/b8/1fb827091f2a6a9d9015da584d1cb245.jpg","__typename":"Image"}],"directors":{"__typename":"CreditsPager","nodes":[{"__typename":"MovieCredit","person":{"firstName":"Andy","lastName":"Morahan","__typename":"Person"}},{"__typename":"MovieCredit","person":{"firstName":"David","lastName":"Austin","__typename":"Person"}}]},"locale":{"title":"George Michael: The Faith Tour","synopsis":"George Michael was one of the most influential stars of his generation; his voice and songwriting defined an era. Assembled from rediscovered, previously unseen and unheard 35mm footage of his 1988 performance at the Palais Omnisports de Paris-Bercy, this new concert film captures George at the height of his creative power during the record-breaking Faith Tour. Expertly restored and remastered, the film transforms a defining cultural moment into a spectacular cinema experience. An original short film by Mary McCartney opens the feature, using newly discovered audio and imagery from 1986–1988 – the Faith era – creating a rare and intimate ‘time capsule’, offering a vivid insight into George’s mindset at this pivotal moment in his life.","__typename":"MovieLocalized","sdTeasers":[],"hdTeasers":[],"poster":{"url":"https://all.web.img.acsta.net/img/71/8a/718afaea6754ac35c776f7653373fc47.jpg","__typename":"Image"},"sdTrailers":[{"url":"https://m.boxoffice.media/mp4/413488_uk_high.mp4","__typename":"MovieVideo"}],"hdTrailers":[{"url":"https://m.boxoffice.media/QuickTime/413488_uk_hd.mov","__typename":"MovieVideo"}],"cmsAssets":{"__typename":"CMSAsset","images":[{"type":"DEFAULT_HERO_IMAGE","url":"https://cms-assets.webediamovies.pro/production/2/82ac641757f83667fc7e69a0d77aa00e.jpg","__typename":"BOAppImage"}]}},"cast":{"__typename":"CreditsPager","nodes":[{"__typename":"MovieCredit","actor":{"firstName":"George","lastName":"Michael","__typename":"Person"},"originalVoiceActor":null,"localizedVoiceActor":null}]},"releases":[{"releasedAt":"2026-11-06T00:00:00.000Z","__typename":"Release","rating":{"advisory":null,"__typename":"Rating","certificate":null},"localRatings":[],"distributors":[{"id":"13733","name":"Universal International Pictures","__typename":"Company"}]}],"embargoes":[],"exhibitor":{"title":null,"poster":null,"synopsis":null,"__typename":"MovieLocalizedOverride","images":[]},"originalTitle":"George Michael: The Faith Tour","synopsis":"George Michael was one of the most influential stars of his generation; his voice and songwriting defined an era. Assembled from rediscovered, previously unseen and unheard 35mm footage of his 1988 performance at the Palais Omnisports de Paris-Bercy, this new concert film captures George at the height of his creative power during the record-breaking Faith Tour. Expertly restored and remastered, the film transforms a defining cultural moment into a spectacular cinema experience. An original short film by Mary McCartney opens the feature, using newly discovered audio and imagery from 1986–1988 – the Faith era – creating a rare and intimate ‘time capsule’, offering a vivid insight into George’s mindset at this pivotal moment in his life.","certificate":null,"casting":["George Michael"],"direction":["Andy Morahan","David Austin"],"coDirection":[],"pictures":["https://all.web.img.acsta.net/img/1f/b8/1fb827091f2a6a9d9015da584d1cb245.jpg"],"heroImages":["https://cms-assets.webediamovies.pro/production/2/82ac641757f83667fc7e69a0d77aa00e.jpg"],"release":"2026-11-06T00:00:00.000Z","advisory":null,"trailer":{"SD":"https://m.boxoffice.media/mp4/413488_uk_high.mp4","HD":"https://m.boxoffice.media/QuickTime/413488_uk_hd.mov"},"localizations":[],"studio":{"na