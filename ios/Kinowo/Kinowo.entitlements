<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Wired into the build via `CODE_SIGN_ENTITLEMENTS = Kinowo/Kinowo.entitlements;`
  on the app target (both Debug and Release build settings in project.pbxproj).
  Associated Domains (iOS Universal Links) requires a PAID Apple Developer
  Program membership; with automatic signing on a paid team, Xcode enables the
  Associated Domains capability for the App ID in the portal on the next
  build/archive. (On a free/personal team this file must be un-referenced again —
  "Personal development teams do not support the Associated Domains capability" —
  leaving only the kinowo:// custom URL scheme in Info.plist, which needs no
  paid account.)

  The AASA is served at each PUBLIC HOST's root,
  https://<host>/.well-known/apple-app-site-association — one identical file
  (same app ID, same path patterns) on kinowo.net and showtimes.cc, since they
  run the same web binary + resources. There are only two hosts now: the three
  Showtimes countries share showtimes.cc and are told apart by a leading path
  segment (showtimes.cc/uk/...), not by a subdomain, so the file's path patterns
  carry both shapes and the domain list carries neither uk. nor de. nor us.
-->
<dict>
	<!-- Universal Links: the OS fetches https://<host>/.well-known/
	     apple-app-site-association for each associated domain and routes matching
	     links (city, film, copy-to-clipboard filter links) into the app via
	     onOpenURL. One entry per public HOST — two, not four, since the Showtimes
	     countries share showtimes.cc. Mirror DeepLink.webHosts. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:kinowo.net</string>
		<string>applinks:showtimes.cc</string>
		<string>webcredentials:kinowo.net</string>
		<string>webcredentials:showtimes.cc</string>
	</array>
</dict>
</plist>
