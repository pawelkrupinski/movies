#!/usr/bin/env bash
# Terraform, with the credentials this root module needs taken from the operator's Touch ID vault
# (`secrets`), never from a file.
#
# IT EXISTS SO THAT NO HETZNER TOKEN IS EVER WRITTEN INTO A tfvars FILE OR A SHELL HISTORY. The
# hcloud provider reads HCLOUD_TOKEN from the environment and nothing else; the vault calls the
# same value HETZNER_API_TOKEN (namespace `movies`) because that is what every other script in this
# repository calls it.
#
# The Terraform Cloud backend (organisation `bitcashier`, workspace `kinowo-infra`) runs in LOCAL
# execution mode, so the plan happens here and only the state is stored remotely -- which is the
# reason the Hetzner token has to be present locally at all, and the reason it never leaves. The TFC
# token is TF_TOKEN_app_terraform_io in the vault's `bitcashier` namespace (same TFC organisation).
#
# HOW: if a variable is missing, this script re-runs itself under `secrets run`, which unlocks the
# namespace (one Touch ID) and execs it again with the variable set. Already set (CI, or a caller
# that exported it) means no vault lookup at all. There is no .env.local any more (2026-10-09).
#
#   infra/bin/tf plan
#   infra/bin/tf apply
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

[[ -n "${HCLOUD_TOKEN:-}" ]] || exec secrets run movies HCLOUD_TOKEN=HETZNER_API_TOKEN -- "$0" "$@"
[[ -n "${TF_TOKEN_app_terraform_io:-}" ]] || exec secrets run bitcashier TF_TOKEN_app_terraform_io -- "$0" "$@"

exec terraform -chdir="$here/../terraform" "$@"
