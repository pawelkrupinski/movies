#!/usr/bin/env python3
"""Replay every alerting rule against the fleet's REAL Prometheus history, and say what it did.

promtool (test/alert-rules/) asks whether a rule does what its author MEANT on a series the author
wrote. This asks the other question: what would the rule, AS IT IS WRITTEN IN THIS TREE, have done
over the last N days of what the fleet actually reported. Sixteen fixes on this repository were an
alert meaning the wrong thing on real data while passing its own synthetic cases:

  * MongodNoPrimary paged continuously against a healthy replica set;
  * one image-policy alert was firing 46% of the time;
  * three Flux rules selected a gauge this fleet has never published, and could never fire;
  * a host was dark for 27 hours without a page.

For every `alert:` in nix/files/monitoring/rules/*.rules -- and every Grafana-managed rule in
grafana/alerting/alert-rules.yaml, translated to the Prometheus alert it is equivalent to -- this

  1. evaluates `expr` with query_range over the window (the same instant-query semantics the rule
     evaluator uses, at `--step` resolution rather than every 15s);
  2. simulates the `for:` hold (and `keep_firing_for:`) per output series -- a series fires at t
     when it has been returned at every step since at least t - for;
  3. reports the fraction of the window the ALERT (any series) was firing, the number of distinct
     episodes, and the peak number of firing series.

An alert over a RECORDING rule would read what Prometheus recorded from the DEPLOYED recording, so a
recording changed in this tree (or new, or reading one that is) is inlined as written: `name`
becomes its expression, `name offset D` a one-point subquery D ago (expand_recordings).

It fails (exit 1) when

  * NOISY -- an alert fires more than `max_firing_fraction` of the window or more than
    `max_episodes_per_week` distinct times, not counting firing inside a catalogued incident it
    is expected to fire in, unless allowlisted with a reason;
  * DEAD -- the expr returned nothing for the whole window AND a metric it reads has no series in
    the window. (Quiet with every metric present is the healthy case: the condition just did not
    happen.) Metrics listed as `conditional_metrics` in the allowlist -- published only in an
    exceptional state -- never count as missing. An alert Prometheus has not loaded yet (a rule
    on a branch) is reported as NOT DEPLOYED and does not fail;
  * an INCIDENT in test/alert-incidents.yml is contradicted: an alert listed under `expect_firing`
    never fired within the window (plus its `grace`), or one under `expect_quiet` fired in it (an
    incident that starts before the retained history is skipped and reported, never a failure: the
    catalogue keeps every incident, and each one ages out of retention in time);
  * the allowlist names an alert that no longer exists.

A metric ROLLED OUT inside the window (absent, then present for the rest of it) clips the alerts
reading it to start at the rollout, so an absent-style rule is not blamed for the days before
its metric existed.

The result is written to test/alert-backtest.json, which is checked in: its diff between two runs
is how a rule's behaviour on real data changes with the rule.

WHERE THE HISTORY COMES FROM (`--source`):

  snapshot (default)  a COPY of monitoring-1's persisted TSDB blocks -- on ci-runner, pulled nightly
                      into /var/lib/prometheus-snapshot/current (bitcashier infra
                      hosts/ci-runner/prometheus-snapshot.nix; this host's side is
                      nix/modules/roles/prometheus-block-export.nix). A throwaway Prometheus of the
                      version production runs is started over a private copy of it, queried, and
                      torn down: production is never asked anything. The window ends where the copy
                      does, and "deployed?" / "stale recording?" read the rules production had
                      loaded, captured beside the blocks -- not the replay's, which loads none.
                      .github/workflows/alert-backtest.yml runs it nightly and for any branch.
  live                monitoring-1's own Prometheus over the SOCKS tunnel (`ssh -f -N kinowo-fleet`),
                      for an ad-hoc look at the last hours. A full run this way took 60-70 min and
                      slowed production's rule evaluation from 3 s to 21 s (2026-11-18): don't.

See nix/files/monitoring/README.md.

Usage:
  infra/bin/backtest-alerts                    # all rules, 14 days, write the baseline, check
  infra/bin/backtest-alerts --alert HostDown   # just these alerts, no baseline written
  infra/bin/backtest-alerts --no-write         # check without touching the baseline
  infra/bin/backtest-alerts --source live --alert HostDown --days 1
"""

import argparse
import concurrent.futures
import datetime
import glob
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.parse

import yaml

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "test"))
from promql_selectors import metric_names, selectors  # noqa: E402  (shared with the dashboards' name check)

HERE = os.path.dirname(os.path.abspath(__file__))
INFRA = os.path.dirname(HERE)
RULES_GLOB = os.path.join(INFRA, "nix", "files", "monitoring", "rules", "*.rules")
GRAFANA_RULES = os.path.join(INFRA, "nix", "files", "monitoring", "grafana", "alerting", "alert-rules.yaml")
BASELINE = os.path.join(INFRA, "test", "alert-backtest.json")
ALLOWLIST = os.path.join(INFRA, "test", "alert-backtest-allowlist.yml")
INCIDENTS = os.path.join(INFRA, "test", "alert-incidents.yml")

DEFAULT_PROMETHEUS = "http://10.20.0.11:9090"
DEFAULT_SOCKS = "127.0.0.1:1080"
DEFAULT_SNAPSHOT = "/var/lib/prometheus-snapshot/current"

# ── PURE LOGIC (unit-tested in test/test_backtest_alerts.py) ─────────────────────────────────────

_DURATION_UNITS = {"ms": 0.001, "s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800, "y": 31536000}


def seconds(duration):
    """A Prometheus duration ("1h30m", "15s", "2d") in seconds; 0 when unset."""
    if duration in (None, "", 0):
        return 0
    if isinstance(duration, (int, float)):
        return float(duration)
    parts = re.findall(r"(\d+)(ms|[smhdwy])", duration)
    if not parts or "".join(n + u for n, u in parts) != duration:
        raise ValueError("not a Prometheus duration: %r" % duration)
    return sum(int(n) * _DURATION_UNITS[u] for n, u in parts)


def firing_steps(present, grid, hold, keep_firing_for=0):
    """The set of grid timestamps at which one series is FIRING.

    `present` is the set of timestamps at which the expression returned this series. A series is
    pending from the first step of an unbroken run of presence and fires once the run is at least
    `hold` seconds old -- which is what the rule evaluator does, at the grid's resolution. A step
    with no sample ends the run and resets the hold, as a real gap does. `keep_firing_for` keeps an
    already-firing series firing that long past its last sample.
    """
    firing = set()
    run_start = None
    last_fired = None
    for t in grid:
        if t in present:
            if run_start is None:
                run_start = t
            if t - run_start >= hold:
                firing.add(t)
                last_fired = t
        else:
            run_start = None
            if last_fired is not None and t - last_fired <= keep_firing_for:
                firing.add(t)
    return firing


def episodes(steps, grid):
    """[(start, end)] contiguous runs of `steps` along `grid` (end is the last firing step)."""
    runs = []
    start = prev = None
    for t in grid:
        if t in steps:
            if start is None:
                start = t
            prev = t
        elif start is not None:
            runs.append((start, prev))
            start = None
    if start is not None:
        runs.append((start, prev))
    return runs


def summarise(series_present, grid, hold, keep_firing_for, window_start, excused=()):
    """Firing statistics for one alert over the part of `grid` at or after `window_start`.

    `series_present` maps a series key to the timestamps it was returned at. The grid starts early
    by the hold so an alert already pending when the window opens is not reset by its edge.
    `excused` is [(start, end)] windows of catalogued incidents in which this alert is EXPECTED to
    fire: firing inside them is reported, but does not count against the noise budget.
    """
    in_window = [t for t in grid if t >= window_start]
    union = set()
    series_episodes = 0
    series_runs = []
    peak = {}
    for key, present in series_present.items():
        steps = {t for t in firing_steps(present, grid, hold, keep_firing_for) if t >= window_start}
        union |= steps
        series_episodes += len(episodes(steps, in_window))
        own = {t for t in steps if not any(a <= t <= b for a, b in excused)}
        series_runs += [(key, a, b) for a, b in episodes(own, in_window)]
        for t in steps:
            peak[t] = peak.get(t, 0) + 1
    unexcused = {t for t in union if not any(a <= t <= b for a, b in excused)}
    budget_grid = [t for t in in_window if not any(a <= t <= b for a, b in excused)]
    returned = any(t >= window_start for present in series_present.values() for t in present)
    return {
        "firing_fraction": (len(union) / len(in_window)) if in_window else 0.0,
        "episodes": len(episodes(union, in_window)),
        "budget_firing_fraction": (len(unexcused) / len(budget_grid)) if budget_grid else 0.0,
        "budget_episodes": len(episodes(unexcused, budget_grid)),
        "series_episodes": series_episodes,
        "peak_series": max(peak.values()) if peak else 0,
        "returned_data": returned,
        "runs": episodes(union, in_window),
        # each series' firing outside the catalogued incidents: the evidence a noisy verdict is judged on
        "series_runs": sorted(series_runs, key=lambda run: (run[1], run[0])),
    }


def noisy_episodes(stats, limit=60):
    """(how many, the first `limit` by start) of a noisy alert's firing runs outside catalogued incidents, each
    with its series' labels: whether it was a real incident (catalogue it), a rule meaning the wrong thing (fix
    it) or a fair rate (budget it) is read off these, not off one longest episode (Alert backtest #1)."""
    runs = sorted(stats.get("series_runs", []), key=lambda run: (run[1], run[0]))
    return len(runs), [{"series": json.loads(key), "from": iso(a), "to": iso(b)} for key, a, b in runs[:limit]]


def rollout_start(presence, grid, min_coverage=0.9):
    """When a metric was ROLLED OUT inside the window, the time it first appeared; else None.

    A metric that appears part-way through the window and is then present for (nearly) all of
    the rest was deployed then, and an alert over it -- above all an `absent`-style one -- was
    "firing" before that only because the rule is newer than the data. A metric that comes and
    goes (published only while a host is blocked, a pod is waiting...) is not a rollout, and is
    not clipped: its gaps are the signal.
    """
    if not presence or not grid:
        return None
    first = min(presence)
    if first <= grid[0]:
        return None
    after = [t for t in grid if t >= first]
    if len([t for t in after if t in presence]) / float(len(after)) < min_coverage:
        return None
    return first


def verdict(stats, budget, allow, missing_metrics, deployed):
    """(status, problem or None) for one alert's statistics against its budget and allowlist.

    status is one of: ok, quiet, noisy, dead, not-deployed, error.
    """
    if stats.get("error"):
        return "error", "query failed: %s" % stats["error"]
    if not stats["returned_data"]:
        if missing_metrics:
            if not deployed:
                return "not-deployed", None
            if allow.get("dead"):
                return "dead", None
            return "dead", ("returned no data for the whole window and reads metrics with no "
                            "series in it: %s" % ", ".join(sorted(missing_metrics)))
        return "quiet", None
    weeks = max(stats.get("days", budget["days"]), 1.0) / 7.0
    max_fraction = allow.get("max_firing_fraction", budget["max_firing_fraction"])
    max_per_week = allow.get("max_episodes_per_week", budget["max_episodes_per_week"])
    problems = []
    fraction, count = stats["budget_firing_fraction"], stats["budget_episodes"]
    if fraction > max_fraction:
        problems.append("fired %.1f%% of the window outside catalogued incidents (budget %.1f%%)"
                        % (100 * fraction, 100 * max_fraction))
    if count / weeks > max_per_week:
        problems.append("fired %d distinct times outside catalogued incidents, %.1f/week "
                        "(budget %s/week)" % (count, count / weeks, max_per_week))
    if not problems:
        return "ok", None
    if allow.get("noisy"):
        return "noisy", None
    return "noisy", "; ".join(problems)


# ── RULES, ALLOWLIST, INCIDENTS ──────────────────────────────────────────────────────────────────


def load_rules(pattern=RULES_GLOB, grafana=GRAFANA_RULES):
    """{alert: rule dict + file} across every Prometheus rule file and the Grafana-managed rules.

    A Grafana rule is translated into the Prometheus alert it is equivalent to, keyed by its uid:
    every one in this tree is a threshold node over the `last` of one instant query, so
    `(query) <op> <threshold>`, plus `or absent(query)` when its no-data state is Alerting. Any
    other shape is refused rather than guessed at.
    """
    alerts = {}
    for path in sorted(glob.glob(pattern)):
        with open(path, encoding="utf-8") as handle:
            document = yaml.safe_load(handle) or {}
        for group in document.get("groups") or []:
            for rule in group.get("rules") or []:
                if "alert" in rule:
                    entry = dict(rule)
                    entry["file"] = os.path.basename(path)
                    entry["interval"] = group.get("interval")
                    alerts[rule["alert"]] = entry
    if grafana and os.path.exists(grafana):
        with open(grafana, encoding="utf-8") as handle:
            document = yaml.safe_load(handle) or {}
        for group in document.get("groups") or []:
            for rule in group.get("rules") or []:
                alerts[rule["uid"]] = grafana_as_prometheus(rule, os.path.basename(grafana))
    return alerts


def load_recordings(pattern=RULES_GLOB):
    """{record name: {expr, interval}} for every recording rule in the tree, with its group's interval.

    A name recorded by more than one rule is left out: which of them an expression means is not
    something to guess, so such a name is always read as Prometheus recorded it."""
    records, seen = {}, set()
    for path in sorted(glob.glob(pattern)):
        with open(path, encoding="utf-8") as handle:
            document = yaml.safe_load(handle) or {}
        for group in document.get("groups") or []:
            for rule in group.get("rules") or []:
                if "record" in rule:
                    name = rule["record"]
                    if name in seen:
                        records.pop(name, None)
                        continue
                    seen.add(name)
                    records[name] = {"expr": str(rule["expr"]).strip(),
                                     "interval": group.get("interval") or "1m"}
    return records


def _record_reference(name):
    # The name as a whole identifier (recording names carry colons), outside a quoted string, with
    # an optional matcher block and `offset`.
    return re.compile(r'(?<![\w:"])' + re.escape(name) + r'(?![\w:])(\s*\{[^}]*\})?(\[[0-9a-z]+\])?'
                      r'(\s+offset\s+([0-9a-z]+))?')


def _outside_strings(expr, start):
    return expr[:start].count('"') % 2 == 0


def stale_recordings(records, loaded, normalise, recorded=None):
    """The recordings whose recorded series do NOT say what the tree's rule says: changed since
    Prometheus loaded it (compared through `normalise(name, expr)`, Prometheus's own formatter), not
    loaded at all, loaded but with no series in the window (`recorded`, the metric names that have
    some: deployed after the window, as a rule loaded today over a copy that ends at midnight is --
    inlining one that is merely empty changes nothing), or reading -- however deeply -- one that is."""
    stale = {name for name, rule in records.items()
             if name not in loaded or normalise(name, rule["expr"]) != normalise(name, loaded[name])
             or (recorded is not None and name not in recorded)}
    grew = True
    while grew:
        grew = False
        for name, rule in records.items():
            if name not in stale and any(_record_reference(dep).search(rule["expr"]) for dep in stale):
                stale.add(name)
                grew = True
    return stale


def expand_recordings(expr, records, stale):
    """`expr` with every stale recording replaced by its tree expression, so a backtest evaluates
    the rules AS WRITTEN rather than what Prometheus recorded from the deployed ones.

    `name` becomes `(expr)`; `name offset D` -- the recording as it was D ago -- becomes
    `last_over_time((expr)[I:I] offset D)` at the recording's own interval I, the one point it
    would have been recorded at; `name[R]` (with or without an offset) becomes the subquery
    `(expr)[R:I]`, the samples it would have recorded over R. A matcher block on a stale recording cannot be applied to an
    expression and is refused."""
    for _ in range(10):
        before = expr
        for name in stale:
            pattern = _record_reference(name)
            rule = records[name]

            def substitute(match):
                if not _outside_strings(match.string, match.start()):
                    return match.group(0)
                if match.group(1):
                    raise ValueError("cannot inline %s: it is read with matchers %s"
                                     % (name, match.group(1).strip()))
                if match.group(2):
                    return "(%s)[%s:%s]%s" % (rule["expr"], match.group(2)[1:-1], rule["interval"],
                                              match.group(3) or "")
                if match.group(3):
                    return "last_over_time((%s)[%s:%s] offset %s)" % (
                        rule["expr"], rule["interval"], rule["interval"], match.group(4))
                return "(%s)" % rule["expr"]
            expr = pattern.sub(substitute, expr)
        if expr == before:
            return expr
    raise ValueError("recording rules nest more than ten deep, or cyclically")


def grafana_as_prometheus(rule, file):
    nodes = {node["refId"]: node["model"] for node in rule["data"]}
    condition = nodes[rule["condition"]]
    if condition.get("type") != "threshold" or len(condition.get("conditions") or []) != 1:
        raise ValueError("%s: condition is not a single threshold" % rule["uid"])
    evaluator = condition["conditions"][0]["evaluator"]
    operator = {"gt": ">", "lt": "<"}.get(evaluator["type"])
    query = nodes[condition["expression"]]
    if operator is None or not query.get("expr") or query.get("range"):
        raise ValueError("%s: not a threshold over one instant query" % rule["uid"])
    expr = "(%s) %s %r" % (query["expr"].strip(), operator, float(evaluator["params"][0]))
    if rule.get("noDataState") == "Alerting":
        expr = "(%s) or absent(%s)" % (expr, query["expr"].strip())
    return {"alert": rule["uid"], "expr": expr, "for": rule.get("for", "0s"), "file": file,
            "grafana": True}


def load_yaml(path, default):
    if not os.path.exists(path):
        return default
    with open(path, encoding="utf-8") as handle:
        return yaml.safe_load(handle) or default


def parse_time(value):
    if isinstance(value, datetime.datetime):
        dt = value
    else:
        dt = datetime.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    return dt.timestamp()


def iso(ts):
    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class QueryTimeout(RuntimeError):
    """Prometheus could not evaluate a query inside its query timeout (or curl gave up waiting)."""


_TIMEOUT_MARKERS = ("query timed out", "context deadline exceeded", "curl: (28)")


def is_query_timeout(message):
    """Whether an error says the query ran out of time -- which a SMALLER range can fix -- rather
    than being wrong (a parse error) or the path to Prometheus failing (a proxy drop), which it cannot."""
    return any(m in message for m in _TIMEOUT_MARKERS)


def fetch_range(get_chunk, start, end, step, chunk=86400, min_chunk=3600):
    """{series key: set(timestamps)} over [start, end] on a `step` grid, asking `get_chunk(t0, t1)`
    for `chunk`-second ranges. A range that times out is HALVED (on the step grid) and both halves
    asked, down to `min_chunk`: a heavy rule over a day can exceed Prometheus's query timeout where
    the same rule over six hours does not, and retrying the day whole only times out again. A range
    still timing out at the floor raises QueryTimeout."""
    series = {}

    def fetch(t0, t1):
        try:
            results = get_chunk(t0, t1)
        except QueryTimeout:
            if t1 - t0 < 2 * min_chunk:
                raise
            mid = t0 + ((t1 - t0) // 2 // step) * step
            fetch(t0, mid)
            fetch(mid + step, t1)
            return
        for result in results:
            key = json.dumps(result["metric"], sort_keys=True)
            series.setdefault(key, set()).update(float(v[0]) for v in result["values"])

    t = start
    while t <= end:
        chunk_end = min(t + chunk - step, end)
        fetch(t, chunk_end)
        t = chunk_end + step
    return series


# ── PROMETHEUS ───────────────────────────────────────────────────────────────────────────────────


class Prometheus(object):
    """Prometheus's HTTP API over curl, because only curl speaks SOCKS without a dependency."""

    def __init__(self, url, socks):
        self.url, self.socks = url.rstrip("/"), socks

    def get(self, path, params, timeout=180):
        query = urllib.parse.urlencode(params, doseq=True)
        command = ["curl", "-sS", "-G", "--max-time", str(timeout), "--data", query]
        if self.socks:
            command += ["--socks5-hostname", self.socks]
        command.append(self.url + path)
        for attempt in range(3):
            out = subprocess.run(command, capture_output=True, text=True)
            if out.returncode == 0:
                try:
                    body = json.loads(out.stdout)
                except ValueError:
                    body = {"status": "error", "error": out.stdout[:200]}
                if body.get("status") == "success":
                    return body["data"]
                error = body.get("error", "unknown error")
                if "exceeded maximum resolution" in error or "parse error" in error:
                    raise RuntimeError(error)
            else:
                error = out.stderr.strip()[:200]
            # A timeout fails the same way again at the same size: the caller splits the range instead.
            if is_query_timeout(error):
                raise QueryTimeout(error)
            time.sleep(2 * (attempt + 1))
        raise RuntimeError(error)

    def ready(self):
        command = ["curl", "-s", "--max-time", "5", self.url + "/-/ready"]
        if self.socks:
            command[1:1] = ["--socks5-hostname", self.socks]
        return subprocess.run(command, capture_output=True).returncode == 0

    def metric_names(self, start, end):
        return set(self.get("/api/v1/label/__name__/values", {"start": start, "end": end}))

    def loaded_alerts(self):
        data = self.get("/api/v1/rules", {"type": "alert"})
        return {r["name"] for g in data["groups"] for r in g["rules"]}

    def loaded_recordings(self):
        data = self.get("/api/v1/rules", {"type": "record"})
        return {r["name"]: r["query"] for g in data["groups"] for r in g["rules"]}

    def format_query(self, expr):
        return self.get("/api/v1/format_query", {"query": expr})

    def lowest_timestamp(self):
        data = self.get("/api/v1/query", {"query": "min(prometheus_tsdb_lowest_timestamp_seconds)"})
        return float(data["result"][0]["value"][1]) if data["result"] else None

    def presence(self, expr, start, end, step, chunk=86400):
        """{series key: set(timestamps)} for `expr` over [start, end] on a `step` grid."""
        def get_chunk(t0, t1):
            return self.get("/api/v1/query_range", {"query": expr, "start": t0, "end": t1, "step": step})["result"]
        return fetch_range(get_chunk, start, end, step, chunk=chunk, min_chunk=min(3600, chunk))


def loaded_rules(document, kind):
    """{name: query} of the `kind` ("alerting" / "recording") rules in a /api/v1/rules document."""
    return {r["name"]: r["query"] for g in document["data"]["groups"] for r in g["rules"]
            if r.get("type") == kind}


class LiveSource(object):
    """Production's Prometheus itself: what it has loaded now, its retention floor, the window to now."""

    def __init__(self, prom):
        self.prom = prom

    def loaded_alerts(self):
        return self.prom.loaded_alerts()

    def loaded_recordings(self):
        return self.prom.loaded_recordings()

    def floor(self):
        return self.prom.lowest_timestamp()

    def latest(self):
        return time.time()


class Snapshot(object):
    """A pulled copy of production's blocks (DIR/tsdb/<ulid>/), with what production had loaded
    (rules.json, buildinfo.json) and the range its blocks cover (pull.json), all captured with it."""

    def __init__(self, directory):
        self.directory = os.path.realpath(directory)
        self.tsdb = os.path.join(self.directory, "tsdb")

        def read(name):
            with open(os.path.join(self.directory, name), encoding="utf-8") as handle:
                return json.load(handle)
        self.pull, self.rules, self.buildinfo = read("pull.json"), read("rules.json"), read("buildinfo.json")
        self.version = self.buildinfo["data"]["version"]

    def loaded_alerts(self):
        return set(loaded_rules(self.rules, "alerting"))

    def loaded_recordings(self):
        return loaded_rules(self.rules, "recording")

    def floor(self):
        return float(self.pull["min_time"])

    def latest(self):
        return float(self.pull["max_time"])


def replay_arguments(binary, config, data, port, jobs):
    """The throwaway Prometheus's command line. No scrape targets and no rules (`config` is empty), so
    nothing is written but its own lock and WAL; compaction off (min = max block duration), so the
    copied blocks are never rewritten; retention far past any block, so none is deleted; a query
    timeout long enough that a heavy rule over a day finishes rather than being split."""
    return [binary,
            "--config.file=" + config,
            "--storage.tsdb.path=" + data,
            "--storage.tsdb.retention.time=3650d",
            "--storage.tsdb.min-block-duration=2h",
            "--storage.tsdb.max-block-duration=2h",
            "--web.listen-address=127.0.0.1:%d" % port,
            "--query.timeout=10m",
            "--query.max-concurrency=%d" % max(jobs, 4),
            "--query.max-samples=500000000",
            "--log.level=warn"]


class Replay(object):
    """A throwaway Prometheus over a PRIVATE copy of a snapshot, for one run: the copy is taken so the
    snapshot itself (read-only on ci-runner) is never touched, and is removed with the process."""

    def __init__(self, snapshot, binary, jobs, ready_timeout=300):
        self.snapshot, self.binary, self.jobs, self.ready_timeout = snapshot, binary, jobs, ready_timeout
        self.work = self.process = None

    def __enter__(self):
        self.work = tempfile.mkdtemp(prefix="backtest-replay-")
        data = os.path.join(self.work, "data")
        started = time.time()
        shutil.copytree(self.snapshot.tsdb, data)
        config = os.path.join(self.work, "prometheus.yml")
        with open(config, "w", encoding="utf-8") as handle:
            handle.write("global: {}\n")
        with socket.socket() as probe:
            probe.bind(("127.0.0.1", 0))
            port = probe.getsockname()[1]
        log = open(os.path.join(self.work, "prometheus.log"), "w")
        self.process = subprocess.Popen(replay_arguments(self.binary, config, data, port, self.jobs),
                                        stdout=log, stderr=subprocess.STDOUT)
        prom = Prometheus("http://127.0.0.1:%d" % port, None)
        deadline = time.time() + self.ready_timeout
        while not prom.ready():
            if self.process.poll() is not None or time.time() > deadline:
                with open(log.name, encoding="utf-8") as handle:
                    tail = handle.read()[-2000:]
                self.__exit__(None, None, None)
                raise RuntimeError("the replay Prometheus did not become ready:\n" + tail)
            time.sleep(1)
        version = prom.get("/api/v1/status/buildinfo", {})["version"]
        if version != self.snapshot.version:
            self.__exit__(None, None, None)
            raise RuntimeError("the replay Prometheus is %s, production ran %s: install the same version"
                               % (version, self.snapshot.version))
        print("replay: Prometheus %s over %s, ready in %.0f s"
              % (version, self.snapshot.directory, time.time() - started))
        return prom

    def __exit__(self, *_):
        if self.process and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(60)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait()
        if self.work:
            shutil.rmtree(self.work, ignore_errors=True)
        return False


def grid_of(start, end, step):
    n = int((end - start) // step)
    return [start + i * step for i in range(n + 1)]


def snap_up(t, step):
    return t if t % step == 0 else t - (t % step) + step


def backtest(prom, rule, start, end, step, floor, excused=(), lead_in=True):
    """Statistics for one alert over [start, end], at `step` or its group's interval if longer.

    Prometheus asks a rule its question once per group interval; a finer grid only asks the same
    one again, and a rule in a slow group is slow because each evaluation is costly
    (CityDarkInBothTiers, every five minutes, read six days of a per-city census raw: a day at a
    one-minute step ran past the query timeout, at five minutes it took 24 s)."""
    step = max(step, int(seconds(rule.get("interval"))))
    hold = seconds(rule.get("for"))
    keep = seconds(rule.get("keep_firing_for"))
    lead = start
    if lead_in:
        # Start early by the hold so an alert already pending at `start` keeps its age, on the
        # same step grid so every chunk lines up.
        lead = max(start - hold - step, floor or 0)
        lead = start - ((start - lead) // step) * step
    try:
        present = prom.presence(rule["expr"], lead, end, step)
    except RuntimeError as err:
        return {"error": str(err), "returned_data": False}
    stats = summarise(present, grid_of(lead, end, step), hold, keep, start, excused)
    stats["days"] = (end - start) / 86400.0
    return stats


def observed_fraction(prom, name, start, end, step):
    """How much of the window Prometheus ITSELF had this alert firing (ALERTS), for comparison.

    It differs from the simulation wherever the deployed rule differs from this tree's, or the
    alert did not exist yet -- which is the point of printing both.
    """
    try:
        present = prom.presence('max(ALERTS{alertname="%s",alertstate="firing"})' % name,
                                start, end, step)
    except RuntimeError:
        return None
    steps = set().union(*present.values()) if present else set()
    return len(steps) / float(len(grid_of(start, end, step)))


def rollout_queries(expr, existing, conditional):
    """What `expr` reads that may have been rolled out inside the window: each metric name it reads that has
    series in the window, and each selector over such a name with its label matchers, as written. A name can
    exist from the start while the series a rule selects appear only later -- `coredns_dns_responses_total` under
    another job, `mongodb_collstats_storageStats_storageSize` for other collections (Alert backtest #1:
    CoreDnsMetricsAbsent and IdentityRetainedSizeAbsent fired in the replay until their selector appeared, and
    never in production)."""
    names = (metric_names(expr) - set(conditional)) & existing
    found = set(names)
    for selector in selectors(expr):
        labels = selector.label_matchers
        if selector.name in names and labels:
            found.add("%s{%s}" % (selector.name, ",".join(
                '%s%s%s' % (m.label, m.op, json.dumps(m.value)) for m in labels)))
    return found


def stale_conditional_metrics(rollouts, conditional):
    """A conditional metric (published only in an exceptional state) comes and goes; one ROLLED OUT inside the
    window -- absent, then present for the rest of it -- is a metric that was waiting for a deploy, and its entry
    outlived it: rollout clipping skips a conditional metric, so the absent()-style alerts reading it are blamed
    for the days before (Alert backtest #3: CoreDnsMetricsAbsent, IdentityRetainedSizeAbsent)."""
    return ["%s: listed in conditional_metrics but rolled out at %s and present since -- refresh metric-names.json"
            " (infra/bin/snapshot-label-values --names-only, which test_metric_names.py reads in its place) and"
            " strike its entry in %s" % (m, iso(rollouts[m]), os.path.basename(ALLOWLIST))
            for m in sorted(conditional) if m in rollouts]


def metric_rollouts(prom, metrics, start, end, jobs):
    """{metric or selector: rollout time} for each one in `metrics` (rollout_queries) deployed inside the window."""
    step = 900
    grid = grid_of(start, end, step)

    def one(metric):
        query = "count(%s)" % metric if "{" in metric else 'count({__name__="%s"})' % metric
        try:
            present = prom.presence(query, start, end, step,
                                    chunk=end - start + step)
        except RuntimeError:
            return metric, None
        steps = set().union(*present.values()) if present else set()
        return metric, rollout_start(steps, grid)

    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        return {m: t for m, t in pool.map(one, sorted(metrics)) if t is not None}


def excused_windows(catalogue, step):
    """{alert: [(start, end)]} -- the incident windows each alert is EXPECTED to fire in."""
    windows = {}
    for incident in catalogue:
        start, end = parse_time(incident["start"]), parse_time(incident["end"])
        end += seconds(incident.get("grace", "1h"))
        for name in incident.get("expect_firing") or []:
            windows.setdefault(name, []).append((start - start % step, end))
    return windows


# ── MAIN ─────────────────────────────────────────────────────────────────────────────────────────


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--days", type=float, default=14)
    parser.add_argument("--step", type=int, default=60, help="evaluation resolution, seconds")
    parser.add_argument("--end", help="window end (ISO, UTC); default now")
    parser.add_argument("--alert", action="append", help="only these alerts (repeatable)")
    parser.add_argument("--no-write", action="store_true", help="do not write the baseline")
    parser.add_argument("--no-incidents", action="store_true")
    parser.add_argument("--jobs", type=int, help="parallel queries (default 16 on a snapshot, 6 live)")
    parser.add_argument("--source", choices=("snapshot", "live"), default="snapshot",
                        help="a replay of the pulled copy (default), or production's Prometheus")
    parser.add_argument("--snapshot", default=os.environ.get("BACKTEST_SNAPSHOT", DEFAULT_SNAPSHOT),
                        help="the pulled copy (--source snapshot)")
    parser.add_argument("--prometheus-binary", default=os.environ.get("BACKTEST_PROMETHEUS_BINARY", "prometheus"),
                        help="the replay's Prometheus, the version production runs (--source snapshot)")
    parser.add_argument("--prometheus", default=os.environ.get("BACKTEST_PROMETHEUS", DEFAULT_PROMETHEUS),
                        help="production's Prometheus (--source live)")
    parser.add_argument("--socks", default=os.environ.get("BACKTEST_SOCKS", DEFAULT_SOCKS),
                        help="SOCKS5 proxy host:port, empty for a direct connection (--source live)")
    args = parser.parse_args(argv)
    if args.jobs is None:
        args.jobs = 16 if args.source == "snapshot" else 6

    if args.source == "live":
        prom = Prometheus(args.prometheus, args.socks)
        if not prom.ready():
            print("Prometheus at %s is unreachable%s. Open the tunnel with: ssh -f -N kinowo-fleet"
                  % (args.prometheus, " via SOCKS " + args.socks if args.socks else ""))
            return 2
        return run_backtest(args, prom, LiveSource(prom))
    try:
        snapshot = Snapshot(args.snapshot)
    except (OSError, ValueError, KeyError) as err:
        print("no usable snapshot at %s (%s). It exists on ci-runner: run this there with\n"
              "  gh workflow run alert-backtest.yml --ref <branch>\nor ask production with --source live."
              % (args.snapshot, err))
        return 2
    try:
        with Replay(snapshot, args.prometheus_binary, args.jobs) as prom:
            return run_backtest(args, prom, snapshot)
    except (OSError, RuntimeError) as err:
        print("could not start the replay: %s" % err)
        return 2


def run_backtest(args, prom, source):
    """The backtest proper, against `prom`, with what was deployed and the window from `source`."""
    started = time.time()
    alerts = load_rules()
    # A recording changed in this tree is evaluated as written, not read from what Prometheus
    # recorded from the deployed rule (an alert over `ci:*:reference_threshold` would otherwise
    # be backtested against the old one, or against nothing).
    records = load_recordings()
    formatted = {}

    def normalise(name, expr):
        if expr not in formatted:
            try:
                formatted[expr] = prom.format_query(expr)
            except RuntimeError:
                formatted[expr] = expr
        return formatted[expr]
    allowlist = load_yaml(ALLOWLIST, {})
    defaults = allowlist.get("defaults") or {}
    allowed = allowlist.get("allow") or {}
    conditional = allowlist.get("conditional_metrics") or {}
    catalogue = load_yaml(INCIDENTS, {}).get("incidents") or []
    budget = {
        "days": args.days,
        "max_firing_fraction": float(defaults.get("max_firing_fraction", 0.05)),
        "max_episodes_per_week": float(defaults.get("max_episodes_per_week", 7)),
    }

    step = args.step
    end = parse_time(args.end) if args.end else source.latest()
    end = end - (end % step)
    start = end - args.days * 86400
    floor = source.floor()
    if floor and start < floor:
        print("note: retention starts %s, so the window is clipped to it" % iso(floor))
        start = snap_up(floor, step)
    existing = prom.metric_names(start, end)
    loaded = source.loaded_alerts()
    stale = stale_recordings(records, source.loaded_recordings(), normalise, recorded=existing)
    if stale:
        print("recordings changed in this tree or not recorded in the window, evaluated as written: %s"
              % ", ".join(sorted(stale)))
    for name, rule in alerts.items():
        rule["expr"] = expand_recordings(rule["expr"], records, stale)

    selected = sorted(alerts)
    if args.alert:
        unknown = set(args.alert) - set(alerts)
        if unknown:
            print("unknown alert(s): %s" % ", ".join(sorted(unknown)))
            return 2
        selected = sorted(args.alert)

    problems = []
    for name in sorted(set(allowed) - set(alerts)):
        problems.append("%s: allowlisted in %s but no rule defines it"
                        % (name, os.path.basename(ALLOWLIST)))
    for name, entry in sorted(list(allowed.items()) + list(conditional.items())):
        if not (entry or {}).get("reason"):
            problems.append("%s: allowlist entry has no reason" % name)

    reads = {n: metric_names(alerts[n]["expr"]) - set(conditional) for n in selected}
    watched = {n: rollout_queries(alerts[n]["expr"], existing, conditional) for n in selected}
    rollouts = metric_rollouts(prom, set().union(*watched.values()), start, end, args.jobs)
    problems += stale_conditional_metrics(
        metric_rollouts(prom, set(conditional) & existing, start, end, args.jobs), conditional)
    excused = excused_windows(catalogue, step)

    print("backtesting %d alert(s) over %s .. %s at %ds" % (len(selected), iso(start), iso(end), step))

    def run(name):
        clipped = max([start] + [rollouts[m] for m in watched[name] if m in rollouts])
        clipped = snap_up(clipped, step)
        if clipped >= end - step:
            return name, clipped, {"returned_data": True, "firing_fraction": 0.0, "episodes": 0,
                                   "budget_firing_fraction": 0.0, "budget_episodes": 0,
                                   "series_episodes": 0, "peak_series": 0, "runs": []}, None
        stats = backtest(prom, alerts[name], clipped, end, step, floor,
                         excused.get(name, ()), lead_in=clipped == start)
        observed = None if alerts[name].get("grafana") else \
            observed_fraction(prom, name, clipped, end, step)
        return name, clipped, stats, observed

    results = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        for name, clipped, stats, observed in pool.map(run, selected):
            results[name] = (clipped, stats, observed)

    report = {}
    for name in selected:
        rule = alerts[name]
        clipped, stats, observed = results[name]
        allow = allowed.get(name) or {}
        missing = sorted(m for m in reads[name] if m not in existing)
        status, problem = verdict(stats, budget, allow, missing,
                                  name in loaded or rule.get("grafana", False))
        entry = {
            "file": rule["file"],
            "for": rule.get("for", "0s"),
            "status": status,
            "firing_fraction": round(stats.get("firing_fraction", 0.0), 4),
            "episodes": stats.get("episodes", 0),
            "series_episodes": stats.get("series_episodes", 0),
            "peak_series": stats.get("peak_series", 0),
        }
        if stats.get("budget_firing_fraction", 0) != stats.get("firing_fraction", 0):
            entry["firing_fraction_outside_incidents"] = round(stats["budget_firing_fraction"], 4)
            entry["episodes_outside_incidents"] = stats["budget_episodes"]
        if observed is not None:
            entry["observed_firing_fraction"] = round(observed, 4)
        if clipped != start:
            entry["metrics_rolled_out_at"] = iso(clipped)
        if missing:
            entry["missing_metrics"] = missing
        if allow:
            entry["allowlisted"] = allow.get("reason", "")
        if stats.get("runs"):
            longest = max(stats["runs"], key=lambda r: r[1] - r[0])
            entry["longest_episode"] = [iso(longest[0]), iso(longest[1])]
        if status == "noisy":
            entry["noisy_episodes_total"], entry["noisy_episodes"] = noisy_episodes(stats)
        if stats.get("error"):
            entry["error"] = stats["error"]
        report[name] = entry
        if problem:
            problems.append("%s (%s): %s" % (name, rule["file"], problem))

    width = max(len(n) for n in selected)
    print("  %-*s  %-12s  %8s  %8s  %8s  %4s" % (width, "alert", "status", "firing", "(ALERTS)",
                                                 "episodes", "peak"))
    for name in selected:
        e = report[name]
        obs = e.get("observed_firing_fraction")
        print("  %-*s  %-12s  %7.2f%%  %8s  %8d  %4d%s%s"
              % (width, name, e["status"], 100 * e["firing_fraction"],
                 "-" if obs is None else "%.2f%%" % (100 * obs), e["episodes"], e["peak_series"],
                 "  [since %s]" % e["metrics_rolled_out_at"] if "metrics_rolled_out_at" in e else "",
                 "  [allowlisted]" if "allowlisted" in e else ""))

    pending = [n for n in selected if report[n]["status"] == "not-deployed"]
    if pending:
        print("\nnote: not loaded by Prometheus yet, and reading metrics with no series -- these fail"
              " as DEAD once deployed if the metrics still do not exist:")
        for name in pending:
            print("  %s: %s" % (name, ", ".join(report[name]["missing_metrics"])))

    incident_report = []
    if not args.no_incidents:
        incident_report, incident_problems = check_incidents(prom, alerts, catalogue, step, floor,
                                                             args.alert, end)
        problems += incident_problems

    if not args.no_write and not args.alert:
        with open(BASELINE, "w", encoding="utf-8") as handle:
            json.dump({
                "window": {"start": iso(start), "end": iso(end), "step_seconds": step},
                "budget": {k: v for k, v in budget.items() if k != "days"},
                "alerts": report,
                "incidents": incident_report,
            }, handle, indent=2, sort_keys=True)
            handle.write("\n")
        print("wrote %s" % os.path.relpath(BASELINE))

    print("backtest took %.0f s with %d parallel queries" % (time.time() - started, args.jobs))
    if problems:
        print("\nFAILED -- %d problem(s):" % len(problems))
        for p in problems:
            print("  - " + p)
        print("\nFix the rule (with a promtool case), catalogue the incident it fired for in %s, "
              "or allowlist it with a reason in %s."
              % (os.path.relpath(INCIDENTS), os.path.relpath(ALLOWLIST)))
        return 1
    print("\nok")
    return 0


def check_incidents(prom, alerts, catalogue, step, floor, only, end):
    """Replay each catalogued incident window up to `end`, where the history does; ([result], [problem])."""
    results, problems = [], []
    now = end - step
    for incident in catalogue:
        ident = incident["id"]
        start, end = parse_time(incident["start"]), parse_time(incident["end"])
        grace = seconds(incident.get("grace", "1h"))
        if floor and start < floor:
            # Outside the history the replay can read: reported, never a failure (the owner, 2026-11-18,
            # Alert backtest #1) -- every catalogued incident ages past retention, and the catalogue is kept.
            why = "starts before retention (%s)" % iso(floor)
            print("  incident %-44s skipped: %s" % (ident, why))
            results.append({"id": ident, "skipped": why})
            continue
        start -= start % step
        row = {"id": ident, "firing": {}, "quiet": {}}
        before = len(problems)
        wanted = [(n, True) for n in incident.get("expect_firing") or []] + \
                 [(n, False) for n in incident.get("expect_quiet") or []]
        for name, should_fire in wanted:
            if only and name not in only:
                continue
            if name not in alerts:
                problems.append("incident %s names %s, which no rule defines" % (ident, name))
                continue
            window_end = min(end + grace if should_fire else end, now)
            window_end -= window_end % step
            stats = backtest(prom, alerts[name], start, window_end, step, floor)
            if stats.get("error"):
                problems.append("incident %s: %s query failed: %s" % (ident, name, stats["error"]))
                continue
            first = iso(stats["runs"][0][0]) if stats["runs"] else None
            (row["firing"] if should_fire else row["quiet"])[name] = first or "never"
            if should_fire and not first:
                problems.append("incident %s: %s should have fired between %s and %s and did not"
                                % (ident, name, iso(start), iso(window_end)))
            if not should_fire and first:
                problems.append("incident %s: %s should have stayed quiet and fired at %s"
                                % (ident, name, first))
        print("  incident %-44s %s" % (ident, "ok" if len(problems) == before else "FAILED"))
        results.append(row)
    return results, problems


if __name__ == "__main__":
    sys.exit(main())
