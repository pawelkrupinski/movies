#!/usr/bin/env bash
# Copy vault values (operator's Touch ID `secrets`, namespace `movies`) into GitHub Actions secrets,
# per infra/k8s-secrets/github-secrets.map. Values go vault -> stdin -> `gh secret set`, never argv.
#
#   infra/bin/push-gh-secrets NIX_STAGE_SSH_KEY NIX_STAGE_SIGNING_KEY   # just these (normal use)
#   infra/bin/push-gh-secrets --all                                     # every mapped key in the vault
#   infra/bin/push-gh-secrets --dry-run NAME...                         # say what would be pushed
#   FORGEJO_TOKEN=... infra/bin/push-gh-secrets --forgejo --all         # the same map, into Forgejo
#
# --forgejo targets the self-hosted Forgejo that runs CI since the GitHub suspension (2026-10), at
# $FORGEJO_URL (default http://localhost:3000, the ssh tunnel), with $FORGEJO_TOKEN. Same map, same
# vault, same stdin-only path; the value is trimmed of trailing newlines exactly as `gh secret set`
# trims it, so a secret reads the same on both platforms.
#
# Name the secrets you rotated: GitHub cannot show a stored value, so there is no way to tell
# "already current" and every push overwrites.
set -euo pipefail
map="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../k8s-secrets/github-secrets.map"
dry=0; all=0; forgejo=0; names=()
for a in "$@"; do case "$a" in --dry-run) dry=1;; --all) all=1;; --forgejo) forgejo=1;; -*) echo "unknown option $a" >&2; exit 2;; *) names+=("$a");; esac; done
forgejo_url="${FORGEJO_URL:-http://localhost:3000}"
(( ! forgejo || dry )) || [[ -n "${FORGEJO_TOKEN:-}" ]] || { echo "--forgejo needs FORGEJO_TOKEN" >&2; exit 2; }
# Values arrive on stdin and leave in a request body read from stdin: never in argv, never on disk.
push_forgejo() {
  jq -Rs '{data: sub("[\r\n]+$"; "")}' |
    curl -fsS -o /dev/null -X PUT -H "Authorization: token $FORGEJO_TOKEN" -H 'Content-Type: application/json' \
      --data-binary @- "$forgejo_url/api/v1/repos/$1/actions/secrets/$2"
}
(( all || ${#names[@]} )) || { sed -n '2,10p' "$0" >&2; exit 2; }
secrets unlock movies >/dev/null   # unlock from here: the vault honours it only for this process's children
vault_keys=" $(secrets list movies | awk '{print $1}' | tr '\n' ' ') "
for n in "${names[@]}"; do grep -qE "^\S+\s+$n\s" "$map" || { echo "$n is not in $map" >&2; exit 2; }; done
while read -r repo name vkey; do
  (( all )) || [[ " ${names[*]} " == *" $name "* ]] || continue
  [[ "$vault_keys" == *" $vkey "* ]] || { echo "  $repo $name: vault key $vkey not set yet -- skipped"; continue; }
  if (( dry )); then echo "  $repo $name: WOULD push from $vkey"; continue; fi
  if (( forgejo )); then
    secrets get movies "$vkey" | push_forgejo "$repo" "$name"
  else
    secrets get movies "$vkey" | gh secret set "$name" -R "$repo" >/dev/null
  fi
  echo "  $repo $name: pushed from $vkey"
done < <(grep -vE '^\s*(#|$)' "$map")
