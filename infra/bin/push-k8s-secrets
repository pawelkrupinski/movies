#!/usr/bin/env bash
# Push the current vault values into the kinowo cluster's Secrets, per infra/k8s-secrets/secrets.map.
# The vault (operator's Touch ID `secrets`: namespace `movies`, or the `<namespace>:` a map row
# names) is the source of truth; the Secrets are copies. Values travel vault -> stdin -> ssh -> `kubectl patch --patch-file /dev/stdin` on the
# k3s server, never through argv or a file. Reloader restarts the pods that use a changed Secret.
#
#   infra/bin/push-k8s-secrets                     # every Secret in the map
#   infra/bin/push-k8s-secrets kinowo/web-secrets  # just one
#   infra/bin/push-k8s-secrets --dry-run           # say what would change, change nothing
#
# A map row whose vault key does not exist yet is skipped, and so is a key whose value already
# matches (compared by sha256 on the server), so re-running is harmless.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
map="${K8S_SECRETS_MAP:-$here/../k8s-secrets/secrets.map}"
server="${K8S_SERVER_HOST:-monitoring-1}"
dry=0; only=""
for a in "$@"; do case "$a" in --dry-run) dry=1;; */*) only="$a";; *) echo "usage: $0 [--dry-run] [namespace/secret]" >&2; exit 2;; esac; done

# A map row's vault key is `KEY` (namespace `movies`) or `<namespace>:KEY`.
vault_namespace() { [[ "$1" == *:* ]] && echo "${1%%:*}" || echo movies; }
# The vault only honours an unlock for callers whose parent is the unlocking shell; unlock from here.
# "<namespace>:KEY" for every key each namespace the map names holds.
vault_keys=" "
for vns in $(grep -vE '^\s*(#|$)' "$map" | awk '{print $3}' | while read -r v; do vault_namespace "$v"; done | sort -u); do
  secrets unlock "$vns" >/dev/null
  vault_keys+="$(secrets list "$vns" | awk -v ns="$vns" '{print ns ":" $1}' | tr '\n' ' ')"
done
secrets_in_map=$(grep -vE '^\s*(#|$)' "$map" | awk '{print $1}' | sort -u)
for target in $secrets_in_map; do
  [[ -z "$only" || "$only" == "$target" ]] || continue
  ns=${target%/*}; name=${target#*/}
  # key -> sha256 of its current value, computed ON THE SERVER so no value crosses back here
  current=$(ssh -o BatchMode=yes "$server" "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl -n $ns get secret $name -o json | jq -r '.data | to_entries[] | \"\\(.key) \\(.value)\"' | while read -r k v; do printf '%s %s\\n' \"\$k\" \"\$(printf %s \"\$v\" | base64 -d | sha256sum | cut -c1-64)\"; done")
  patch='{}'; changed=()
  while read -r t key vkey; do
    [[ "$t" == "$target" ]] || continue
    vns=$(vault_namespace "$vkey"); vname=${vkey#*:}
    [[ "$vault_keys" == *" $vns:$vname "* ]] || { echo "  $target $key: vault key $vns:$vname not set yet -- skipped"; continue; }
    value=$(secrets get "$vns" "$vname")
    have=$(awk -v k="$key" '$1==k{print $2}' <<<"$current")
    want=$(printf %s "$value" | shasum -a 256 | cut -c1-64)
    if [[ "$have" == "$want" ]]; then echo "  $target $key: up to date"; continue; fi
    patch=$(jq -c --arg k "$key" --arg v "$value" '.data[$k] = ($v | @base64)' <<<"$patch"); changed+=("$key")
  done < <(grep -vE '^\s*(#|$)' "$map")
  unset value
  if (( ${#changed[@]} == 0 )); then echo "$target: nothing to change"; continue; fi
  if (( dry )); then echo "$target: WOULD update ${changed[*]}"; continue; fi
  printf '%s' "$patch" | ssh -o BatchMode=yes "$server" "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; kubectl -n $ns patch secret $name --type merge --patch-file /dev/stdin" >/dev/null
  echo "$target: updated ${changed[*]} (Reloader restarts its pods)"
done
