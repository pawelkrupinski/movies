#!/usr/bin/env bash
# Let ci-runner's Security headers check (.github/workflows/security-headers.yml) past Cloudflare's Bot
# Fight Mode on kinowo.net and showtimes.cc WITHOUT the Decodo proxy, and only when it carries a secret.
#
#   infra/bin/cloudflare-ci-edge-allow             # apply (idempotent), then verify from ci-runner
#   infra/bin/cloudflare-ci-edge-allow --dry-run   # say what it would change, change nothing
#
# WHY THIS SHAPE. Bot Fight Mode (Free plan, `fight_mode: true` on both zones) runs outside the ruleset
# engine: a WAF custom rule's Skip / Allow has no effect on it (developers.cloudflare.com/bots/get-started/
# bot-fight-mode, "Limitations"). Its one exception is an IP Access Rule that matches first -- the same
# hand step that lets monitoring-1 probe the sites (infra/nix/modules/roles/synthetic-probes.nix). An
# address alone would let ANY job on ci-runner through, so a custom rule, which still runs for an allowed
# address (monitoring-1's showtimes.cc /movie/ exemption shows it), BLOCKS ci-runner on the sites' own
# hosts unless the request carries `X-Kinowo-Edge-Check: <EDGE_CHECK_KEY>`. The block rule goes in
# BEFORE the allow, so there is never a moment the address is let through without the key.
#
# Steps, each skipped when already done:
#   1. EDGE_CHECK_KEY: a fresh random value into the `movies` vault (never argv, never printed);
#   2. it into the Forgejo Actions secret EDGE_CHECK_KEY (infra/bin/push-gh-secrets --forgejo);
#   3. per zone: the custom rule `ci-runner-edge-key` (first in the zone's custom rules), then the IP Access
#      Rule allowing 162.55.0.154;
#   4. verify on ci-runner: without the key 403 (blocked, NOT `cf-mitigated: challenge`), with it 401.
# Rotating the key: `secrets delete movies EDGE_CHECK_KEY` and run this again (it rewrites the rule).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dry=0; [[ "${1:-}" == --dry-run ]] && dry=1
CI_RUNNER_IP=162.55.0.154
export CI_RUNNER_IP DRY_RUN=$dry

secrets unlock movies >/dev/null
if ! secrets list movies | awk '{print $1}' | grep -qx EDGE_CHECK_KEY; then
  if (( dry )); then echo "WOULD create vault key movies/EDGE_CHECK_KEY"
  else
    openssl rand -hex 32 | secrets set movies EDGE_CHECK_KEY
    echo "X-Kinowo-Edge-Check value: lets ci-runner's Security headers check past Cloudflare (infra/bin/cloudflare-ci-edge-allow)" |
      secrets describe movies EDGE_CHECK_KEY
    echo "vault: movies/EDGE_CHECK_KEY created"
  fi
fi

if (( dry )); then "$here/push-gh-secrets" --dry-run EDGE_CHECK_KEY
else FORGEJO_TOKEN="$(secrets get movies FORGEJO_API_TOKEN)" "$here/push-gh-secrets" --forgejo EDGE_CHECK_KEY
fi

keys=(CLOUDFLARE_API_TOKEN EDGE_CHECK_KEY)
if ! secrets list movies | awk '{print $1}' | grep -qx EDGE_CHECK_KEY; then  # --dry-run before the first apply
  keys=(CLOUDFLARE_API_TOKEN); export EDGE_CHECK_KEY=dry-run-placeholder
fi
secrets run movies "${keys[@]}" -- python3 -I - <<'PY'
import json, os, sys, urllib.request

TOKEN, KEY, IP, DRY = os.environ["CLOUDFLARE_API_TOKEN"], os.environ["EDGE_CHECK_KEY"], os.environ["CI_RUNNER_IP"], os.environ["DRY_RUN"] == "1"
REF = "ci-runner-edge-key"
HOSTS = {"kinowo.net": ["kinowo.net", "www.kinowo.net"], "showtimes.cc": ["showtimes.cc", "www.showtimes.cc"]}


def api(method, path, body=None):
    request = urllib.request.Request("https://api.cloudflare.com/client/v4" + path, method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"Authorization": "Bearer " + TOKEN, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        payload = json.load(error)
        if method == "GET" and error.code == 404:
            return payload
        sys.exit("Cloudflare %s %s: HTTP %s %s" % (method, path, error.code, payload.get("errors")))


def change(what, method, path, body):
    print(("WOULD " if DRY else "") + what)
    if not DRY:
        api(method, path, body)


for zone_name, hosts in HOSTS.items():
    zone = api("GET", "/zones?name=" + zone_name)["result"][0]
    print("%s: plan %s" % (zone_name, zone["plan"]["name"]))
    expression = '(ip.src eq %s and http.host in {%s} and not any(http.request.headers["x-kinowo-edge-check"][*] eq "%s"))' % (
        IP, " ".join('"%s"' % h for h in hosts), KEY)
    rule = {"ref": REF, "action": "block", "enabled": True, "expression": expression,
            "description": "ci-runner without the edge key (its IP Access allow is for the Security headers check only)"}
    entry = api("GET", "/zones/%s/rulesets/phases/http_request_firewall_custom/entrypoint" % zone["id"]).get("result")
    if not entry:
        change("%s: create the custom-rules entrypoint with %s" % (zone_name, REF), "PUT",
               "/zones/%s/rulesets/phases/http_request_firewall_custom/entrypoint" % zone["id"], {"rules": [rule]})
    else:
        existing = [r for r in entry.get("rules", []) if r.get("ref") == REF]
        if not existing:
            change("%s: add custom rule %s first" % (zone_name, REF), "POST",
                   "/zones/%s/rulesets/%s/rules" % (zone["id"], entry["id"]), dict(rule, position={"index": 1}))
        elif existing[0]["expression"] != expression or existing[0]["action"] != "block" or not existing[0].get("enabled"):
            change("%s: update custom rule %s" % (zone_name, REF), "PATCH",
                   "/zones/%s/rulesets/%s/rules/%s" % (zone["id"], entry["id"], existing[0]["id"]), rule)
        else:
            print("%s: custom rule %s current" % (zone_name, REF))
    rules = api("GET", "/zones/%s/firewall/access_rules/rules?configuration.value=%s" % (zone["id"], IP))["result"]
    if any(r["mode"] == "whitelist" for r in rules):
        print("%s: IP Access allow %s present" % (zone_name, IP))
    else:
        change("%s: IP Access allow %s" % (zone_name, IP), "POST", "/zones/%s/firewall/access_rules/rules" % zone["id"],
               {"mode": "whitelist", "configuration": {"target": "ip", "value": IP},
                "notes": "ci-runner: Security headers check; gated by custom rule %s (infra/bin/cloudflare-ci-edge-allow)" % REF})
PY

(( dry )) && exit 0
echo "verify from ci-runner (expect 403 without the key, not a challenge; 401 with it):"
secrets get movies EDGE_CHECK_KEY | ssh ci-runner 'read -r k; for h in kinowo.net showtimes.cc; do
  printf "  %s  no key: " $h; curl -s -o /dev/null -D - -m 20 https://$h/api/me | grep -iE "^(HTTP|cf-mitigated)" | tr -d "\r" | tr "\n" " "; echo
  printf "  %s  key:    " $h; curl -s -o /dev/null -w "%{http_code}\n" -m 20 -K <(printf "header = \"X-Kinowo-Edge-Check: %s\"\n" "$k") https://$h/api/me
done'
