#!/usr/bin/env bash
# Put the GitOps manifests where the deploy specs expect them.
#
# They used to be `infra/kubernetes/` in this repository. They are now
# pawelkrupinski/movies-gitops, because Flux pulls its source on every reconcile
# — and, since image-automation began committing the deployed tag, on the write
# path of every deploy. A shallow clone of THIS repository is 93.5s and a 1.3 GB
# working tree of 18,806 files, to reach 420 KB of manifests in 36 of them.
#
# The checkout lands at the OLD PATH on purpose. Nine specs in
# worker/src/test/scala/deploy/ compare those manifests against this repository's
# CI workflow and nix config, and keeping the path identical means the split cost
# them no changes at all. The directory is gitignored here.
#
# It tracks the config repo's `main` rather than a pinned commit, deliberately:
# the specs should test what is actually deployed. A submodule pointer would go
# stale silently, which is the failure this repository has spent a lot of effort
# eliminating everywhere else.
set -euo pipefail

# WHERE FROM. GitHub, anonymously -- the config repo is public ($GITHUB_SERVER_URL on CI). $KINOWO_GITOPS_REPO, set, is
# the only source.
#
# A FETCH THAT FAILS IS A FAILURE. It used to fall back to the local clone $KINOWO_GITOPS_LOCAL quietly, and that clone,
# pulled from GitHub, stopped moving the day GitHub went: the deploy specs then passed or failed against weeks-old
# manifests (WorkerRolloutStaggerSpec, 2026-10-21). Now every source unreachable exits 1, the checkout left as it was
# and called STALE; KINOWO_GITOPS_OFFLINE=1 opts into the local clone (default ~/projects/movies-gitops), said so.
slug=pawelkrupinski/movies-gitops
if [ -n "${KINOWO_GITOPS_REPO:-}" ]; then
    sources=("$KINOWO_GITOPS_REPO")
elif [ -n "${GITHUB_SERVER_URL:-}" ]; then
    sources=("${GITHUB_SERVER_URL%/}/$slug.git")
else
    sources=("https://github.com/$slug.git")
fi
local_repo="${KINOWO_GITOPS_LOCAL:-$HOME/projects/movies-gitops}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
dest="${KINOWO_GITOPS_DEST:-$root/infra/kubernetes}"

# no prompt, no hang on a stalled connection
export GIT_TERMINAL_PROMPT=0
git_() { # <source> <git args...>
    shift
    git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=20 "$@"
}

fetch() { # <repo>
    if [ -d "$dest/.git" ]; then
        echo "updating $dest from $1"
        git -C "$dest" remote set-url origin "$1"
        git_ "$1" -C "$dest" fetch --quiet origin main && git -C "$dest" reset --quiet --hard origin/main
    else
        echo "cloning $1 -> $dest"
        rm -rf "$dest"
        git_ "$1" clone --quiet --depth 1 --single-branch --branch main "${1/#\//file:///}" "$dest"
    fi
}

for src in "${sources[@]}"; do
    if fetch "$src"; then
        echo "now at $(git -C "$dest" rev-parse --short HEAD) ($(git -C "$dest" log -1 --format=%s))"
        exit 0
    fi
    echo "fetch-gitops: $src unreachable" >&2
done

if [ "${KINOWO_GITOPS_OFFLINE:-}" = 1 ]; then
    [ -d "$local_repo/.git" ] || { echo "fetch-gitops: every source unreachable, and no local clone at $local_repo" >&2; exit 1; }
    echo "fetch-gitops: KINOWO_GITOPS_OFFLINE=1 -- using the local clone $local_repo ($(git -C "$local_repo" log -1 --format='%h %cr: %s')); it may be behind main" >&2
    fetch "$local_repo"
    echo "now at $(git -C "$dest" rev-parse --short HEAD) ($(git -C "$dest" log -1 --format=%s))"
    exit 0
fi
{
    echo "fetch-gitops: could not fetch movies-gitops main from: ${sources[*]}"
    if [ -d "$dest/.git" ]; then
        echo "  $dest is STALE -- left at $(git -C "$dest" log -1 --format='%h, committed %cr') -- and the deploy specs must not run against it."
    else
        echo "  no manifests at $dest (STALE: never fetched)."
    fi
    echo "  Fix: the network to github.com, then rerun infra/bin/fetch-gitops. Knowingly offline: KINOWO_GITOPS_OFFLINE=1 uses $local_repo."
} >&2
exit 1
