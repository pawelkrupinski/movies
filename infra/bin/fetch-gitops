#!/usr/bin/env bash
# Put the GitOps manifests where the deploy specs expect them.
#
# They used to be `infra/kubernetes/` in this repository. They are now
# pawelkrupinski/movies-gitops, because Flux pulls its source on every reconcile
# — and, since image-automation began committing the deployed tag, on the write
# path of every deploy. A shallow clone of THIS repository is 93.5s and a 1.3 GB
# working tree of 18,806 files, to reach 420 KB of manifests in 36 of them.
#
# The checkout lands at the OLD PATH on purpose. Nine specs in
# worker/src/test/scala/deploy/ compare those manifests against this repository's
# CI workflow and nix config, and keeping the path identical means the split cost
# them no changes at all. The directory is gitignored here.
#
# It tracks the config repo's `main` rather than a pinned commit, deliberately:
# the specs should test what is actually deployed. A submodule pointer would go
# stale silently, which is the failure this repository has spent a lot of effort
# eliminating everywhere else.
set -euo pipefail

#
# When GitHub cannot be reached (the account was suspended 2026-10-18), it falls back to a local clone of the config
# repo, $KINOWO_GITOPS_LOCAL (default ~/projects/movies-gitops), and says so.
repo="${KINOWO_GITOPS_REPO:-https://github.com/pawelkrupinski/movies-gitops.git}"
local_repo="${KINOWO_GITOPS_LOCAL:-$HOME/projects/movies-gitops}"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
dest="${KINOWO_GITOPS_DEST:-$root/infra/kubernetes}"

fetch() { # <repo>
    if [ -d "$dest/.git" ]; then
        echo "updating $dest from $1"
        git -C "$dest" remote set-url origin "$1"
        git -C "$dest" fetch --quiet origin main && git -C "$dest" reset --quiet --hard origin/main
    else
        echo "cloning $1 -> $dest"
        rm -rf "$dest"
        git clone --quiet --depth 1 --single-branch --branch main "${1/#\//file:///}" "$dest"
    fi
}

if ! fetch "$repo"; then
    [ -d "$local_repo/.git" ] || { echo "fetch-gitops: $repo unreachable, and no local clone at $local_repo" >&2; exit 1; }
    echo "fetch-gitops: $repo unreachable -- using the local clone $local_repo ($(git -C "$local_repo" log -1 --format='%h %s'))" >&2
    fetch "$local_repo"
fi
echo "now at $(git -C "$dest" rev-parse --short HEAD) ($(git -C "$dest" log -1 --format=%s))"
