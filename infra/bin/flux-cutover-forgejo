#!/usr/bin/env bash
# Cut the kinowo cluster's Flux over from github.com (suspended) to the self-hosted Forgejo.
#
# movies-gitops 1e2db3b already points the GitRepositories `movies` (flux/gotk-sync.yaml) and
# `movies-write` (image-automation/automation.yaml) at
# ssh://forgejo@162.55.0.154:2222/pawelkrupinski/movies-gitops.git with secretRef flux-git-read /
# flux-git-write. Flux cannot pull that change itself: its current source is the dead GitHub repo.
# This script supplies the keys and applies the change out of band, the same way gotk-sync.yaml and
# the deploy key were always applied (docs/credential-rotation.md section 2; the Secrets are never in
# git):
#
#   1. generates a read and a write ed25519 deploy key in a temp dir (removed on exit);
#   2. registers them on movies-gitops via the Forgejo API (read_only true / false), replacing any
#      key with the same title;
#   3. builds known_hosts with ssh-keyscan run on k3s-worker-1 (Forgejo's :2222 admits only the
#      cluster nodes, so the laptop cannot scan it);
#   4. creates/updates Secrets flux-system/flux-git-read and flux-git-write (identity,
#      identity.pub, known_hosts) by `kubectl apply -f -` on the k3s server, values over stdin;
#   5. applies flux/gotk-sync.yaml from Forgejo main if the `movies` source does not already point
#      at Forgejo, and points `movies-write` there too;
#   6. requests a reconcile (annotation; there is no flux CLI on the server) and prints the state.
#
# Re-running is harmless: every run mints fresh keys and replaces both the deploy keys and the
# Secrets, and the manifests are applied idempotently.
#
# Needs: the ssh tunnel that makes http://forgejo.internal:3000 reachable, the Touch ID vault
# (`secrets`, key movies/FORGEJO_API_TOKEN, a Forgejo admin token), ssh to monitoring-1 and
# k3s-worker-1, and jq, curl, ssh-keygen locally.
#
#   infra/bin/flux-cutover-forgejo
set -euo pipefail

server="${K8S_SERVER_HOST:-monitoring-1}"     # k3s server; kubectl runs there
scanner="${KEYSCAN_HOST:-k3s-worker-1}"        # a node on Forgejo's :2222 allowlist
api="${FORGEJO_API:-http://forgejo.internal:3000/api/v1}"
owner=pawelkrupinski
repo=movies-gitops
git_host=162.55.0.154
git_port=2222
git_url="ssh://forgejo@${git_host}:${git_port}/${owner}/${repo}.git"
read_title="flux-git-read (kinowo k3s)"
write_title="flux-git-write (kinowo k3s)"

for tool in jq curl ssh ssh-keygen secrets; do
  command -v "$tool" >/dev/null || { echo "missing: $tool" >&2; exit 1; }
done

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

kube() { ssh -o BatchMode=yes "$server" "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml; $1"; }

# The token never reaches argv or the terminal: curl reads its header from stdin (-K -).
secrets unlock movies >/dev/null
token=$(secrets get movies FORGEJO_API_TOKEN)
forgejo() {
  printf 'header = "Authorization: token %s"\n' "$token" |
    curl -fsS -K - -H 'Content-Type: application/json' "$@"
}

echo "== preflight"
forgejo "$api/repos/$owner/$repo" | jq -r '"  repo \(.full_name) (private: \(.private)), default branch \(.default_branch)"'
gotk_sync=$(forgejo "$api/repos/$owner/$repo/raw/flux/gotk-sync.yaml?ref=main")
grep -qF "url: $git_url" <<<"$gotk_sync" || {
  echo "Forgejo main's flux/gotk-sync.yaml does not point at $git_url -- is 1e2db3b on main?" >&2; exit 1; }
grep -qF "name: flux-git-read" <<<"$gotk_sync" || {
  echo "Forgejo main's flux/gotk-sync.yaml has no secretRef flux-git-read" >&2; exit 1; }

echo "== 3. known_hosts (ssh-keyscan on $scanner)"
known_hosts=$(ssh -o BatchMode=yes "$scanner" "ssh-keyscan -p $git_port $git_host 2>/dev/null" | grep -v '^#' || true)
grep -q "^\[$git_host\]:$git_port " <<<"$known_hosts" || {
  echo "ssh-keyscan from $scanner returned no host keys for $git_host:$git_port" >&2; exit 1; }
awk '{print "  " $1, $2}' <<<"$known_hosts"
printf '%s\n' "$known_hosts" >"$work/known_hosts"

echo "== 1. generate deploy keys"
for kind in read write; do
  ssh-keygen -q -t ed25519 -N '' -C "flux-git-$kind@kinowo-k3s" -f "$work/$kind" </dev/null
  echo "  $kind: $(ssh-keygen -lf "$work/$kind.pub" | awk '{print $2}')"
done

echo "== 2. register deploy keys on $owner/$repo"
existing=$(forgejo "$api/repos/$owner/$repo/keys?limit=50")
register() { # <title> <pubkey file> <read_only>
  local title=$1 pub=$2 ro=$3 id
  for id in $(jq -r --arg t "$title" '.[] | select(.title == $t) | .id' <<<"$existing"); do
    forgejo -X DELETE "$api/repos/$owner/$repo/keys/$id" >/dev/null
    echo "  removed old '$title' (id $id)"
  done
  jq -n --arg t "$title" --arg k "$(cat "$pub")" --argjson ro "$ro" '{title: $t, key: $k, read_only: $ro}' |
    forgejo -X POST --data-binary @- "$api/repos/$owner/$repo/keys" |
    jq -r '"  added \(.title) (id \(.id), read_only \(.read_only))"'
}
register "$read_title" "$work/read.pub" true
register "$write_title" "$work/write.pub" false

echo "== 4. Secrets flux-system/flux-git-read and flux-git-write"
for kind in read write; do
  jq -n --arg name "flux-git-$kind" \
    --rawfile id "$work/$kind" --rawfile pub "$work/$kind.pub" --rawfile kh "$work/known_hosts" \
    '{apiVersion: "v1", kind: "Secret", type: "Opaque",
      metadata: {name: $name, namespace: "flux-system"},
      data: {identity: ($id | @base64), "identity.pub": ($pub | @base64), known_hosts: ($kh | @base64)}}' |
    kube "kubectl apply -f -" | sed 's/^/  /'
done

echo "== 5. GitRepositories"
current=$(kube "kubectl -n flux-system get gitrepository movies -o jsonpath='{.spec.url} {.spec.secretRef.name}'")
if [[ "$current" == "$git_url flux-git-read" ]]; then
  echo "  movies already on Forgejo"
else
  echo "  movies is '$current' -- applying flux/gotk-sync.yaml from Forgejo main"
  printf '%s\n' "$gotk_sync" | kube "kubectl apply -f -" | sed 's/^/  /'
fi
# movies-write is applied by the image-automation Kustomization, which will set the same value once
# `movies` fetches from Forgejo; patching it now just saves a reconcile round.
jq -cn --arg u "$git_url" '{spec: {url: $u, secretRef: {name: "flux-git-write"}}}' |
  kube "kubectl -n flux-system patch gitrepository movies-write --type merge --patch-file /dev/stdin" | sed 's/^/  /'

echo "== 6. reconcile"
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
kube "kubectl -n flux-system annotate --overwrite gitrepository/movies gitrepository/movies-write reconcile.fluxcd.io/requestedAt=$now" | sed 's/^/  /'
kube "kubectl -n flux-system wait gitrepository/movies gitrepository/movies-write --for=condition=Ready --timeout=120s" | sed 's/^/  /' ||
  echo "  sources not Ready within 120s -- see the status below"
kube "kubectl -n flux-system annotate --overwrite kustomization --all reconcile.fluxcd.io/requestedAt=$now" >/dev/null
kube "kubectl -n flux-system annotate --overwrite imageupdateautomation/movies reconcile.fluxcd.io/requestedAt=$now" >/dev/null

echo
kube "kubectl -n flux-system get gitrepositories,kustomizations"
echo
kube "kubectl -n flux-system get imagerepositories,imagepolicies,imageupdateautomations"
echo
echo "Kustomizations reconcile in the background; image-automation may need a few minutes to go Ready."
echo "Re-check: ssh $server 'KUBECONFIG=/etc/rancher/k3s/k3s.yaml kubectl -n flux-system get gitrepositories,kustomizations,imageupdateautomations'"
