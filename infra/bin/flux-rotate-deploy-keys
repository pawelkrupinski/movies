#!/bin/sh
# Purpose: rotate the kinowo cluster Flux's GitHub deploy keys (read and write) for movies-gitops, keys first, old keys last.
# The name its callers run: infra/bin/flux_rotate_deploy_keys.py is the tool (its header says what it does, and why).
exec python3 "$(dirname "$0")/flux_rotate_deploy_keys.py" "$@"
