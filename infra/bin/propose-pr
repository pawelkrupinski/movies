#!/usr/bin/env bash
# Turn a bot's patch into ONE pull request on a fixed branch, opened or updated in place.
#
#   PROPOSE_TOKEN=... infra/bin/propose-pr [-C <checkout>] [--repo <owner/name>] --branch <branch> <out dir>
#
# <out dir> holds changes.patch, title and body.md; <checkout> (default: here) is a clean checkout of
# <repo>'s main (default $GITHUB_REPOSITORY). Needs git, curl and jq. Two callers, both in
# .github/workflows/nix-update.yml: infra/bin/nix-update's output as branch nix-update/all here, and
# infra/bin/image_pins.py --gitops-out's as branch image-pins/all in pawelkrupinski/movies-gitops.
#
# AS ci-bot, NOT AS THE JOB: Forgejo fires no `pull_request` workflows for a PR the job token opens,
# so the checks a reviewer needs would never run. The token is SCALA_STEWARD_TOKEN, the one
# scala-steward.yml opens its PRs with (ci-bot, minted by bitcashier/infra's bin/forgejo-bootstrap;
# write through team pawelkrupinski/steward, which must hold every repository it proposes to).
#
# THE BRANCH IS REBUILT FROM main EVERY WEEK AND FORCE-PUSHED, so an open PR always shows this
# week's change against today's main -- UNLESS someone else has pushed to it (to drop an upgrade,
# fix a host). Then it is left alone and the run says so: a weekly job silently discarding a
# person's commits is the one thing this must never do.
set -euo pipefail

usage="usage: propose-pr [-C <checkout>] [--repo <owner/name>] --branch <branch> <out dir>"
repo="${GITHUB_REPOSITORY:-}"
branch=""
checkout=.
while [ $# -gt 1 ]; do
  case "$1" in
    -C) checkout="$2"; shift 2 ;;
    --repo) repo="$2"; shift 2 ;;
    --branch) branch="$2"; shift 2 ;;
    *) echo "${usage}" >&2; exit 2 ;;
  esac
done
out="$(cd "${1:?${usage}}" && pwd)"
cd "${checkout}"
: "${branch:?${usage}}" "${repo:?${usage} (or \$GITHUB_REPOSITORY)}"
: "${PROPOSE_TOKEN:?PROPOSE_TOKEN is not set (secrets.SCALA_STEWARD_TOKEN, the ci-bot token)}"
server="${GITHUB_SERVER_URL:?}"
bot_email="ci-bot@forgejo.internal"
summary="${GITHUB_STEP_SUMMARY:-/dev/null}"

if [ ! -s "${out}/changes.patch" ]; then
  echo "nothing to propose"
  exit 0
fi

# THE TOKEN NEVER GOES ON ARGV: curl reads the header from a config on a pipe, git from its
# GIT_CONFIG_* environment.
auth_curl() { curl -K <(printf 'header = "Authorization: token %s"\n' "${PROPOSE_TOKEN}") "$@"; }
auth_git() {
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0="Authorization: token ${PROPOSE_TOKEN}" \
    git "$@"
}
remote="${server}/${repo}.git"
api="${server}/api/v1/repos/${repo}"

# ls-remote first, so "no such branch" (the first week, or after a merge) is told apart from a
# failed read, which must stop the run rather than read as "nothing to protect". An assignment, not
# `[ -n "$(...)" ]`: set -e ignores a substitution's failure inside a test's argument.
existing="$(auth_git ls-remote --heads "${remote}" "refs/heads/${branch}")"
if [ -n "${existing}" ]; then
  # A shallow checkout (infra/bin/fetch-gitops clones at depth 1) would read main's own older
  # commits as the branch's: deepen it first.
  if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
    auth_git fetch -q --unshallow "${remote}" main
  fi
  auth_git fetch -q "${remote}" "+refs/heads/${branch}:refs/remotes/propose-pr/existing"
  others="$(git log --format='%ae %h %s' HEAD..propose-pr/existing | grep -v "^${bot_email} " || true)"
  if [ -n "${others}" ]; then
    {
      echo "**${branch} has commits by someone other than ci-bot, so this week's run left it alone:**"
      echo '```'
      echo "${others}"
      echo '```'
      echo "Merge or close its PR (or delete the branch) and the next run proposes afresh."
    } | tee -a "${summary}"
    exit 0
  fi
fi

# The bot upgraded THIS checkout in place, and the patch is its record: start from a clean main,
# so the branch is exactly the patch. Never anywhere but a CI job, where the checkout is the job's own.
if ! git diff --quiet HEAD; then
  if [ "${GITHUB_ACTIONS:-}" != "true" ]; then
    echo "the checkout has uncommitted changes; outside CI this will not discard them" >&2
    exit 1
  fi
  git reset -q --hard HEAD
fi
git checkout -q -B "${branch}"
git apply --index "${out}/changes.patch"
git -c user.name=ci-bot -c user.email="${bot_email}" commit -q -F - <<EOF
$(cat "${out}/title")

Weekly .github/workflows/nix-update.yml in ${GITHUB_REPOSITORY:-?}, run ${GITHUB_RUN_ID:-?}.
EOF
auth_git push -q --force "${remote}" "HEAD:refs/heads/${branch}"
echo "pushed ${branch} ($(git rev-parse --short HEAD))"

title="$(head -n1 "${out}/title")"
body_json="$(jq -n --arg title "${title}" --rawfile body "${out}/body.md" '{title: $title, body: $body}')"
number="$(auth_curl -fsS "${api}/pulls?state=open&limit=50" |
  jq -r --arg b "${branch}" 'map(select(.head.ref == $b)) | first | .number // empty')"
if [ -n "${number}" ]; then
  auth_curl -fsS -o /dev/null -X PATCH -H 'Content-Type: application/json' \
    --data-binary @- "${api}/pulls/${number}" <<<"${body_json}"
  echo "updated PR #${number}: ${title}" | tee -a "${summary}"
else
  number="$(jq --arg h "${branch}" '. + {head: $h, base: "main"}' <<<"${body_json}" |
    auth_curl -fsS -X POST -H 'Content-Type: application/json' --data-binary @- "${api}/pulls" | jq -r .number)"
  echo "opened PR #${number}: ${title}" | tee -a "${summary}"
fi
echo "${server}/${repo}/pulls/${number}" | tee -a "${summary}"
