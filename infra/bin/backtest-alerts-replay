#!/usr/bin/env python3
"""Replay a red Alert backtest at two revisions, here or on ci-runner, and say whether a fix turned it green.

  infra/bin/backtest-alerts-replay --local --from-run <github run id> [--base REV] [--head REV]
                                   [--alert A]... [--group G]... [--days N] [--offline]
  infra/bin/backtest-alerts-replay --from-run <github run id> [--host ci-runner] ...

--local (the fix-replay registry's command, .github/red-workflows.tsv) runs both revisions on this machine:
infra/bin/backtest-alerts-local syncs, once, the blocks either revision's selected alerts need from ci-runner's copy
into ~/.cache/movies-backtest-snapshot, picks production's Prometheus version, and each revision's own
infra/bin/backtest-alerts (from `git archive <rev> infra scripts` in a scratch directory) replays them under a
governor ticket. A few minutes once the cache is warm; no ci-runner queue and no ssh shell. Without --local, the
replay runs on --host as described below.

WHY. The nightly Alert backtest takes ~29 min over all 224 alerts; seven fixes were landed on a guess and refuted
by its next run. A fixer proves a fix BEFORE landing instead: the same backtest over the same nightly Prometheus
copy, scoped to the alerts the red run named (--from-run fetches that run's log; infra/bin/backtest-alerts
--from-log selects them), run at the base (default origin/main) and at the head (default HEAD). Verdict:
base=FAIL head=PASS (exit 0) is a fix that fixes; anything else (exit 1) is not one; a harness error is exit 2.

HOW (on --host). Per revision: `git archive <rev> infra scripts` (the 1.3 GB whole tree took minutes over ssh, 14 MB takes seconds) is unpacked over ssh into /tmp/backtest-replay-<user>-<pid>-<rev8> on the
host and removed after; there infra/bin/backtest-alerts --source snapshot --no-write replays against
/mnt/data/prometheus-snapshot/current (the tool copies the blocks privately). The host has neither the Prometheus
binary nor PyYAML: the binary of the copy's version is downloaded once into ~/.cache/backtest-prometheus/<version>/,
checksum-verified as .github/workflows/alert-backtest.yml does, and PyYAML comes from scripts/python-venv. Production
is never touched. A revision whose tool predates --from-log gets the log's alerts as --alert names instead.

The last line is `Fix-Replay: <this command without --base/--head> base=<FAIL|PASS> head=<FAIL|PASS>`, for the
commit trailer agentctl checks. BACKTEST_REPLAY_PROMETHEUS_BINARY names a binary already on the host (the self-test).
"""

import argparse
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

SNAPSHOT = "/mnt/data/prometheus-snapshot/current"
TIMESTAMP = re.compile(r"^.*?\d{4}-\d\d-\d\dT[\d:.]+Z ?")
NAMED = re.compile(r"^\s*- (?:incident \S+: )?([A-Za-z_]\w*)(?: \(| should | query failed)")

REMOTE = r"""
set -uo pipefail
cd "$1"; shift
snapshot="$1"; shift
if [ -n "${BACKTEST_REPLAY_PROMETHEUS_BINARY:-}" ]; then
    binary="$BACKTEST_REPLAY_PROMETHEUS_BINARY"
else
    version="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["data"]["version"])' "$snapshot/buildinfo.json")" || exit 2
    name="prometheus-$version.linux-amd64"
    cache="$HOME/.cache/backtest-prometheus/$version"
    if [ ! -x "$cache/$name/prometheus" ]; then
        base="https://github.com/prometheus/prometheus/releases/download/v$version"
        mkdir -p "$HOME/.cache/backtest-prometheus"
        tmp="$(mktemp -d "$HOME/.cache/backtest-prometheus/.dl.XXXXXX")"
        ( cd "$tmp" \
            && curl -fsSLO "$base/$name.tar.gz" \
            && curl -fsSL "$base/sha256sums.txt" | grep " $name.tar.gz\$" | sha256sum -c - >&2 \
            && tar xzf "$name.tar.gz" ) || { rm -rf "$tmp"; echo "could not install prometheus $version" >&2; exit 2; }
        mkdir -p "$cache" && { mv "$tmp/$name" "$cache/" 2>/dev/null || [ -x "$cache/$name/prometheus" ]; }
        rm -rf "$tmp"
    fi
    binary="$cache/$name/prometheus"
fi
yaml_bin="$(scripts/python-venv scripts/pyyaml-requirements.txt yaml)" || exit 2
PATH="$yaml_bin:$PATH" exec infra/bin/backtest-alerts --source snapshot --no-write \
    --snapshot "$snapshot" --prometheus-binary "$binary" "$@"
"""


def run(command, **kwargs):
    return subprocess.run(command, **kwargs)


def log_of_run(run_id):
    done = run(["gh", "run", "view", str(run_id), "--log"], capture_output=True, text=True)
    if done.returncode != 0:
        sys.exit("cannot fetch the log of run %s: %s" % (run_id, done.stderr.strip()))
    return "\n".join(TIMESTAMP.sub("", line) for line in done.stdout.splitlines()) + "\n"


def alerts_named(log_text):
    return sorted({m.group(1) for m in map(NAMED.match, log_text.splitlines()) if m})


def invoked(argv):
    """The command as invoked, without --base/--head."""
    kept, skip = [], False
    for word in argv:
        if skip:
            skip = False
        elif word in ("--base", "--head"):
            skip = True
        elif not word.startswith(("--base=", "--head=")):
            kept.append(word)
    return " ".join(["infra/bin/backtest-alerts-replay"] + [shlex.quote(w) for w in kept])


def scope_for(host, remote_dir, scope, log_path):
    """The scope flags as the unpacked revision's tool takes them: --from-log, or the log's alerts as --alert."""
    if "--from-log" not in scope:
        return scope
    at = scope.index("--from-log")
    rest = scope[:at] + scope[at + 2:]
    probe = run(["ssh", host, "grep -q -e --from-log %s/infra/bin/backtest-alerts" % remote_dir])
    if probe.returncode == 0:
        return rest + ["--from-log", "red-run.log"]
    with open(log_path, encoding="utf-8") as handle:
        return rest + [x for name in alerts_named(handle.read()) for x in ("--alert", name)]


def replay(host, rev, sha, log_path, scope, user):
    """PASS, FAIL or ERROR for one revision on the host; the backtest's output streams to ours."""
    remote_dir = "/tmp/backtest-replay-%s-%d-%s" % (user, os.getpid(), sha[:8])
    print("== %s (%s) on %s" % (rev, sha[:8], host), flush=True)
    try:
        archive = subprocess.Popen(["git", "archive", sha, "infra", "scripts"], stdout=subprocess.PIPE)
        unpack = run(["ssh", host, "mkdir -p %s && tar -x -C %s" % (remote_dir, remote_dir)], stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or unpack.returncode != 0:
            return "ERROR"
        with open(log_path, "rb") as handle:
            if run(["ssh", host, "cat > %s/red-run.log" % remote_dir], stdin=handle).returncode != 0:
                return "ERROR"
        scoped = scope_for(host, remote_dir, scope, log_path)
        command = "bash -s -- %s %s %s" % (remote_dir, SNAPSHOT, " ".join(shlex.quote(a) for a in scoped))
        passthrough = os.environ.get("BACKTEST_REPLAY_PROMETHEUS_BINARY")
        if passthrough:
            command = "BACKTEST_REPLAY_PROMETHEUS_BINARY=%s %s" % (shlex.quote(passthrough), command)
        done = run(["ssh", host, command], input=REMOTE.encode())
        return {0: "PASS", 1: "FAIL"}.get(done.returncode, "ERROR")
    finally:
        run(["ssh", host, "rm -rf %s" % remote_dir])


def load_local():
    """infra/bin/backtest-alerts-local as a module: its sync, Prometheus and governor are the local replay's."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "backtest-alerts-local")
    loader = importlib.machinery.SourceFileLoader("backtest_alerts_local", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def local_scope(tool, scope, log_path):
    """The scope flags as the unpacked revision's tool takes them (scope_for's question, asked of a local file)."""
    if "--from-log" not in scope:
        return scope
    at = scope.index("--from-log")
    rest = scope[:at] + scope[at + 2:]
    with open(tool, encoding="utf-8") as handle:
        if "--from-log" in handle.read():
            return rest + ["--from-log", log_path]
    with open(log_path, encoding="utf-8") as handle:
        return rest + [x for name in alerts_named(handle.read()) for x in ("--alert", name)]


def local_verdicts(args, revisions, log_path, scope, scratch):
    """{label: PASS|FAIL|ERROR} with both revisions replayed HERE over one synced copy (backtest-alerts-local)."""
    local = load_local()
    trees = {}
    for label, sha in revisions:
        tree = os.path.join(scratch, label)
        os.makedirs(tree)
        archive = subprocess.Popen(["git", "archive", sha, "infra", "scripts"], stdout=subprocess.PIPE)
        unpack = run(["tar", "-x", "-C", tree], stdin=archive.stdout)
        archive.stdout.close()
        if archive.wait() != 0 or unpack.returncode != 0:
            return {label: "ERROR"}
        trees[label] = tree
    options = local.parse(scope + ["--days", str(args.days)] + (["--offline"] if args.offline else []))
    tools = {label: os.path.join(tree, "infra", "bin", "backtest-alerts") for label, tree in trees.items()}
    try:
        run_dir, snapshot, binary = local.prepare(options, [tools[label] for label, _sha in revisions])
    except (local.SyncError, OSError) as err:
        print("could not prepare the local copy: %s" % err, file=sys.stderr)
        return {"base": "ERROR"}
    verdicts = {}
    try:
        for label, sha in revisions:
            print("== %s (%s) locally" % (label, sha[:8]), flush=True)
            flags = local_scope(tools[label], scope, log_path) + ["--days", str(args.days), "--no-write"]
            command = local.governed(local.backtest_command(tools[label], snapshot, binary, flags))
            done = run(command, cwd=trees[label])
            verdicts[label] = {0: "PASS", 1: "FAIL"}.get(done.returncode, "ERROR")
            print("-- %s: %s" % (label, verdicts[label]), flush=True)
    finally:
        shutil.rmtree(run_dir, ignore_errors=True)
    return verdicts


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--from-run", help="the red Alert backtest run (GitHub run id): its problem lines scope the replay")
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument("--alert", action="append", default=[])
    parser.add_argument("--group", action="append", default=[])
    parser.add_argument("--host", default="ci-runner")
    parser.add_argument("--local", action="store_true",
                        help="replay on this machine over a synced copy (infra/bin/backtest-alerts-local), not --host")
    parser.add_argument("--offline", action="store_true", help="--local: the cached copy as it is, no sync")
    parser.add_argument("--days", type=float, default=14, help="--local: the window, as backtest-alerts takes it")
    args = parser.parse_args(argv)
    if not (args.from_run or args.alert or args.group):
        parser.error("name what to replay: --from-run, --alert or --group")
    if args.local:
        load_local().ensure_yaml()

    with tempfile.TemporaryDirectory(prefix="backtest-replay-") as scratch:
        return verdict(args, argv, scratch)


def verdict(args, argv, scratch):
    log_path = os.path.join(scratch, "red-run.log")
    with open(log_path, "w", encoding="utf-8") as handle:
        handle.write(log_of_run(args.from_run) if args.from_run else "")
    scope = [x for name in args.alert for x in ("--alert", name)] + [x for g in args.group for x in ("--group", g)]
    if args.from_run:
        scope += ["--from-log", log_path]

    revisions = []
    for label, rev in (("base", args.base), ("head", args.head)):
        parsed = run(["git", "rev-parse", "--verify", "--quiet", rev + "^{commit}"], capture_output=True, text=True)
        if parsed.returncode != 0:
            print("unknown revision %s" % rev, file=sys.stderr)
            return 2
        revisions.append((label, parsed.stdout.strip()))
    if args.local:
        verdicts = local_verdicts(args, revisions, log_path, scope, scratch)
    else:
        verdicts = {}
        for (label, sha), rev in zip(revisions, (args.base, args.head)):
            verdicts[label] = replay(args.host, rev, sha, log_path, scope, os.environ.get("USER") or str(os.getuid()))
            print("-- %s: %s%s" % (label, verdicts[label], " (harness error: exit 2 or a failed ssh/step)"
                                   if verdicts[label] == "ERROR" else ""), flush=True)
    if "ERROR" in verdicts.values():
        return 2
    print("Fix-Replay: %s base=%s head=%s" % (invoked(argv), verdicts["base"], verdicts["head"]))
    return 0 if (verdicts["base"], verdicts["head"]) == ("FAIL", "PASS") else 1


if __name__ == "__main__":
    sys.exit(main())
