#!/usr/bin/env python3
"""Snapshot the fleet's REAL label values for every (metric, label) an alert or panel filters on.

Writes infra/test/label-values.json, which test_label_shapes.py validates every matcher against.
READ-ONLY: it only calls Prometheus's label-values API.

WHY A SNAPSHOT OF REAL VALUES. A label matcher is checked by nothing: Prometheus answers an empty
or partial result for a pattern that misses, and the alert is silently narrower than its name.
`route=~"/api/me.*"` (2026-09-23) matched Poland's `/api/me/state` and missed every mounted
country's `/uk/api/me/state`, so UserStateWritesFailing only ever watched Poland. A promtool case
cannot catch that -- its author types the same wrong assumption into the input series. Only the
values the running fleet actually produces can.

Reaches Prometheus over the fleet SOCKS proxy (`ssh -f -N kinowo-fleet`, 127.0.0.1:1080), with
curl because Python's urllib has no SOCKS support. Re-run it when a matcher is added on a label
the snapshot has not seen, or when the label shapes themselves change (a new country mount, a new
enrichment row) -- the test names the missing pair.

Usage: infra/bin/snapshot-label-values [--days 14] [--prometheus http://10.20.0.11:9090]
"""

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import time
import urllib.parse

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "test"))
import promql_selectors  # noqa: E402

OUTPUT = os.path.join(HERE, "..", "test", "label-values.json")
SOCKS = "127.0.0.1:1080"
WORKERS = 8


def fetch(base, path, params):
    url = "%s%s?%s" % (base, path, urllib.parse.urlencode(params, doseq=True))
    out = subprocess.run(["curl", "-sfS", "--max-time", "60", "--socks5-hostname", SOCKS, url],
                         check=True, capture_output=True, text=True).stdout
    body = json.loads(out)
    if body.get("status") != "success":
        raise RuntimeError("%s: %s" % (url, body))
    return body["data"]


def wanted_pairs(all_metric_names):
    """{metric: {label, ...}} for every literal matcher in every rule, Grafana alert and panel."""
    pairs = {}
    for _, expr in promql_selectors.all_expressions():
        for selector in promql_selectors.selectors(expr):
            labels = {m.label for m in selector.label_matchers if not m.is_templated}
            if not labels:
                continue
            name = selector.name_matcher
            metrics = [name.value] if name is not None and name.op == "=" else selector.metrics(all_metric_names)
            for metric in metrics:
                pairs.setdefault(metric, set()).update(labels)
    return pairs


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--days", type=int, default=14)
    parser.add_argument("--prometheus", default="http://10.20.0.11:9090")
    args = parser.parse_args()

    end = int(time.time())
    window = {"start": end - args.days * 86400, "end": end}
    names = fetch(args.prometheus, "/api/v1/label/__name__/values", window)
    pairs = wanted_pairs(names)
    jobs = [(metric, label) for metric, labels in sorted(pairs.items()) for label in sorted(labels)]

    started = time.time()
    snapshot = {metric: {} for metric in pairs}
    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:
        futures = {
            pool.submit(fetch, args.prometheus, "/api/v1/label/%s/values" % label,
                        dict(window, **{"match[]": metric})): (metric, label)
            for metric, label in jobs
        }
        for future in concurrent.futures.as_completed(futures):
            metric, label = futures[future]
            values = sorted(future.result())
            if values:
                snapshot[metric][label] = values
    elapsed = time.time() - started

    # The three kinowo_uptime_recent_* families carry the same ~9,000 service names; writing each
    # list once keeps the fixture reviewable. The reader resolves `same_as` back to the list.
    first_seen = {}
    for metric in sorted(snapshot):
        for label, values in sorted(snapshot[metric].items()):
            key = (label, tuple(values))
            if key in first_seen:
                snapshot[metric][label] = {"same_as": first_seen[key]}
            else:
                first_seen[key] = metric

    document = {
        "comment": "Written by infra/bin/snapshot-label-values from the fleet Prometheus; read by "
                   "infra/test/test_label_shapes.py. Do not edit by hand -- re-run the script.",
        "window_days": args.days,
        "metrics": snapshot,
    }
    with open(OUTPUT, "w", encoding="utf-8") as handle:
        json.dump(document, handle, indent=1, sort_keys=True, ensure_ascii=False)
        handle.write("\n")
    print("%d (metric, label) pairs over %d metrics in %.1fs (%.1f/s) -> %s"
          % (len(jobs), len(pairs), elapsed, len(jobs) / max(elapsed, 0.001), os.path.relpath(OUTPUT)))


if __name__ == "__main__":
    main()
