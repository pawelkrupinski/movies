#!/usr/bin/env python3
"""Snapshot the fleet's REAL label values for every (metric, label) an alert or panel filters on.

Writes infra/test/label-values.json, which test_label_shapes.py validates every matcher against,
and infra/test/metric-names.json, which test_metric_names.py checks every exporter name against.
READ-ONLY: it only calls Prometheus's label-values API.

WHY A SNAPSHOT OF REAL VALUES. A label matcher is checked by nothing: Prometheus answers an empty
or partial result for a pattern that misses, and the alert is silently narrower than its name.
`route=~"/api/me.*"` (2026-09-23) matched Poland's `/api/me/state` and missed every mounted
country's `/uk/api/me/state`, so UserStateWritesFailing only ever watched Poland. A promtool case
cannot catch that -- its author types the same wrong assumption into the input series. Only the
values the running fleet actually produces can.

Reaches Prometheus over the fleet SOCKS proxy (`ssh -f -N kinowo-fleet`, 127.0.0.1:1080), with
curl because Python's urllib has no SOCKS support. Re-run it when a matcher is added on a label
the snapshot has not seen, or when the label shapes themselves change (a new country mount, a new
enrichment row) -- the test names the missing pair.

Usage: infra/bin/snapshot-label-values [--days 14] [--prometheus http://10.20.0.11:9090] [--names-only]
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import subprocess
import sys
import time
import urllib.parse
from typing import Any, Dict, List, Mapping, Set, Tuple

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "test"))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(HERE)), "scripts", "lib"))  # machine (Alert backtest #38)
from processes import machine  # noqa: E402
import promql_selectors  # noqa: E402

OUTPUT = os.path.join(HERE, "..", "test", "label-values.json")
NAMES_OUTPUT = os.path.join(HERE, "..", "test", "metric-names.json")
SOCKS = "127.0.0.1:1080"
WORKERS = 8


def fetch(base: str, path: str, params: Mapping[str, Any]) -> Any:
    url = "%s%s?%s" % (base, path, urllib.parse.urlencode(params, doseq=True))
    out = subprocess.run(["curl", "-sfS", "--max-time", "60", "--socks5-hostname", SOCKS, url],
                         check=True, capture_output=True, text=True).stdout
    body = json.loads(out)
    if body.get("status") != "success":
        raise RuntimeError("%s: %s" % (url, body))
    return body["data"]


def _selector_metrics(selector: Any, all_metric_names: List[str]) -> List[str]:
    name = selector.name_matcher
    return [name.value] if name is not None and name.op == "=" else selector.metrics(all_metric_names)


def wanted_pairs(all_metric_names: List[str]) -> Dict[str, Set[str]]:
    """{metric: {label, ...}} for every literal matcher in every rule, Grafana alert and panel."""
    pairs: Dict[str, Set[str]] = {}
    for _, expr in promql_selectors.all_expressions():
        for selector in promql_selectors.selectors(expr):
            labels = {m.label for m in selector.label_matchers if not m.is_templated}
            for metric in (_selector_metrics(selector, all_metric_names) if labels else []):
                pairs.setdefault(metric, set()).update(labels)
    return pairs


def referenced_names(all_metric_names: List[str]) -> List[str]:
    """The fleet names every rule, Grafana alert, panel and template variable reads that the
    build cannot vouch for itself -- not a `kinowo_*` family (GrafanaMetricCoverageSpec checks
    those against the code) and not a recording rule's output (test_metric_names.py checks those
    against the rule files): the exporters' `jvm_*`, `process_*`, `node_*`, `mongodb_*`... Only the
    referenced subset is written, so the fixture stays reviewable and a name the fleet does not
    have stays missing from it however often the script is re-run."""
    known = set(all_metric_names)
    expressions = list(promql_selectors.all_expressions()) + list(promql_selectors.template_queries())
    wanted = set()
    for _, expr in expressions:
        wanted.update(promql_selectors.metric_names(expr))
        for pattern in promql_selectors.name_patterns(expr):
            wanted.update(n for n in known if pattern.matches(n))
    return sorted(n for n in wanted & known if not n.startswith("kinowo_") and ":" not in n)


def write_metric_names(names: List[str], days: int, taken: float) -> None:
    document = {
        "comment": "Written by infra/bin/snapshot-label-values from the fleet Prometheus; read by "
                   "infra/test/test_metric_names.py. Do not edit by hand -- re-run the script "
                   "(--names-only refreshes just this file).",
        "window_days": days,
        # When the window ended: test_metric_names.py refuses a snapshot older than MAX_AGE_DAYS,
        # since a name the fleet STOPPED exporting stays in a stale one and passes for good.
        "taken": time.strftime("%Y-%m-%d", time.gmtime(taken)),
        "names": referenced_names(names),
    }
    with open(NAMES_OUTPUT, "w", encoding="utf-8") as handle:
        json.dump(document, handle, indent=1, sort_keys=True)
        handle.write("\n")


DOCSTRING = __doc__ or ""  # None under python -OO


def _fetch_values(base: str, window: Mapping[str, int], jobs: List[Tuple[str, str]]) -> Dict[str, Dict[str, Any]]:
    """{metric: {label: sorted values}} -- the pairs the fleet holds values for -- over a pool of WORKERS curls."""
    snapshot: Dict[str, Dict[str, Any]] = {metric: {} for metric, _ in jobs}
    with concurrent.futures.ThreadPoolExecutor(WORKERS) as pool:
        futures = {
            pool.submit(fetch, base, "/api/v1/label/%s/values" % label, dict(window, **{"match[]": metric})): (metric, label)
            for metric, label in jobs
        }
        for future in concurrent.futures.as_completed(futures):
            metric, label = futures[future]
            values = sorted(future.result())
            if values:
                snapshot[metric][label] = values
    return snapshot


def _share_equal_lists(snapshot: Dict[str, Dict[str, Any]]) -> None:
    """The three kinowo_uptime_recent_* families carry the same ~9,000 service names; writing each
    list once keeps the fixture reviewable. The reader resolves `same_as` back to the list."""
    first_seen: Dict[Tuple[str, Tuple[str, ...]], str] = {}
    for metric in sorted(snapshot):
        for label, values in sorted(snapshot[metric].items()):
            key = (label, tuple(values))
            if key in first_seen:
                snapshot[metric][label] = {"same_as": first_seen[key]}
            else:
                first_seen[key] = metric


def _write_label_values(days: int, snapshot: Mapping[str, Any]) -> None:
    document = {
        "comment": "Written by infra/bin/snapshot-label-values from the fleet Prometheus; read by "
                   "infra/test/test_label_shapes.py. Do not edit by hand -- re-run the script.",
        "window_days": days,
        "metrics": snapshot,
    }
    with open(OUTPUT, "w", encoding="utf-8") as handle:
        json.dump(document, handle, indent=1, sort_keys=True, ensure_ascii=False)
        handle.write("\n")


def main() -> None:
    parser = argparse.ArgumentParser(description=DOCSTRING.split("\n")[0])
    parser.add_argument("--days", type=int, default=14)
    parser.add_argument("--prometheus", default="http://10.20.0.11:9090")
    parser.add_argument("--names-only", action="store_true",
                        help="refresh only metric-names.json (one query) -- what its age check asks for")
    args = parser.parse_args()

    end = int(machine.wall())
    window = {"start": end - args.days * 86400, "end": end}
    names = fetch(args.prometheus, "/api/v1/label/__name__/values", window)
    write_metric_names(names, args.days, end)
    print("%d referenced names -> %s" % (len(referenced_names(names)), os.path.relpath(NAMES_OUTPUT)))
    if args.names_only:
        return
    pairs = wanted_pairs(names)
    jobs = [(metric, label) for metric, labels in sorted(pairs.items()) for label in sorted(labels)]
    started = machine.wall()
    snapshot = _fetch_values(args.prometheus, window, jobs)
    elapsed = machine.wall() - started
    _share_equal_lists(snapshot)
    _write_label_values(args.days, snapshot)
    print("%d (metric, label) pairs over %d metrics in %.1fs (%.1f/s) -> %s"
          % (len(jobs), len(pairs), elapsed, len(jobs) / max(elapsed, 0.001), os.path.relpath(OUTPUT)))


if __name__ == "__main__":
    main()
