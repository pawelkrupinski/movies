#!/usr/bin/env python3
"""Find upgrades to the fleet flake's Nix dependencies and write them as ONE change for a pull request.

WHY THIS EXISTS. Nothing upgraded the NixOS side of this repository: Renovate is scoped to Gradle,
scala-steward to sbt, and nixpkgs (infra/flake.lock) moved only when somebody remembered -- as did
the one hand-pinned package, mongod (infra/nix/modules/roles/mongodb.nix), which is pinned ahead of
nixpkgs precisely so that it gets patch releases nixpkgs does not ship.

WHAT IT DOES, AND WHAT IT DOES NOT. It proposes; it never merges, pushes or deploys. It applies
every upgrade it finds to this tree -- the pinned packages (PINNED below) and every flake input --
and writes ONE patch plus a title and a body into --out (ported from bitcashier/infra's
bin/nix-update, operator decision 2026-10-22: "one PR for all nix dep updates").
.github/workflows/nix-update.yml turns them into a pull request with infra/bin/propose-pr.
A merge to main IS a deploy of the fleet -- nix-stage-closures.yml stages every host's closure and
`fleet.autoApply` activates what it may -- so the person merging is the gate, and the body exists to
give them what they need.

  infra/bin/nix-update --old DIR --out DIR   # upgrade THIS tree; DIR/infra is the same tree, untouched
  infra/bin/nix-update --self-test           # offline: version choice, file rewriting, every pin's shape

It builds EVERY host's closure from the old tree and from the new one and puts the union of
`nix store diff-closures` in the body: a nixpkgs bump is unreviewable as a lock diff (two hashes)
and reviewable as "openssl 3.5.1 -> 3.5.2 on all 3 hosts". It also proves the new tree BUILDS,
which the pull request's own CI does not -- nix-stage-closures.yml's `evaluate` instantiates, it
does not build.

CONTAINER IMAGE PINS ride along (infra/bin/image_pins.py, added 2026-10-23): the Dockerfile's bases, BuildKit,
Swift's CI container, and movies-gitops' cluster components (Flux, kube-state-metrics, Reloader, Headlamp), which no
other bumper watched. This checkout's pins are rewritten by each pin's policy; movies-gitops' are listed in the body
only: they move in that repository's own weekly PR (image_pins.py --gitops-out, the same workflow). A week where only an image pin moved skips
the host builds: nothing Nix changed.

Pinned packages take the newest release WITHIN THE CURRENT MAJOR only; a newer major is listed in
the body and left alone (a mongod major has its own upgrade path: featureCompatibilityVersion, one
major at a time). mongod's version is also held to the CI and local `mongo:<tag>` containers by
MongoServerVersionParitySpec, so a bump rewrites those tags too -- and is not proposed until Docker
Hub publishes the tag. The hashes are computed from the downloaded bytes and checked against
MongoDB's published sha256; a mismatch leaves the package out and fails the run.

Exit 0 done (a change written, or nothing to upgrade), 1 part of it failed (what did work is still
written to --out), 2 it could not look at all. Python 3.9 (scripts/run-script-tests' floor).
"""

import argparse
import base64
import dataclasses
import datetime
import hashlib
import json
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request
from typing import Any, Dict, List, Optional, Tuple

import image_pins  # beside this script: the container image pins no other bumper owns
from nix_update_body import PinnedUpgrades, Upgrade, package_rows, pull_request_body  # beside this script: the pull request's body
import nix_path  # beside this script: where nix is when PATH lacks it

REPO = pathlib.Path(__file__).resolve().parents[1]  # infra/, the flake root
ROOT = REPO.parent  # the git checkout
USER_AGENT = "kinowo-infra-nix-update"


def request(url):
    return urllib.request.Request(url, headers={"User-Agent": USER_AGENT})


def fetch(url):
    with urllib.request.urlopen(request(url), timeout=300) as response:
        return response.read()


def sha256_of(url):
    """The sha256 of url's bytes, streamed: a mongod tarball is a few hundred MB."""
    digest = hashlib.sha256()
    with urllib.request.urlopen(request(url), timeout=300) as response:
        for chunk in iter(lambda: response.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def run(argv, cwd):
    result = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)
    return result.returncode, result.stdout, result.stderr


def version_key(v):
    return tuple(int(p) for p in v.split("."))


def is_release(v):
    return re.fullmatch(r"\d+(\.\d+)*", v) is not None


def choose(current, available):
    """([every release in current's major newer than it, newest first], newest of a later major or None)."""
    releases = sorted({v for v in available if is_release(v)}, key=version_key, reverse=True)
    major = version_key(current)[0]
    same = [v for v in releases if version_key(v)[0] == major and version_key(v) > version_key(current)]
    later = [v for v in releases if version_key(v)[0] > major]
    return same, (later[0] if later else None)


# ---- the pinned package: mongod ---------------------------------------------------------------
#
# roles/mongodb.nix names the release once (`mongodbVersion = "x.y.z";`) and four tarballs, one
# `url = "...${mongodbVersion}...";` + `hash = "sha256-...";` pair per platform. Every url is the
# file's own template with the new version put in, so the file and this script cannot disagree
# about where the bytes come from.

MONGODB_FILE = "nix/modules/roles/mongodb.nix"
# The containers MongoServerVersionParitySpec holds to the same release (paths from the checkout).
# CI's is the `mongo` row of .github/pinned-images.tsv (tag AND digest; CiPinnedImageSpec), which
# start_mongo_replset.py reads, its native /opt/mongodb/<tag> home included.
MONGODB_TAG_FILES = (".github/pinned-images.tsv", "scripts/convergence_local.py")
PINNED_IMAGES = ".github/pinned-images.tsv"

MONGODB_VERSION_LINE = re.compile(r'^(\s*mongodbVersion = ")([^"]+)(";)', re.M)
URL_HASH = re.compile(r'(url = ")([^"]+)(";\s*\n\s*hash = ")(sha256-[A-Za-z0-9+/=]+)(";)')


def mongo_tag(version):
    # The spec's own pattern: bare or registry-qualified `mongo:<tag>`.
    return re.compile(r"(?<![\w.-])((?:[\w.-]+/)*mongo:)" + re.escape(version) + r"(?![\w.])")


def mongodb_shape(text):
    """(current version, [(url template, hash)]). Refuses any other shape."""
    versions = MONGODB_VERSION_LINE.findall(text)
    if len(versions) != 1:
        raise ValueError(f"expected exactly one `mongodbVersion = \"...\";` line, found {len(versions)}")
    pairs = [(m.group(2), m.group(4)) for m in URL_HASH.finditer(text)]
    if len(pairs) != 4 or any("${mongodbVersion}" not in url for url, _ in pairs):
        raise ValueError("expected four `url = \"...${mongodbVersion}...\"; hash = \"sha256-...\";` pairs")
    return versions[0][1], pairs


def rewrite_mongodb(text, version, hashes):
    """The file with its version and each url's hash replaced; hashes is {url template: sri}."""
    mongodb_shape(text)
    text = MONGODB_VERSION_LINE.sub(lambda m: m.group(1) + version + m.group(3), text)
    return URL_HASH.sub(lambda m: m.group(1) + m.group(2) + m.group(3) + hashes[m.group(2)] + m.group(5), text)


def rewrite_tags(text, current, version):
    """Every `mongo:<current>` made `<version>`. Refuses a file naming no tag."""
    pattern = mongo_tag(current)
    if not pattern.search(text):
        raise ValueError(f"names no mongo:{current}")
    return pattern.sub(lambda m: m.group(1) + version, text)


def mongodb_releases():
    """{version: {archive url: published sha256}} for every production release."""
    listing = json.loads(fetch("https://downloads.mongodb.org/full.json"))
    out = {}
    for release in listing["versions"]:
        if not release.get("production_release"):
            continue
        out[release["version"]] = {d["archive"]["url"]: d["archive"].get("sha256")
                                   for d in release.get("downloads", []) if "archive" in d}
    return out


def docker_hub_digest(version):
    """The digest Docker Hub's `mongo:<version>` points at (its index), None when there is no such tag."""
    try:
        with urllib.request.urlopen(request(
                f"https://hub.docker.com/v2/repositories/library/mongo/tags/{version}"), timeout=60) as r:
            digest = json.loads(r.read()).get("digest")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    if not re.fullmatch(r"sha256:[0-9a-f]{64}", digest or ""):
        raise ValueError(f"Docker Hub's mongo:{version} names no digest ({digest!r})")
    return digest


def rewrite_pinned_digest(text, version, digest):
    """The pins table with `mongo:<version>`'s digest made `digest` (after rewrite_tags moved the tag)."""
    pattern = re.compile(r"((?:[\w.-]+/)*mongo:" + re.escape(version) + r")@sha256:[0-9a-f]{64}")
    if not pattern.search(text):
        raise ValueError(f"pins no mongo:{version}@sha256:<digest>")
    return pattern.sub(lambda m: m.group(1) + "@" + digest, text)


def header_comment(text, line_pattern):
    """The comment block right above the pinned line: why it is pinned."""
    lines = text[:line_pattern.search(text).start()].rstrip("\n").splitlines()
    out = []
    for line in reversed(lines):
        if not line.strip().startswith("#"):
            break
        out.append(line.strip().lstrip("#").strip())
    return " ".join(reversed(out))


@dataclasses.dataclass
class MongodbBump:
    """What bump_mongodb found: the pin, the version to take (None when nothing newer is proposable), the newer major
    it holds back, and the PR's wording."""
    name: str
    path: str
    current: str
    take: Optional[str]
    later: Optional[str]
    header: str
    notes: List[str]
    checked: str = ""


class Refused(Exception):
    """A pinned package's new bytes did not match upstream's checksum."""


def bump_mongodb():
    """Bump mongod in place when its major has a newer release Docker Hub also has."""
    text = (REPO / MONGODB_FILE).read_text()
    current, pairs = mongodb_shape(text)
    releases = mongodb_releases()
    if not releases:
        raise ValueError("upstream listed no releases at all, which is not the same as none being newer")
    newer, later = choose(current, releases)
    found = MongodbBump("mongodb", f"infra/{MONGODB_FILE}", current, None, later,
                        header_comment(text, MONGODB_VERSION_LINE), [])
    digest = None
    for v in newer:
        digest = docker_hub_digest(v)
        if digest:
            found.take = v
            break
        found.notes.append(f"mongodb {v}: Docker Hub has no `mongo:{v}` yet, and CI's mongod must run "
                              "the same release (MongoServerVersionParitySpec) -- not proposed")
    take = found.take
    if not take:
        return found
    hashes = {}
    for template, _ in pairs:
        url = template.replace("${mongodbVersion}", take)
        want = releases[take].get(url)
        if not want:
            raise Refused(f"MongoDB's listing for {take} has no {url} (the file's url template no longer matches upstream)")
        digest = sha256_of(url)
        if digest != want:
            raise Refused(f"downloaded {url} hashes to {digest} but MongoDB's listing says {want}")
        hashes[template] = "sha256-" + base64.b64encode(bytes.fromhex(digest)).decode()
    tag_files = {p: (ROOT / p).read_text() for p in MONGODB_TAG_FILES}
    rewritten = {p: rewrite_tags(t, current, take) for p, t in tag_files.items()}
    rewritten[PINNED_IMAGES] = rewrite_pinned_digest(rewritten[PINNED_IMAGES], take, digest)
    (REPO / MONGODB_FILE).write_text(rewrite_mongodb(text, take, hashes))
    for p, t in rewritten.items():
        (ROOT / p).write_text(t)
    found.checked = "each tarball matches MongoDB's published sha256; `mongo:` tags in " + \
        ", ".join(f"`{p}`" for p in MONGODB_TAG_FILES) + f" moved with it (CI's pin to Docker Hub's {digest}; " \
        "mirror-pinned-images.yml copies it to GHCR once this lands, CI pulling it from mirror.gcr.io until then)"
    # start_mongo_replset.py looks for a job image's native mongod at /opt/mongodb/<the pin's tag>
    found.notes.append(f"mongodb {take}: a CI job image baking its native mongod at `/opt/mongodb/{current}` "
                          "(bitcashier/infra `nix/files/movies-job-image/Dockerfile`) must bake "
                          f"`/opt/mongodb/{take}` too; until then CI starts the `mongo:{take}` container (slower, same release)")
    return found


# ---- flake.lock -------------------------------------------------------------------------------

def locked_inputs(lock):
    return {name: node["locked"] for name, node in lock["nodes"].items() if "locked" in node}


def hosts(tree: pathlib.Path) -> List[str]:
    code, out, err = run(["nix", "eval", "--json", ".#nixosConfigurations", "--apply", "builtins.attrNames"], tree)
    if code != 0:
        raise RuntimeError(err.strip()[-2000:])
    return json.loads(out)


def instantiate(tree: pathlib.Path, names: List[str]) -> Tuple[Dict[str, str], Dict[str, str]]:
    """{host: .drv} from evaluation alone, and {host: error} for those that would not evaluate."""
    drvs, errors = {}, {}
    for name in names:
        code, out, err = run(["nix", "eval", "--raw",
                              f".#nixosConfigurations.{name}.config.system.build.toplevel.drvPath"], tree)
        if code != 0:
            errors[name] = err.strip()[-1500:]
        else:
            drvs[name] = out.strip()
    return drvs, errors


def build(drvs: Dict[str, str]) -> Dict[str, Tuple[Optional[str], Optional[str]]]:
    """Build every .drv in ONE nix process (shared dependencies built once), then ask per host --
    each host's own error comes from its own retry, not the shared run's tail."""
    if not drvs:
        return {}
    run(["nix", "build", "--keep-going", "--no-link", "--max-jobs", "auto"] + [f"{d}^*" for d in drvs.values()], REPO)
    built = {}
    for name, drv in drvs.items():
        code, out, err = run(["nix", "build", "--no-link", "--print-out-paths", f"{drv}^*"], REPO)
        built[name] = (out.strip(), None) if code == 0 else (None, err.strip()[-1500:])
    return built


def changed(line: str) -> Optional[str]:
    """The `old → new` part of a diff-closures line, None for a line that is not a version change."""
    matched = DIFF_LINE.match(line)
    return matched["change"] if matched else None


DIFF_LINE = re.compile(r"^(?P<pkg>[^:]+): (?P<change>.*→.*?)(?:, [+-][\d.]+ [KMG]?i?B)?$")
# diff-closures colours the size even when its output is not a terminal.
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def pinned_upgrades() -> PinnedUpgrades:
    """The pinned package, within its major."""
    result = PinnedUpgrades()
    try:
        found = bump_mongodb()
    except Refused as e:
        result.failures.append(f"**mongodb**: REFUSED -- {e}")
        result.failed = True
    except Exception as e:  # network or format: "could not look", never "up to date"
        result.failures.append(f"**mongodb**: could not check upstream -- {e}")
        result.failed = True
    else:
        result.bumped = [found] if found.take else []
        result.held = [found] if found.later else []
        result.notes = list(found.notes)
    return result


# (action, movies-gitops' row?, wording): this checkout's bumped pins, those behind, then movies-gitops' bumped ones
IMAGE_LINES = (("bumped", False, "image {name} {current} -> {latest}"),
               ("behind", None, "image {name} {current} is behind {latest}: bump by hand"),
               ("bumped", True, "image {name} {current} -> {latest} in movies-gitops' PR"))


def image_summary(image_rows: List[Dict[str, Any]]) -> List[str]:
    """The summary lines of the container image pins."""
    return [wording.format(**r) for action, gitops, wording in IMAGE_LINES for r in image_rows
            if r["action"] == action and gitops in (None, r["gitops"])]


def moved_inputs(old_in: Dict[str, Dict[str, Any]], new_in: Dict[str, Dict[str, Any]]) -> List[str]:
    return sorted(n for n in new_in if old_in.get(n, {}).get("narHash") != new_in[n].get("narHash"))


def host_changes(old_tree: pathlib.Path, names: List[str]) -> Tuple[Dict[str, List[str]], Dict[str, str]]:
    """Every host built before and after: ({package change: hosts}, {host: why it fails}); a host broken before
    this change as well has nothing to compare against."""
    old_drvs, _ = instantiate(old_tree, names)
    new_drvs, new_eval_errors = instantiate(REPO, names)
    old_built, new_built = build(old_drvs), build(new_drvs)
    changes: Dict[str, List[str]] = {}
    failed: Dict[str, str] = {}
    for name in names:
        if name in new_eval_errors:
            failed[name] = "does not evaluate:\n" + new_eval_errors[name]
            continue
        new_path, error = new_built[name]
        old_path = (old_built.get(name) or (None, None))[0]
        if error:
            failed[name] = "does not build:\n" + error
        elif old_path:
            _, diff, _ = run(["nix", "store", "diff-closures", old_path, new_path], REPO)
            for m in filter(None, (DIFF_LINE.match(ANSI.sub("", line).strip()) for line in diff.splitlines())):
                changes.setdefault(f"{m['pkg']}: {m['change']}", []).append(name)
    return changes, failed


def caught_up_note(names: List[str], bumped: List[MongodbBump]) -> str:
    """When nixpkgs catches up with the pin, mongodb.nix says to drop the override."""
    if "mongo-1" not in names:
        return ""
    code, nixpkgs_mongo, _ = run(["nix", "eval", "--raw", ".#nixosConfigurations.mongo-1.pkgs.mongodb-ce.version"], REPO)
    pinned = (bumped[0].take if bumped else None) or mongodb_shape((REPO / MONGODB_FILE).read_text())[0]
    version = nixpkgs_mongo.strip()
    if code == 0 and is_release(version) and version_key(version) >= version_key(pinned):
        return (f"- nixpkgs' `mongodb-ce` is now **{version}**, not behind the pin ({pinned}): "
                f"the override in `infra/{MONGODB_FILE}` can go (its comment says so).\n")
    return ""


def write_proposal(out: pathlib.Path, u: Upgrade, summary: List[str]) -> int:
    """changes.patch, title, body.md and summary.md; 1 when git has no diff to propose."""
    print("\n".join(package_rows(u)))
    code, diff, err = run(["git", "diff"], ROOT)
    if code != 0 or not diff:
        print(f"git diff failed or was empty: {err}", file=sys.stderr)
        return 1
    bumped = u.pinned.bumped
    parts = ([f"{f.name} {f.take}" for f in bumped] + (["flake.lock: " + ", ".join(u.moved)] if u.moved else [])
             + [f"{r['name']} {r['latest']}" for r in u.images_bumped])
    (out / "changes.patch").write_text(diff)
    (out / "title").write_text(f"deps: weekly update ({'; '.join(parts)})\n")
    (out / "body.md").write_text(pull_request_body(u))
    (out / "summary.md").write_text("".join(f"- {s}\n" for s in summary + u.pinned.failures))
    print("\n".join(summary + u.pinned.failures))
    return 0



def pinned_summary(pinned: PinnedUpgrades) -> List[str]:
    return ([f"{f.name} {f.current} -> {f.take}" for f in pinned.bumped]
            + [f"{f.name} {f.later} is a newer major, not proposed" for f in pinned.held] + pinned.notes)


def refreshed_inputs(old_tree: pathlib.Path) -> Optional[Tuple[Dict[str, Dict[str, Any]], Dict[str, Dict[str, Any]], List[str]]]:
    """flake.lock after `nix flake update`: (old inputs, new inputs, those that moved); None when the update failed."""
    old_in = locked_inputs(json.loads((old_tree / "flake.lock").read_text()))
    code, _, err = run(["nix", "flake", "update"], REPO)
    if code != 0:
        print(f"nix flake update failed:\n{err}", file=sys.stderr)
        return None
    new_in = locked_inputs(json.loads((REPO / "flake.lock").read_text()))
    return old_in, new_in, moved_inputs(old_in, new_in)


def nothing_to_upgrade(out: pathlib.Path, lines: List[str]) -> None:
    (out / "summary.md").write_text("Nothing to upgrade.\n" + "".join(f"- {s}\n" for s in lines))
    print("nothing to upgrade")
    for line in lines:
        print(line, file=sys.stderr)


def update(old_tree: pathlib.Path, out: pathlib.Path) -> int:
    pinned = pinned_upgrades()
    # Container image pins (infra/bin/image_pins.py): this checkout's are rewritten, movies-gitops' only listed
    # (they move in that repository's own PR, image_pins.py --gitops-out).
    image_rows, image_failures = image_pins.update(ROOT, image_pins.GITOPS, write={"repo"})
    pinned.failures += image_failures
    summary = pinned_summary(pinned) + image_summary(image_rows)
    status = 1 if pinned.failed or image_failures else 0

    inputs = refreshed_inputs(old_tree)
    if inputs is None:
        return 2
    old_in, new_in, moved = inputs
    if moved:
        summary.append(f"flake inputs moved: {', '.join(moved)}")
    if not (pinned.bumped or moved or any(r["action"] == "bumped" and not r["gitops"] for r in image_rows)):
        nothing_to_upgrade(out, summary + pinned.failures)
        return status

    # Every host, before and after: proves the new tree BUILDS (the PR's own CI only evaluates) and says what actually
    # changes on the machines. Nothing Nix moved (only image pins): nothing to build.
    try:
        names = hosts(REPO) if pinned.bumped or moved else []
    except RuntimeError as e:
        print(f"could not list the hosts: {e}", file=sys.stderr)
        return 2
    changes, failed = host_changes(old_tree, names)
    if failed:
        summary.append(f"{len(failed)} host(s) do not build: {', '.join(sorted(failed))}")
    upgrade = Upgrade(pinned, old_in, new_in, moved, image_rows, image_failures, names, changes, failed,
                      caught_up_note(names, pinned.bumped))
    return write_proposal(out, upgrade, summary) or status


# ---- self-test --------------------------------------------------------------------------------

def expect(failures: List[str], what: str, got: object, want: object) -> None:
    if got != want:
        failures.append(f"{what}: got {got!r}, want {want!r}")


def check_choice(failures: List[str]) -> None:
    expect(failures, "same major only", choose("8.3.11", ["8.2.9", "8.3.11", "8.3.13", "8.3.12", "8.4.0", "9.0.4", "9.0.2"]),
           (["8.4.0", "8.3.13", "8.3.12"], "9.0.4"))
    expect(failures, "nothing newer", choose("8.3.11", ["8.3.11", "8.2.9"]), ([], None))
    expect(failures, "prereleases ignored", choose("8.3.11", ["8.3.12-rc0", "8.3.12"]), (["8.3.12"], None))
    expect(failures, "major only newer", choose("8.3.13", ["8.3.13", "9.0.0"]), ([], "9.0.0"))


def check_mongodb_rewrites(failures: List[str]) -> None:
    sample = ('  # Pinned ahead of nixpkgs.\n  mongodbVersion = "8.3.11";\n  x = {\n'
              + "".join(f'    "{p}" = pkgs.fetchurl {{\n      url = "https://h/{p}-${{mongodbVersion}}.tgz";\n'
                        f'      hash = "sha256-{p}=";\n    }};\n' for p in ("a", "b", "c", "d")) + "  };\n")
    expect(failures, "shape", mongodb_shape(sample)[0], "8.3.11")
    new = rewrite_mongodb(sample, "8.3.13", {f"https://h/{p}-${{mongodbVersion}}.tgz": f"sha256-N{p}=" for p in "abcd"})
    expect(failures, "rewrite", new, sample.replace('"8.3.11"', '"8.3.13"').replace("sha256-a=", "sha256-Na=")
           .replace("sha256-b=", "sha256-Nb=").replace("sha256-c=", "sha256-Nc=").replace("sha256-d=", "sha256-Nd="))
    for broken, why in ((sample.replace("  mongodbVersion", "  # mongodbVersion"), "no version line"),
                        (sample.replace("${mongodbVersion}.tgz\";\n      hash = \"sha256-d=", "8.3.11.tgz\";\n      hash = \"sha256-d="),
                         "a url not built from the version")):
        try:
            mongodb_shape(broken)
            failures.append(f"mongodb_shape accepted a file with {why}")
        except ValueError:
            pass
    expect(failures, "header", header_comment("x\n  # Why one,\n  # why two.\n  mongodbVersion = \"1\";\n", MONGODB_VERSION_LINE),
           "Why one, why two.")


def check_pins_and_diffs(failures: List[str]) -> None:
    expect(failures, "tags", rewrite_tags("image=mirror.gcr.io/library/mongo:8.3.11\nrun mongo:8.3.11 --x\nmongo:8.3.111\n",
                                          "8.3.11", "8.3.13"),
           "image=mirror.gcr.io/library/mongo:8.3.13\nrun mongo:8.3.13 --x\nmongo:8.3.111\n")
    pin = "mongo\tdocker.io/library/mongo:8.3.13@sha256:" + "a" * 64 + "\tghcr.io/o/mongo\n"
    expect(failures, "pinned digest", rewrite_pinned_digest(pin, "8.3.13", "sha256:" + "b" * 64), pin.replace("a" * 64, "b" * 64))
    expect(failures, "diff line", changed("openssl: 3.5.1 → 3.5.2, +4.1 KiB"), "3.5.1 → 3.5.2")
    expect(failures, "coloured size dropped", changed(ANSI.sub("", "libgcrypt: 1.12.2 → 1.12.4, \x1b[31;1m+9.6 KiB\x1b[0m")),
           "1.12.2 → 1.12.4")
    expect(failures, "size-only line ignored", DIFF_LINE.match("openssl: +4.1 KiB"), None)


def check_body(failures: List[str]) -> None:
    """A taken bump reaches the pull request's body, with the reason the package is pinned."""
    bump = MongodbBump("mongodb", "infra/mongodb.nix", "8.3.11", "8.3.13", None, "Pinned ahead.", [], "checked")
    upgrade = Upgrade(PinnedUpgrades(bumped=[bump]), {}, {}, [], [], [], ["mongo-1"], {}, {}, "")
    body = pull_request_body(upgrade)
    expect(failures, "body names the pinned package", "Why <code>mongodb</code> is pinned" in body and "> Pinned ahead." in body, True)


def check_real_files(failures: List[str]) -> None:
    """The real files keep the shape the weekly run rewrites, so a file reshaped by hand fails here (on every push, via
    scripts/run-script-tests) rather than on next Monday's run."""
    try:
        current, _ = mongodb_shape((REPO / MONGODB_FILE).read_text())
        header_comment((REPO / MONGODB_FILE).read_text(), MONGODB_VERSION_LINE)
        for p in MONGODB_TAG_FILES:
            try:
                moved = rewrite_tags((ROOT / p).read_text(), current, "0.0.0")
                if p == PINNED_IMAGES:
                    rewrite_pinned_digest(moved, "0.0.0", "sha256:" + "0" * 64)
            except ValueError as e:
                failures.append(f"{p}: {e}")
    except ValueError as e:
        failures.append(f"infra/{MONGODB_FILE}: {e}")


def self_test():
    failures: List[str] = []
    for check in (check_choice, check_mongodb_rewrites, check_pins_and_diffs, check_body, check_real_files):
        check(failures)
    for f in failures:
        print(f"FAIL {f}")
    print(f"{'FAILED' if failures else 'ok'}: self-test, {len(failures)} failure(s)")
    return 1 if failures else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--self-test", action="store_true")
    ap.add_argument("--old", type=pathlib.Path, help="the flake root (infra/) of the same tree, not upgraded")
    ap.add_argument("--out", type=pathlib.Path, help="where changes.patch, title, body.md, summary.md go")
    args = ap.parse_args()
    if args.self_test:
        return self_test()
    if not args.old or not args.out:
        ap.error("--old and --out are required")
    args.out.mkdir(parents=True, exist_ok=True)
    try:
        nix_path.put_nix_on_path()
    except nix_path.NixNotFound as exc:
        print(exc, file=sys.stderr)
        return 2
    return update(args.old.resolve(), args.out)


if __name__ == "__main__":
    sys.exit(main())
