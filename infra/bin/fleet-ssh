#!/usr/bin/env python3
"""Reach any host this flake declares, at the address `fleet_hosts.py` gives it -- as YOURSELF,
never as `nixdeploy`.

WHY THIS EXISTS, and the incident that named it: see `fleet_hosts.py`'s module docstring. That
module answers WHERE a host is; this one answers WHO you arrive as and WHAT to try once you're
there, which is the rest of the same wrong turn.

  fleet-ssh monitoring-1              # ssh in as SSH_USER, or your own login
  fleet-ssh monitoring-1 systemctl status prometheus.service   # a remote command, like plain ssh
  fleet-ssh --ssh-config              # write every host into ~/.ssh/config once, so a bare
                                       # `ssh monitoring-1` needs no wrapper and no evaluation

NEVER `nixdeploy`. That account's key is a forced command (`command="...",restrict` --
nix/files/nix-stage-endpoint.sh) that can receive and pin a signed closure and nothing else; it
has no sudo and cannot give a person a shell. `bin/stage-nixos-closures` draws the identical
distinction (`target` vs `admin_target`) for the same reason on the CI side. `login()` below
falls back to your own account, never to that one.
"""

import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fleet_hosts

SSH_CONFIG_BEGIN = "# BEGIN fleet-ssh (generated by infra/bin/fleet-ssh --ssh-config -- edits here are overwritten)"
SSH_CONFIG_END = "# END fleet-ssh"

# Real per-host services worth trying once you're on the box -- read off nix/modules/roles/*.nix
# and nix/modules/fleet/default.nix, not guessed. Keep this in step with those files, not the
# other way round.
SERVICES = {
    "monitoring-1": [("prometheus", 9090), ("alertmanager", 9093), ("grafana", 3000)],
    "mongo-1":       [("mongod", 27017), ("mongodb_exporter", 9216)],
}
# Every host in the fleet runs this one (fleet.nodeExporterPort's own default -- see
# nix/modules/fleet/default.nix).
NODE_EXPORTER_PORT = 9100


def login(env):
    """Who a PERSON arrives as: `SSH_USER` if set, else the local account -- and never
    `nixdeploy`, which this never falls back to because it isn't a usable shell login at all."""
    return env.get("SSH_USER", "").strip() or env.get("USER", "").strip()


def ssh_config(fleet, login):
    """One `~/.ssh/config` block naming every declared host by its PUBLIC address, so a bare
    `ssh <host>` needs no wrapper and no `nix eval`.

    NO ProxyJump, ON PURPOSE. These hosts sit on their own public IPs and need no jump at all --
    the wrong turn this whole file is about was reaching for exactly that (`fleet-jump`, a real,
    resolving host that belongs to an ENTIRELY DIFFERENT fleet and does not route this one's
    10.20.0.0/16), which fails at the second hop looking exactly like the target being down."""
    lines = [SSH_CONFIG_BEGIN]
    for host in sorted(fleet):
        lines.append(f"Host {host}")
        lines.append(f"    HostName {fleet[host]}")
        lines.append(f"    User {login}")
    lines.append(SSH_CONFIG_END)
    return "\n".join(lines) + "\n"


def service_hint(host, private_address):
    """What's worth trying once you're on `host`, addressed at its PRIVATE ip -- never localhost.
    Prometheus and Grafana both bind `fleet.privateAddress` (roles/prometheus.nix,
    roles/grafana.nix), so a habit of `curl localhost:PORT` returns nothing and reads exactly
    like the service being down rather than merely being asked at the wrong address."""
    known = SERVICES.get(host, [])
    if not known:
        return ""
    lines = [f"services on {host}, at its private address (never localhost):"]
    for name, port in known:
        lines.append(f"  {name:<18} {private_address}:{port}")
    return "\n".join(lines)


def install_ssh_config(block, path=None):
    """Write `block` into `~/.ssh/config`, replacing a block this command wrote before rather
    than piling up a duplicate on every run -- everything outside the markers is a human's own
    config and is left exactly as it was."""
    path = path or os.path.expanduser("~/.ssh/config")
    existing = ""
    if os.path.exists(path):
        with open(path) as f:
            existing = f.read()
    marked = re.compile(re.escape(SSH_CONFIG_BEGIN) + r".*?" + re.escape(SSH_CONFIG_END) + r"\n?",
                         re.DOTALL)
    if marked.search(existing):
        updated = marked.sub(block.rstrip("\n"), existing)
    else:
        sep = "\n" if existing and not existing.endswith("\n") else ""
        updated = existing + sep + block
    with open(path, "w") as f:
        f.write(updated)
    return path


def write_ssh_config(flake):
    names, error = flake.hosts()
    if error:
        print(f"could not read this flake's hosts, so nothing was written: {error}")
        return 2
    addresses = {}
    for name in names:
        address, error = flake.address_of(name)
        if error or not address:
            print(f"skipping {name}: {error or 'fleet.publicAddress is empty'}")
            continue
        addresses[name] = address
    if not addresses:
        print("no host had an address to write, so ~/.ssh/config is untouched")
        return 1
    who = login(os.environ)
    if not who:
        print("no login to write -- set SSH_USER, or run this as yourself rather than root")
        return 2
    path = install_ssh_config(ssh_config(addresses, who))
    print(f"wrote {len(addresses)} host(s) to {path}. `ssh <host>` now needs no wrapper.")
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "--ssh-config":
        return write_ssh_config(fleet_hosts.Flake())

    if not args:
        print(__doc__.strip().splitlines()[0])
        print("\nusage: fleet-ssh <host> [remote command...]")
        print("       fleet-ssh --ssh-config")
        return 2

    name = args[0]
    flake = fleet_hosts.Flake()
    address, error = fleet_hosts.resolve(name, flake)
    if error:
        print(error)
        return 2

    private_address, private_error = flake.private_address_of(name)
    if not private_error:
        hint = service_hint(name, private_address)
        if hint:
            print(hint, file=sys.stderr)

    who = login(os.environ)
    target = f"{who}@{address}" if who else address
    return subprocess.call(["ssh", target] + args[1:])


if __name__ == "__main__":
    sys.exit(main())
