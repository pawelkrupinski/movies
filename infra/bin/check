#!/usr/bin/env bash
# THE GATE FOR infra/. Everything this tree can be verified for without touching a live machine.
#
# It is the closest thing this directory has to a test suite, and it is genuinely load-bearing
# rather than ceremonial: a NixOS fleet's failure mode is that a mistake is invisible until
# activation, ON the host, AFTER the closure has been built and copied. Every check below moves one
# class of that failure earlier -- to a laptop, before anything is deployed.
#
#   terraform fmt      formatting, so a diff is about intent
#   terraform validate provider schemas and references
#   dashboard tests    the provisioned Grafana JSON -- structure, and the host/job/mountpoint
#                      literals its queries pin, against the fleet that has to produce them
#   nix eval           EVERY host's toplevel derivation. This is the expensive one and the one that
#                      matters: it type-checks the whole module tree, runs every `assertions` entry,
#                      and proves each host would build. A module that references a missing option
#                      or an unset secret fails here rather than at 03:00 on the auto-apply timer.
#   alert rule tests   the alerting rules, fed a series and asked what they do -- the question
#                      `promtool check rules` does not ask and Prometheus never asks at all.
#   reboot-required    the decision behind `nixos_reboot_required`, whose only other test is to
#                      reboot a machine and read a metric afterwards -- which is how it stayed
#                      wrong.
#   replica-set origin WHICH hosts may CREATE the replica set. `nix eval` proves each host builds;
#                      it cannot notice that two of them would both build a unit that calls
#                      `rs.initiate()`, which is a silent, data-losing mistake rather than a broken
#                      closure.
#
# It deliberately does NOT run `terraform plan` -- that needs a Hetzner token and network, and this
# has to stay runnable offline in CI on a fork.
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here/.."

nix_flags=(--extra-experimental-features 'nix-command flakes')
hosts=(mongo-1 monitoring-1 k3s-worker-1)
failed=0

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

step "terraform fmt"
if terraform fmt -check -recursive terraform; then
  echo "  ok"
else
  echo "  FAILED -- run: terraform fmt -recursive infra/terraform"
  failed=1
fi

step "terraform validate"
# `-backend=false` so this needs no Terraform Cloud credentials: validate checks the configuration,
# not the state, and requiring a login here would make the gate unrunnable in CI.
if terraform -chdir=terraform init -backend=false -input=false >/dev/null 2>&1 &&
  terraform -chdir=terraform validate; then
  echo "  ok"
else
  echo "  FAILED"
  failed=1
fi

step "python + plist syntax"
# THE DASHBOARD IS NOT COVERED BY ANY OTHER CHECK HERE -- it is plain Python outside the flake, so
# `nix eval` never looks at it and a syntax error would only surface when launchd failed to start
# it, which looks like a crash loop rather than a typo.
#
# The plist check earns its place separately: XML FORBIDS A DOUBLE HYPHEN INSIDE A COMMENT, and the
# first version of that file used them as dashes in prose. launchctl rejects the whole file as
# malformed, so the agent simply never runs -- and nothing else in this repository would have said
# so.
syntax_ok=1
if [ -f version-dashboard/app.py ]; then
  if python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' version-dashboard/app.py; then
    echo "  ok  version-dashboard/app.py"
  else
    echo "  FAILED version-dashboard/app.py"
    syntax_ok=0
  fi
fi
for plist in version-dashboard/*.plist; do
  [ -e "$plist" ] || continue
  if python3 -c 'import plistlib,sys; plistlib.load(open(sys.argv[1],"rb"))' "$plist"; then
    echo "  ok  $plist"
  else
    echo "  FAILED $plist (XML forbids -- inside a comment; that is the usual cause)"
    syntax_ok=0
  fi
done
((syntax_ok)) || failed=1

step "version-dashboard render tests"
# THE RENDER IS THE PART THAT CAN BE WRONG WITHOUT CRASHING. `ast.parse` above proves the file
# loads; these prove the table still says what an operator reads it for -- which columns exist, and
# that a machine nobody can reach is not rendered as one that is merely behind.
if [ -f version-dashboard/test_app.py ]; then
  if out="$(python3 version-dashboard/test_app.py 2>&1)"; then
    echo "  ok  $(echo "$out" | grep -c '\.\.\. ok') test(s)"
  else
    echo "$out" | tail -25 | sed 's/^/  /'
    failed=1
  fi
fi

step "grafana dashboard tests"
# THE PROVISIONED DASHBOARDS ARE OTHERWISE UNCHECKED BY EVERYTHING ABOVE. `nix eval` type-checks
# the module that COPIES nix/files/monitoring/grafana into the store; it never opens the JSON
# inside. Grafana's own reaction to a malformed dashboard is a log line at startup and a page that
# is quietly missing -- so the whole class fails silently, and is found by somebody opening the page
# during an incident. These tests are structural (duplicate panel ids, overlapping tiles, an empty
# query, a datasource uid nothing provisions) plus the three literals a panel filters on that are
# DEFINED SOMEWHERE ELSE IN THIS TREE -- host, job and mountpoint. A typo in any of those is not an
# error: Prometheus returns nothing and the panel draws "No data", which is indistinguishable from
# a subject that is genuinely quiet.
if [ -f test/test_dashboards.py ]; then
  if out="$(python3 test/test_dashboards.py 2>&1)"; then
    echo "  ok  $(echo "$out" | grep -c '\.\.\. ok') test(s)"
  else
    echo "$out" | tail -25 | sed 's/^/  /'
    failed=1
  fi
fi

step "alerting rule tests"
# PROMETHEUS IS THE ONLY THING THAT EVER READ THESE FILES, and it reads them for syntax. An
# expression that parses and means the opposite of its name loads without complaint and pages
# forever: `MongodNoPrimary` was `max(state == 1) or vector(0)`, which returns a sample -- and
# therefore FIRES -- exactly when a member IS primary. It called a healthy database leaderless for
# as long as it existed, and could only have gone quiet during the outage it was written for.
# test/alert-rules/ feeds each rule a series and asserts what it does. See test_alert_rules.sh.
if [ -f test/test_alert_rules.sh ]; then
  if out="$(bash test/test_alert_rules.sh 2>&1)"; then
    echo "$out"
  else
    echo "$out"
    failed=1
  fi
else
  echo "  FAILED test/test_alert_rules.sh is missing"
  failed=1
fi

step "public proxy behaviour"
# THE ONE MODULE HERE WHOSE OUTPUT IS A REQUEST-MATCHING DECISION, and `nix eval` cannot ask it
# anything. The facet throttle sits one character away from the film pages (`/{city}/movies` vs
# `/{city}/movie/{slug}`) and one user-agent away from Meta's share-preview crawler; getting either
# wrong de-indexes the content or breaks every link card, and both read as a config that evaluates
# fine. test_public_proxy.sh renders the real vhost and asks the real Caddy. See it for the four
# ways this goes quietly wrong.
if [ -f test/test_public_proxy.sh ]; then
  if out="$(bash test/test_public_proxy.sh 2>&1)"; then
    echo "$out"
  else
    echo "$out"
    failed=1
  fi
else
  echo "  FAILED test/test_public_proxy.sh is missing"
  failed=1
fi

step "version-dashboard browser tests"
# THE QUEUE IN bringAllToLatest IS NOT REACHABLE FROM PYTHON. Whether the bulk run really stops
# taking new machines after a failure, and whether the production database's typed confirmation is
# actually carried into the switch it authorises, are facts about a running browser -- so they are
# checked in one. Skips itself when Playwright is not installed, which keeps this gate runnable
# offline on a fork; the step then says so rather than passing silently.
if [ -f version-dashboard/test_browser.js ] && command -v node >/dev/null 2>&1; then
  if out="$(node version-dashboard/test_browser.js 2>&1)"; then
    echo "$out" | tail -3 | sed 's/^/  /'
  else
    echo "$out" | tail -30 | sed 's/^/  /'
    failed=1
  fi
else
  echo "  skipped: no node on PATH"
fi

for host in "${hosts[@]}"; do
  step "nix eval $host"
  if out="$(nix "${nix_flags[@]}" eval ".#nixosConfigurations.$host.config.system.build.toplevel.drvPath" 2>&1)"; then
    echo "  ok  ${out##*/}"
  else
    echo "$out" | tail -20 | sed 's/^/  /'
    failed=1
  fi
done

step "reboot-required decision"
# THE ONE PIECE OF FLEET LOGIC WHOSE OTHER TEST IS "REBOOT A MACHINE AND LOOK". It decides
# `nixos_reboot_required`, which is what the dashboard turns into "reboot owed" -- and it was wrong
# for as long as it lived inline in an activation script, reporting that a reboot was owed on every
# host from the moment it booted. See nix/files/reboot-required.sh.
if [ -f test/test_reboot_required.sh ]; then
  if out="$(bash test/test_reboot_required.sh 2>&1)"; then
    echo "$out" | tail -1 | sed 's/^/  /'
  else
    echo "$out" | sed 's/^/  /'
    failed=1
  fi
else
  echo "  FAILED test/test_reboot_required.sh is missing"
  failed=1
fi

step "systemd key placement"
# SYSTEMD IGNORES A KEY IT DOES NOT RECOGNISE, WHICH IS WHY THIS NEEDS CHECKING AT ALL.
#
# `StartLimitIntervalSec` and `StartLimitBurst` are `[Unit]` directives. Written under
# `serviceConfig` they are rendered into `[Service]`, where systemd logs
# `Unknown key 'startLimitBurst' in section [Service], ignoring` and quietly applies the DEFAULT
# limit instead. Nothing fails: the unit starts, runs and looks perfect -- the protection the author
# wrote simply is not there. mongodb-exporter carried exactly that for as long as the role existed,
# and it was found by reading the journal for an unrelated reason.
#
# `nix eval` cannot catch it, because both spellings are valid Nix and produce a valid unit. Only
# the SECTION is wrong, so this asks each host's built units where these keys actually landed.
placement_bad=()
for host in "${hosts[@]}"; do
  offenders="$(nix "${nix_flags[@]}" eval --raw \
    ".#nixosConfigurations.$host.config.systemd.services" \
    --apply 'svcs:
       let bad = builtins.filter (n:
             let sc = (svcs.${n}.serviceConfig or {}); in
             sc ? StartLimitIntervalSec || sc ? StartLimitBurst
             || sc ? startLimitIntervalSec || sc ? startLimitBurst)
           (builtins.attrNames svcs);
       in builtins.concatStringsSep " " bad' 2>/dev/null)" || offenders="EVALFAIL"
  if [ "$offenders" = "EVALFAIL" ]; then
    echo "  FAILED could not evaluate $host (see its nix eval step above)"
    failed=1
  elif [ -n "$offenders" ]; then
    placement_bad+=("$host: $offenders")
  fi
done

if [ "${#placement_bad[@]}" -eq 0 ]; then
  echo "  ok  no StartLimit* directives are hidden in a [Service] section"
else
  echo "  FAILED StartLimit* under serviceConfig, where systemd ignores it:"
  printf '           %s\n' "${placement_bad[@]}"
  echo "         Move them to the unit level (beside wantedBy), not into serviceConfig."
  failed=1
fi

step "replica-set origin"
# EXACTLY ONE HOST MAY CREATE THE REPLICA SET, and nothing else in this gate can see a violation.
#
# roles/mongodb.nix ships `mongodb-init-replicaset`, which reacts to `NotYetInitialized` by calling
# `rs.initiate()`. An EMPTY dbPath answers `NotYetInitialized` too -- so a second mongo host built to
# JOIN the existing set will instead give itself its own one-member set with the same name, its own
# history, and no relationship to the real one. Both machines then report a healthy `rs0` with
# themselves as PRIMARY and every unit stays green; the only symptom is that the real primary's
# `rs.add()` fails talking about configuration versions.
#
# `nix eval` above cannot catch it: both hosts BUILD perfectly. The mistake is in which of them
# carries the unit, so that is what this asserts -- against the built config, not against the source,
# so it stays true however `fleet.mongodb.initiateReplicaSet` is defaulted or overridden later.
origin_hosts=()
origin_unevaluated=()
for host in "${hosts[@]}"; do
  # AN EVALUATION FAILURE IS NOT AN ANSWER, and conflating the two is how this check first passed
  # for the wrong reason: mongo-2 could not evaluate (its files were untracked, so the flake could
  # not see them), the eval failed, `|| has_unit="no"` turned that into "carries no initiator", and
  # the step reported exactly one origin host and went green. A test that answers "no" when it means
  # "I could not look" is worse than no test.
  if has_unit="$(nix "${nix_flags[@]}" eval --raw \
       ".#nixosConfigurations.$host.config.systemd.services" \
       --apply 'svcs: if svcs ? mongodb-init-replicaset then "yes" else "no"' 2>/dev/null)"; then
    [ "$has_unit" = "yes" ] && origin_hosts+=("$host")
  else
    origin_unevaluated+=("$host")
  fi
done

if [ "${#origin_unevaluated[@]}" -ne 0 ]; then
  echo "  FAILED could not evaluate: ${origin_unevaluated[*]}"
  echo "         The nix eval steps above say why. Until every host evaluates, this check cannot"
  echo "         know which of them would initiate the replica set."
  failed=1
fi

if [ "${#origin_hosts[@]}" -eq 1 ]; then
  echo "  ok  only ${origin_hosts[0]} may initiate the replica set"
elif [ "${#origin_hosts[@]}" -eq 0 ]; then
  echo "  FAILED no host would initiate the replica set."
  echo "         A fleet built from scratch would come up with mongod running and no set at all,"
  echo "         so the app's change streams -- which need an oplog -- would never work."
  echo "         Exactly one mongo host needs fleet.mongodb.initiateReplicaSet = true."
  failed=1
else
  echo "  FAILED ${#origin_hosts[@]} hosts would each CREATE their own replica set:"
  printf '           %s\n' "${origin_hosts[@]}"
  echo "         Set fleet.mongodb.initiateReplicaSet = false on every host that JOINS an existing"
  echo "         set and let the current primary add it -- see"
  echo "         infra/ansible/playbooks/migrate-mongo-replica.yml."
  failed=1
fi

if ((failed)); then
  printf '\n\033[1;31minfra/bin/check: FAILED\033[0m\n'
else
  printf '\n\033[1;32minfra/bin/check: all green\033[0m\n'
fi
exit "$failed"
