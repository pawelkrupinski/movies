{
  "name": "kinowo-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "once": "tsx src/once.ts",
    "dev": "KINOWO_DASHBOARD_PORT=8789 tsx watch src/server.ts",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json && oxlint --type-aware --deny-warnings",
    "restart": "sh scripts/service.sh restart",
    "service": "sh scripts/service.sh"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
