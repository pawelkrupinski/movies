{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "node_modules/**"
  ],
  "rules": {
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-duplicate-imports": "error"
  }
}
