<?xml version="1.0" encoding="UTF-8"?>
<!--
  Keeps the NixOS fleet dashboard running on http://127.0.0.1:8788/nixos.

  MODELLED ON ~/bitcashier/version-dashboard/com.kinowo.version-dashboard.plist, with one
  difference that matters: the PORT. That dashboard holds 8787 on this workstation, and two agents
  racing for one port means whichever loses exits and launchd retries it for ever -- quietly, since
  a bind failure looks like a crash. Different estate, different port.

  PATH IS SET EXPLICITLY because launchd does not read a login shell's profile. app.py shells out to
  `nix` (for the flake roster), `git` (for "behind main") and `ssh` (to reach the fleet's Prometheus,
  which binds a private address). Without /nix/var/nix/profiles/default/bin on PATH the roster query
  fails and every row renders as "not reporting" -- a page that looks like a fleet-wide outage but
  is really a missing binary.

  Install:
    cp infra/version-dashboard/com.kinowo.nixos-dashboard.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kinowo.nixos-dashboard.plist
  Reload after editing:
    launchctl kickstart -k gui/$(id -u)/com.kinowo.nixos-dashboard
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kinowo.nixos-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/pawel/projects/movies/infra/version-dashboard/app.py</string>
  </array>

  <!-- Runs from the dashboard's own directory; app.py resolves the flake as its parent, so a
       different cwd would make `nix eval` run against whatever tree launchd happened to start in. -->
  <key>WorkingDirectory</key>
  <string>/Users/pawel/projects/movies/infra/version-dashboard</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- The process is meant to be up whenever the laptop is. It holds no state, so restarting it
       costs one cache rebuild. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/kinowo-nixos-dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/kinowo-nixos-dashboard.log</string>
</dict>
</plist>
