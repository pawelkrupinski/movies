# IS THE AGREEMENT STAGE KEEPING UP, AND IS IT STILL AS CHEAP AS IT WAS? -- the identity projection's agreement
# phase (services.identity.agreement.AgreementStage), and the staging publisher beside it.
#
#   - `kinowo_worker_identity_agreement_clusters{state}` -- clusters by agreement state, as the last stage run left
#     them; `incomplete` is a cluster whose verdict is still to be read, the backfill's backlog.
#   - `kinowo_worker_identity_agreement_phase_seconds{mode}` / `..._allocated_bytes{mode}` -- every projection's
#     agreement phase, by projection mode (periodic, whole, changed): the "agreement 69.1s/9579MB" of its
#     `identity projection:` log line, as histograms.
#   - `kinowo_worker_identity_staging_dropped_total` -- staging events the publisher let go unwritten.
#   - `kinowo_worker_identity_model_held_listings` / `..._held_oldest_seconds` -- the identity model's input gate
#     (docs/design/identity-structural-fixes.md, fix 1): listings whose newest version waits on its own questions,
#     and how long the oldest has waited. No replay runs the gate, so only these see it stuck.
#   - `kinowo_worker_identity_model_kept_listings` / `..._present_listings` -- the departed listings the model keeps as
#     inputs beside the billed ones (docs/design/identity-listing-retention.md): the retention window's cost.
#   - `kinowo_worker_identity_projection_seconds` -- the last identity projection's wall clock.
groups:
  - name: identity-agreement-recorded
    rules:
      # Each hour's median agreement phase per country and mode: what the regressions below compare with its own
      # week, read back through `quantile_over_time` (a histogram's quantile cannot be taken over 7 days of buckets
      # directly without summing a week of rates at every evaluation).
      - record: kinowo:identity_agreement_phase_seconds:p50_1h
        expr: histogram_quantile(0.5, sum by (country, mode, le) (rate(kinowo_worker_identity_agreement_phase_seconds_bucket[1h])))
      - record: kinowo:identity_agreement_phase_allocated_bytes:p50_1h
        expr: histogram_quantile(0.5, sum by (country, mode, le) (rate(kinowo_worker_identity_agreement_phase_allocated_bytes_bucket[1h])))

  - name: identity-agreement
    rules:
      # THE BACKFILL HAS LEFT CLUSTERS INCOMPLETE FOR SIX HOURS. A healthy backlog drains within a few projections;
      # one that never reaches 0 is a stage reading nothing (an answer store refusing, a budget spent every time).
      # `last_over_time(...[10m])` bridges a worker restart's scrape gap, which would otherwise reset the hold.
      - alert: IdentityAgreementBackfillStalled
        expr: max by (country) (last_over_time(kinowo_worker_identity_agreement_clusters{state="incomplete"}[10m])) > 0
        for: 6h
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: {{ $value }} agreement clusters have stayed incomplete for 6 hours"
          description: >-
            The agreement stage has had clusters with unread verdicts for six hours without draining them. Its
            per-projection progress is in VictoriaLogs `country:<cc> "agreement"`; the worker diagnostics
            dashboard draws the clusters by state.

      # THE MODEL'S INPUT GATE IS STUCK. A held listing waits on its own family questions and venue page, asked ahead of
      # the agreement's queue: seconds to minutes. One held over an hour, or more than 1,000 held at once (a day's
      # arrivals in DE), is an ask that never concludes or a queue not served -- listings shown on their old version,
      # or on their own card Pending, for as long as it lasts. `max_over_time(...[10m])` bridges a restart's gap and skips
      # the NaN a restart seeds these gauges with until the gate first measures them.
      - alert: IdentityInputGateStuck
        expr: |
          max by (country) (max_over_time(kinowo_worker_identity_model_held_oldest_seconds[10m])) > 3600
          or
          max by (country) (max_over_time(kinowo_worker_identity_model_held_listings[10m])) > 1000
        for: 15m
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: the identity model's input gate holds listings too long or too many ({{ $value }})"
          description: >-
            Listings whose newest version waits on its own questions are held over an hour, or over a thousand are
            held. Their questions are AskQuestion tasks claimed at 0 and venue-page reads; the worker diagnostics
            dashboard's "Identity input gate" panel draws the held count, the oldest wait and the promotions. The
            one switch: IdentityModelService.NewWhilePending.

      # THE KEPT LISTINGS OUTNUMBER THE BILLED ONES. A departed listing stays an input while a billed one relates to it by
      # title (ListingRetention), up to the retention window: measured 2026-11-07, DE kept 830 more listings per day of
      # departures (+23% of the 32.5k billed after 9 days), so the window's cost grows with the store's history. Past 1x
      # the billed set the resolve reads twice its population: look at the window before raising it, or lower it. Read
      # through max/min_over_time, which skip a restart's NaN seed, so the hour's hold bridges a restart.
      - alert: IdentityKeptListingsHigh
        expr: |
          max by (country) (max_over_time(kinowo_worker_identity_model_kept_listings[15m]))
            > max by (country) (min_over_time(kinowo_worker_identity_model_present_listings[15m]))
        for: 1h
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: the identity model keeps {{ $value }} departed listings, more than it bills"
          description: >-
            The departed listings kept as identity inputs (ListingRetention, identity_retained) outnumber the billed
            ones, so every family's resolve reads at least twice its population. The window is ListingRetention's
            grace (docs/design/identity-listing-retention.md); the worker diagnostics dashboard draws kept, departed and
            billed listings beside the projection's seconds.

      # THE PROJECTION TAKES A QUARTER LONGER THAN A WEEK AGO. The last six hours' mean wall clock against the same six
      # hours a week before, above 30 s (a scoped projection takes seconds: a quarter of that is noise). What a growing
      # kept set costs shows here first; a deploy that slows the resolver too. Not in the hour after a worker start.
      - alert: IdentityProjectionSlower
        expr: |
          (
            avg by (country) (avg_over_time(kinowo_worker_identity_projection_seconds[6h]))
              > 1.25 * avg by (country) (avg_over_time(kinowo_worker_identity_projection_seconds[6h] offset 7d))
            and
            avg by (country) (avg_over_time(kinowo_worker_identity_projection_seconds[6h])) > 30
          )
          unless on (country)
          (time() - max by (country) (last_over_time(process_start_time_seconds{job="kinowo-worker"}[10m]))) < 3600
        for: 1h
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: identity projections average {{ $value | humanizeDuration }} over 6h, a quarter slower than a week ago"
          description: >-
            The identity projection's mean wall clock over the last six hours is over 1.25x the same window a week ago.
            Compare kinowo_worker_identity_model_kept_listings with the billed listings (a longer retention window
            costs resolve time), then the builds deployed between: VictoriaLogs `country:<cc> "identity projection:"`.

      # THE AGREEMENT PHASE COSTS TWICE ITS WEEK. The hour's median wall clock above twice the week's median of that
      # hourly median, and above 20 s (a scoped projection's phase is about a second: doubling it is noise). Not in
      # the hour after a worker start: a deploy's first projection is a whole one and runs cold. The 10-minute hold
      # also lets that projection's sample leave the 1h window before anything can fire.
      - alert: IdentityAgreementCostRegression
        expr: |
          (
            kinowo:identity_agreement_phase_seconds:p50_1h
              > 2 * quantile_over_time(0.5, kinowo:identity_agreement_phase_seconds:p50_1h[7d])
            and
            kinowo:identity_agreement_phase_seconds:p50_1h > 20
          )
          unless on (country)
          (time() - max by (country) (last_over_time(process_start_time_seconds{job="kinowo-worker"}[10m]))) < 3600
        for: 10m
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: the {{ $labels.mode }} agreement phase's hourly median is {{ $value | humanizeDuration }}, over twice its week"
          description: >-
            The identity projection's agreement phase has doubled its weekly median. Find the build and the
            projections: VictoriaLogs `country:<cc> "identity projection:"`, whose phase list names each phase's
            seconds and MB; the worker diagnostics dashboard draws the hour against the week.

      # THE SAME, FOR WHAT IT ALLOCATES: steadier than the wall clock, which CPU contention on the node moves, and the
      # first to show a change that copies a corpus per verdict. Floor 2 GB.
      - alert: IdentityAgreementAllocationRegression
        expr: |
          (
            kinowo:identity_agreement_phase_allocated_bytes:p50_1h
              > 2 * quantile_over_time(0.5, kinowo:identity_agreement_phase_allocated_bytes:p50_1h[7d])
            and
            kinowo:identity_agreement_phase_allocated_bytes:p50_1h > 2e9
          )
          unless on (country)
          (time() - max by (country) (last_over_time(process_start_time_seconds{job="kinowo-worker"}[10m]))) < 3600
        for: 10m
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: the {{ $labels.mode }} agreement phase's hourly median allocation is {{ $value | humanize }}B, over twice its week"
          description: >-
            The identity projection's agreement phase allocates twice its weekly median. VictoriaLogs
            `country:<cc> "identity projection:"` names each projection's phases with their MB; compare the
            build before and after.

      # A STAGING EVENT WAS DROPPED. The staging publisher let a take change or a wait go unwritten: the local
      # /debug/identity/staging page misses it. Zero always; the counter is seeded at 0 per country.
      - alert: IdentityStagingEventsDropped
        expr: sum by (country) (increase(kinowo_worker_identity_staging_dropped_total[30m])) > 0
        labels:
          severity: warning
          domain: identity
        annotations:
          summary: "{{ $labels.country }}: the identity staging publisher dropped events"
          description: >-
            Identity staging events (take changes, waits) were let go before a publish wrote them -- the feed let
            them go, or publishes kept failing -- so the staging screen misses them. VictoriaLogs
            `country:<cc> "identity staging"` has the WARN line per drop and the failed publishes before it.
