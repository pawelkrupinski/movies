# GENERATED by infra/test/app_metrics_absent.py from the alerting rules beside it -- do not edit by hand.
# Re-run `python3 infra/test/app_metrics_absent.py --write` after adding or changing an alert over an
# application metric; test_alert_rule_coverage.py fails until this file matches.
groups:
- name: app-metrics-absent
  rules:
  - alert: AppMetricAbsent
    expr: |-
      max by (country) (up{job="kinowo-web"} == 1)
      unless on (country)
      count by (country) (kinowo_uptime_recent_failures)
    for: 15m
    labels:
      severity: warning
      metric: kinowo_uptime_recent_failures
    annotations:
      summary: '{{ $labels.country }}''s web is up but publishes no kinowo_uptime_recent_failures'
      description: 'The web answers its scrape (`up`) but has published no kinowo_uptime_recent_failures series for this country
        for 15m. Every web metric family exists from boot, so this is a fault, not a quiet day: the family was unwired, renamed,
        or the class that writes it is no longer built. Until it is back these alerts read nothing and cannot fire: cinema-scrape.rules
        ChainEnrichmentFailing, cinema-scrape.rules CinemaScrapeFailureShareHigh, residential-proxy.rules ResidentialProxyFailing.'
  - alert: AppMetricAbsent
    expr: |-
      max by (country) (up{job="kinowo-web"} == 1)
