            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Design rules: the effects, stacked by kind",
      "description": "Modules touching an injected effect outside its adapter, stacked: effect-clock-process-env is ONE row a module for those three (design-baseline.tsv does not split them), effect-files / -storage / -network one row each. Falls as modules receive them instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
