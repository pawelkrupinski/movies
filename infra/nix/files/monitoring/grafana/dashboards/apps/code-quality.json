      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          },
          "expr": "sum by (repo, measure) (last_over_time(kinowo_quality_rows{repo=~\"$repo\", language=\"$language\", family=\"design\", measure=~\"effect-.*\"}[7d]))",
          "legendFormat": "{{repo}} {{measure}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
