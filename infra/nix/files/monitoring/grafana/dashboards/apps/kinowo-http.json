{
  "uid": "kinowo-http",
  "title": "Kinowo \u2014 HTTP (requests & round trips)",
  "description": "Request rate, response time and outbound fetch health, from the applications' OWN metrics. This replaces what Fly's managed Prometheus used to give (fly_app_http_response_time, fly_edge_*): those tokens are revoked and unmintable, and the app's own numbers are better -- they measure the work rather than the edge, and they keep working off Fly. NOTE the inbound half is NOT scoped by $country, which applies to the OUTBOUND half only. It was written when the web tier served Poland alone; there are now five web deployments (pl, uk, de, us, es) on k3s and the inbound panels sum across all of them, so read a request rate or a latency percentile here as the whole product's, not one country's.",
  "tags": [
    "kinowo",
    "http"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "country",
        "label": "country (outbound only)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "local-prometheus"
        },
        "query": {
          "query": "label_values(kinowo_worker_http_total, country)",
          "refId": "country"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Inbound \u2014 the web tier's own requests (k3s)",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "description": "The app's OWN counter, not Fly's proxy. Fly's fly_app_http_* died with the Prometheus token; this survives leaving Fly and measures the application's work rather than the edge in front of it.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kinowo_web_http_requests_total[$__rate_interval]))",
          "legendFormat": "requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p50 / p90 / p99",
      "description": "Whole-app response time from the app's histogram. Compare the spread, not the absolute: the listing pages render megabytes of HTML and sit far above the JSON endpoints, so a wide p99/p50 gap is normal here and a NARROWING one usually means the big pages stopped being served.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 16,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kinowo_web_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(kinowo_web_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p90",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kinowo_web_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests per second by route",
      "description": "Route is the matched PLAY ROUTE PATTERN, never the raw path -- /:city/movie/:slug is one series, not one per film. That is the cardinality guarantee; if you ever see a slug here, the filter's route extraction has regressed.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(kinowo_web_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 by route \u2014 which page costs the time",
      "description": "A route climbing away from ITS OWN baseline is the signal; routes are not comparable to each other. The `>= 0` guard drops NaN so a quiet window draws zero rather than \"No data\".",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, route) (rate(kinowo_web_http_request_duration_seconds_bucket[$__rate_interval]))) >= 0) or (sum by (route) (rate(kinowo_web_http_request_duration_seconds_count[$__rate_interval])) * 0)",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Stacked. A steady 4xx floor is EXPECTED and not a fault: /api/me answers 401 to every anonymous caller. 5xx is the line to care about.",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(kinowo_web_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Share of requests slower than 1s",
      "description": "The tail as a proportion, which is what a user notices. A window with no traffic at all is a GAP, not 0% \u2014 dividing by a clamped-to-epsilon denominator used to draw idle minutes as 100% slow and drag the legend mean down with them. \u00b7 THE BUCKET IS le=\"1.0\", NOT le=\"1\". The Java client writes bucket boundaries with a decimal point, so `le=\"1\"` matches NOTHING and the panel renders empty while the histogram is perfectly healthy -- a silent miss, because a label selector that matches no series is not an error. Check the real values with a /api/v1/series query before hand-writing an `le`.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(kinowo_web_http_request_duration_seconds_bucket{le=\"1.0\"}[$__rate_interval])) / (sum(rate(kinowo_web_http_request_duration_seconds_count[$__rate_interval])) > 0))",
          "legendFormat": "slower than 1s",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Outbound \u2014 the workers' own fetches (scraping & enrichment)",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Outbound fetches per second by phase and country",
      "description": "What the scrapers are actually doing to the outside world. `scrape` is cinema listings, `enrich` is TMDB/IMDb/RT/Metacritic. This is the closest thing to Fly's edge view that still exists, and it is about OUR outbound traffic rather than inbound.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (country, phase) (rate(kinowo_worker_http_total{country=~\"$country\"}[$__rate_interval]))",
          "legendFormat": "{{country}} {{phase}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbound failures per second by outcome",
      "description": "Anything that is not `success`. The outcomes worth reacting to differ: http_429 means we are being rate-limited and should slow down, timeout/connection_error usually means the far side is down, and http_403 on a site that used to work is the shape of a bot block.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(kinowo_worker_http_total{country=~\"$country\"}[$__rate_interval])) unless on (outcome) sum by (outcome) (rate(kinowo_worker_http_total{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbound success rate",
      "description": "Success as a share of all outbound fetches, per country. A window in which the worker made no request at all is a GAP, not 0% \u2014 the denominator is filtered with `> 0` so idle minutes are absent rather than fabricated. They used to be drawn as 0% success, which is what made a low-volume country like uk or us read as a ~45% mean while it was really succeeding on ~93% of the requests it actually made. A sustained dip with http_429 rising on the panel to the left means the pacing is too aggressive for a site, not that the site is broken.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (country) (rate(kinowo_worker_http_total{country=~\"$country\",outcome=\"success\"}[$__rate_interval])) / (sum by (country) (rate(kinowo_worker_http_total{country=~\"$country\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{country}}",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate-limited (429) and timeouts",
      "description": "Called out separately because these two are the ones WE cause and can fix by pacing. Everything else on the failures panel is largely the far side's problem.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (country) (rate(kinowo_worker_http_total{country=~\"$country\",outcome=\"http_429\"}[$__rate_interval]))",
          "legendFormat": "{{country}} 429",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (country) (rate(kinowo_worker_http_total{country=~\"$country\",outcome=\"timeout\"}[$__rate_interval]))",
          "legendFormat": "{{country}} timeout",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Caches \u2014 bytes held against budget",
      "description": "This tier's in-heap caches, and the reading that was missing for both of its heap incidents. The gzipped-response cache was unbounded when a crawler walking the US sitemap pinned all 55 states in a 768m heap and web-us OOM-crash-looped hourly; the share-card cache repeated it on 2026-09-04 behind a bound that counted ENTRIES over rendered images, taking web-uk's old-gen floor from 29% to 71% in two hours. The budget is plotted rather than written here so it stays right when retuned. Poland's corpus fits several times over and should sit flat well under its ceiling; the US should ride at it \u2014 a country that STARTS evicting when it never used to is a corpus that grew.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "spanNulls": 300000
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*budget.*"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byType",
              "options": "number"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kinowo_web_cache_held_bytes{country=~\"$country\"}",
          "legendFormat": "{{country}} {{cache}} held",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "kinowo_web_cache_max_bytes{country=~\"$country\"}",
          "legendFormat": "{{country}} {{cache}} budget",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "id": 14,
      "title": "Caches \u2014 entries, hit ratio and evictions",
      "description": "Entries is context for the bytes, not a bound: flat while held_bytes rides the budget is the long tail falling out. Hit ratio and evictions come only from the caches that count them \u2014 the share-card caches, where a hit is a whole card not composited again. The response cache is an access-ordered LinkedHashMap with no counters, so it has no ratio line at all rather than a zero one, which would read as a cache serving nothing.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "spanNulls": 300000
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*hit ratio.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kinowo_web_cache_entries{country=~\"$country\"}",
          "legendFormat": "{{country}} {{cache}} entries",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "kinowo_web_cache_hit_ratio{country=~\"$country\"}",
          "legendFormat": "{{country}} {{cache}} hit ratio",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "rate(kinowo_web_cache_evictions_total{country=~\"$country\"}[5m])",
          "legendFormat": "{{country}} {{cache}} evictions/sec",
          "datasource": {
            "type": "prometheus",
            "uid": "local-prometheus"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Response size on the wire",
      "description": "What visitors actually download, measured AFTER gzip, by route. The median says what a typical page costs; p95 is where the big listings live \u2014 the US, where a city is a STATE and the largest listing is 1.06 MB gzipped, is the shape that filled the response cache and OOM-crash-looped web-us hourly, so this is the series that says whether a corpus is growing into that. Only responses declaring a Content-Length are recorded: a streamed body (SSE) has none, and guessing one would be worse than the gap.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
