{
 "uid": "kinowo-ci-convergence",
 "title": "CI — identity model convergence timings",
 "tags": [
  "ci",
  "convergence"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "Where each Identity model convergence run spends its time, per country: run wall clock, every leg's job, its steps and its suite's top-level phases. From scripts/ci/ci_timings.py, pushed by the `CI timings` workflow's sweep (every 30 min) through grafana.kinowo.net's token-gated OTLP path.",
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": false,
    "iconColor": "purple",
    "name": "Deploys",
    "tags": [
     "deploy"
    ],
    "type": "tags"
   }
  ]
 },
 "links": [
  {
   "title": "GitHub Actions",
   "type": "link",
   "url": "https://github.com/pawelkrupinski/movies/actions",
   "targetBlank": true
  },
  {
   "title": "Convergence runs",
   "type": "link",
   "url": "https://github.com/pawelkrupinski/movies/actions/workflows/identity-model-convergence.yml",
   "targetBlank": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "country",
    "label": "Country",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "local-prometheus"
    },
    "definition": "label_values(kinowo_ci_job_seconds{workflow=\"Identity model convergence\"}, ci_job)",
    "query": {
     "query": "label_values(kinowo_ci_job_seconds{workflow=\"Identity model convergence\"}, ci_job)",
     "refId": "country"
    },
    "current": {
     "text": "All",
     "value": "$__all",
     "selected": true
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "hide": 0,
    "regex": "/^([a-z-]+) \\//"
   },
   {
    "name": "ref",
    "label": "Ref",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "local-prometheus"
    },
    "definition": "label_values(kinowo_ci_job_seconds, ref)",
    "query": {
     "query": "label_values(kinowo_ci_job_seconds, ref)",
     "refId": "ref"
    },
    "current": {
     "text": "main",
     "value": "main",
     "selected": true
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "gridPos": {
    "h": 3,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "One point per **Identity model convergence** run, at the run's start. **Target: every run under 10 minutes** (red band). Pushed by `CI timings` (`ci-timings.yml`) up to ~30 min after the run ends — Main dispatches this run with the GITHUB_TOKEN, so only the sweep sees it. Steps are GitHub's step timestamps; phases are the suite's top-level `PhaseTimer` lines (`[uk] bootCutover done in …`), the longest copy when several ran side by side (the order replays `[ukp0..2]`). The run's own `timings` job prints the same table in its log."
   }
  },
  {
   "id": 2,
   "title": "Run wall clock (first job start → last job end)",
   "description": "The number the 10-minute target is about. `queued` is the wait in the one-lane queue before any job started -- not counted against the target.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "local-prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 3
   },
   "interval": "1m",
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "showPoints": "always",
      "pointSize": 5,
      "lineWidth": 1,
      "fillOpacity": 0,
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "min",
      "max"
     ],
     "sortBy": "Last *",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max_over_time(kinowo_ci_run_seconds{workflow=\"Identity model convergence\",ref=~\"$ref\"}[$__interval])",
     "legendFormat": "{{measure}}",
     "datasource": {
      "type": "prometheus",
      "uid": "local-prometheus"
     }
    }
   ]
  },
  {
