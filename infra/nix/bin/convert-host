#!/usr/bin/env bash
# Convert one stock-Ubuntu Hetzner Cloud server into a NixOS host from this flake.
#
# THIS REPARTITIONS THE TARGET'S ROOT DISK AND IS IRREVERSIBLE. Everything on /dev/sda is destroyed;
# an attached Hetzner Volume is NOT touched (disko only owns the disks its layout names -- see
# nix/hosts/*/disko.nix), which is precisely why mongo-1's database lives on one.
#
# HOW IT WORKS, and why it is not bitcashier's route. bitcashier re-images onto a prebuilt
# `role=nixos-base` snapshot and then rebuilds; that snapshot lives in its Hetzner project and this
# project has none, and building one needs a Linux nix builder this estate does not have. So this
# takes bitcashier's OTHER path, the one its RUNBOOK-borg-ovh-1-nixos.md uses for bare metal: boot
# the machine into Hetzner's rescue system and let nixos-anywhere install over it. The rescue system
# is a live Linux with our SSH key already injected by the API, which is the only foothold needed --
# and it is the reason this works on a host we have NEVER been able to log into, which is the state
# all three of these machines were in (they were created without the operator's key).
#
# It is safe to re-run. A second conversion is simply another install.
#
#   infra/nix/bin/convert-host mongo-1 --yes
set -euo pipefail

host="${1:-}"
confirm="${2:-}"

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
flake_dir="$(cd "$here/../.." && pwd)"
repo_root="$(cd "$flake_dir/.." && pwd)"

# The server ids and addresses are written here rather than looked up by name, because the lookup
# and the destruction would otherwise share a failure mode: a typo that matches no server is an
# error, but a typo that matches the WRONG server silently wipes it. An explicit table cannot
# resolve to a machine nobody named.
#
# A `case` AND NOT AN ASSOCIATIVE ARRAY, WHICH IS NOT A STYLE CHOICE. macOS ships bash 3.2 (2007),
# which has no `declare -A`. It does not fail loudly either: the declaration is ignored, the
# assignment degrades to an INDEXED array, and `[mongo-1]` is then evaluated as ARITHMETIC -- so
# under `set -u` the script dies with "mongo: unbound variable", naming a variable nobody wrote.
# This ran on the operator's Mac and did exactly that. `case` works on every bash there is.
case "$host" in
  mongo-1)      id=163926647; ip=2.28.56.140 ;;
  mongo-2)      id=164241785; ip=178.105.221.61 ;;
  monitoring-1) id=164234644; ip=128.140.49.167 ;;
  k3s-worker-1) id=164234589; ip=2.28.47.31 ;;
  *)            id=""; ip="" ;;
esac

if [[ -z "$host" || -z "$id" ]]; then
  echo "usage: convert-host <mongo-1|monitoring-1|k3s-worker-1> --yes" >&2
  exit 1
fi

if [[ "$confirm" != "--yes" ]]; then
  cat >&2 <<MSG
convert-host: refusing to run without --yes.

  This will REPARTITION /dev/sda on $host ($ip, Hetzner server $id)
  and install NixOS over whatever is there. It is irreversible.

  Attached Hetzner Volumes are not touched.
MSG
  exit 1
fi

token="$(grep -E '^HETZNER_API_TOKEN=' "$repo_root/.env.local" | head -1 | cut -d= -f2- | tr -d '"'"'"' \r')"

api() {
  curl -fsS -H "Authorization: Bearer $token" -H "Content-Type: application/json" "$@"
}

# The operator SSH key, by Hetzner key id. Injected into the rescue system -- NOT into the installed
# system, which gets its keys from nix/modules/fleet/accounts.nix like every other setting.
echo "==> enabling rescue on $host ($id)"
api -X POST -d '{"type":"linux64","ssh_keys":[118066985]}' \
  "https://api.hetzner.cloud/v1/servers/$id/actions/enable_rescue" >/dev/null

# A HARD RESET, not a graceful reboot: the point is to land in rescue, and a machine that declines
# to shut down cleanly would otherwise sit in the old system indefinitely. There is nothing on these
# disks to lose -- that is the premise of the whole script.
echo "==> resetting $host into rescue"
api -X POST "https://api.hetzner.cloud/v1/servers/$id/actions/reset" >/dev/null

echo "==> waiting for the rescue system on $ip"
# The host key CHANGES when the machine boots into rescue, and changes again when it boots into the
# installed NixOS. Pinning it would mean two known-hosts edits per conversion, so this deliberately
# does not verify it -- the exposure is one SSH session to a machine we are about to overwrite
# entirely, on a connection whose only payload is a public flake.
#
# ServerAliveInterval IS NOT BELT AND BRACES HERE, it is the difference between this script failing
# and this script HANGING FOR EVER. `ConnectTimeout` bounds only the CONNECT; a session that
# establishes and then dies silently -- which is exactly what a rescue system does when it is reset
# or its network blips -- leaves ssh waiting on a socket nothing will ever answer, with no timeout
# of any kind. That happened converting mongo-2 on 2026-09-02: the `readlink -f` probe below sat
# open for eleven minutes against a machine that was up and idle, and the only symptom was a script
# that printed nothing. Three missed five-second probes and ssh gives up, which turns a hang into an
# error the retry logic can see.
ssh_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5
          -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
#
# THE TEST MUST BE ABLE TO FAIL, and the version this replaces could not. It ran
# `test -d /root && grep -qi rescue /etc/motd || true` -- and the trailing `|| true` makes the whole
# command exit 0 whatever it finds, so the loop broke on the first ssh that merely CONNECTED. The
# reset issued above is asynchronous, so that first connection is usually to the machine we are
# about to destroy, still running the old system. The loop then "succeeded" against a host that
# rebooted a moment later, and every command after it talked to a socket going away underneath it.
#
# `hostname` is the check because Hetzner's rescue system is literally called `rescue`, and unlike
# /etc/motd it cannot be matched by accident on an Ubuntu image. Waiting for the machine to BE the
# rescue system is the thing this loop was always meant to do.
#
# THREE CONSECUTIVE ANSWERS, NOT ONE, because the rescue system answers before it has finished
# coming up. Hetzner starts sshd early in the rescue boot and then carries on initialising, so a
# single successful probe is routinely followed by the connection being dropped underneath the next
# command -- which is what happened converting mongo-2 on 2026-09-02: the wait loop saw `rescue`,
# and the very next ssh died with "server not responding" against a machine that was up and would
# answer again fifteen seconds later. Requiring the answer to REPEAT is what distinguishes "sshd is
# listening" from "this machine is ready to be installed onto".
rescue_ready=0
stable=0
for _ in $(seq 1 60); do
  if [[ "$(ssh "${ssh_opts[@]}" -o BatchMode=yes "root@$ip" hostname 2>/dev/null)" == "rescue" ]]; then
    stable=$((stable + 1))
    if ((stable >= 3)); then
      rescue_ready=1
      break
    fi
  else
    # A miss RESETS the count rather than decrementing it. Two answers either side of a reboot are
    # not evidence of stability, and treating them as such is the bug this is here to avoid.
    stable=0
  fi
  sleep 5
done

if ((!rescue_ready)); then
  echo "convert-host: $ip never came up as the rescue system (waited 5 minutes)." >&2
  echo "  Check the machine in the Hetzner console; it may have booted the installed system" >&2
  echo "  instead, which means enable_rescue did not take before the reset." >&2
  exit 1
fi

# REFUSE TO INSTALL ONTO A HETZNER VOLUME. This is the guard for the failure that cost mongo-1 a
# rebuild on 2026-08-29: the host's disko layout named `/dev/sda`, an attached volume won the race
# for that name, and disko partitioned and formatted the DATABASE'S DISK while leaving the root disk
# unformatted. disko does exactly what it is told; the danger is being told the wrong disk.
#
# The layouts now name the root disk by its own serial (scsi-0QEMU_QEMU_HARDDISK_<serial>), which a
# volume can never be assigned -- volumes always present as scsi-0HC_Volume_<id>. This checks, from
# the rescue system and BEFORE anything is written, that the declared device is actually present
# there and is not a volume. Both halves matter: a device that is absent means the install would
# fail late and confusingly, and a device that resolves to a volume means it would succeed
# catastrophically.
echo "==> checking the declared root disk on $host"
declared="$(nix --extra-experimental-features 'nix-command flakes' eval --raw \
  "$flake_dir#nixosConfigurations.$host.config.disko.devices.disk.main.device")"
echo "    layout names: $declared"

case "$declared" in
  */scsi-0HC_Volume_*)
    echo "convert-host: REFUSING -- $host's disko layout names a Hetzner VOLUME ($declared)." >&2
    echo "  Installing there would repartition the data disk. Point it at the root disk's own" >&2
    echo "  scsi-0QEMU_QEMU_HARDDISK_<serial>; read it with: lsblk -dno NAME,SIZE,SERIAL" >&2
    exit 1
    ;;
esac

resolved="$(ssh "${ssh_opts[@]}" -o BatchMode=yes "root@$ip" "readlink -f '$declared' 2>/dev/null || true")"
if [[ -z "$resolved" ]]; then
  echo "convert-host: REFUSING -- $declared does not exist on $host." >&2
  echo "  Disks actually present there:" >&2
  ssh "${ssh_opts[@]}" -o BatchMode=yes "root@$ip" 'lsblk -dno NAME,SIZE,SERIAL' >&2 || true
  exit 1
fi

volume_target="$(ssh "${ssh_opts[@]}" -o BatchMode=yes "root@$ip" \
  "ls -l /dev/disk/by-id/ 2>/dev/null | grep -E 'scsi-0HC_Volume_[0-9]+ ' | awk '{print \$NF}' | sed 's#\.\./\.\./#/dev/#'")"
for v in $volume_target; do
  if [[ "$v" == "$resolved" ]]; then
    echo "convert-host: REFUSING -- $declared resolves to $resolved on $host, which is a Hetzner VOLUME." >&2
    echo "  This is the mongo-1 failure of 2026-08-29. Installing would destroy that volume's data." >&2
    exit 1
  fi
done
echo "    resolves to $resolved, which is not a volume -- proceeding"

echo "==> installing NixOS on $host from $flake_dir#$host"
# --build-on-target because the operator's machine is aarch64-darwin and cannot produce an
# x86_64-linux closure at all. The rescue system has enough disk and RAM to do it.
nix run nixpkgs#nixos-anywhere -- \
  --flake "$flake_dir#$host" \
  --build-on-remote \
  "root@$ip"

# WAIT FOR THE MACHINE TO COME BACK BEFORE TOUCHING known_hosts. nixos-anywhere REBOOTS as its
# last act, so a keyscan issued the moment it returns races that reboot and records either the
# rescue system's key or nothing at all -- and `ssh-keyscan` failing is silent, so the result is a
# known_hosts entry that is confidently wrong. That happened on monitoring-1 (2026-08-29): the
# refresh below ran, captured nothing, and the next ssh failed with "Host key verification failed"
# on a host that was perfectly healthy.
echo "==> waiting for $host to come back up as NixOS"
for _ in $(seq 1 60); do
  if ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 \
         -o BatchMode=yes "root@$ip" 'test -e /etc/NIXOS' >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

# THE HOST KEY HAS CHANGED, and every later tool checks it strictly. The machine minted a fresh
# ssh_host_ed25519_key on first boot, so the entry left behind by the rescue system -- or by the
# Ubuntu host before it -- now looks exactly like a man-in-the-middle attack. It stops the very next
# step: `nixos-rebuild --target-host` fails with "REMOTE HOST IDENTIFICATION HAS CHANGED", which
# reads like a network fault rather than a stale record.
#
# Re-learning it here is safe in a way a blind re-TOFU elsewhere would not be: we installed this
# machine ourselves, seconds ago, over a connection whose only payload was a public flake.
echo "==> refreshing the host key for $ip (it changed during the install)"
ssh-keygen -R "$ip" >/dev/null 2>&1 || true
if ! ssh-keyscan -t ed25519 "$ip" 2>/dev/null | grep -q .; then
  # Loud, because a silent failure here is what produced the monitoring-1 confusion.
  echo "    WARNING: ssh-keyscan returned nothing for $ip." >&2
  echo "    Re-run once it answers:  ssh-keygen -R $ip && ssh-keyscan -t ed25519 $ip >> ~/.ssh/known_hosts" >&2
else
  ssh-keyscan -t ed25519 "$ip" 2>/dev/null >> "$HOME/.ssh/known_hosts"
fi

cat <<MSG

==> $host converted.

Two things are NOT done yet and the host cannot decrypt its secrets until both are:

  1. Derive the new host age key -- the machine minted a fresh SSH host key on this boot, so the
     old recipient (if any) is now worthless:

       ssh root@$ip cat /etc/ssh/ssh_host_ed25519_key.pub | nix run nixpkgs#ssh-to-age

  2. Add it to infra/.sops.yaml under the $host anchor, then:

       sops updatekeys infra/nix/secrets/$host.yaml

Then deploy for real:  colmena apply --on $host
MSG
