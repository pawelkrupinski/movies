#!/bin/sh
# Purpose: Convert one stock-Ubuntu Hetzner Cloud server into a NixOS host from this flake
# The name its callers run (infra/nix/bin/convert-host mongo-1 --yes): infra/nix/bin/convert_host.py is the tool, its
# header says what it does -- it REPARTITIONS the target's root disk.
exec python3 "$(dirname "$0")/convert_host.py" "$@"
