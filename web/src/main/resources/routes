# ── Auth (OAuth2 — Google / Facebook) ────────────────────────────────────────
# `/auth/<provider>/start` issues a CSRF state, stashes it in the signed
# session cookie, redirects to the provider's consent screen. The callback
# verifies the state and exchanges the code for a profile; on success the
# session gets a `userId` and the user lands back on /.
# ── Cross-domain sign-in handoff ─────────────────────────────────────────────
# BEFORE the `:provider` routes on purpose: Play matches in file order, and
# `/auth/:provider/start` would otherwise swallow `/auth/sso/start` as a
# provider literally named "sso".
#
# `/uk`, `/de` and `/us` are one origin and share the session cookie outright.
# Poland is on its own domain, where no cookie can follow — so switching country
# hands the session over explicitly: `start` mints a one-shot code on the
# deployment that HAS the session, `finish` spends it on the one being switched
# to. `to` is matched against the deployed countries' own base URLs and nothing
# else, so the redirect cannot be aimed off-brand.
GET     /auth/sso/start             controllers.AuthController.ssoStart()
GET     /auth/sso/finish            controllers.AuthController.ssoFinish()
# The far half of a logout. The sign-in pairing establishes a session on BOTH
# domains, so clearing one would leave the visitor signed out where they pressed
# the button and signed in a domain away.
GET     /auth/sso/logout            controllers.AuthController.ssoLogout()

GET     /auth/:provider/start       controllers.AuthController.start(provider: String)
GET     /auth/:provider/callback    controllers.AuthController.callback(provider: String)
+ nocsrf
POST    /auth/logout                controllers.AuthController.logout()

GET     /api/me                     controllers.AuthController.me()
+ nocsrf
POST    /auth/token                 controllers.AuthController.token()
+ nocsrf
POST    /auth/exchange              controllers.AuthController.exchange()

