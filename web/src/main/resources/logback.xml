<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%date{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="services" level="INFO"/>
  <logger name="clients" level="INFO"/>
  <!-- DEBUG surfaces per-entry rating changes from the hourly Cinemeta refresh
       (look for "Cinemeta refresh:" lines). The tick-start / tick-end summary
       and "first run in 10s" line are INFO and always visible. -->
  <logger name="services.enrichment.EnrichmentService" level="DEBUG"/>

  <!-- RemovalAudit's dedicated stream — the ONE place a removal is recorded
       (here: `MongoMovieRepository.delete` / `deleteById`). It is deliberately a
       fixed name rather than a class logger, so the `services`/`clients` levels
       above do NOT reach it: without this line it inherits the root's WARN and
       every INFO audit call is a silent no-op. Keep the name in step with
       `RemovalAudit.LoggerName`; LogbackConfigSpec asserts a real call reaches an
       appender. Mirrored in the worker's logback-base.xml. -->
  <logger name="kinowo.removal-audit" level="INFO"/>

  <!-- RetiredAccessLog's dedicated stream — the only per-request record a
       RETIRED deployment (kinowo.fly.dev) keeps, so `fly logs` shows something
       useful for deciding when that host's traffic has died down enough to
       shut it off. Fixed name for the same reason `kinowo.removal-audit` is
       above: `controllers` isn't in this file, so a class logger would
       silently inherit the root's WARN. Keep the name in step with
       `RetiredAccessLog.LoggerName`; LogbackConfigSpec asserts a real call
       reaches an appender. -->
  <logger name="kinowo.retired-access" level="INFO"/>

  <!-- MongoDB driver 5.x's TLS selector-monitor loop races against
       connection-pool churn: a SocketChannel queued for selector
       registration can be closed by another thread (idle-pool shrinkage,
       Atlas-side disconnect, shutdown) before register() runs, throwing
       `ClosedChannelException` from
       `TlsChannelStreamFactoryFactory$SelectorMonitor`. The driver
       catches it and the next read/write retries on a fresh connection;
       the WARN line is the only effect. Raise this logger to ERROR so
       the noise stops surfacing while real TLS-layer errors still log. -->
  <logger name="org.mongodb.driver.connection.tls" level="ERROR"/>

  <!-- Sentry: forward ERROR-level events; attach INFO+ as breadcrumbs.
       Reads SENTRY_DSN from the environment; when unset the appender is
       a no-op (local dev, CI). -->
  <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
    <minimumEventLevel>ERROR</minimumEventLevel>
    <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="SENTRY"/>
  </root>
</configuration>
