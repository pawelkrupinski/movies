<configuration>
  <include resource="logback-base.xml"/>

  <!-- ONE JSON object per line (tools.JsonLineEncoder): the fleet's Vector merges
       its fields into the VictoriaLogs row (`mergeJsonBodyVrl` in
       infra/nix/modules/fleet/logs.nix), so `message` is `_msg` and the image's
       `build`, a projection's `projection_id` and every key-value pair a log call
       adds (a take change's kind, basis, venue, …) are fields LogsQL filters on,
       not text a regex has to dig out. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="tools.JsonLineEncoder"/>
  </appender>

  <!-- Persistent log file on the volume mounted at /data (KINOWO_LOG_DIR=
       /data/logs in each worker overlay) so the worker's logs SURVIVE a restart —
       `kubectl logs` only retains a short rolling window, which loses exactly the
       pre-restart logs you need to diagnose a crash/throttle spiral (the gap hit
       during the 2026-06-24 throttle incident). Unset (local dev) → ./logs.
       Capped so it can't fill the 1GB volume it shares with /data/heapdumps. -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${KINOWO_LOG_DIR:-logs}/worker.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${KINOWO_LOG_DIR:-logs}/worker.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>10MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>80MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <!-- Text with a full date: a persisted file spans days, and restarts — so the
           build too, and a call's key-value pairs after the message. -->
      <pattern>%date{yyyy-MM-dd HH:mm:ss} %-5level [%property{build}] %logger{36} - %msg %kvp%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
    <appender-ref ref="SENTRY"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
